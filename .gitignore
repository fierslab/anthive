# Build artifacts
webapp/

# Temporary / generated files (go in tmp/)
tmp/
.jupyterlite.doit.db

# Server logs and pids
caddy.log
nginx_access.log
nginx_error.log
nginx.pid

# (former antclient.py / anthelper.py vendored-copy gitignore lines
# dropped 2026-06-22: pyvark `vark/` is now tracked in frontend/jupyter/.)


# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Rclone (keep example, ignore actual config)
rclone.conf

# nginx active config (may contain secrets)
config/default.conf

# Per-instance / per-server live configuration (real hostnames, ports, paths,
# cert locations, systemd units, nginx vhosts). Instance-specific — NOT for the
# public repo. Tracked in a SEPARATE private repo mounted here. config/ keeps
# only the generic mechanism + examples + the how-to README.
config/server/

# User config (may contain credentials)
anthive.yaml

# Deleted/broken DuckDB files
*.duckdb.deleted
*.duckdb.wal.deleted

# Micromamba environments (large, reproducible from envs/*.yml)
envs/anthive-data/

# Server logs (generated at runtime)
logs/

# Attic - archived old files
attic/

# Data - separate repos, not tracked here
data/

# Claude runtime artefacts (lock files, transient state)
.claude/scheduled_tasks.lock

# Caddy basic-auth credentials — dropped in by 'make caddy-passwd'
config/caddy-auth-*.conf

# Authelia: secrets + the user database (bcrypt hashes still secret).
# configuration.yml is instance-specific (host/port/cookie domain/SMTP) and
# is gitignored — copy configuration.example.yml per host. Secrets stay in files.
config/authelia/configuration.yml
config/authelia/secrets/
config/authelia/users_database.yml
config/authelia/db.sqlite3
config/authelia/notification.txt

# Authelia binary (large, reproducible — download via setup script)
envs/authelia/

# Custom Caddy build (xcaddy with replace-response module) — large binary,
# reproducible. Build via: cd envs/go && ./go/bin/go install xcaddy && xcaddy build --with caddyserver/replace-response
envs/caddy/

# Local Go toolchain (for building the custom Caddy). Tarball download,
# never tracked.
envs/go/

# Original logo backup (kept locally as a fallback; not for git)
config/authelia/assets/logo.original.png

# vark — Go CLI standalone repo (codeberg.org/mfiers/vark), nested at
# repo root but never tracked by anthive4. Anchored with leading slash
# so the vendored Python `vark/` package under frontend/jupyter/jupyter/
# (= codeberg.org/mfiers/pyvark) is NOT excluded.
/vark/
.vark/
