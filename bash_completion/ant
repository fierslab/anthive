# Bash completion for ant command
#
# Installation:
#   sudo cp bash_completion/ant /etc/bash_completion.d/ant
#   OR
#   cp bash_completion/ant ~/.bash_completion.d/ant
#
# Then reload: source ~/.bashrc

_ant_completion()
{
    local cur prev words cword
    _init_completion || return

    # Available ant subcommands (dispatcher walks bin/<domain>/ant-*; keep
    # this list aligned with what's actually shipped).
    local subcommands="annotate api-check browse build-all build-reports cellxgene check convert db de-ingest de-pseudobulk duckdb-check h5ad-check inactive ingest mcp md md-check merge-h5ad priority s3-check score serve starcat suggest-tops supervisor sync warm-cache write-manifest"

    # Complete the subcommand itself
    if [[ $cword -eq 1 ]]; then
        COMPREPLY=($(compgen -W "$subcommands" -- "$cur"))
        return
    fi

    local subcommand="${words[1]}"

    case "$subcommand" in

        # ── cellxgene: subcommand + optional identifier ────────────────────
        cellxgene)
            if [[ $cword -eq 2 ]]; then
                COMPREPLY=($(compgen -W "import info search" -- "$cur"))
                return
            fi
            local cxg_sub="${words[2]}"
            case "$cxg_sub" in
                import|info)
                    if [[ "$cur" == -* ]]; then
                        COMPREPLY=($(compgen -W "--output-dir --no-convert --force --data-folder" -- "$cur"))
                        return
                    fi
                    return  # identifier is a URL/UUID; no file completion
                    ;;
                search)
                    COMPREPLY=($(compgen -W "--organism --tissue --cell-type --disease --assay" -- "$cur"))
                    return
                    ;;
            esac
            return
            ;;

        # ── file-less commands ─────────────────────────────────────────────
        api-check|mcp|supervisor)
            return
            ;;

        # ── .h5ad file commands ────────────────────────────────────────────
        check|h5ad-check)
            _filedir h5ad
            return
            ;;

        # ── convert: .h5ad file + optional layer overrides ─────────────────
        convert)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--exclude-layer --include-layer" -- "$cur"))
                return
            fi
            _filedir h5ad
            return
            ;;

        # ── duckdb-check: .h5ad or .duckdb + flags ────────────────────────
        duckdb-check)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--deep --clean-wal --verbose" -- "$cur"))
                return
            fi
            _filedir '@(h5ad|duckdb)'
            return
            ;;

        # ── db: subcommand then .duckdb file ──────────────────────────────
        db)
            if [[ $cword -eq 2 ]]; then
                COMPREPLY=($(compgen -W "structure schema query" -- "$cur"))
                return
            fi
            if [[ $cword -eq 3 ]]; then
                _filedir duckdb
                return
            fi
            return
            ;;

        # ── inactive: subcommand then files/folders ────────────────────────
        inactive)
            if [[ $cword -eq 2 ]]; then
                COMPREPLY=($(compgen -W "mark unmark list" -- "$cur"))
                return
            fi
            local inactive_sub="${words[2]}"
            case "$inactive_sub" in
                mark|unmark)
                    # Accept .md, .h5ad, .duckdb, or directories
                    _filedir '@(md|h5ad|duckdb)'
                    return
                    ;;
                list)
                    _filedir -d
                    return
                    ;;
            esac
            return
            ;;

        # ── md: YAML metadata editor ───────────────────────────────────────
        md)
            local md_subcommands="delete exclude-embedding exclude-layer get include-embedding include-layer set show"

            # Complete the md subcommand
            if [[ $cword -eq 2 ]]; then
                COMPREPLY=($(compgen -W "$md_subcommands" -- "$cur"))
                return
            fi

            local md_sub="${words[2]}"
            case "$md_sub" in
                set)
                    if [[ "$cur" != *=* ]]; then
                        _filedir md
                    fi
                    return
                    ;;
                get|delete)
                    _filedir md
                    return
                    ;;
                show|exclude-layer|include-layer|exclude-embedding|include-embedding)
                    _filedir md
                    return
                    ;;
            esac
            return
            ;;

        # ── md-check: folder + flags ───────────────────────────────────────
        md-check)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--no-fix --verbose" -- "$cur"))
                return
            fi
            _filedir -d
            return
            ;;

        # ── s3-check: data folder + flags ─────────────────────────────────
        s3-check)
            if [[ "$prev" == "--data-folder" ]]; then
                _filedir -d
                return
            fi
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--data-folder --verbose" -- "$cur"))
                return
            fi
            return
            ;;

        # ── serve: data folder + flags ─────────────────────────────────────
        serve)
            if [[ "$prev" == "--data-folder" ]]; then
                _filedir -d
                return
            fi
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--data-folder --host --port --reload" -- "$cur"))
                return
            fi
            return
            ;;

        # ── sync: subcommand then optional glob filter ─────────────────────
        sync)
            if [[ $cword -eq 2 ]]; then
                COMPREPLY=($(compgen -W "push pull evict status" -- "$cur"))
                return
            fi
            local sync_sub="${words[2]}"
            case "$sync_sub" in
                pull)
                    if [[ "$cur" == -* ]]; then
                        COMPREPLY=($(compgen -W "--evict --include-duckdb --only --max-bandwidth --max-concurrency" -- "$cur"))
                        return
                    fi
                    ;;
                push)
                    if [[ "$cur" == -* ]]; then
                        COMPREPLY=($(compgen -W "--skip-no-mtime --max-bandwidth --max-concurrency" -- "$cur"))
                        return
                    fi
                    ;;
                evict)
                    if [[ "$cur" == -* ]]; then
                        COMPREPLY=($(compgen -W "--dry-run" -- "$cur"))
                        return
                    fi
                    return
                    ;;
            esac
            if [[ "$prev" == "--data-folder" ]]; then
                _filedir -d
                return
            fi
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--data-folder" -- "$cur"))
                return
            fi
            return
            ;;

        # ── priority: per-dataset retention priority (0..100) ──────────────
        priority)
            local priority_subcommands="list show set"

            if [[ $cword -eq 2 ]]; then
                COMPREPLY=($(compgen -W "$priority_subcommands" -- "$cur"))
                return
            fi

            local prio_sub="${words[2]}"
            case "$prio_sub" in
                list)
                    if [[ "$prev" == "--sort" ]]; then
                        COMPREPLY=($(compgen -W "priority priority-desc db_id" -- "$cur"))
                        return
                    fi
                    if [[ "$cur" == -* ]]; then
                        COMPREPLY=($(compgen -W "--below --above --sort" -- "$cur"))
                        return
                    fi
                    return
                    ;;
                show)
                    # Target: db_id OR path (.md / .h5ad / .duckdb / dir).
                    # _filedir's @() glob accepts the three file types and
                    # the -d fallback below picks up directories too.
                    _filedir '@(md|h5ad|duckdb)'
                    return
                    ;;
                set)
                    # Two positional args after `set`: target (cword=3),
                    # then numeric value (cword=4); --dry-run anywhere after.
                    if [[ "$cur" == -* ]]; then
                        COMPREPLY=($(compgen -W "--dry-run" -- "$cur"))
                        return
                    fi
                    if [[ $cword -eq 3 ]]; then
                        _filedir '@(md|h5ad|duckdb)'
                        return
                    fi
                    # cword >= 4: numeric value — no completion to offer
                    return
                    ;;
            esac
            return
            ;;

        # ── directory-based commands ───────────────────────────────────────
        browse|build-all)
            _filedir -d
            return
            ;;

        # ── fallback ───────────────────────────────────────────────────────
        *)
            _filedir
            return
            ;;
    esac
}

complete -F _ant_completion ant
