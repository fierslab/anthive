# Only the source tree needs to go into the build context.
# Everything below is either large, secret, host-specific, or generated.

# Version control + editor + OS cruft
.git
.gitignore
.gitattributes
**/__pycache__
**/*.pyc
**/*.pyo
**/.DS_Store
**/*.swp
**/*~
**/#*#
**/.#*
.vscode
.idea

# Local data caches — the container gets its stores via bind mounts.
# The whole data/ tree stays out (chat_history.db and friends live there on
# dev checkouts); the image recreates data/ as links to the mounts.
data
data/h5adstore
data/genesetstore
data/starcatstore
data/reports
data/*.h5ad
data/*.duckdb
data/*.parquet

# Host-local tool envs never enter the image: the Dockerfile copies caddy
# from the official image, the venv comes from docker/requirements-app.lock
# and the ingest image builds its R env from the pinned explicit lock.
envs/*
!envs/anthive-data.yml

# Emacs autosave + attic + host-local Claude/Jupyter caches
attic
.cache
.claude
.jupyterlite.doit.db

# Local run state
tmp
logs
*.log
.venv
venv
node_modules

# Test / build outputs
dist
build
htmlcov
.pytest_cache
.mypy_cache
.ruff_cache
*.egg-info

# Runtime state and site deployment config (tokens, caches, secrets)
var
site.yaml
site.*.yaml
!site.example.yaml

# Static bundles: the image builds JupyterLite itself; plots/ and artifacts/
# are runtime output (possibly data derivatives). Keep only the 404 page.
webapp/*
!webapp/404.html
!webapp/anthive404.png

# Secrets — must never end up in a redistributable image
anthive.yaml
config/caddy-auth-basic.conf
config/authelia/secrets
**/.env
**/*.secret

# Docs / reports not needed at runtime (keep small — the image doesn't
# serve these, and the source is on git anyway)
report

# Host-specific work-in-progress
fix.txt
plans

# Docker artifacts themselves — build context already includes docker/
# but the Dockerfile lives elsewhere in the tree so keep it out of the
# copy step's noise.
docker/build
