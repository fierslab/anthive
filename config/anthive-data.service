[Unit]
Description=Anthive — data.nevel.eu (ant-supervisor: api+browse+authelia)
Documentation=file:/data/data_nevel_eu/doc/HANDOFF_authelia.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mf
Group=mf
WorkingDirectory=/data/data_nevel_eu
# uv lives in mf's ~/.local/bin; the supervisor + its children are
# `uv run --script` shebangs, so uv must be on PATH. HOME is needed for
# the uv cache (~/.cache/uv).
Environment=HOME=/home/mf
Environment=PATH=/home/mf/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/data/data_nevel_eu/bin/ops/ant-supervisor
# systemd's default KillMode=control-group SIGTERMs the whole cgroup
# (supervisor + api/browse/authelia), so no orphaned children on stop.
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
