# Anthive4 Caddy Configuration
# Serves static files and proxies API requests
{
	# Disable admin API to avoid port conflict with system Caddy
	admin off
}

:8501 {
	# Root directory for static files
	root * ./webapp

	# Optional basic-auth, dropped in by `make caddy-passwd`.  The file is
	# gitignored.  No file → import is a no-op → no auth → the same
	# unauthenticated dev experience as before.  See config/caddy-auth.example.
	import caddy-auth-*.conf

	# Reverse proxy for API - strip /api prefix before forwarding
	handle_path /api/* {
		reverse_proxy localhost:8080
	}

	# Reverse proxy for browser interface (dataset browsing)
	handle /browse/* {
		reverse_proxy localhost:8081
	}

	# Home page - browser interface
	handle / {
		reverse_proxy localhost:8081
	}

	# Serve static files for JupyterLite
	# COOP/COEP headers are required for SharedArrayBuffer (Pyodide kernel)
	handle /jupyter/* {
		header Cross-Origin-Opener-Policy "same-origin"
		header Cross-Origin-Embedder-Policy "require-corp"
		file_server
	}

	# MCP server (FastMCP streamable-http)
	handle /mcp* {
		reverse_proxy localhost:8090
	}

	# MCP clients (per RFC 8414 / MCP spec) probe many discovery URLs
	# *before* /mcp itself: oauth-authorization-server,
	# oauth-protected-resource, openid-configuration, and the OAuth
	# dynamic-registration endpoint /register.  We don't require auth, but
	# if these return an empty 404 body the client SDK crashes parsing it
	# as JSON ("Unexpected EOF").  Catch them all and respond with valid
	# JSON 404s so the SDK falls back to no-auth and proceeds to /mcp.
	handle /.well-known/* {
		header Content-Type application/json
		respond `{"error":"not_supported","error_description":"This MCP server does not implement OAuth"}` 404
	}
	handle /register {
		header Content-Type application/json
		respond `{"error":"not_supported","error_description":"OAuth dynamic registration is not supported"}` 404
	}

	# /streamlit was a Streamlit dashboard mounted at :8082; superseded by
	# ant-browse's per-dataset plot UI and removed from the production
	# stack.  Any stale link gets a tiny 410 instead of a confusing 502.
	handle /streamlit* {
		header Content-Type application/json
		respond `{"error":"gone","error_description":"The Streamlit dashboard has been removed. Use the per-dataset plot UI at /browse/ instead."}` 410
	}

	# Fallback - if no other handle matched, serve static files
	handle {
		file_server
	}

	# Enable gzip compression
	encode gzip

	# Logging
	log {
		output file ./tmp/caddy.log
		format console
	}
}
