# Anthive4 Caddy Configuration — single source of truth for path routing
#
# Caddy owns ALL anthive path routing on both dev and prod. The split
# between the two modes is controlled by three env vars, set by the
# launcher (ant-supervisor) or systemd unit:
#
#   ANTHIVE_LISTEN        listen address      dev: ":8501"  prod: "127.0.0.1:8500"
#   ANTHIVE_TLS_SNIPPET   TLS directives      dev: caddy-tls.dev (= "tls internal")
#                                              prod: caddy-tls.prod (= empty; nginx terminates)
#   ANTHIVE_AUTH_SNIPPET  auth directives     dev: caddy-auth.dev (= Authelia forward_auth)
#                                              prod: caddy-auth.prod (= trust Remote-* headers
#                                                                       already set by nginx)
#
# Everything else — handle blocks for /api, /browse, /mcp, /jupyter,
# /artifacts, the fallback to ant-browse, /.well-known + /register
# stubs, /streamlit 410 — is IDENTICAL between dev and prod.
#
# When ANTHIVE_PROD=1 is set, ant-supervisor exports the *.prod values
# below; otherwise dev defaults apply and behaviour is byte-for-byte
# what it was before this refactor.
{
	# Disable admin API to avoid port conflict with system Caddy
	admin off

	# Authelia v4.39 hard-requires https:// for cookie URLs, so on dev
	# Caddy terminates TLS via `tls internal` (self-signed by Caddy's
	# local CA). `disable_redirects` keeps automatic cert provisioning
	# ON (`tls internal` needs that) but skips the :80 → :443 redirect
	# listener that fails as a non-root process.  On prod ANTHIVE_TLS
	# is empty and nginx terminates TLS in front of us.
	auto_https disable_redirects
}

# HTTP companion block — dev: :8500 → 301 to https://…:8501. Prod:
# Caddy itself listens on :8500 (plain HTTP from nginx), so the
# redirect block would conflict and is omitted entirely via an empty
# snippet import.
import {$ANTHIVE_HTTP_REDIRECT_SNIPPET:caddy-http-redirect.dev}

# Main site block — listens on ANTHIVE_LISTEN.
#
# Dev default: enumerates hostnames so `tls internal` issues a cert per
# name and SNI-matches whichever the client uses (localhost, …).
# A bare ":8501" leaves no hostname bound → TLS handshake fails with
# `internal error` because Caddy can't pick a cert for the connection.
# To reach a dev box over a LAN/VPN address, add it here or via env — keep
# host-specific addresses out of this shared file.
# Prod overrides via env to a host-agnostic "http://:<port>" (single address;
# nginx in front terminates TLS and forwards the public Host).
{$ANTHIVE_LISTEN::8501, localhost:8501, localhost.localdomain:8501, 127.0.0.1:8501, 10.42.0.3:8501} {
	# Restrict which network interfaces Caddy accepts connections on.
	# Default ("0.0.0.0 ::") = all v4 + v6 interfaces — fine for laptops,
	# overridden on multi-homed boxes via ANTHIVE_CADDY_BIND. On prod the
	# supervisor sets this to "127.0.0.1" so Caddy is reachable only via
	# the local nginx hop.
	#
	#   export ANTHIVE_CADDY_BIND="127.0.0.1 <lan-or-vpn-ip>"   # peer + loopback
	#
	# See INSTALL.md section 5 for the persistent-per-host pattern.
	bind {$ANTHIVE_CADDY_BIND:0.0.0.0 ::}

	# TLS directives — dev imports a snippet containing `tls internal`;
	# prod imports an empty snippet so Caddy serves plain HTTP (nginx
	# terminates TLS upstream).  Paths are relative to THIS Caddyfile
	# (so `caddy-tls.dev` resolves to `config/caddy-tls.dev` from the
	# repo root).
	import {$ANTHIVE_TLS_SNIPPET:caddy-tls.dev}

	# Root directory for static files
	root * ./webapp

	# Authelia portal — always reachable, never gated by forward_auth
	# (chicken-and-egg: this IS the gate). handle_path strips /authelia/
	# so Authelia (which is configured with base path /authelia) sees the
	# full path it expects.  Identical dev/prod (prod nginx forwards
	# /authelia/* through to us so the login UI keeps working).
	handle /authelia/* {
		reverse_proxy localhost:{$ANTHIVE_AUTHELIA_PORT:9091}
	}

	# Routes that MUST bypass auth — MCP discovery probes + the /streamlit
	# gone-410 stub. Otherwise MCP clients see a 302-to-login instead of
	# the JSON 404 they need to parse.
	# /mcp/u/* carries a personal MCP link token that ant-mcp verifies
	# itself, and /mcp with "Authorization: Bearer amcp_..." likewise
	# (see the @browser matcher in caddy-auth.dev).
	@bypass_auth path /.well-known/* /register /streamlit* /mcp/u/*

	# X-Anthive-Internal is ant-mcp's credential towards ant-serve; a
	# client must never be able to present it through the proxy.
	request_header -X-Anthive-Internal

	# Auth snippet — dev imports forward_auth blocks (cookie/api split
	# against local Authelia); prod imports a passthrough that trusts
	# the Remote-User / Remote-Groups / Remote-Email headers set by nginx.
	# Path is relative to THIS Caddyfile.
	import {$ANTHIVE_AUTH_SNIPPET:caddy-auth.dev}

	# ant-serve's /internal/* endpoints (MCP link verification) are for
	# ant-mcp on the backend network only.
	handle /api/internal/* {
		respond `{"detail":"internal endpoint"}` 403
	}

	# Reverse proxy for API - strip /api prefix before forwarding
	handle_path /api/* {
		reverse_proxy localhost:{$ANTHIVE_API_PORT:8080}
	}

	# Reverse proxy for browser interface (dataset browsing)
	handle /browse/* {
		reverse_proxy localhost:{$ANTHIVE_BROWSE_PORT:8081}
	}

	# Home page - browser interface
	handle / {
		reverse_proxy localhost:{$ANTHIVE_BROWSE_PORT:8081}
	}

	# Serve static files for JupyterLite
	# COOP/COEP headers are required for SharedArrayBuffer (Pyodide kernel)
	# `/jupyter` (no trailing slash) doesn't match `/jupyter/*` globs, so
	# redirect first — otherwise it falls through to the browser proxy
	# and 404s.
	handle /jupyter {
		redir /jupyter/ 301
	}
	handle /jupyter/* {
		header Cross-Origin-Opener-Policy "same-origin"
		header Cross-Origin-Embedder-Policy "require-corp"
		file_server
	}

	# Other static bundles under ./webapp (rendered reports, plot exports, the
	# stlite playground). Explicit so they stay on file_server now that the
	# fallback below proxies everything else to the browser app.
	handle /plots/* {
		file_server
	}
	# Pseudobulk parquet artifacts (TTL 1 h, unguessable UUID filenames).
	# Lives behind the same authelia/basic-auth gate as /api/.
	handle /artifacts/* {
		file_server
	}
	handle /report/* {
		file_server
	}
	handle /stlite/* {
		file_server
	}

	# MCP server (FastMCP streamable-http). ant-mcp authenticates every
	# request itself (personal link /mcp/u/<token> or Bearer amcp_ token)
	# and never reads client identity headers, but strip them anyway.
	handle /mcp* {
		request_header -Remote-User
		request_header -Remote-Groups
		request_header -Remote-Name
		request_header -Remote-Email
		reverse_proxy localhost:{$ANTHIVE_MCP_PORT:8090}
	}

	# MCP clients (per RFC 8414 / MCP spec) probe many discovery URLs
	# *before* /mcp itself: oauth-authorization-server,
	# oauth-protected-resource, openid-configuration, and the OAuth
	# dynamic-registration endpoint /register.  We don't require auth, but
	# if these return an empty 404 body the client SDK crashes parsing it
	# as JSON ("Unexpected EOF").  Catch them all and respond with valid
	# JSON 404s so the SDK falls back to no-auth and proceeds to /mcp.
	handle /.well-known/* {
		header Content-Type application/json
		respond `{"error":"not_supported","error_description":"This MCP server does not implement OAuth"}` 404
	}
	handle /register {
		header Content-Type application/json
		respond `{"error":"not_supported","error_description":"OAuth dynamic registration is not supported"}` 404
	}

	# /streamlit was a Streamlit dashboard mounted at :8082; superseded by
	# ant-browse's per-dataset plot UI and removed from the production
	# stack.  Any stale link gets a tiny 410 instead of a confusing 502.
	handle /streamlit* {
		header Content-Type application/json
		respond `{"error":"gone","error_description":"The Streamlit dashboard has been removed. Use the per-dataset plot UI at /browse/ instead."}` 410
	}

	# Custom 404 page assets — must be handled BEFORE the ant-browse
	# fallback below (which would proxy them to ant-browse and get its
	# own 404 back). file_server serves them directly from ./webapp.
	handle /anthive404.png {
		file_server
	}
	handle /404.html {
		file_server
	}

	# Fallback — the browser app (ant-browse) owns every remaining path:
	# /, /browse/*, /genesets*, /about, and the favicon / webmanifest routes
	# it serves. Previously this was file_server, which 404'd any browser
	# route not explicitly enumerated above (e.g. /about, /genesets). The app
	# is the default; static bundles are the handled exceptions, just above.
	#
	# handle_response converts any 404 ant-browse returns into a
	# Caddy-side error, which handle_errors below then renders as our
	# static 404 page (webapp/404.html + webapp/anthive404.png).
	# /api/* is intentionally NOT intercepted so API consumers still see
	# the FastAPI JSON error body.
	handle {
		reverse_proxy localhost:{$ANTHIVE_BROWSE_PORT:8081} {
			@notfound status 404
			handle_response @notfound {
				error 404
			}
		}
	}

	# Central 404 renderer. Catches BOTH:
	#   - Caddy-generated errors (file_server misses on /jupyter/*,
	#     /plots/*, /artifacts/*, /report/*, /stlite/*)
	#   - ant-browse 404s converted to `error 404` in handle_response above
	handle_errors {
		@notfound expression `{err.status_code} == 404`
		handle @notfound {
			rewrite * /404.html
			file_server {
				status 404
			}
		}
	}

	# Enable gzip compression
	encode gzip

	# Access log. Path via ANTHIVE_CADDY_LOG (default ./tmp/caddy.log).
	# Personal MCP link tokens (/mcp/u/amcp_...) and credentials in
	# headers are redacted before anything is written.
	log {
		output file {$ANTHIVE_CADDY_LOG:./tmp/caddy.log}
		format filter {
			wrap console
			request>uri regexp amcp_[A-Za-z0-9_-]+ amcp_REDACTED
			request>headers>Authorization replace REDACTED
			request>headers>Cookie replace REDACTED
		}
	}
}
