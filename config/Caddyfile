# Anthive4 Caddy Configuration
# Serves static files and proxies API requests
{
	# Disable admin API to avoid port conflict with system Caddy
	admin off

	# Authelia v4.39 hard-requires https:// for cookie URLs, so Caddy
	# terminates TLS via `tls internal` (self-signed by Caddy's local CA).
	# `disable_redirects` keeps automatic cert provisioning ON (`tls
	# internal` needs that) but skips the :80 → :443 redirect listener
	# that fails as a non-root process. The ACME path is unused since
	# the certs come from Caddy's local CA, not Let's Encrypt.
	auto_https disable_redirects
}

# HTTP companion on :8500 — redirects any plain-http hit to https:8501.
# A single TCP listener can't serve both http and https on the same port,
# so we offer a small adjacent HTTP listener whose only job is the 301.
http://localhost:8500, http://localhost.localdomain:8500, http://127.0.0.1:8500, http://10.42.0.3:8500 {
	bind {$ANTHIVE_CADDY_BIND:0.0.0.0 ::}
	redir https://{host}:8501{uri} 301
}

# Site address enumerates the hostnames Caddy serves. `tls internal`
# issues a self-signed cert for each one. Connecting clients see a cert
# matching the hostname they used (no "wrong CN" warning beyond the
# trust warning itself).
#
# To add a hostname for another machine, append it here. The bind below
# still controls WHICH interfaces accept connections.
localhost:8501, localhost.localdomain:8501, 127.0.0.1:8501, 10.42.0.3:8501 {
	# Restrict which network interfaces Caddy actually accepts connections
	# on.  Default ("0.0.0.0 ::") = all IPv4 + IPv6 interfaces — fine for
	# laptops, but typically too open on a multi-homed host where you want
	# the stack reachable on (say) Nebula + localhost but NOT on the office
	# LAN or Docker bridges.
	#
	# Override at runtime via the ANTHIVE_CADDY_BIND env var.  Multiple
	# space-separated IPs / hostnames bind to each one.
	#
	#   export ANTHIVE_CADDY_BIND="127.0.0.1 10.42.0.3"
	#   # → reachable only on localhost + the Nebula IP
	#
	# See INSTALL.md section 5 for the persistent-per-host pattern.
	bind {$ANTHIVE_CADDY_BIND:0.0.0.0 ::}

	# Caddy internal CA — Authelia v4.39 requires https:// for cookie URLs.
	# Self-signed cert; clients accept once or run `caddy trust` on the
	# server box to install the CA into the system trust store.
	tls internal

	# Root directory for static files
	root * ./webapp

	# Authelia portal — always reachable, never gated by forward_auth
	# (chicken-and-egg: this IS the gate). handle_path strips /authelia/
	# so Authelia (which is configured with base path /authelia) sees the
	# full path it expects.
	handle /authelia/* {
		reverse_proxy localhost:9091
	}

	# Routes that MUST bypass auth — MCP discovery probes + the /streamlit
	# gone-410 stub. Otherwise MCP clients see a 302-to-login instead of
	# the JSON 404 they need to parse.
	@bypass_auth path /.well-known/* /register /streamlit*

	# Everything else: forward_auth → Authelia. Authelia returns 200 (allow)
	# or 302 (redirect to /authelia/) based on the session cookie.
	@protected not path /authelia/* /.well-known/* /register /streamlit*
	forward_auth @protected localhost:9091 {
		uri /authelia/api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
	}

	# Reverse proxy for API - strip /api prefix before forwarding
	handle_path /api/* {
		reverse_proxy localhost:8080
	}

	# Reverse proxy for browser interface (dataset browsing)
	handle /browse/* {
		reverse_proxy localhost:8081
	}

	# Home page - browser interface
	handle / {
		reverse_proxy localhost:8081
	}

	# Serve static files for JupyterLite
	# COOP/COEP headers are required for SharedArrayBuffer (Pyodide kernel)
	handle /jupyter/* {
		header Cross-Origin-Opener-Policy "same-origin"
		header Cross-Origin-Embedder-Policy "require-corp"
		file_server
	}

	# MCP server (FastMCP streamable-http)
	handle /mcp* {
		reverse_proxy localhost:8090
	}

	# MCP clients (per RFC 8414 / MCP spec) probe many discovery URLs
	# *before* /mcp itself: oauth-authorization-server,
	# oauth-protected-resource, openid-configuration, and the OAuth
	# dynamic-registration endpoint /register.  We don't require auth, but
	# if these return an empty 404 body the client SDK crashes parsing it
	# as JSON ("Unexpected EOF").  Catch them all and respond with valid
	# JSON 404s so the SDK falls back to no-auth and proceeds to /mcp.
	handle /.well-known/* {
		header Content-Type application/json
		respond `{"error":"not_supported","error_description":"This MCP server does not implement OAuth"}` 404
	}
	handle /register {
		header Content-Type application/json
		respond `{"error":"not_supported","error_description":"OAuth dynamic registration is not supported"}` 404
	}

	# /streamlit was a Streamlit dashboard mounted at :8082; superseded by
	# ant-browse's per-dataset plot UI and removed from the production
	# stack.  Any stale link gets a tiny 410 instead of a confusing 502.
	handle /streamlit* {
		header Content-Type application/json
		respond `{"error":"gone","error_description":"The Streamlit dashboard has been removed. Use the per-dataset plot UI at /browse/ instead."}` 410
	}

	# Fallback - if no other handle matched, serve static files
	handle {
		file_server
	}

	# Enable gzip compression
	encode gzip

	# Logging
	log {
		output file ./tmp/caddy.log
		format console
	}
}
