# Example basic-auth fragment.  Copy to `caddy-auth-basic.conf` (or any
# matching `caddy-auth-*.conf`) to enable; remove that file to disable.
# The Caddyfile imports `caddy-auth-*.conf` automatically when present.
#
# Generate the hash with:
#
#     caddy hash-password
#
# (interactive — prompts twice for the password; outputs a `$2a$…` bcrypt
# hash to stdout.  Paste it below.)
#
# Or use the convenience target `make caddy-passwd`, which writes
# `config/caddy-auth-basic.conf` for you.
#
# What's protected: everything Caddy serves on :8501 EXCEPT the MCP
# transport (`/mcp*`) and the OAuth-discovery probes (`/.well-known/*`,
# `/register`).  MCP clients carry their own auth, and the discovery
# endpoints return harmless JSON 404s; both should stay reachable.

@protected {
	not path /mcp* /.well-known/* /register
}

basic_auth @protected {
	admin REPLACE_WITH_BCRYPT_HASH
}
