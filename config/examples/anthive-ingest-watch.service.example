# EXAMPLE: systemd unit for the S3 watch route (bin/ingest/ant-ingest-watch).
# It runs on its own, next to the serving stack, never as a child of it:
# it polls S3 for `mus s3 upload` deposits, checks and publishes them into
# the local store, and reaches the local ant-serve over HTTP only (rescan,
# release/restore). A restart of ant-serve does not stop it (rescans retry
# with backoff).
#
#   sudo cp anthive-ingest-watch.service.example /etc/systemd/system/anthive-ingest-watch.service
#   (fill the <PLACEHOLDERS>; set ingest_watch.enabled: true in anthive.yaml)
#   sudo systemctl daemon-reload && sudo systemctl enable --now anthive-ingest-watch
#   journalctl -u anthive-ingest-watch -f          # the log
#   <REPO_PATH>/bin/ant ingest-watch status        # items and their states
#
# Keep the filled-in copy in your private server-config repo, NOT in anthive4.

[Unit]
Description=Anthive S3 ingest watcher (<HOSTNAME>)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=<USER>
WorkingDirectory=<REPO_PATH>
# uv must be on PATH (the tools are `uv run --script`); HOME holds the uv cache.
Environment=HOME=<HOME>
Environment=PATH=<HOME>/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Optional: a config outside the repo (paths, S3 keys, ingest_watch block).
# Environment=ANTHIVE_CONFIG=/etc/anthive/anthive.yaml
# Runtime dirs outside the checkout (the watcher refuses dirs inside it).
Environment=ANTHIVE_INGEST_STATE_DIR=<STATE_PATH>/ingest
Environment=ANTHIVE_INGEST_WORK_DIR=<STATE_PATH>/ingest_work
Environment=ANTHIVE_TMP_DIR=<STATE_PATH>/tmp
ExecStart=<REPO_PATH>/bin/ingest/ant-ingest-watch
# Low priority: it shares the host with the server. The watcher also sets
# nice 19 / ionice idle on itself (ingest_watch.low_priority).
Nice=19
IOSchedulingClass=idle
CPUSchedulingPolicy=batch
# Caps for the whole cgroup (convert, ant-ingest-check, the post steps). Size
# MemoryMax for the largest h5ad you expect: ant-convert holds a dataset in RAM.
CPUQuota=400%
MemoryHigh=40G
MemoryMax=48G
# Stopping: systemd sends SIGTERM to every process of the unit. Running tools
# (ant-convert, ant-ingest-check, post steps) die at once and their item is
# retried on the next start; the watcher itself finishes the step it is in,
# never starts a store swap after the signal, and a swap already committing
# is completed (or finished from its journal on the next start). 600 s covers
# a swap or catalog push of a large dataset; after that systemd kills it and
# the journal is rolled forward or back on the next start.
KillMode=control-group
TimeoutStopSec=600
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
