# EXAMPLE — Authelia-gated anthive4 vhost. Copy, fill <PLACEHOLDERS>, deploy to
# /etc/nginx/conf.d/. nginx terminates TLS, runs the Authelia auth_request gate,
# and forwards every non-Authelia path to this instance's Caddy on a loopback
# port. Browser routes use a cookie-only gate; /api/ also accepts HTTP Basic
# (validated against the same Authelia users) for CLI clients (e.g. vark).
#
# Identity: Remote-User / Remote-Groups / Remote-Email / Remote-Name reach
# Caddy ONLY as set from Authelia's auth_request response (auth_request_set
# below); a client-sent copy is always overwritten, and an empty value makes
# nginx drop the header. X-Remote-* is no identity anywhere (anthive ignores
# it since 2.45); it is dropped too. Caddy in prod mode (caddy-auth.prod)
# trusts whatever nginx sends, so every proxied location must keep these lines.
#
# Keep the filled-in copy in your private server-config repo, NOT in anthive4.
# <CADDY_PORT> = this instance's Caddy listener; <AUTHELIA_PORT> = its Authelia.

# Mask personal MCP link tokens (/mcp/u/amcp_...) in the access log. map and
# log_format live at http level; a file in /etc/nginx/conf.d/ is included there.
# Several anthive vhosts on one nginx: keep ONE copy of these two blocks
# (a second copy is a duplicate log_format and fails nginx -t).
map $request_uri $anthive_log_uri {
    ~^(?<mcp_prefix>/mcp/u/)amcp_  "${mcp_prefix}amcp_REDACTED";
    default                        $request_uri;
}
log_format anthive_masked '$remote_addr - $remote_user [$time_local] '
                          '"$request_method $anthive_log_uri $server_protocol" '
                          '$status $body_bytes_sent "$http_referer" "$http_user_agent"';

server {
    listen 80;
    server_name <HOSTNAME>;
    return 301 https://<HOSTNAME>$request_uri;
}

server {
    listen 443 ssl http2;            # combined form: nginx 1.24 and 1.25+
    listen [::]:443 ssl http2;
    server_name <HOSTNAME>;

    ssl_certificate         /etc/nginx/cert/<CERT>.crt;
    ssl_certificate_key     /etc/nginx/cert/<CERT>.key;
    ssl_trusted_certificate /etc/nginx/cert/<CA>.crt;

    client_max_body_size 1024m;

    access_log /var/log/nginx/<HOSTNAME>-access.log anthive_masked;
    error_log  /var/log/nginx/<HOSTNAME>-error.log warn;

    # ── Authelia gate (server-level; locations opt out with auth_request off) ──
    auth_request /internal/authelia-verify;
    error_page 401 = @authelia_redirect;
    auth_request_set $auth_user   $upstream_http_remote_user;
    auth_request_set $auth_groups $upstream_http_remote_groups;
    auth_request_set $auth_email  $upstream_http_remote_email;
    auth_request_set $auth_name   $upstream_http_remote_name;

    # Authelia portal — never gated; proxied through Caddy.
    location ^~ /authelia/ {
        auth_request off;
        proxy_pass         http://127.0.0.1:<CADDY_PORT>;
        proxy_set_header   Host              $http_host;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   X-Forwarded-Host  $http_host;
        proxy_set_header   X-Forwarded-Uri   $request_uri;
    }

    # Browser verify endpoint — COOKIE ONLY (stale cached basic-auth is ignored,
    # so it can't trip Authelia's regulation/ban).
    location = /internal/authelia-verify {
        internal;
        proxy_pass                http://127.0.0.1:<AUTHELIA_PORT>/authelia/api/authz/auth-request;
        proxy_pass_request_body   off;
        proxy_set_header          Content-Length     "";
        proxy_set_header          Host               $http_host;
        proxy_set_header          X-Original-URL     $scheme://$http_host$request_uri;
        proxy_set_header          X-Original-Method  $request_method;
        proxy_set_header          X-Forwarded-Proto  $scheme;
    }

    # API verify endpoint — cookie first, then HTTP Basic (forwards Authorization).
    location = /internal/authelia-verify-api {
        internal;
        proxy_pass                http://127.0.0.1:<AUTHELIA_PORT>/authelia/api/authz/auth-request-api;
        proxy_pass_request_body   off;
        proxy_set_header          Content-Length     "";
        proxy_set_header          Host               $http_host;
        proxy_set_header          Authorization      $http_authorization;   # REQUIRED for basic
        proxy_set_header          X-Original-URL     $scheme://$http_host$request_uri;
        proxy_set_header          X-Original-Method  $request_method;
        proxy_set_header          X-Forwarded-Proto  $scheme;
    }

    location @authelia_redirect {
        return 302 https://$http_host/authelia/?rd=$scheme://$http_host$request_uri;
    }

    # Personal MCP links (/mcp/u/amcp_..., or Authorization: Bearer amcp_...
    # on /mcp): ant-mcp verifies the token itself, so no auth_request here,
    # and no client-sent identity or internal header gets through.
    location /mcp {
        auth_request off;
        proxy_pass http://127.0.0.1:<CADDY_PORT>;
        proxy_http_version 1.1;
        proxy_set_header Host              $http_host;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $http_host;
        proxy_set_header Remote-User       "";
        proxy_set_header Remote-Groups     "";
        proxy_set_header Remote-Email      "";
        proxy_set_header Remote-Name       "";
        proxy_set_header X-Remote-User     "";
        proxy_set_header X-Remote-Groups   "";
        proxy_set_header X-Remote-Email    "";
        proxy_set_header X-Remote-Name     "";
        proxy_set_header X-Anthive-Internal "";
        # MCP streamable HTTP uses long-lived SSE responses.
        proxy_buffering    off;
        proxy_read_timeout 3600s;
    }

    # Server-to-server routes; Caddy refuses them too.
    location /api/internal/ { return 403; }

    # REST API — cookie OR HTTP Basic. Forwarded to Caddy (strips /api).
    location /api/ {
        auth_request /internal/authelia-verify-api;
        proxy_pass http://127.0.0.1:<CADDY_PORT>;
        proxy_http_version 1.1;
        proxy_set_header Host              $http_host;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Remote-User       $auth_user;
        proxy_set_header Remote-Groups     $auth_groups;
        proxy_set_header Remote-Email      $auth_email;
        proxy_set_header Remote-Name       $auth_name;
        proxy_set_header X-Remote-User     "";
        proxy_set_header X-Remote-Groups   "";
        proxy_set_header X-Remote-Email    "";
        proxy_set_header X-Remote-Name     "";
        proxy_buffering    off;
        proxy_read_timeout 300s;
    }

    # Everything else → Caddy (cookie-gated by the server-level auth_request).
    # NOTE: deliberately NO `Connection: upgrade` here — it would blank the body
    # on normal GETs. Add a `map $http_upgrade $connection_upgrade` only for a
    # real WebSocket upstream.
    location / {
        proxy_pass http://127.0.0.1:<CADDY_PORT>;
        proxy_http_version 1.1;
        proxy_set_header Host              $http_host;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Remote-User       $auth_user;
        proxy_set_header Remote-Groups     $auth_groups;
        proxy_set_header Remote-Email      $auth_email;
        proxy_set_header Remote-Name       $auth_name;
        proxy_set_header X-Remote-User     "";
        proxy_set_header X-Remote-Groups   "";
        proxy_set_header X-Remote-Email    "";
        proxy_set_header X-Remote-Name     "";
    }
}
