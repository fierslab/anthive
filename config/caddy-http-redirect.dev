# Dev HTTP→HTTPS redirect companion — imported by config/Caddyfile when
# ANTHIVE_HTTP_REDIRECT_SNIPPET is unset (the default).
#
# A single TCP listener can't serve both http and https on the same port,
# so we offer a small adjacent HTTP listener on :8500 whose only job is
# the 301 redirect to the TLS site on :8501.
#
# Prod uses an empty snippet (caddy-http-redirect.prod) because :8500 IS
# the main Caddy listener in prod — nginx terminates TLS on :443 and
# forwards plain HTTP to 127.0.0.1:8500. A redirect block here would
# fight the main site for the same port.
http://localhost:8500, http://localhost.localdomain:8500, http://127.0.0.1:8500 {
	bind {$ANTHIVE_CADDY_BIND:0.0.0.0 ::}
	redir https://{host}:8501{uri} 301
}
