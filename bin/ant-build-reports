#!/usr/bin/env python3
"""
ant-build-reports — Pull report repos and build with mkdocs.

Reads the `reports` list from anthive.yaml, clones/pulls each repo,
then either:
  - build=mkdocs: runs `mkdocs build` in the repo to produce the site
  - build=static (or absent): copies a pre-built folder as-is

Output goes to webapp/report/<slug>/.

Usage:
    ant build-reports           # pull and build all reports
    ant build-reports --clean   # remove cached repos and built sites
"""

import argparse
import shutil
import subprocess
import sys
from pathlib import Path

import yaml


def _clone_or_pull(repo_url, repo_dir):
    """Clone or pull a git repo. Returns True on success."""
    if repo_dir.exists():
        print(f"    Pulling...")
        result = subprocess.run(
            ["git", "-C", str(repo_dir), "pull", "--ff-only", "-q"],
            capture_output=True, text=True,
        )
        if result.returncode != 0:
            print(f"    git pull failed, re-cloning...")
            shutil.rmtree(repo_dir)
        else:
            return True

    result = subprocess.run(
        ["git", "clone", "--depth=1", repo_url, str(repo_dir)],
        capture_output=True, text=True,
    )
    if result.returncode != 0:
        print(f"    FAILED: {result.stderr.strip()}")
        return False
    return True


def _build_mkdocs(repo_dir, dest_dir):
    """Run mkdocs build in repo_dir, output to dest_dir. Returns True on success."""
    mkdocs_yml = repo_dir / "mkdocs.yml"
    if not mkdocs_yml.exists():
        print(f"    ERROR: no mkdocs.yml found in repo root")
        return False

    if dest_dir.exists():
        shutil.rmtree(dest_dir)

    result = subprocess.run(
        ["uvx", "--with", "mkdocs-material",
         "--with", "mkdocs-bibtex",
         "--with", "mkdocs-table-reader-plugin",
         "mkdocs", "build",
         "--site-dir", str(dest_dir),
         "--quiet"],
        capture_output=True, text=True,
        cwd=str(repo_dir),
    )
    if result.returncode != 0:
        stderr = result.stderr.strip()
        # mkdocs warnings go to stderr but aren't fatal
        if "ERROR" in stderr or not dest_dir.exists():
            print(f"    mkdocs build FAILED:\n    {stderr[:500]}")
            return False
        if stderr:
            print(f"    (warnings: {stderr[:200]})")

    return dest_dir.exists()


def _build_quarto(repo_dir, dest_dir, report_cfg):
    """Render a repo's doc/ folder as a Quarto website.

    Looks for _quarto.yml in the doc_dir. If absent, generates one from
    the anthive template with the report's name and bib path.

    The bib file lives inside the repo (typically doc/literature/references.bib).
    """
    doc_dir = repo_dir / report_cfg.get("folder", "doc")
    if not doc_dir.exists():
        print(f"    ERROR: folder '{doc_dir.name}' not found in repo")
        return False

    # Find bib file: explicit config → scan doc_dir → scan repo root
    bib_path = None
    bib_cfg = report_cfg.get("bib")
    if bib_cfg:
        candidate = repo_dir / bib_cfg
        if candidate.exists():
            bib_path = candidate
        else:
            print(f"    WARNING: configured bib '{bib_cfg}' not found")
    if not bib_path:
        # Scan for .bib files under doc_dir and repo root
        bib_files = sorted(set(list(doc_dir.rglob("*.bib")) + list(repo_dir.glob("*.bib"))))
        if len(bib_files) == 1:
            bib_path = bib_files[0]
        elif len(bib_files) > 1:
            print(f"    WARNING: {len(bib_files)} .bib files found — set 'bib:' in config to pick one:")
            for b in bib_files:
                print(f"      {b.relative_to(repo_dir)}")
            bib_path = bib_files[0]
            print(f"    Using: {bib_path.relative_to(repo_dir)}")

    # Generate _quarto.yml if not present in doc_dir
    quarto_yml = doc_dir / "_quarto.yml"
    generated_yml = False
    if not quarto_yml.exists():
        name = report_cfg.get("name", "Report")
        cfg_lines = [
            "project:",
            "  type: website",
            f"  output-dir: {dest_dir}",
            "",
            "website:",
            f'  title: "{name}"',
            "  navbar:",
            "    left:",
            '      - text: "Anthive"',
            '        href: https://data.nevel.eu/',
            "",
            "format:",
            "  html:",
            "    theme: cosmo",
            "    toc: true",
            "    toc-depth: 3",
            "    code-fold: true",
            "    css: []",
        ]
        if bib_path:
            # Path relative to doc_dir
            try:
                rel_bib = bib_path.relative_to(doc_dir)
            except ValueError:
                rel_bib = bib_path.relative_to(repo_dir)
            cfg_lines.extend([
                "",
                f"bibliography: {rel_bib}",
                "csl: https://raw.githubusercontent.com/citation-style-language/styles/master/nature.csl",
            ])

        quarto_yml.write_text("\n".join(cfg_lines) + "\n")
        generated_yml = True
        print(f"    Generated _quarto.yml" + (f" (bib: {bib_path.name})" if bib_path else ""))
    else:
        # Patch output-dir into existing _quarto.yml so output goes to our dest
        existing = yaml.safe_load(quarto_yml.read_text()) or {}
        project = existing.get("project", {})
        project["output-dir"] = str(dest_dir)
        existing["project"] = project
        quarto_yml.write_text(yaml.dump(existing, default_flow_style=False, sort_keys=False))
        print(f"    Patched output-dir in existing _quarto.yml")

    if dest_dir.exists():
        shutil.rmtree(dest_dir)

    result = subprocess.run(
        ["quarto", "render", str(doc_dir)],
        capture_output=True, text=True,
        cwd=str(repo_dir),
    )

    # Clean up generated yml
    if generated_yml and quarto_yml.exists():
        quarto_yml.unlink()

    if result.returncode != 0:
        stderr = result.stderr.strip()
        print(f"    quarto render FAILED:\n    {stderr[:500]}")
        return False

    if result.stderr:
        warnings = [l for l in result.stderr.strip().split('\n') if 'WARN' in l]
        if warnings:
            print(f"    ({len(warnings)} warnings)")

    return dest_dir.exists()


def _build_static(repo_dir, folder, dest_dir):
    """Copy a pre-built static folder. Returns True on success."""
    src = repo_dir / folder
    if not src.exists():
        print(f"    ERROR: folder '{folder}' not found in repo")
        dirs = [p.name for p in repo_dir.iterdir() if p.is_dir() and not p.name.startswith('.')]
        print(f"    Available: {dirs}")
        return False

    if dest_dir.exists():
        shutil.rmtree(dest_dir)
    shutil.copytree(src, dest_dir)
    return True


def main():
    parser = argparse.ArgumentParser(description="Pull and build report sites from git")
    parser.add_argument("--clean", action="store_true", help="Remove cache and output dirs")
    args = parser.parse_args()

    root = Path(__file__).parent.parent.resolve()
    config_path = root / "anthive.yaml"
    if not config_path.exists():
        config_path = root / "anthive.default.yaml"

    with open(config_path) as f:
        config = yaml.safe_load(f) or {}

    reports = config.get("reports", [])
    if not reports:
        print("No reports configured in anthive.yaml")
        return 0

    cache_dir = root / "tmp" / "report-repos"
    output_dir = root / "webapp" / "report"

    if args.clean:
        for d in [cache_dir, output_dir]:
            if d.exists():
                shutil.rmtree(d)
                print(f"Removed {d}")
        return 0

    cache_dir.mkdir(parents=True, exist_ok=True)
    output_dir.mkdir(parents=True, exist_ok=True)

    for report in reports:
        name = report.get("name", "?")
        repo = report.get("repo")
        slug = report.get("slug")
        build = report.get("build", "static")
        folder = report.get("folder", ".")

        if not repo or not slug:
            print(f"  SKIP {name}: missing repo or slug")
            continue

        print(f"  {name} ({slug}, build={build})")
        repo_dir = cache_dir / slug

        if not _clone_or_pull(repo, repo_dir):
            continue

        dest = output_dir / slug

        if build == "mkdocs":
            ok = _build_mkdocs(repo_dir, dest)
        elif build == "quarto":
            ok = _build_quarto(repo_dir, dest, report)
        else:
            ok = _build_static(repo_dir, folder, dest)

        if ok:
            n_files = sum(1 for _ in dest.rglob("*") if _.is_file())
            print(f"    -> /report/{slug}/ ({n_files} files)")
        else:
            print(f"    FAILED")

    print(f"\nDone.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
