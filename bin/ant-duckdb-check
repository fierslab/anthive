"""
ant-duckdb-check - Validate DuckDB database integrity

Checks DuckDB files against h5ad metadata to ensure correct structure,
table existence, row counts, and data integrity.

Use --deep flag for extensive data integrity checks (slower, loads h5ad file).
"""

import argparse
import sys
from pathlib import Path
from typing import Dict, List, Tuple, Optional

import duckdb

# Add lib directory to Python path
script_dir = Path(__file__).parent.resolve()
lib_dir = script_dir.parent / 'lib'
sys.path.insert(0, str(lib_dir))

from metadata import parse_md_file, MetadataError


class DuckDBCheckReport:
    """Accumulator for check results"""
    def __init__(self):
        self.missing_tables = []
        self.extra_tables = []
        self.size_mismatches = []
        self.missing_views = []
        self.warnings = []
        self.info = []
        self.orphaned_tables = []
        self.data_mismatches = []
        self.deep_checks_passed = 0

    def has_errors(self) -> bool:
        """Check if there are any errors"""
        return (
            len(self.missing_tables) > 0 or
            len(self.size_mismatches) > 0 or
            len(self.data_mismatches) > 0
        )

    def has_warnings(self) -> bool:
        """Check if there are any warnings"""
        return (
            len(self.extra_tables) > 0 or
            len(self.missing_views) > 0 or
            len(self.warnings) > 0 or
            len(self.orphaned_tables) > 0
        )

    def print_summary(self):
        """Print summary of findings"""
        if not self.has_errors() and not self.has_warnings() and not self.info:
            return

        print("\nCheck Summary:")
        print()

        # Errors
        if self.missing_tables:
            print("✗ Missing required tables:")
            for table in self.missing_tables:
                print(f"  - {table}")
            print()

        if self.size_mismatches:
            print("✗ Table size mismatches:")
            for msg in self.size_mismatches:
                print(f"  - {msg}")
            print()

        if self.data_mismatches:
            print("✗ Data integrity mismatches:")
            # Show first 20 mismatches, summarize rest
            for msg in self.data_mismatches[:20]:
                print(f"  - {msg}")
            if len(self.data_mismatches) > 20:
                print(f"  ... and {len(self.data_mismatches) - 20} more mismatches")
            print()

        # Warnings
        if self.orphaned_tables:
            print("⚠ Orphaned tables (not in metadata):")
            for table in self.orphaned_tables:
                print(f"  - {table}")
            print()

        if self.missing_views:
            print("⚠ Missing views:")
            for view in self.missing_views:
                print(f"  - {view}")
            print()

        if self.warnings:
            for warning in self.warnings:
                print(f"⚠ {warning}")
            print()

        # Info
        if self.info:
            for info in self.info:
                print(f"ℹ {info}")
            print()


def format_size(size_bytes: int) -> str:
    """Format file size for display"""
    for unit in ['B', 'KB', 'MB', 'GB']:
        if size_bytes < 1024.0:
            return f"{size_bytes:.1f} {unit}"
        size_bytes /= 1024.0
    return f"{size_bytes:.1f} TB"


def get_table_list(conn: duckdb.DuckDBPyConnection) -> List[str]:
    """Get list of all tables in database"""
    result = conn.execute("SELECT name FROM sqlite_master WHERE type='table'").fetchall()
    return [row[0] for row in result]


def get_view_list(conn: duckdb.DuckDBPyConnection) -> List[str]:
    """Get list of all views in database"""
    result = conn.execute("SELECT name FROM sqlite_master WHERE type='view'").fetchall()
    return [row[0] for row in result]


def get_table_row_count(conn: duckdb.DuckDBPyConnection, table_name: str) -> int:
    """Get row count for a table"""
    try:
        result = conn.execute(f"SELECT COUNT(*) FROM {table_name}").fetchone()
        return result[0] if result else 0
    except Exception:
        return -1


def check_schema(conn: duckdb.DuckDBPyConnection, report: DuckDBCheckReport) -> Optional[int]:
    """Check schema version

    Returns:
        Schema version if valid, None if invalid
    """
    tables = get_table_list(conn)

    if '__schema_version' not in tables:
        report.warnings.append("Missing __schema_version table")
        return None

    try:
        result = conn.execute("SELECT version FROM __schema_version ORDER BY version DESC LIMIT 1").fetchone()
        if result:
            schema_version = result[0]
            if schema_version != 1:
                report.warnings.append(f"Unexpected schema version: {schema_version} (expected 1)")
            return schema_version
    except Exception as e:
        report.warnings.append(f"Failed to read schema version: {e}")
        return None


def check_core_tables(conn: duckdb.DuckDBPyConnection, metadata: dict, report: DuckDBCheckReport) -> bool:
    """Check core tables (__cells, __genes)

    Returns:
        True if core tables are valid
    """
    tables = get_table_list(conn)
    expected_n_obs = metadata.get('n_obs', 0)
    expected_n_vars = metadata.get('n_vars', 0)

    # Check __cells
    if '__cells' not in tables:
        report.missing_tables.append('__cells')
        return False
    else:
        cell_count = get_table_row_count(conn, '__cells')
        if cell_count != expected_n_obs:
            report.size_mismatches.append(
                f"__cells: has {cell_count:,} rows, expected {expected_n_obs:,}"
            )

    # Check __genes
    if '__genes' not in tables:
        report.missing_tables.append('__genes')
        return False
    else:
        gene_count = get_table_row_count(conn, '__genes')
        if gene_count != expected_n_vars:
            report.size_mismatches.append(
                f"__genes: has {gene_count:,} rows, expected {expected_n_vars:,}"
            )

    return len(report.missing_tables) == 0 and len(report.size_mismatches) == 0


def check_layer_tables(conn: duckdb.DuckDBPyConnection, metadata: dict, report: DuckDBCheckReport):
    """Check layer tables"""
    tables = get_table_list(conn)
    layers_include = metadata.get('layers_include', [])

    if not layers_include:
        report.info.append("No layers to check")
        return

    for layer_key in layers_include:
        # Layer tables are stored as __layer__{layer_key}
        table_name = f"__layer__{layer_key}"

        if table_name not in tables:
            report.missing_tables.append(f"{table_name} (layer)")


def check_obs_tables(conn: duckdb.DuckDBPyConnection, metadata: dict, report: DuckDBCheckReport):
    """Check observation tables

    Obs columns are stored in TWO tables: __obsnum and __obscat
    """
    tables = get_table_list(conn)
    expected_n_obs = metadata.get('n_obs', 0)

    obsnum_include = metadata.get('obsnum_include', [])
    obscat_include = metadata.get('obscat_include', [])

    # Check if __obsnum table exists (only if there are numerical obs columns)
    if obsnum_include:
        if '__obsnum' not in tables:
            report.missing_tables.append('__obsnum (numerical obs columns)')
        else:
            # Check row count
            row_count = get_table_row_count(conn, '__obsnum')
            if row_count != expected_n_obs and row_count >= 0:
                report.size_mismatches.append(
                    f"__obsnum: has {row_count:,} rows, expected {expected_n_obs:,}"
                )

            # Check if all columns exist
            try:
                result = conn.execute("PRAGMA table_info(__obsnum)").fetchall()
                column_names = [row[1] for row in result]  # column name is at index 1

                for col_name in obsnum_include:
                    if col_name not in column_names:
                        report.missing_tables.append(f"__obsnum.{col_name} (numerical obs column missing)")
            except Exception as e:
                report.warnings.append(f"Could not check __obsnum columns: {e}")

    # Check if __obscat table exists (only if there are categorical obs columns)
    if obscat_include:
        if '__obscat' not in tables:
            report.missing_tables.append('__obscat (categorical obs columns)')
        else:
            # Check row count
            row_count = get_table_row_count(conn, '__obscat')
            if row_count != expected_n_obs and row_count >= 0:
                report.size_mismatches.append(
                    f"__obscat: has {row_count:,} rows, expected {expected_n_obs:,}"
                )

            # Check if all columns exist
            try:
                result = conn.execute("PRAGMA table_info(__obscat)").fetchall()
                column_names = [row[1] for row in result]  # column name is at index 1

                for col_name in obscat_include:
                    if col_name not in column_names:
                        report.missing_tables.append(f"__obscat.{col_name} (categorical obs column missing)")
            except Exception as e:
                report.warnings.append(f"Could not check __obscat columns: {e}")


def check_var_tables(conn: duckdb.DuckDBPyConnection, metadata: dict, report: DuckDBCheckReport):
    """Check variable tables

    Var columns are stored in TWO tables: __varnum and __varcat
    """
    tables = get_table_list(conn)
    expected_n_vars = metadata.get('n_vars', 0)

    var_include = metadata.get('var_include', [])

    if not var_include:
        return

    # Determine which columns are numerical vs categorical by checking the actual tables
    has_varnum = '__varnum' in tables
    has_varcat = '__varcat' in tables

    if has_varnum:
        # Check __varnum row count
        row_count = get_table_row_count(conn, '__varnum')
        if row_count != expected_n_vars and row_count >= 0:
            report.size_mismatches.append(
                f"__varnum: has {row_count:,} rows, expected {expected_n_vars:,}"
            )

    if has_varcat:
        # Check __varcat row count
        row_count = get_table_row_count(conn, '__varcat')
        if row_count != expected_n_vars and row_count >= 0:
            report.size_mismatches.append(
                f"__varcat: has {row_count:,} rows, expected {expected_n_vars:,}"
            )

    # Check if columns exist in either table
    for col_name in var_include:
        found = False

        if has_varnum:
            try:
                result = conn.execute("PRAGMA table_info(__varnum)").fetchall()
                column_names = [row[1] for row in result]
                if col_name in column_names:
                    found = True
            except Exception:
                pass

        if not found and has_varcat:
            try:
                result = conn.execute("PRAGMA table_info(__varcat)").fetchall()
                column_names = [row[1] for row in result]
                if col_name in column_names:
                    found = True
            except Exception:
                pass

        if not found:
            report.missing_tables.append(f"var column '{col_name}' (not in __varnum or __varcat)")


def check_embedding_tables(conn: duckdb.DuckDBPyConnection, metadata: dict, report: DuckDBCheckReport):
    """Check embedding tables"""
    tables = get_table_list(conn)
    expected_n_obs = metadata.get('n_obs', 0)

    obsm_include = metadata.get('obsm_include', [])
    for obsm_key in obsm_include:
        # Embeddings are stored as __obsm__{obsm_key}
        table_name = f"__obsm__{obsm_key}"

        if table_name not in tables:
            report.missing_tables.append(f"{table_name} (embedding)")
        else:
            row_count = get_table_row_count(conn, table_name)
            if row_count != expected_n_obs and row_count >= 0:
                report.size_mismatches.append(
                    f"{table_name}: has {row_count:,} rows, expected {expected_n_obs:,}"
                )


def check_views(conn: duckdb.DuckDBPyConnection, report: DuckDBCheckReport):
    """Check required views exist"""
    views = get_view_list(conn)
    required_views = ['cells', 'genes']

    for view_name in required_views:
        if view_name not in views:
            report.missing_views.append(view_name)


def check_orphaned_tables(conn: duckdb.DuckDBPyConnection, metadata: dict, report: DuckDBCheckReport):
    """Find tables that exist but aren't in metadata"""
    tables = get_table_list(conn)

    # Build set of expected tables
    expected_tables = {
        '__schema_version',
        '__cells',
        '__genes',
    }

    # Add layer tables
    for layer_key in metadata.get('layers_include', []):
        expected_tables.add(f"__layer__{layer_key}")

    # Add obs tables (single tables for all columns)
    if metadata.get('obsnum_include'):
        expected_tables.add('__obsnum')
    if metadata.get('obscat_include'):
        expected_tables.add('__obscat')

    # Add var tables (single tables for all columns)
    if metadata.get('var_include'):
        expected_tables.add('__varnum')
        expected_tables.add('__varcat')

    # Add embedding tables
    for obsm_key in metadata.get('obsm_include', []):
        expected_tables.add(f"__obsm__{obsm_key}")

    # Find orphans
    for table in tables:
        if table not in expected_tables:
            report.orphaned_tables.append(table)


def run_integrity_checks(conn: duckdb.DuckDBPyConnection, report: DuckDBCheckReport) -> bool:
    """Run basic integrity checks

    Returns:
        True if integrity checks pass
    """
    try:
        # Try to query core tables
        conn.execute("SELECT 1 FROM __cells LIMIT 1").fetchone()
        conn.execute("SELECT 1 FROM __genes LIMIT 1").fetchone()
        return True
    except Exception as e:
        report.warnings.append(f"Integrity check failed: {e}")
        return False


def cleanup_wal(duckdb_path: Path, report: DuckDBCheckReport):
    """Clean up WAL file if present"""
    wal_path = Path(str(duckdb_path) + '.wal')

    if not wal_path.exists():
        return

    wal_size = wal_path.stat().st_size
    report.info.append(f"Found WAL file: {wal_path.name} ({format_size(wal_size)})")

    try:
        conn = duckdb.connect(str(duckdb_path), read_only=False)
        conn.execute("CHECKPOINT")
        conn.close()

        if wal_path.exists():
            wal_path.unlink()
            report.info.append("Cleaned up WAL file")
    except Exception as e:
        report.warnings.append(f"Failed to clean up WAL: {e}")


def deep_check_layers(conn: duckdb.DuckDBPyConnection, adata, metadata: dict, report: DuckDBCheckReport, num_samples: int = 100):
    """Deep check: Compare layer expression values between h5ad and DuckDB

    Args:
        conn: DuckDB connection
        adata: AnnData object
        metadata: Metadata dictionary
        report: Check report
        num_samples: Number of genes to sample and check (default: 100)
    """
    import numpy as np
    import scipy.sparse

    layers_include = metadata.get('layers_include', [])

    if not layers_include:
        return

    print("\n[Deep Check] Verifying layer expression values...")

    # Get cell and gene mappings from database
    cell_result = conn.execute("SELECT cell_id, cell_name FROM __cells ORDER BY cell_id").fetchall()
    gene_result = conn.execute("SELECT gene_id, gene_name FROM __genes ORDER BY gene_id").fetchall()

    cell_id_to_name = {row[0]: row[1] for row in cell_result}
    gene_id_to_name = {row[0]: row[1] for row in gene_result}
    gene_name_to_id = {row[1]: row[0] for row in gene_result}

    for layer_key in layers_include:
        # Get layer data from h5ad
        if layer_key == 'X':
            if adata.X is None:
                continue
            layer_data = adata.X
        else:
            if layer_key not in adata.layers:
                continue
            layer_data = adata.layers[layer_key]

        # Sample genes to check
        n_genes = min(num_samples, adata.n_vars)
        gene_indices = np.random.choice(adata.n_vars, size=n_genes, replace=False)

        mismatches = 0
        checks = 0

        for gene_idx in gene_indices:
            gene_name = adata.var_names[gene_idx]

            if gene_name not in gene_name_to_id:
                report.data_mismatches.append(f"Layer {layer_key}: gene '{gene_name}' not in database")
                continue

            gene_id = gene_name_to_id[gene_name]

            # Get values from h5ad
            if scipy.sparse.issparse(layer_data):
                h5ad_values = layer_data[:, gene_idx].toarray().flatten()
            else:
                h5ad_values = layer_data[:, gene_idx].flatten()

            # Get values from DuckDB
            table_name = f"__layer__{layer_key}"
            query = f"""
                SELECT cell_id, value
                FROM {table_name}
                WHERE gene_id = {gene_id}
                ORDER BY cell_id
            """
            db_result = conn.execute(query).fetchall()

            # Build sparse representation from DuckDB (zeros implicit)
            db_values = np.zeros(adata.n_obs)
            for cell_id, value in db_result:
                db_values[cell_id] = value

            # Compare values (with tolerance for floating point)
            if not np.allclose(h5ad_values, db_values, rtol=1e-5, atol=1e-8):
                diff_mask = ~np.isclose(h5ad_values, db_values, rtol=1e-5, atol=1e-8)
                num_diffs = np.sum(diff_mask)
                mismatches += 1
                report.data_mismatches.append(
                    f"Layer {layer_key}, gene '{gene_name}': {num_diffs} cells have different values"
                )

            checks += 1

        if mismatches == 0:
            print(f"  ✓ Layer {layer_key}: {checks} genes checked, all match")
            report.deep_checks_passed += 1
        else:
            print(f"  ✗ Layer {layer_key}: {mismatches}/{checks} genes have mismatches")


def deep_check_obs(conn: duckdb.DuckDBPyConnection, adata, metadata: dict, report: DuckDBCheckReport, num_samples: int = 100):
    """Deep check: Compare obs table values between h5ad and DuckDB

    Args:
        conn: DuckDB connection
        adata: AnnData object
        metadata: Metadata dictionary
        report: Check report
        num_samples: Number of cells to sample and check (default: 100)
    """
    import numpy as np
    import pandas as pd

    obsnum_include = metadata.get('obsnum_include', [])
    obscat_include = metadata.get('obscat_include', [])

    if not obsnum_include and not obscat_include:
        return

    print("\n[Deep Check] Verifying obs table values...")

    # Get cell mapping
    cell_result = conn.execute("SELECT cell_id, cell_name FROM __cells ORDER BY cell_id").fetchall()
    cell_name_to_id = {row[1]: row[0] for row in cell_result}

    # Sample cells to check
    n_cells = min(num_samples, adata.n_obs)
    cell_indices = np.random.choice(adata.n_obs, size=n_cells, replace=False)

    # Check numerical obs columns
    if obsnum_include:
        mismatches = 0
        checks = 0

        for cell_idx in cell_indices:
            cell_name = adata.obs_names[cell_idx]
            cell_id = cell_name_to_id.get(cell_name)

            if cell_id is None:
                continue

            # Get values from DuckDB
            query = f"SELECT * FROM __obsnum WHERE cell_id = {cell_id}"
            db_result = conn.execute(query).fetchdf()

            if len(db_result) == 0:
                report.data_mismatches.append(f"Obs: cell '{cell_name}' not in __obsnum table")
                continue

            # Compare each column
            for col in obsnum_include:
                if col not in adata.obs.columns:
                    continue

                h5ad_value = adata.obs.loc[cell_name, col]
                db_value = db_result[col].iloc[0]

                # Handle NaN comparison
                if pd.isna(h5ad_value) and pd.isna(db_value):
                    checks += 1
                    continue

                if not np.isclose(h5ad_value, db_value, rtol=1e-5, atol=1e-8, equal_nan=True):
                    mismatches += 1
                    report.data_mismatches.append(
                        f"Obs numerical: cell '{cell_name}', column '{col}': h5ad={h5ad_value}, db={db_value}"
                    )

                checks += 1

        if mismatches == 0:
            print(f"  ✓ Obs numerical: {checks} values checked, all match")
            report.deep_checks_passed += 1
        else:
            print(f"  ✗ Obs numerical: {mismatches}/{checks} values have mismatches")

    # Check categorical obs columns
    if obscat_include:
        mismatches = 0
        checks = 0

        for cell_idx in cell_indices:
            cell_name = adata.obs_names[cell_idx]
            cell_id = cell_name_to_id.get(cell_name)

            if cell_id is None:
                continue

            # Get values from DuckDB
            query = f"SELECT * FROM __obscat WHERE cell_id = {cell_id}"
            db_result = conn.execute(query).fetchdf()

            if len(db_result) == 0:
                report.data_mismatches.append(f"Obs: cell '{cell_name}' not in __obscat table")
                continue

            # Compare each column
            for col in obscat_include:
                if col not in adata.obs.columns:
                    continue

                h5ad_value = str(adata.obs.loc[cell_name, col])
                db_value = str(db_result[col].iloc[0])

                # Handle NaN/None comparison
                if h5ad_value in ['nan', 'None'] and db_value in ['nan', 'None', 'null']:
                    checks += 1
                    continue

                if h5ad_value != db_value:
                    mismatches += 1
                    report.data_mismatches.append(
                        f"Obs categorical: cell '{cell_name}', column '{col}': h5ad='{h5ad_value}', db='{db_value}'"
                    )

                checks += 1

        if mismatches == 0:
            print(f"  ✓ Obs categorical: {checks} values checked, all match")
            report.deep_checks_passed += 1
        else:
            print(f"  ✗ Obs categorical: {mismatches}/{checks} values have mismatches")


def deep_check_embeddings(conn: duckdb.DuckDBPyConnection, adata, metadata: dict, report: DuckDBCheckReport, num_samples: int = 100):
    """Deep check: Compare embedding coordinates between h5ad and DuckDB

    Args:
        conn: DuckDB connection
        adata: AnnData object
        metadata: Metadata dictionary
        report: Check report
        num_samples: Number of cells to sample and check (default: 100)
    """
    import numpy as np
    import pandas as pd

    obsm_include = metadata.get('obsm_include', [])

    if not obsm_include:
        return

    print("\n[Deep Check] Verifying embedding coordinates...")

    # Get cell mapping
    cell_result = conn.execute("SELECT cell_id, cell_name FROM __cells ORDER BY cell_id").fetchall()
    cell_name_to_id = {row[1]: row[0] for row in cell_result}

    # Sample cells to check
    n_cells = min(num_samples, adata.n_obs)
    cell_indices = np.random.choice(adata.n_obs, size=n_cells, replace=False)

    for obsm_key in obsm_include:
        if obsm_key not in adata.obsm:
            continue

        embedding = adata.obsm[obsm_key]
        if isinstance(embedding, pd.DataFrame):
            embedding = embedding.values

        mismatches = 0
        checks = 0

        for cell_idx in cell_indices:
            cell_name = adata.obs_names[cell_idx]
            cell_id = cell_name_to_id.get(cell_name)

            if cell_id is None:
                continue

            # Get h5ad coordinates
            h5ad_coords = embedding[cell_idx]

            # Get DuckDB coordinates (limit to 4 dimensions as in convert)
            table_name = f"__obsm__{obsm_key}"
            query = f"SELECT * FROM {table_name} WHERE cell_id = {cell_id}"
            db_result = conn.execute(query).fetchdf()

            if len(db_result) == 0:
                report.data_mismatches.append(f"Embedding {obsm_key}: cell '{cell_name}' not in table")
                continue

            # Extract dimension columns
            dim_cols = [col for col in db_result.columns if col.startswith('dim_')]
            db_coords = db_result[dim_cols].values.flatten()

            # Compare (only first N dimensions stored in DB)
            n_dims = len(db_coords)
            h5ad_coords_subset = h5ad_coords[:n_dims]

            if not np.allclose(h5ad_coords_subset, db_coords, rtol=1e-5, atol=1e-8, equal_nan=True):
                mismatches += 1
                report.data_mismatches.append(
                    f"Embedding {obsm_key}: cell '{cell_name}' coordinates differ"
                )

            checks += 1

        if mismatches == 0:
            print(f"  ✓ Embedding {obsm_key}: {checks} cells checked, all match")
            report.deep_checks_passed += 1
        else:
            print(f"  ✗ Embedding {obsm_key}: {mismatches}/{checks} cells have mismatches")


def run_deep_checks(conn: duckdb.DuckDBPyConnection, h5ad_path: Path, metadata: dict, report: DuckDBCheckReport):
    """Run deep data integrity checks by loading h5ad and comparing values

    Args:
        conn: DuckDB connection
        h5ad_path: Path to h5ad file
        metadata: Metadata dictionary
        report: Check report
    """
    print("\n" + "="*70)
    print("DEEP DATA INTEGRITY CHECKS")
    print("="*70)
    print(f"\nLoading h5ad file: {h5ad_path.name}")

    # Lazy imports (only needed for deep checks)
    try:
        from h5ad_utils import load_h5ad
    except ImportError:
        report.warnings.append("Cannot perform deep checks: h5ad_utils not available")
        return

    # Load h5ad file
    try:
        adata = load_h5ad(h5ad_path)
        print(f"  ✓ Loaded ({adata.n_obs:,} cells × {adata.n_vars:,} genes)")
    except Exception as e:
        report.warnings.append(f"Cannot load h5ad file for deep checks: {e}")
        return

    # Run deep checks
    deep_check_layers(conn, adata, metadata, report, num_samples=100)
    deep_check_obs(conn, adata, metadata, report, num_samples=100)
    deep_check_embeddings(conn, adata, metadata, report, num_samples=100)

    print()
    if report.data_mismatches:
        print(f"✗ Deep checks found {len(report.data_mismatches)} data mismatches")
    else:
        print(f"✓ Deep checks passed ({report.deep_checks_passed} tests)")


def main():
    """Main entry point"""

    parser = argparse.ArgumentParser(
        description='Check DuckDB database integrity',
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument('file', help='Path to .h5ad or .duckdb file')
    parser.add_argument('--clean-wal', action='store_true',
                       help='Clean up orphaned WAL file if present')
    parser.add_argument('--verbose', action='store_true',
                       help='Show detailed information')
    parser.add_argument('--deep', action='store_true',
                       help='Perform deep data integrity checks (loads h5ad file, samples ~100 genes/cells)')

    args = parser.parse_args()

    # Convert to Path
    input_path = Path(args.file).resolve()

    # Determine duckdb and metadata paths
    if input_path.suffix == '.h5ad':
        duckdb_path = input_path.with_suffix('.duckdb')
        md_path = input_path.with_suffix('.md')
    elif input_path.suffix == '.duckdb':
        duckdb_path = input_path
        md_path = input_path.with_suffix('.md')
    else:
        print(f"ERROR: [ant-duckdb-check] Unsupported file type", file=sys.stderr)
        print(f"Details: File must be .h5ad or .duckdb", file=sys.stderr)
        print(f"Location: {input_path}", file=sys.stderr)
        sys.exit(1)

    # Check files exist
    if not duckdb_path.exists():
        print(f"ERROR: [ant-duckdb-check] DuckDB file not found", file=sys.stderr)
        print(f"Location: {duckdb_path}", file=sys.stderr)
        print(f"Action: Run 'ant convert' to create DuckDB file", file=sys.stderr)
        sys.exit(3)

    if not md_path.exists():
        print(f"ERROR: [ant-duckdb-check] Metadata file not found", file=sys.stderr)
        print(f"Location: {md_path}", file=sys.stderr)
        print(f"Action: Run 'ant h5ad-check' to create metadata file", file=sys.stderr)
        sys.exit(3)

    print(f"{'='*70}")
    print(f"CHECKING: {duckdb_path.name}")
    print(f"{'='*70}")
    print()

    # Show file size
    db_size = duckdb_path.stat().st_size
    print(f"Database size: {format_size(db_size)}")
    print()

    # Load metadata
    print("[1/9] Loading metadata...")
    try:
        metadata, _ = parse_md_file(md_path)
        print(f"  ✓ Loaded from {md_path.name}")
        print(f"    - Expected cells: {metadata.get('n_obs', 0):,}")
        print(f"    - Expected genes: {metadata.get('n_vars', 0):,}")
    except MetadataError as e:
        print(f"  ✗ Failed to load metadata: {e}", file=sys.stderr)
        sys.exit(1)

    # Initialize report
    report = DuckDBCheckReport()

    try:
        # Open database
        print(f"\n[2/9] Opening database...")
        conn = duckdb.connect(str(duckdb_path), read_only=True)
        print("  ✓ Connected successfully")

        # Check schema
        print(f"\n[3/9] Checking schema...")
        schema_version = check_schema(conn, report)
        if schema_version:
            print(f"  ✓ Schema version: {schema_version}")
        else:
            print("  ⚠ Schema version check failed")

        # Check core tables
        print(f"\n[4/9] Checking core tables...")
        if check_core_tables(conn, metadata, report):
            print("  ✓ Core tables validated")
        else:
            print("  ✗ Core table validation failed")

        # Check layers
        print(f"\n[5/9] Checking layer tables...")
        check_layer_tables(conn, metadata, report)
        num_layers = len(metadata.get('layers_include', []))
        if num_layers > 0:
            print(f"  ✓ Checked {num_layers} layer(s)")
        else:
            print("  ℹ No layers to check")

        # Check obs tables
        print(f"\n[6/9] Checking observation tables...")
        check_obs_tables(conn, metadata, report)
        num_obs = len(metadata.get('obsnum_include', [])) + len(metadata.get('obscat_include', []))
        if num_obs > 0:
            print(f"  ✓ Checked {num_obs} obs column(s)")
        else:
            print("  ℹ No obs columns to check")

        # Check var tables
        print(f"\n[7/9] Checking variable tables...")
        check_var_tables(conn, metadata, report)
        num_var = len(metadata.get('var_include', []))
        if num_var > 0:
            print(f"  ✓ Checked {num_var} var column(s)")
        else:
            print("  ℹ No var columns to check")

        # Check embeddings
        print(f"\n[8/9] Checking embedding tables...")
        check_embedding_tables(conn, metadata, report)
        num_embeddings = len(metadata.get('obsm_include', []))
        if num_embeddings > 0:
            print(f"  ✓ Checked {num_embeddings} embedding(s)")
        else:
            print("  ℹ No embeddings to check")

        # Check views
        print(f"\n[9/9] Checking views...")
        check_views(conn, report)
        views = get_view_list(conn)
        print(f"  ✓ Found {len(views)} view(s)")

        # Check for orphaned tables
        if args.verbose:
            print(f"\nChecking for orphaned tables...")
            check_orphaned_tables(conn, metadata, report)

        # Run integrity checks
        if run_integrity_checks(conn, report):
            print("\n  ✓ Integrity checks passed")

        # Run deep data integrity checks if requested
        if args.deep:
            # Need h5ad file for deep checks
            if input_path.suffix == '.h5ad':
                h5ad_path = input_path
            elif input_path.suffix == '.duckdb':
                h5ad_path = input_path.with_suffix('.h5ad')
            else:
                h5ad_path = None

            if h5ad_path and h5ad_path.exists():
                run_deep_checks(conn, h5ad_path, metadata, report)
            else:
                print("\n⚠ Cannot run deep checks: h5ad file not found")
                print(f"  Expected: {h5ad_path}")
                report.warnings.append("Deep checks skipped (h5ad file not found)")

        conn.close()

        # Clean up WAL if requested
        if args.clean_wal:
            print("\nCleaning up WAL file...")
            cleanup_wal(duckdb_path, report)

        # Print summary
        report.print_summary()

        # Final status
        print(f"{'='*70}")
        if report.has_errors():
            print("✗ CHECK FAILED - Errors found")
            print(f"{'='*70}")
            sys.exit(1)
        elif report.has_warnings():
            print("⚠ CHECK COMPLETED - Warnings found")
            print(f"{'='*70}")
            print("\nDatabase is functional but has warnings.")
            sys.exit(0)
        else:
            print("✓ CHECK COMPLETED SUCCESSFULLY")
            print(f"{'='*70}")
            print("\nDatabase is healthy and matches metadata.")
            sys.exit(0)

    except KeyboardInterrupt:
        print("\n\nInterrupted by user", file=sys.stderr)
        sys.exit(130)
    except Exception as error:
        print(f"\nERROR: [ant-duckdb-check] Unexpected error", file=sys.stderr)
        print(f"Details: {error}", file=sys.stderr)
        print(f"Location: {duckdb_path}", file=sys.stderr)
        import traceback
        traceback.print_exc()
        sys.exit(1)


if __name__ == '__main__':
    main()
