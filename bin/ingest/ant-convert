class ConversionError(Exception):
    """Conversion-related errors"""
    pass


def apply_layer_cli_overrides(metadata: Dict, include_layers: List[str], exclude_layers: List[str]) -> None:
    """Apply --include-layer / --exclude-layer CLI overrides to metadata (in-place).

    Does NOT write back to the .md file — changes apply to this conversion only.
    """
    layers_include = metadata.setdefault('layers_include', [])
    layers_exclude = metadata.setdefault('layers_exclude', [])

    for layer in exclude_layers:
        if layer in layers_include:
            layers_include.remove(layer)
            print(f"  CLI override: removed '{layer}' from layers_include")
        if layer not in layers_exclude:
            layers_exclude.append(layer)

    for layer in include_layers:
        if layer in layers_exclude:
            layers_exclude.remove(layer)
            print(f"  CLI override: removed '{layer}' from layers_exclude")
        if layer not in layers_include:
            layers_include.append(layer)
            print(f"  CLI override: added '{layer}' to layers_include")


def validate_layer_lists(metadata: Dict) -> None:
    """Validate that no layer name appears in both layers_include and layers_exclude.

    Raises:
        ConversionError: If any layer is listed in both
    """
    includes = set(metadata.get('layers_include', []))
    excludes = set(metadata.get('layers_exclude', []))
    conflict = sorted(includes & excludes)
    if conflict:
        raise ConversionError(
            f"ERROR: [ant-convert] Layer(s) listed in both layers_include and layers_exclude: "
            f"{conflict}\n"
            f"Action: Edit the .md file to remove conflicting layer(s) from one list, "
            f"or use --exclude-layer / --include-layer to override for this run."
        )


def sanitize_identifier(key: str) -> str:
    """Sanitize a key for use as a DuckDB identifier (table/index/view name).

    Replaces non-alphanumeric characters with underscores to avoid
    DuckDB interpreting dots as schema separators.
    """
    return ''.join(c if c.isalnum() else '_' for c in key)


def normalize_dataframe_dtypes(df: pd.DataFrame) -> pd.DataFrame:
    """Normalize DataFrame dtypes to be compatible with DuckDB

    Converts problematic dtypes like 'str' to standard pandas types.
    Drops columns that are nested DataFrames (e.g., h5ad obs columns stored
    as a sub-DataFrame group like percentage_SEAAD_L2) — DuckDB can't
    represent those as a single column.
    """
    df = df.copy()

    # Drop nested-DataFrame columns first (anndata sometimes returns a
    # DataFrame when reading a multi-key h5ad obs group). `.dtype` raises
    # AttributeError on a DataFrame, blowing up the loop below.
    bad_cols = [
        col for col in df.columns
        if isinstance(df[col], pd.DataFrame)
    ]
    if bad_cols:
        print(f"  ⚠ dropping nested-DataFrame obs columns: {bad_cols}",
              file=sys.stderr)
        df = df.drop(columns=bad_cols)

    for col in df.columns:
        dtype_str = str(df[col].dtype)

        # Convert 'str' dtype to 'object'
        if dtype_str == 'str':
            df[col] = df[col].astype('object')

        # Convert other non-standard string types
        elif 'str' in dtype_str.lower() and dtype_str not in ['object', 'string']:
            df[col] = df[col].astype('object')

    return df


def check_pending_state(
    duckdb_path: Path,
    h5ad_obs_keys: set,
    force_discard: bool,
) -> None:
    """Dual-check guard: refuse to rebuild if the existing duckdb has pending
    obs columns that would be silently lost. Delegates the actual diagnosis
    to lib.anthive_db.pending_state_diagnosis so the check is unit-testable.
    """
    if not duckdb_path.exists():
        return  # no existing duckdb, nothing to lose

    diag = pending_state_diagnosis(duckdb_path, h5ad_obs_keys)
    if diag['clean']:
        return

    pending_df = diag['pending_table']
    unrecorded = diag['unrecorded']

    print()
    print("=" * 70)
    print("⚠  EXISTING DUCKDB HAS PENDING OBS COLUMNS")
    print("=" * 70)
    if not pending_df.empty:
        print(f"  __pending_cols table ({len(pending_df)} columns):")
        for _, row in pending_df.iterrows():
            print(f"    - {row['col_name']:50s} "
                  f"[{row['kind']}] by {row['annotator']} "
                  f"({row['catalog'] or '-'})")
    if unrecorded:
        print(f"  duckdb obs cols not in h5ad (and NOT in __pending_cols):")
        for col in unrecorded:
            print(f"    - {col}")

    if not force_discard:
        raise ConversionError(
            "ERROR: [ant-convert] Refusing to rebuild — pending obs columns "
            "would be lost.\n"
            "Action: run 'ant-merge-h5ad' first to sync these columns into "
            "the h5ad,\n"
            "        OR pass --force-discard-pending to overwrite anyway "
            "(columns lost!)."
        )
    print()
    print("  --force-discard-pending given — proceeding with REBUILD; "
          "columns above will be lost.")
    print("=" * 70)


def convert_h5ad_to_duckdb(h5ad_path: Path, config: Dict[str, Any],
                           cli_include: List[str] = None,
                           cli_exclude: List[str] = None,
                           force_discard_pending: bool = False) -> None:
    """
    Main conversion function

    Args:
        h5ad_path: Path to h5ad file
        config: Configuration dictionary
        force_discard_pending: Override pending-column guard

    Raises:
        ConversionError: If conversion fails
    """
    duckdb_path = h5ad_path.with_suffix('.duckdb')
    rebuilding_sentinel = h5ad_path.with_suffix('.duckdb.rebuilding')

    print(f"{'='*70}")
    print(f"CONVERTING: {h5ad_path.name}")
    print(f"{'='*70}")

    # Show file size
    h5ad_size = h5ad_path.stat().st_size
    print(f"Input file size: {format_size(h5ad_size)}")
    print()

    # Check prerequisites
    md_path = h5ad_path.with_suffix('.md')
    if not md_path.exists():
        raise ConversionError(
            f"ERROR: [ant-convert] Metadata file not found\n"
            f"Details: Run 'ant check {h5ad_path}' first to generate metadata\n"
            f"Location: {md_path}\n"
            f"Action: Run ant check before converting"
        )

    # Fail fast on an unreadable DE sidecar: it is restored at the very end,
    # after the previous duckdb may already be gone (in-place builds).
    import de_storage as _de_storage  # type: ignore
    de_sidecar = _de_storage.sidecar_path_for(h5ad_path)
    if de_sidecar.exists():
        try:
            _de_storage.read_sidecar_studies(de_sidecar)
        except Exception as de_exc:
            raise ConversionError(
                f"ERROR: [ant-convert] DE sidecar unreadable\n"
                f"Details: {de_exc}\n"
                f"Location: {de_sidecar}\n"
                f"Action: repair or move the sidecar before converting"
            ) from de_exc

    # Load metadata
    print("[1/7] Loading metadata...")
    try:
        metadata, _ = parse_md_file(md_path)
    except MetadataError as error:
        raise ConversionError(f"Failed to load metadata: {error}")

    if not metadata:
        raise ConversionError(
            f"ERROR: [ant-convert] Empty metadata file\n"
            f"Location: {md_path}\n"
            f"Action: Run 'ant check {h5ad_path}' to regenerate metadata"
        )
    print("  ✓ Metadata loaded")

    # Apply CLI layer overrides (--include-layer / --exclude-layer)
    if cli_include or cli_exclude:
        print("  Applying CLI layer overrides...")
        apply_layer_cli_overrides(metadata, cli_include or [], cli_exclude or [])

    # Validate mutual exclusivity of layers_include and layers_exclude
    validate_layer_lists(metadata)

    # Load h5ad file
    print(f"[2/7] Loading h5ad file ({format_size(h5ad_size)})...")
    load_start = time.time()
    try:
        adata = load_h5ad(h5ad_path)
    except H5ADError as error:
        raise ConversionError(str(error))
    load_time = time.time() - load_start
    print(f"  ✓ Loaded in {load_time:.1f}s ({adata.n_obs:,} cells × {adata.n_vars:,} genes)")

    # Dual-check pending-state guard BEFORE any destructive operation
    h5ad_obs_keys = set(adata.obs.columns)
    check_pending_state(duckdb_path, h5ad_obs_keys, force_discard_pending)

    # Check if duckdb exists
    if duckdb_path.exists():
        print(f"⚠ Warning: {duckdb_path.name} already exists and will be overwritten")

    # Refuse if another live process (e.g. ant-drop-indexes) owns the sentinel;
    # a sentinel left by a dead process is stale and safe to replace.
    if rebuilding_sentinel.exists():
        owner = rebuilding_sentinel.read_text().strip()
        pid_match = re.search(r'pid=(\d+)', owner)
        owner_alive = False
        if pid_match:
            try:
                os.kill(int(pid_match.group(1)), 0)
                owner_alive = True
            except ProcessLookupError:
                owner_alive = False
            except PermissionError:
                owner_alive = True
        if owner_alive:
            raise ConversionError(
                f"ERROR: [ant-convert] {rebuilding_sentinel.name} is held by a live process ({owner}).\n"
                f"Action: wait for it to finish, then rerun"
            )
        print(f"  Removing stale sentinel ({owner})")

    # Set sentinel BEFORE the rebuild starts so AnnotationWriter refuses to open
    rebuilding_sentinel.write_text(f"ant-convert pid={os.getpid()}\n")

    # Staging: with convert_staging_dir set (e.g. $TMPDIR on HPC) the new
    # .duckdb is built there and moved into place only after it verified, so
    # the served file stays intact until the swap. Layer parquet sidecars are
    # still written next to the h5ad: the layer views record their absolute
    # paths, so they must be created at their final location.
    staging_dir = get_convert_staging_dir(config)
    if staging_dir is not None:
        staging_dir.mkdir(parents=True, exist_ok=True)
        build_path = staging_dir / f"{duckdb_path.name}.{os.getpid()}.building"
        for leftover in (build_path, Path(str(build_path) + '.wal')):
            if leftover.exists():
                leftover.unlink()
        print(f"  Staging build in {staging_dir}")
    else:
        build_path = duckdb_path

    # Create connection and start conversion
    conn = None
    try:
        # Remove existing database (in-place builds only; a staged build
        # replaces it atomically at the end)
        if build_path == duckdb_path and duckdb_path.exists():
            duckdb_path.unlink()

        # Connect to new database
        print(f"[3/7] Initializing database...")
        conn = duckdb.connect(str(build_path))
        spill_dir = (os.environ.get('ANTHIVE_DUCKDB_TEMP_DIR', '').strip()
                     or config.get('duckdb_temp_directory'))
        if spill_dir:
            spill_path = Path(expand_value(spill_dir))
            spill_path.mkdir(parents=True, exist_ok=True)
            conn.execute(f"SET temp_directory = '{spill_path}'")
            print(f"  ✓ temp_directory = {spill_path}")
        # Apply memory_limit from anthive.yaml if set. DuckDB's default
        # (~80% of RAM) can trigger OOM on very-large-nnz layer melts
        # where the primary-key index build accumulates a lot of state;
        # capping here forces earlier spill-to-disk on huge ingests.
        mem_limit = config.get('duckdb_memory_limit')
        if mem_limit and str(mem_limit).lower() != 'auto':
            conn.execute(f"SET memory_limit = '{mem_limit}'")
            print(f"  ✓ memory_limit = {mem_limit}")
        threads = config.get('duckdb_threads')
        if threads:
            conn.execute(f"SET threads = {int(threads)}")
        initialize_database(conn)
        print(f"  ✓ Schema version: 1")

        create_cell_index(conn, adata)
        print(f"  ✓ Cell index: {adata.n_obs:,} cells")

        create_gene_index(conn, adata)
        print(f"  ✓ Gene index: {adata.n_vars:,} genes")

        # Convert layers
        print(f"\n[4/7] Converting layers...")
        if metadata.get('layers_include'):
            convert_layers(conn, adata, metadata, config, h5ad_path)
        else:
            print("  (no layers to convert)")

        # Convert observations
        print(f"\n[5/7] Converting observations...")
        if metadata.get('obsnum_include') or metadata.get('obscat_include'):
            convert_observations(conn, adata, metadata, group_id=group_id_for_md(md_path))
        else:
            print("  (no observations to convert)")

        # Convert variables
        print(f"\n[6/7] Converting variables...")
        if metadata.get('var_include'):
            convert_variables(conn, adata, metadata)
        else:
            print("  (no variables to convert)")

        # Convert embeddings
        if metadata.get('obsm_include'):
            print(f"\nConverting embeddings...")
            convert_embeddings(conn, adata, metadata)

        # Finalize
        print(f"\n[7/7] Finalizing database...")
        finalize_database(conn)
        print("  ✓ Database optimized")

        # Verify
        verify_database(conn, adata)
        print("  ✓ Integrity verified")

        # Get file sizes
        duckdb_size = build_path.stat().st_size
        compression_pct = (1 - duckdb_size / h5ad_size) * 100

        # Re-ingest DE sidecar if one exists. The .duckdb's __de_study /
        # __de tables are gone (full rebuild dropped them); the sidecar
        # parquet is the durable copy. ant-de-ingest writes the sidecar
        # so this is a no-op for datasets that haven't run DE ingestion.
        if conn:
            try:
                conn.close()
            except Exception:
                pass
            conn = None
        # A failed reimport aborts the conversion (the outer handler removes
        # the build and keeps any served duckdb): silently shipping a duckdb
        # without its DE studies is data loss the next restore would not notice.
        sidecar = de_sidecar
        if sidecar.exists():
            print(f"\nReimporting DE sidecar...")
            print(f"  {sidecar.name}")
            try:
                inserted = _de_storage.reimport_sidecar(build_path, sidecar)
            except Exception as de_exc:
                raise ConversionError(
                    f"ERROR: [ant-convert] DE sidecar reimport failed\n"
                    f"Details: {de_exc}\n"
                    f"Location: {sidecar}\n"
                    f"Action: fix the sidecar or its gene names, then rerun"
                ) from de_exc
            expected = {entry['study_id']: entry['n_rows']
                        for entry in _de_storage.read_sidecar_studies(sidecar)}
            if set(inserted) != set(expected):
                raise ConversionError(
                    f"ERROR: [ant-convert] DE sidecar reimport incomplete\n"
                    f"Details: restored {sorted(inserted)}, sidecar has {sorted(expected)}\n"
                    f"Location: {sidecar}"
                )
            for study_id, n_rows in inserted.items():
                print(f"  ✓ {study_id}: {n_rows} rows")
                if n_rows < expected[study_id]:
                    print(f"  ⚠ {study_id}: {expected[study_id] - n_rows} sidecar rows "
                          f"dropped (gene not in rebuilt dataset)", file=sys.stderr)

        if build_path != duckdb_path:
            _install_staged_duckdb(build_path, duckdb_path)
            print(f"  ✓ Moved staged build into place: {duckdb_path}")
        # Measure after close: before the final checkpoint the file on disk
        # is only a fraction of its real size.
        duckdb_size = duckdb_path.stat().st_size
        compression_pct = (1 - duckdb_size / h5ad_size) * 100

        print(f"\n{'='*70}")
        print(f"CONVERSION COMPLETE!")
        print(f"{'='*70}")
        print(f"  Input:  {h5ad_path.name} ({format_size(h5ad_size)})")
        print(f"  Output: {duckdb_path.name} ({format_size(duckdb_size)})")
        print(f"  Compression: {compression_pct:.0f}%")

    except BaseException as error:
        # Clean up on failure (BaseException: a Ctrl-C must not leave a
        # half-built staged file behind either)
        if conn:
            conn.close()
            conn = None

        if build_path == duckdb_path and not isinstance(error, Exception):
            raise    # in-place build: main() handles Ctrl-C cleanup as before
        if build_path != duckdb_path:
            for partial in (build_path, Path(str(build_path) + '.wal')):
                if partial.exists():
                    print(f"\nRemoving partial staged build: {partial}", file=sys.stderr)
                    partial.unlink()
            if not isinstance(error, Exception):
                raise
        elif duckdb_path.exists():
            print(f"\n{'='*60}", file=sys.stderr)
            print(f"ERROR: [ant-convert] Conversion failed", file=sys.stderr)
            print(f"{'='*60}", file=sys.stderr)
            print(f"File: {h5ad_path}", file=sys.stderr)
            print(f"Error: {error}", file=sys.stderr)
            print(f"\nRemoving partial database: {duckdb_path}", file=sys.stderr)
            duckdb_path.unlink()

        # Also remove any partially-written parquet sidecars
        base_stem = h5ad_path.stem
        for partial in h5ad_path.parent.glob(f"{base_stem}.layer.*"):
            if partial.suffix == '.parquet' or partial.name.endswith('.parquet'):
                try:
                    partial.unlink()
                    print(f"Removing partial parquet: {partial.name}", file=sys.stderr)
                except FileNotFoundError:
                    pass

        raise ConversionError(str(error))

    finally:
        if conn:
            conn.close()
        if rebuilding_sentinel.exists():
            try:
                rebuilding_sentinel.unlink()
            except FileNotFoundError:
                pass


def _install_staged_duckdb(build_path: Path, duckdb_path: Path) -> None:
    """Move a finished staged build over the target, atomically on the target fs.

    Same filesystem: one rename. Different filesystem (node-local scratch to
    a shared store): copy next to the target under a temporary name, fsync,
    then rename, so readers never see a half-copied file.
    """
    import shutil  # noqa: PLC0415
    wal = Path(str(build_path) + '.wal')
    if wal.exists():
        raise ConversionError(
            f"ERROR: [ant-convert] staged build left a WAL file ({wal}); "
            f"refusing to install an unconsolidated database"
        )
    try:
        os.replace(build_path, duckdb_path)
        return
    except OSError as exc:
        if exc.errno != 18:   # EXDEV: cross-device link
            raise
    incoming = duckdb_path.with_name(f".{duckdb_path.name}.{os.getpid()}.incoming")
    try:
        shutil.copyfile(build_path, incoming)
        with open(incoming, 'rb') as handle:
            os.fsync(handle.fileno())
        os.replace(incoming, duckdb_path)
    finally:
        if incoming.exists():
            incoming.unlink()
    build_path.unlink()


def initialize_database(conn: duckdb.DuckDBPyConnection) -> None:
    """Initialize database with schema version table"""
    conn.execute("""
        CREATE TABLE __schema_version (
            version INTEGER PRIMARY KEY,
            applied_date TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
            description TEXT
        )
    """)

    conn.execute("""
        INSERT INTO __schema_version (version, description)
        VALUES (1, 'Initial schema')
    """)


def create_cell_index(conn: duckdb.DuckDBPyConnection, adata) -> None:
    """Create cell ID to name mapping table"""
    cell_names = adata.obs_names.tolist()

    cells_df = pd.DataFrame({
        'cell_id': range(len(cell_names)),
        'cell_name': cell_names
    })

    conn.execute("""
        CREATE TABLE __cells (
            cell_id INTEGER PRIMARY KEY,
            cell_name TEXT NOT NULL UNIQUE
        )
    """)

    cells_df = normalize_dataframe_dtypes(cells_df)
    conn.register('temp_cells', cells_df)
    conn.execute("INSERT INTO __cells SELECT * FROM temp_cells")
    conn.unregister('temp_cells')

    # No extra index on cell_name: the UNIQUE constraint already builds one.
    conn.execute("CREATE VIEW cells AS SELECT * FROM __cells")


def create_gene_index(conn: duckdb.DuckDBPyConnection, adata) -> None:
    """Create gene ID to name mapping table"""
    gene_names = adata.var_names.tolist()

    genes_df = pd.DataFrame({
        'gene_id': range(len(gene_names)),
        'gene_name': gene_names
    })

    conn.execute("""
        CREATE TABLE __genes (
            gene_id INTEGER PRIMARY KEY,
            gene_name TEXT NOT NULL UNIQUE
        )
    """)

    genes_df = normalize_dataframe_dtypes(genes_df)
    conn.register('temp_genes', genes_df)
    conn.execute("INSERT INTO __genes SELECT * FROM temp_genes")
    conn.unregister('temp_genes')

    conn.execute("CREATE VIEW genes AS SELECT * FROM __genes")


def convert_layers(conn: duckdb.DuckDBPyConnection, adata, metadata: Dict,
                   config: Dict, h5ad_path: Path) -> None:
    """Write each expression layer to two Parquet sidecars sorted by gene_id and cell_id.

    Replaces the old in-DuckDB __layer__<name> table approach with external
    Parquet files for dramatically smaller storage and faster ingest on large
    datasets. Two files per layer are created:
      <name>.layer.<layer>.by_gene.parquet  — sorted by gene_id (gene-filter queries)
      <name>.layer.<layer>.by_cell.parquet  — sorted by cell_id (cell-filter queries)

    Both have schema: (cell_id INTEGER, gene_id INTEGER, value FLOAT or dtype-matched).
    DuckDB views over these files are created inside the .duckdb so queries are
    transparent to callers.

    NOTE: explicit zeros are dropped during melt (`value != 0`), matching the
    sparse-CSR semantics of the source. A layer that stores meaningful zeros
    (e.g. signed residuals, z-scores) is NOT round-trippable through this path.

    Args:
        conn: Open DuckDB connection (read-write).
        adata: AnnData object.
        metadata: Dataset metadata dict (contains layers_include, layer_description).
        config: Config dict (contains melt_chunk_size).
        h5ad_path: Absolute path to the .h5ad file; parquets are written as siblings.
    """
    layers_include = metadata['layers_include']
    chunk_size = config['melt_chunk_size']
    layer_description = metadata.get('layer_description', {})

    # Base path for sidecar files — siblings of the .h5ad, strip the .h5ad suffix.
    base_path = h5ad_path.parent / h5ad_path.stem

    for layer_key in layers_include:
        # Get layer data
        if layer_key == 'X':
            if adata.X is None:
                print(f"  ⚠ Layer 'X' (.X) not present, skipping")
                continue
            layer_data = adata.X
        else:
            if layer_key not in adata.layers:
                print(f"  ⚠ Layer '{layer_key}' not found, skipping")
                continue
            layer_data = adata.layers[layer_key]

        safe_layer_key = sanitize_identifier(layer_key)
        print(f"  layer__{layer_key} ({layer_description.get(layer_key, layer_key)}):")
        start_time = time.time()

        # Determine value dtype from source to preserve precision (counts as int, X as float)
        if scipy.sparse.issparse(layer_data):
            src_dtype = layer_data.dtype
        else:
            src_dtype = np.array(layer_data).dtype
        # Use float32 for float layers, preserve integer type for count layers
        if np.issubdtype(src_dtype, np.integer):
            value_dtype = src_dtype
        else:
            value_dtype = np.float32

        # Staging table in the duckdb itself — DuckDB handles spill-to-disk
        # so this approach is memory-safe for large datasets. We INSERT chunks
        # as we process them, then use COPY TO for two sorted parquets.
        staging_table = f"__staging_layer_{safe_layer_key}"
        by_gene_path = base_path.parent / f"{base_path.name}.layer.{layer_key}.by_gene.parquet"
        by_cell_path = base_path.parent / f"{base_path.name}.layer.{layer_key}.by_cell.parquet"

        # Determine DuckDB SQL type for the value column
        if np.issubdtype(value_dtype, np.integer):
            sql_value_type = "BIGINT"
        else:
            sql_value_type = "FLOAT"

        # Clean up any previous partial files and staging table
        for partial in (by_gene_path, by_cell_path):
            if partial.exists():
                partial.unlink()
        conn.execute(f"DROP TABLE IF EXISTS {staging_table}")

        conn.execute(f"""
            CREATE TEMP TABLE {staging_table} (
                cell_id INTEGER NOT NULL,
                gene_id INTEGER NOT NULL,
                value {sql_value_type} NOT NULL
            )
        """)

        num_cells = adata.n_obs
        num_genes = adata.n_vars
        total_nonzero = 0
        chunk_count = 0

        for chunk_start in range(0, num_cells, chunk_size):
            chunk_end = min(chunk_start + chunk_size, num_cells)
            chunk_count += 1

            chunk_data = layer_data[chunk_start:chunk_end, :]

            if scipy.sparse.issparse(chunk_data):
                chunk_coo = chunk_data.tocoo()
            else:
                chunk_coo = scipy.sparse.coo_matrix(chunk_data)

            if chunk_coo.nnz == 0:
                del chunk_data, chunk_coo
                gc.collect()
                continue

            melted = pd.DataFrame({
                'cell_id': (chunk_coo.row + chunk_start).astype(np.int32),
                'gene_id': chunk_coo.col.astype(np.int32),
                'value': chunk_coo.data.astype(value_dtype),
            })
            # Safety: drop explicit zeros
            melted = melted[melted['value'] != 0]
            total_nonzero += len(melted)

            if len(melted) > 0:
                conn.register('_chunk', melted)
                conn.execute(f"INSERT INTO {staging_table} SELECT * FROM _chunk")
                conn.unregister('_chunk')

            del chunk_data, chunk_coo, melted
            gc.collect()

        if total_nonzero == 0:
            print(f"  ⚠ Layer '{layer_key}' is all zeros — creating empty parquets")
            conn.execute(f"""
                COPY (SELECT * FROM {staging_table} ORDER BY gene_id, cell_id)
                TO '{by_gene_path!s}'
                (FORMAT PARQUET, COMPRESSION ZSTD, ROW_GROUP_SIZE 1000000)
            """)
            conn.execute(f"""
                COPY (SELECT * FROM {staging_table} ORDER BY cell_id, gene_id)
                TO '{by_cell_path!s}'
                (FORMAT PARQUET, COMPRESSION ZSTD, ROW_GROUP_SIZE 1000000)
            """)
        else:
            print(f"    Processed {chunk_count} chunks, {total_nonzero:,} non-zero values")
            print(f"    Sorting by gene_id → {by_gene_path.name}")
            # DuckDB COPY handles arbitrary sizes via spill-to-disk
            conn.execute(f"""
                COPY (
                    SELECT cell_id, gene_id, value
                    FROM {staging_table}
                    ORDER BY gene_id, cell_id
                ) TO '{by_gene_path!s}'
                (FORMAT PARQUET, COMPRESSION ZSTD, ROW_GROUP_SIZE 1000000)
            """)
            print(f"    Sorting by cell_id → {by_cell_path.name}")
            conn.execute(f"""
                COPY (
                    SELECT cell_id, gene_id, value
                    FROM {staging_table}
                    ORDER BY cell_id, gene_id
                ) TO '{by_cell_path!s}'
                (FORMAT PARQUET, COMPRESSION ZSTD, ROW_GROUP_SIZE 1000000)
            """)

        conn.execute(f"DROP TABLE IF EXISTS {staging_table}")

        # Register views over the two parquets. Absolute paths required so
        # the view works regardless of the cwd when duckdb is opened later.
        # Single quotes in the path are doubled per SQL string-literal escape
        # rules (defensive — no failure observed yet, but a user directory
        # containing an apostrophe would otherwise break the CREATE VIEW).
        by_gene_sql = str(by_gene_path.resolve()).replace("'", "''")
        by_cell_sql = str(by_cell_path.resolve()).replace("'", "''")
        conn.execute(f"""
            CREATE VIEW layer__{safe_layer_key} AS
            SELECT c.cell_name, g.gene_name, l.value
            FROM read_parquet('{by_gene_sql}') l
            JOIN __cells c ON l.cell_id = c.cell_id
            JOIN __genes g ON l.gene_id = g.gene_id
        """)
        # Symmetric alias: analytics users reasonably expect layer__X_by_gene
        # to exist next to layer__X_by_cell — otherwise `FROM layer__X_by_gene`
        # in a hand-written query hits "table does not exist".
        conn.execute(f"""
            CREATE VIEW layer__{safe_layer_key}_by_gene AS
            SELECT * FROM layer__{safe_layer_key}
        """)
        conn.execute(f"""
            CREATE VIEW layer__{safe_layer_key}_by_cell AS
            SELECT c.cell_name, g.gene_name, l.value
            FROM read_parquet('{by_cell_sql}') l
            JOIN __cells c ON l.cell_id = c.cell_id
            JOIN __genes g ON l.gene_id = g.gene_id
        """)

        total_elements = num_cells * num_genes
        sparsity = (1 - total_nonzero / total_elements) * 100 if total_elements > 0 else 0.0
        by_gene_size = by_gene_path.stat().st_size if by_gene_path.exists() else 0
        by_cell_size = by_cell_path.stat().st_size if by_cell_path.exists() else 0
        total_time = time.time() - start_time
        print(f"  ✓ {layer_key}: {total_nonzero:,} values, {sparsity:.1f}% sparse, "
              f"{total_time:.1f}s  ({format_size(by_gene_size + by_cell_size)} parquet)")


def convert_observations(conn: duckdb.DuckDBPyConnection, adata, metadata: Dict,
                         group_id: Optional[str] = None) -> None:
    """Convert observation (cell) annotations.

    ``group_id`` fills ``{group_id}`` in template / join derives; join tables
    resolve against the configured store root.
    """

    # Reserved column names that cannot be used
    RESERVED_COLUMNS = {'cell_id', 'cell_name', 'gene_id', 'gene_name'}
    # view name -> stored columns (with cell_id), filled as tables are created
    view_columns: Dict[str, List[str]] = {}

    # Convert numerical observations
    obsnum_cols = metadata.get('obsnum_include', [])
    if obsnum_cols:
        # Filter to existing columns and remove duplicates (case-insensitive)
        seen = set()
        seen_lower = set()
        filtered_cols = []

        for col in obsnum_cols:
            if col not in adata.obs.columns:
                continue

            # Check for exact duplicates
            if col in seen:
                continue

            # Check for case-insensitive duplicates (DuckDB columns are case-insensitive)
            if col.lower() in seen_lower:
                print(f"  ⚠ Skipping obs column '{col}' (case-insensitive duplicate)")
                continue

            # Check for reserved column names
            if col.lower() in RESERVED_COLUMNS:
                print(f"  ⚠ Skipping obs column '{col}' (conflicts with reserved name)")
                continue

            filtered_cols.append(col)
            seen.add(col)
            seen_lower.add(col.lower())

        obsnum_cols = filtered_cols

        if obsnum_cols:
            # Build CREATE TABLE statement
            col_defs = ['cell_id INTEGER PRIMARY KEY']
            for col in obsnum_cols:
                col_defs.append(f'"{col}" DOUBLE')

            conn.execute(f"""
                CREATE TABLE __obsnum (
                    {', '.join(col_defs)}
                )
            """)

            # Prepare and insert data
            obsnum_df = adata.obs[obsnum_cols].copy()
            obsnum_df.insert(0, 'cell_id', range(len(obsnum_df)))

            obsnum_df = normalize_dataframe_dtypes(obsnum_df)
            conn.register('temp_obsnum', obsnum_df)
            conn.execute("INSERT INTO __obsnum SELECT * FROM temp_obsnum")
            conn.unregister('temp_obsnum')

            # The view is created below, once both __obs* tables exist.
            view_columns['obsnum'] = ['cell_id'] + obsnum_cols

            print(f"  ✓ obsnum: {len(obsnum_cols)} columns")

    # Convert categorical observations
    obscat_cols = metadata.get('obscat_include', [])
    if obscat_cols:
        # Filter to existing columns and remove duplicates (case-insensitive)
        seen = set()
        seen_lower = set()
        filtered_cols = []

        for col in obscat_cols:
            if col not in adata.obs.columns:
                continue

            # Check for exact duplicates
            if col in seen:
                continue

            # Check for case-insensitive duplicates (DuckDB columns are case-insensitive)
            if col.lower() in seen_lower:
                print(f"  ⚠ Skipping obs column '{col}' (case-insensitive duplicate)")
                continue

            # Check for reserved column names
            if col.lower() in RESERVED_COLUMNS:
                print(f"  ⚠ Skipping obs column '{col}' (conflicts with reserved name)")
                continue

            filtered_cols.append(col)
            seen.add(col)
            seen_lower.add(col.lower())

        obscat_cols = filtered_cols

        if obscat_cols:
            # Build CREATE TABLE statement with ENUM types
            col_defs = ['cell_id INTEGER PRIMARY KEY']

            for col in obscat_cols:
                col_defs.append(f'"{col}" VARCHAR')

            conn.execute(f"""
                CREATE TABLE __obscat (
                    {', '.join(col_defs)}
                )
            """)

            # Prepare data
            obscat_df = adata.obs[obscat_cols].copy()

            # Convert all to string (use 'object' dtype, not 'str')
            for col in obscat_cols:
                obscat_df[col] = obscat_df[col].astype('object')
                obscat_df[col] = obscat_df[col].replace('nan', None)

            obscat_df.insert(0, 'cell_id', range(len(obscat_df)))

            # Insert
            obscat_df = normalize_dataframe_dtypes(obscat_df)
            conn.register('temp_obscat', obscat_df)
            conn.execute("INSERT INTO __obscat SELECT * FROM temp_obscat")
            conn.unregister('temp_obscat')

            # No per-column ART indexes: DuckDB 1.5 plans sequential scans for
            # these filters anyway, and the indexes tripled file size and made
            # AnnotationWriter overwrites 100-4000x slower (see ant-drop-indexes).

            # The view is created below, once both __obs* tables exist.
            view_columns['obscat'] = ['cell_id'] + obscat_cols

            print(f"  ✓ obscat: {len(obscat_cols)} columns")

    # Create the views: apply the .md api: section (rename, hide, derive,
    # constant, central facets) at projection time so old internal names are
    # unreachable via the view. Built after both tables exist and with the
    # sibling table passed, so a derive whose source lives in the other
    # table (e.g. a numerical ant_braak from a text Braak column) is kept;
    # before 2026-10-05 such derives were dropped silently at ingest.
    api_config = get_api_config(metadata)
    for view_name, sibling_name in (('obsnum', 'obscat'), ('obscat', 'obsnum')):
        if view_name not in view_columns:
            continue
        sibling_columns = view_columns.get(sibling_name)
        conn.execute(build_obs_view_sql(
            view_name, f'__{view_name}', view_columns[view_name], api_config,
            sibling_underscore_table=f'__{sibling_name}' if sibling_columns else None,
            sibling_columns=sibling_columns,
            db_label=str(metadata.get('id') or metadata.get('title') or ''),
            group_id=group_id,
        ))


def convert_variables(conn: duckdb.DuckDBPyConnection, adata, metadata: Dict) -> None:
    """Convert variable (gene) annotations"""

    # Reserved column names that cannot be used
    RESERVED_COLUMNS = {'cell_id', 'cell_name', 'gene_id', 'gene_name'}

    var_cols = metadata.get('var_include', [])
    if not var_cols:
        return

    # Filter to existing columns and remove duplicates (case-insensitive)
    seen = set()
    seen_lower = set()
    filtered_cols = []

    for col in var_cols:
        if col not in adata.var.columns:
            continue

        # Check for exact duplicates
        if col in seen:
            continue

        # Check for case-insensitive duplicates (DuckDB columns are case-insensitive)
        if col.lower() in seen_lower:
            print(f"  ⚠ Skipping var column '{col}' (case-insensitive duplicate)")
            continue

        # Check for reserved column names
        if col.lower() in RESERVED_COLUMNS:
            print(f"  ⚠ Skipping var column '{col}' (conflicts with reserved name)")
            continue

        filtered_cols.append(col)
        seen.add(col)
        seen_lower.add(col.lower())

    var_cols = filtered_cols

    if not var_cols:
        return

    # Determine which are numerical and which are categorical
    varnum_cols = []
    varcat_cols = []

    for col in var_cols:
        if pd.api.types.is_numeric_dtype(adata.var[col]):
            varnum_cols.append(col)
        else:
            varcat_cols.append(col)

    # Convert numerical variables
    if varnum_cols:
        col_defs = ['gene_id INTEGER PRIMARY KEY']
        for col in varnum_cols:
            col_defs.append(f'"{col}" DOUBLE')

        conn.execute(f"""
            CREATE TABLE __varnum (
                {', '.join(col_defs)}
            )
        """)

        varnum_df = adata.var[varnum_cols].copy()
        varnum_df.insert(0, 'gene_id', range(len(varnum_df)))

        varnum_df = normalize_dataframe_dtypes(varnum_df)
        conn.register('temp_varnum', varnum_df)
        conn.execute("INSERT INTO __varnum SELECT * FROM temp_varnum")
        conn.unregister('temp_varnum')

        conn.execute("""
            CREATE VIEW varnum AS
            SELECT g.gene_name, v.*
            FROM __varnum v
            JOIN __genes g ON v.gene_id = g.gene_id
        """)

        print(f"  ✓ varnum: {len(varnum_cols)} columns")

    # Convert categorical variables
    if varcat_cols:
        col_defs = ['gene_id INTEGER PRIMARY KEY']
        for col in varcat_cols:
            col_defs.append(f'"{col}" VARCHAR')

        conn.execute(f"""
            CREATE TABLE __varcat (
                {', '.join(col_defs)}
            )
        """)

        varcat_df = adata.var[varcat_cols].copy()
        for col in varcat_cols:
            varcat_df[col] = varcat_df[col].astype('object')
            varcat_df[col] = varcat_df[col].replace('nan', None)

        varcat_df.insert(0, 'gene_id', range(len(varcat_df)))

        varcat_df = normalize_dataframe_dtypes(varcat_df)
        conn.register('temp_varcat', varcat_df)
        conn.execute("INSERT INTO __varcat SELECT * FROM temp_varcat")
        conn.unregister('temp_varcat')

        conn.execute("""
            CREATE VIEW varcat AS
            SELECT g.gene_name, v.*
            FROM __varcat v
            JOIN __genes g ON v.gene_id = g.gene_id
        """)

        print(f"  ✓ varcat: {len(varcat_cols)} columns")


def convert_embeddings(conn: duckdb.DuckDBPyConnection, adata, metadata: Dict) -> None:
    """Convert embeddings (UMAP, PCA, etc.)"""

    obsm_include = metadata.get('obsm_include', [])
    embedding_description = metadata.get('embedding_description', {})

    for obsm_key in obsm_include:
        try:
            if obsm_key not in adata.obsm:
                print(f"  ⚠ Embedding '{obsm_key}' not found, skipping")
                continue

            safe_obsm_key = sanitize_identifier(obsm_key)
            embedding_raw = adata.obsm[obsm_key]

            # Convert to numpy array if it's a DataFrame
            if isinstance(embedding_raw, pd.DataFrame):
                embedding = embedding_raw.values
            else:
                embedding = np.array(embedding_raw)

            original_dims = embedding.shape[1]

            # Cap ridiculous dimensionalities (a 1000-D obsm is very unusual);
            # 50 covers standard scanpy PCA (`n_comps=50`) and any UMAP up to
            # `n_components=50`. Was 4, which silently truncated 5-D+ UMAPs
            # and full 50-D PCA — see 2026-07 catalog note.
            MAX_EMBEDDING_DIMS = 50
            if original_dims > MAX_EMBEDDING_DIMS:
                embedding = embedding[:, :MAX_EMBEDDING_DIMS]
                num_dims = MAX_EMBEDDING_DIMS
            else:
                num_dims = original_dims

            # Build CREATE TABLE statement
            col_defs = ['cell_id INTEGER PRIMARY KEY']
            for i in range(num_dims):
                col_defs.append(f'dim_{i} DOUBLE')

            conn.execute(f"""
                CREATE TABLE __obsm__{safe_obsm_key} (
                    {', '.join(col_defs)}
                )
            """)

            # Prepare data - use register/insert pattern (much faster than executemany)
            embedding_df = pd.DataFrame(embedding)
            embedding_df.columns = [f'dim_{i}' for i in range(num_dims)]
            embedding_df.insert(0, 'cell_id', range(len(embedding_df)))

            # Insert using register pattern (fast)
            conn.register('temp_embedding', embedding_df)
            conn.execute(f"INSERT INTO __obsm__{safe_obsm_key} SELECT * FROM temp_embedding")
            conn.unregister('temp_embedding')

            # Create view
            conn.execute(f"""
                CREATE VIEW obsm__{safe_obsm_key} AS
                SELECT c.cell_name, e.*
                FROM __obsm__{safe_obsm_key} e
                JOIN __cells c ON e.cell_id = c.cell_id
            """)

            desc = embedding_description.get(obsm_key, obsm_key)
            print(f"  ✓ obsm__{obsm_key} ({desc}): {num_dims} dimensions")

        except Exception as e:
            print(f"  ✗ ERROR converting embedding '{obsm_key}':")
            print(f"    Type: {type(e).__name__}")
            print(f"    Message: {str(e)}")
            import traceback
            traceback.print_exc()
            raise ConversionError(f"Failed to convert embedding '{obsm_key}': {e}")


def finalize_database(conn: duckdb.DuckDBPyConnection) -> None:
    """Optimize database"""
    conn.execute("VACUUM")
    conn.execute("ANALYZE")


def verify_database(conn: duckdb.DuckDBPyConnection, adata) -> None:
    """Basic sanity checks on converted database"""

    # Check cell count
    result = conn.execute("SELECT COUNT(*) FROM __cells").fetchone()
    if result[0] != adata.n_obs:
        raise ConversionError(f"Cell count mismatch: {result[0]} != {adata.n_obs}")

    # Check gene count
    result = conn.execute("SELECT COUNT(*) FROM __genes").fetchone()
    if result[0] != adata.n_vars:
        raise ConversionError(f"Gene count mismatch: {result[0]} != {adata.n_vars}")


def format_size(size_bytes: int) -> str:
    """Format file size for display"""
    for unit in ['B', 'KB', 'MB', 'GB']:
        if size_bytes < 1024.0:
            return f"{size_bytes:.1f} {unit}"
        size_bytes /= 1024.0
    return f"{size_bytes:.1f} TB"


def main():
    """Main entry point"""

    parser = argparse.ArgumentParser(
        description='Convert h5ad file to DuckDB database',
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument('file', help='Path to h5ad file')
    parser.add_argument(
        '--exclude-layer', metavar='LAYER', nargs='+', default=[],
        help='Exclude layer(s) from this conversion (overrides .md file, not saved)'
    )
    parser.add_argument(
        '--include-layer', metavar='LAYER', nargs='+', default=[],
        help='Force-include layer(s), removing from layers_exclude (overrides .md file, not saved)'
    )
    parser.add_argument(
        '--force-discard-pending', action='store_true',
        help='Override the pending-column guard. Existing duckdb obs columns '
             'not in the h5ad WILL BE LOST. Use only after deliberate '
             'inspection of the warning output.'
    )

    args = parser.parse_args()

    # Convert to Path
    h5ad_path = Path(args.file).resolve()

    # Check file exists
    if not h5ad_path.exists():
        print(f"ERROR: [ant-convert] File not found", file=sys.stderr)
        print(f"Location: {h5ad_path}", file=sys.stderr)
        sys.exit(3)

    # Check file has .h5ad extension
    if h5ad_path.suffix != '.h5ad':
        print(f"ERROR: [ant-convert] Not an h5ad file", file=sys.stderr)
        print(f"Details: File must have .h5ad extension", file=sys.stderr)
        sys.exit(1)

    # Load configuration
    config = get_config()

    # Start conversion
    start_time = time.time()

    try:
        convert_h5ad_to_duckdb(
            h5ad_path, config,
            cli_include=args.include_layer,
            cli_exclude=args.exclude_layer,
            force_discard_pending=args.force_discard_pending,
        )

        total_time = time.time() - start_time
        minutes = int(total_time // 60)
        seconds = int(total_time % 60)

        if minutes > 0:
            print(f"  Total time: {minutes}m {seconds}s")
        else:
            print(f"  Total time: {seconds}s")

        sys.exit(0)

    except ConversionError as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        print("\n\nInterrupted by user", file=sys.stderr)

        # Try to clean up (a staged build never touched the target file)
        duckdb_path = h5ad_path.with_suffix('.duckdb')
        if get_convert_staging_dir(config) is None and duckdb_path.exists():
            print(f"Removing partial database: {duckdb_path}", file=sys.stderr)
            duckdb_path.unlink()

        sys.exit(130)
    except Exception as error:
        print(f"\nERROR: [ant-convert] Unexpected error", file=sys.stderr)
        print(f"Details: {error}", file=sys.stderr)
        import traceback
        traceback.print_exc()

        # Try to clean up (a staged build never touched the target file)
        duckdb_path = h5ad_path.with_suffix('.duckdb')
        if get_convert_staging_dir(config) is None and duckdb_path.exists():
            print(f"\nRemoving partial database: {duckdb_path}", file=sys.stderr)
            duckdb_path.unlink()

        sys.exit(1)


if __name__ == '__main__':
    main()
