def _catalog_paths(data_folder: Path, plan: DatasetPlan) -> Tuple[Path, Path]:
    """Return (catalog_h5ad_path, catalog_mus_path) for a plan."""
    parts = [data_folder, plan.data_project]
    if plan.subfolder:
        parts.append(plan.subfolder)
    catalog_dir = Path(*parts)
    h5ad_name = plan.basename + H5AD_SUFFIX
    return catalog_dir / h5ad_name, catalog_dir / (h5ad_name + '.mus')


def _staging_dir(data_folder: Path, plan: DatasetPlan) -> Path:
    parts = [data_folder, STAGING_DIR_REL, plan.data_project]
    if plan.subfolder:
        parts.append(plan.subfolder)
    return Path(*parts)


def _print_h5ad_conflict_table(
    plan: DatasetPlan,
    incoming_path: Path, incoming_sha: str,
    catalog_path: Path, catalog_sha: str,
    incoming_mus_text: str,
) -> None:
    """Verbose diff to help the human resolve a same-name-different-sha clash."""
    msg = _parse_sidecar_keys(incoming_mus_text).get('irods_message') or \
          _parse_sidecar_keys(incoming_mus_text).get('note') or ''
    _err(f'h5ad collision for {plan.display_name}:')
    print(f'    INCOMING')
    print(f'      key:    {plan.incoming_h5ad_key}')
    print(f'      sha256: {incoming_sha}')
    print(f'      size:   {incoming_path.stat().st_size:,} bytes')
    if msg:
        print(f'      msg:    {msg[:120]}')
    print(f'    CATALOG (already in data/h5adstore/)')
    print(f'      path:   {catalog_path}')
    print(f'      sha256: {catalog_sha}')
    print(f'      size:   {catalog_path.stat().st_size:,} bytes')
    print(f'      mtime:  {time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(catalog_path.stat().st_mtime))}')
    print(f'    To resolve, choose ONE:')
    print(f'      a) Keep catalog, discard incoming:')
    print(f'           ant-ingest prune --only-incoming-key {plan.incoming_h5ad_key}')
    print(f'      b) Replace catalog with incoming:')
    print(f'           rm {catalog_path}{{,.mus}}')
    print(f'           ant-ingest --filter {plan.data_project}')
    print(f'      c) Treat as a new dataset under a different name:')
    print(f'           rename in S3 __incoming/ first, then ant-ingest')


def _process_dataset(
    plan: DatasetPlan,
    client,
    bucket: str,
    data_folder: Path,
    args: argparse.Namespace,
) -> DatasetResult:
    """Execute steps 2-9 of the workflow for one h5ad. All-or-nothing per
    dataset — any failure leaves staging intact so the user can inspect."""
    result = DatasetResult(plan=plan)
    print(f'\n─── {plan.display_name} ───')

    # 2. Pull h5ad + .mus into staging.
    staging_dir = _staging_dir(data_folder, plan)
    staged_h5ad = staging_dir / (plan.basename + H5AD_SUFFIX)
    staged_mus = staging_dir / (plan.basename + H5AD_SUFFIX + '.mus')

    if args.dry_run:
        result.status = 'dry-run'
        result.detail = f'would pull {plan.incoming_h5ad_key} + sidecar'
        result.s3_incoming_keys = [plan.incoming_h5ad_key, plan.incoming_mus_key]
        return result

    try:
        print(f'  Pulling sidecar  {plan.incoming_mus_key}')
        _download(client, bucket, plan.incoming_mus_key, staged_mus)
        result.staging_files.append(str(staged_mus))

        print(f'  Pulling h5ad     {plan.incoming_h5ad_key} ({_human_size(client, bucket, plan.incoming_h5ad_key)})')
        _download(client, bucket, plan.incoming_h5ad_key, staged_h5ad)
        result.staging_files.append(str(staged_h5ad))
    except ClientError as exc:
        result.status = 'failed'
        result.detail = f'pull failed: {exc}'
        _err(result.detail)
        return result

    # 3. Validate sha.
    incoming_text = staged_mus.read_text(encoding='utf-8', errors='replace')
    incoming_meta = _parse_sidecar_keys(incoming_text)
    declared_sha = incoming_meta.get('sha256', '')
    actual_sha = _sha256_file(staged_h5ad)
    if not declared_sha:
        _warn('sidecar has no sha256= line; cannot verify integrity, proceeding')
    elif declared_sha != actual_sha:
        result.status = 'failed'
        result.detail = (
            f'sha256 mismatch: pulled file is {actual_sha}, '
            f'sidecar declared {declared_sha}. Aborting (possible mid-upload race or corruption).'
        )
        _err(result.detail)
        return result
    else:
        _ok(f'sha256 verified ({actual_sha[:12]}…)')

    # 4. Catalog clash check.
    catalog_h5ad, catalog_mus = _catalog_paths(data_folder, plan)
    h5ad_action = 'promote'   # 'promote' | 'reuse' (already in catalog with matching sha)
    if catalog_h5ad.exists():
        existing_sha = _sha256_file(catalog_h5ad)
        if existing_sha == actual_sha:
            h5ad_action = 'reuse'
            _ok('catalog h5ad already present with matching sha — proceeding to metadata')
        else:
            _print_h5ad_conflict_table(
                plan,
                incoming_path=staged_h5ad, incoming_sha=actual_sha,
                catalog_path=catalog_h5ad, catalog_sha=existing_sha,
                incoming_mus_text=incoming_text,
            )
            result.status = 'conflict'
            result.detail = (
                'catalog has same-name h5ad with different sha256 — '
                'human must resolve before re-running'
            )
            return result

    # 5. Metadata merge.
    local_text = read_sidecar(catalog_mus)
    merge = merge_sidecars(local_text, incoming_text)
    if merge.conflicts:
        for conflict in merge.conflicts:
            _warn(
                f'sidecar key conflict — kept local: '
                f'{conflict.key}={conflict.local_value}  '
                f'(incoming was: {conflict.incoming_value})'
            )
        result.sidecar_conflicts = list(merge.conflicts)
    if merge.adopted:
        _ok(f'adopted {len(merge.adopted)} new sidecar key(s): {", ".join(merge.adopted[:8])}'
            + ('…' if len(merge.adopted) > 8 else ''))
    if merge.overwritten:
        print(_dim(f'  machine-keys refreshed: {", ".join(merge.overwritten)}'))

    # 6. Promote h5ad (if needed) and write merged sidecar.
    catalog_h5ad.parent.mkdir(parents=True, exist_ok=True)
    if h5ad_action == 'promote':
        shutil.move(str(staged_h5ad), str(catalog_h5ad))
        result.promoted_files.append(str(catalog_h5ad))
        _ok(f'promoted h5ad → {catalog_h5ad}')
    write_sidecar_atomic(catalog_mus, merge.merged_text)
    result.promoted_files.append(str(catalog_mus))

    # 7. Static files (sha-compare).
    for static_key in plan.static_keys:
        static_filename = static_key.split('/')[-1]
        catalog_static = data_folder / plan.data_project / 'static' / static_filename
        staged_static = staging_dir.parent / 'static' / static_filename
        try:
            _download(client, bucket, static_key, staged_static)
        except ClientError as exc:
            _warn(f'static pull failed: {static_key} — {exc}')
            continue
        incoming_sha_static = _sha256_file(staged_static)
        if catalog_static.exists():
            existing_static_sha = _sha256_file(catalog_static)
            if existing_static_sha == incoming_sha_static:
                staged_static.unlink()  # identical — no-op
                continue
            _warn(
                f'static file conflict (kept local): '
                f'{catalog_static.relative_to(data_folder)}  '
                f'(catalog sha {existing_static_sha[:8]}…, incoming sha {incoming_sha_static[:8]}…)'
            )
            result.static_conflicts.append(str(catalog_static))
            staged_static.unlink()
            continue
        catalog_static.parent.mkdir(parents=True, exist_ok=True)
        shutil.move(str(staged_static), str(catalog_static))
        result.promoted_files.append(str(catalog_static))
        _ok(f'promoted static → {catalog_static.relative_to(data_folder)}')

    # 8. Run check, convert, duckdb-check.
    ant_h5ad_check = _SCRIPT_DIR / 'ant-h5ad-check'
    ant_convert = _SCRIPT_DIR / 'ant-convert'
    ant_duckdb_check = _SCRIPT_DIR / 'ant-duckdb-check'

    for label, cmd in [
        ('ant-h5ad-check', [str(ant_h5ad_check), str(catalog_h5ad)]),
        ('ant-convert', [str(ant_convert), str(catalog_h5ad)]),
        ('ant-duckdb-check', [str(ant_duckdb_check),
                              str(catalog_h5ad.with_suffix('.duckdb'))]),
    ]:
        ok, msg = _run(label, cmd)
        if not ok:
            result.status = 'failed'
            result.detail = msg
            _err(msg)
            return result
        _ok(f'{label} ok')

    # 9. Push to catalog root + re-stamp s3_*.
    catalog_key = _catalog_key(plan)
    h5ad_size = catalog_h5ad.stat().st_size
    print(f'  Pushing to catalog: s3://{bucket}/{catalog_key}  ({_fmt_size(h5ad_size)})')
    try:
        client.upload_file(
            str(catalog_h5ad), bucket, catalog_key,
            Config=_transfer_config(),
            ExtraArgs={'Metadata': {'original-mtime': str(int(catalog_h5ad.stat().st_mtime))}},
        )
        head = client.head_object(Bucket=bucket, Key=catalog_key)
        etag = head['ETag'].strip('"')
        uploaded_at = datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')
        endpoint = get_config()['s3'].get('endpoint')
        url = f'https://{endpoint}/{bucket}/{catalog_key}' if endpoint else \
              f's3://{bucket}/{catalog_key}'
        new_text = restamp_s3_block(
            catalog_mus.read_text(encoding='utf-8'),
            bucket=bucket, key=catalog_key, url=url,
            etag=etag, uploaded_at=uploaded_at,
        )
        write_sidecar_atomic(catalog_mus, new_text)
        # Also push the sidecar so S3 stays consistent with the local truth.
        client.upload_file(
            str(catalog_mus), bucket, catalog_key + '.mus',
            Config=_transfer_config(),
            ExtraArgs={'Metadata': {'original-mtime': str(int(catalog_mus.stat().st_mtime))}},
        )
        _ok('pushed to catalog + sidecar s3_* re-stamped')
    except ClientError as exc:
        result.status = 'failed'
        result.detail = f'catalog push failed: {exc}'
        _err(result.detail)
        return result

    # 10. Record __incoming/ keys for pending prune.
    result.s3_incoming_keys = [plan.incoming_mus_key, plan.incoming_h5ad_key]
    result.s3_incoming_keys.extend(plan.static_keys)
    result.status = 'ok'
    result.detail = 'ingested'
    return result


def _catalog_key(plan: DatasetPlan) -> str:
    parts = [plan.data_project]
    if plan.subfolder:
        parts.append(plan.subfolder)
    parts.append(plan.basename + H5AD_SUFFIX)
    return '/'.join(parts)


def _fmt_size(num_bytes: int) -> str:
    for unit in ('B', 'KB', 'MB', 'GB', 'TB'):
        if num_bytes < 1024 or unit == 'TB':
            return f'{num_bytes:.1f} {unit}'
        num_bytes /= 1024
    return str(num_bytes)


def _human_size(client, bucket: str, key: str) -> str:
    try:
        head = client.head_object(Bucket=bucket, Key=key)
        return _fmt_size(head['ContentLength'])
    except Exception:
        return '?'


