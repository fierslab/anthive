def cmd_purge(args: argparse.Namespace, s3_cfg: dict, data_folder: Path) -> int:
    """Remove archived versions (``<group>/_versions/<basename>/<version>/`` locally and on S3)."""
    import ingest_versions
    import ingest_watch

    if not args.all and not args.db_id:
        _err('name a dataset (ant-ingest purge <db_id>) or pass --all')
        return 2
    datasets = ingest_versions.find_datasets(data_folder)
    if args.db_id:
        datasets = [entry for entry in datasets if entry['db_id'] == args.db_id]
        if not datasets:
            _err(f'{args.db_id}: no such dataset in {data_folder}')
            return 2
    if args.verified and not args.local_only:
        _err('--verified goes with --local-only (it checks the S3 copy before the local one goes)')
        return 2
    if args.superseded_minor and args.local_only:
        _err('--superseded-minor removes S3 and local copies; leave out --local-only')
        return 2
    client = _s3_client(s3_cfg) if (not args.local_only or args.verified) else None
    bucket = s3_cfg['bucket']
    refs = None
    if not args.local_only:                      # versions others point at stay unless --force (design 25)
        refs = ingest_versions.version_references(data_folder, anthive_config.get_facet_results_dir())
    plans = []
    kept = []
    for entry in datasets:
        if args.verified:
            plan = ingest_versions.plan_local_verified(entry, client, bucket, args.catalog_prefix)
        elif args.superseded_minor:
            from metadata import parse_md_file  # noqa: PLC0415
            meta = parse_md_file(entry['dataset_dir'] / f'{entry["basename"]}.md')[0]
            plan = ingest_versions.plan_superseded(entry, meta, client, bucket, args.catalog_prefix, refs,
                                                   force=args.force)
        else:
            plan = ingest_versions.plan_purge(entry['db_id'], entry['dataset_dir'], entry['rel_dir'],
                                              entry['basename'], entry['version'], args.keep, s3=client,
                                              bucket=bucket, catalog_prefix=args.catalog_prefix)
            if refs is not None:
                ingest_versions.protect_plan(plan, refs, force=args.force, s3=client, bucket=bucket,
                                             catalog_prefix=args.catalog_prefix)
        if plan.blocked:
            kept.append(plan)
        if plan.remove_versions:
            plans.append(plan)
    for plan in kept:
        for version, reasons in plan.blocked.items():
            print(f'{plan.db_id}  keeps {version}: {"; ".join(reasons)}')
    if not plans:
        print('Nothing to purge.' if (args.verified or args.superseded_minor) else f'Nothing to purge (keep {args.keep}).')
        return 0
    for plan in plans:
        print(f'{plan.db_id}  current {plan.current_version}  remove {", ".join(plan.remove_versions)}')
        for version, reasons in plan.references.items():
            if version in plan.remove_versions:
                print(f'    --force over: {version}: {"; ".join(reasons)}')
        for folder in plan.local_dirs:
            print(f'    local  {folder}')
        for key in plan.s3_keys:
            print(f'    s3     {key}')
    if args.dry_run:
        print('\n(dry-run: nothing deleted)')
        return 0
    if not args.yes:
        answer = input(f'Delete {sum(len(p.local_dirs) for p in plans)} folder(s) and '
                       f'{sum(len(p.s3_keys) for p in plans)} S3 key(s)? Type yes: ')
        if answer.strip().lower() != 'yes':
            print('Aborted, nothing deleted.')
            return 1
    db = ingest_watch.StateDB(anthive_config.get_ingest_state_dir() / ingest_watch.DB_FILE)
    for plan in plans:
        def record(kind: str, target: str, version: str, plan=plan) -> None:
            db.record_version(plan.db_id, f'{plan.rel_dir}/{plan.basename}', f'purged_{kind}', version, '', target)
        removed = ingest_versions.purge(plan, s3=client, bucket=bucket, record=record)
        _ok(f'{plan.db_id}: removed {removed["local_dirs"]} folder(s), {removed["s3_keys"]} S3 key(s)')
    db.close()
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(
        description='End-to-end ingestion from S3 __incoming/ to the anthive catalog.',
    )
    parser.add_argument(
        '--data-folder', default=None,
        help='h5adstore root (default: the configured store, h5adstore / ANTHIVE_H5ADSTORE)',
    )
    parser.add_argument(
        '--post-steps', default='',
        help='comma separated post steps after publication (score, gene_stats, module_variability, '
             'facet_test, facet_test_modules, ingest_index, manifest); default none',
    )
    parser.add_argument(
        '--git-commit', action='store_true',
        help='commit the .md / .h5ad.mus / index.md in the store repository',
    )
    parser.add_argument(
        '--filter', metavar='DATA_PROJECT',
        help='Only ingest this data project (matches __incoming/<DP>/)',
    )
    parser.add_argument(
        '--dry-run', action='store_true',
        help='Plan only, no downloads, no promotion, no uploads',
    )
    parser.add_argument(
        '--skip-orphan-scan', action='store_true',
        help='Skip the post-run S3 catalog-orphan scan (faster on big buckets)',
    )

    subparsers = parser.add_subparsers(dest='command')
    prune = subparsers.add_parser(
        'prune', help='Remove local staging + __incoming/ keys consumed by past runs',
    )
    prune.add_argument(
        '--dry-run', action='store_true',
        help='Preview what would be deleted (nothing destructive)',
    )
    prune.add_argument(
        '--include-catalog-orphans', action='store_true',
        help='Also delete S3 catalog keys with no local counterpart',
    )

    purge_parser = subparsers.add_parser(
        'purge', help='Remove archived versions of datasets (local _versions/ folders and their S3 keys)',
    )
    purge_parser.add_argument('db_id', nargs='?', help='dataset id, e.g. WT6/MIC')
    purge_parser.add_argument('--all', action='store_true', help='every dataset')
    purge_parser.add_argument('--keep', type=int, default=1,
                              help='versions to keep, the current one included (default 1: only the current)')
    purge_parser.add_argument('--dry-run', action='store_true', help='show what would be removed')
    purge_parser.add_argument('--yes', action='store_true', help='do not ask for confirmation')
    purge_parser.add_argument('--local-only', action='store_true', help='leave S3 alone')
    purge_parser.add_argument('--verified', action='store_true',
                              help='with --local-only: remove only local copies whose S3 copy is verified '
                                   '(sha256), whatever --keep says')
    purge_parser.add_argument('--superseded-minor', action='store_true',
                              help='remove archived versions (S3 and local) whose successor is a patch or minor '
                                   'version verified on S3; major predecessors stay')
    purge_parser.add_argument('--force', action='store_true',
                              help="also versions an artefact's made_from or a facet result names (listed)")
    purge_parser.add_argument('--catalog-prefix', default='', help="catalog prefix on S3 ('' = the root)")

    args = parser.parse_args()
    if hasattr(args, 'post_steps') and isinstance(args.post_steps, str):
        args.post_steps = [step for step in args.post_steps.split(',') if step]

    cfg = get_config()
    if 's3' not in cfg:
        _err('No [s3] block in anthive.yaml')
        return 2

    # Slave gate. Both the ingest run and prune modify the local
    # catalog + S3 state. Slaves are read-only mirrors and need a
    # clear refusal before any S3 client is constructed. Dry-run is
    # also blocked — the principle is "no catalog ops on slaves" and
    # a dry-run could be misleading about the slave's actual capacity
    # to perform the action.
    require_primary(cfg, tool='ant-ingest')

    data_folder = (Path(args.data_folder).resolve() if args.data_folder
                   else anthive_config.get_data_folder(cfg).resolve())
    if not data_folder.exists():
        _err(f'data folder not found: {data_folder}')
        return 2

    import ingest_watch
    try:
        with ingest_watch.WatchLock(anthive_config.get_ingest_state_dir(cfg)):   # never beside a watcher run
            if args.command == 'prune':
                return cmd_prune(args, cfg['s3'], data_folder)
            if args.command == 'purge':
                return cmd_purge(args, cfg['s3'], data_folder)
            return cmd_run(args, cfg['s3'], data_folder)
    except ingest_watch.LockBusy as exc:
        _err(f'{exc}; try again when it has finished')
        return 3


if __name__ == '__main__':
    sys.exit(main())
