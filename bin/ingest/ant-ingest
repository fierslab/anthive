@dataclass
class DatasetPlan:
    """One h5ad found in __incoming/ — the unit of ingestion."""
    data_project: str
    subfolder: Optional[str]
    basename: str                            # e.g. 'Microglia' (without .h5ad)
    incoming_h5ad_key: str                   # S3 key of the .h5ad
    incoming_mus_key: str                    # S3 key of the .h5ad.mus
    static_keys: List[str] = field(default_factory=list)

    @property
    def display_name(self) -> str:
        if self.subfolder:
            return f'{self.data_project}/{self.subfolder}/{self.basename}'
        return f'{self.data_project}/{self.basename}'


@dataclass
class DatasetResult:
    plan: DatasetPlan
    status: str = 'pending'          # ok / skipped / failed / conflict
    detail: str = ''
    sidecar_conflicts: List[Conflict] = field(default_factory=list)
    static_conflicts: List[str] = field(default_factory=list)
    staging_files: List[str] = field(default_factory=list)   # paths relative to staging root
    promoted_files: List[str] = field(default_factory=list)  # absolute catalog paths
    s3_incoming_keys: List[str] = field(default_factory=list)
    s3_incoming_etags: Dict[str, str] = field(default_factory=dict)


@dataclass
class DEPlan:
    """One DE file under __incoming/<dp>/de/<local-parent>/. Resolves to
    a single ant-de-ingest call against one target h5ad.

    The mus contract (#125-#138, shipped mus 0.2.24) puts:
      __incoming/<dp>/de/<local-parent>/<basename>.tsv      (or .csv)
      __incoming/<dp>/de/<local-parent>/<basename>.tsv.mus  (collapsed sidecar)

    Each DE file is one ingest unit. Multi-file analyses (one per cluster)
    produce multiple DEPlans bound to the same data_project + target h5ad.
    """
    data_project: str
    local_parent: str                 # the folder name under de/ (e.g. 'main_model')
    basename: str                     # the full filename including extension (e.g. 'carlo_mg_DAM_vs_homeo.tsv')
    incoming_data_key: str            # S3 key of the data file
    incoming_mus_key: str             # S3 key of the .mus sidecar

    @property
    def display_name(self) -> str:
        return f'{self.data_project}/de/{self.local_parent}/{self.basename}'


@dataclass
class DEResult:
    plan: DEPlan
    status: str = 'pending'            # ok / skipped / failed / conflict
    detail: str = ''
    staging_files: List[str] = field(default_factory=list)
