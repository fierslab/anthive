def _resolve_target_h5ad(
    data_folder: Path,
    data_project: str,
    de_dataset_id: Optional[str],
    de_dataset_h5ad: Optional[str],
) -> Tuple[Optional[Path], str]:
    """Resolve a DE deposit's target h5ad in the local catalog.

    Returns (h5ad_path, reason). h5ad_path is None if unresolved; reason
    is a human-readable explanation either way.

    Resolution order (preferring de_dataset_id since basenames are
    mutable — see #132):
      1. de_dataset_id: scan <data_project>/**/*.md for frontmatter
         `id:` matching, take the sibling <basename>.h5ad.
      2. de_dataset_h5ad: just look at <data_project>/<basename>.h5ad
         (and one level of nested subfolders).
    """
    project_dir = data_folder / data_project
    if not project_dir.exists():
        return None, f"data_project folder not on disk: {project_dir}"

    if de_dataset_id:
        # Walk the project dir for any .md whose frontmatter has id:
        # matching. Tracks the opening/closing `---` fences explicitly;
        # only looks at lines INSIDE the frontmatter block.
        #
        # The frontmatter block is bounded by the closing `---` fence —
        # no fixed line cap. Some .md files run 150+ lines of frontmatter
        # because obscat_include / obsnum_include / layer_stats lists can
        # be long; an arbitrary 60-line cap silently misses the `id:`
        # field on those (bit us on Sun2026/AQB).
        for md_path in sorted(project_dir.rglob('*.md')):
            if md_path.name == 'index.md':
                continue
            try:
                text = md_path.read_text(encoding='utf-8', errors='replace')
            except OSError:
                continue
            if not text.startswith('---\n'):
                continue
            in_frontmatter = False
            for line in text.split('\n'):
                stripped = line.strip()
                if stripped == '---':
                    if not in_frontmatter:
                        in_frontmatter = True
                        continue
                    break  # closing fence
                if not in_frontmatter:
                    continue
                if stripped.lower().startswith('id:'):
                    val = stripped.split(':', 1)[1].strip().strip('"\'')
                    if val == de_dataset_id:
                        h5ad = md_path.with_suffix('.h5ad')
                        if h5ad.exists():
                            return h5ad, f"matched de_dataset_id={de_dataset_id} → {h5ad.name}"
                        return None, (
                            f"de_dataset_id={de_dataset_id} matches {md_path.name} but "
                            f"sibling h5ad ({h5ad.name}) not on disk"
                        )
                    break  # id: line found and didn't match, stop scanning this .md
        return None, f"no .md frontmatter `id:` matches de_dataset_id={de_dataset_id!r} in {data_project}"

    if de_dataset_h5ad:
        # Direct lookup; also handle one level of subfolder.
        cand = project_dir / de_dataset_h5ad
        if cand.exists():
            return cand, f"matched de_dataset_h5ad={de_dataset_h5ad}"
        # Search one level deep
        for sub in project_dir.iterdir():
            if sub.is_dir() and not sub.name.startswith(('_', '.')):
                deeper = sub / de_dataset_h5ad
                if deeper.exists():
                    return deeper, f"matched de_dataset_h5ad={de_dataset_h5ad} (in {sub.name}/)"
        return None, f"de_dataset_h5ad={de_dataset_h5ad!r} not found under {data_project}"

    return None, "neither de_dataset_id nor de_dataset_h5ad set in sidecar"


def _de_staging_dir(data_folder: Path, plan: DEPlan) -> Path:
    return _work_root() / 'de' / plan.data_project / plan.local_parent


def _process_de(
    plan: DEPlan,
    client,
    bucket: str,
    data_folder: Path,
    args: argparse.Namespace,
) -> DEResult:
    """Pull a DE file + sidecar → resolve target h5ad → call ant-de-ingest.

    Per #134 contract:
      - DE sidecar carries de_format, de_dataset_id / de_dataset_h5ad,
        de_term, de_contrast, de_cluster, de_cluster_obs_column, de_method,
        de_software_version, de_reference_type, de_covariates,
        de_description, plus sha256 of the data file.
      - Target h5ad must already be in the catalog (mus's check passed
        because either it co-ingested an h5ad in the same deposit, or the
        depositor pointed at an existing catalog id).
      - Run ant-de-ingest with the right preset + flags; write a .de.parquet
        sidecar next to the catalog h5ad.
    """
    result = DEResult(plan=plan)
    print(f'\n─── DE  {plan.display_name} ───')

    staging_dir = _de_staging_dir(data_folder, plan)
    staged_data = staging_dir / plan.basename
    staged_mus = staging_dir / (plan.basename + '.mus')

    if args.dry_run:
        result.status = 'dry-run'
        result.detail = f'would pull DE {plan.incoming_data_key} + sidecar'
        result.s3_incoming_keys = [plan.incoming_data_key, plan.incoming_mus_key]
        return result

    # 1. Pull sidecar + data file into staging.
    try:
        print(f'  Pulling sidecar  {plan.incoming_mus_key}')
        _download(client, bucket, plan.incoming_mus_key, staged_mus)
        result.staging_files.append(str(staged_mus))
        size_hint = _human_size(client, bucket, plan.incoming_data_key)
        print(f'  Pulling DE data  {plan.incoming_data_key} ({size_hint})')
        _download(client, bucket, plan.incoming_data_key, staged_data)
        result.staging_files.append(str(staged_data))
    except ClientError as exc:
        result.status = 'failed'
        result.detail = f'pull failed: {exc}'
        _err(result.detail)
        return result

    # 2. Parse sidecar + verify sha256 of the data file.
    incoming_text = staged_mus.read_text(encoding='utf-8', errors='replace')
    incoming_meta = _parse_sidecar_keys(incoming_text)
    declared_sha = incoming_meta.get('sha256', '')
    actual_sha = _sha256_file(staged_data)
    if declared_sha and declared_sha != actual_sha:
        result.status = 'failed'
        result.detail = (
            f'DE file sha256 mismatch: pulled {actual_sha}, '
            f'sidecar declared {declared_sha}. Possible mid-upload race.'
        )
        _err(result.detail)
        return result
    if declared_sha:
        _ok(f'sha256 verified ({actual_sha[:12]}…)')

    # 3. Resolve target h5ad.
    de_dataset_id = incoming_meta.get('de_dataset_id')
    de_dataset_h5ad = incoming_meta.get('de_dataset_h5ad')
    target_h5ad, reason = _resolve_target_h5ad(
        data_folder, plan.data_project, de_dataset_id, de_dataset_h5ad,
    )
    if target_h5ad is None:
        result.status = 'failed'
        result.detail = f'cannot resolve target h5ad: {reason}'
        _err(result.detail)
        return result
    _ok(f'target h5ad: {target_h5ad.relative_to(data_folder)}  ({reason})')

    # 4. Promote sidecar to data/h5adstore/<dp>/de_sources/<local-parent>/<basename>.mus
    #    (the data file rides too — kept as the audit trail). The .de.parquet
    #    written by ant-de-ingest goes next to the h5ad, NOT into de_sources.
    de_sources_dir = data_folder / plan.data_project / 'de_sources' / plan.local_parent
    de_sources_dir.mkdir(parents=True, exist_ok=True)
    catalog_data = de_sources_dir / plan.basename
    catalog_mus = de_sources_dir / (plan.basename + '.mus')

    if catalog_data.exists():
        existing_sha = _sha256_file(catalog_data)
        if existing_sha != actual_sha:
            result.status = 'conflict'
            result.detail = (
                f'DE source collision: {catalog_data.relative_to(data_folder)} '
                f'already exists with different sha {existing_sha[:8]}… '
                f'(incoming {actual_sha[:8]}…). Rename the local-parent '
                f'or remove the existing source.'
            )
            _err(result.detail)
            return result
        _ok('catalog DE source already present with matching sha — re-ingesting')
    else:
        shutil.move(str(staged_data), str(catalog_data))
        result.promoted_files.append(str(catalog_data))
    shutil.move(str(staged_mus), str(catalog_mus))
    result.promoted_files.append(str(catalog_mus))
    _ok(f'promoted DE source → {catalog_data.relative_to(data_folder)}')

    # 5. Build the ant-de-ingest command.
    target_duckdb = target_h5ad.with_suffix('.duckdb')
    if not target_duckdb.exists():
        result.status = 'failed'
        result.detail = f'target duckdb missing: {target_duckdb}'
        _err(result.detail)
        return result

    de_format = incoming_meta.get('de_format')
    if not de_format:
        result.status = 'failed'
        result.detail = 'sidecar missing required key: de_format'
        _err(result.detail)
        return result
    de_method = incoming_meta.get('de_method')
    de_term = incoming_meta.get('de_term')
    de_contrast = incoming_meta.get('de_contrast')
    de_description = incoming_meta.get('de_description')
    de_covariates = incoming_meta.get('de_covariates')
    de_reference_type = incoming_meta.get('de_reference_type')

    # Fall back to the preset's default_method when the sidecar didn't set
    # one. ant-de-ingest requires --method for every preset; deseq2 / edger /
    # scanpy / seurat / glmmseq / glmmtmb each declare a sensible default,
    # but `long` has none — those deposits still hard-fail with a clear
    # error message if the depositor didn't supply de_method explicitly.
    if not de_method and de_format:
        try:
            sys.path.insert(0, str(_REPO_ROOT / 'lib'))
            from de_presets import PRESETS as _DE_PRESETS  # noqa: E402
            preset_obj = _DE_PRESETS.get(de_format)
            if preset_obj and preset_obj.default_method:
                de_method = preset_obj.default_method
                _ok(f'no de_method in sidecar — using preset default {de_method!r}')
        except ImportError:
            pass

    # Study id: prefer mus-supplied if present, else file-stem.
    study_id = incoming_meta.get('de_study_id') or _de_study_id_from_basename(plan.basename)

    # ant-de-ingest lives in bin/annot/, not bin/ingest/. Path was not
    # updated when the bin/<domain>/ reorg happened — _SCRIPT_DIR points
    # at bin/ingest/ here, which has no ant-de-ingest. Resolve via the
    # repo root + annot/ instead.
    ant_de_ingest = _REPO_ROOT / 'bin' / 'annot' / 'ant-de-ingest'

    # --replace: idempotent re-ingest. Without this, re-running ant-ingest
    # against an __incoming/ deposit that's already landed (because the
    # depositor didn't prune, or a partial run inserted some studies)
    # would collide with "study exists". `--replace` deletes the prior
    # rows for the same study_id and re-inserts — safe because the
    # study_id key is stable per sidecar, and the source data file is
    # sha-verified before promotion.
    cmd = [
        str(ant_de_ingest),
        str(target_duckdb),
        '--from', str(catalog_data),
        '--preset', de_format,
        '--study-id', study_id,
        '--no-sidecar',           # we'll handle sidecar regen ourselves
        '--replace',
    ]
    if de_method:
        cmd += ['--method', de_method]
    if de_term:
        cmd += ['--term', de_term]
    if de_contrast:
        cmd += ['--contrast', de_contrast]
    if de_description:
        cmd += ['--description', de_description]
    if de_covariates:
        cmd += ['--covariates', de_covariates]

    # de_map_<TARGET>=<SRC> sidecar keys translate the source TSV/CSV
    # column names to anthive's canonical __de columns. Required for the
    # `long` preset (where the depositor's column names are arbitrary)
    # and an override for other presets when a source column name doesn't
    # match the preset's expected name. mus stamps these as separate keys
    # per the design discussion (cleaner than a comma-encoded blob); we
    # collect them all and emit a single --map gene=...,log2fc=...,... .
    map_pairs: List[str] = []
    for key, value in incoming_meta.items():
        if not key.startswith('de_map_'):
            continue
        target = key[len('de_map_'):].strip()
        source = str(value).strip()
        if not target or not source:
            continue
        map_pairs.append(f'{target}={source}')
    if map_pairs:
        cmd += ['--map', ','.join(map_pairs)]
    if de_reference_type:
        cmd += ['--reference-type', de_reference_type]

    ok, msg = _run('ant-de-ingest', cmd)
    if not ok:
        result.status = 'failed'
        result.detail = msg
        _err(msg)
        return result
    _ok('ant-de-ingest ok')

    # 6. Record S3 incoming keys for pending prune.
    result.s3_incoming_keys = [plan.incoming_mus_key, plan.incoming_data_key]
    result.status = 'ok'
    result.detail = f'ingested → study_id={study_id}'
    return result


def _de_study_id_from_basename(basename: str) -> str:
    """Strip the data-file extension from the basename to produce a
    default study_id. Matches ant-de-ingest's default behaviour."""
    for ext in _DE_DATA_EXTS:
        if basename.endswith(ext):
            return basename[: -len(ext)]
    # Fallback — strip the last suffix.
    return basename.rsplit('.', 1)[0]


def cmd_run(args: argparse.Namespace, s3_cfg: dict, data_folder: Path) -> int:
    client = _s3_client(s3_cfg)
    bucket = s3_cfg['bucket']

    print(f'Scanning s3://{bucket}/{INCOMING_PREFIX} …')
    try:
        objects = _list_incoming(client, bucket, args.filter)
    except ClientError as exc:
        _err(f'list_objects_v2 failed: {exc}')
        return 2

    items, malformed = plan_items(objects, INCOMING_PREFIX)
    de_plans, de_malformed = _group_into_de_plans(objects)
    malformed.extend(de_malformed)

    if not items and not de_plans and not malformed:
        print('  (nothing under __incoming/)')
        _print_prune_hints(data_folder, [], client, bucket, args)
        return 0

    parts = []
    if items:
        parts.append(f'{len(items)} h5ad dataset(s)')
    if de_plans:
        parts.append(f'{len(de_plans)} DE deposit(s)')
    if malformed:
        parts.append(f'{len(malformed)} malformed')
    print(f"  Found {', '.join(parts) or '(nothing)'}")

    # Process h5ads FIRST so DE files can resolve their target_id against
    # an already-promoted .md. (Mus's recommended ingest order, #134.)
    state_dir = anthive_config.get_ingest_state_dir()
    pipeline = Pipeline(
        PipelineConfig(store_root=data_folder, work_root=_work_root(), reports_root=state_dir / 'reports',
                       bucket=bucket, catalog_prefix='', post_steps=args.post_steps,
                       store_git_commit=args.git_commit, route='manual', state_dir=state_dir,
                       s3_endpoint=s3_cfg.get('endpoint'),
                       min_free_gb=anthive_config.get_ingest_watch_settings()['min_free_gb'],
                       require_update_marker=anthive_config.get_ingest_watch_settings()['require_update_marker']),
        client, SubprocessRunner(log_path=state_dir / 'logs' / f'ant_ingest_{time.strftime("%Y%m%d")}.log'),
        ApiClient(anthive_config.get_api_url(), anthive_config.internal_auth_headers(), retry_delays=(2, 5, 10)),
        log=lambda message: print(_dim(f'  {message}')))
    pipeline.recover()
    results: List[DatasetResult] = []
    consumed_by_pipeline: set = set()
    for item in items:
        result = _process_dataset(item, pipeline, args)
        results.append(result)
        consumed_by_pipeline.update(result.s3_incoming_keys)

    # Process DE files SECOND (those the h5ad pipeline did not already ingest).
    de_results: List[DEResult] = []
    for plan in de_plans:
        if plan.incoming_data_key in consumed_by_pipeline:
            continue
        de_result = _process_de(plan, client, bucket, data_folder, args)
        de_results.append(de_result)

    if not args.dry_run:
        _append_to_ledger(data_folder, results)
        _append_de_to_ledger(data_folder, de_results)

    _print_run_report(results, malformed)
    _print_de_run_report(de_results)
    _print_prune_hints(data_folder, results, client, bucket, args,
                       de_results=de_results)

    # Always refresh the catalog manifest on S3 — mus reads it to validate
    # sidecars at deposit time. Reflects the LOCAL catalog state regardless
    # of whether this particular ingest run added or removed anything.
    if not args.dry_run:
        try:
            from catalog_manifest import write_manifest
            manifest = write_manifest(data_folder, client, bucket)
            n_proj = len(manifest['data_projects'])
            n_ds = sum(len(p['datasets']) for p in manifest['data_projects'].values())
            print(f'\n  catalog manifest refreshed: {n_proj} data_project(s), {n_ds} dataset(s)')
        except Exception as exc:
            print(f'\n  WARNING: catalog manifest refresh failed: {exc}')
            print('  (ingest itself succeeded; rerun or re-trigger via ant-build-all to retry the manifest)')

    any_failed = (
        any(r.status in {'failed', 'conflict'} for r in results)
        or any(r.status in {'failed', 'conflict'} for r in de_results)
    )
    return 1 if any_failed else 0


def cmd_prune(args: argparse.Namespace, s3_cfg: dict, data_folder: Path) -> int:
    client = _s3_client(s3_cfg)
    bucket = s3_cfg['bucket']

    ledger = _load_ledger(data_folder)
    datasets = ledger.get('datasets', [])

    print(f'Loaded {len(datasets)} dataset(s) from pending-prune ledger.')

    staging_files: List[Path] = []
    incoming_keys: List[str] = []
    expected_etags: Dict[str, str] = {}
    for entry in datasets:
        for path_str in entry.get('staging_files', []):
            path = Path(path_str)
            if path.exists():
                staging_files.append(path)
        incoming_keys.extend(entry.get('s3_incoming_keys', []))
        expected_etags.update(entry.get('s3_incoming_etags') or {})

    orphan_keys: List[str] = []
    if args.include_catalog_orphans:
        print('Scanning S3 for catalog orphans …')
        try:
            orphan_keys = _catalog_orphans(client, bucket, data_folder)
        except ClientError as exc:
            _err(f'orphan scan failed: {exc}')
            return 2

    print()
    print(f'  Local staging files: {len(staging_files)}')
    print(f'  S3 __incoming/ keys: {len(incoming_keys)}')
    if args.include_catalog_orphans:
        print(f'  S3 catalog orphans:  {len(orphan_keys)}')

    if args.dry_run:
        for path in staging_files[:5]:
            print(f'    [would rm]      {path}')
        if len(staging_files) > 5:
            print(f'    … and {len(staging_files)-5} more local files')
        for key in incoming_keys[:5]:
            print(f'    [would s3 del]  {key}')
        if len(incoming_keys) > 5:
            print(f'    … and {len(incoming_keys)-5} more incoming keys')
        for key in orphan_keys[:5]:
            print(f'    [would s3 del]  {key}')
        if len(orphan_keys) > 5:
            print(f'    … and {len(orphan_keys)-5} more orphan keys')
        print('\n(dry-run: nothing deleted)')
        return 0

    deleted_local = 0
    work_root = _work_root().resolve()
    for path in staging_files:
        try:
            if path.is_dir():
                resolved = path.resolve()
                if work_root in resolved.parents:          # an item's work dir, never the work root itself
                    shutil.rmtree(path)
                    deleted_local += 1
            else:
                path.unlink()
                deleted_local += 1
        except FileNotFoundError:
            pass

    # Also remove work dirs that became empty.
    staging_root = _work_root()
    if staging_root.exists():
        for sub in sorted(staging_root.rglob('*'), reverse=True):
            if sub.is_dir() and not any(sub.iterdir()):
                sub.rmdir()

    changed = [key for key, etag in expected_etags.items()
               if key in incoming_keys and head_etag(client, bucket, key) not in (None, etag)]
    for key in changed:
        _warn(f'kept {key}: its ETag changed since it was ingested (a newer upload)')
    deleted_remote = _bulk_delete(client, bucket, [key for key in incoming_keys if key not in changed] + orphan_keys)

    # Clear processed entries from the ledger.
    if not args.include_catalog_orphans:
        # Only clear successful ingest entries; orphan mode doesn't touch them.
        ledger['datasets'] = []
    _save_ledger(data_folder, ledger)

    _ok(f'removed {deleted_local} local file(s)')
    _ok(f'removed {deleted_remote} S3 key(s)')
    return 0


def _bulk_delete(client, bucket: str, keys: List[str]) -> int:
    """Delete S3 keys 1000 at a time (boto3 limit). Returns count deleted."""
    deleted = 0
    for i in range(0, len(keys), 1000):
        batch = keys[i:i + 1000]
        if not batch:
            continue
        try:
            resp = client.delete_objects(
                Bucket=bucket,
                Delete={'Objects': [{'Key': k} for k in batch], 'Quiet': True},
            )
            deleted += len(batch) - len(resp.get('Errors', []) or [])
            for err in resp.get('Errors', []) or []:
                _warn(f'delete failed for {err.get("Key")}: {err.get("Message")}')
        except ClientError as exc:
            _err(f'bulk delete failed: {exc}')
    return deleted


