_PIPELINE_STATE_TO_STATUS = {'live': 'ok', 'held': 'held', 'failed': 'failed', 'needs_decision': 'conflict'}


def _work_root() -> Path:
    """Work dir of the manual route (outside the store)."""
    return anthive_config.get_ingest_work_dir() / 'manual'


def _process_dataset(item, pipeline: Pipeline, args: argparse.Namespace) -> DatasetResult:
    """Run one deposited h5ad through the shared pipeline (lib/ingest_pipeline.py)."""
    plan = DatasetPlan(
        data_project=item.data_project, subfolder=item.subfolder, basename=item.basename,
        incoming_h5ad_key=item.h5ad.key, incoming_mus_key=item.mus.key if item.mus else '',
        static_keys=[obj.key for obj in item.static_to_consume()],
    )
    result = DatasetResult(plan=plan)
    print(f'\n─── {plan.display_name} ───')
    if args.dry_run:
        result.status = 'dry-run'
        result.detail = f'would pull {plan.incoming_h5ad_key} + sidecar, check, convert and publish'
        result.s3_incoming_keys = [plan.incoming_h5ad_key, plan.incoming_mus_key]
        return result
    if item.mus is None:
        result.status = 'failed'
        result.detail = f'missing companion sidecar {item.h5ad.key}.mus'
        _err(result.detail)
        return result
    try:
        outcome = pipeline.process(item)
    except TransientError as exc:
        result.status = 'failed'
        result.detail = f'S3 or server error, rerun later: {exc}'
        _err(result.detail)
        return result
    result.status = _PIPELINE_STATE_TO_STATUS.get(outcome.state, outcome.state)
    result.detail = outcome.detail + (f'  (report: {outcome.report_path})' if outcome.report_path else '')
    for warning in outcome.warnings:
        _warn(warning)
    if outcome.state == 'live':
        _ok(f'{outcome.db_id} {outcome.kind} {outcome.version}')
        result.s3_incoming_keys = sorted(outcome.consumed)
        result.s3_incoming_etags = dict(outcome.consumed)
        result.staging_files = [str(pipeline.config.work_root / ingest_slug(item.key))]
        result.promoted_files = [outcome.store_h5ad] if outcome.store_h5ad else []
    else:
        _err(f'{outcome.state}: {outcome.detail}')
    return result


def _fmt_size(num_bytes: int) -> str:
    for unit in ('B', 'KB', 'MB', 'GB', 'TB'):
        if num_bytes < 1024 or unit == 'TB':
            return f'{num_bytes:.1f} {unit}'
        num_bytes /= 1024
    return str(num_bytes)


def _human_size(client, bucket: str, key: str) -> str:
    try:
        head = client.head_object(Bucket=bucket, Key=key)
        return _fmt_size(head['ContentLength'])
    except Exception:
        return '?'


