def _s3_client(s3_cfg: dict):
    endpoint = s3_cfg.get('endpoint')
    # Adaptive retries with a bigger budget — Hetzner S3 in particular
    # returns transient 5xx / socket errors on large multipart downloads,
    # and the default max_attempts=5 blows up whole downloads on a single
    # flake. `adaptive` mode also backs off on client-side throttling.
    # read_timeout is bumped for very large parts.
    return boto3.client(
        's3',
        endpoint_url=f'https://{endpoint}' if endpoint else None,
        region_name=s3_cfg.get('region', 'us-east-1'),
        aws_access_key_id=s3_cfg.get('access_key_id'),
        aws_secret_access_key=s3_cfg.get('secret_access_key'),
        config=BotoConfig(
            retries={'max_attempts': 20, 'mode': 'adaptive'},
            connect_timeout=30,
            read_timeout=300,
        ),
    )


def _transfer_config() -> TransferConfig:
    return TransferConfig(
        multipart_threshold=MULTIPART_THRESHOLD,
        multipart_chunksize=MULTIPART_CHUNKSIZE,
        max_concurrency=4,
    )


def _list_incoming(client, bucket: str, filter_project: Optional[str]) -> List[dict]:
    """List every object under __incoming/ — returns full S3 metadata dicts."""
    paginator = client.get_paginator('list_objects_v2')
    prefix = INCOMING_PREFIX
    if filter_project:
        prefix = f'{INCOMING_PREFIX}{filter_project.strip("/")}/'
    objects: List[dict] = []
    for page in paginator.paginate(Bucket=bucket, Prefix=prefix):
        for obj in page.get('Contents', []):
            objects.append(obj)
    return objects


def _group_into_plans(objects: List[dict]) -> Tuple[List[DatasetPlan], List[str]]:
    """Group the listing into DatasetPlan units.

    Rules:
      - Each .h5ad in __incoming/ creates one plan; the matching .h5ad.mus
        MUST exist or the dataset is reported as malformed.
      - The relative path between __incoming/<dp>/ and the file decides
        whether it's at the project root, under a subfolder, or under static/.
        Depth >1 (beyond a single subfolder) is rejected as malformed.

    Returns (plans, malformed_messages).
    """
    by_key: Dict[str, dict] = {obj['Key']: obj for obj in objects}
    keys = sorted(by_key)

    h5ad_keys = [k for k in keys if k.endswith(H5AD_SUFFIX)]
    plans: List[DatasetPlan] = []
    malformed: List[str] = []

    for h5ad_key in h5ad_keys:
        # __incoming/<dp>/...rest...
        rest = h5ad_key[len(INCOMING_PREFIX):]
        parts = rest.split('/')
        if len(parts) < 2:
            malformed.append(f'{h5ad_key}: not under __incoming/<data_project>/')
            continue
        data_project = parts[0]
        tail = parts[1:]

        subfolder: Optional[str] = None
        if len(tail) == 1:
            filename = tail[0]
        elif len(tail) == 2 and tail[0] != 'static':
            subfolder, filename = tail
        else:
            malformed.append(
                f'{h5ad_key}: too deep '
                f'(expected __incoming/<dp>/[<subfolder>/]<file>.h5ad)'
            )
            continue

        if not filename.endswith(H5AD_SUFFIX):
            continue  # shouldn't happen — already filtered
        basename = filename[:-len(H5AD_SUFFIX)]

        # Required sidecar key.
        if subfolder:
            mus_key = f'{INCOMING_PREFIX}{data_project}/{subfolder}/{filename}.mus'
        else:
            mus_key = f'{INCOMING_PREFIX}{data_project}/{filename}.mus'
        if mus_key not in by_key:
            malformed.append(
                f'{h5ad_key}: missing companion sidecar at {mus_key}. '
                f'Skipping (mus is expected to deposit both atomically).'
            )
            continue

        plans.append(DatasetPlan(
            data_project=data_project,
            subfolder=subfolder,
            basename=basename,
            incoming_h5ad_key=h5ad_key,
            incoming_mus_key=mus_key,
        ))

    # Static files are associated with a data_project, not a specific h5ad,
    # so we just attach them to every plan in that project; promotion is
    # sha-aware so the same file copied multiple times is a no-op.
    static_by_project: Dict[str, List[str]] = {}
    for key in keys:
        rest = key[len(INCOMING_PREFIX):]
        parts = rest.split('/')
        if len(parts) >= 3 and parts[1] == 'static':
            static_by_project.setdefault(parts[0], []).append(key)
    for plan in plans:
        plan.static_keys = static_by_project.get(plan.data_project, [])

    return plans, malformed


# DE file extensions we accept (mus deposit gate rejects .parquet).
_DE_DATA_EXTS = ('.tsv', '.csv', '.tsv.gz', '.csv.gz')


def _group_into_de_plans(objects: List[dict]) -> Tuple[List[DEPlan], List[str]]:
    """Find DE deposits under __incoming/<dp>/de/<local-parent>/<basename>.

    Per the mus contract: every DE primary has a companion `.mus`
    collapsed sidecar at the same path with `.mus` appended. Layout is
    one folder per analysis (local-parent), one file per contrast
    (basename).

    Returns (de_plans, malformed_messages).
    """
    by_key: Dict[str, dict] = {obj['Key']: obj for obj in objects}
    keys = sorted(by_key)
    plans: List[DEPlan] = []
    malformed: List[str] = []

    for key in keys:
        rest = key[len(INCOMING_PREFIX):]
        parts = rest.split('/')
        # __incoming/<dp>/de/<local-parent>/<basename>
        if len(parts) < 4 or parts[1] != 'de':
            continue
        data_project = parts[0]
        local_parent = parts[2]
        filename = parts[3]

        # Skip .mus sidecars themselves — they're paired with data files.
        if filename.endswith('.mus'):
            continue
        # Reject parquet at the deposit gate (mus already does, but defend
        # against an out-of-band put).
        if filename.endswith('.parquet'):
            malformed.append(
                f'{key}: parquet not accepted in DE deposits — '
                f'mus de check should refuse this. Convert to .tsv.'
            )
            continue
        # Only accept the data-file extensions mus's check allows.
        if not any(filename.endswith(ext) for ext in _DE_DATA_EXTS):
            malformed.append(
                f"{key}: DE file has unrecognized extension "
                f"(want one of {_DE_DATA_EXTS})"
            )
            continue
        # Companion sidecar required.
        mus_key = f'{key}.mus'
        if mus_key not in by_key:
            malformed.append(
                f'{key}: missing companion .mus sidecar at {mus_key}. '
                f'mus is expected to deposit both atomically — skipping.'
            )
            continue

        plans.append(DEPlan(
            data_project=data_project,
            local_parent=local_parent,
            basename=filename,
            incoming_data_key=key,
            incoming_mus_key=mus_key,
        ))

    return plans, malformed


# Resumable-download threshold: files larger than this use range-GET chunks
# with a per-chunk progress sidecar so an interrupted download can resume
# without re-transferring anything already on disk. Below this, boto3's
# multipart transfer is fine (its internal retries handle small blips).
RESUMABLE_THRESHOLD = 1 * 1024 ** 3   # 1 GB
RESUMABLE_CHUNK     = 256 * 1024 ** 2 # 256 MB per range-GET
RESUMABLE_WORKERS   = 4               # concurrent chunks
RESUMABLE_RETRIES   = 15              # per-chunk retries on top of boto3's own


def _download(client, bucket: str, key: str, dest: Path) -> None:
    dest.parent.mkdir(parents=True, exist_ok=True)
    try:
        head = client.head_object(Bucket=bucket, Key=key)
        size = head['ContentLength']
    except Exception:
        size = None
    if size is not None and size >= RESUMABLE_THRESHOLD:
        _download_resumable(client, bucket, key, dest, size)
    else:
        client.download_file(bucket, key, str(dest), Config=_transfer_config())


def _download_resumable(client, bucket: str, key: str, dest: Path, size: int) -> None:
    """Concurrent range-GET download with per-chunk resume state.

    Chunks are written directly at their file offset via ``os.pwrite``. A
    JSON sidecar next to the destination (``<dest>.progress``) tracks
    which chunk indices are done, so an interrupted run continues without
    re-downloading anything already on disk.

    Rationale: boto3's built-in ``download_file`` uses multipart concurrent
    downloads but if a single part exhausts its own retries the whole
    download fails and the file is discarded. On a Hetzner-flavoured 125
    GB pull that means paying for the whole file every attempt. This
    variant lets us pay only for the parts that actually failed.
    """
    import json
    import os
    from concurrent.futures import ThreadPoolExecutor, as_completed

    n_chunks = (size + RESUMABLE_CHUNK - 1) // RESUMABLE_CHUNK
    progress_path = dest.with_suffix(dest.suffix + '.progress')
    done: set[int] = set()

    if progress_path.exists() and dest.exists():
        try:
            state = json.loads(progress_path.read_text())
            if state.get('key') == key and state.get('size') == size:
                done = set(state.get('done', []))
        except (OSError, ValueError):
            done = set()

    if not dest.exists() or dest.stat().st_size != size:
        with open(dest, 'wb') as fh:
            fh.truncate(size)
        done = set()   # size mismatch → start over

    def _fetch(idx: int) -> int:
        start = idx * RESUMABLE_CHUNK
        end = min(start + RESUMABLE_CHUNK, size) - 1
        expected = end - start + 1
        last_exc: Optional[BaseException] = None
        for attempt in range(RESUMABLE_RETRIES):
            try:
                resp = client.get_object(
                    Bucket=bucket, Key=key, Range=f'bytes={start}-{end}',
                )
                body = resp['Body'].read()
                if len(body) != expected:
                    raise IOError(
                        f'chunk {idx}: got {len(body)} bytes, expected {expected}'
                    )
                fd = os.open(dest, os.O_WRONLY)
                try:
                    os.pwrite(fd, body, start)
                finally:
                    os.close(fd)
                return idx
            except (ClientError, IOError, OSError) as exc:
                last_exc = exc
                if attempt < RESUMABLE_RETRIES - 1:
                    time.sleep(min(60, 2 ** attempt))
        raise last_exc if last_exc is not None else IOError(f'chunk {idx} failed')

    missing = [i for i in range(n_chunks) if i not in done]
    if not missing:
        try:
            progress_path.unlink()
        except FileNotFoundError:
            pass
        print(_dim(f'  resumable: all {n_chunks} chunks already on disk — skipping download'))
        return

    print(_dim(
        f'  resumable download: {size / 1024**3:.1f} GB in {n_chunks} chunks '
        f'of {RESUMABLE_CHUNK / 1024**2:.0f} MB '
        f'({len(done)} already done, {len(missing)} to fetch, '
        f'{RESUMABLE_WORKERS} workers)'
    ))

    n_completed = len(done)
    last_report = n_completed
    with ThreadPoolExecutor(max_workers=RESUMABLE_WORKERS) as ex:
        futures = {ex.submit(_fetch, i): i for i in missing}
        try:
            for fut in as_completed(futures):
                idx = fut.result()
                done.add(idx)
                n_completed += 1
                # Persist progress every chunk (cheap — small JSON write).
                progress_path.write_text(json.dumps({
                    'key':  key,
                    'size': size,
                    'done': sorted(done),
                }))
                if n_completed - last_report >= 10 or n_completed == n_chunks:
                    pct = 100 * n_completed / n_chunks
                    print(_dim(
                        f'  progress: {n_completed}/{n_chunks} chunks ({pct:.1f}%)'
                    ))
                    last_report = n_completed
        except BaseException:
            # Any thread failed (or user hit Ctrl-C). Cancel remaining
            # work, persist the current state, and re-raise so the caller
            # sees the failure. `.progress` stays on disk → next run
            # resumes from here.
            for f in futures:
                f.cancel()
            progress_path.write_text(json.dumps({
                'key':  key,
                'size': size,
                'done': sorted(done),
            }))
            raise

    if len(done) != n_chunks:
        raise IOError(
            f'resumable download incomplete: {len(done)}/{n_chunks} chunks done'
        )
    try:
        progress_path.unlink()
    except FileNotFoundError:
        pass


def _sha256_file(path: Path) -> str:
    sha = hashlib.sha256()
    with open(path, 'rb') as handle:
        for chunk in iter(lambda: handle.read(2 ** 20), b''):
            sha.update(chunk)
    return sha.hexdigest()


def _parse_sidecar_keys(text: str) -> Dict[str, str]:
    """Tiny key=value extractor — only needed for sha256 lookup pre-merge."""
    out: Dict[str, str] = {}
    for line in text.splitlines():
        stripped = line.strip()
        if not stripped or stripped.startswith('#') or '=' not in line:
            continue
        key, _, val = line.partition('=')
        out[key.strip()] = val.strip()
    return out


