def _print_run_report(results: List[DatasetResult], malformed: List[str]) -> None:
    print()
    print('═' * 66)
    print('RUN REPORT')
    print('═' * 66)
    if not results and not malformed:
        print('  (no datasets found in __incoming/)')
        return
    name_width = max((len(r.plan.display_name) for r in results), default=10)
    for result in results:
        glyph = _STATUS_GLYPH.get(result.status, result.status)
        print(f'  {glyph:<20}  {result.plan.display_name:<{name_width}}  {result.detail}')
        for conflict in result.sidecar_conflicts:
            print(f'    {_COL_WARN}sidecar conflict{_COL_RESET}: {conflict.key}  '
                  f'local={conflict.local_value!r}  incoming={conflict.incoming_value!r}')
        for path in result.static_conflicts:
            print(f'    {_COL_WARN}static conflict{_COL_RESET}: {path}')
    for line in malformed:
        print(f'  {_COL_WARN}MALFORMED{_COL_RESET}    {line}')


def _print_de_run_report(de_results: List[DEResult]) -> None:
    if not de_results:
        return
    print()
    print('═' * 66)
    print('DE RUN REPORT')
    print('═' * 66)
    name_width = max((len(r.plan.display_name) for r in de_results), default=10)
    for result in de_results:
        glyph = _STATUS_GLYPH.get(result.status, result.status)
        print(f'  {glyph:<20}  {result.plan.display_name:<{name_width}}  {result.detail}')


def _print_prune_hints(data_folder: Path, results: List[DatasetResult],
                       client, bucket: str, args: argparse.Namespace,
                       de_results: Optional[List[DEResult]] = None) -> None:
    print()
    print('═' * 66)
    print('PENDING CLEANUP')
    print('═' * 66)

    successes = [r for r in results if r.status == 'ok']
    de_successes = [r for r in (de_results or []) if r.status == 'ok']
    if not successes and not de_successes and args.dry_run:
        # nothing to summarise
        return

    if successes or de_successes:
        n_staging = (
            sum(len(r.staging_files) for r in successes)
            + sum(len(r.staging_files) for r in de_successes)
        )
        n_incoming = (
            sum(len(r.s3_incoming_keys) for r in successes)
            + sum(len(r.s3_incoming_keys) for r in de_successes)
        )
        print(f'  Local work files:   {n_staging} path(s) under {_work_root()}/')
        print(f'  S3 __incoming/ :    {n_incoming} key(s) under s3://{bucket}/{INCOMING_PREFIX}')

    # Catalog orphans — cheap to scan, useful even if no datasets ingested.
    if not args.skip_orphan_scan:
        try:
            orphans = _catalog_orphans(client, bucket, data_folder)
        except ClientError as exc:
            orphans = []
            _warn(f'(orphan scan failed: {exc})')
        if orphans:
            shown = orphans[:5]
            extra = max(0, len(orphans) - len(shown))
            print(f'  S3 catalog orphans: {len(orphans)} key(s) on S3 with no local file')
            for key in shown:
                print(f'    - {key}')
            if extra:
                print(f'    … and {extra} more')

    print()
    print('  To clean:')
    print(f'    ant-ingest prune --dry-run     # preview')
    print(f'    ant-ingest prune               # remove staging + __incoming/')
    print(f'    ant-ingest prune --include-catalog-orphans')
    print(f'                                   # also remove S3 catalog orphans')


