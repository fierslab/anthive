def _ledger_path(data_folder: Path) -> Path:
    return data_folder / STAGING_DIR_REL / PENDING_PRUNE_FILE


def _load_ledger(data_folder: Path) -> Dict:
    ledger_file = _ledger_path(data_folder)
    if not ledger_file.exists():
        return {'datasets': []}
    return json.loads(ledger_file.read_text())


def _save_ledger(data_folder: Path, ledger: Dict) -> None:
    ledger_file = _ledger_path(data_folder)
    ledger_file.parent.mkdir(parents=True, exist_ok=True)
    ledger_file.write_text(json.dumps(ledger, indent=2, default=str))


def _append_to_ledger(data_folder: Path, results: List[DatasetResult]) -> None:
    ledger = _load_ledger(data_folder)
    for result in results:
        if result.status != 'ok':
            continue
        ledger['datasets'].append({
            'display_name': result.plan.display_name,
            'data_project': result.plan.data_project,
            'subfolder': result.plan.subfolder,
            'basename': result.plan.basename,
            'staging_files': result.staging_files,
            's3_incoming_keys': result.s3_incoming_keys,
            'recorded_at': datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ'),
        })
    _save_ledger(data_folder, ledger)


def _append_de_to_ledger(data_folder: Path, results: List[DEResult]) -> None:
    """Add successful DE deposits to the pending-prune ledger.

    Stored alongside h5ad deposits under the 'datasets' key — `prune`
    consumes both kinds identically (delete from S3, remove staging
    files). Source-of-truth distinction is whether the entry has
    'local_parent' (DE) or 'subfolder' (h5ad).
    """
    ledger = _load_ledger(data_folder)
    for result in results:
        if result.status != 'ok':
            continue
        ledger['datasets'].append({
            'display_name':     result.plan.display_name,
            'data_project':     result.plan.data_project,
            'local_parent':     result.plan.local_parent,
            'basename':         result.plan.basename,
            'kind':             'de',
            'staging_files':    result.staging_files,
            's3_incoming_keys': result.s3_incoming_keys,
            'recorded_at':      datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ'),
        })
    _save_ledger(data_folder, ledger)


