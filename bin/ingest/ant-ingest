def _run(label: str, cmd: List[str]) -> Tuple[bool, str]:
    """Run a subprocess; return (ok, tail_of_output)."""
    print(_dim(f'  $ {" ".join(cmd)}'))
    try:
        result = subprocess.run(
            cmd, capture_output=True, text=True, check=False,
        )
    except FileNotFoundError as exc:
        return False, f'{label}: executable not found ({exc})'
    if result.returncode != 0:
        tail = (result.stderr or result.stdout or '').strip().splitlines()
        tail_text = '\n'.join(tail[-15:])
        return False, f'{label} failed (exit {result.returncode}):\n{tail_text}'
    return True, (result.stdout or '').strip()


