#!/usr/bin/env -S uv run --quiet --script
# /// script
# dependencies = ["cellxgene-census", "requests", "pyyaml"]
# ///

"""
ant-cellxgene — import datasets from CellxGene Discover into the h5adstore.

Accepted identifiers (pass any of these as <id>):
  Full URL:    https://cellxgene.cziscience.com/datasets/<dataset_id>
  Full URL:    https://cellxgene.cziscience.com/collections/<collection_id>
  Bare UUID:   0bd1a1de-3aee-40e0-b2ec-86c7a30c7149

Usage:
  ant-cellxgene import <id>   [--output-dir PATH] [--no-convert] [--force]
  ant-cellxgene info   <id>
  ant-cellxgene search [--organism STR] [--tissue STR] [--disease STR] [--assay STR]
"""

import argparse
import re
import subprocess
import sys
from pathlib import Path

import requests
import yaml

# ── constants ──────────────────────────────────────────────────────────────────

CXG_PORTAL = "https://cellxgene.cziscience.com"
CXG_API    = "https://api.cellxgene.cziscience.com/curation/v1"

ORGANISM_MAP: dict[str, str] = {
    "Homo sapiens":       "human",
    "Mus musculus":       "mouse",
    "Pan troglodytes":    "chimpanzee",
    "Macaca mulatta":     "macaque",
    "Callithrix jacchus": "marmoset",
}

ASSAY_MAP: dict[str, str] = {
    "10x 3' v1":                           "10x_scrna",
    "10x 3' v2":                           "10x_scrna",
    "10x 3' v3":                           "10x_scrna",
    "10x 3' v4":                           "10x_scrna",
    "10x 5' v1":                           "10x_scrna",
    "10x 5' v2":                           "10x_scrna",
    "10x 5' v3":                           "10x_scrna",
    "10x multiome":                        "10x_multiome",
    "10x multiome ATAC + Gene Expression": "10x_multiome",
    "Smart-seq2":                          "smartseq2",
    "Smart-seq v4":                        "smartseq2",
    "Drop-seq":                            "dropseq",
    "inDrop":                              "indrop",
    "sci-RNA-seq":                         "sci_rna",
    "sci-RNA-seq3":                        "sci_rna",
    "Slide-seq":                           "slideseq",
    "Slide-seq2":                          "slideseq",
    "Slide-tag":                           "slide-tag",
    "MERFISH":                             "merfish",
    "seqFISH":                             "seqfish",
    "seqFISH+":                            "seqfish",
    "Visium Spatial Gene Expression":      "visium",
    "Visium HD":                           "visium_hd",
    "CEL-seq2":                            "celseq2",
    "BD Rhapsody Targeted mRNA":           "bd_rhapsody",
    "microwell-seq":                       "microwell_seq",
    "ATAC-seq":                            "atac",
    "snmC-seq2":                           "snmc_seq",
    "MARS-seq":                            "mars_seq",
    "DNB-seq":                             "dnb_seq",
}

# obs columns generated by CellxGene schema that are redundant (ontology IDs
# instead of labels, or internal bookkeeping columns).
_CXG_OBS_EXCLUDE: set[str] = {
    "observation_joinid",
    "tissue_type",   # redundant with tissue
}

UUID_RE = re.compile(
    r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}",
    re.IGNORECASE,
)

_UNSAFE_RE = re.compile(r"[^\w\s\-]")
_SPACE_RE  = re.compile(r"[\s_]+")

# ── URL / UUID parsing ─────────────────────────────────────────────────────────

def parse_identifier(raw: str) -> tuple[str, str]:
    """
    Parse a raw identifier string into (kind, uuid).
    kind is 'dataset' or 'collection'.
    """
    raw = raw.strip().rstrip('/')

    if '/datasets/' in raw:
        kind: str = 'dataset'
    elif '/collections/' in raw:
        kind = 'collection'
    else:
        kind = 'unknown'

    match = UUID_RE.search(raw)
    if not match:
        raise ValueError(f"Cannot extract a UUID from: {raw!r}")

    uuid = match.group(0).lower()

    if kind == 'unknown':
        kind = _detect_kind(uuid)

    return kind, uuid


def _detect_kind(uuid: str) -> str:
    resp = requests.get(f"{CXG_API}/datasets/{uuid}", timeout=15)
    if resp.status_code == 200:
        return 'dataset'
    resp = requests.get(f"{CXG_API}/collections/{uuid}", timeout=15)
    if resp.status_code == 200:
        return 'collection'
    raise ValueError(f"UUID {uuid!r} not found as dataset or collection in CellxGene.")

# ── REST API ───────────────────────────────────────────────────────────────────

def _get(url: str) -> dict | list:
    resp = requests.get(url, timeout=30)
    resp.raise_for_status()
    return resp.json()


def fetch_dataset(dataset_id: str) -> dict:
    return _get(f"{CXG_API}/datasets/{dataset_id}")  # type: ignore[return-value]


def fetch_collection(collection_id: str) -> dict:
    return _get(f"{CXG_API}/collections/{collection_id}")  # type: ignore[return-value]


def fetch_all_datasets() -> list[dict]:
    return _get(f"{CXG_API}/datasets")  # type: ignore[return-value]

# ── metadata helpers ───────────────────────────────────────────────────────────

def _labels(field: list[dict]) -> list[str]:
    return [item["label"] for item in (field or [])]


def _single_or_list(values: list[str]) -> str | list[str]:
    if not values:
        return ""
    return values[0] if len(values) == 1 else values


def _normalize_organism(organisms: list[str]) -> str | list[str]:
    normalized = [ORGANISM_MAP.get(o, o.lower()) for o in organisms]
    return _single_or_list(normalized)


def _normalize_technology(assays: list[str]) -> list[str]:
    seen:   list[str] = []
    for assay in assays:
        mapped = ASSAY_MAP.get(assay) or assay.lower().replace(' ', '_').replace("'", '')
        if mapped not in seen:
            seen.append(mapped)
    return seen


def _format_authors(publisher_meta: dict) -> list[str]:
    result = []
    for author in publisher_meta.get("authors", []):
        family = author.get("family", "")
        given  = author.get("given", "")
        if family and given:
            result.append(f"{family} {given[0]}")
        elif family:
            result.append(family)
    return result


def _generate_group_id(collection_meta: dict) -> str:
    name  = collection_meta.get("name", "CXG")
    words = re.findall(r'\b[A-Za-z]\w*', name)
    prefix = ''.join(w[0].upper() for w in words)[:4]
    pub_meta = collection_meta.get("publisher_metadata") or {}
    year = pub_meta.get("published_year")
    suffix = str(year)[-2:] if year else "XX"
    return f"{prefix}{suffix}"


def sanitize(s: str, max_len: int = 60) -> str:
    s = _UNSAFE_RE.sub('', s)
    s = _SPACE_RE.sub('_', s.strip())
    return s[:max_len]


def build_annotation(dataset_meta: dict, collection_meta: dict) -> dict:
    """Map CellxGene API metadata to anthive annotation fields."""
    organisms  = _labels(dataset_meta.get("organism", []))
    tissues    = _labels(dataset_meta.get("tissue", []))
    cell_types = _labels(dataset_meta.get("cell_type", []))
    diseases   = _labels(dataset_meta.get("disease", []))
    assays     = _labels(dataset_meta.get("assay", []))
    sexes      = _labels(dataset_meta.get("sex", []))
    dev_stages = _labels(dataset_meta.get("development_stage", []))

    organism   = _normalize_organism(organisms) or None
    tissue     = _single_or_list(tissues)    or None
    celltype   = _single_or_list(cell_types) or None
    technology = _normalize_technology(assays) or None
    sex_val    = _single_or_list([s for s in sexes if s.lower() != 'unknown']) or None

    disease_vals = [d for d in diseases if d.lower() not in ('normal', 'healthy')]
    disease      = _single_or_list(disease_vals) or None

    # Condition: development stage if more than just 'adult' / 'unknown'
    interesting_stages = [d for d in dev_stages
                          if d.lower() not in ('unknown', 'adult', 'human adult stage')]
    condition = "; ".join(interesting_stages) or None

    dois  = [collection_meta["doi"]] if collection_meta.get("doi") else []
    links = [f"{CXG_PORTAL}/datasets/{dataset_meta['dataset_id']}"]
    for link_entry in collection_meta.get("links", []):
        url = link_entry.get("link_url", "")
        if url and url not in links:
            links.append(url)

    return {k: v for k, v in {
        "organism":   organism,
        "tissue":     tissue,
        "celltype":   celltype,
        "disease":    disease,
        "condition":  condition,
        "sex":        sex_val,
        "technology": technology,
        "doi":        dois or None,
        "link":       links,
    }.items() if v is not None}

# ── .md file I/O ───────────────────────────────────────────────────────────────

def _read_md(path: Path) -> tuple[dict, str]:
    text = path.read_text()
    if not text.startswith('---'):
        return {}, text
    parts = text.split('---', 2)
    if len(parts) < 3:
        return {}, text
    return yaml.safe_load(parts[1]) or {}, parts[2].lstrip('\n')


def _write_md(path: Path, frontmatter: dict, body: str) -> None:
    path.write_text(
        f"---\n{yaml.dump(frontmatter, allow_unicode=True, sort_keys=False)}---\n\n{body}"
    )

# ── index.md ───────────────────────────────────────────────────────────────────

def ensure_index_md(
    folder: Path,
    dataset_meta: dict,
    collection_meta: dict,
) -> None:
    """Create or lightly update the group index.md (collection-level metadata)."""
    index_path   = folder / "index.md"
    pub_meta     = collection_meta.get("publisher_metadata") or {}
    year         = pub_meta.get("published_year")
    authors      = _format_authors(pub_meta)
    group_id     = _generate_group_id(collection_meta)
    col_name     = collection_meta.get("name", folder.name)
    col_desc     = (collection_meta.get("description") or "").strip()
    doi          = collection_meta.get("doi", "")
    journal      = pub_meta.get("journal", "")

    if index_path.exists():
        fm, body = _read_md(index_path)
        if 'group_id' not in fm:
            fm['group_id'] = group_id
        _write_md(index_path, fm, body)
        print(f"  index.md: updated {index_path}")
        return

    # Build fresh index.md
    fm: dict = {
        'group':                  folder.name,
        'experiment':             'na',
        'authors':                authors,
        'year':                   year or 2025,
        'group_id':               group_id,
        'cellxgene_collection_id': collection_meta.get('collection_id', ''),
    }
    if doi:
        fm['annotation'] = {'doi': [doi]}

    body_lines = [f"# {col_name}", ""]
    if col_desc:
        body_lines += [col_desc, ""]
    if journal:
        pub_str = f"Published in {journal}"
        if year:
            pub_str += f" ({year})"
        if doi:
            pub_str += f". DOI: {doi}"
        body_lines.append(pub_str + ".")

    _write_md(index_path, fm, "\n".join(body_lines) + "\n")
    print(f"  index.md: created {index_path}")

# ── patch data .md ─────────────────────────────────────────────────────────────

def patch_md(
    md_path: Path,
    dataset_meta: dict,
    collection_meta: dict,
) -> None:
    """
    Enrich the .md written by ant-h5ad-check with:
    - Full anthive annotation (organism, tissue, celltype, disease, …)
    - CellxGene provenance (dataset_id, collection_id, schema_version, …)
    - Move ontology term ID columns and bookkeeping columns to obs_exclude
    - Set default_layer based on x_approximate_distribution
    - Rich markdown body with all available metadata
    """
    fm, _ = _read_md(md_path)

    # ── annotation ────────────────────────────────────────────────────────────
    annotation = build_annotation(dataset_meta, collection_meta)
    fm.setdefault('annotation', {})
    fm['annotation'].update(annotation)

    # ── default_layer ─────────────────────────────────────────────────────────
    x_dist = dataset_meta.get('x_approximate_distribution', '')
    if x_dist == 'normal' and 'default_layer' not in fm:
        fm['default_layer'] = 'X'   # log-normalized: good for visualization

    # ── CellxGene provenance ──────────────────────────────────────────────────
    fm['cellxgene_dataset_id']       = dataset_meta.get('dataset_id', '')
    fm['cellxgene_collection_id']    = collection_meta.get('collection_id', '')
    fm['cellxgene_schema_version']   = dataset_meta.get('schema_version', '')
    fm['x_approximate_distribution'] = x_dist
    fm['is_primary_data']            = dataset_meta.get('is_primary_data', '')
    fm['mean_genes_per_cell']        = dataset_meta.get('mean_genes_per_cell', '')

    # ── obs column cleanup: move CellxGene housekeeping cols to obs_exclude ───
    obs_cat     = list(fm.get('obscat_include', []))
    obs_num     = list(fm.get('obsnum_include', []))
    obs_exclude = set(fm.get('obs_exclude', []))

    def _should_exclude(col: str) -> bool:
        return (col in _CXG_OBS_EXCLUDE
                or col.endswith('_ontology_term_id'))

    obs_cat     = [c for c in obs_cat if not _should_exclude(c) or obs_exclude.add(c)]  # type: ignore[func-returns-value]
    obs_num     = [c for c in obs_num if not _should_exclude(c) or obs_exclude.add(c)]  # type: ignore[func-returns-value]

    fm['obscat_include'] = obs_cat
    fm['obsnum_include'] = obs_num
    fm['obs_exclude']    = sorted(obs_exclude)

    # ── rich markdown body ────────────────────────────────────────────────────
    title      = dataset_meta.get('title', md_path.stem)
    desc       = (dataset_meta.get('description') or '').strip()
    col_name   = collection_meta.get('name', '')
    doi        = collection_meta.get('doi', '')
    schema_ver = dataset_meta.get('schema_version', '')
    cell_count = dataset_meta.get('cell_count', '')
    mean_genes = dataset_meta.get('mean_genes_per_cell', '')
    is_primary = dataset_meta.get('is_primary_data', '')
    dataset_id = dataset_meta.get('dataset_id', '')
    dataset_url= f"{CXG_PORTAL}/datasets/{dataset_id}"
    pub_meta   = collection_meta.get("publisher_metadata") or {}
    journal    = pub_meta.get("journal", "")
    pub_year   = pub_meta.get("published_year", "")

    def _fmt(items: list[str]) -> str:
        return "; ".join(items) if items else "—"

    def _fmt_cells(n: object) -> str:
        return f"{n:,}" if isinstance(n, int) else str(n)

    organisms  = _labels(dataset_meta.get("organism", []))
    tissues    = _labels(dataset_meta.get("tissue", []))
    cell_types = _labels(dataset_meta.get("cell_type", []))
    diseases   = _labels(dataset_meta.get("disease", []))
    assays     = _labels(dataset_meta.get("assay", []))
    sexes      = _labels(dataset_meta.get("sex", []))
    dev_stages = _labels(dataset_meta.get("development_stage", []))
    ethnicities= _labels(dataset_meta.get("self_reported_ethnicity", []))

    lines = [f"# {title}", ""]
    if desc:
        lines += [desc, ""]
    lines += [
        f"**Collection:** {col_name}",
    ]
    if journal:
        pub_line = f"**Published:** {journal} ({pub_year})"
        if doi:
            pub_line += f". DOI: {doi}"
        lines.append(pub_line)
    lines += [
        f"**Dataset:** `{dataset_id}`  ([CellxGene]({dataset_url}))",
        "",
        f"**Cells:** {_fmt_cells(cell_count)}  |  "
        f"**Mean genes/cell:** {mean_genes}  |  "
        f"**Schema:** {schema_ver}  |  "
        f"**X:** {x_dist}  |  "
        f"**Primary data:** {is_primary}",
        "",
        f"**Organisms:** {_fmt(organisms)}",
        f"**Tissues:** {_fmt(tissues)}",
        f"**Cell types:** {_fmt(cell_types)}",
        f"**Diseases:** {_fmt(diseases)}",
        f"**Assays:** {_fmt(assays)}",
        f"**Sex:** {_fmt(sexes)}",
        f"**Development stages:** {_fmt(dev_stages)}",
    ]
    if ethnicities and ethnicities != ["unknown"]:
        lines.append(f"**Ethnicities:** {_fmt(ethnicities)}")

    _write_md(md_path, fm, "\n".join(lines) + "\n")
    print(f"  .md patched: {md_path.name}")

# ── file paths ─────────────────────────────────────────────────────────────────

def choose_paths(
    dataset_meta: dict,
    collection_meta: dict,
    data_folder: Path,
    output_dir: str | None,
) -> tuple[Path, Path]:
    """Return (h5ad_path, group_folder)."""
    if output_dir:
        folder = Path(output_dir).resolve()
    else:
        col_name = sanitize(collection_meta.get("name", "CellxGene"))
        folder   = data_folder / col_name

    stem     = sanitize(dataset_meta.get("title", dataset_meta["dataset_id"]))
    h5ad_path = folder / f"{stem}.h5ad"
    return h5ad_path, folder

# ── subprocess helpers ────────────────────────────────────────────────────────

def _run(cmd: list[str]) -> int:
    print(f"  $ {' '.join(str(c) for c in cmd)}")
    return subprocess.run(cmd).returncode

# ── commands ──────────────────────────────────────────────────────────────────

def cmd_import(args: argparse.Namespace, bin_dir: Path, data_folder: Path) -> None:
    import cellxgene_census

    kind, uuid = parse_identifier(args.identifier)

    if kind == 'collection':
        # Show datasets and exit
        print(f"Collection given — listing datasets. Re-run with a dataset ID/URL to import.\n")
        cmd_info(args)
        sys.exit(0)

    print(f"Fetching metadata for dataset {uuid}…")
    dataset_meta    = fetch_dataset(uuid)
    collection_id   = dataset_meta.get('collection_id', '')
    collection_meta = fetch_collection(collection_id) if collection_id else {}

    cell_count = dataset_meta.get('cell_count', 0) or 0
    if cell_count > 200_000:
        print(f"  WARNING: {cell_count:,} cells — conversion may take 30–90+ minutes.")

    h5ad_path, folder = choose_paths(dataset_meta, collection_meta, data_folder, args.output_dir)
    folder.mkdir(parents=True, exist_ok=True)

    # Download
    if h5ad_path.exists() and not args.force:
        print(f"  {h5ad_path.name} already exists — skipping download (use --force to re-download).")
    else:
        print(f"\nDownloading → {h5ad_path}")
        cellxgene_census.download_source_h5ad(uuid, to_path=str(h5ad_path))
        size_gb = h5ad_path.stat().st_size / 1024 ** 3
        print(f"  Downloaded: {size_gb:.2f} GB")

    # Group index.md
    ensure_index_md(folder, dataset_meta, collection_meta)

    # h5ad-check → structural .md
    print("\nRunning h5ad-check…")
    rc = _run([str(bin_dir / 'ant-h5ad-check'), str(h5ad_path)])
    if rc != 0:
        print("h5ad-check failed — aborting.", file=sys.stderr)
        sys.exit(rc)

    # Patch .md with CellxGene metadata
    md_path = h5ad_path.with_suffix('.md')
    print("\nEnriching .md with CellxGene metadata…")
    patch_md(md_path, dataset_meta, collection_meta)

    # Convert
    if not args.no_convert:
        print("\nRunning convert…")
        rc = _run([str(bin_dir / 'ant-convert'), str(h5ad_path)])
        if rc != 0:
            print("convert failed.", file=sys.stderr)
            sys.exit(rc)

    print(f"\nDone.  {h5ad_path}")


def cmd_info(args: argparse.Namespace) -> None:
    kind, uuid = parse_identifier(args.identifier)

    if kind == 'collection':
        meta = fetch_collection(uuid)
        print(f"\nCollection: {meta.get('name', uuid)}")
        print(f"  ID:          {uuid}")
        print(f"  DOI:         {meta.get('doi', '—')}")
        print(f"  Description: {(meta.get('description') or '')[:200]}")
        pub = meta.get("publisher_metadata") or {}
        if pub:
            print(f"  Journal:     {pub.get('journal', '—')} ({pub.get('published_year', '—')})")
            authors = _format_authors(pub)
            if authors:
                print(f"  Authors:     {', '.join(authors[:5])}" + (" …" if len(authors) > 5 else ""))
        print(f"\n  Datasets ({len(meta.get('datasets', []))}):")
        for ds in sorted(meta.get('datasets', []), key=lambda d: d.get('cell_count') or 0, reverse=True):
            cells = ds.get('cell_count', 0) or 0
            print(f"    {ds['dataset_id']}  {cells:>9,} cells  {(ds.get('title') or '')[:55]}")
        return

    meta            = fetch_dataset(uuid)
    collection_id   = meta.get('collection_id', '')
    collection_meta = fetch_collection(collection_id) if collection_id else {}
    pub_meta        = collection_meta.get("publisher_metadata") or {}

    def fmt(field: str) -> str:
        return "; ".join(_labels(meta.get(field, []))) or "—"

    cells = meta.get('cell_count', '—')
    print(f"\nDataset:  {meta.get('title', uuid)}")
    print(f"  ID:                {uuid}")
    print(f"  Collection:        {collection_meta.get('name', collection_id)}")
    print(f"  DOI:               {collection_meta.get('doi', '—')}")
    if pub_meta:
        print(f"  Journal:           {pub_meta.get('journal', '—')} ({pub_meta.get('published_year', '—')})")
        authors = _format_authors(pub_meta)
        if authors:
            print(f"  Authors:           {', '.join(authors[:6])}" + (" …" if len(authors) > 6 else ""))
    print(f"  Cells:             {cells:,}" if isinstance(cells, int) else f"  Cells:             {cells}")
    print(f"  Mean genes/cell:   {meta.get('mean_genes_per_cell', '—')}")
    print(f"  Schema version:    {meta.get('schema_version', '—')}")
    print(f"  X distribution:    {meta.get('x_approximate_distribution', '—')}")
    print(f"  Primary data:      {meta.get('is_primary_data', '—')}")
    print(f"  Organism:          {fmt('organism')}")
    print(f"  Tissue:            {fmt('tissue')}")
    print(f"  Cell types:        {fmt('cell_type')}")
    print(f"  Disease:           {fmt('disease')}")
    print(f"  Assay:             {fmt('assay')}")
    print(f"  Sex:               {fmt('sex')}")
    print(f"  Development stage: {fmt('development_stage')}")
    print(f"  Ethnicity:         {fmt('self_reported_ethnicity')}")
    print(f"  URL:               {CXG_PORTAL}/datasets/{uuid}")


def cmd_search(args: argparse.Namespace) -> None:
    print("Fetching dataset list from CellxGene…")
    datasets = fetch_all_datasets()

    filters = {
        'organism': args.organism,
        'tissue':   args.tissue,
        'disease':  args.disease,
        'assay':    args.assay,
    }

    results = []
    for ds in datasets:
        match = True
        for field, query in filters.items():
            if not query:
                continue
            labels = [lbl.lower() for lbl in _labels(ds.get(field, []))]
            if not any(query.lower() in lbl for lbl in labels):
                match = False
                break
        if match:
            results.append(ds)

    if not results:
        print("No datasets matched the filters.")
        return

    print(f"\n{'CELLS':>9}  {'DATASET_ID':36}  TITLE")
    print("─" * 105)
    for ds in sorted(results, key=lambda d: d.get('cell_count') or 0, reverse=True):
        cells = ds.get('cell_count') or 0
        did   = ds.get('dataset_id', '')
        title = (ds.get('title') or '')[:56]
        print(f"  {cells:>8,}  {did}  {title}")

    print(f"\n{len(results)} dataset(s).")

# ── main ──────────────────────────────────────────────────────────────────────

def main() -> None:
    bin_dir     = Path(__file__).parent.resolve()
    data_folder = (bin_dir.parent / 'data' / 'h5adstore').resolve()

    parser = argparse.ArgumentParser(
        prog='ant-cellxgene',
        description='Import datasets from CellxGene Discover.',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__,
    )
    parser.add_argument(
        '--data-folder', default=str(data_folder),
        help=f'Root of the h5adstore (default: {data_folder})',
    )

    subparsers = parser.add_subparsers(dest='command', required=True)

    # import
    import_p = subparsers.add_parser('import', help='Download + check + convert a dataset')
    import_p.add_argument('identifier', help='Dataset URL or UUID')
    import_p.add_argument('--output-dir', default=None,
                          help='Override group folder (default: h5adstore/<collection_name>/)')
    import_p.add_argument('--no-convert', action='store_true',
                          help='Skip DuckDB conversion')
    import_p.add_argument('--force', action='store_true',
                          help='Re-download even if .h5ad already exists')

    # info
    info_p = subparsers.add_parser('info', help='Show metadata without downloading')
    info_p.add_argument('identifier', help='Dataset or collection URL/UUID')

    # search
    search_p = subparsers.add_parser('search', help='Search available datasets')
    search_p.add_argument('--organism', default=None, metavar='STR')
    search_p.add_argument('--tissue',   default=None, metavar='STR')
    search_p.add_argument('--disease',  default=None, metavar='STR')
    search_p.add_argument('--assay',    default=None, metavar='STR')

    args        = parser.parse_args()
    data_folder = Path(args.data_folder).resolve()

    if args.command == 'import':
        cmd_import(args, bin_dir, data_folder)
    elif args.command == 'info':
        cmd_info(args)
    elif args.command == 'search':
        cmd_search(args)


if __name__ == '__main__':
    main()
