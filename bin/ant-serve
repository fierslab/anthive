# ── analytics endpoints ────────────────────────────────────────────────────────


def _json_safe(obj: Any) -> Any:
    """Recursively replace NaN/Inf floats with None so json.dumps never chokes."""
    if isinstance(obj, float) and not math.isfinite(obj):
        return None
    if isinstance(obj, dict):
        return {k: _json_safe(v) for k, v in obj.items()}
    if isinstance(obj, list):
        return [_json_safe(v) for v in obj]
    return obj


class AnalyticsQueryRequest(BaseModel):
    sql: str
    session_id: Optional[str] = None
    timeout: Optional[int] = None  # seconds; defaults to server ANTHIVE_QUERY_TIMEOUT (120)
    attach_sessions: Optional[List[str]] = None  # prior session IDs to attach as tables (e.g. module_score results)


class AnalyticsVizRequest(BaseModel):
    session_id: str
    code: str
    output_format: str = 'png'


@app.get("/databases/{db_id:path}/analytics/schema", tags=["analytics"])
async def analytics_schema(db_id: str):
    """Return the schema of all DuckDB tables in a dataset.

    Lists every table with its column names, types, row count, and a 3-row
    sample.  Use this to understand what fields are available before writing
    an analytics_query SQL statement.
    """
    try:
        db_url = registry.get_database_path(db_id)
    except KeyError:
        raise HTTPException(status_code=404, detail=f"Dataset '{db_id}' not found.")
    def _sync_schema():
        conn = connection_pool.get_connection(db_url)
        try:
            return analytics.get_schema(conn)
        finally:
            connection_pool.return_connection(db_url, conn)
    try:
        schema = await asyncio.to_thread(_sync_schema)
    except Exception as exc:
        raise HTTPException(status_code=500, detail=str(exc))
    return _json_safe({"db_id": db_id, "tables": schema})


@app.post("/databases/{db_id:path}/analytics/query", tags=["analytics"])
async def analytics_query(db_id: str, request: AnalyticsQueryRequest):
    """Execute a read-only SELECT query and persist results as a Parquet file.

    The full result set is saved server-side; only column metadata and a small
    preview (first 10 rows) are returned.  Use the returned session_id in a
    subsequent POST /analytics/viz call to visualise the data.

    To use results from a prior module_score call, pass its session_id in
    `attach_sessions`. The scores become available as a table called `scores`
    with columns (cell_name, module_score). Example:

        {"sql": "SELECT o.cell_type, AVG(s.module_score) FROM scores s JOIN obscat o USING (cell_name) GROUP BY 1",
         "attach_sessions": ["abc123..."]}

    Constraints:
    - Only SELECT / WITH … SELECT queries are accepted.
    - Result is capped at 500 000 rows (configurable via ANTHIVE_ANALYTICS_ROWS).
    - Query is killed after 120 s (configurable via ANTHIVE_QUERY_TIMEOUT).
    """
    try:
        db_url = registry.get_database_path(db_id)
    except KeyError:
        raise HTTPException(status_code=404, detail=f"Dataset '{db_id}' not found.")
    # analytics.run_query opens and closes its own dedicated connection so that
    # closing it on timeout actually cancels the in-flight DuckDB query.
    try:
        result = await asyncio.to_thread(
            lambda: analytics.run_query(
                db_url, request.sql, request.session_id,
                s3_config=registry._s3_config,
                timeout=request.timeout,
                attach_sessions=request.attach_sessions,
            )
        )
    except (ValueError, RuntimeError) as exc:
        raise HTTPException(status_code=400, detail=str(exc))
    except TimeoutError as exc:
        raise HTTPException(status_code=408, detail=str(exc))
    except Exception as exc:
        raise HTTPException(status_code=500, detail=str(exc))
    return _json_safe(result)


@app.post("/analytics/viz", tags=["analytics"])
async def analytics_viz(request: AnalyticsVizRequest):
    """Execute a Python visualisation script and return the figure as base64.

    The script runs in a subprocess with a blocked-import AST scan and a
    wall-clock timeout.  Two variables are pre-injected:

      DATA_PATH   — path to the Parquet file saved by a prior analytics_query
      OUTPUT_PATH — path where the script MUST save its figure, e.g.:
                        plt.savefig(OUTPUT_PATH, bbox_inches='tight', dpi=150)

    The script may use: pandas, matplotlib, seaborn, numpy, scipy, sklearn,
    statsmodels, and other data-science packages.  Imports of os, sys,
    subprocess, socket, requests, and similar modules are blocked.
    Scripts are killed after 60 s (configurable via ANTHIVE_VIZ_TIMEOUT).
    """
    try:
        figure_b64, output_format = await asyncio.to_thread(
            analytics.run_viz,
            request.session_id, request.code, request.output_format,
        )
    except FileNotFoundError as exc:
        raise HTTPException(status_code=404, detail=str(exc))
    except (ValueError, RuntimeError) as exc:
        raise HTTPException(status_code=400, detail=str(exc))
    except TimeoutError as exc:
        raise HTTPException(status_code=408, detail=str(exc))
    except Exception as exc:
        raise HTTPException(status_code=500, detail=str(exc))
    mime_types = {'png': 'image/png', 'svg': 'image/svg+xml', 'pdf': 'application/pdf'}
    return {
        "session_id":    request.session_id,
        "output_format": output_format,
        "mime_type":     mime_types.get(output_format, 'image/png'),
        "figure_b64":    figure_b64,
    }


@app.post("/databases/{db_id:path}/module_score", tags=["analytics"])
async def module_score(db_id: str, request: ModuleScoreRequest):
    """Compute per-cell module scores (Scanpy score_genes / Seurat AddModuleScore equivalent).

    For each cell: score = mean(module genes) − mean(expression-matched control genes).
    Control genes are sampled from the same expression bins as the module genes
    using the precomputed __gene_bins table.

    Returns summary statistics and a session_id. The full per-cell scores are saved
    as a Parquet file that can be visualized via POST /analytics/viz or queried
    via POST /analytics/query using the session_id.

    Requires __gene_bins (built by ant-duckdb-check on databases with a log-normalized layer).
    """
    filters = _parse_subset(request.subset)

    def _sync_score():
        with _pooled_db(db_id) as db:
            scores_df, meta = db.score_module(
                module_genes=request.genes,
                layer=request.layer,
                n_control=request.n_control,
                seed=request.seed,
            )

            # Apply subset filters if any
            if filters:
                cat_fields = db._get_categorical_fields()
                num_fields = db._get_numerical_fields()
                filter_df = db.get_cell_table(metadata_fields=list(filters.keys()), filters=filters)
                keep_cells = set(filter_df['cell_name'])
                scores_df = scores_df[scores_df['cell_name'].isin(keep_cells)]

            return scores_df, meta

    try:
        scores_df, meta = await asyncio.to_thread(_sync_score)
    except KeyError as exc:
        raise HTTPException(status_code=404, detail=str(exc))
    except ValueError as exc:
        raise HTTPException(status_code=400, detail=str(exc))
    except Exception as exc:
        raise HTTPException(status_code=500, detail=str(exc))

    # Save to Parquet for downstream analytics_viz / analytics_query
    import uuid as _uuid
    session_id = _uuid.uuid4().hex
    parquet_path = analytics._get_tmp_dir() / f"{session_id}.parquet"
    scores_df.to_parquet(parquet_path, index=False)

    # Summary statistics
    s = scores_df['module_score']
    summary = {
        'mean':   round(float(s.mean()), 6),
        'std':    round(float(s.std()), 6),
        'min':    round(float(s.min()), 6),
        'q25':    round(float(s.quantile(0.25)), 6),
        'median': round(float(s.median()), 6),
        'q75':    round(float(s.quantile(0.75)), 6),
        'max':    round(float(s.max()), 6),
    }

    return _json_safe({
        'db_id':           db_id,
        'session_id':      session_id,
        'genes_found':     meta['genes_found'],
        'genes_missing':   meta['genes_missing'],
        'n_cells':         len(scores_df),
        'n_control_genes': meta['n_control_genes'],
        'layer':           request.layer,
        'n_control':       request.n_control,
        'seed':            request.seed,
        'summary':         summary,
    })


@app.post("/admin/release/{db_id:path}", tags=["admin"])
async def release_database(
    db_id: str,
    duration_seconds: float = 300.0,
    drain_timeout_seconds: float = 30.0,
):
    """Evict a database from the connection pool so a writer can take the
    DuckDB r/w lock.

    Closes idle pooled connections, marks the db_key as evicted (refuses new
    connections), and waits up to `drain_timeout_seconds` for in-use
    connections to be returned. The eviction self-expires after
    `duration_seconds` (safety net so a crashed writer can't lock ant-serve
    out indefinitely).

    Returns:
      - ok: True if the db is fully released; False if in-use connections
        didn't drain in time (the writer should retry or fail)
      - closed_idle: number of pooled connections that were closed
      - still_in_use: 0 on success, else the count of stubbornly in-use conns
      - eviction_expires_in: seconds until the eviction auto-clears

    Used by AnnotationWriter / ant-merge-h5ad / ant-score / ant-starcat
    before they open the duckdb in r/w mode.
    """
    try:
        db_url = registry.get_database_path(db_id)
    except KeyError:
        raise HTTPException(status_code=404, detail=f"db_id {db_id!r} not found")
    result = connection_pool.release(
        db_url,
        duration_seconds=duration_seconds,
        drain_timeout_seconds=drain_timeout_seconds,
    )
    log.info("admin.release db_id=%s result=%s", db_id, result)
    return result


@app.post("/admin/restore/{db_id:path}", tags=["admin"])
async def restore_database(db_id: str):
    """Clear an eviction set by /admin/release/{db_id}. The connection pool
    will issue fresh r/o connections on the next request."""
    try:
        db_url = registry.get_database_path(db_id)
    except KeyError:
        raise HTTPException(status_code=404, detail=f"db_id {db_id!r} not found")
    result = connection_pool.restore(db_url)
    log.info("admin.restore db_id=%s result=%s", db_id, result)
    return result


@app.post("/admin/rescan", tags=["admin"])
async def rescan_databases():
    """
    Force rescan of data folder and reload all metadata

    Triggers a complete rescan of the data folder, clearing all caches
    and re-discovering databases and metadata.

    Useful after:
    - Adding new database files
    - Updating metadata files (.md, index.md)
    - Removing database files

    Returns:
    - status: 'success'
    - previous_count: Number of databases before rescan
    - current_count: Number of databases after rescan
    - added: List of added database IDs
    - removed: List of removed database IDs
    - databases: Complete list of current database IDs
    """
    try:
        result = registry.rescan()
        # rebuild module-score reverse index too
        if geneset_registry is not None:
            _build_score_index()
            result['scored_databases'] = len(_score_index_by_db)
        # Drop the plot-response cache — any cached image may now be stale.
        result['plot_cache_cleared'] = _plot_cache_clear()
        return result
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


@app.get("/admin/plot-cache/stats", tags=["admin"])
async def plot_cache_stats():
    """Return the plot response cache stats (hits / misses / evictions / size)."""
    with _plot_cache_lock:
        size = len(_plot_cache)
        total_bytes = sum(len(e.get('bytes', b'')) for e in _plot_cache.values())
    hits, misses = _plot_cache_stats['hits'], _plot_cache_stats['misses']
    total = hits + misses
    return {
        'size':         size,
        'max_size':     _PLOT_CACHE_MAX_ENTRIES,
        'memory_bytes': total_bytes,
        'hits':         hits,
        'misses':       misses,
        'evictions':    _plot_cache_stats['evictions'],
        'hit_rate':     (hits / total) if total else 0.0,
    }


@app.post("/admin/plot-cache/clear", tags=["admin"])
async def plot_cache_clear():
    """Drop all cached plot responses."""
    n = _plot_cache_clear()
    return {'cleared': n}


# ── Genesets ───────────────────────────────────────────────────────────────────

def _require_geneset_registry() -> GenesetRegistry:
    if geneset_registry is None:
        raise HTTPException(status_code=503, detail="Geneset store is not configured")
    return geneset_registry


def _build_score_index() -> None:
    """
    Walk every database in the registry, find columns matching
    <study>::<experiment>::<geneset> in obsnum, and build the bidirectional
    index. Cheap (one information_schema query per db).
    """
    global _score_index_by_db, _score_index_by_geneset, _score_columns
    new_by_db: Dict[str, List[str]] = {}
    new_by_geneset: Dict[str, List[str]] = {}
    new_columns: Dict[Tuple[str, str], str] = {}

    if registry is None:
        return

    for db_id in registry.databases.keys():
        try:
            db_url = registry.get_database_path(db_id)
            conn = connection_pool.get_connection(db_url)
        except Exception as exc:
            log.warning("score-index: skipping %s (open failed: %s)", db_id, exc)
            continue
        try:
            rows = conn.execute("""
                SELECT column_name FROM information_schema.columns
                WHERE table_name = 'obsnum'
            """).fetchall()
            for (col,) in rows:
                geneset_id = parse_score_column(col)
                if not geneset_id:
                    continue
                new_by_db.setdefault(db_id, []).append(geneset_id)
                new_by_geneset.setdefault(geneset_id, []).append(db_id)
                new_columns[(db_id, geneset_id)] = col
        except Exception as exc:
            log.warning("score-index: scan failed for %s: %s", db_id, exc)
        finally:
            try:
                connection_pool.return_connection(db_url, conn)
            except Exception:
                pass

    # Sort for deterministic output
    for ids in new_by_db.values():
        ids.sort()
    for ids in new_by_geneset.values():
        ids.sort()

    _score_index_by_db = new_by_db
    _score_index_by_geneset = new_by_geneset
    _score_columns = new_columns
    log.info(
        "score-index: %d database(s) with scored genesets, %d distinct geneset(s)",
        len(new_by_db), len(new_by_geneset),
    )


def _annotate_with_scored_in(summary: Dict[str, Any]) -> Dict[str, Any]:
    """Mutate a geneset summary dict to include scored_in (list of db_ids)."""
    summary['scored_in'] = list(_score_index_by_geneset.get(summary['geneset_id'], []))
    return summary


@app.get("/genesets", tags=["genesets"])
async def list_genesets(
    organism: Optional[str] = None,
    method: Optional[str] = None,
    study: Optional[str] = None,
):
    """List all genesets, optionally filtered by organism/method/study.

    Each entry includes `scored_in` — a list of `db_id`s where the geneset is
    already pre-computed as an obs column (no on-the-fly scoring required).
    """
    registry = _require_geneset_registry()
    items = registry.list_genesets(organism=organism, method=method, study=study)
    return {
        "count": len(items),
        "column_naming": {
            "separator": SCORE_COLUMN_SEPARATOR,
            "template":  SCORE_COLUMN_TEMPLATE,
            "example":   "Sierksma2025::WGCNA::Brown_Lysosome",
        },
        "genesets": [_annotate_with_scored_in(g.to_summary()) for g in items],
    }


@app.get("/genesets/{study}/{experiment}", tags=["genesets"])
async def get_geneset_experiment(study: str, experiment: str):
    """Return experiment metadata + the list of genesets it contains."""
    registry = _require_geneset_registry()
    experiment_id = f"{study}/{experiment}"
    exp = registry.get_experiment(experiment_id)
    if exp is None:
        raise HTTPException(status_code=404, detail=f"Experiment {experiment_id} not found")
    members = [g for g in registry.list_genesets(study=study) if g.experiment.name == experiment]
    return {
        "experiment_id": exp.experiment_id,
        "study": exp.study,
        "name": exp.name,
        "metadata": exp.metadata,
        "body": exp.body,
        "genesets": [_annotate_with_scored_in(g.to_summary()) for g in members],
    }


@app.get("/genesets/{study}/{experiment}/{name}", tags=["genesets"])
async def get_geneset(study: str, experiment: str, name: str):
    """Return one geneset (merged metadata + gene list).

    Includes `scored_in` (list of db_ids) and `column_name` (the obs column name
    used in pre-scored datasets).
    """
    registry = _require_geneset_registry()
    geneset_id = f"{study}/{experiment}/{name}"
    geneset = registry.get(geneset_id)
    if geneset is None:
        raise HTTPException(status_code=404, detail=f"Geneset {geneset_id} not found")
    detail = geneset.to_detail()
    detail['scored_in'] = list(_score_index_by_geneset.get(geneset_id, []))
    detail['column_name'] = SCORE_COLUMN_TEMPLATE.format(
        study=geneset.experiment.study,
        experiment=geneset.experiment.name,
        name=geneset.name,
    )
    return detail


@app.post("/genesets/rescan", tags=["genesets"])
async def rescan_genesets():
    """Re-scan the geneset store from disk and rebuild the score index."""
    geneset_reg = _require_geneset_registry()
    geneset_reg.scan()
    h5ad_db_ids = set(globals()['registry'].databases.keys()) if globals().get('registry') else None
    errors, warnings = validate_geneset_registry(geneset_reg, h5ad_db_ids=h5ad_db_ids)
    _build_score_index()
    return {
        "experiments": len(geneset_reg.experiments),
        "genesets": len(geneset_reg.genesets),
        "scored_databases": len(_score_index_by_db),
        "errors": errors,
        "warnings": warnings,
    }


@app.get("/databases/{db_id:path}/module_scores", tags=["databases"])
async def get_database_module_scores(db_id: str):
    """List all pre-computed module-score columns for one dataset.

    For each scored geneset, returns:
      - geneset_id        canonical geneset id (study/experiment/name)
      - column_name       obs/duckdb column where the score is stored
      - geneset_known     True if the geneset is in the registered genesetstore
      - method            (if known)
      - description       (if known)
      - n_genes           (if known)
      - stats             {min, max, mean, std, median}  computed from the column

    Use the resulting column names directly in analytics_query, e.g.:
        SELECT cell_name, "Sierksma2025::WGCNA::Brown_Lysosome"
        FROM   obsnum
    """
    if registry is None or db_id not in registry.databases:
        raise HTTPException(status_code=404, detail=f"Database not found: {db_id}")

    db_url = registry.get_database_path(db_id)
    conn = connection_pool.get_connection(db_url)
    try:
        cols = conn.execute("""
            SELECT column_name FROM information_schema.columns
            WHERE table_name = 'obsnum'
        """).fetchall()
        score_cols = [c[0] for c in cols if is_score_column(c[0])]

        out = []
        gset_reg = geneset_registry  # may be None if store not configured
        for col in sorted(score_cols):
            geneset_id = parse_score_column(col)
            row = {
                "geneset_id":   geneset_id,
                "column_name":  col,
                "geneset_known": False,
                "method":       None,
                "description":  None,
                "n_genes":      None,
                "stats":        None,
            }
            if gset_reg is not None:
                gs = gset_reg.get(geneset_id)
                if gs is not None:
                    row["geneset_known"] = True
                    row["method"]       = gs.experiment.method
                    row["description"]  = gs.metadata.get('description') or ''
                    row["n_genes"]      = gs.n_genes
            try:
                # safe_ident() validates against [A-Za-z0-9_:.\- ] and quotes
                # — defends against a crafted column name (`"); DROP …`) even
                # though the connection is read-only.
                qcol = safe_ident(col)
                stats_row = conn.execute(f"""
                    SELECT
                      COUNT(*) AS n,
                      MIN({qcol}) AS min,
                      MAX({qcol}) AS max,
                      AVG({qcol}) AS mean,
                      STDDEV({qcol}) AS std,
                      MEDIAN({qcol}) AS median
                    FROM __obsnum
                """).fetchone()
                if stats_row is not None:
                    n, mn, mx, mean, std, med = stats_row
                    row["stats"] = {
                        "n":      int(n) if n is not None else None,
                        "min":    float(mn)   if mn   is not None else None,
                        "max":    float(mx)   if mx   is not None else None,
                        "mean":   float(mean) if mean is not None else None,
                        "std":    float(std)  if std  is not None else None,
                        "median": float(med)  if med  is not None else None,
                    }
            except Exception as exc:
                row["stats"] = {"error": str(exc)}
            out.append(row)
    finally:
        connection_pool.return_connection(db_url, conn)

    return {
        "db_id": db_id,
        "count": len(out),
        "column_naming": {
            "separator": SCORE_COLUMN_SEPARATOR,
            "template":  SCORE_COLUMN_TEMPLATE,
        },
        "scored_genesets": out,
    }


@app.get("/skill", tags=["info"], response_class=Response)
async def get_skill():
    """Return the Anthive Claude Code skill file (SKILL.md).

    Collaborators can install it with:
        curl -n https://data.nevel.eu/api/skill -o ~/.claude/skills/anthive/SKILL.md
    """
    skill_path = script_dir.parent / ".claude" / "skills" / "anthive" / "SKILL.md"
    if not skill_path.exists():
        raise HTTPException(status_code=404, detail="SKILL.md not found")
    return Response(
        content=skill_path.read_text(),
        media_type="text/markdown",
        headers={"Content-Disposition": "inline; filename=SKILL.md"},
    )


def main():
    """Main entry point"""
    parser = argparse.ArgumentParser(
        description="Anthive REST API Server",
        formatter_class=argparse.RawDescriptionHelpFormatter
    )

    # Get config for defaults
    config = get_config()

    parser.add_argument(
        '--data-folder',
        type=Path,
        default=Path('./data'),
        help='Path to data folder containing .duckdb files (default: ./data)'
    )
    parser.add_argument(
        '--host',
        default=config.get('rest_api_host', '127.0.0.1'),
        help='Host to bind to (default: from config or 127.0.0.1)'
    )
    parser.add_argument(
        '--port',
        type=int,
        default=config.get('rest_api_port', 8000),
        help='Port to bind to (default: from config or 8000)'
    )
    parser.add_argument(
        '--reload',
        action='store_true',
        help='Enable auto-reload for development'
    )

    args = parser.parse_args()

    # Initialize global connection pool and registry (Phase 2)
    global registry, connection_pool, geneset_registry
    s3_config = config.get('s3') or {}
    try:
        print("Initializing connection pool...")
        connection_pool = ConnectionPool(
            max_connections_per_db=config.get('duckdb_max_connections', 3),
            s3_config=s3_config,
            memory_limit=str(config.get('duckdb_memory_limit', 'auto')),
            threads=config.get('duckdb_threads', 2),
        )
        print("Initializing database registry...")
        registry = DatabaseRegistry(args.data_folder, connection_pool, s3_config=s3_config)
    except FileNotFoundError as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)

    if len(registry.databases) == 0:
        print(f"Warning: No databases found in {args.data_folder}")
        print("The server will start but no databases will be available.")

    # Initialize geneset registry (optional)
    geneset_store_value = config.get('geneset_store')
    if geneset_store_value:
        geneset_path = (script_dir.parent / geneset_store_value).resolve()
        if geneset_path.exists():
            print(f"Initializing geneset registry: {geneset_path}")
            geneset_registry = GenesetRegistry(geneset_path)
            geneset_registry.scan()
            print(
                f"  {len(geneset_registry.experiments)} experiment(s), "
                f"{len(geneset_registry.genesets)} geneset(s)"
            )
            if geneset_registry.errors:
                print(f"  ⚠ {len(geneset_registry.errors)} parse error(s)")
        else:
            print(f"Geneset store path does not exist: {geneset_path} (skipping)")

    # Run md-check on the data folder (read-only: report only, never modify)
    print("\nRunning md-check on data folder...")
    try:
        from md_check import MdCheckReport, check_md_folder, write_log_entry
        md_report = MdCheckReport()
        check_md_folder(Path(args.data_folder), md_report, fix=False)
        print(
            f"  Checked {md_report.checked} .md file(s): "
            f"{md_report.index_count} index.md, {md_report.data_count} data .md"
        )
        if md_report.has_errors() or md_report.has_warnings():
            md_report.print_summary()
            log_messages = md_report.collect_log_messages()
            if log_messages:
                write_log_entry(
                    Path(args.data_folder), 'ant-serve md-check', log_messages
                )
        else:
            print("  ✓ All .md files OK")
    except Exception as e:
        print(f"  ⚠ md-check failed: {e}")

    # Start server
    print(f"\n{'='*60}")
    print(f"Starting Anthive REST API Server")
    print(f"{'='*60}")
    print(f"  Version: 2.0.0")
    print(f"  Host: {args.host}")
    print(f"  Port: {args.port}")
    print(f"  Data folder: {args.data_folder}")
    print(f"  Databases: {len(registry.databases)}")
    print(f"  URL: http://{args.host}:{args.port}")
    print(f"  Docs: http://{args.host}:{args.port}/docs")
    print(f"{'='*60}\n")

    uvicorn.run(
        app,
        host=args.host,
        port=args.port,
        reload=args.reload
    )


if __name__ == '__main__':
    main()
