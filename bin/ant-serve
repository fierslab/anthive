@app.get("/databases/{db_id:path}/embeddings/{embedding_id}", tags=["embeddings"])
async def get_embedding_data(
    db_id: str,
    embedding_id: str,
    limit: int = Query(100000, description="Maximum cells (default 100000)"),
    n_dims: Optional[int] = Query(2, description="Number of dimensions (0 for all)")
):
    """
    Get embedding coordinates for cells

    Parameters:
    - embedding_id: Embedding name (e.g., Umap, Pca)
    - limit: Maximum cells to return (default 100000)
    - n_dims: Number of dimensions (default: 2, use 0 for all)
    """
    try:
        with _pooled_db(db_id) as db:
            dims = None if n_dims == 0 else n_dims
            df = db.get_embedding_data(embedding_id, limit=min(limit, 500_000), n_dims=dims)

            return {
                "embedding_id": embedding_id,
                "n_cells": len(df),
                "n_dims": len(df.columns) - 1,  # Subtract cell_name
                "columns": df.columns.tolist(),
                "data": df.to_dict(orient='records')
            }
    except KeyError as e:
        raise HTTPException(status_code=404, detail=str(e))
    except ValueError as e:
        raise HTTPException(status_code=404, detail=str(e))
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


@app.post("/databases/{db_id:path}/query/sql", tags=["query"])
async def execute_sql_query(db_id: str, request: QueryRequest):
    """
    Execute a raw SQL query on the database

    Request Body:
    - query: SQL query string
    - limit: Optional limit to append (capped at 100000)

    Returns results in JSON format.
    All queries are read-only for security. Only SELECT queries are allowed.
    """
    try:
        # Validate SQL (block writes, DDL, file-reading functions)
        analytics.validate_sql(request.query)
        effective_limit = min(request.limit or 100_000, 100_000)
        with _pooled_db(db_id) as db:
            df = db.execute_sql(request.query, limit=effective_limit)

        # Convert to JSON-safe format
        df = df.where(pd.notna(df), None)

        return {
            "query": request.query,
            "n_rows": len(df),
            "n_columns": len(df.columns),
            "columns": df.columns.tolist(),
            "dtypes": {col: str(dtype) for col, dtype in df.dtypes.items()},
            "data": df.to_dict(orient='records')
        }

    except KeyError as e:
        raise HTTPException(status_code=404, detail=str(e))
    except Exception as e:
        raise HTTPException(status_code=400, detail=f"Query error: {str(e)}")



# ── plot endpoints ─────────────────────────────────────────────────────────────
#
# All endpoints share common size/quality parameters:
#   width (float, inches), height (float, inches), dpi (int)
# They return image/png.  Extend lib/plotting.py to add new plot types.


# ── plot helpers ───────────────────────────────────────────────────────────────

_PLOT_MIME_TYPES = {
    'png': 'image/png',
    'svg': 'image/svg+xml',
    'pdf': 'application/pdf',
}

_PLOT_GEOMS = {
    'scatter', 'violin', 'box', 'bar', 'histogram', 'ecdf', 'kde', 'heatmap',
}


def _resolve_field_kind(
    field_name: str,
    available_embeddings: List[str],
    categorical_fields: List[str],
    numerical_fields: List[str],
    db,
) -> tuple:
    """Classify field_name as (resolved_name, kind).

    kind ∈ {embedding, categorical, numerical, gene}.
    Resolution order: embedding → categorical → numerical → gene (gene is last
    as it requires a DB query). Raises HTTPException(400) if not found.
    """
    if field_name in available_embeddings:
        return field_name, 'embedding'
    if field_name in categorical_fields:
        return field_name, 'categorical'
    if field_name in numerical_fields:
        return field_name, 'numerical'
    matches = db.search_genes(field_name, exact=True, case_sensitive=False, limit=1)
    if matches:
        return matches[0], 'gene'
    raise HTTPException(
        status_code=400,
        detail=(
            f"Field '{field_name}' is not a known embedding, categorical field, "
            f"numerical field, or gene in this dataset."
        ),
    )


def _get_top_genes_by_mean(db, n_genes: int, layer: str) -> List[str]:
    """Return top n_genes names ranked by mean expression.

    Both branches use bound parameters (`?`) for n_genes and `safe_ident()`
    for the layer table — no f-string SQL interpolation of user input.
    """
    try:
        db.require_gene_bins()
        rows = db._conn.execute(
            'SELECT g.gene_name FROM __gene_bins b '
            'JOIN __genes g USING (gene_id) '
            'ORDER BY b.mean_expr DESC '
            'LIMIT ?',
            [n_genes],
        ).fetchall()
        return [r[0] for r in rows]
    except Exception:
        # Validate the layer exists, then route through safe_ident so the
        # identifier is properly quoted (closes a SQL-injection vector that
        # surfaced in the v0 implementation).
        available = db._get_layers()
        if layer not in available:
            raise HTTPException(
                status_code=400,
                detail=f"Layer '{layer}' not in this dataset (available: {available})",
            )
        layer_table = safe_ident(f"layer__{layer}")
        rows = db._conn.execute(
            f'SELECT gene_name, AVG(value) AS avg_expr '
            f'FROM {layer_table} '
            f'GROUP BY gene_name '
            f'ORDER BY avg_expr DESC '
            f'LIMIT ?',
            [n_genes],
        ).fetchall()
        return [r[0] for r in rows]


# ── subset / filter helpers ───────────────────────────────────────────────────


def _parse_subset(subset_params: List[str]) -> Optional[Dict[str, Any]]:
    """Parse ?subset=field:value query params into a filters dict for AnthiveDB.

    Supported formats (all URL-encoded as needed):
      field:value          exact categorical match
      field:v1,v2,v3      IN list (multiple categorical values)
      field:min..max       numerical range (BETWEEN min AND max)

    Multiple subset params for the same field are merged into an IN list.
    Returns None when the list is empty.
    """
    if not subset_params:
        return None

    merged: Dict[str, Any] = {}
    for param in subset_params:
        if ':' not in param:
            continue
        field, _, raw = param.partition(':')
        field = field.strip()
        raw = raw.strip()
        if not field or not raw:
            continue

        # Range: field:min..max
        if '..' in raw:
            parts = raw.split('..', 1)
            try:
                lo, hi = float(parts[0]), float(parts[1])
                merged[field] = (lo, hi)
                continue
            except ValueError:
                pass  # fall through to string handling

        # Single or comma-separated list
        values = [v.strip() for v in raw.split(',') if v.strip()]
        if field in merged:
            existing = merged[field]
            existing_list = existing if isinstance(existing, list) else [existing]
            merged[field] = existing_list + values
        else:
            merged[field] = values if len(values) > 1 else values[0]

    return merged or None


# ── plot response cache ───────────────────────────────────────────────────────
#
# In-memory LRU keyed on (db_id, query string, output format, duckdb mtime
# fingerprint). Plots are deterministic in their inputs, so repeat requests
# return the cached bytes instantly. mtime in the key invalidates a stale
# entry the moment the duckdb is rebuilt (the new key simply misses; the
# LRU bound evicts the old entry over time). /admin/rescan also wipes the
# cache eagerly.

import hashlib as _plot_hashlib
import os as _plot_os
from collections import OrderedDict as _PlotOrderedDict
from threading import Lock as _PlotLock

_PLOT_CACHE_MAX_ENTRIES = 256
_plot_cache: "_PlotOrderedDict[str, dict]" = _PlotOrderedDict()
_plot_cache_lock = _PlotLock()
_plot_cache_stats = {'hits': 0, 'misses': 0, 'evictions': 0}


def _plot_db_fingerprint(db_url: str) -> str:
    """Stable per-deposit fingerprint. mtime for local files, the URL
    itself for s3:// (S3 deposits don't change underneath a running server)."""
    if db_url.startswith('s3://'):
        return db_url
    try:
        return f"{_plot_os.path.getmtime(db_url):.0f}"
    except OSError:
        return db_url


def _plot_cache_key(db_id: str, query: str, output_format: str, fingerprint: str) -> str:
    raw = f"{db_id}|{query}|{output_format}|{fingerprint}"
    return _plot_hashlib.sha1(raw.encode()).hexdigest()


def _plot_cache_get(key: str) -> Optional[dict]:
    with _plot_cache_lock:
        entry = _plot_cache.get(key)
        if entry is None:
            _plot_cache_stats['misses'] += 1
            return None
        _plot_cache.move_to_end(key)
        _plot_cache_stats['hits'] += 1
        return entry


def _plot_cache_put(key: str, entry: dict) -> None:
    with _plot_cache_lock:
        _plot_cache[key] = entry
        _plot_cache.move_to_end(key)
        while len(_plot_cache) > _PLOT_CACHE_MAX_ENTRIES:
            _plot_cache.popitem(last=False)
            _plot_cache_stats['evictions'] += 1


def _plot_cache_clear() -> int:
    """Drop every cached plot. Returns the number of entries removed."""
    with _plot_cache_lock:
        n = len(_plot_cache)
        _plot_cache.clear()
        return n


# ── plot dispatch (handler registry) ──────────────────────────────────────────
#
# Each geom (scatter / violin-box-bar / histogram-ecdf-kde / heatmap) has its
# own handler. The dispatch keeps the endpoint body thin and makes it trivial
# to add a new geom: write a handler, register it. The handler receives a
# PlotRequest + a PlotContext (db connection + a resolve helper for typing
# field names against the dataset's schema).

from dataclasses import dataclass as _plot_dataclass


@_plot_dataclass(frozen=True)
class PlotRequest:
    """Validated inputs to a plot handler — what the endpoint forwards."""
    db_id: str
    geom: str
    x: Optional[str]
    y: Optional[str]
    color: Optional[str]
    output_format: str
    layer: str
    width: float
    height: float
    dpi: int
    bins: int
    point_size: float
    alpha: float
    palette: str
    ci: bool
    n_genes: int
    filters: Optional[Dict[str, Any]]
    sample: Optional[int]
    source_url: str


@_plot_dataclass
class PlotContext:
    """Database handle + schema/resolver helpers shared across handlers."""
    db: Any
    available_embeddings: List[str]
    categorical_fields: List[str]
    numerical_fields: List[str]

    def resolve(self, field_name: str):
        return _resolve_field_kind(
            field_name, self.available_embeddings,
            self.categorical_fields, self.numerical_fields, self.db,
        )


def _handle_scatter(req: PlotRequest, ctx: PlotContext) -> Tuple[bytes, str]:
    emb_id = req.x or ('X_umap' if 'X_umap' in ctx.available_embeddings
                       else (ctx.available_embeddings[0] if ctx.available_embeddings else None))
    if not emb_id:
        raise HTTPException(400, detail="No embeddings available for scatter plot")
    embedding_df = ctx.db.get_embedding_data(emb_id, n_dims=2, filters=req.filters, sample=req.sample)

    color_df = None
    color_field_name = None
    color_kind = 'categorical'
    if req.color:
        color_field_name, color_kind = ctx.resolve(req.color)
        sampled_cells = embedding_df['cell_name'].tolist() if req.sample else None
        color_filters = dict(req.filters) if req.filters else {}
        if sampled_cells:
            color_filters['cell_name'] = sampled_cells
        used_filters = color_filters if sampled_cells else req.filters
        if color_kind == 'gene':
            color_df = ctx.db.get_cell_table(genes=[color_field_name], layer=req.layer, filters=used_filters)
        else:
            color_df = ctx.db.get_cell_table(metadata_fields=[color_field_name], filters=used_filters)

    x_label = str(embedding_df.columns[-2]).replace('dim_', 'Dim ')
    y_label = str(embedding_df.columns[-1]).replace('dim_', 'Dim ')
    caption = plotting.build_caption(req.db_id, req.geom, emb_id, 'embedding',
                                     None, color_field_name, req.layer)
    image_bytes = plotting.plot_scatter(
        embedding_df=embedding_df,
        color_df=color_df,
        color_field=color_field_name,
        color_kind=color_kind,
        x_label=x_label,
        y_label=y_label,
        width=req.width, height=req.height, dpi=req.dpi,
        output_format=req.output_format,
        point_size=req.point_size, alpha=req.alpha, palette=req.palette,
        caption=caption, source_url=req.source_url,
    )
    return image_bytes, caption


def _handle_grouped(req: PlotRequest, ctx: PlotContext) -> Tuple[bytes, str]:
    """Handles violin / box / bar — all share x=categorical, optional y."""
    if not req.x:
        raise HTTPException(400, detail=f"geom='{req.geom}' requires x (categorical field)")
    x_name, x_kind = ctx.resolve(req.x)
    if x_kind != 'categorical':
        raise HTTPException(400, detail=(
            f"geom='{req.geom}' requires x to be categorical; '{req.x}' resolved as '{x_kind}'"
        ))
    y_name = None
    if req.y:
        y_name, y_kind = ctx.resolve(req.y)
        if y_kind == 'gene':
            data_df = ctx.db.get_cell_table(genes=[y_name], metadata_fields=[x_name],
                                            layer=req.layer, filters=req.filters, sample=req.sample)
        else:
            data_df = ctx.db.get_cell_table(metadata_fields=[x_name, y_name],
                                            filters=req.filters, sample=req.sample)
    else:
        data_df = ctx.db.get_cell_table(metadata_fields=[x_name],
                                        filters=req.filters, sample=req.sample)

    caption = plotting.build_caption(req.db_id, req.geom, x_name, x_kind, y_name, None, req.layer)
    image_bytes = plotting.plot_grouped(
        data_df=data_df, x_field=x_name, y_field=y_name,
        geom=req.geom, ci=req.ci,
        width=req.width, height=req.height, dpi=req.dpi,
        output_format=req.output_format,
        caption=caption, source_url=req.source_url,
    )
    return image_bytes, caption


def _handle_distribution(req: PlotRequest, ctx: PlotContext) -> Tuple[bytes, str]:
    """Handles histogram / ecdf / kde — univariate distribution of x, optional color hue."""
    if not req.x:
        raise HTTPException(400, detail=f"geom='{req.geom}' requires x (gene or numerical field)")
    x_name, x_kind = ctx.resolve(req.x)
    color_name = None
    if req.color:
        color_name, _ = ctx.resolve(req.color)
        if x_kind == 'gene':
            data_df = ctx.db.get_cell_table(genes=[x_name], metadata_fields=[color_name],
                                            layer=req.layer, filters=req.filters, sample=req.sample)
        else:
            data_df = ctx.db.get_cell_table(metadata_fields=[x_name, color_name],
                                            filters=req.filters, sample=req.sample)
    else:
        if x_kind == 'gene':
            data_df = ctx.db.get_cell_table(genes=[x_name], layer=req.layer,
                                            filters=req.filters, sample=req.sample)
        else:
            data_df = ctx.db.get_cell_table(metadata_fields=[x_name],
                                            filters=req.filters, sample=req.sample)

    caption = plotting.build_caption(req.db_id, req.geom, x_name, x_kind, None, color_name, req.layer)
    image_bytes = plotting.plot_distribution(
        data_df=data_df, x_field=x_name,
        geom=req.geom, color_field=color_name,
        bins=req.bins,
        width=req.width, height=req.height, dpi=req.dpi,
        output_format=req.output_format,
        caption=caption, source_url=req.source_url,
    )
    return image_bytes, caption


def _handle_heatmap(req: PlotRequest, ctx: PlotContext) -> Tuple[bytes, str]:
    if not req.y:
        raise HTTPException(400, detail="geom='heatmap' requires y (categorical field)")
    y_name, y_kind = ctx.resolve(req.y)
    if y_kind != 'categorical':
        raise HTTPException(400, detail=(
            f"geom='heatmap' requires y to be categorical; '{req.y}' resolved as '{y_kind}'"
        ))
    if req.x:
        # Resolve each gene exactly once (was duplicated in the v0 implementation).
        gene_list: List[str] = []
        for g in (s.strip() for s in req.x.split(',')):
            hits = ctx.db.search_genes(g, exact=True, limit=1)
            if hits:
                gene_list.append(hits[0])
        if not gene_list:
            raise HTTPException(400, detail=f"None of the genes in x='{req.x}' were found")
    else:
        gene_list = _get_top_genes_by_mean(ctx.db, req.n_genes, req.layer)

    data_df = ctx.db.get_cell_table(genes=gene_list, metadata_fields=[y_name],
                                    layer=req.layer, filters=req.filters, sample=req.sample)
    mean_expr_df = data_df.groupby(y_name)[gene_list].mean()

    caption = plotting.build_caption(req.db_id, req.geom, req.x, 'gene', y_name, None, req.layer)
    image_bytes = plotting.plot_heatmap(
        mean_expr_df=mean_expr_df,
        width=req.width, height=req.height, dpi=req.dpi,
        output_format=req.output_format,
        caption=caption, source_url=req.source_url,
    )
    return image_bytes, caption


# Registry: geom → handler. Adding a new geom is now: write a handler,
# add a line here, add the geom name to _PLOT_GEOMS.
_PLOT_HANDLERS: Dict[str, Any] = {
    'scatter':   _handle_scatter,
    'violin':    _handle_grouped,
    'box':       _handle_grouped,
    'bar':       _handle_grouped,
    'histogram': _handle_distribution,
    'ecdf':      _handle_distribution,
    'kde':       _handle_distribution,
    'heatmap':   _handle_heatmap,
}


# ── unified plot endpoint ──────────────────────────────────────────────────────

@app.get("/databases/{db_id:path}/plot", tags=["plots"])
async def plot(
    db_id: str,
    geom: str = Query(..., description="scatter | violin | box | bar | histogram | ecdf | kde | heatmap"),
    x: Optional[str] = Query(None, description="X-axis field (auto-typed: embedding, gene, categorical, numerical)"),
    y: Optional[str] = Query(None, description="Y-axis field (auto-typed)"),
    color: Optional[str] = Query(None, description="Color-encoding field (auto-typed)"),
    output_format: str = Query('png', alias='format', description="png | svg | pdf"),
    layer: str = Query('X', description="Expression layer"),
    width: float = Query(8.0, gt=1.0, le=32.0, description="Figure width in inches (1–32)"),
    height: float = Query(6.0, gt=1.0, le=32.0, description="Figure height in inches (1–32)"),
    dpi: int = Query(150, ge=72, le=600, description="Resolution dots per inch (72–600)"),
    bins: int = Query(20, ge=2, le=500),
    point_size: float = Query(3.0, gt=0.0, le=200.0),
    alpha: float = Query(0.8, ge=0.0, le=1.0),
    palette: str = Query('tab20'),
    ci: bool = Query(True, description="Show 95% CI on bar plots"),
    n_genes: int = Query(20, ge=1, le=200, description="Top genes for heatmap when x not given"),
    subset: List[str] = Query(default=[], description=(
        "Cell subset filter(s). Repeatable. Formats: "
        "'field:value' (exact), 'field:v1,v2' (IN list), 'field:min..max' (range). "
        "Example: subset=sex:female&subset=condition:AD"
    )),
    sample: Optional[int] = Query(None, ge=1, le=1_000_000, description=(
        "Random subsample: draw at most this many cells using DuckDB reservoir sampling"
        "(near-zero overhead, applied after subset filters). "
        "Example: sample=10000. If larger than the cell count, all cells are used."
    )),
    request: Request = None,  # type: ignore[assignment]
):
    """Unified grammar-of-graphics plot endpoint.

    Provide geom + x/y/color field names; the server auto-detects field types.
    Returns the image with X-Plot-Caption and X-Plot-Format response headers.
    Restrict to a cell subset with one or more ?subset=field:value params.
    Use ?sample=N to randomly draw N cells (DuckDB reservoir sampling).
    """
    filters = _parse_subset(subset)
    if geom not in _PLOT_GEOMS:
        raise HTTPException(400, detail=f"Unknown geom '{geom}'. Valid: {sorted(_PLOT_GEOMS)}")
    if output_format not in _PLOT_MIME_TYPES:
        raise HTTPException(400, detail=f"Unknown format '{output_format}'. Valid: png, svg, pdf")

    # Cache lookup — keyed on (db_id, query string, format, file fingerprint).
    # If the duckdb hasn't changed since we last rendered this exact query,
    # return the cached bytes directly.
    source_url = str(request.url) if request is not None else ''
    try:
        db_fingerprint = _plot_db_fingerprint(registry.get_database_path(db_id))
    except KeyError:
        raise HTTPException(status_code=404, detail=f"Dataset '{db_id}' not found")
    query_string = request.url.query if request is not None else ''
    cache_key = _plot_cache_key(db_id, query_string, output_format, db_fingerprint)
    cached = _plot_cache_get(cache_key)
    if cached is not None:
        return Response(
            content=cached['bytes'],
            media_type=cached['mime'],
            headers={
                'X-Plot-Caption':   cached['caption'],
                'X-Plot-Format':    output_format,
                'X-Source-URL':     cached['source_url'],
                'X-Plot-Cache':     'HIT',
                'ETag':             f'"{cache_key}"',
                'Cache-Control':    'public, max-age=3600',
            },
        )

    plot_req = PlotRequest(
        db_id=db_id, geom=geom, x=x, y=y, color=color,
        output_format=output_format, layer=layer,
        width=width, height=height, dpi=dpi, bins=bins,
        point_size=point_size, alpha=alpha, palette=palette,
        ci=ci, n_genes=n_genes,
        filters=filters, sample=sample,
        source_url=source_url,
    )
    handler = _PLOT_HANDLERS[geom]  # geom validity already checked above

    def _sync_plot():
        with _pooled_db(db_id) as db:
            ctx = PlotContext(
                db=db,
                available_embeddings=db._get_embeddings(),
                categorical_fields=db._get_categorical_fields(),
                numerical_fields=db._get_numerical_fields(),
            )
            return handler(plot_req, ctx)

    try:
        image_bytes, caption = await asyncio.to_thread(_sync_plot)
    except HTTPException:
        raise
    except KeyError as e:
        raise HTTPException(status_code=404, detail=str(e))
    except ValueError as e:
        raise HTTPException(status_code=400, detail=str(e))
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

    mime = _PLOT_MIME_TYPES[output_format]
    _plot_cache_put(cache_key, {
        'bytes':      image_bytes,
        'caption':    caption,
        'source_url': source_url,
        'mime':       mime,
    })
    return Response(
        content=image_bytes,
        media_type=mime,
        headers={
            'X-Plot-Caption':   caption,
            'X-Plot-Format':    output_format,
            'X-Source-URL':     source_url,
            'X-Plot-Cache':     'MISS',
            'ETag':             f'"{cache_key}"',
            'Cache-Control':    'public, max-age=3600',
        },
    )


# ── legacy plot endpoints (deprecated — use /plot) ────────────────────────────

@app.get("/databases/{db_id:path}/plot/umap", tags=["plots"], deprecated=True)
async def plot_umap(
    db_id: str,
    embedding: Optional[str] = Query(None, description="Embedding key, e.g. X_umap (default: first available)"),
    gene: Optional[str] = Query(None, description="Color by gene expression"),
    category: Optional[str] = Query(None, description="Color by categorical metadata field"),
    numerical: Optional[str] = Query(None, description="Color by numerical metadata field"),
    layer: str = Query("X", description="Expression layer"),
    width: float = Query(8.0, description="Figure width in inches"),
    height: float = Query(6.0, description="Figure height in inches"),
    dpi: int = Query(150, description="Output resolution (dots per inch)"),
    point_size: float = Query(3.0, description="Scatter point size"),
    alpha: float = Query(0.8, description="Point transparency (0–1)"),
    palette: str = Query("tab20", description="Seaborn palette for categorical coloring"),
    subset: List[str] = Query(default=[], description="Cell subset filters: 'field:value', 'field:v1,v2', 'field:min..max'"),
):
    """
    Render a UMAP scatter plot and return PNG.

    Provide at most one of: gene, category, numerical.
    If none given, all cells are rendered in a single colour.
    """
    filters = _parse_subset(subset)
    try:
        with _pooled_db(db_id) as db:
            available_embeddings = db._get_embeddings()
            if not available_embeddings:
                raise HTTPException(status_code=400, detail="No embeddings available for this database")

            emb_id = embedding or ('X_umap' if 'X_umap' in available_embeddings else available_embeddings[0])
            embedding_df = db.get_embedding_data(emb_id, n_dims=2, filters=filters)

            color_df = None
            color_field = None
            color_type = 'categorical'

            if gene:
                color_df = db.get_cell_table(genes=[gene], layer=layer, filters=filters)
                color_field = gene
                color_type = 'gene'
            elif category:
                color_df = db.get_cell_table(metadata_fields=[category], filters=filters)
                color_field = category
                color_type = 'categorical'
            elif numerical:
                color_df = db.get_cell_table(metadata_fields=[numerical], filters=filters)
                color_field = numerical
                color_type = 'numerical'

        png = plotting.plot_umap(
            embedding_df=embedding_df,
            color_df=color_df,
            color_field=color_field,
            color_type=color_type,
            width=width, height=height, dpi=dpi,
            point_size=point_size, alpha=alpha, palette=palette,
        )
        return Response(content=png, media_type='image/png')

    except KeyError as e:
        raise HTTPException(status_code=404, detail=str(e))
    except ValueError as e:
        raise HTTPException(status_code=400, detail=str(e))
    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


