    }


@app.get("/databases/{db_id:path}/info", tags=["databases"])
async def get_database_info(db_id: str):
    """
    Get detailed information about a specific database

    Returns:
    - title: Dataset title
    - n_cells: Number of cells
    - n_genes: Number of genes
    - layers: Dict of layer keys to friendly names
      - Example: {"X": "Normalized expression", "counts": "Raw counts"}
    - embeddings: Dict of embedding keys to metadata objects
      - Example: {"X_umap": {"name": "Umap", "dimensions": 2}}
      - Each value contains:
        - name: Friendly name
        - dimensions: Number of dimensions
    - obs: Observation metadata columns
      - numerical: List of numerical columns
      - categorical: List of categorical columns
      - total: Total number of obs columns
    - var: Variable metadata columns
      - columns: List of var columns
      - total: Total number of var columns
    - version: Anthive version
    - sha256: File checksum
    - date: Last checked date
    - year: Publication year
    - collection: Collection metadata (if available)
      - group: Collection/study name
      - experiment: Experiment description
      - authors: List of authors
      - year: Publication year
    """
    try:
        metadata = registry.get_database_metadata(db_id)
        return metadata
    except KeyError as e:
        raise HTTPException(status_code=404, detail=str(e))
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


@app.get("/databases/{db_id:path}/genes", tags=["genes"])
async def search_genes(
    db_id: str,
    q: str = Query(..., description="Search string", example="CD4"),
    limit: Optional[int] = Query(None, description="Maximum results"),
    case_sensitive: bool = Query(False, description="Case-sensitive search"),
    exact: bool = Query(False, description="Exact name match (no substring)")
):
    """
    Search for genes by name.

    Returns a list of gene names matching the search query.

    - `exact=false` (default): substring match — `q=CD4` matches CD4, CD40, CD40LG, …
    - `exact=true`: full-name match — `q=CD4` matches CD4 only (case-insensitive unless `case_sensitive=true`)

    Example:
        GET /databases/my_db/genes?q=CD4&limit=10
        GET /databases/my_db/genes?q=CD4&exact=true
    """
    try:
        def _sync_search():
            with _pooled_db(db_id) as db:
                genes = db.search_genes(q, case_sensitive=case_sensitive, limit=limit, exact=exact)
            return {"query": q, "count": len(genes), "genes": genes}
        return await asyncio.to_thread(_sync_search)
    except KeyError as e:
        raise HTTPException(status_code=404, detail=str(e))
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


@app.get("/databases/{db_id:path}/genes/{gene_id}", tags=["genes"])
async def get_gene_info(db_id: str, gene_id: str):
    """
    Get information about a specific gene

    Returns:
    - Gene name
    - Existence confirmation
    - Available layers containing this gene
    """
    try:
        with _pooled_db(db_id) as db:
            info = db.get_gene_info(gene_id)
            return info
    except KeyError as e:
        raise HTTPException(status_code=404, detail=str(e))
    except ValueError as e:
        raise HTTPException(status_code=404, detail=str(e))
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


@app.get("/databases/{db_id:path}/gene_stats", tags=["genes"])
async def get_gene_stats(
    db_id: str,
    genes: str = Query(..., description="Comma-separated gene names, e.g. APOE,CLU"),
    layer: str = Query("X", description="Layer name (default: X)")
):
    """
    Get expression statistics for one or more genes.

    Computed efficiently from sparse data without transferring all cells.

    Returns per-gene:
    - **n_cells**: total cell count
    - **n_nonzero**: cells with non-zero expression
    - **pct_nonzero**: % cells expressing the gene
    - **mean**, **std**: over all cells (zeros = 0)
    - **mean_nonzero**, **std_nonzero**, **median_nonzero**, **q10_nonzero**, **q90_nonzero**, **max**: expressing cells only

    Example:
        GET /databases/LC5/SPM/gene_stats?genes=APOE,CLU&layer=X
    """
    try:
        gene_list = [g.strip() for g in genes.split(',') if g.strip()]
        with _pooled_db(db_id) as db:
            stats = db.get_gene_stats(gene_list, layer=layer)
        return {"db_id": db_id, "layer": layer, "stats": stats}
    except KeyError as e:
        raise HTTPException(status_code=404, detail=str(e))
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


@app.get("/gene_stats_all", tags=["genes"])
async def get_gene_stats_all(
    genes: str = Query(..., description="Comma-separated gene names, e.g. APOE,CLU"),
    case_sensitive: bool = Query(False, description="Case-sensitive gene name matching (default: False)")
):
    """
    Get expression statistics for selected genes across **all** databases that have a `default_layer`.

    For each qualifying database the `default_layer` is used automatically.
    Gene names are matched case-insensitively by default (so `APOE` matches `Apoe`).
    When the stored name differs from the queried name a `gene_found` field is included in the result.

    Returns:
    - **results**: list of per-database entries, each with `db_id`, `title`, `n_cells`, `layer`, `stats`
    - **n_databases**: number of databases queried
    - **n_skipped**: number of databases skipped (no default_layer or error)

    Example:
        GET /gene_stats_all?genes=APOE,TREM2
        GET /gene_stats_all?genes=APOE,TREM2&case_sensitive=true
    """
    gene_list = [g.strip() for g in genes.split(',') if g.strip()]

    def _sync_query_all_dbs():
        query_results = []
        n_skip = 0
        for db_id_inner, meta in registry.metadata_cache.items():
            layer = meta.get('default_layer')
            if not layer:
                n_skip += 1
                continue
            try:
                with _pooled_db(db_id_inner) as db:
                    stats = db.get_gene_stats(gene_list, layer=layer, case_sensitive=case_sensitive)
                query_results.append({
                    'db_id': db_id_inner,
                    'group': registry._db_extra.get(db_id_inner, {}).get('group_id', ''),
                    'title': meta.get('title', db_id_inner),
                    'n_cells': meta.get('n_cells', 0),
                    'layer': layer,
                    'stats': stats,
                })
            except Exception:
                n_skip += 1
        return query_results, n_skip

    results, n_skipped = await asyncio.to_thread(_sync_query_all_dbs)

    # ── Cross-database CV per gene ─────────────────────────────────────────
    # Collect mean expression per gene across all databases (skip not-found)
    from collections import defaultdict
    import math as _math

    gene_means: Dict[str, List[float]] = defaultdict(list)
    for r in results:
        for s in r['stats']:
            if 'error' not in s and s.get('mean', 0) > 0:
                gene_means[s['gene']].append(s['mean'])

    # CV = std(means) / mean(means) across databases
    gene_cv: Dict[str, float] = {}
    for gene, means in gene_means.items():
        if len(means) >= 2:
            mu = sum(means) / len(means)
            if mu > 0:
                variance = sum((m - mu) ** 2 for m in means) / (len(means) - 1)
                gene_cv[gene] = round(_math.sqrt(variance) / mu, 4)

    # Rank CV among queried genes (0 = least variable, 1 = most variable)
    if gene_cv:
        sorted_genes = sorted(gene_cv, key=lambda g: gene_cv[g])
        n_cv = len(sorted_genes)
        gene_cv_rank = {g: round(i / (n_cv - 1), 4) if n_cv > 1 else 0.5
                        for i, g in enumerate(sorted_genes)}
        for r in results:
            for s in r['stats']:
                gene = s.get('gene')
                if gene in gene_cv:
                    s['cross_db_cv']      = gene_cv[gene]
                    s['rank_cross_db_cv'] = gene_cv_rank[gene]
    # ──────────────────────────────────────────────────────────────────────

    return {
        'genes': gene_list,
        'case_sensitive': case_sensitive,
        'n_databases': len(results),
        'n_skipped': n_skipped,
        'results': results,
    }


@app.get("/databases/{db_id:path}/cells", tags=["data"])
async def get_cells(
    db_id: str,
    genes: Optional[str] = Query(None, description="Comma-separated gene names"),
    metadata: Optional[str] = Query(None, description="Comma-separated metadata fields, '*' for all"),
    layer: str = Query("X", description="Layer name"),
    filter: Optional[List[str]] = Query(None, description="Filters: field:value or field:min,max"),
    limit: Optional[int] = Query(None, description="Maximum cells (no default)"),
    format: str = Query("json", description="Output format: json, csv, parquet")
):
    """
    Get cell table with expression and metadata

    Query Parameters:
    - genes: Comma-separated gene names to include
    - metadata: Comma-separated fields, "*" for all, empty/omit for none
    - layer: Layer name (default: "X")
    - filter: Filters in format field:value or field:min,max
    - limit: Maximum cells (optional, returns all if not specified)
    - format: Output format (json, csv, parquet)

    Examples:
        GET /databases/my_db/cells?genes=CD4,CD8&metadata=cell_type&layer=X
        GET /databases/my_db/cells?genes=CD4&filter=cell_type:T-cell&limit=100
        GET /databases/my_db/cells?metadata=*&format=csv
    """
    try:
        # Parse parameters
        gene_list = genes.split(',') if genes else None

        # Handle metadata parameter
        if metadata is None or metadata == "":
            metadata_list = None  # No metadata
        elif metadata == "*":
            metadata_list = ["*"]  # All metadata
        else:
            metadata_list = metadata.split(',')

        # Parse filters
        filters = {}
        if filter:
            for f in filter:
                if ':' not in f:
                    raise ValueError(f"Invalid filter format: {f}")

                field, value = f.split(':', 1)

                # Try to parse as range
                if ',' in value:
                    try:
                        parts = value.split(',')
                        filters[field] = (float(parts[0]), float(parts[1]))
                    except ValueError:
                        filters[field] = value
                else:
                    # Try numeric conversion
                    try:
                        filters[field] = float(value)
                    except ValueError:
                        filters[field] = value

        # Get data
        with _pooled_db(db_id) as db:
            df = db.get_cell_table(
                genes=gene_list,
                metadata_fields=metadata_list,
                layer=layer,
                filters=filters,
                limit=limit
            )

        # Return in requested format
        if format == "csv":
            output = StringIO()
            df.to_csv(output, index=False)
            # Generate filename (max 60 chars)
            base_name = db_id.replace('/', '_')
            filename = f"{base_name}_cells.csv"
            if len(filename) > 60:
                # Truncate base_name to fit within 60 chars including suffix
                max_base = 60 - len("_cells.csv")
                filename = f"{base_name[:max_base]}_cells.csv"
            return Response(
                content=output.getvalue(),
                media_type="text/csv",
                headers={"Content-Disposition": f"attachment; filename={filename}"}
            )
        elif format == "parquet":
            output = BytesIO()
            df.to_parquet(output, index=False)
            # Generate filename (max 60 chars)
            base_name = db_id.replace('/', '_')
            filename = f"{base_name}_cells.parquet"
            if len(filename) > 60:
                # Truncate base_name to fit within 60 chars including suffix
                max_base = 60 - len("_cells.parquet")
                filename = f"{base_name[:max_base]}_cells.parquet"
            return Response(
                content=output.getvalue(),
                media_type="application/octet-stream",
                headers={"Content-Disposition": f"attachment; filename={filename}"}
            )
        else:  # json
            # Convert to JSON-safe format using pandas to_json which handles NaN/inf properly
            import json
            json_str = df.to_json(orient='records', double_precision=6)
            data = json.loads(json_str)
            # Ensure all values are JSON-safe (no numpy types)
            n_cells = int(len(df))
            n_columns = int(len(df.columns))
            columns = [str(col) for col in df.columns.tolist()]
            return {
                "n_cells": n_cells,
                "n_columns": n_columns,
                "columns": columns,
                "data": data
            }

    except KeyError as e:
        raise HTTPException(status_code=404, detail=str(e))
    except ValueError as e:
        raise HTTPException(status_code=400, detail=str(e))
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


