@app.get("/databases/{db_id:path}/plot/cat", tags=["plots"], deprecated=True)
async def plot_cat(
    db_id: str,
    cat: str = Query(..., description="Categorical metadata field to group by"),
    y: Optional[str] = Query(None, description="Gene or numerical field for Y axis (omit for cell counts)"),
    y_type: str = Query("count", description="Y axis type: count | gene | numerical"),
    plot_type: str = Query("bar", description="Plot type: bar | box | violin"),
    layer: str = Query("X", description="Expression layer (used when y_type=gene)"),
    width: float = Query(8.0, description="Figure width in inches"),
    height: float = Query(5.0, description="Figure height in inches"),
