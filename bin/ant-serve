from contextlib import contextmanager

@contextmanager
def _pooled_db(db_id: str):
    """Context manager: AnthiveDB backed by the connection pool (local or S3)."""
    db_url = registry.get_database_path(db_id)
    try:
        conn = connection_pool.get_connection(db_url)
    except EvictedDatabaseError as exc:
        raise HTTPException(
            status_code=503,
            detail=f"{exc}",
            headers={"Retry-After": "5"},
        )
    try:
        yield AnthiveDB(conn=conn, owns_conn=False)
    finally:
        connection_pool.return_connection(db_url, conn)


@app.get("/health", tags=["info"])
async def health_check():
    """
    Health check endpoint for load balancers

    Returns 200 if healthy, 503 if unhealthy
    """
    try:
        database_count = len(registry.databases)
        error_count = sum(1 for m in registry.metadata_cache.values() if 'error' in m)

        if database_count == 0:
            raise HTTPException(
                status_code=503,
                detail="No databases available"
            )

        return {
            "status": "healthy",
            "databases": database_count,
            "database_errors": error_count,
            "uptime_seconds": int(registry.get_uptime())
        }
    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(
            status_code=503,
            detail=f"Health check failed: {str(e)}"
        )


@app.get("/metrics", tags=["info"])
async def get_metrics():
    """
    Performance metrics endpoint (Phase 2)

    Returns:
    - Request statistics
    - Connection pool statistics
    - Cache statistics
    - Uptime information
    """
    try:
        pool_stats = connection_pool.get_stats()

        return {
            "uptime_seconds": int(registry.get_uptime()),
            "requests": {
                "total": registry.request_count,
                "errors": registry.error_count,
                "error_rate": registry.error_count / max(1, registry.request_count)
            },
            "connection_pool": pool_stats,
            "caches": {
                "databases": len(registry.databases),
                "metadata_cached": len(registry.metadata_cache),
                "gene_lists_cached": len(registry.gene_list_cache),
                "metadata_stats_cached": len(registry.metadata_stats_cache)
            }
        }
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


@app.get("/databases", tags=["databases"])
async def list_databases(
    refresh: bool = Query(False, description="Force refresh from disk")
):
    """
    List all available databases with metadata

    Returns comprehensive information about each database including:
    - Database ID and path
    - Title, version, checksum, date
    - Cell and gene counts
    - Available layers and embeddings
    - Collection metadata (group, experiment, authors)

    Use `?refresh=true` to force reload from disk.
    """
    databases = registry.list_databases(force_refresh=refresh)
    return {
        "databases": databases,
        "total": len(databases)
    }


@app.get("/databases/{db_id:path}/info", tags=["databases"])
async def get_database_info(db_id: str):
    """
    Get detailed information about a specific database

    Returns:
    - title: Dataset title
    - n_cells: Number of cells
    - n_genes: Number of genes
    - layers: Dict of layer keys to friendly names
      - Example: {"X": "Normalized expression", "counts": "Raw counts"}
    - embeddings: Dict of embedding keys to metadata objects
      - Example: {"X_umap": {"name": "Umap", "dimensions": 2}}
      - Each value contains:
        - name: Friendly name
        - dimensions: Number of dimensions
    - obs: Observation metadata columns
      - numerical: List of numerical columns
      - categorical: List of categorical columns
      - total: Total number of obs columns
    - var: Variable metadata columns
      - columns: List of var columns
      - total: Total number of var columns
    - version: Anthive version
    - sha256: File checksum
    - date: Last checked date
    - year: Publication year
    - collection: Collection metadata (if available)
      - group: Collection/study name
      - experiment: Experiment description
      - authors: List of authors
      - year: Publication year
    """
    try:
        metadata = registry.get_database_metadata(db_id)
        return metadata
    except KeyError as e:
        raise HTTPException(status_code=404, detail=str(e))
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


@app.get("/databases/{db_id:path}/genes", tags=["genes"])
async def search_genes(
    db_id: str,
    q: str = Query(..., description="Search string", example="CD4"),
    limit: Optional[int] = Query(None, description="Maximum results"),
    case_sensitive: bool = Query(False, description="Case-sensitive search"),
    exact: bool = Query(False, description="Exact name match (no substring)")
):
    """
    Search for genes by name.

    Returns a list of gene names matching the search query.

    - `exact=false` (default): substring match — `q=CD4` matches CD4, CD40, CD40LG, …
    - `exact=true`: full-name match — `q=CD4` matches CD4 only (case-insensitive unless `case_sensitive=true`)

    Example:
        GET /databases/my_db/genes?q=CD4&limit=10
        GET /databases/my_db/genes?q=CD4&exact=true
    """
    try:
        def _sync_search():
            with _pooled_db(db_id) as db:
                genes = db.search_genes(q, case_sensitive=case_sensitive, limit=limit, exact=exact)
            return {"query": q, "count": len(genes), "genes": genes}
        return await asyncio.to_thread(_sync_search)
    except KeyError as e:
        raise HTTPException(status_code=404, detail=str(e))
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


