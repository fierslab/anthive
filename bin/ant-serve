@app.get("/databases/{db_id:path}/embeddings/{embedding_id}", tags=["embeddings"])
async def get_embedding_data(
    db_id: str,
    embedding_id: str,
    limit: Optional[int] = Query(None, description="Maximum cells"),
    n_dims: Optional[int] = Query(2, description="Number of dimensions (0 for all)")
):
    """
    Get embedding coordinates for cells

    Parameters:
    - embedding_id: Embedding name (e.g., Umap, Pca)
    - limit: Maximum cells to return
    - n_dims: Number of dimensions (default: 2, use 0 for all)
    """
    try:
        with _pooled_db(db_id) as db:
            dims = None if n_dims == 0 else n_dims
            df = db.get_embedding_data(embedding_id, limit=limit, n_dims=dims)

            return {
                "embedding_id": embedding_id,
                "n_cells": len(df),
                "n_dims": len(df.columns) - 1,  # Subtract cell_name
                "columns": df.columns.tolist(),
                "data": df.to_dict(orient='records')
            }
    except KeyError as e:
        raise HTTPException(status_code=404, detail=str(e))
    except ValueError as e:
        raise HTTPException(status_code=404, detail=str(e))
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


@app.post("/databases/{db_id:path}/query/sql", tags=["query"])
async def execute_sql_query(db_id: str, request: QueryRequest):
    """
    Execute a raw SQL query on the database

    Request Body:
    - query: SQL query string
    - limit: Optional limit to append

    Returns results in JSON format.
    All queries are read-only for security.
    """
    try:
        with _pooled_db(db_id) as db:
            df = db.execute_sql(request.query, limit=request.limit)

        # Convert to JSON-safe format
        df = df.where(pd.notna(df), None)

        return {
            "query": request.query,
            "n_rows": len(df),
            "n_columns": len(df.columns),
            "columns": df.columns.tolist(),
            "dtypes": {col: str(dtype) for col, dtype in df.dtypes.items()},
            "data": df.to_dict(orient='records')
        }

    except KeyError as e:
        raise HTTPException(status_code=404, detail=str(e))
    except Exception as e:
        raise HTTPException(status_code=400, detail=f"Query error: {str(e)}")



# ── plot endpoints ─────────────────────────────────────────────────────────────
#
# All endpoints share common size/quality parameters:
#   width (float, inches), height (float, inches), dpi (int)
# They return image/png.  Extend lib/plotting.py to add new plot types.


# ── plot helpers ───────────────────────────────────────────────────────────────

_PLOT_MIME_TYPES = {
    'png': 'image/png',
    'svg': 'image/svg+xml',
    'pdf': 'application/pdf',
}

_PLOT_GEOMS = {
    'scatter', 'violin', 'box', 'bar', 'histogram', 'ecdf', 'kde', 'heatmap',
}


def _resolve_field_kind(
    field_name: str,
    available_embeddings: List[str],
    categorical_fields: List[str],
    numerical_fields: List[str],
    db,
) -> tuple:
    """Classify field_name as (resolved_name, kind).

    kind ∈ {embedding, categorical, numerical, gene}.
    Resolution order: embedding → categorical → numerical → gene (gene is last
    as it requires a DB query). Raises HTTPException(400) if not found.
    """
    if field_name in available_embeddings:
        return field_name, 'embedding'
    if field_name in categorical_fields:
        return field_name, 'categorical'
    if field_name in numerical_fields:
        return field_name, 'numerical'
    matches = db.search_genes(field_name, exact=True, case_sensitive=False, limit=1)
    if matches:
        return matches[0], 'gene'
    raise HTTPException(
        status_code=400,
        detail=(
            f"Field '{field_name}' is not a known embedding, categorical field, "
            f"numerical field, or gene in this dataset."
        ),
    )


def _get_top_genes_by_mean(db, n_genes: int, layer: str) -> List[str]:
    """Return top n_genes names ranked by mean expression."""
    try:
        db.require_gene_bins()
        rows = db._conn.execute(
            'SELECT g.gene_name FROM __gene_bins b '
            'JOIN __genes g USING (gene_id) '
            'ORDER BY b.mean_expr DESC '
            f'LIMIT {n_genes}'
        ).fetchall()
        return [r[0] for r in rows]
    except Exception:
        rows = db._conn.execute(
            f'SELECT gene_name, AVG(value) AS avg_expr '
            f'FROM layer__{layer} '
            f'GROUP BY gene_name '
            f'ORDER BY avg_expr DESC '
            f'LIMIT {n_genes}'
        ).fetchall()
        return [r[0] for r in rows]


# ── subset / filter helpers ───────────────────────────────────────────────────


def _parse_subset(subset_params: List[str]) -> Optional[Dict[str, Any]]:
    """Parse ?subset=field:value query params into a filters dict for AnthiveDB.

    Supported formats (all URL-encoded as needed):
      field:value          exact categorical match
      field:v1,v2,v3      IN list (multiple categorical values)
      field:min..max       numerical range (BETWEEN min AND max)

    Multiple subset params for the same field are merged into an IN list.
    Returns None when the list is empty.
    """
    if not subset_params:
        return None

    merged: Dict[str, Any] = {}
    for param in subset_params:
        if ':' not in param:
            continue
        field, _, raw = param.partition(':')
        field = field.strip()
        raw = raw.strip()
        if not field or not raw:
            continue

        # Range: field:min..max
        if '..' in raw:
            parts = raw.split('..', 1)
            try:
                lo, hi = float(parts[0]), float(parts[1])
                merged[field] = (lo, hi)
                continue
            except ValueError:
                pass  # fall through to string handling

        # Single or comma-separated list
        values = [v.strip() for v in raw.split(',') if v.strip()]
        if field in merged:
            existing = merged[field]
            existing_list = existing if isinstance(existing, list) else [existing]
            merged[field] = existing_list + values
        else:
            merged[field] = values if len(values) > 1 else values[0]

    return merged or None


# ── unified plot endpoint ──────────────────────────────────────────────────────

@app.get("/databases/{db_id:path}/plot", tags=["plots"])
async def plot(
    db_id: str,
    geom: str = Query(..., description="scatter | violin | box | bar | histogram | ecdf | kde | heatmap"),
    x: Optional[str] = Query(None, description="X-axis field (auto-typed: embedding, gene, categorical, numerical)"),
    y: Optional[str] = Query(None, description="Y-axis field (auto-typed)"),
    color: Optional[str] = Query(None, description="Color-encoding field (auto-typed)"),
    output_format: str = Query('png', alias='format', description="png | svg | pdf"),
    layer: str = Query('X', description="Expression layer"),
    width: float = Query(8.0),
    height: float = Query(6.0),
    dpi: int = Query(150),
    bins: int = Query(20),
    point_size: float = Query(3.0),
    alpha: float = Query(0.8),
    palette: str = Query('tab20'),
    ci: bool = Query(True, description="Show 95% CI on bar plots"),
    n_genes: int = Query(20, description="Top genes for heatmap when x not given"),
    subset: List[str] = Query(default=[], description=(
        "Cell subset filter(s). Repeatable. Formats: "
        "'field:value' (exact), 'field:v1,v2' (IN list), 'field:min..max' (range). "
        "Example: subset=sex:female&subset=condition:AD"
    )),
    sample: Optional[int] = Query(None, description=(
        "Random subsample: draw at most this many cells using DuckDB reservoir sampling"
        "(near-zero overhead, applied after subset filters). "
        "Example: sample=10000. If larger than the cell count, all cells are used."
    )),
):
    """Unified grammar-of-graphics plot endpoint.

    Provide geom + x/y/color field names; the server auto-detects field types.
    Returns the image with X-Plot-Caption and X-Plot-Format response headers.
    Restrict to a cell subset with one or more ?subset=field:value params.
    Use ?sample=N to randomly draw N cells (DuckDB reservoir sampling).
    """
    filters = _parse_subset(subset)
    if geom not in _PLOT_GEOMS:
        raise HTTPException(400, detail=f"Unknown geom '{geom}'. Valid: {sorted(_PLOT_GEOMS)}")
    if output_format not in _PLOT_MIME_TYPES:
        raise HTTPException(400, detail=f"Unknown format '{output_format}'. Valid: png, svg, pdf")

    def _sync_plot():
        with _pooled_db(db_id) as db:
            available_embeddings = db._get_embeddings()
            categorical_fields = db._get_categorical_fields()
            numerical_fields = db._get_numerical_fields()

            def resolve(field_name):
                return _resolve_field_kind(
                    field_name, available_embeddings,
                    categorical_fields, numerical_fields, db,
                )

            # ── scatter ────────────────────────────────────────────────────────
            if geom == 'scatter':
                emb_id = x or ('X_umap' if 'X_umap' in available_embeddings
                               else (available_embeddings[0] if available_embeddings else None))
                if not emb_id:
                    raise HTTPException(400, detail="No embeddings available for scatter plot")
                embedding_df = db.get_embedding_data(emb_id, n_dims=2, filters=filters, sample=sample)

                color_df = None
                color_field_name = None
                color_kind = 'categorical'
                if color:
                    color_field_name, color_kind = resolve(color)
                    if color_kind == 'gene':
                        color_df = db.get_cell_table(genes=[color_field_name], layer=layer, filters=filters)
                    else:
                        color_df = db.get_cell_table(metadata_fields=[color_field_name], filters=filters)

                x_label = str(embedding_df.columns[-2]).replace('dim_', 'Dim ')
                y_label = str(embedding_df.columns[-1]).replace('dim_', 'Dim ')
                caption = plotting.build_caption(db_id, geom, emb_id, 'embedding',
                                                 None, color_field_name, layer)
                image_bytes = plotting.plot_scatter(
                    embedding_df=embedding_df,
                    color_df=color_df,
                    color_field=color_field_name,
                    color_kind=color_kind,
                    x_label=x_label,
                    y_label=y_label,
                    width=width, height=height, dpi=dpi,
                    output_format=output_format,
                    point_size=point_size, alpha=alpha, palette=palette,
                    caption=caption,
                )

            # ── violin / box / bar ─────────────────────────────────────────────
            elif geom in ('violin', 'box', 'bar'):
                if not x:
                    raise HTTPException(400, detail=f"geom='{geom}' requires x (categorical field)")
                x_name, x_kind = resolve(x)
                if x_kind != 'categorical':
                    raise HTTPException(400, detail=(
                        f"geom='{geom}' requires x to be categorical; "
                        f"'{x}' resolved as '{x_kind}'"
                    ))
                y_name = None
                if y:
                    y_name, y_kind = resolve(y)
                    if y_kind == 'gene':
                        data_df = db.get_cell_table(genes=[y_name], metadata_fields=[x_name], layer=layer, filters=filters, sample=sample)
                    else:
                        data_df = db.get_cell_table(metadata_fields=[x_name, y_name], filters=filters, sample=sample)
                else:
                    data_df = db.get_cell_table(metadata_fields=[x_name], filters=filters, sample=sample)

                caption = plotting.build_caption(db_id, geom, x_name, x_kind,
                                                 y_name, None, layer)
                image_bytes = plotting.plot_grouped(
                    data_df=data_df,
                    x_field=x_name,
                    y_field=y_name,
                    geom=geom, ci=ci,
                    width=width, height=height, dpi=dpi,
                    output_format=output_format,
                    caption=caption,
                )

            # ── histogram / ecdf / kde ─────────────────────────────────────────
            elif geom in ('histogram', 'ecdf', 'kde'):
                if not x:
                    raise HTTPException(400, detail=f"geom='{geom}' requires x (gene or numerical field)")
                x_name, x_kind = resolve(x)
                color_name = None
                if color:
                    color_name, _ = resolve(color)
                    if x_kind == 'gene':
                        data_df = db.get_cell_table(genes=[x_name], metadata_fields=[color_name], layer=layer, filters=filters, sample=sample)
                    else:
                        data_df = db.get_cell_table(metadata_fields=[x_name, color_name], filters=filters, sample=sample)
                else:
                    if x_kind == 'gene':
                        data_df = db.get_cell_table(genes=[x_name], layer=layer, filters=filters, sample=sample)
                    else:
                        data_df = db.get_cell_table(metadata_fields=[x_name], filters=filters, sample=sample)

                caption = plotting.build_caption(db_id, geom, x_name, x_kind,
                                                 None, color_name, layer)
                image_bytes = plotting.plot_distribution(
                    data_df=data_df,
                    x_field=x_name,
                    geom=geom, color_field=color_name,
                    bins=bins,
                    width=width, height=height, dpi=dpi,
                    output_format=output_format,
                    caption=caption,
                )

            # ── heatmap ────────────────────────────────────────────────────────
            else:  # heatmap
                if not y:
                    raise HTTPException(400, detail="geom='heatmap' requires y (categorical field)")
                y_name, y_kind = resolve(y)
                if y_kind != 'categorical':
                    raise HTTPException(400, detail=(
                        f"geom='heatmap' requires y to be categorical; "
                        f"'{y}' resolved as '{y_kind}'"
                    ))
                if x:
                    gene_list = [g.strip() for g in x.split(',')]
                    gene_list = [db.search_genes(g, exact=True, limit=1)[0]
                                 for g in gene_list
                                 if db.search_genes(g, exact=True, limit=1)]
                    if not gene_list:
                        raise HTTPException(400, detail=f"None of the genes in x='{x}' were found")
                else:
                    gene_list = _get_top_genes_by_mean(db, n_genes, layer)

                data_df = db.get_cell_table(genes=gene_list, metadata_fields=[y_name], layer=layer, filters=filters, sample=sample)
                mean_expr_df = data_df.groupby(y_name)[gene_list].mean()

                caption = plotting.build_caption(db_id, geom, x, 'gene',
                                                 y_name, None, layer)
                image_bytes = plotting.plot_heatmap(
                    mean_expr_df=mean_expr_df,
                    width=width, height=height, dpi=dpi,
                    output_format=output_format,
                    caption=caption,
                )

        return image_bytes, caption

    try:
        image_bytes, caption = await asyncio.to_thread(_sync_plot)
    except HTTPException:
        raise
    except KeyError as e:
        raise HTTPException(status_code=404, detail=str(e))
    except ValueError as e:
        raise HTTPException(status_code=400, detail=str(e))
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

    return Response(
        content=image_bytes,
        media_type=_PLOT_MIME_TYPES[output_format],
        headers={
            'X-Plot-Caption': caption,
            'X-Plot-Format': output_format,
        },
    )


# ── legacy plot endpoints (deprecated — use /plot) ────────────────────────────

@app.get("/databases/{db_id:path}/plot/umap", tags=["plots"], deprecated=True)
async def plot_umap(
    db_id: str,
    embedding: Optional[str] = Query(None, description="Embedding key, e.g. X_umap (default: first available)"),
    gene: Optional[str] = Query(None, description="Color by gene expression"),
    category: Optional[str] = Query(None, description="Color by categorical metadata field"),
    numerical: Optional[str] = Query(None, description="Color by numerical metadata field"),
    layer: str = Query("X", description="Expression layer"),
    width: float = Query(8.0, description="Figure width in inches"),
    height: float = Query(6.0, description="Figure height in inches"),
    dpi: int = Query(150, description="Output resolution (dots per inch)"),
    point_size: float = Query(3.0, description="Scatter point size"),
    alpha: float = Query(0.8, description="Point transparency (0–1)"),
    palette: str = Query("tab20", description="Seaborn palette for categorical coloring"),
    subset: List[str] = Query(default=[], description="Cell subset filters: 'field:value', 'field:v1,v2', 'field:min..max'"),
):
    """
    Render a UMAP scatter plot and return PNG.

    Provide at most one of: gene, category, numerical.
    If none given, all cells are rendered in a single colour.
    """
    filters = _parse_subset(subset)
    try:
        with _pooled_db(db_id) as db:
            available_embeddings = db._get_embeddings()
            if not available_embeddings:
                raise HTTPException(status_code=400, detail="No embeddings available for this database")

            emb_id = embedding or ('X_umap' if 'X_umap' in available_embeddings else available_embeddings[0])
            embedding_df = db.get_embedding_data(emb_id, n_dims=2, filters=filters)

            color_df = None
            color_field = None
            color_type = 'categorical'

            if gene:
                color_df = db.get_cell_table(genes=[gene], layer=layer, filters=filters)
                color_field = gene
                color_type = 'gene'
            elif category:
                color_df = db.get_cell_table(metadata_fields=[category], filters=filters)
                color_field = category
                color_type = 'categorical'
            elif numerical:
                color_df = db.get_cell_table(metadata_fields=[numerical], filters=filters)
                color_field = numerical
                color_type = 'numerical'

        png = plotting.plot_umap(
            embedding_df=embedding_df,
            color_df=color_df,
            color_field=color_field,
            color_type=color_type,
            width=width, height=height, dpi=dpi,
            point_size=point_size, alpha=alpha, palette=palette,
        )
        return Response(content=png, media_type='image/png')

    except KeyError as e:
        raise HTTPException(status_code=404, detail=str(e))
    except ValueError as e:
        raise HTTPException(status_code=400, detail=str(e))
    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


@app.get("/databases/{db_id:path}/plot/gene", tags=["plots"], deprecated=True)
async def plot_gene(
    db_id: str,
    gene: str = Query(..., description="Gene name"),
    plot_type: str = Query("ecdf", description="Plot type: ecdf | kde | histogram"),
    layer: str = Query("X", description="Expression layer"),
    bins: int = Query(20, description="Histogram bins (ignored for ecdf/kde)"),
    width: float = Query(7.0, description="Figure width in inches"),
    height: float = Query(4.0, description="Figure height in inches"),
    dpi: int = Query(150, description="Output resolution"),
    subset: List[str] = Query(default=[], description="Cell subset filters: 'field:value', 'field:v1,v2', 'field:min..max'"),
):
    """Render a gene expression distribution plot and return PNG."""
    filters = _parse_subset(subset)
    try:
        with _pooled_db(db_id) as db:
            data_df = db.get_cell_table(genes=[gene], layer=layer, filters=filters)

        png = plotting.plot_gene(
            data_df=data_df,
            gene_field=gene,
            plot_type=plot_type,
            bins=bins,
            width=width, height=height, dpi=dpi,
        )
        return Response(content=png, media_type='image/png')

    except KeyError as e:
        raise HTTPException(status_code=404, detail=str(e))
    except ValueError as e:
        raise HTTPException(status_code=400, detail=str(e))
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


@app.get("/databases/{db_id:path}/plot/cat", tags=["plots"], deprecated=True)
async def plot_cat(
    db_id: str,
    cat: str = Query(..., description="Categorical metadata field to group by"),
    y: Optional[str] = Query(None, description="Gene or numerical field for Y axis (omit for cell counts)"),
    y_type: str = Query("count", description="Y axis type: count | gene | numerical"),
    plot_type: str = Query("bar", description="Plot type: bar | box | violin"),
    layer: str = Query("X", description="Expression layer (used when y_type=gene)"),
    width: float = Query(8.0, description="Figure width in inches"),
    height: float = Query(5.0, description="Figure height in inches"),
    dpi: int = Query(150, description="Output resolution"),
    subset: List[str] = Query(default=[], description="Cell subset filters: 'field:value', 'field:v1,v2', 'field:min..max'"),
):
    """Render a categorical breakdown plot and return PNG."""
    filters = _parse_subset(subset)
    try:
        with _pooled_db(db_id) as db:
            if y_type == 'gene' and y:
                data_df = db.get_cell_table(genes=[y], metadata_fields=[cat], layer=layer, filters=filters)
            elif y_type == 'numerical' and y:
                data_df = db.get_cell_table(metadata_fields=[cat, y], filters=filters)
            else:
                data_df = db.get_cell_table(metadata_fields=[cat], filters=filters)

        png = plotting.plot_cat(
            data_df=data_df,
            cat_field=cat,
            y_field=y,
            y_type=y_type,
            plot_type=plot_type,
            width=width, height=height, dpi=dpi,
        )
        return Response(content=png, media_type='image/png')

    except KeyError as e:
        raise HTTPException(status_code=404, detail=str(e))
    except ValueError as e:
        raise HTTPException(status_code=400, detail=str(e))
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


@app.get("/databases/{db_id:path}/plot/num", tags=["plots"], deprecated=True)
async def plot_num(
    db_id: str,
    num: str = Query(..., description="Numerical metadata field"),
    cat: Optional[str] = Query(None, description="Categorical field to group by (optional)"),
    plot_type: str = Query("ecdf", description="Plot type: ecdf | kde | histogram | box | violin | bar"),
    bins: int = Query(20, description="Histogram bins"),
    width: float = Query(7.0, description="Figure width in inches"),
    height: float = Query(4.0, description="Figure height in inches"),
    dpi: int = Query(150, description="Output resolution"),
    subset: List[str] = Query(default=[], description="Cell subset filters: 'field:value', 'field:v1,v2', 'field:min..max'"),
):
    """Render a numerical field distribution plot and return PNG."""
    filters = _parse_subset(subset)
    try:
        with _pooled_db(db_id) as db:
            metadata_fields = [num] if not cat else [num, cat]
            data_df = db.get_cell_table(metadata_fields=metadata_fields, filters=filters)

        png = plotting.plot_num(
            data_df=data_df,
            num_field=num,
            cat_field=cat,
            plot_type=plot_type,
            bins=bins,
            width=width, height=height, dpi=dpi,
        )
        return Response(content=png, media_type='image/png')

    except KeyError as e:
        raise HTTPException(status_code=404, detail=str(e))
    except ValueError as e:
        raise HTTPException(status_code=400, detail=str(e))
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


# ── analytics endpoints ────────────────────────────────────────────────────────


def _json_safe(obj: Any) -> Any:
    """Recursively replace NaN/Inf floats with None so json.dumps never chokes."""
    if isinstance(obj, float) and not math.isfinite(obj):
        return None
    if isinstance(obj, dict):
        return {k: _json_safe(v) for k, v in obj.items()}
    if isinstance(obj, list):
        return [_json_safe(v) for v in obj]
    return obj


class AnalyticsQueryRequest(BaseModel):
    sql: str
    session_id: Optional[str] = None
    timeout: Optional[int] = None  # seconds; defaults to server ANTHIVE_QUERY_TIMEOUT (120)


class AnalyticsVizRequest(BaseModel):
    session_id: str
    code: str
    output_format: str = 'png'


@app.get("/databases/{db_id:path}/analytics/schema", tags=["analytics"])
async def analytics_schema(db_id: str):
    """Return the schema of all DuckDB tables in a dataset.

    Lists every table with its column names, types, row count, and a 3-row
    sample.  Use this to understand what fields are available before writing
    an analytics_query SQL statement.
    """
    try:
        db_url = registry.get_database_path(db_id)
    except KeyError:
        raise HTTPException(status_code=404, detail=f"Dataset '{db_id}' not found.")
    def _sync_schema():
        conn = connection_pool.get_connection(db_url)
        try:
            return analytics.get_schema(conn)
        finally:
            connection_pool.return_connection(db_url, conn)
    try:
        schema = await asyncio.to_thread(_sync_schema)
    except Exception as exc:
        raise HTTPException(status_code=500, detail=str(exc))
    return _json_safe({"db_id": db_id, "tables": schema})


@app.post("/databases/{db_id:path}/analytics/query", tags=["analytics"])
async def analytics_query(db_id: str, request: AnalyticsQueryRequest):
    """Execute a read-only SELECT query and persist results as a Parquet file.

    The full result set is saved server-side; only column metadata and a small
    preview (first 10 rows) are returned.  Use the returned session_id in a
    subsequent POST /analytics/viz call to visualise the data.

    Constraints:
    - Only SELECT / WITH … SELECT queries are accepted.
    - Result is capped at 500 000 rows (configurable via ANTHIVE_ANALYTICS_ROWS).
    - Query is killed after 30 s (configurable via ANTHIVE_QUERY_TIMEOUT).
    """
    try:
        db_url = registry.get_database_path(db_id)
    except KeyError:
        raise HTTPException(status_code=404, detail=f"Dataset '{db_id}' not found.")
    # analytics.run_query opens and closes its own dedicated connection so that
    # closing it on timeout actually cancels the in-flight DuckDB query.
    try:
        result = await asyncio.to_thread(
            lambda: analytics.run_query(
                db_url, request.sql, request.session_id,
                s3_config=registry._s3_config,
                timeout=request.timeout,
            )
        )
    except (ValueError, RuntimeError) as exc:
        raise HTTPException(status_code=400, detail=str(exc))
    except TimeoutError as exc:
        raise HTTPException(status_code=408, detail=str(exc))
    except Exception as exc:
        raise HTTPException(status_code=500, detail=str(exc))
    return _json_safe(result)


@app.post("/analytics/viz", tags=["analytics"])
async def analytics_viz(request: AnalyticsVizRequest):
    """Execute a Python visualisation script and return the figure as base64.

    The script runs in a subprocess with a blocked-import AST scan and a
    wall-clock timeout.  Two variables are pre-injected:

      DATA_PATH   — path to the Parquet file saved by a prior analytics_query
      OUTPUT_PATH — path where the script MUST save its figure, e.g.:
                        plt.savefig(OUTPUT_PATH, bbox_inches='tight', dpi=150)

    The script may use: pandas, matplotlib, seaborn, numpy, scipy, sklearn,
    statsmodels, and other data-science packages.  Imports of os, sys,
    subprocess, socket, requests, and similar modules are blocked.
    Scripts are killed after 60 s (configurable via ANTHIVE_VIZ_TIMEOUT).
    """
    try:
        figure_b64, output_format = await asyncio.to_thread(
            analytics.run_viz,
            request.session_id, request.code, request.output_format,
        )
    except FileNotFoundError as exc:
        raise HTTPException(status_code=404, detail=str(exc))
    except (ValueError, RuntimeError) as exc:
        raise HTTPException(status_code=400, detail=str(exc))
    except TimeoutError as exc:
        raise HTTPException(status_code=408, detail=str(exc))
    except Exception as exc:
        raise HTTPException(status_code=500, detail=str(exc))
    mime_types = {'png': 'image/png', 'svg': 'image/svg+xml', 'pdf': 'application/pdf'}
    return {
        "session_id":    request.session_id,
        "output_format": output_format,
        "mime_type":     mime_types.get(output_format, 'image/png'),
        "figure_b64":    figure_b64,
    }


@app.post("/admin/rescan", tags=["admin"])
async def rescan_databases():
    """
    Force rescan of data folder and reload all metadata

    Triggers a complete rescan of the data folder, clearing all caches
    and re-discovering databases and metadata.

    Useful after:
    - Adding new database files
    - Updating metadata files (.md, index.md)
    - Removing database files

    Returns:
    - status: 'success'
    - previous_count: Number of databases before rescan
    - current_count: Number of databases after rescan
    - added: List of added database IDs
    - removed: List of removed database IDs
    - databases: Complete list of current database IDs
    """
    try:
        result = registry.rescan()
        return result
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


@app.get("/skill", tags=["info"], response_class=Response)
async def get_skill():
    """Return the Anthive Claude Code skill file (SKILL.md).

    Collaborators can install it with:
        curl -n https://data.nevel.eu/api/skill -o ~/.claude/skills/anthive/SKILL.md
    """
    skill_path = script_dir.parent / ".claude" / "skills" / "anthive" / "SKILL.md"
    if not skill_path.exists():
        raise HTTPException(status_code=404, detail="SKILL.md not found")
    return Response(
        content=skill_path.read_text(),
        media_type="text/markdown",
        headers={"Content-Disposition": "inline; filename=SKILL.md"},
    )


def main():
    """Main entry point"""
    parser = argparse.ArgumentParser(
        description="Anthive REST API Server",
        formatter_class=argparse.RawDescriptionHelpFormatter
    )

    # Get config for defaults
    config = get_config()

    parser.add_argument(
        '--data-folder',
        type=Path,
        default=Path('./data'),
        help='Path to data folder containing .duckdb files (default: ./data)'
    )
    parser.add_argument(
        '--host',
        default=config.get('rest_api_host', '127.0.0.1'),
        help='Host to bind to (default: from config or 127.0.0.1)'
    )
    parser.add_argument(
        '--port',
        type=int,
        default=config.get('rest_api_port', 8000),
        help='Port to bind to (default: from config or 8000)'
    )
    parser.add_argument(
        '--reload',
        action='store_true',
        help='Enable auto-reload for development'
    )

    args = parser.parse_args()

    # Initialize global connection pool and registry (Phase 2)
    global registry, connection_pool
    s3_config = config.get('s3') or {}
    try:
        print("Initializing connection pool...")
        connection_pool = ConnectionPool(max_connections_per_db=5, s3_config=s3_config)
        print("Initializing database registry...")
        registry = DatabaseRegistry(args.data_folder, connection_pool, s3_config=s3_config)
    except FileNotFoundError as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)

    if len(registry.databases) == 0:
        print(f"Warning: No databases found in {args.data_folder}")
        print("The server will start but no databases will be available.")

    # Run md-check on the data folder (read-only: report only, never modify)
    print("\nRunning md-check on data folder...")
    try:
        from md_check import MdCheckReport, check_md_folder, write_log_entry
        md_report = MdCheckReport()
        check_md_folder(Path(args.data_folder), md_report, fix=False)
        print(
            f"  Checked {md_report.checked} .md file(s): "
            f"{md_report.index_count} index.md, {md_report.data_count} data .md"
        )
        if md_report.has_errors() or md_report.has_warnings():
            md_report.print_summary()
            log_messages = md_report.collect_log_messages()
            if log_messages:
                write_log_entry(
                    Path(args.data_folder), 'ant-serve md-check', log_messages
                )
        else:
            print("  ✓ All .md files OK")
    except Exception as e:
        print(f"  ⚠ md-check failed: {e}")

    # Start server
    print(f"\n{'='*60}")
    print(f"Starting Anthive REST API Server")
    print(f"{'='*60}")
    print(f"  Version: 2.0.0")
    print(f"  Host: {args.host}")
    print(f"  Port: {args.port}")
    print(f"  Data folder: {args.data_folder}")
    print(f"  Databases: {len(registry.databases)}")
    print(f"  URL: http://{args.host}:{args.port}")
    print(f"  Docs: http://{args.host}:{args.port}/docs")
    print(f"{'='*60}\n")

    uvicorn.run(
        app,
        host=args.host,
        port=args.port,
        reload=args.reload
    )


if __name__ == '__main__':
    main()
