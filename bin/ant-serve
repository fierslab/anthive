# ── Logging setup ─────────────────────────────────────────────────────────────

def _setup_logging(log_dir: Path = None) -> logging.Logger:
    """Configure file + console logging with rotation."""
    if log_dir is None:
        log_dir = Path(__file__).parent.parent.resolve() / 'logs'
    log_dir.mkdir(parents=True, exist_ok=True)

    logger = logging.getLogger('anthive')
    logger.setLevel(logging.DEBUG)

    # Rotating file handler: 10 MB per file, keep 5 backups
    file_handler = logging.handlers.RotatingFileHandler(
        log_dir / 'ant-serve.log',
        maxBytes=10 * 1024 * 1024,
        backupCount=5,
    )
    file_handler.setLevel(logging.DEBUG)
    file_handler.setFormatter(logging.Formatter(
        '%(asctime)s %(levelname)-8s %(message)s',
        datefmt='%Y-%m-%d %H:%M:%S',
    ))
    logger.addHandler(file_handler)

    # Console: warnings and above only (uvicorn handles INFO)
    console_handler = logging.StreamHandler()
    console_handler.setLevel(logging.WARNING)
    console_handler.setFormatter(logging.Formatter('%(levelname)s: %(message)s'))
    logger.addHandler(console_handler)

    return logger


log = _setup_logging()


def _auto_memory_limit(max_connections: int = 3) -> str:
    """Compute a per-connection DuckDB memory limit based on system RAM.

    Heuristic: reserve 40% of system RAM for DuckDB total, then divide
    by the max number of concurrent connections that could be active.
    Floor at 512 MB, cap at 8 GB per connection.
    """
    import os
    try:
        total_bytes = os.sysconf('SC_PAGE_SIZE') * os.sysconf('SC_PHYS_PAGES')
    except (ValueError, OSError):
        return '2GB'  # safe fallback
    duckdb_budget = int(total_bytes * 0.4)
    per_conn = max(512 * 1024 * 1024, min(duckdb_budget // max(max_connections, 1), 8 * 1024 * 1024 * 1024))
    per_conn_gb = round(per_conn / (1024 * 1024 * 1024), 1)
    return f'{per_conn_gb}GB'


class QueryRequest(BaseModel):
    """Request model for SQL query endpoints"""
    query: str
    limit: Optional[int] = None


class ModuleScoreRequest(BaseModel):
    """Request model for module scoring"""
    genes: List[str]
    layer: str = 'X'
    n_control: int = 100
    seed: int = 42
    subset: List[str] = []


class EvictedDatabaseError(RuntimeError):
    """Raised when get_connection() is called on a db_key that has been
    administratively evicted (a writer is holding the duckdb r/w lock)."""


class ConnectionPool:
    """Connection pool for DuckDB databases

    Maintains a pool of reusable connections per database for better performance.
    Phase 2 enhancement for concurrent request handling.

    Supports eviction (POST /admin/release/{db_id}) for the AnnotationWriter
    workflow — when an annotator wants to take the duckdb r/w lock, ant-serve
    must first close its r/o handles and refuse to issue new ones until the
    writer is done.
    """

    EVICTION_DEFAULT_SECONDS = 300.0

    def __init__(self, max_connections_per_db: int = 3, s3_config: Optional[Dict] = None,
                 memory_limit: str = 'auto', threads: int = 2):
        self.max_connections_per_db = max_connections_per_db
        self.s3_config = s3_config or {}
        if memory_limit == 'auto':
            self.memory_limit = _auto_memory_limit(max_connections_per_db)
        else:
            self.memory_limit = memory_limit
        self.threads = threads
        log.info('ConnectionPool: memory_limit=%s/conn, threads=%d/conn, max_conns_per_db=%d',
                 self.memory_limit, threads, max_connections_per_db)
        self.pools: Dict[str, List[Any]] = defaultdict(list)
        self.in_use: Dict[str, int] = defaultdict(int)
        self.locks: Dict[str, Lock] = defaultdict(Lock)
        self.eviction_until: Dict[str, float] = {}  # db_key -> unix timestamp
        self.total_connections = 0
        self.hits = 0
        self.misses = 0
        self._httpfs_installed = False

    def _make_connection(self, db_key: str):
        """Create a new DuckDB connection for a local path or S3 URL"""
        import duckdb
        if db_key.startswith('s3://'):
            conn = duckdb.connect()
            if not self._httpfs_installed:
                conn.execute("INSTALL httpfs;")
                self._httpfs_installed = True
            conn.execute("LOAD httpfs;")
            s3 = self.s3_config
            raw_ep = (s3.get('endpoint') or '').strip()
            ep_host = raw_ep.removeprefix('https://').removeprefix('http://')
            use_ssl = not raw_ep.startswith('http://')
            use_path_style = s3.get('use_path_style') or bool(ep_host)
            # DuckDB 1.x: use CREATE SECRET instead of SET s3_* variables
            fields = [
                f"TYPE S3",
                f"KEY_ID '{s3.get('access_key_id') or ''}'",
                f"SECRET '{s3.get('secret_access_key') or ''}'",
            ]
            if ep_host:
                fields.append(f"ENDPOINT '{ep_host}'")
            if s3.get('region'):
                fields.append(f"REGION '{s3['region']}'")
            fields.append(f"USE_SSL {'true' if use_ssl else 'false'}")
            if use_path_style:
                fields.append("URL_STYLE 'path'")
            conn.execute(f"CREATE OR REPLACE SECRET _s3 ({', '.join(fields)})")
            conn.execute(f"ATTACH '{db_key}' AS db (READ_ONLY);")
            conn.execute("USE db;")
        else:
            conn = duckdb.connect(db_key, read_only=True)
        # Cap per-connection memory and parallelism to prevent OOM
        conn.execute(f"SET memory_limit = '{self.memory_limit}'")
        conn.execute(f"SET threads = {self.threads}")
        return conn

    def _is_evicted_unlocked(self, db_key: str) -> bool:
        """Caller must hold self.locks[db_key]. Auto-clears expired evictions."""
        deadline = self.eviction_until.get(db_key)
        if deadline is None:
            return False
        if time.time() >= deadline:
            self.eviction_until.pop(db_key, None)
            return False
        return True

    def get_connection(self, db_key: str):
        """Get a connection from the pool or create a new one"""
        with self.locks[db_key]:
            if self._is_evicted_unlocked(db_key):
                expires_in = self.eviction_until[db_key] - time.time()
                raise EvictedDatabaseError(
                    f"db_key {db_key!r} is currently evicted by a writer "
                    f"(expires in {expires_in:.0f}s). Retry shortly or call "
                    f"POST /admin/restore/{{db_id}} to clear."
                )

            # Try to get an existing connection
            if self.pools[db_key]:
                conn = self.pools[db_key].pop()
                self.in_use[db_key] += 1
                self.hits += 1
                return conn

            # Create new connection if under limit
            if self.in_use[db_key] < self.max_connections_per_db:
                conn = self._make_connection(db_key)
                self.in_use[db_key] += 1
                self.total_connections += 1
                self.misses += 1
                return conn

            # Fallback: create an extra connection beyond the pool limit
            self.misses += 1
            return self._make_connection(db_key)

    def release(self, db_key: str, *,
                duration_seconds: Optional[float] = None,
                drain_timeout_seconds: float = 30.0) -> Dict[str, Any]:
        """Mark db_key evicted, close idle conns, wait for in-use to drain.

        Used by POST /admin/release/{db_id}. Returns dict with status and
        counts so the caller can decide whether to proceed.
        """
        if duration_seconds is None:
            duration_seconds = self.EVICTION_DEFAULT_SECONDS

        with self.locks[db_key]:
            # Close idle connections
            n_closed = 0
            while self.pools[db_key]:
                conn = self.pools[db_key].pop()
                try:
                    conn.close()
                except Exception:
                    pass
                n_closed += 1
            # Mark evicted
            self.eviction_until[db_key] = time.time() + duration_seconds

        # Wait for in-use to drain (outside the per-key lock so request
        # handlers can finish and call return_connection)
        deadline = time.monotonic() + drain_timeout_seconds
        while True:
            in_use = self.in_use.get(db_key, 0)
            if in_use <= 0:
                break
            if time.monotonic() > deadline:
                return {
                    'ok': False,
                    'closed_idle': n_closed,
                    'still_in_use': in_use,
                    'eviction_expires_in': duration_seconds,
                    'reason': f"in_use did not drain within {drain_timeout_seconds:.0f}s",
                }
            time.sleep(0.1)

        # Drain happened; also close any conns that came back during the wait
        with self.locks[db_key]:
            late_returns = 0
            while self.pools[db_key]:
                conn = self.pools[db_key].pop()
                try:
                    conn.close()
                except Exception:
                    pass
                late_returns += 1

        return {
            'ok': True,
            'closed_idle': n_closed + late_returns,
            'still_in_use': 0,
            'eviction_expires_in': duration_seconds,
        }

    def restore(self, db_key: str) -> Dict[str, Any]:
        """Clear eviction state so new connections can be issued again."""
        with self.locks[db_key]:
            was_evicted = self._is_evicted_unlocked(db_key)
            self.eviction_until.pop(db_key, None)
        return {'was_evicted': was_evicted}

    def return_connection(self, db_key: str, conn):
        """Return a connection to the pool"""
        with self.locks[db_key]:
            if len(self.pools[db_key]) < self.max_connections_per_db:
                self.pools[db_key].append(conn)
                self.in_use[db_key] = max(0, self.in_use[db_key] - 1)
            else:
                # Close if pool is full
                conn.close()
                self.in_use[db_key] = max(0, self.in_use[db_key] - 1)

    def close_all(self):
        """Close all pooled connections"""
        for db_key, conns in self.pools.items():
            for conn in conns:
                try:
                    conn.close()
                except:
                    pass
            conns.clear()
        self.pools.clear()
        self.in_use.clear()

    def get_stats(self) -> Dict[str, Any]:
        """Get pool statistics"""
        return {
            'total_connections': self.total_connections,
            'active_databases': len(self.pools),
            'pooled_connections': sum(len(p) for p in self.pools.values()),
            'in_use': sum(self.in_use.values()),
            'cache_hits': self.hits,
            'cache_misses': self.misses,
            'hit_rate': self.hits / max(1, self.hits + self.misses)
        }


_METADATA_CACHE_VERSION = 4       # bump when cache format changes
_METADATA_CACHE_TTL_S3  = 86_400  # 24 h for S3 databases (no local mtime)


def _json_serial(obj: object) -> str:
    """JSON serializer for types not handled by the default encoder (e.g. date)."""
    if hasattr(obj, 'isoformat'):
        return obj.isoformat()
    raise TypeError(f"Object of type {type(obj).__name__} is not JSON serializable")


class DatabaseRegistry:
    """Registry of available databases with enhanced caching (Phase 2)

    Caches:
    - Database metadata (Phase 1)
    - Gene lists per database (Phase 2)
    - Metadata field statistics (Phase 2)
    """

    def __init__(self, data_folder: Path, connection_pool: ConnectionPool, s3_config: Optional[Dict] = None):
        self.data_folder = data_folder.resolve()
        self.connection_pool = connection_pool
        self._s3_config = s3_config or {}
        self.databases: Dict[str, str] = {}           # db_id → local path str or s3:// URL
        self._db_md_bases: Dict[str, Path] = {}       # db_id → local .md file path
        self.metadata_cache: Dict[str, Dict[str, Any]] = {}
        self._databases_list_cache: Optional[List[Dict[str, Any]]] = None
        self._db_extra: Dict[str, Dict[str, str]] = {}  # db_id → {group_id, file_id, rel_path}
        self._startup_time = time.time()

        # Phase 2: Enhanced caching
        self.gene_list_cache: Dict[str, List[str]] = {}
        self.metadata_stats_cache: Dict[str, Dict[str, Any]] = {}

        # Metrics
        self.request_count = 0
        self.error_count = 0

        print(f"Scanning data folder: {self.data_folder}")
        self._scan_databases()
        self._cache_all_metadata()

    def _resolve_db_id(self, md_path: Path, rel_path: Path) -> tuple:
        """Compute (db_id, group_id, file_id) from .md files.

        db_id is '{group_id}/{file_id}' derived from YAML metadata.
        Falls back to generate_group_id / generate_file_id when fields are absent.
        Returns (db_id, group_id, file_id).
        """
        top_level = rel_path.parts[0] if len(rel_path.parts) > 1 else rel_path.stem

        # group_id: from index.md in the same directory as the .md file
        index_meta, _ = parse_md_file(md_path.parent / 'index.md')
        group_id = str(index_meta.get('group_id') or '').strip() or generate_group_id(top_level)

        # file_id: from the .md file itself
        data_meta, _ = parse_md_file(md_path)
        file_id = str(data_meta.get('id') or '').strip() or generate_file_id(rel_path.stem)

        return f"{group_id}/{file_id}", group_id, file_id

    def _build_s3_url(self, duckdb_rel: Path) -> str:
        """Build an S3 URL for a relative .duckdb path"""
        bucket = self._s3_config['bucket']
        prefix = (self._s3_config.get('prefix') or '').strip('/')
        base = f"s3://{bucket}/{prefix}" if prefix else f"s3://{bucket}"
        return f"{base}/{duckdb_rel}"

    def _make_s3_client(self):
        """Create a boto3 S3 client from config"""
        import boto3
        s3 = self._s3_config
        endpoint = s3.get('endpoint') or None
        if endpoint and '://' not in endpoint:
            endpoint = 'https://' + endpoint
        return boto3.client(
            's3',
            endpoint_url=endpoint,
            region_name=s3.get('region') or 'us-east-1',
            aws_access_key_id=s3.get('access_key_id') or None,
            aws_secret_access_key=s3.get('secret_access_key') or None,
        )

    def _s3_key_exists(self, s3_client, duckdb_rel: Path) -> bool:
        """Return True if the S3 object exists (HEAD request)"""
        bucket = self._s3_config['bucket']
        prefix = (self._s3_config.get('prefix') or '').strip('/')
        key = f"{prefix}/{duckdb_rel}" if prefix else str(duckdb_rel)
        try:
            s3_client.head_object(Bucket=bucket, Key=key)
            return True
        except Exception:
            return False

    # ── persistent metadata cache ──────────────────────────────────────────────

    def _cache_file_path(self) -> Path:
        return Path('./tmp/metadata_cache.json')

    def _load_persisted_cache(self) -> Dict[str, Any]:
        """Load the on-disk metadata cache.  Returns {} on any error or version mismatch."""
        cache_path = self._cache_file_path()
        if not cache_path.exists():
            return {}
        try:
            with cache_path.open() as f:
                data = json.load(f)
            if data.get('cache_version') != _METADATA_CACHE_VERSION:
                return {}
            return data.get('entries', {})
        except Exception as exc:
            print(f"  Note: could not read metadata cache ({exc}); will reload all.")
            return {}

    def _save_persisted_cache(self, entries: Dict[str, Any]) -> None:
        """Write the metadata cache to disk."""
        cache_path = self._cache_file_path()
        cache_path.parent.mkdir(parents=True, exist_ok=True)
        data = {'cache_version': _METADATA_CACHE_VERSION, 'entries': entries}
        try:
            tmp_path = cache_path.with_suffix('.json.tmp')
            with tmp_path.open('w') as f:
                json.dump(data, f, default=_json_serial)
            tmp_path.replace(cache_path)
        except Exception as exc:
            print(f"  Warning: could not save metadata cache ({exc}).")

    def _get_entry_fingerprint(self, db_id: str) -> Dict[str, float]:
        """Return mtime fingerprint for the files that back a single registry entry."""
        md_path = self._db_md_bases[db_id]
        db_url  = self.databases[db_id]

        md_mtime = md_path.stat().st_mtime if md_path.exists() else 0.0

        # mtime of the nearest ancestor index.md (carries inherited annotation)
        index_mtime = 0.0
        search = md_path.parent
        while search != self.data_folder.parent:
            candidate = search / 'index.md'
            if candidate.exists():
                index_mtime = candidate.stat().st_mtime
                break
            search = search.parent

        duckdb_mtime = 0.0
        if not db_url.startswith('s3://'):
            duckdb_path = Path(db_url)
            duckdb_mtime = duckdb_path.stat().st_mtime if duckdb_path.exists() else 0.0

        return {'md_mtime': md_mtime, 'index_mtime': index_mtime, 'duckdb_mtime': duckdb_mtime}

    def _is_cache_entry_valid(
        self, db_id: str, cached_entry: Dict[str, Any], fingerprint: Dict[str, float],
    ) -> bool:
        """Return True if the cached entry still matches the on-disk files."""
        db_url = self.databases[db_id]
        if cached_entry.get('md_mtime')    != fingerprint['md_mtime']:    return False
        if cached_entry.get('index_mtime') != fingerprint['index_mtime']: return False
        if db_url.startswith('s3://'):
            # No reliable mtime for S3 — fall back to 24 h TTL
            return time.time() - cached_entry.get('cached_at', 0) < _METADATA_CACHE_TTL_S3
        return cached_entry.get('duckdb_mtime') == fingerprint['duckdb_mtime']

    # ── database scanning ──────────────────────────────────────────────────────

    def _scan_databases(self):
        """Scan data folder for databases via .md files (follows symlinks)"""
        if not self.data_folder.exists():
            raise FileNotFoundError(f"Data folder not found: {self.data_folder}")

        self.databases.clear()
        self._db_md_bases.clear()
        self._db_extra.clear()

        s3_enabled = bool(self._s3_config.get('bucket'))
        s3_client = self._make_s3_client() if s3_enabled else None

        # Walk the directory tree, following symlinks
        def scan_recursive(path: Path, base: Path):
            """Recursively scan for .md files (excluding index.md), following symlinks"""
            try:
                for item in path.iterdir():
                    resolved_item = item.resolve()

                    if (resolved_item.is_file()
                            and resolved_item.suffix == '.md'
                            and resolved_item.name != 'index.md'):
                        try:
                            rel_path = item.relative_to(base)

                            # Skip datasets marked inactive via sidecar file
                            if resolved_item.with_suffix('.inactive').exists():
                                continue

                            local_duckdb = resolved_item.with_suffix('.duckdb')
                            if local_duckdb.exists():
                                db_url = str(local_duckdb)
                            elif s3_enabled:
                                duckdb_rel = rel_path.with_suffix('.duckdb')
                                if not self._s3_key_exists(s3_client, duckdb_rel):
                                    continue  # not on S3 either
                                db_url = self._build_s3_url(duckdb_rel)
                            else:
                                continue  # no .duckdb available locally or on S3

                            db_id, group_id, file_id = self._resolve_db_id(resolved_item, rel_path)

                            if db_id in self.databases:
                                existing = self._db_extra[db_id]['rel_path']
                                print(f"  WARNING: ID collision '{db_id}': "
                                      f"{existing} vs {rel_path} — using path fallback")
                                db_id = str(rel_path.with_suffix(''))

                            self.databases[db_id] = db_url
                            self._db_md_bases[db_id] = resolved_item
                            self._db_extra[db_id] = {
                                'group_id': group_id,
                                'file_id': file_id,
                                'rel_path': str(rel_path.with_suffix('.duckdb')),
                            }
                        except ValueError:
                            # Skip if can't make relative path
                            pass
                    elif resolved_item.is_dir():
                        # Skip _-prefixed folders (e.g. _synapse_raw) —
                        # staging / archive areas, not served datasets.
                        if item.name.startswith('_'):
                            continue
                        # Recursively scan subdirectories
                        scan_recursive(item, base)
            except (PermissionError, OSError):
                # Skip directories we can't access
                pass

        scan_recursive(self.data_folder, self.data_folder)

        print(f"Found {len(self.databases)} databases")
        if len(self.databases) <= 10:
            for db_id in sorted(self.databases.keys()):
                print(f"  - {db_id}")
        else:
            for db_id in sorted(self.databases.keys())[:10]:
                print(f"  - {db_id}")
            print(f"  ... and {len(self.databases) - 10} more")

    def _cache_all_metadata(self, force_reload: bool = False) -> None:
        """Load metadata for all databases, using the persisted cache where possible.

        A cache entry is reused when the mtime of the dataset's .md file, its
        nearest ancestor index.md, and the local .duckdb file are all unchanged.
        S3-backed databases use a 24 h TTL instead.

        Pass force_reload=True to ignore the cache and reload everything (used by
        POST /admin/rescan).
        """
        print("Loading metadata (checking cache)..." if not force_reload else "Loading metadata (forced reload)...")
        persisted = {} if force_reload else self._load_persisted_cache()

        self.metadata_cache.clear()
        self._databases_list_cache = None
        errors: List[tuple] = []
        cache_hits = 0
        reloaded = 0
        s3_warnings: List[str] = []

        for db_id, db_url in self.databases.items():
            fingerprint = self._get_entry_fingerprint(db_id)
            cached_entry = persisted.get(db_id, {})

            if not force_reload and self._is_cache_entry_valid(db_id, cached_entry, fingerprint):
                self.metadata_cache[db_id] = cached_entry['metadata']
                cache_hits += 1
                continue

            try:
                metadata = self._load_database_metadata(db_id, self._db_extra[db_id])
                self.metadata_cache[db_id] = metadata
                persisted[db_id] = {
                    'metadata': metadata,
                    **fingerprint,
                    'cached_at': time.time(),
                }
                reloaded += 1
            except Exception as exc:
                error_msg = str(exc)
                is_s3_missing = (
                    db_url.startswith('s3://')
                    and 'does not exist' in error_msg.lower()
                )
                if is_s3_missing:
                    s3_warnings.append(db_id)
                else:
                    errors.append((db_id, error_msg))
                    print(f"\n{'='*70}")
                    print(f"ERROR: Failed to load database metadata")
                    print(f"{'='*70}")
                    print(f"Database: {db_id}")
                    print(f"Path: {db_url}")
                    print(f"Error: {error_msg}")
                    print(f"{'='*70}\n")

        if s3_warnings:
            print(f"  S3 not accessible ({len(s3_warnings)}): {', '.join(s3_warnings)}")
            errors.extend((db_id, 'S3 not accessible') for db_id in s3_warnings)

        # Remove databases that failed to load
        for db_id, _ in errors:
            if db_id in self.databases:
                del self.databases[db_id]
                self._db_md_bases.pop(db_id, None)
                persisted.pop(db_id, None)

        self._save_persisted_cache(persisted)

        status = f"{len(self.metadata_cache)} databases"
        if cache_hits:
            status += f" ({cache_hits} from cache, {reloaded} reloaded)"
        if errors:
            status += f", {len(errors)} skipped"
        print(f"Metadata ready: {status}")

    def _resolve_annotations(self, md_path: Path, file_metadata: dict) -> dict:
        """Build resolved annotation dict for a deposit.

        Reads the post-2026-06 model: the dataset's `<basename>.h5ad.mus`
        sidecar plus the `.env` cascade walking up the folder tree.
        See `lib/mus.py` and `data/h5adstore/CONVENTIONS.md`.

        Legacy alias `celltype` is populated alongside the canonical
        `cell_type` so API consumers that haven't been ported keep working.
        """
        h5ad_path = md_path.with_suffix('.h5ad')
        ann = dict(mus.resolve_annotation(h5ad_path, root=self.data_folder))
        # Backward-compat alias for /databases/{db_id}/info consumers
        if 'cell_type' in ann and 'celltype' not in ann:
            ann['celltype'] = ann['cell_type']
        return ann

    def _load_database_metadata(self, db_id: str, extra: Dict[str, str]) -> Dict[str, Any]:
        """Load metadata from .md files and database"""
        md_path = self._db_md_bases[db_id]
        db_url = self.databases[db_id]

        # Load per-file metadata
        file_metadata, md_body = parse_md_file(md_path)

        # Load collection metadata from the nearest index.md walking up the tree.
        # Sierksma2025 datasets live in subdirectories, so the index.md is one
        # level above the immediate parent.
        index_path = None
        search = md_path.parent
        while search != self.data_folder.parent:
            candidate = search / 'index.md'
            if candidate.exists():
                index_path = candidate
                break
            search = search.parent
        collection_metadata, _ = parse_md_file(index_path) if index_path else ({}, '')

        # Get database info using connection pool
        conn = self.connection_pool.get_connection(db_url)
        try:
            n_cells = conn.execute("SELECT COUNT(*) FROM __cells").fetchone()[0]
            n_genes = conn.execute("SELECT COUNT(*) FROM __genes").fetchone()[0]

            # Get layers with friendly names
            layers_result = conn.execute("""
                SELECT table_name
                FROM information_schema.tables
                WHERE table_type = 'VIEW'
                AND table_name LIKE 'layer__%'
            """).fetchall()
            layer_keys = sorted([row[0].replace('layer__', '') for row in layers_result])

            # Build layers dict with friendly names from metadata
            layers = {}
            layers_include = file_metadata.get('layers_include', [])
            layer_description = file_metadata.get('layer_description', {})
            for key in layer_keys:
                # Only include layers that are in layers_include
                if key in layers_include:
                    # Use description if available, otherwise use key
                    layers[key] = layer_description.get(key, key)

            # Get embeddings with friendly names and dimensions
            embeddings_result = conn.execute("""
                SELECT table_name
                FROM information_schema.tables
                WHERE table_type = 'VIEW'
                AND table_name LIKE 'obsm__%'
            """).fetchall()
            embedding_keys = sorted([row[0].replace('obsm__', '') for row in embeddings_result])

            # Build embeddings dict with friendly names and dimensions
            embeddings = {}
            obsm_include = file_metadata.get('obsm_include', [])
            embedding_description = file_metadata.get('embedding_description', {})
            for key in embedding_keys:
                # Only include embeddings that are in obsm_include
                if key in obsm_include:
                    emb_info = {}

                    # Add friendly name from metadata
                    if key in embedding_description:
                        emb_info['name'] = embedding_description[key]
                    else:
                        # Fallback: capitalize and remove X_ prefix
                        name = key
                        if name.startswith('X_'):
                            name = name[2:]
                        emb_info['name'] = name.capitalize()

                    # Get dimensions (count columns excluding cell_name and cell_id)
                    try:
                        dim_result = conn.execute(f"""
                            SELECT COUNT(*)
                            FROM information_schema.columns
                            WHERE table_name = 'obsm__{key}'
                            AND column_name NOT IN ('cell_name', 'cell_id')
                        """).fetchone()
                        emb_info['dimensions'] = dim_result[0] if dim_result else None
                    except:
                        emb_info['dimensions'] = None

                    embeddings[key] = emb_info

            # Get obs columns (numerical)
            obs_numerical = []
            obsnum_exists = conn.execute("""
                SELECT COUNT(*)
                FROM information_schema.tables
                WHERE table_name = 'obsnum'
            """).fetchone()[0]

            if obsnum_exists:
                num_fields = conn.execute("""
                    SELECT column_name
                    FROM information_schema.columns
                    WHERE table_name = 'obsnum'
                    AND column_name NOT IN ('cell_name', 'cell_id')
                    ORDER BY column_name
                """).fetchall()
                obs_numerical = [row[0] for row in num_fields]

            # Get obs columns (categorical)
            obs_categorical = []
            obscat_exists = conn.execute("""
                SELECT COUNT(*)
                FROM information_schema.tables
                WHERE table_name = 'obscat'
            """).fetchone()[0]

            if obscat_exists:
                cat_fields = conn.execute("""
                    SELECT column_name
                    FROM information_schema.columns
                    WHERE table_name = 'obscat'
                    AND column_name NOT IN ('cell_name', 'cell_id')
                    ORDER BY column_name
                """).fetchall()
                obs_categorical = [row[0] for row in cat_fields]

            # Get var columns
            var_columns = []
            var_exists = conn.execute("""
                SELECT COUNT(*)
                FROM information_schema.tables
                WHERE table_name = 'var'
            """).fetchone()[0]

            if var_exists:
                var_fields = conn.execute("""
                    SELECT column_name
                    FROM information_schema.columns
                    WHERE table_name = 'var'
                    AND column_name NOT IN ('gene_name', 'gene_id')
                    ORDER BY column_name
                """).fetchall()
                var_columns = [row[0] for row in var_fields]

            # Module scoring availability (queried here to avoid using conn after return)
            module_scoring_available = bool(conn.execute("""
                SELECT COUNT(*) FROM information_schema.tables
                WHERE table_name = '__gene_bins'
            """).fetchone()[0])

        finally:
            self.connection_pool.return_connection(db_url, conn)

        # Resolve annotation with inheritance from ancestor index.md files
        ann = self._resolve_annotations(md_path, file_metadata)

        # Combine metadata with enhanced structure
        metadata = {
            'group_id': extra['group_id'],
            'file_id': extra['file_id'],
            'path': extra['rel_path'],
            'title': file_metadata.get('title', md_path.stem),
            'n_cells': n_cells,
            'n_genes': n_genes,

            # Layers with friendly names
            'layers': layers,

            # Embeddings with friendly names and dimensions
            'embeddings': embeddings,

            # Observation columns
            'obs': {
                'numerical': obs_numerical,
                'categorical': obs_categorical,
                'total': len(obs_numerical) + len(obs_categorical)
            },

            # Variable columns
            'var': {
                'columns': var_columns,
                'total': len(var_columns)
            },

            # File metadata
            'version': file_metadata.get('version'),
            'sha256': file_metadata.get('sha256'),
            'date': file_metadata.get('date'),
            'year': file_metadata.get('year'),
            'default_layer': file_metadata.get('default_layer'),
            'has_lognorm':   file_metadata.get('has_lognorm', True),

            # Biology & study annotation (resolved from .h5ad.mus + .env cascade)
            'organism':         ann.get('organism'),
            'tissue':           ann.get('tissue'),
            'cell_type':        ann.get('cell_type'),
            'celltype':         ann.get('celltype'),          # legacy alias
            'suspension_type':  ann.get('suspension_type'),   # cell | nucleus | na
            'disease':          ann.get('disease'),
            'condition':        ann.get('condition'),
            'region':           ann.get('region'),            # legacy — empty after migration
            'sex':              ann.get('sex'),
            'age':              ann.get('age'),
            'strain':           ann.get('strain'),
            'technology':       ann.get('technology'),
            'technology_category': ann.get('technology_category'),  # legacy
            'accession':        ann.get('accession'),
            'doi':              ann.get('doi') or [],
            'pmid':             ann.get('pmid') or [],
            'link':             ann.get('link') or [],
            'license':          ann.get('license'),
            'contributor':      ann.get('contributor'),
            'year':             ann.get('year') or file_metadata.get('year'),
            'source':           ann.get('source'),            # internal | external
            'access':           ann.get('access'),            # internal | public
            'top_genes':        file_metadata.get('top_genes'),
            'top_cat':          file_metadata.get('top_cat'),
            'top_num':          file_metadata.get('top_num'),

            # Module scoring availability
            'module_scoring_available': module_scoring_available,

            # Raw markdown body (for visualization in the browser)
            'markdown': md_body or None,

            # Layer statistics from .md frontmatter
            'layer_stats': file_metadata.get('layer_stats') or {},
        }

        # Add collection metadata if present
        if collection_metadata:
            metadata['group'] = collection_metadata.get('group')
            metadata['collection'] = {
                'group': collection_metadata.get('group'),
                'experiment': collection_metadata.get('experiment'),
                'authors': collection_metadata.get('authors'),
                'year': collection_metadata.get('year'),
                'default_dataset': collection_metadata.get('default_dataset'),
            }

        return metadata

    def get_gene_list(self, db_id: str) -> List[str]:
        """Get cached gene list for a database (Phase 2 enhancement)"""
        if db_id not in self.gene_list_cache:
            db_url = self.get_database_path(db_id)
            conn = self.connection_pool.get_connection(db_url)
            try:
                result = conn.execute("SELECT gene_name FROM __genes ORDER BY gene_name").fetchall()
                self.gene_list_cache[db_id] = [row[0] for row in result]
            finally:
                self.connection_pool.return_connection(db_url, conn)

        return self.gene_list_cache[db_id]

    def get_database_path(self, db_id: str) -> str:
        """Get path or URL for a database ID"""
        if db_id not in self.databases:
            raise KeyError(f"Database '{db_id}' not found")
        return self.databases[db_id]

    def get_database_metadata(self, db_id: str) -> Dict[str, Any]:
        """Get cached metadata for a database"""
        if db_id not in self.metadata_cache:
            raise KeyError(f"Database '{db_id}' not found")
        return self.metadata_cache[db_id]

    def list_databases(self, force_refresh: bool = False) -> List[Dict[str, Any]]:
        """
        List all databases with metadata

        Args:
            force_refresh: Force reload from disk

        Returns:
            List of database information dictionaries
        """
        if not force_refresh and self._databases_list_cache is not None:
            return self._databases_list_cache

        result = []
        errors = []

        for db_id, db_path in sorted(self.databases.items()):
            try:
                metadata = self.get_database_metadata(db_id)

                db_info = {
                    'id': db_id,
                    **metadata
                }

                result.append(db_info)
            except Exception as e:
                # Skip databases with errors and log them
                errors.append((db_id, str(e)))
                print(f"\n{'='*70}")
                print(f"ERROR: Failed to load database metadata")
                print(f"{'='*70}")
                print(f"Database: {db_id}")
                print(f"Path: {db_path}")
                print(f"Error: {str(e)}")
                print(f"{'='*70}\n")

        # Log summary if there were errors
        if errors:
            print(f"\nWarning: Skipped {len(errors)} database(s) with errors")
            print(f"Successfully loaded {len(result)} database(s)")
            print()

        self._databases_list_cache = result
        return result

    def rescan(self) -> Dict[str, Any]:
        """Force rescan of data folder and reload all metadata"""
        old_count = len(self.databases)
        old_db_ids = set(self.databases.keys())

        print("\nRescanning data folder...")
        self.databases.clear()
        self._db_md_bases.clear()
        self.metadata_cache.clear()
        self._databases_list_cache = None
        self._db_extra.clear()

        # Phase 2: Clear enhanced caches
        self.gene_list_cache.clear()
        self.metadata_stats_cache.clear()

        # Drop the DuckDB connection pool — pooled connections hold the OLD
        # schema after a .duckdb file is replaced (e.g., after ant-convert
        # rebuilds with new obs columns added by ant-score), so any
        # information_schema query against them returns stale column lists.
        # Closing forces fresh connections on next access.
        try:
            self.connection_pool.close_all()
        except Exception as exc:
            print(f"  (connection_pool.close_all failed: {exc})")

        self._scan_databases()
        self._cache_all_metadata(force_reload=True)

        new_db_ids = set(self.databases.keys())
        added = new_db_ids - old_db_ids
        removed = old_db_ids - new_db_ids

        result = {
            'status': 'success',
            'previous_count': old_count,
            'current_count': len(self.databases),
            'added': sorted(list(added)),
            'removed': sorted(list(removed)),
            'databases': sorted(list(new_db_ids))
        }

        print(f"Rescan complete: {old_count} -> {len(self.databases)} databases")
        if added:
            print(f"  Added: {', '.join(added)}")
        if removed:
            print(f"  Removed: {', '.join(removed)}")

        return result

    def get_uptime(self) -> float:
        """Get server uptime in seconds"""
        return time.time() - self._startup_time


# Global registry
registry: Optional[DatabaseRegistry] = None
connection_pool: Optional[ConnectionPool] = None
geneset_registry: Optional[GenesetRegistry] = None

# Reverse index built at startup / rescans:
#   _score_index_by_db[db_id]      = [geneset_id, ...]   (which genesets are scored on this db)
#   _score_index_by_geneset[gid]   = [db_id, ...]        (which dbs have this geneset pre-scored)
# Plus per-(db_id, geneset_id) the actual column name (in case naming convention drifts).
_score_index_by_db: Dict[str, List[str]] = {}
_score_index_by_geneset: Dict[str, List[str]] = {}
_score_columns: Dict[Tuple[str, str], str] = {}    # (db_id, geneset_id) -> column_name


async def _daily_metadata_refresh() -> None:
    """Background task: re-scan and refresh any stale metadata entries once per day."""
    while True:
        await asyncio.sleep(_METADATA_CACHE_TTL_S3)   # 24 h
        print("Daily metadata refresh: scanning for changes...")
        try:
            registry._scan_databases()
            registry._cache_all_metadata(force_reload=False)
        except Exception as exc:
            print(f"Daily metadata refresh error: {exc}")


@asynccontextmanager
async def lifespan(app: FastAPI):
    """Lifespan context manager for startup and shutdown (Phase 2)"""
    # Startup
    global registry, connection_pool
    if registry is None or connection_pool is None:
        print("ERROR: Registry or connection pool not initialized!")
        sys.exit(1)
    asyncio.create_task(_daily_metadata_refresh())
    if geneset_registry is not None:
        try:
            _build_score_index()
            log.info(
                "Module-score index: %d database(s), %d distinct geneset(s)",
                len(_score_index_by_db), len(_score_index_by_geneset),
            )
        except Exception as exc:
            log.warning("Failed to build module-score index: %s", exc)
    log.info("Server startup complete — %d databases", len(registry.databases))
    print("Server startup complete")
    yield
    # Shutdown
    log.info("Server shutting down")
    print("Shutting down...")
    if connection_pool:
        connection_pool.close_all()
    print("Server shutdown complete")


# Create FastAPI app with lifespan handler (Phase 2)
app = FastAPI(
    title="Anthive API",
    description="""
## Anthive REST API v2.0 (Phase 2 - Enhanced Performance)

A high-performance REST API for querying single-cell expression databases.

### Phase 2 Enhancements

* **Connection Pooling**: Reusable database connections for better concurrency
* **Enhanced Caching**: Gene lists and metadata statistics cached
* **Response Compression**: Automatic gzip compression for large responses
* **Performance Metrics**: Track request performance and cache efficiency

### Features

* **Database Discovery**: List and explore available databases
* **Gene Search**: Search for genes by substring matching
