def is_dirty(path: Path) -> bool:
    """True when ``path`` has uncommitted changes in its git repository."""
    result = subprocess.run(['git', '-C', str(path.parent), 'status', '--porcelain', '--', path.name],
                            capture_output=True, text=True)
    return bool(result.stdout.strip())


def stored_columns(duckdb_path: Path) -> set:
    """Obs column names of a .duckdb (empty when unreadable)."""
    if not duckdb_path.exists():
        return set()
    try:
        connection = duckdb.connect(str(duckdb_path), read_only=True)
        try:
            return {row[0] for row in connection.execute(
                "SELECT column_name FROM information_schema.columns "
                "WHERE table_name IN ('__obscat', '__obsnum')").fetchall()}
        finally:
            connection.close()
    except Exception:
        return set()


def decide(entry, md_yaml: Dict, root: Path) -> Tuple[str, Optional[str], str]:
    """``(unit, column, why)`` of one dataset."""
    if entry.db_id in DECISIONS:
        return DECISIONS[entry.db_id]
    api = metadata.get_api_config(md_yaml) or {}
    columns = stored_columns(entry.duckdb_path) | set((api.get('obs_rename') or {}).values()) \
        | set(api.get('obs_derive') or {}) | set(api.get('obs_constant') or {})
    annotation = mus.resolve_annotation(entry.h5ad_path, root=root)
    unit, column = replicates.infer_replicate(annotation, columns)
    why = 'inferred: ' + ('human data with ant_donor' if unit == 'donor' else
                          'animal id column' if unit == 'animal' else 'no replicate column found')
    return unit, column, why


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.split('\n')[0])
    parser.add_argument('--h5adstore-root', default=None)
    parser.add_argument('--dry-run', action='store_true')
    parser.add_argument('--only', default=None, help='comma-separated db_ids')
    parser.add_argument('--date', default=dt.date.today().isoformat())
    args = parser.parse_args()
    from config import get_data_folder  # type: ignore  # noqa: PLC0415
    root = Path(args.h5adstore_root).resolve() if args.h5adstore_root else Path(get_data_folder())
    only = set(args.only.split(',')) if args.only else None
    changed, unchanged, skipped_dirty = 0, 0, []
    undetermined: List[Tuple[str, str]] = []
    counts: Dict[str, int] = {}
    for entry in iter_h5adstore(root):
        if entry.study.startswith('_') or (only and entry.db_id not in only):
            continue
        md_yaml, _ = metadata.parse_md_file(entry.md_path)
        unit, column, why = decide(entry, md_yaml, root)
        counts[unit] = counts.get(unit, 0) + 1
        if unit == 'none':
            undetermined.append((entry.db_id, why))
        if md_yaml.get('replicate_unit') == unit and md_yaml.get('replicate_column') == column:
            unchanged += 1
            continue
        if is_dirty(entry.md_path):
            skipped_dirty.append(entry.db_id)
            continue
        text = entry.md_path.read_text(encoding='utf-8')
        operations = [md_edit.set_top('replicate_unit', unit)]
        operations.append(md_edit.set_top('replicate_column', column) if column
                          else md_edit.delete_path(['replicate_column']))
        operations.append(md_edit.bump_version(
            [f'replicate_unit: {unit}' + (f', replicate_column: {column}' if column else '') + f' ({why})'],
            args.date))
        new_text = md_edit.apply_edits(text, operations)
        if not args.dry_run:
            entry.md_path.write_text(new_text, encoding='utf-8')
        changed += 1
    print(f'changed {changed}, unchanged {unchanged}, units {counts}')
    if skipped_dirty:
        print(f'SKIPPED (uncommitted changes, rerun later): {", ".join(skipped_dirty)}')
    print('UNDETERMINED / none (cell-level, descriptive only):')
    for db_id, why in undetermined:
        print(f'  {db_id}: {why}')
    return 0


if __name__ == '__main__':
    sys.exit(main())
