"""ant-set-replicate: write ``replicate_unit`` / ``replicate_column`` into every dataset .md.

What it does
------------
For each dataset in the h5adstore the replicate unit (donor, animal, sample,
none) and the obs column that identifies a replicate are decided and written
as two top-level keys of the .md front matter (see ``lib/replicates.py``):

* an entry of ``DECISIONS`` (below) wins: datasets whose animal or sample
  column was checked by hand (xenografts, mouse, in vitro, bulk);
* every other dataset gets the inferred default (``replicates.resolve_replicate``):
  ``donor`` / ``ant_donor`` for human data with ``ant_donor``, ``animal`` with an
  animal id column for mouse and xenograft data, otherwise ``none``.

Datasets whose replicate could not be determined get ``none`` with the reason
printed (``UNDETERMINED``): they run as cell-level, descriptive only.

The edit is a verified text edit (``lib/md_edit.py``): only the two keys, the
``version`` patch bump, ``updated`` and one changelog entry change. A file with
uncommitted changes in its git repository is skipped (another job may be editing it).

Usage::

  ant-set-replicate [--h5adstore-root DIR] [--dry-run] [--only G24/MMG,...] [--date YYYY-MM-DD]

Inputs: the .md, .h5ad.mus and .duckdb of every dataset (read only).
Outputs: the .md files (front matter keys above).
"""
from __future__ import annotations

import argparse
import datetime as dt
import subprocess
import sys
from pathlib import Path
from typing import Dict, List, Optional, Tuple

import duckdb

script_dir = Path(__file__).resolve().parent
sys.path.insert(0, str(script_dir.parent.parent / 'lib'))

import md_edit  # type: ignore  # noqa: E402
import metadata  # type: ignore  # noqa: E402
import mus  # type: ignore  # noqa: E402
import replicates  # type: ignore  # noqa: E402
from h5adstore import iter_h5adstore  # type: ignore  # noqa: E402

