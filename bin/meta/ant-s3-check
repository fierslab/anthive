#!/usr/bin/env -S uv run --quiet --script
# /// script
# dependencies = [
#   "boto3>=1.34.0",
#   "pyyaml>=6.0",
# ]
# ///
"""
ant-s3-check - Check S3 availability of DuckDB files

Scans the data folder for .md files and reports whether each corresponding
.duckdb is available locally, on S3, or missing entirely.

Usage:
    ant s3-check [--data-folder PATH]

Example:
    ant s3-check --data-folder ./data
"""

import argparse
import sys
from pathlib import Path
from typing import Optional, Tuple

import yaml

# Add lib directory to path
script_dir = Path(__file__).parent.resolve()
lib_dir = script_dir.parent.parent / 'lib'
sys.path.insert(0, str(lib_dir))

from config import get_config
from md_check import generate_file_id, generate_group_id
from metadata import parse_md_file


def make_s3_client(s3_cfg: dict):
    """Create a boto3 S3 client from the anthive S3 config block"""
    import boto3
    from botocore.config import Config

    kwargs = {}

    endpoint = s3_cfg.get('endpoint')
    if endpoint:
        # boto3 requires a full URL with scheme
        if not endpoint.startswith(('http://', 'https://')):
            endpoint = f"https://{endpoint}"
        kwargs['endpoint_url'] = endpoint

    region = s3_cfg.get('region')
    if region:
        kwargs['region_name'] = region

    access_key = s3_cfg.get('access_key_id')
    secret_key = s3_cfg.get('secret_access_key')
    if access_key and secret_key:
        kwargs['aws_access_key_id'] = access_key
        kwargs['aws_secret_access_key'] = secret_key

    if s3_cfg.get('use_path_style'):
        kwargs['config'] = Config(s3={'addressing_style': 'path'})

    return boto3.client('s3', **kwargs)


def s3_head(client, bucket: str, key: str) -> Optional[int]:
    """
    Check if a key exists in S3.
    Returns file size in bytes if found, None if not found.
    Raises on unexpected errors.
    """
    from botocore.exceptions import ClientError
    try:
        response = client.head_object(Bucket=bucket, Key=key)
        return response.get('ContentLength')
    except ClientError as error:
        code = error.response['Error']['Code']
        if code in ('404', 'NoSuchKey'):
            return None
        raise


def build_s3_key(prefix: str, duckdb_rel: Path) -> str:
    """Build the S3 key for a relative .duckdb path"""
    prefix = (prefix or '').strip('/')
    if prefix:
        return f"{prefix}/{duckdb_rel}"
    return str(duckdb_rel)


def resolve_db_id(md_path: Path, rel_path: Path) -> Tuple[str, str, str]:
    """Compute (db_id, group_id, file_id) from .md files"""
    top_level = rel_path.parts[0] if len(rel_path.parts) > 1 else rel_path.stem

    index_meta, _ = parse_md_file(md_path.parent / 'index.md')
    group_id = str(index_meta.get('group_id') or '').strip() or generate_group_id(top_level)

    data_meta, _ = parse_md_file(md_path)
    file_id = str(data_meta.get('id') or '').strip() or generate_file_id(rel_path.stem)

    return f"{group_id}/{file_id}", group_id, file_id


def format_size(n_bytes: Optional[int]) -> str:
    """Human-readable file size"""
    if n_bytes is None:
        return ''
    for unit in ('B', 'KB', 'MB', 'GB', 'TB'):
        if n_bytes < 1024:
            return f"{n_bytes:.0f} {unit}"
        n_bytes /= 1024
    return f"{n_bytes:.1f} PB"


def scan_md_files(scan_root: Path, base: Path):
    """Yield (md_path, rel_path) for all non-index .md files under scan_root.
    rel_path is always relative to base (the data folder root) so S3 keys stay correct."""
    def _recurse(path: Path):
        try:
            for item in sorted(path.iterdir()):
                resolved = item.resolve()
                if resolved.is_file() and resolved.suffix == '.md' and resolved.name != 'index.md':
                    try:
                        yield resolved, item.relative_to(base)
                    except ValueError:
                        pass
                elif resolved.is_dir():
                    yield from _recurse(item)
        except (PermissionError, OSError):
            pass

    yield from _recurse(scan_root)


def main():
    parser = argparse.ArgumentParser(
        description="Check S3 availability of DuckDB files",
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument(
        '--data-folder',
        type=Path,
        default=Path('./data'),
        help='Path to data folder (default: ./data)'
    )
    parser.add_argument(
        'subfolder',
        nargs='?',
        default=None,
        help='Optional subfolder to scan (relative to data folder, e.g. G24)'
    )
    parser.add_argument(
        '--require-s3',
        action='store_true',
        help='Treat local-only databases (no S3 copy) as errors and exit 1'
    )
    args = parser.parse_args()

    config = get_config()
    s3_cfg = config.get('s3') or {}
    bucket = s3_cfg.get('bucket')
    prefix = (s3_cfg.get('prefix') or '').strip('/')

    data_folder = args.data_folder.resolve()
    if not data_folder.exists():
        print(f"Error: data folder not found: {data_folder}", file=sys.stderr)
        sys.exit(1)

    # Narrow scan to a subfolder if specified
    scan_root = data_folder
    if args.subfolder:
        scan_root = data_folder / args.subfolder
        if not scan_root.exists():
            print(f"Error: subfolder not found: {scan_root}", file=sys.stderr)
            sys.exit(1)

    if not bucket:
        print("No S3 bucket configured (s3.bucket is not set in anthive.yaml).")
        print("S3 check skipped — only local status will be shown.")
        print()

    # Set up S3 client if bucket is configured
    s3_client = None
    if bucket:
        try:
            s3_client = make_s3_client(s3_cfg)
            # Quick connectivity test
            s3_client.head_bucket(Bucket=bucket)
            endpoint_label = s3_cfg.get('endpoint') or 'AWS S3'
            print(f"Connected to S3: {endpoint_label}, bucket: {bucket}")
            if prefix:
                print(f"Prefix: {prefix}")
        except Exception as error:
            print(f"Warning: could not connect to S3: {error}", file=sys.stderr)
            s3_client = None

    scan_label = str(scan_root) if scan_root == data_folder else f"{data_folder} (subfolder: {args.subfolder})"
    print(f"Scanning: {scan_label}")
    print()

    # Column widths
    id_width  = 36
    loc_width = 12   # "✓ 150.0 GB" = 11 chars
    s3_width  = 14   # same + "(not checked)" = 13 chars
    sep = ' | '
    header = (
        f"{'Database ID':<{id_width}}{sep}"
        f"{'Local':>{loc_width}}{sep}"
        f"{'S3':>{s3_width}}{sep}"
        f"Status"
    )
    divider = (
        f"{'-' * id_width}-+-"
        f"{'-' * loc_width}-+-"
        f"{'-' * s3_width}-+-"
        f"{'-' * 20}"
    )
    print(header)
    print(divider)

    n_local_only = 0
    n_s3_only = 0
    n_both = 0
    n_missing = 0
    n_total = 0

    for md_path, rel_path in scan_md_files(scan_root, data_folder):
        n_total += 1

        db_id, _, _ = resolve_db_id(md_path, rel_path)
        duckdb_rel = rel_path.with_suffix('.duckdb')
        local_duckdb = md_path.with_suffix('.duckdb')

        has_local = local_duckdb.exists()
        local_size = local_duckdb.stat().st_size if has_local else None

        s3_size: Optional[int] = None
        s3_checked = False
        if s3_client and bucket:
            s3_key = build_s3_key(prefix, duckdb_rel)
            try:
                s3_size = s3_head(s3_client, bucket, s3_key)
                s3_checked = True
            except Exception as error:
                s3_size = None
                s3_checked = False

        # Determine status
        if has_local and (s3_size is not None):
            status = 'ok (local + S3)'
            n_both += 1
        elif has_local:
            if s3_checked and args.require_s3:
                status = '*** NO S3 BACKUP ***'
                n_missing += 1
            else:
                status = 'ok (local only)' if s3_checked else 'local only'
                n_local_only += 1
        elif s3_size is not None:
            status = 'ok (S3 fallback)'
            n_s3_only += 1
        else:
            status = '*** MISSING ***'
            n_missing += 1

        if has_local and local_size is not None:
            local_col = f"✓ {format_size(local_size):>8}"
        else:
            local_col = '✓' if has_local else '✗'

        if not s3_checked:
            s3_col = '(not checked)'
        elif s3_size is not None:
            s3_col = f"✓ {format_size(s3_size):>8}"
        else:
            s3_col = '✗'

        db_id_display = db_id if len(db_id) <= id_width else db_id[:id_width - 1] + '…'
        print(
            f"{db_id_display:<{id_width}}{sep}"
            f"{local_col:>{loc_width}}{sep}"
            f"{s3_col:>{s3_width}}{sep}"
            f"{status}"
        )

    print()
    print(f"Total: {n_total} dataset(s)")
    if s3_client:
        print(f"  Local + S3 : {n_both}")
        print(f"  Local only : {n_local_only}")
        print(f"  S3 only    : {n_s3_only}")
        if n_missing:
            if args.require_s3:
                print(f"  Errors     : {n_missing}  ← missing S3 copy or no .duckdb at all")
            else:
                print(f"  Missing    : {n_missing}  ← no .duckdb found locally or on S3")
    else:
        n_local = n_local_only + n_both
        print(f"  With local .duckdb : {n_local}")
        print(f"  No local .duckdb   : {n_total - n_local}")

    if n_missing:
        sys.exit(1)


if __name__ == '__main__':
    main()
