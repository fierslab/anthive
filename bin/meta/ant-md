from obscol_tags import (
    ObsColTagError, known_tags, tag_description,
    validate_obs_tags, get_columns_by_tag,
)


def parse_assignment(arg: str) -> tuple[str, str]:
    """Parse key=value string, handling quoted values"""
    if '=' not in arg:
        return None, None

    key, value = arg.split('=', 1)
    key = key.strip()

    # Remove quotes from value if present
    value = value.strip()
    if (value.startswith('"') and value.endswith('"')) or \
       (value.startswith("'") and value.endswith("'")):
        value = value[1:-1]

    # Try to convert to appropriate type
    if value.lower() == 'true':
        value = True
    elif value.lower() == 'false':
        value = False
    elif value.lower() == 'null':
        value = None
    elif value.isdigit():
        value = int(value)
    elif value.replace('.', '', 1).isdigit():
        try:
            value = float(value)
        except ValueError:
            pass

    return key, value


def _apply_updates_to_file(file_path: Path, updates: dict) -> int:
    """Apply key=value updates to a single .md file. Returns 0 on success, 1 on error."""
    if not file_path.exists():
        print(f"Error: File not found: {file_path}", file=sys.stderr)
        return 1

    try:
        metadata, body = parse_md_file(file_path)
    except Exception as e:
        print(f"Error reading file: {e}", file=sys.stderr)
        return 1

    for key, value in updates.items():
        if key.startswith('annotation.') or key in ANNOTATION_FIELDS:
            # POST-2026-06: annotation fields no longer live in .md frontmatter.
            # Direct the user at the new location instead of silently writing
            # to the wrong place.
            print(
                f"ERROR: '{key}' is an experimental annotation field. After the "
                f"2026-06 h5adstore migration these live in `<basename>.h5ad.mus` "
                f"sidecars + folder `.env` cascade — not in `.md` frontmatter.\n"
                f"  Use the `mus` CLI instead:\n"
                f"    mus -C <folder> config set {key.split('.', 1)[-1]} {value!r}\n"
                f"  Or edit the sidecar directly. See data/h5adstore/CONVENTIONS.md.",
                file=sys.stderr,
            )
            return 1
        else:
            metadata[key] = value
            print(f"Set {key} = {repr(value)}")

    try:
        write_md_file(file_path, metadata, body)
        print(f"✓ Updated {file_path}")
        return 0
    except Exception as e:
        print(f"Error writing file: {e}", file=sys.stderr)
        return 1


def cmd_set(args: list[str]) -> int:
    """Set metadata fields"""
    if len(args) < 1:
        print("Error: Usage: ant md set key=value [key=value ...] FILE", file=sys.stderr)
        return 1

    # Determine if last arg is a file path or another key=value
    if all('=' in a for a in args):
        # All args are assignments — read file paths from stdin
        if sys.stdin.isatty():
            print("Error: no FILE given and stdin is a terminal", file=sys.stderr)
            return 1
        file_paths = [Path(line.strip()) for line in sys.stdin if line.strip()]
        assignments = args
    else:
        file_paths = [Path(args[-1])]
        assignments = args[:-1]

    if not assignments:
        print("Error: Usage: ant md set key=value [key=value ...] FILE", file=sys.stderr)
        return 1

    # Parse assignments once
    updates = {}
    for assignment in assignments:
        key, value = parse_assignment(assignment)
        if key is None:
            print(f"Error: Invalid assignment: {assignment}", file=sys.stderr)
            print("Expected format: key=value", file=sys.stderr)
            return 1
        updates[key] = value

    # Apply to each file
    exit_code = 0
    for file_path in file_paths:
        result = _apply_updates_to_file(file_path, updates)
        if result != 0:
            exit_code = result

    return exit_code


def cmd_get(args: list[str]) -> int:
    """Get metadata fields"""
    if len(args) < 2:
        print("Error: Usage: ant md get key [key ...] FILE", file=sys.stderr)
        return 1

    file_path = Path(args[-1])
    keys = args[:-1]

    if not file_path.exists():
        print(f"Error: File not found: {file_path}", file=sys.stderr)
        return 1

    # Read metadata
    try:
        metadata, _ = parse_md_file(file_path)
    except Exception as e:
        print(f"Error reading file: {e}", file=sys.stderr)
        return 1

    # Get values
    for key in keys:
        if key in ANNOTATION_FIELDS:
            # Check annotation subkey first, then fall back to root
            ann = metadata.get('annotation') or {}
            value = ann.get(key)
            if value is None:
                value = metadata.get(key)
        else:
            value = metadata.get(key)
        if value is None:
            print(f"{key}: (not set)")
        else:
            print(f"{key}: {value}")

    return 0


def cmd_show(args: list[str]) -> int:
    """Show all metadata"""
    if len(args) != 1:
        print("Error: Usage: ant md show FILE", file=sys.stderr)
        return 1

    file_path = Path(args[0])

    if not file_path.exists():
        print(f"Error: File not found: {file_path}", file=sys.stderr)
        return 1

    # Read metadata
    try:
        metadata, body = parse_md_file(file_path)
    except Exception as e:
        print(f"Error reading file: {e}", file=sys.stderr)
        return 1

    if not metadata:
        print("(no metadata)")
        return 0

    # Print metadata
    print(f"Metadata in {file_path}:")
    print()
    for key, value in metadata.items():
        print(f"  {key}: {value}")

    return 0


def _delete_keys_from_file(file_path: Path, keys: list[str]) -> int:
    """Delete metadata keys from a single .md file. Returns 0 on success, 1 on error."""
    if not file_path.exists():
        print(f"Error: File not found: {file_path}", file=sys.stderr)
        return 1

    try:
        metadata, body = parse_md_file(file_path)
    except Exception as e:
        print(f"Error reading file: {e}", file=sys.stderr)
        return 1

    deleted = []
    for key in keys:
        if key in ANNOTATION_FIELDS:
            ann = metadata.get('annotation')
            if isinstance(ann, dict) and key in ann:
                del ann[key]
                deleted.append(f"annotation.{key}")
            elif key in metadata:
                del metadata[key]
                deleted.append(key)
            else:
                print(f"Warning: {key} not found", file=sys.stderr)
        elif key.startswith('annotation.'):
            ann_key = key[len('annotation.'):]
            ann = metadata.get('annotation')
            if isinstance(ann, dict) and ann_key in ann:
                del ann[ann_key]
                deleted.append(key)
            else:
                print(f"Warning: {key} not found", file=sys.stderr)
        else:
            if key in metadata:
                del metadata[key]
                deleted.append(key)
            else:
                print(f"Warning: {key} not found", file=sys.stderr)

    if not deleted:
        print(f"Nothing to delete in {file_path}")
        return 0

    for key in deleted:
        print(f"Deleted {key}")

    try:
        write_md_file(file_path, metadata, body)
        print(f"✓ Updated {file_path}")
        return 0
    except Exception as e:
        print(f"Error writing file: {e}", file=sys.stderr)
        return 1


def cmd_delete(args: list[str]) -> int:
    """Delete metadata fields"""
    if len(args) < 1:
        print("Error: Usage: ant md delete key [key ...] FILE", file=sys.stderr)
        return 1

    # Stdin support: if last arg looks like a key (no path separator, no .md), read files from stdin
    if not args[-1].endswith('.md') and not Path(args[-1]).exists():
        if sys.stdin.isatty():
            print("Error: no FILE given and stdin is a terminal", file=sys.stderr)
            return 1
        file_paths = [Path(line.strip()) for line in sys.stdin if line.strip()]
        keys = args
    else:
        file_paths = [Path(args[-1])]
        keys = args[:-1]

    if not keys:
        print("Error: Usage: ant md delete key [key ...] FILE", file=sys.stderr)
        return 1

    exit_code = 0
    for file_path in file_paths:
        result = _delete_keys_from_file(file_path, keys)
        if result != 0:
            exit_code = result
    return exit_code



def _move_items(metadata: dict, items: list[str],
                include_key: str, exclude_key: str,
                direction: str) -> tuple[list[str], list[str]]:
    """Move items between an include list and an exclude list.

    direction: 'exclude' moves items → exclude_key (removes from include_key)
               'include' moves items → include_key (removes from exclude_key)

    Returns:
        (moved, not_found) — names that were moved, names not present anywhere
    """
    inc = metadata.setdefault(include_key, [])
    exc = metadata.setdefault(exclude_key, [])

    moved = []
    not_found = []

    for item in items:
        if direction == 'exclude':
            if item in inc:
                inc.remove(item)
            if item not in exc:
                exc.append(item)
            moved.append(item)
        else:  # include
            if item in exc:
                exc.remove(item)
            if item not in inc:
                inc.append(item)
            moved.append(item)

    return moved, not_found


def _cmd_layer(args: list[str], direction: str) -> int:
    """Shared implementation for exclude-layer / include-layer."""
    if len(args) < 2:
        print(f"Error: Usage: ant md {direction}-layer LAYER [LAYER ...] FILE",
              file=sys.stderr)
        return 1

    file_path = Path(args[-1])
    items = args[:-1]

    if not file_path.exists():
        print(f"Error: File not found: {file_path}", file=sys.stderr)
        return 1

    try:
        metadata, body = parse_md_file(file_path)
    except Exception as e:
        print(f"Error reading file: {e}", file=sys.stderr)
        return 1

    moved, _ = _move_items(metadata, items, 'layers_include', 'layers_exclude', direction)

    target = 'layers_exclude' if direction == 'exclude' else 'layers_include'
    for name in moved:
        print(f"  → {name}  added to {target}")

    try:
        write_md_file(file_path, metadata, body)
        print(f"\n✓ Updated {file_path}")
        return 0
    except Exception as e:
        print(f"Error writing file: {e}", file=sys.stderr)
        return 1


def cmd_exclude_layer(args: list[str]) -> int:
    """Move layer(s) from layers_include to layers_exclude"""
    return _cmd_layer(args, 'exclude')


def cmd_include_layer(args: list[str]) -> int:
    """Move layer(s) from layers_exclude to layers_include"""
    return _cmd_layer(args, 'include')


