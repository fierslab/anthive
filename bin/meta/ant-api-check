"""
ant-api-check - Validate REST API endpoints and data integrity

Tests REST API endpoints and optionally compares API responses with h5ad file
for deep data integrity validation.

Usage:
    ant api-check http://localhost:8080 mydb
    ant api-check http://localhost:8080 mydb --deep dataset.h5ad
"""

import argparse
import sys
import time
from pathlib import Path
from typing import Dict, List, Any, Optional
from urllib.parse import quote

import requests


class APICheckReport:
    """Accumulator for API check results"""
    def __init__(self):
        self.endpoint_failures = []
        self.data_mismatches = []
        self.performance_warnings = []
        self.info = []
        self.tests_passed = 0
        self.tests_failed = 0

    def has_errors(self) -> bool:
        """Check if there are any errors"""
        return len(self.endpoint_failures) > 0 or len(self.data_mismatches) > 0

    def has_warnings(self) -> bool:
        """Check if there are any warnings"""
        return len(self.performance_warnings) > 0

    def print_summary(self):
        """Print summary of findings"""
        if not self.has_errors() and not self.has_warnings() and not self.info:
            return

        print("\nCheck Summary:")
        print()

        # Errors
        if self.endpoint_failures:
            print("✗ Endpoint failures:")
            for failure in self.endpoint_failures:
                print(f"  - {failure}")
            print()

        if self.data_mismatches:
            print("✗ Data integrity mismatches:")
            # Show first 20 mismatches, summarize rest
            for msg in self.data_mismatches[:20]:
                print(f"  - {msg}")
            if len(self.data_mismatches) > 20:
                print(f"  ... and {len(self.data_mismatches) - 20} more mismatches")
            print()

        # Warnings
        if self.performance_warnings:
            print("⚠ Performance warnings:")
            for warning in self.performance_warnings:
                print(f"  - {warning}")
            print()

        # Info
        if self.info:
            for info in self.info:
                print(f"ℹ {info}")
            print()


def test_endpoint(url: str, description: str, report: APICheckReport, timeout: int = 30) -> Optional[Any]:
    """Test an API endpoint

    Args:
        url: Full URL to test
        description: Description of the test
        report: Check report
        timeout: Request timeout in seconds

    Returns:
        Response JSON if successful, None otherwise
    """
    try:
        start_time = time.time()
        response = requests.get(url, timeout=timeout)
        elapsed = time.time() - start_time

        if response.status_code != 200:
            report.endpoint_failures.append(
                f"{description}: HTTP {response.status_code}"
            )
            report.tests_failed += 1
            return None

        # Check response time
        if elapsed > 5.0:
            report.performance_warnings.append(
                f"{description}: slow response ({elapsed:.1f}s)"
            )

        report.tests_passed += 1
        return response.json()

    except requests.exceptions.Timeout:
        report.endpoint_failures.append(f"{description}: timeout after {timeout}s")
        report.tests_failed += 1
        return None
    except requests.exceptions.RequestException as e:
        report.endpoint_failures.append(f"{description}: {str(e)}")
        report.tests_failed += 1
        return None
    except Exception as e:
        report.endpoint_failures.append(f"{description}: unexpected error: {str(e)}")
        report.tests_failed += 1
        return None


def test_post_endpoint(url: str, description: str, json_body: Dict, report: APICheckReport, timeout: int = 30) -> Optional[Any]:
    """Test a POST API endpoint

    Args:
        url: Full URL to test
        description: Description of the test
        json_body: JSON body to send
        report: Check report
        timeout: Request timeout in seconds

    Returns:
        Response JSON if successful, None otherwise
    """
    try:
        start_time = time.time()
        response = requests.post(url, json=json_body, timeout=timeout)
        elapsed = time.time() - start_time

        if response.status_code != 200:
            report.endpoint_failures.append(
                f"{description}: HTTP {response.status_code}"
            )
            report.tests_failed += 1
            return None

        if elapsed > 5.0:
            report.performance_warnings.append(
                f"{description}: slow response ({elapsed:.1f}s)"
            )

        report.tests_passed += 1
        return response.json()

    except requests.exceptions.Timeout:
        report.endpoint_failures.append(f"{description}: timeout after {timeout}s")
        report.tests_failed += 1
        return None
    except requests.exceptions.RequestException as e:
        report.endpoint_failures.append(f"{description}: {str(e)}")
        report.tests_failed += 1
        return None
    except Exception as e:
        report.endpoint_failures.append(f"{description}: unexpected error: {str(e)}")
        report.tests_failed += 1
        return None


def check_basic_endpoints(base_url: str, report: APICheckReport):
    """Check basic API endpoints

    Args:
        base_url: Base API URL
        report: Check report
    """
    print("\n[1/3] Testing basic endpoints...")

    # Test root endpoint
    result = test_endpoint(f"{base_url}/", "GET /", report)
    if result:
        print(f"  ✓ Root endpoint: API version {result.get('version', 'unknown')}")
    else:
        print(f"  ✗ Root endpoint failed")

    # Test health endpoint
    result = test_endpoint(f"{base_url}/health", "GET /health", report)
    if result:
        print(f"  ✓ Health check: {result.get('status', 'unknown')}")
    else:
        print(f"  ✗ Health check failed")

    # Test metrics endpoint
    result = test_endpoint(f"{base_url}/metrics", "GET /metrics", report)
    if result:
        print(f"  ✓ Metrics endpoint")
    else:
        print(f"  ✗ Metrics endpoint failed")

    # Test databases list endpoint
    result = test_endpoint(f"{base_url}/databases", "GET /databases", report)
    if result:
        databases = result.get('databases', result if isinstance(result, list) else [])
        print(f"  ✓ Databases list: {len(databases)} database(s)")
    else:
        print(f"  ✗ Databases list failed")


def check_database_endpoints(base_url: str, db_id: str, report: APICheckReport) -> Optional[Dict]:
    """Check database-specific endpoints

    Args:
        base_url: Base API URL
        db_id: Database ID
        report: Check report

    Returns:
        Database info dict if successful, None otherwise
    """
    print(f"\n[2/3] Testing database endpoints for '{db_id}'...")

    # Test database info
    result = test_endpoint(
        f"{base_url}/databases/{db_id}/info",
        f"GET /databases/{db_id}/info",
        report
    )
    if result:
        print(f"  ✓ Database info: {result.get('n_cells', 0):,} cells, {result.get('n_genes', 0):,} genes")
        db_info = result
    else:
        print(f"  ✗ Database info failed")
        return None

    # Test gene search
    genes_result = test_endpoint(
        f"{base_url}/databases/{db_id}/genes?q=&limit=10",
        f"GET /databases/{db_id}/genes",
        report
    )
    if genes_result:
        num_genes = genes_result.get('count', len(genes_result.get('genes', [])))
        print(f"  ✓ Gene search: returned {num_genes} genes")
    else:
        print(f"  ✗ Gene search failed")

    # Test specific gene lookup (use first gene from search result)
    first_gene = (genes_result or {}).get('genes', [None])[0] if genes_result else None
    if first_gene:
        gene_name = first_gene if isinstance(first_gene, str) else first_gene.get('gene_name', '')
        result = test_endpoint(
            f"{base_url}/databases/{db_id}/genes/{quote(gene_name, safe='')}",
            f"GET /databases/{db_id}/genes/{{gene_id}}",
            report
        )
        if result:
            print(f"  ✓ Gene info: '{gene_name}'")
        else:
            print(f"  ✗ Gene info failed")
    else:
        print(f"  ℹ Gene info: skipped (no genes available)")

    # Test layers endpoint
    result = test_endpoint(
        f"{base_url}/databases/{db_id}/layers",
        f"GET /databases/{db_id}/layers",
        report
    )
    if result:
        layers = result.get('layers', {})
        print(f"  ✓ Layers endpoint: {len(layers)} layers")
    else:
        print(f"  ✗ Layers endpoint failed")

    # Test embeddings endpoint
    embeddings_result = test_endpoint(
        f"{base_url}/databases/{db_id}/embeddings",
        f"GET /databases/{db_id}/embeddings",
        report
    )
    if embeddings_result:
        embeddings = embeddings_result.get('embeddings', {})
        print(f"  ✓ Embeddings endpoint: {len(embeddings)} embeddings")
    else:
        embeddings = {}
        print(f"  ✗ Embeddings endpoint failed")

    # Test specific embedding (use first embedding from list)
    first_embedding_key = next(iter(embeddings), None)
    if first_embedding_key:
        result = test_endpoint(
            f"{base_url}/databases/{db_id}/embeddings/{quote(first_embedding_key, safe='')}?limit=1",
            f"GET /databases/{db_id}/embeddings/{{embedding_id}}",
            report
        )
        if result:
            print(f"  ✓ Embedding data: '{first_embedding_key}'")
        else:
            print(f"  ✗ Embedding data failed")
    else:
        print(f"  ℹ Embedding data: skipped (no embeddings available)")

    # Test cells endpoint (with limit)
    result = test_endpoint(
        f"{base_url}/databases/{db_id}/cells?limit=10",
        f"GET /databases/{db_id}/cells",
        report
    )
    if result:
        n_cells = result.get('n_cells', 0)
        print(f"  ✓ Cells endpoint: returned {n_cells} cells")
    else:
        print(f"  ✗ Cells endpoint failed")

    # Test metadata fields endpoint
    result = test_endpoint(
        f"{base_url}/databases/{db_id}/metadata/fields",
        f"GET /databases/{db_id}/metadata/fields",
        report
    )
    if result:
        obs_fields = result.get('obs', {})
        total_fields = obs_fields.get('total', 0) if isinstance(obs_fields, dict) else 0
        print(f"  ✓ Metadata fields: {total_fields} obs field(s)")
    else:
        print(f"  ✗ Metadata fields failed")

    # Test SQL query endpoint
    result = test_post_endpoint(
        f"{base_url}/databases/{db_id}/query/sql",
        f"POST /databases/{db_id}/query/sql",
        {"query": "SELECT COUNT(*) AS n FROM __cells"},
        report
    )
    if result:
        print(f"  ✓ SQL query: executed successfully")
    else:
        print(f"  ✗ SQL query failed")

    return db_info


def deep_check_api_data(base_url: str, db_id: str, h5ad_path: Path, db_info: Dict, report: APICheckReport):
    """Deep check: Compare API responses with h5ad file data

    Args:
        base_url: Base API URL
        db_id: Database ID
        h5ad_path: Path to h5ad file
        db_info: Database info from API
        report: Check report
    """
    import numpy as np
    import scipy.sparse

    print("\n" + "="*70)
    print("DEEP DATA INTEGRITY CHECKS")
    print("="*70)
    print(f"\nLoading h5ad file: {h5ad_path.name}")

    # Add lib directory to path
    import sys
    from pathlib import Path
    script_dir = Path(__file__).parent.resolve()
    lib_dir = script_dir.parent.parent / 'lib'
    sys.path.insert(0, str(lib_dir))

    try:
        from h5ad_utils import load_h5ad
    except ImportError:
        report.endpoint_failures.append("Cannot perform deep checks: h5ad_utils not available")
        return

    # Load h5ad file
    try:
        adata = load_h5ad(h5ad_path)
        print(f"  ✓ Loaded ({adata.n_obs:,} cells × {adata.n_vars:,} genes)")
    except Exception as e:
        report.endpoint_failures.append(f"Cannot load h5ad file for deep checks: {e}")
        return

    # Get layers from API
    layers_response = requests.get(f"{base_url}/databases/{db_id}/layers").json()
    layers = layers_response.get('layers', {})

    if not layers:
        print("\n  ℹ No layers to check")
    else:
        print(f"\n[Deep Check] Verifying layer expression values via API...")
        deep_check_layers_api(base_url, db_id, adata, layers, report, num_samples=50)

    # Check obs data
    print(f"\n[Deep Check] Verifying obs data via API...")
    deep_check_obs_api(base_url, db_id, adata, report, num_samples=50)

    # Check embeddings
    embeddings_response = requests.get(f"{base_url}/databases/{db_id}/embeddings").json()
    embeddings = embeddings_response.get('embeddings', {})

    if embeddings:
        print(f"\n[Deep Check] Verifying embeddings via API...")
        deep_check_embeddings_api(base_url, db_id, adata, embeddings, report, num_samples=50)


def deep_check_layers_api(base_url: str, db_id: str, adata, layers: Dict, report: APICheckReport, num_samples: int = 50):
    """Deep check layers via API

    Args:
        base_url: Base API URL
        db_id: Database ID
        adata: AnnData object
        layers: Dict of layer names from API
        report: Check report
        num_samples: Number of genes to sample
    """
    import numpy as np
    import scipy.sparse

    for layer_key in layers.keys():
        # Get layer data from h5ad
        if layer_key == 'X':
            if adata.X is None:
                print(f"  ⚠ Layer {layer_key}: not present in h5ad, skipping")
                continue
            layer_data = adata.X
        else:
            if layer_key not in adata.layers:
                print(f"  ⚠ Layer {layer_key}: not present in h5ad, skipping")
                continue
            layer_data = adata.layers[layer_key]

        # Sample genes
        n_genes = min(num_samples, adata.n_vars)
        if n_genes == 0:
            print(f"  ⚠ Layer {layer_key}: no genes to sample")
            continue

        gene_indices = np.random.choice(adata.n_vars, size=n_genes, replace=False)

        mismatches = 0
        checks = 0
        api_errors = 0

        for gene_idx in gene_indices:
            gene_name = adata.var_names[gene_idx]

            # Get values from h5ad
            if scipy.sparse.issparse(layer_data):
                h5ad_values = layer_data[:, gene_idx].toarray().flatten()
            else:
                h5ad_values = layer_data[:, gene_idx].flatten()

            # Get values from API
            try:
                url = f"{base_url}/databases/{db_id}/cells?genes={gene_name}&layer={layer_key}"
                response = requests.get(url, timeout=30)

                if response.status_code != 200:
                    api_errors += 1
                    if api_errors <= 3:
                        report.data_mismatches.append(
                            f"Layer {layer_key}, gene '{gene_name}': API returned HTTP {response.status_code}"
                        )
                    continue

                api_data = response.json()

                # Check if we got data
                if not api_data.get('data'):
                    api_errors += 1
                    if api_errors <= 3:
                        report.data_mismatches.append(
                            f"Layer {layer_key}, gene '{gene_name}': API returned empty data"
                        )
                    continue

                # Build dict of cell_name -> value, handling None values
                api_values_dict = {}
                for row in api_data['data']:
                    cell_name = row.get('cell_name')
                    gene_val = row.get(gene_name)
                    # Convert None to 0.0 for comparison
                    api_values_dict[cell_name] = 0.0 if gene_val is None else float(gene_val)

                # Compare with h5ad (sample first 100 cells to keep it fast)
                sample_size = min(100, adata.n_obs)
                sample_indices = np.random.choice(adata.n_obs, size=sample_size, replace=False)

                cell_mismatches = 0
                for cell_idx in sample_indices:
                    cell_name = adata.obs_names[cell_idx]
                    h5ad_val = float(h5ad_values[cell_idx])
                    api_val = api_values_dict.get(cell_name, 0.0)

                    if not np.isclose(h5ad_val, api_val, rtol=1e-5, atol=1e-8):
                        cell_mismatches += 1
                        if mismatches <= 3:  # Only report first few
                            report.data_mismatches.append(
                                f"Layer {layer_key}, gene '{gene_name}', cell '{cell_name}': h5ad={h5ad_val:.6f}, api={api_val:.6f}"
                            )

                if cell_mismatches > 0:
                    mismatches += 1

                checks += 1

            except Exception as e:
                api_errors += 1
                if api_errors <= 3:
                    report.data_mismatches.append(
                        f"Layer {layer_key}, gene '{gene_name}': Exception: {type(e).__name__}: {str(e)}"
                    )

        # Report results
        if checks == 0:
            print(f"  ✗ Layer {layer_key}: 0 genes checked (all failed), {api_errors} API errors")
            report.tests_failed += 1
        elif mismatches == 0 and api_errors == 0:
            print(f"  ✓ Layer {layer_key}: {checks} genes checked, all match")
            report.tests_passed += 1
        else:
            print(f"  ✗ Layer {layer_key}: {checks} genes checked, {mismatches} with data mismatches, {api_errors} API errors")
            report.tests_failed += 1


def deep_check_obs_api(base_url: str, db_id: str, adata, report: APICheckReport, num_samples: int = 50):
    """Deep check obs data via API

    Args:
        base_url: Base API URL
        db_id: Database ID
        adata: AnnData object
        report: Check report
        num_samples: Number of cells to sample
    """
    import numpy as np
    import pandas as pd

    # Sample cells
    n_cells = min(num_samples, adata.n_obs)
    cell_indices = np.random.choice(adata.n_obs, size=n_cells, replace=False)
    cell_names = [adata.obs_names[i] for i in cell_indices]

    # Get obs columns to check (first few numerical and categorical)
    obs_cols = list(adata.obs.columns[:10])  # Check first 10 columns

    if not obs_cols:
        print("  ℹ No obs columns to check")
        return

    try:
        # Request cells with metadata
        url = f"{base_url}/databases/{db_id}/cells?metadata=*&limit={n_cells}"
        response = requests.get(url, timeout=30)

        if response.status_code != 200:
            report.data_mismatches.append(f"Obs data: API returned {response.status_code}")
            report.tests_failed += 1
            return

        api_data = response.json()
        api_rows = {row['cell_name']: row for row in api_data['data']}

        mismatches = 0
        checks = 0

        for cell_name in cell_names:
            if cell_name not in api_rows:
                continue

            api_row = api_rows[cell_name]

            for col in obs_cols:
                if col not in adata.obs.columns:
                    continue

                h5ad_value = adata.obs.loc[cell_name, col]
                api_value = api_row.get(col)

                # Skip if column not in API response
                if api_value is None and col not in api_row:
                    continue

                # Handle NaN comparison
                if pd.isna(h5ad_value) and (api_value is None or pd.isna(api_value)):
                    checks += 1
                    continue

                # Numerical comparison
                if pd.api.types.is_numeric_dtype(type(h5ad_value)):
                    if not np.isclose(h5ad_value, api_value, rtol=1e-5, atol=1e-8, equal_nan=True):
                        mismatches += 1
                        if mismatches <= 3:
                            report.data_mismatches.append(
                                f"Obs: cell '{cell_name}', col '{col}': h5ad={h5ad_value}, api={api_value}"
                            )
                # String comparison
                else:
                    if str(h5ad_value) != str(api_value):
                        mismatches += 1
                        if mismatches <= 3:
                            report.data_mismatches.append(
                                f"Obs: cell '{cell_name}', col '{col}': h5ad='{h5ad_value}', api='{api_value}'"
                            )

                checks += 1

        if mismatches == 0:
            print(f"  ✓ Obs data: {checks} values checked, all match")
            report.tests_passed += 1
        else:
            print(f"  ✗ Obs data: {mismatches} mismatches found in {checks} values")
            report.tests_failed += 1

    except Exception as e:
        report.data_mismatches.append(f"Obs data: API error: {str(e)}")
        report.tests_failed += 1


def deep_check_embeddings_api(base_url: str, db_id: str, adata, embeddings: Dict, report: APICheckReport, num_samples: int = 50):
    """Deep check embeddings via API

    Args:
        base_url: Base API URL
        db_id: Database ID
        adata: AnnData object
        embeddings: Dict of embeddings from API
        report: Check report
        num_samples: Number of cells to sample
    """
    import numpy as np
    import pandas as pd

    for emb_key, emb_info in embeddings.items():
        if emb_key not in adata.obsm:
            continue

        embedding = adata.obsm[emb_key]
        if isinstance(embedding, pd.DataFrame):
            embedding = embedding.values

        # Sample cells
        n_cells = min(num_samples, adata.n_obs)
        cell_indices = np.random.choice(adata.n_obs, size=n_cells, replace=False)

        try:
            # Get embedding data from API
            url = f"{base_url}/databases/{db_id}/embeddings/{emb_key}?limit={n_cells}"
            response = requests.get(url, timeout=30)

            if response.status_code != 200:
                report.data_mismatches.append(
                    f"Embedding {emb_key}: API returned {response.status_code}"
                )
                continue

            api_data = response.json()
            api_rows = {row['cell_name']: row for row in api_data['data']}

            mismatches = 0
            checks = 0

            for cell_idx in cell_indices:
                cell_name = adata.obs_names[cell_idx]

                if cell_name not in api_rows:
                    continue

                api_row = api_rows[cell_name]
                h5ad_coords = embedding[cell_idx]

                # Get dimension columns from API
                dim_cols = sorted([k for k in api_row.keys() if k.startswith('dim_')])
                n_dims = len(dim_cols)

                # Compare coordinates
                api_coords = np.array([api_row[col] for col in dim_cols])
                h5ad_coords_subset = h5ad_coords[:n_dims]

                if not np.allclose(h5ad_coords_subset, api_coords, rtol=1e-5, atol=1e-8):
                    mismatches += 1
                    if mismatches <= 3:
                        report.data_mismatches.append(
                            f"Embedding {emb_key}, cell '{cell_name}': coordinates differ"
                        )

                checks += 1

            if mismatches == 0:
                print(f"  ✓ Embedding {emb_key}: {checks} cells checked, all match")
                report.tests_passed += 1
            else:
                print(f"  ✗ Embedding {emb_key}: {mismatches} mismatches found in {checks} cells")
                report.tests_failed += 1

        except Exception as e:
            report.data_mismatches.append(f"Embedding {emb_key}: API error: {str(e)}")
            report.tests_failed += 1


def main():
    """Main entry point"""

    parser = argparse.ArgumentParser(
        description='Check REST API endpoints and data integrity',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  # Basic endpoint checks
  ant api-check http://localhost:8080 mydb

  # Deep data integrity checks
  ant api-check http://localhost:8080 mydb --deep dataset.h5ad

  # Custom timeout
  ant api-check http://localhost:8080 mydb --timeout 60
        """
    )
    parser.add_argument('base_url', help='Base API URL (e.g., http://localhost:8080)')
    parser.add_argument('db_id', help='Database ID to check')
    parser.add_argument('--deep', metavar='H5AD_FILE',
                       help='Perform deep data integrity checks against h5ad file')
    parser.add_argument('--timeout', type=int, default=30,
                       help='Request timeout in seconds (default: 30)')

    args = parser.parse_args()

    # Clean up base URL
    base_url = args.base_url.rstrip('/')
    if not base_url.startswith('http'):
        base_url = f"http://{base_url}"

    # URL-encode the database ID (handles slashes and special characters)
    db_id_encoded = quote(args.db_id, safe='/')  # preserve slashes for group_id/file_id format

    print(f"{'='*70}")
    print(f"API CHECK: {base_url}")
    print(f"Database: {args.db_id}")
    if db_id_encoded != args.db_id:
        print(f"Encoded:  {db_id_encoded}")
    print(f"{'='*70}")
    print()

    # Initialize report
    report = APICheckReport()

    try:
        # Check basic endpoints
        check_basic_endpoints(base_url, report)

        # Check database endpoints (use encoded db_id for URL paths)
        db_info = check_database_endpoints(base_url, db_id_encoded, report)

        # Run deep checks if requested
        if args.deep:
            h5ad_path = Path(args.deep).resolve()
            if not h5ad_path.exists():
                print(f"\n✗ H5AD file not found: {h5ad_path}", file=sys.stderr)
                sys.exit(1)

            if db_info:
                deep_check_api_data(base_url, db_id_encoded, h5ad_path, db_info, report)
            else:
                print("\n⚠ Skipping deep checks (database info unavailable)")

        # Print summary
        report.print_summary()

        # Print test statistics
        print(f"\n{'='*70}")
        total_tests = report.tests_passed + report.tests_failed
        if total_tests > 0:
            print(f"Tests: {report.tests_passed} passed, {report.tests_failed} failed ({report.tests_passed}/{total_tests})")
        else:
            print(f"Tests: No tests completed")

        if report.data_mismatches:
            print(f"Data mismatches: {len(report.data_mismatches)}")
        if report.endpoint_failures:
            print(f"Endpoint failures: {len(report.endpoint_failures)}")

        print(f"{'='*70}")

        # Final status
        if report.has_errors():
            print("✗ API CHECK FAILED - Errors found")
            print(f"{'='*70}")
            if report.endpoint_failures:
                print(f"\n{len(report.endpoint_failures)} endpoint(s) failed")
            if report.data_mismatches:
                print(f"{len(report.data_mismatches)} data mismatch(es) found")
            sys.exit(1)
        elif report.has_warnings():
            print("⚠ API CHECK COMPLETED - Warnings found")
            print(f"{'='*70}")
            print("\nAPI is functional but has warnings.")
            sys.exit(0)
        else:
            print("✓ API CHECK COMPLETED SUCCESSFULLY")
            print(f"{'='*70}")
            print("\nAPI is healthy and data matches h5ad file.")
            sys.exit(0)

    except KeyboardInterrupt:
        print("\n\nInterrupted by user", file=sys.stderr)
        sys.exit(130)
    except Exception as error:
        print(f"\nERROR: [ant-api-check] Unexpected error", file=sys.stderr)
        print(f"Details: {error}", file=sys.stderr)
        import traceback
        traceback.print_exc()
        sys.exit(1)


if __name__ == '__main__':
    main()
