# CLI
# ---------------------------------------------------------------------------


def _default_workers() -> int:
    cpu_count = os.cpu_count() or 2
    return max(1, min(8, cpu_count // 2))


def _load_hot_set_file(path: Path) -> list[str]:
    """Load a hot-set gene list from a text file (one gene per line, `#` comments)."""
    out: list[str] = []
    for raw in path.read_text().splitlines():
        line = raw.strip()
        if not line or line.startswith('#'):
            continue
        # Allow comma-separated per line too, for convenience.
        for token in line.split(','):
            gene = token.strip()
            if gene:
                out.append(gene)
    # Preserve order, dedup.
    return list(dict.fromkeys(out))


def _emit_progress_json(stream, index: int, total: int,
                        result: DatasetResult) -> None:
    stream.write(json.dumps({
        'i':         index,
        'n':         total,
        'db_id':     result.db_id,
        'phase':     result.phase,
        'elapsed_s': round(result.elapsed_s, 3),
        'n_rows':    result.n_rows,
        'cached':    result.from_cache,
        'ok':        result.error is None,
    }) + '\n')
    stream.flush()


def main() -> int:
    parser = argparse.ArgumentParser(prog='ant-gene-stats-precompute')
    parser.add_argument('--h5adstore-root', default='data/h5adstore')
    parser.add_argument(
        '--only', default=None,
        help='comma-separated db_ids (else all active datasets)',
    )
    parser.add_argument(
        '--top-n', type=int, default=100,
        help='per-dataset top-N variable genes to seed the hot set '
             '(default: 100)',
    )
    parser.add_argument(
        '--hot-set', default=None,
        help='path to a text file of hot-set gene names, one per line '
             '(overrides auto-discovery — no phase 1)',
    )
    parser.add_argument(
        '--extra-hot-set', default=None,
        help='path to a text file of ADDITIONAL hot-set gene names to '
             'union with the auto-discovered set (e.g. user favourites)',
    )
    parser.add_argument(
        '--out', default=None,
        help='output parquet path (default: '
             '<h5adstore>/gene_stats_index.parquet)',
    )
    parser.add_argument(
        '--force', action='store_true',
        help='ignore per-dataset cache — recompute every dataset',
    )
    parser.add_argument(
        '--workers', type=int, default=_default_workers(),
        help=f'parallel workers (default: {_default_workers()})',
    )
    parser.add_argument('--no-prune', action='store_true')
    parser.add_argument(
        '--list-stale', action='store_true',
        help='print which dataset caches are fresh / stale / missing under '
             'cache_is_fresh and exit (computes nothing)',
    )
    parser.add_argument('--dry-run', action='store_true')
    args = parser.parse_args()

    root = Path(args.h5adstore_root).resolve()
    only = set(args.only.split(',')) if args.only else None
    out = (
        Path(args.out).resolve() if args.out
        else root / 'gene_stats_index.parquet'
    )
    workers = max(1, args.workers)

    print(f'Scanning {root} for scored datasets…', file=sys.stderr)
    dataset_snapshot = _collect_dataset_snapshot(root)
    if only is not None:
        active_subset = [d for d in dataset_snapshot if d.db_id in only]
        if not active_subset:
            print(f'no dataset in {only!r} — nothing to do', file=sys.stderr)
            return 1
    else:
        active_subset = dataset_snapshot
    print(
        f'  found {len(dataset_snapshot)} active dataset(s); '
        f'{len(active_subset)} in scope',
        file=sys.stderr,
    )

    if args.list_stale:
        verdicts: dict[str, list[str]] = {'fresh': [], 'stale': [], 'missing': []}
        for inputs in active_subset:
            cache_path = _cache_file(root, inputs.db_id)
            verdict = ('missing' if not cache_path.exists()
                       else 'fresh' if cache_is_fresh(cache_path, inputs) else 'stale')
            verdicts[verdict].append(inputs.db_id)
        for verdict, ids in verdicts.items():
            print(f'{verdict}: {len(ids)}' + (f"  {' '.join(ids)}" if verdict != 'fresh' else ''))
        return 0

    _cache_root(root).mkdir(parents=True, exist_ok=True)

    # ── Determine the hot gene set ────────────────────────────────────────
    if args.hot_set:
        hot_set = _load_hot_set_file(Path(args.hot_set))
        print(
            f'Hot set: {len(hot_set)} gene(s) from {args.hot_set} (phase 1 skipped)',
            file=sys.stderr,
        )
    else:
        # Phase 1 — top-N per dataset, then union. Normally we walk the
        # entire fleet so the hot set is stable regardless of `--only`;
        # BUT if the caller passed `--only`, walking the whole fleet
        # dominates a small backfill. In that case, seed the hot set from
        # the existing aggregate parquet (its ``gene`` column) if it
        # exists, and only run phase 1 for the requested subset. Result:
        # `--only` becomes a cheap incremental. On the very first fleet
        # run there is no aggregate yet, so we still walk everything.
        seeded_from_agg: list[str] = []
        if only is not None and out.exists():
            try:
                agg = pd.read_parquet(out, columns=['gene'])
                seeded_from_agg = list(dict.fromkeys(agg['gene'].astype(str)))
                print(
                    f'Seeded hot set from existing aggregate '
                    f'({len(seeded_from_agg)} genes at {out})',
                    file=sys.stderr,
                )
            except Exception as exc:
                print(f'  [warn] could not seed from {out}: {exc}',
                      file=sys.stderr)
                seeded_from_agg = []
        phase1_scope = active_subset if seeded_from_agg else dataset_snapshot
        print(
            f'Phase 1: top-{args.top_n} variable genes across '
            f'{len(phase1_scope)} dataset(s)',
            file=sys.stderr,
        )
        topvar_jobs = [
            DatasetJob(
                inputs=inputs,
                hot_set=(), top_n=args.top_n,
                cache_path=_cache_file(root, inputs.db_id),
                phase='topvar',
            )
            for inputs in phase1_scope
        ]

        hot_set_dict: dict[str, None] = {g: None for g in seeded_from_agg}
        pbar = tqdm(
            total=len(topvar_jobs), desc='phase 1 (top-var)',
            unit='ds', file=sys.stderr,
        )
        if workers == 1 or len(topvar_jobs) <= 1:
            result_iter = (_process_topvar(job) for job in topvar_jobs)
        else:
            ctx = multiprocessing.get_context('spawn')
            pool = ctx.Pool(processes=workers)
            result_iter = pool.imap_unordered(_process_topvar_star, topvar_jobs)
        try:
            for result in result_iter:
                pbar.update(1)
                if result.error:
                    tqdm.write(
                        f'  [warn] {result.db_id}: {result.error.splitlines()[0]}',
                        file=sys.stderr,
                    )
                    continue
                for gene in result.top_genes:
                    hot_set_dict.setdefault(gene, None)
        finally:
            pbar.close()
            if workers > 1 and len(topvar_jobs) > 1:
                pool.close()
                pool.join()
        hot_set = list(hot_set_dict.keys())
        print(
            f'  hot set union: {len(hot_set)} unique gene(s)',
            file=sys.stderr,
        )

    if args.extra_hot_set:
        extra = _load_hot_set_file(Path(args.extra_hot_set))
        merged = list(dict.fromkeys(list(hot_set) + extra))
        added = len(merged) - len(hot_set)
        hot_set = merged
        print(
            f'  + {added} extra gene(s) from {args.extra_hot_set} — total {len(hot_set)}',
            file=sys.stderr,
        )

    if not hot_set:
        print('empty hot set — nothing to compute', file=sys.stderr)
        return 1

    # ── Phase 2 — per-(dataset, gene) stats ───────────────────────────────
    full_jobs = [
        DatasetJob(
            inputs=inputs,
            hot_set=tuple(hot_set), top_n=args.top_n,
            cache_path=_cache_file(root, inputs.db_id),
            phase='full',
        )
        for inputs in active_subset
    ]
    print(
        f'Phase 2: stats for {len(hot_set)} hot gene(s) × '
        f'{len(full_jobs)} dataset(s) with {workers} worker(s) '
        f'(force={args.force})',
        file=sys.stderr,
    )

    summary = RunSummary()
    total = len(full_jobs)
    completed = 0

    if workers == 1 or total <= 1:
        result_iter = (_process_full(job, args.force) for job in full_jobs)
    else:
        ctx = multiprocessing.get_context('spawn')
        pool = ctx.Pool(processes=workers)
        result_iter = pool.imap_unordered(
            _process_full_star, [(job, args.force) for job in full_jobs],
        )

    pbar = tqdm(total=total, desc='phase 2 (stats)', unit='ds', file=sys.stderr)
    try:
        for result in result_iter:
            completed += 1
            pbar.update(1)
            tag = '[cached]' if result.from_cache else '[computed]'
            if result.error:
                summary.errored += 1
                summary.errors.append(f'{result.db_id}: {result.error}')
                tqdm.write(
                    f'[{completed}/{total}] {result.db_id} — ERROR: '
                    f'{result.error.splitlines()[0]}',
                    file=sys.stderr,
                )
            else:
                if result.from_cache:
                    summary.cached += 1
                else:
                    summary.processed += 1
                tqdm.write(
                    f'[{completed}/{total}] {result.db_id} — '
                    f'{result.elapsed_s:.2f}s — {result.n_rows} rows {tag}',
                    file=sys.stderr,
                )
            if completed % 10 == 0 or completed == total:
                _emit_progress_json(sys.stderr, completed, total, result)
    finally:
        pbar.close()
        if workers > 1 and total > 1:
            pool.close()
            pool.join()

    if summary.errored:
        print(
            f'\n{summary.errored} dataset(s) failed — continuing to aggregate '
            f'with the successful ones',
            file=sys.stderr,
        )
        for err in summary.errors[:5]:
            print(f'  {err}', file=sys.stderr)

    if not args.no_prune:
        active_ids = {inputs.db_id for inputs in dataset_snapshot}
        pruned = _prune_stale_cache(root, active_ids)
        if pruned:
            print(f'pruned {pruned} stale cache file(s)', file=sys.stderr)

    if args.dry_run:
        print(f'\n[dry-run] would concat cache → {out}', file=sys.stderr)
        return 0

    # Aggregate: concatenate EVERY cache file for the full fleet (not just
    # `active_subset`), so a `--only` re-run still produces a complete
    # fleet-wide parquet.
    all_cache_entries = _cache_fingerprints(root, dataset_snapshot)

    print(f'\nConcatenating {len(all_cache_entries)} cache file(s) → {out}',
          file=sys.stderr)
    n_rows, n_datasets, n_genes = _concat_and_write(out, all_cache_entries)
    print(
        f'wrote {n_rows:,} rows across {n_datasets} dataset(s), '
        f'{n_genes} unique gene(s) → {out}',
        file=sys.stderr,
    )
    print(
        f'summary: processed={summary.processed} cached={summary.cached} '
        f'errored={summary.errored} hot_set={len(hot_set)}',
        file=sys.stderr,
    )
    return 0


if __name__ == '__main__':
    sys.exit(main())
