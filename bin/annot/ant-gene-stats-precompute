@dataclass
class RunSummary:
    processed: int = 0
    cached: int = 0
    errored: int = 0
    errors: list[str] = field(default_factory=list)


def _collect_dataset_snapshot(root: Path) -> list[DatasetInputs]:
    """Walk the h5adstore, one DatasetInputs per active dataset with a layer."""
    out: list[DatasetInputs] = []
    for entry in sorted(iter_h5adstore(root), key=lambda entry: entry.db_id):
        if entry.h5ad_path.with_suffix('.inactive').exists():
            continue
        if not entry.duckdb_path.exists():
            continue
        try:
            inputs = build_dataset_inputs(entry, root)
        except Exception as exc:  # noqa: BLE001 — surfaced in stderr
            print(f'  [warn] discover {entry.db_id}: {exc}', file=sys.stderr)
            continue
        if inputs is None:
            continue
        out.append(inputs)
    return out


def _prune_stale_cache(root: Path, active_db_ids: set[str]) -> int:
    """Remove cache dirs for db_ids no longer present."""
    cache_root = _cache_root(root)
    if not cache_root.exists():
        return 0
    active_tokens = {_sanitise(db_id) for db_id in active_db_ids}
    removed = 0
    for db_dir in cache_root.iterdir():
        if not db_dir.is_dir():
            continue
        if db_dir.name in active_tokens:
            continue
        for cache_file in db_dir.glob('*.parquet'):
            cache_file.unlink()
            removed += 1
        try:
            db_dir.rmdir()
        except OSError:
            pass
    return removed


def _cache_fingerprints(
    root: Path, snapshot: list[DatasetInputs],
) -> list[tuple[Path, str, str]]:
    """Pair every existing cache file with its dataset's ``src_fingerprint``.

    A cache the script itself would recompute (:func:`cache_is_fresh`
    false, e.g. skipped by ``--only`` or errored this run) is stamped with
    :data:`STALE_FINGERPRINT` so ant-serve never serves its rows.
    """
    out: list[tuple[Path, str, str]] = []
    for inputs in snapshot:
        cache_path = _cache_file(root, inputs.db_id)
        if not cache_path.exists():
            continue
        fresh = cache_is_fresh(cache_path, inputs)
        out.append((
            cache_path, inputs.db_id,
            inputs.fingerprint if fresh else STALE_FINGERPRINT,
        ))
    return out


def _concat_and_write(
    out_path: Path,
    cache_entries: list[tuple[Path, str, str]],
) -> tuple[int, int, int]:
    """Concatenate per-dataset caches into the aggregate parquet.

    Args:
        out_path: Aggregate parquet to (atomically) replace.
        cache_entries: ``(cache_path, db_id, src_fingerprint)`` triples.

    Returns ``(n_rows, n_datasets, n_unique_genes)``.
    """
    tmp = out_path.with_suffix(out_path.suffix + '.tmp')
    tmp.parent.mkdir(parents=True, exist_ok=True)

    if not cache_entries:
        empty = pd.DataFrame(
            {col: [] for col in (*OUTPUT_COLUMNS, FINGERPRINT_COLUMN)}
        ).astype({**OUTPUT_DTYPES, FINGERPRINT_COLUMN: 'object'})
        empty.to_parquet(tmp, engine='pyarrow', compression='zstd')
        os.replace(tmp, out_path)
        return (0, 0, 0)

    cache_files = [str(path) for path, _, _ in cache_entries]
    fingerprints = pd.DataFrame(
        [(db_id, fp) for _, db_id, fp in cache_entries],
        columns=['dataset', FINGERPRINT_COLUMN],
    )
    conn = duckdb.connect(':memory:')
    try:
        conn.register('fingerprints', fingerprints)
        select_cols = ', '.join(f'c.{col}' for col in OUTPUT_COLUMNS)
        # ORDER BY keeps the pre-join row order (file order, then row
        # order within each cache) so the output stays diffable.
        conn.execute(
            f"COPY (SELECT {select_cols}, f.{FINGERPRINT_COLUMN} "
            f"      FROM read_parquet(?, union_by_name=true, filename=true, "
            f"                        file_row_number=true) c "
            f"      LEFT JOIN fingerprints f ON f.dataset = c.dataset "
            f"      ORDER BY list_position(?, c.filename), c.file_row_number) "
            f"TO '{tmp}' (FORMAT PARQUET, COMPRESSION ZSTD)",
            [cache_files, cache_files],
        )
        row = conn.execute(
            'SELECT COUNT(*), COUNT(DISTINCT dataset), COUNT(DISTINCT gene) '
            'FROM read_parquet(?)',
            [str(tmp)],
        ).fetchone()
        n_rows = int(row[0]) if row else 0
        n_datasets = int(row[1]) if row else 0
        n_genes = int(row[2]) if row else 0
    finally:
        conn.close()

    os.replace(tmp, out_path)
    return n_rows, n_datasets, n_genes


