CACHE_DIRNAME = '_gene_stats_cache'
CACHE_FILENAME = 'genestats.parquet'

# Canonical schema — matches the fields ant-serve's /gene_stats_all
# returns (minus `gene` reordering / `error`). Kept in stable order so
# the aggregate parquet is diffable.
OUTPUT_COLUMNS = (
    'dataset', 'gene', 'layer', 'n_cells',
    'n_nonzero', 'pct_nonzero',
    'mean', 'std', 'cv',
    'mean_nonzero', 'std_nonzero', 'median_nonzero',
    'q10_nonzero', 'q90_nonzero', 'max',
    'mean_expr_layer', 'rank_mean', 'scaled_mean',
)

OUTPUT_DTYPES = {
    'dataset': 'object', 'gene': 'object', 'layer': 'object',
    'n_cells': 'int64',
    'n_nonzero': 'int64', 'pct_nonzero': 'float64',
    'mean': 'float64', 'std': 'float64', 'cv': 'float64',
    'mean_nonzero': 'float64', 'std_nonzero': 'float64',
    'median_nonzero': 'float64', 'q10_nonzero': 'float64',
    'q90_nonzero': 'float64', 'max': 'float64',
    'mean_expr_layer': 'float64', 'rank_mean': 'float64',
    'scaled_mean': 'float64',
}


# ---------------------------------------------------------------------------
# Cache path handling
# ---------------------------------------------------------------------------


_SANITISE_RE = re.compile(r'[^A-Za-z0-9._-]+')


def _sanitise(name: str) -> str:
    """Turn a db_id into a filesystem-safe single token (`G/F` → `G__F`)."""
    if not name:
        raise ValueError('empty identifier')
    token = _SANITISE_RE.sub('_', name.replace('/', '__').replace(':', '_'))
    token = token.strip('_')
    if not token:
        raise ValueError(f'identifier {name!r} sanitises to empty')
    return token


def _cache_root(h5adstore_root: Path) -> Path:
    return h5adstore_root / CACHE_DIRNAME


def _cache_file(h5adstore_root: Path, db_id: str) -> Path:
    return _cache_root(h5adstore_root) / _sanitise(db_id) / CACHE_FILENAME


def _mtime(path: Path) -> float:
    try:
        return path.stat().st_mtime
    except FileNotFoundError:
        return 0.0


# ---------------------------------------------------------------------------
# Dataset discovery
# ---------------------------------------------------------------------------


@dataclass(frozen=True)
class DatasetInputs:
    """Everything a worker needs to compute one dataset.

    Attributes:
        db_id: Canonical ``group/file`` id.
        duckdb_path: Absolute path to the ``.duckdb`` file.
        md_path: Absolute path to the sibling ``.md`` file.
        layer: Default layer name (e.g. ``'X'``).
        by_gene_parquet: Path to ``<stem>.layer.<layer>.by_gene.parquet``
            (may or may not exist).
        source_mtime: Kept for callers; mtime of ``expression_source``.
        expression_source: File the statistics are computed from (the
            by-gene parquet, else the duckdb); with ``layer`` it decides
            cache freshness (:func:`cache_is_fresh`).
        fingerprint: ``src_fingerprint`` JSON snapshot of the expression
            source (by-gene parquet, else the duckdb) taken at discovery;
            ant-serve compares it to the live files before serving rows.
    """
    db_id: str
    duckdb_path: Path
    md_path: Path
    layer: str
    by_gene_parquet: Path
    source_mtime: float
    fingerprint: str = STALE_FINGERPRINT
    expression_source: Optional[Path] = None


def _default_layer_from_md(md_path: Path) -> Optional[str]:
    """Return ``default_layer`` from a dataset's ``.md`` (or ``None``)."""
    try:
        meta, _ = parse_md_file(md_path)
    except Exception:
        return None
    val = meta.get('default_layer')
    return str(val).strip() if val else None


def build_dataset_inputs(entry, root: Path) -> Optional[DatasetInputs]:
    """Snapshot on-disk state for a dataset without opening it.

    Returns ``None`` if the dataset lacks a ``.duckdb`` or a resolvable
    ``default_layer``. The ``by_gene_parquet`` is *not* required — a
    legacy in-DuckDB layer is fine, we just fall back to the slower path.

    Args:
        entry: :class:`h5adstore.H5adEntry`.
        root: h5adstore root (fingerprint paths are relative to it).

    Returns:
        A :class:`DatasetInputs` or ``None``.
    """
    if not entry.duckdb_path.exists():
        return None
    layer = _default_layer_from_md(entry.md_path)
    if not layer:
        return None
    by_gene = entry.duckdb_path.with_name(
        f'{entry.duckdb_path.stem}.layer.{layer}.by_gene.parquet'
    )
    # Expression stats depend only on the layer values (and the gene/cell
    # tables that a re-ingest rewrites alongside them), so obs-only
    # annotation writes to the duckdb and .md edits do not invalidate them.
    expression_source = by_gene if by_gene.exists() else entry.duckdb_path
    source_mtime = _mtime(expression_source)
    return DatasetInputs(
        db_id=entry.db_id,
        duckdb_path=entry.duckdb_path.resolve(),
        md_path=entry.md_path.resolve(),
        layer=layer,
        by_gene_parquet=by_gene.resolve() if by_gene.exists() else by_gene,
        source_mtime=source_mtime,
        fingerprint=build_fingerprint(root, [expression_source]),
        expression_source=expression_source.resolve(),
    )


# ---------------------------------------------------------------------------
# Layer source expressions (portable across hosts — mirrors AnthiveDB helpers)
# ---------------------------------------------------------------------------


def _sql_str(literal: str) -> str:
    return "'" + str(literal).replace("'", "''") + "'"


def _by_gene_source(inputs: DatasetInputs) -> str:
    """Return a SQL ``FROM`` expression for the per-gene layer.

    Prefers the by-gene parquet sidecar (portable across hosts); falls
    back to the persisted ``layer__<safe>`` view otherwise. The chosen
    expression exposes ``(cell_id, gene_id, value)``.
    """
    if inputs.by_gene_parquet.exists():
        return f"read_parquet({_sql_str(str(inputs.by_gene_parquet))})"
    safe = ''.join(c if c.isalnum() else '_' for c in inputs.layer)
    return f'"__layer__{safe}"'


# ---------------------------------------------------------------------------
# Phase 1: per-dataset top-N most-variable genes
# ---------------------------------------------------------------------------


def _top_variable_genes(
    conn: duckdb.DuckDBPyConnection,
    inputs: DatasetInputs,
    top_n: int,
) -> list[str]:
    """Return the ``top_n`` most-variable gene names for a dataset.

    Variability = STDDEV_POP(value) over non-zero rows on the default
    layer. Ties broken by mean expression (higher first) for determinism.

    Args:
        conn: Open read-only connection to the dataset's ``.duckdb``.
        inputs: Dataset paths + default layer.
        top_n: Number of genes to return.

    Returns:
        List of gene names, longest-first (may be shorter than ``top_n``
        for very small datasets).
    """
    layer_source = _by_gene_source(inputs)
    rows = conn.execute(f"""
        WITH stats AS (
            SELECT gene_id,
                   STDDEV_POP(value) AS s,
                   AVG(value)        AS m
            FROM {layer_source}
            GROUP BY gene_id
        )
        SELECT g.gene_name
        FROM stats s
        JOIN __genes g USING (gene_id)
        WHERE s.s IS NOT NULL
        ORDER BY s.s DESC NULLS LAST, s.m DESC NULLS LAST
        LIMIT ?
    """, [int(top_n)]).fetchall()
    return [r[0] for r in rows]


# ---------------------------------------------------------------------------
# Phase 2: per-(dataset, gene set) stat computation
# ---------------------------------------------------------------------------


def _compute_stats_for_genes(
    conn: duckdb.DuckDBPyConnection,
    inputs: DatasetInputs,
    gene_names: list[str],
    n_cells: int,
) -> list[dict]:
    """Return one row per gene present in this dataset, matching OUTPUT_COLUMNS.

    Genes absent from ``__genes`` are silently skipped — the aggregate
    parquet is (dataset, gene) sparse: a gene only appears for datasets
    that carry it. The endpoint falls back to the live query for missing
    pairs.

    Args:
        conn: Open read-only connection to the dataset's ``.duckdb``.
        inputs: Dataset paths + default layer.
        gene_names: Hot-set gene names to compute for.
        n_cells: ``COUNT(*) FROM __cells`` (passed in — hoisted once per
            dataset by the caller).

    Returns:
        List of dicts, one per gene that resolves to an entry in
        ``__genes``. Rows are keyed by the *stored* gene name (queried
        name matches stored name in this pass because we drove the hot
        set with stored names to begin with).
    """
    if not gene_names or n_cells == 0:
        return []

    # ── Resolve queried names → gene_ids (batched — one SQL call) ────────
    placeholders = ','.join('?' * len(gene_names))
    id_rows = conn.execute(
        f"SELECT gene_name, gene_id FROM __genes "
        f"WHERE gene_name IN ({placeholders})",
        gene_names,
    ).fetchall()
    if not id_rows:
        return []
    stored_to_id: dict[str, int] = {r[0]: int(r[1]) for r in id_rows}
    unique_ids = list(dict.fromkeys(stored_to_id.values()))

    layer_source = _by_gene_source(inputs)
    id_placeholders = ','.join('?' * len(unique_ids))

    # ── Per-gene aggregates (single grouped scan) ─────────────────────────
    stat_rows = conn.execute(f"""
        SELECT
            gene_id,
            COUNT(*)                   AS n_nonzero,
            SUM(value)                 AS sum_nz,
            SUM(value * value)         AS sum_sq_nz,
            AVG(value)                 AS mean_nz,
            STDDEV_POP(value)          AS std_nz,
            MEDIAN(value)              AS median_nz,
            QUANTILE_CONT(value, 0.1)  AS q10_nz,
            QUANTILE_CONT(value, 0.9)  AS q90_nz,
            MAX(value)                 AS max_val
        FROM {layer_source}
        WHERE gene_id IN ({id_placeholders})
        GROUP BY gene_id
    """, unique_ids).fetchall()
    stats_by_gid: dict[int, tuple] = {int(row[0]): row for row in stat_rows}

    # ── Cross-gene distribution (for rank_mean + scaled_mean) ─────────────
    # One layer-wide grouped scan — ~800 ms cold on 300k×25k datasets. The
    # same scan is what /gene_stats_all triggers on a cache miss; running
    # it once per dataset here is exactly the "compute once, serve many"
    # trade the parquet exists to make.
    dist_rows = conn.execute(f"""
        SELECT gene_id, SUM(value) / {n_cells}.0 AS mean_expr
        FROM {layer_source}
        GROUP BY gene_id
    """).fetchall()
    if not dist_rows:
        return []
    all_means: dict[int, float] = {int(r[0]): float(r[1]) for r in dist_rows}
    sorted_means = sorted(all_means.values())
    n_total = max(len(sorted_means) - 1, 1)

    def _quant(p: float) -> float:
        n = len(sorted_means)
        if n == 0:
            return 0.0
        idx = p * (n - 1)
        lo = int(idx)
        hi = min(lo + 1, n - 1)
        frac = idx - lo
        return sorted_means[lo] * (1 - frac) + sorted_means[hi] * frac

    q05 = _quant(0.05)
    q95 = _quant(0.95)
    q_range = max(q95 - q05, 1e-9)
    from bisect import bisect_left

    # ── Assemble output rows ──────────────────────────────────────────────
    import math
    out_rows: list[dict] = []
    for stored_name, gid in stored_to_id.items():
        row = stats_by_gid.get(gid)
        mean_expr = all_means.get(gid)
        rank_mean = (
            bisect_left(sorted_means, mean_expr) / n_total
            if mean_expr is not None else 0.0
        )
        scaled_mean = (
            max(0.0, min(1.0, (mean_expr - q05) / q_range))
            if mean_expr is not None else 0.0
        )

        if row is None:
            # Gene present but silent across all cells — mean 0, std 0.
            out_rows.append({
                'dataset':         inputs.db_id,
                'gene':            stored_name,
                'layer':           inputs.layer,
                'n_cells':         int(n_cells),
                'n_nonzero':       0,
                'pct_nonzero':     0.0,
                'mean':            0.0,
                'std':             0.0,
                'cv':              float('nan'),
                'mean_nonzero':    float('nan'),
                'std_nonzero':     float('nan'),
                'median_nonzero':  float('nan'),
                'q10_nonzero':     float('nan'),
                'q90_nonzero':     float('nan'),
                'max':             0.0,
                'mean_expr_layer': round(float(mean_expr or 0.0), 6),
                'rank_mean':       round(float(rank_mean), 4),
                'scaled_mean':     round(float(scaled_mean), 4),
            })
            continue

        (_gid, n_nonzero, sum_nz, sum_sq_nz, mean_nz, std_nz,
         median_nz, q10_nz, q90_nz, max_val) = row
        mean_all = float(sum_nz) / n_cells if n_cells else 0.0
        var_all = max(0.0, float(sum_sq_nz) / n_cells - mean_all ** 2) if n_cells else 0.0
        std_all = math.sqrt(var_all)
        cv = round(std_all / mean_all, 4) if mean_all > 0 else float('nan')

        out_rows.append({
            'dataset':         inputs.db_id,
            'gene':            stored_name,
            'layer':           inputs.layer,
            'n_cells':         int(n_cells),
            'n_nonzero':       int(n_nonzero),
            'pct_nonzero':     round(n_nonzero * 100.0 / n_cells, 2) if n_cells else 0.0,
            'mean':            round(mean_all, 6),
            'std':             round(std_all, 6),
            'cv':              cv,
            'mean_nonzero':    round(float(mean_nz), 6),
            'std_nonzero':     round(float(std_nz), 6),
            'median_nonzero':  round(float(median_nz), 6),
            'q10_nonzero':     round(float(q10_nz), 6),
            'q90_nonzero':     round(float(q90_nz), 6),
            'max':             round(float(max_val), 6),
            'mean_expr_layer': round(float(mean_expr or mean_all), 6),
            'rank_mean':       round(float(rank_mean), 4),
            'scaled_mean':     round(float(scaled_mean), 4),
        })
    return out_rows


# ---------------------------------------------------------------------------
# Per-dataset worker
# ---------------------------------------------------------------------------


@dataclass
class DatasetJob:
    """One dataset unit of work."""
    inputs: DatasetInputs
    hot_set: tuple[str, ...]
    top_n: int
    cache_path: Path
    phase: str          # 'topvar' → phase 1;  'full' → phase 2


@dataclass
class DatasetResult:
    """What a worker returns to the coordinator."""
    db_id: str
    phase: str
    cache_path: Path
    n_rows: int
    top_genes: tuple[str, ...]     # only set for phase 'topvar'
    from_cache: bool
    elapsed_s: float
    error: Optional[str] = None


def _read_cache(cache_path: Path) -> Optional[pd.DataFrame]:
    if not cache_path.exists():
        return None
    try:
        return pd.read_parquet(cache_path)
    except Exception:
        return None


#: Parquet key-value metadata key of a cache file: JSON ``{layer, source,
#: size, mtime_ns}`` describing the expression source the rows came from.
CACHE_META_KEY = b'anthive_gene_stats_source'


def _source_signature(inputs: DatasetInputs) -> Optional[dict]:
    """``{layer, source, size, mtime_ns}`` of a dataset's expression source now."""
    source = inputs.expression_source
    if source is None:
        return None
    try:
        stat = Path(source).stat()
    except OSError:
        return None
    return {'layer': inputs.layer, 'source': str(source),
            'size': int(stat.st_size), 'mtime_ns': int(stat.st_mtime_ns)}


def _read_cache_meta(cache_path: Path) -> Optional[dict]:
    """The recorded source signature of a cache file, or None (old cache, unreadable)."""
    try:
        import pyarrow.parquet as pq  # noqa: PLC0415
        metadata = pq.read_schema(cache_path).metadata or {}
        raw = metadata.get(CACHE_META_KEY)
        return json.loads(raw) if raw else None
    except Exception:  # noqa: BLE001 — treated as an old cache
        return None


def cache_is_fresh(cache_path: Path, inputs: DatasetInputs) -> bool:
    """Whether a dataset's cache still matches its expression source.

    With recorded metadata: fresh when the ``default_layer`` value, the
    source path and size are unchanged, and the source mtime is unchanged
    or not newer than the cache (a pull from S3 resets mtimes). Without
    metadata (caches written before 2026-10-13): fresh only when the
    expression source is not newer than the cache and every cached row
    carries the current layer. ``.md`` and obs-only duckdb changes never
    count.
    """
    cache_mtime = _mtime(cache_path)
    if cache_mtime <= 0.0:
        return False
    current = _source_signature(inputs)
    if current is None:
        return False
    recorded = _read_cache_meta(cache_path)
    if recorded is not None:
        if (recorded.get('layer') != current['layer'] or recorded.get('source') != current['source']
                or recorded.get('size') != current['size']):
            return False
        return (recorded.get('mtime_ns') == current['mtime_ns']
                or current['mtime_ns'] / 1e9 <= cache_mtime)
    if current['mtime_ns'] / 1e9 > cache_mtime:
        return False
    try:
        layers = set(pd.read_parquet(cache_path, columns=['layer'])['layer'].dropna().astype(str))
    except Exception:  # noqa: BLE001
        return False
    return layers <= {inputs.layer}


def _write_cache(cache_path: Path, rows: list[dict], inputs: Optional[DatasetInputs] = None) -> None:
    """Write a dataset cache; ``inputs`` stamps its expression source signature."""
    cache_path.parent.mkdir(parents=True, exist_ok=True)
    if rows:
        df = pd.DataFrame(rows, columns=list(OUTPUT_COLUMNS)).astype(
            OUTPUT_DTYPES, errors='ignore',
        )
    else:
        df = pd.DataFrame({col: [] for col in OUTPUT_COLUMNS}).astype(
            OUTPUT_DTYPES,
        )
    tmp = cache_path.with_suffix(cache_path.suffix + '.tmp')
    import pyarrow as pa  # noqa: PLC0415
    import pyarrow.parquet as pq  # noqa: PLC0415
    table = pa.Table.from_pandas(df, preserve_index=False)
    signature = _source_signature(inputs) if inputs is not None else None
    if signature is not None:
        table = table.replace_schema_metadata(
            {**(table.schema.metadata or {}), CACHE_META_KEY: json.dumps(signature).encode()})
    pq.write_table(table, tmp, compression='zstd')
    os.replace(tmp, cache_path)


def _process_topvar(job: DatasetJob) -> DatasetResult:
    """Phase 1: compute this dataset's top-N most-variable genes."""
    start = time.time()
    try:
        conn = duckdb.connect(str(job.inputs.duckdb_path), read_only=True)
        try:
            top = _top_variable_genes(conn, job.inputs, job.top_n)
        finally:
            conn.close()
        return DatasetResult(
            db_id=job.inputs.db_id, phase='topvar',
            cache_path=job.cache_path, n_rows=len(top),
            top_genes=tuple(top), from_cache=False,
            elapsed_s=time.time() - start,
        )
    except Exception as exc:  # noqa: BLE001 — reported via .error
        return DatasetResult(
            db_id=job.inputs.db_id, phase='topvar',
            cache_path=job.cache_path, n_rows=0,
            top_genes=(), from_cache=False,
            elapsed_s=time.time() - start,
            error=f'{type(exc).__name__}: {exc}\n{traceback.format_exc()}',
        )


def _process_full(job: DatasetJob, force: bool) -> DatasetResult:
    """Phase 2: compute per-(dataset, gene) stats for the hot set.

    Cache is valid if (a) :func:`cache_is_fresh` AND (b) it already
    contains every gene in ``job.hot_set``. If (a) but not (b), we
    compute stats for the missing genes and *append* them to the cache
    (append-only backfill).
    """
    start = time.time()
    try:
        cached_df: Optional[pd.DataFrame] = None
        cached_genes: set[str] = set()
        if not force and cache_is_fresh(job.cache_path, job.inputs):
            cached_df = _read_cache(job.cache_path)
            if cached_df is not None:
                cached_genes = set(cached_df['gene'].astype(str))

        missing_genes = [g for g in job.hot_set if g not in cached_genes]
        if not missing_genes and cached_df is not None:
            return DatasetResult(
                db_id=job.inputs.db_id, phase='full',
                cache_path=job.cache_path,
                n_rows=int(len(cached_df)),
                top_genes=(), from_cache=True,
                elapsed_s=time.time() - start,
            )

        conn = duckdb.connect(str(job.inputs.duckdb_path), read_only=True)
        try:
            n_cells = (conn.execute(
                'SELECT COUNT(*) FROM __cells'
            ).fetchone() or (0,))[0]
            new_rows = _compute_stats_for_genes(
                conn, job.inputs, missing_genes if cached_df is not None else list(job.hot_set),
                int(n_cells),
            )
        finally:
            conn.close()

        # Merge — cached rows (still fresh) + new rows. Any change of the
        # expression source or layer would have failed cache_is_fresh and
        # we would be recomputing from scratch.
        if cached_df is not None:
            new_df = pd.DataFrame(new_rows, columns=list(OUTPUT_COLUMNS))
            merged = pd.concat([cached_df, new_df], ignore_index=True)
            # De-dup on (dataset, gene) — new rows win.
            merged = merged.drop_duplicates(
                subset=['dataset', 'gene'], keep='last',
            )
            _write_cache(job.cache_path, merged.to_dict(orient='records'), job.inputs)
            n_rows = int(len(merged))
        else:
            _write_cache(job.cache_path, new_rows, job.inputs)
            n_rows = len(new_rows)

        return DatasetResult(
            db_id=job.inputs.db_id, phase='full',
            cache_path=job.cache_path,
            n_rows=n_rows, top_genes=(),
            from_cache=False, elapsed_s=time.time() - start,
        )
    except Exception as exc:  # noqa: BLE001 — reported via .error
        return DatasetResult(
            db_id=job.inputs.db_id, phase='full',
            cache_path=job.cache_path, n_rows=0,
            top_genes=(), from_cache=False,
            elapsed_s=time.time() - start,
            error=f'{type(exc).__name__}: {exc}\n{traceback.format_exc()}',
        )


def _process_topvar_star(args_tuple):
    return _process_topvar(args_tuple)


def _process_full_star(args_tuple):
    job, force = args_tuple
    return _process_full(job, force)


