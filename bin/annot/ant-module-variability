def dataset_skip_reason(inputs: DatasetInputs) -> Optional[str]:
    """Why this dataset is out of scope (bulk, one observation per donor), or None.

    Args:
        inputs: Dataset metadata.

    Returns:
        The reason to record, or None when per-cell statistics make sense.
    """
    annotation: dict = {}
    if inputs.h5ad_path is not None:
        try:
            annotation = mus.resolve_annotation(inputs.h5ad_path, root=inputs.store_root)
        except Exception:  # noqa: BLE001 - no annotation: only the counts can decide
            annotation = {}
    conn = duckdb.connect(str(inputs.duckdb_path), read_only=True)
    try:
        n_obs, n_donors = cell_level_scope.count_obs_and_donors(conn)
    finally:
        conn.close()
    return cell_level_scope.scope_skip_reason(annotation, n_obs, n_donors)


def _load_scores_for_pair(
    conn: duckdb.DuckDBPyConnection,
    inputs: DatasetInputs,
    source: str,
    catalog: str,
) -> pd.DataFrame:
    """Return ``(cell_name, module, score)`` rows for one (source, catalog).

    Reads from the sidecar if the pair is present there; falls back to
    the legacy ``__obsnum`` columns for pairs absent from the sidecar.
    Sidecar shadows legacy (matches legacy tool behaviour).

    Args:
        conn: Read-only DuckDB connection to the dataset's ``.duckdb``.
        inputs: Dataset metadata (paths, mtime).
        source: ``'geneset'`` / ``'starcat'`` / ...
        catalog: e.g. ``'Sierksma2025/WGCNA'``.

    Returns:
        DataFrame with columns ``cell_name``, ``module``, ``score``.
        Empty if the pair has no data (unusual — the pair was
        discovered from these sources).
    """
    frames: list[pd.DataFrame] = []
    sidecar_present = False
    if inputs.sidecar_path.exists():
        sidecar_df = conn.execute(
            "SELECT c.cell_name, s.module, s.score "
            "FROM read_parquet(?) s "
            "JOIN __cells c ON c.cell_id = s.cell_id "
            "WHERE s.source = ? AND s.catalog = ?",
            [str(inputs.sidecar_path), source, catalog],
        ).df()
        if not sidecar_df.empty:
            sidecar_present = True
            frames.append(sidecar_df)

    if not sidecar_present:
        for column, col_source, col_catalog, module in _obsnum_score_columns(conn):
            if col_source != source or col_catalog != catalog:
                continue
            col_ident = '"' + column.replace('"', '""') + '"'
            try:
                df = conn.execute(
                    f'SELECT c.cell_name, CAST({col_ident} AS DOUBLE) AS score '
                    f'FROM __obsnum o JOIN __cells c ON c.cell_id = o.cell_id'
                ).df()
            except Exception:
                continue
            if df.empty:
                continue
            df['module'] = module
            frames.append(df[['cell_name', 'module', 'score']])

    if not frames:
        return pd.DataFrame(columns=['cell_name', 'module', 'score'])
    return pd.concat(frames, ignore_index=True) if len(frames) > 1 else frames[0]


def _compute_rows_for_pair(
    inputs: DatasetInputs,
    source: str,
    catalog: str,
) -> list[dict]:
    """Compute the variability rows for one (dataset × catalog) pair.

    Args:
        inputs: Dataset metadata.
        source: Score source (``'geneset'``, ``'starcat'``, ...).
        catalog: Catalog id.

    Returns:
        List of dicts, one per output row.
    """
    tag_targets = _resolve_tag_targets(inputs.md_path)

    conn = duckdb.connect(str(inputs.duckdb_path), read_only=True)
    try:
        scores_long = _load_scores_for_pair(conn, inputs, source, catalog)
        if scores_long.empty:
            return []

        obs_frames: dict[str, pd.DataFrame] = {}
        for column in list(tag_targets.keys()):
            kind = _view_column_kind(conn, column)
            if kind == '?':
                continue
            view = 'obsnum' if kind == 'num' else 'obscat'
            try:
                df = conn.execute(
                    f'SELECT cell_name, "{column}" AS "{column}" FROM {view}'
                ).df().set_index('cell_name')
            except Exception:
                continue
            obs_frames[column] = df
    finally:
        conn.close()

    tag_targets = {col: tags for col, tags in tag_targets.items() if col in obs_frames}
    if not tag_targets:
        return []

    rows: list[dict] = []
    for module, sub in scores_long.groupby('module', observed=True):
        scores_by_cell = sub.set_index('cell_name')['score']
        total_var = float(scores_by_cell.var(ddof=1))
        n_cells = int(len(scores_by_cell))

        for column, tags in tag_targets.items():
            col_series = obs_frames[column][column]
            joined = pd.concat(
                [scores_by_cell, col_series], axis=1, join='inner',
            ).dropna()
            if joined.empty:
                continue
            score_array = joined.iloc[:, 0].to_numpy(dtype=float)
            tag_array = joined.iloc[:, 1]

            for tag in tags:
                # Donor identifiers are labels, whatever tag they carry.
                if tag in NUMERICAL_TAGS and not cell_level_scope.is_donor_like(column):
                    predictor = pd.to_numeric(tag_array, errors='coerce').to_numpy(
                        dtype=float,
                    )
                    if np.isnan(predictor).all():
                        # Numeric tag against a non-numeric column? fall
                        # back to categorical stats — matches legacy.
                        eta2, omega2, mean_range, f_stat = _eta_squared(
                            score_array, tag_array.to_numpy(),
                        )
                        n_categories = int(pd.Series(tag_array).nunique())
                        stats_here: list[tuple[str, float]] = [
                            ('eta2', eta2), ('omega2', omega2),
                            ('mean_range', mean_range), ('F', f_stat),
                        ]
                    else:
                        r2, rho, _ = _r_squared(score_array, predictor)
                        stats_here = [('R2', r2), ('spearman', rho)]
                        n_categories = 0
                else:
                    tag_values = tag_array.astype(str).to_numpy()
                    eta2, omega2, mean_range, f_stat = _eta_squared(
                        score_array, tag_values,
                    )
                    n_categories = int(pd.Series(tag_values).nunique())
                    stats_here = [
                        ('eta2', eta2), ('omega2', omega2),
                        ('mean_range', mean_range), ('F', f_stat),
                    ]

                stats_here.append(('total_var', total_var))
                stats_here.append(('mean_score', float(score_array.mean())))

                for stat_name, value in stats_here:
                    rows.append({
                        'dataset':      inputs.db_id,
                        'source':       source,
                        'catalog':      catalog,
                        'module':       module,
                        'tag_column':   column,
                        'tag':          tag,
                        'statistic':    stat_name,
                        'value':        value,
                        'n_cells':      n_cells,
                        'n_categories': n_categories,
                    })

    return rows


def _write_cache(cache_path: Path, rows: list[dict]) -> None:
    """Atomically write pair rows to the cache directory.

    Always writes a parquet — even for zero rows — so cache freshness
    can be tested by mtime alone (no ambiguity between "cache miss" and
    "cache present but empty").

    Args:
        cache_path: Target parquet path (must be under the cache root).
        rows: Rows to write (may be empty).
    """
    cache_path.parent.mkdir(parents=True, exist_ok=True)
    if rows:
        df = pd.DataFrame(rows, columns=list(OUTPUT_COLUMNS))
    else:
        df = pd.DataFrame({col: [] for col in OUTPUT_COLUMNS})
        df = df.astype({
            'dataset': 'object', 'source': 'object', 'catalog': 'object',
            'module': 'object', 'tag_column': 'object', 'tag': 'object',
            'statistic': 'object', 'value': 'float64',
            'n_cells': 'int64', 'n_categories': 'int64',
        })
    tmp = cache_path.with_suffix(cache_path.suffix + '.tmp')
    df.to_parquet(tmp, engine='pyarrow', compression='zstd')
    os.replace(tmp, cache_path)


def _process_pair(job: PairJob, force: bool) -> PairResult:
    """Worker entry point. Handle cache read, compute, cache write.

    Args:
        job: Unit of work.
        force: If ``True``, ignore any existing cache file.

    Returns:
        A :class:`PairResult` — never raises; errors are captured on
        ``.error``.
    """
    start = time.time()
    try:
        skip_reason = dataset_skip_reason(job.inputs)
        if skip_reason:
            # Out of scope: an empty cache keeps stale rows from a previous
            # run out of the aggregate.
            _write_cache(job.cache_path, [])
            return PairResult(
                db_id=job.db_id, source=job.source, catalog=job.catalog,
                cache_path=job.cache_path, n_rows=0, from_cache=False,
                elapsed_s=time.time() - start, skipped_reason=skip_reason,
            )
        cache_mtime = _mtime(job.cache_path)
        if (
            not force
            and cache_mtime > 0.0
            and cache_mtime >= job.inputs.source_mtime
        ):
            # Cache is at least as new as the sources it derives from.
            n_rows = _count_parquet_rows(job.cache_path)
            return PairResult(
                db_id=job.db_id, source=job.source, catalog=job.catalog,
                cache_path=job.cache_path, n_rows=n_rows,
                from_cache=True, elapsed_s=time.time() - start,
            )

        rows = _compute_rows_for_pair(job.inputs, job.source, job.catalog)
        _write_cache(job.cache_path, rows)
        return PairResult(
            db_id=job.db_id, source=job.source, catalog=job.catalog,
            cache_path=job.cache_path, n_rows=len(rows),
            from_cache=False, elapsed_s=time.time() - start,
        )
    except Exception as exc:  # noqa: BLE001 — surfaced via .error
        return PairResult(
            db_id=job.db_id, source=job.source, catalog=job.catalog,
            cache_path=job.cache_path, n_rows=0, from_cache=False,
            elapsed_s=time.time() - start,
            error=f'{type(exc).__name__}: {exc}\n{traceback.format_exc()}',
        )


def _count_parquet_rows(path: Path) -> int:
    """Row count of a parquet file via a short-lived DuckDB connection."""
    conn = duckdb.connect(':memory:')
    try:
        row = conn.execute(
            'SELECT COUNT(*) FROM read_parquet(?)', [str(path)],
        ).fetchone()
        return int(row[0]) if row else 0
    finally:
        conn.close()


