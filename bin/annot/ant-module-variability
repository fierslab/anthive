@dataclass
class RunSummary:
    """Aggregate progress counters for the coordinator log line."""
    processed: int = 0
    cached: int = 0
    empty_pairs: int = 0
    errored: int = 0
    skipped_datasets: int = 0
    errors: list[str] = field(default_factory=list)


def _iter_pair_jobs(
    root: Path,
    only: Optional[set[str]],
    dataset_snapshot: list[DatasetInputs],
) -> Iterable[PairJob]:
    """Yield one :class:`PairJob` per (dataset × catalog).

    Args:
        root: h5adstore root.
        only: Optional set of db_ids to keep.
        dataset_snapshot: Pre-computed dataset inputs.

    Yields:
        :class:`PairJob` in stable (db_id, source, catalog) order.
    """
    for inputs in dataset_snapshot:
        if only and inputs.db_id not in only:
            continue
        for source, catalog in inputs.catalogs:
            yield PairJob(
                db_id=inputs.db_id, source=source, catalog=catalog,
                inputs=inputs,
                cache_path=_cache_file(root, inputs.db_id, source, catalog),
            )


def _collect_dataset_snapshot(root: Path) -> list[DatasetInputs]:
    """Walk the h5adstore, return one :class:`DatasetInputs` per scored dataset.

    Skips inactive datasets (``.inactive`` sidecar) and datasets without
    a score source. Runs sequentially — the discovery is cheap
    relative to the compute.

    Args:
        root: h5adstore root.

    Returns:
        Sorted list of :class:`DatasetInputs`.
    """
    out: list[DatasetInputs] = []
    for entry in sorted(iter_h5adstore(root), key=lambda entry: entry.db_id):
        if entry.h5ad_path.with_suffix('.inactive').exists():
            continue
        if not entry.duckdb_path.exists():
            continue
        try:
            inputs = build_dataset_inputs(entry, root)
        except Exception as exc:  # noqa: BLE001 — surfaced in stderr
            print(
                f'  [warn] discover {entry.db_id}: {exc}',
                file=sys.stderr,
            )
            continue
        if inputs is None:
            continue
        out.append(inputs)
    return out


def _prune_stale_cache(
    root: Path, active_triples: set[tuple[str, str, str]],
) -> int:
    """Remove cache files for (dataset, source, catalog) triples no longer present.

    Args:
        root: h5adstore root.
        active_triples: Set of ``(db_id, source, catalog)`` still active.

    Returns:
        Count of files removed.
    """
    cache_root = _cache_root(root)
    if not cache_root.exists():
        return 0
    active_tokens = {
        (_sanitise(db_id), f'{_sanitise(source)}__{_sanitise(catalog)}')
        for db_id, source, catalog in active_triples
    }
    removed = 0
    for db_dir in cache_root.iterdir():
        if not db_dir.is_dir():
            continue
        for cache_file in db_dir.glob('*.parquet'):
            key = (db_dir.name, cache_file.stem)
            if key not in active_tokens:
                cache_file.unlink()
                removed += 1
        if not any(db_dir.iterdir()):
            db_dir.rmdir()
    return removed


def _concat_and_write(
    root: Path,
    out_path: Path,
    cache_files: list[Path],
    keep_tags: Optional[set[str]],
) -> tuple[int, int]:
    """Concatenate the given cache parquets into the aggregate output.

    Uses DuckDB's native parquet reader over an explicit file list —
    never materialises the full aggregate in Python. Filters by
    ``keep_tags`` if provided.

    Args:
        root: h5adstore root (unused; kept for symmetry).
        out_path: Final parquet path.
        cache_files: Explicit list of cache parquet paths to concat.
            Passing the list (not a glob) lets ``--only`` limit the
            aggregate to the requested datasets, matching legacy
            semantics.
        keep_tags: Optional whitelist of ``tag`` values.

    Returns:
        Tuple ``(n_rows, n_datasets)`` in the aggregate. ``(0, 0)`` if
        ``cache_files`` is empty.
    """
    del root  # noqa: F841 — kept for parity with older callers
    tmp = out_path.with_suffix(out_path.suffix + '.tmp')
    tmp.parent.mkdir(parents=True, exist_ok=True)

    if not cache_files:
        # Write an empty parquet with the canonical schema — downstream
        # readers should never see "file missing" vs "no rows" as two
        # distinct states.
        empty = pd.DataFrame({col: [] for col in OUTPUT_COLUMNS}).astype({
            'dataset': 'object', 'source': 'object', 'catalog': 'object',
            'module': 'object', 'tag_column': 'object', 'tag': 'object',
            'statistic': 'object', 'value': 'float64',
            'n_cells': 'int64', 'n_categories': 'int64',
        })
        empty.to_parquet(tmp, engine='pyarrow', compression='zstd')
        os.replace(tmp, out_path)
        return (0, 0)

    conn = duckdb.connect(':memory:')
    try:
        file_list = [str(path) for path in cache_files]
        select_cols = ', '.join(OUTPUT_COLUMNS)
        where_clause = ''
        params: list = [file_list]
        if keep_tags is not None:
            placeholders = ', '.join(['?'] * len(keep_tags))
            where_clause = f'WHERE tag IN ({placeholders})'
            params.extend(sorted(keep_tags))
        conn.execute(
            f"COPY (SELECT {select_cols} "
            f"      FROM read_parquet(?, union_by_name=true) "
            f"      {where_clause}) "
            f"TO '{tmp}' (FORMAT PARQUET, COMPRESSION ZSTD)",
            params,
        )
        row = conn.execute(
            "SELECT COUNT(*), COUNT(DISTINCT dataset) FROM read_parquet(?)",
            [str(tmp)],
        ).fetchone()
        n_rows = int(row[0]) if row else 0
        n_datasets = int(row[1]) if row else 0
    finally:
        conn.close()

    os.replace(tmp, out_path)
    return n_rows, n_datasets


def _emit_progress_json(
    stream, index: int, total: int, result: PairResult,
) -> None:
    """Emit a machine-readable progress line to ``stream`` (stderr)."""
    stream.write(json.dumps({
        'i':         index,
        'n':         total,
        'db_id':     result.db_id,
        'catalog':   result.catalog,
        'elapsed_s': round(result.elapsed_s, 3),
        'n_rows':    result.n_rows,
        'cached':    result.from_cache,
        'ok':        result.error is None,
    }) + '\n')
    stream.flush()


