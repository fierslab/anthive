@dataclass(frozen=True)
class DatasetInputs:
    """Cached, JSON-safe view of everything needed to compute one dataset.

    Attributes:
        db_id: Canonical ``group/file`` id.
        duckdb_path: Absolute path to the ``.duckdb`` file.
        md_path: Absolute path to the sibling ``.md`` file.
        sidecar_path: Absolute path to the ``.scores.parquet`` sidecar
            (may not exist).
        source_mtime: Newest mtime among (sidecar, duckdb) — the cache
            invalidation key.
        catalogs: List of ``(source, catalog)`` pairs present for this
            dataset.
        h5ad_path: The ``.h5ad`` next to the dataset; its ``.mus`` sidecar
            carries the technology used by the scope check.
        store_root: h5adstore root (bounds the ``.env`` cascade).
    """
    db_id: str
    duckdb_path: Path
    md_path: Path
    sidecar_path: Path
    source_mtime: float
    catalogs: tuple[tuple[str, str], ...]
    h5ad_path: Optional[Path] = None
    store_root: Optional[Path] = None


def _discover_catalogs(entry_duckdb: Path) -> list[tuple[str, str]]:
    """Enumerate every ``(source, catalog)`` present for a dataset.

    Reads the sidecar (if present) and the ``__obsnum`` legacy columns.
    A ``(source, catalog)`` from the sidecar shadows any legacy match —
    the same rule the legacy tool used ("sidecar wins").

    Args:
        entry_duckdb: Path to the dataset's ``.duckdb`` file.

    Returns:
        Sorted, deduplicated list of ``(source, catalog)`` pairs. Empty
        if neither source has any modules.
    """
    seen: dict[tuple[str, str], None] = {}
    sidecar = scores_path(entry_duckdb)
    conn = duckdb.connect(str(entry_duckdb), read_only=True)
    try:
        if sidecar.exists():
            rows = conn.execute(
                "SELECT DISTINCT source, catalog "
                "FROM read_parquet(?)",
                [str(sidecar)],
            ).fetchall()
            for source, catalog in rows:
                seen[(source, catalog)] = None
        for _col, source, catalog, _module in _obsnum_score_columns(conn):
            seen.setdefault((source, catalog), None)
    finally:
        conn.close()
    return sorted(seen.keys())


def build_dataset_inputs(entry, root: Optional[Path] = None) -> Optional[DatasetInputs]:
    """Snapshot on-disk state for a dataset without reading scores.

    Returns ``None`` for datasets without any score source (sidecar
    missing AND no legacy ``::`` columns).

    Args:
        entry: :class:`h5adstore.H5adEntry` yielded by ``iter_h5adstore``.
        root: h5adstore root, for the annotation cascade.

    Returns:
        A :class:`DatasetInputs` or ``None``.
    """
    if not entry.duckdb_path.exists():
        return None
    sidecar = scores_path(entry.duckdb_path)
    catalogs = _discover_catalogs(entry.duckdb_path)
    if not catalogs:
        return None
    # Cache invalidation must react to changes in any of the three sources
    # feeding a computed row: scores (sidecar), obs columns (duckdb), and
    # tag-target resolution (the .md's obs_tags / api.obs_rename block).
    source_mtime = max(
        _mtime(sidecar),
        _mtime(entry.duckdb_path),
        _mtime(entry.md_path),
    )
    return DatasetInputs(
        db_id=entry.db_id,
        duckdb_path=entry.duckdb_path.resolve(),
        md_path=entry.md_path.resolve(),
        sidecar_path=sidecar.resolve(),
        source_mtime=source_mtime,
        catalogs=tuple(catalogs),
        h5ad_path=entry.h5ad_path,
        store_root=root,
    )


# ---------------------------------------------------------------------------
# Tag-target resolution — replicated verbatim from the legacy tool.
# ---------------------------------------------------------------------------


def _resolve_tag_targets(md_path: Path) -> dict[str, list[str]]:
    """Build the ``(view_column → [tag_id,...])`` map for one dataset.

    Combines:
      * Canonical ``ant_*`` columns from :data:`_CANONICAL_TAGS`.
      * Every hop of an ``api.obs_rename`` chain that terminates on a
        canonical column (so intermediate names still surface).
      * ``obs_tags:`` in the ``.md`` YAML (both raw and any renamed hop).

    Args:
        md_path: Path to the dataset's ``.md``.

    Returns:
        Dict mapping view column name → list of tag ids to compute.
    """
    md, _ = parse_md_file(md_path)
    obs_tags = md.get('obs_tags') or {}
    api_config = md.get('api') or {}
    obs_rename = api_config.get('obs_rename') or {}

    tag_targets: dict[str, list[str]] = {}
    for col, tag in _CANONICAL_TAGS.items():
        tag_targets.setdefault(col, [])
        if tag not in tag_targets[col]:
            tag_targets[col].append(tag)

    def _resolve_chain(start: str, seen: set[str]) -> Optional[str]:
        current = start
        while current in obs_rename and current not in seen:
            seen.add(current)
            current = obs_rename[current]
        return current

    for source_column in list(obs_rename.keys()):
        terminal = _resolve_chain(source_column, set())
        if terminal in _CANONICAL_TAGS:
            canonical_tag = _CANONICAL_TAGS[terminal]
            hop = source_column
            visited: set[str] = set()
            while True:
                if hop in visited:
                    break
                visited.add(hop)
                tag_targets.setdefault(hop, [])
                if canonical_tag not in tag_targets[hop]:
                    tag_targets[hop].append(canonical_tag)
                if hop == terminal or hop not in obs_rename:
                    break
                hop = obs_rename[hop]

    for col, tags in obs_tags.items():
        tag_targets.setdefault(col, [])
        for tag in (tags or []):
            if tag not in tag_targets[col]:
                tag_targets[col].append(tag)
        hop = col
        visited = set()
        while hop in obs_rename and hop not in visited:
            visited.add(hop)
            hop = obs_rename[hop]
            tag_targets.setdefault(hop, [])
            for tag in (tags or []):
                if tag not in tag_targets[hop]:
                    tag_targets[hop].append(tag)

    return tag_targets


