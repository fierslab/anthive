#!/usr/bin/env -S uv run --quiet --script
# /// script
# dependencies = [
#   "duckdb>=0.10.0",
#   "pandas>=2.0.0",
#   "numpy>=1.24.0",
#   "scipy>=1.10.0",
#   "pyarrow>=14.0",
#   "pyyaml>=6.0",
