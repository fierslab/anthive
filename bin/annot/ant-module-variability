# ---------------------------------------------------------------------------
# Statistics primitives.
# ---------------------------------------------------------------------------


def _eta_squared(
    values: np.ndarray, groups: np.ndarray,
) -> tuple[float, float, float, float]:
    """Return ``(eta2, omega2, mean_range, F)`` for a categorical predictor.

    Args:
        values: Score vector.
        groups: Category label vector (same length).

    Returns:
        Tuple ``(eta2, omega2, mean_range, F)``. All NaN if fewer than
        two categories or fewer than three finite observations.
    """
    if len(values) < 3:
        return (float('nan'),) * 4
    mask = ~np.isnan(values)
    values = values[mask]
    groups = np.asarray(groups)[mask]
    unique = pd.unique(groups)
    n_categories = len(unique)
    n_values = len(values)
    if n_categories < 2 or n_values <= n_categories:
        return (float('nan'),) * 4

    grand_mean = float(values.mean())
    ss_total = float(((values - grand_mean) ** 2).sum())
    if ss_total == 0.0:
        return (0.0, 0.0, 0.0, 0.0)

    ss_between = 0.0
    group_means: list[float] = []
    for level in unique:
        vals = values[groups == level]
        if len(vals) == 0:
            continue
        mean = float(vals.mean())
        group_means.append(mean)
        ss_between += len(vals) * (mean - grand_mean) ** 2
    ss_within = ss_total - ss_between
    mean_range = float(max(group_means) - min(group_means)) if group_means else 0.0

    eta2 = ss_between / ss_total
    if n_values <= n_categories or ss_within < 0:
        omega2 = float('nan')
        f_stat = float('nan')
    else:
        ms_within = ss_within / (n_values - n_categories)
        ms_between = ss_between / (n_categories - 1) if n_categories > 1 else 0.0
        omega2 = (
            (ss_between - (n_categories - 1) * ms_within) / (ss_total + ms_within)
            if (ss_total + ms_within) > 0
            else float('nan')
        )
        f_stat = ms_between / ms_within if ms_within > 0 else float('inf')
    return (float(eta2), float(omega2), float(mean_range), float(f_stat))


def _r_squared(values: np.ndarray, predictor: np.ndarray) -> tuple[float, float, float]:
    """Return ``(r2, spearman_rho, spearman_p)`` for a numerical predictor.

    Args:
        values: Score vector.
        predictor: Numerical predictor vector.

    Returns:
        Tuple ``(r2, rho, p)``. All NaN if fewer than three finite pairs
        or if either vector has zero variance.
    """
    mask = ~(np.isnan(values) | np.isnan(predictor))
    values, predictor = values[mask], predictor[mask]
    if len(values) < 3 or np.std(predictor) == 0 or np.std(values) == 0:
        return (float('nan'), float('nan'), float('nan'))

    _slope, _intercept, r_value, _, _ = stats.linregress(predictor, values)
    r2 = float(r_value * r_value)
    rho, p_value = stats.spearmanr(predictor, values, nan_policy='omit')
    return (r2, float(rho), float(p_value))


# ---------------------------------------------------------------------------
# DuckDB introspection helpers.
# ---------------------------------------------------------------------------


def _view_column_kind(conn: duckdb.DuckDBPyConnection, column: str) -> str:
    """Report whether ``column`` lives in the ``obsnum`` or ``obscat`` view.

    Args:
        conn: Read-only DuckDB connection.
        column: Column name to look up.

    Returns:
        ``'num'`` if numeric, ``'cat'`` if categorical, ``'?'`` otherwise.
    """
    for view, kind in (('obsnum', 'num'), ('obscat', 'cat')):
        try:
            row = conn.execute(
                "SELECT COUNT(*) FROM information_schema.columns "
                "WHERE table_name = ? AND column_name = ?",
                [view, column],
            ).fetchone()
            if row and row[0]:
                return kind
        except Exception:
            pass
    return '?'


def _obsnum_score_columns(
    conn: duckdb.DuckDBPyConnection,
) -> list[tuple[str, str, str, str]]:
    """Enumerate legacy ``<study>::<experiment>::<module>`` score columns.

    These predate the ``.scores.parquet`` sidecar convention.

    Args:
        conn: Read-only DuckDB connection.

    Returns:
        List of ``(column_name, source, catalog, module)`` tuples with
        ``source='geneset'`` and ``catalog='<study>/<experiment>'``.
    """
    rows = conn.execute(
        "SELECT column_name FROM information_schema.columns "
        "WHERE table_name = '__obsnum' AND column_name LIKE '%::%::%'"
    ).fetchall()
    out: list[tuple[str, str, str, str]] = []
    for (col,) in rows:
        parts = col.split('::')
        if len(parts) != 3 or not all(parts):
            continue
        study, experiment, module = parts
        out.append((col, 'geneset', f'{study}/{experiment}', module))
    return out


# ---------------------------------------------------------------------------
# Cache path handling.
# ---------------------------------------------------------------------------


_SANITISE_RE = re.compile(r'[^A-Za-z0-9._-]+')


def _sanitise(name: str) -> str:
    """Turn a db_id or catalog id into a filesystem-safe token.

    Slashes / colons / spaces are replaced by ``__``; other unsafe chars
    collapse to ``_``. Empty inputs raise ``ValueError``.

    Args:
        name: Raw identifier (e.g. ``'M23/MIC'`` or ``'Sierksma2025/WGCNA'``).

    Returns:
        A safe token — e.g. ``'M23__MIC'``.

    Raises:
        ValueError: If ``name`` collapses to an empty string.
    """
    if not name:
        raise ValueError('empty identifier')
    token = _SANITISE_RE.sub('_', name.replace('/', '__').replace(':', '_'))
    token = token.strip('_')
    if not token:
        raise ValueError(f'identifier {name!r} sanitises to empty')
    return token


def _cache_root(h5adstore_root: Path) -> Path:
    """Cache directory root under the h5adstore."""
    return h5adstore_root / CACHE_DIRNAME


def _cache_file(
    h5adstore_root: Path, db_id: str, source: str, catalog: str,
) -> Path:
    """Cache file path for one (dataset, source, catalog) triple.

    Source is part of the key because a single catalog can carry
    multiple sources (e.g. ``geneset`` and ``aucell`` on the same
    ``Sierksma2025/WGCNA``) — sharing a cache file would let one
    overwrite the other.
    """
    return (
        _cache_root(h5adstore_root) / _sanitise(db_id)
        / f'{_sanitise(source)}__{_sanitise(catalog)}.parquet'
    )


def _mtime(path: Path) -> float:
    """Return ``path.stat().st_mtime`` or ``0.0`` if the file is absent."""
    try:
        return path.stat().st_mtime
    except FileNotFoundError:
        return 0.0


# ---------------------------------------------------------------------------
# Dataset-level metadata used by all workers.
