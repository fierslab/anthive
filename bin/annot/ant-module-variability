# CLI.
# ---------------------------------------------------------------------------


def _default_workers() -> int:
    """Half of the CPU count, capped at 8. Leaves room for ant-serve."""
    cpu_count = os.cpu_count() or 2
    return max(1, min(8, cpu_count // 2))


def main() -> int:
    """Entry point. See module docstring for CLI flags."""
    parser = argparse.ArgumentParser(prog='ant-module-variability')
    parser.add_argument('--h5adstore-root', default='data/h5adstore')
    parser.add_argument(
        '--only', default=None,
        help='comma-separated db_ids to process (else all)',
    )
    parser.add_argument(
        '--tags', default=None,
        help='comma-separated tag subset (else all)',
    )
    parser.add_argument(
        '--out', default=None,
        help='output parquet path (default: '
             '<h5adstore>/module_variability.parquet)',
    )
    parser.add_argument(
        '--force', action='store_true',
        help='ignore cache — recompute every pair from scratch',
    )
    parser.add_argument(
        '--workers', type=int, default=_default_workers(),
        help=f'parallel workers (default: {_default_workers()})',
    )
    parser.add_argument(
        '--no-prune', action='store_true',
        help='keep cache entries for pairs no longer active',
    )
    parser.add_argument('--dry-run', action='store_true')
    args = parser.parse_args()

    root = Path(args.h5adstore_root).resolve()
    only = set(args.only.split(',')) if args.only else None
    keep_tags: Optional[set[str]] = (
        set(args.tags.split(',')) if args.tags else None
    )
    out = (
        Path(args.out).resolve() if args.out
        else root / 'module_variability.parquet'
    )

    print(f'Scanning {root} for scored datasets…', file=sys.stderr)
    dataset_snapshot = _collect_dataset_snapshot(root)
    print(
        f'  found {len(dataset_snapshot)} scored dataset(s) '
        f'({sum(len(datasets.catalogs) for datasets in dataset_snapshot)} '
        f'pair(s) total)',
        file=sys.stderr,
    )

    jobs = list(_iter_pair_jobs(root, only, dataset_snapshot))
    if not jobs:
        print('no (dataset × catalog) pairs to process', file=sys.stderr)
        return 1

    _cache_root(root).mkdir(parents=True, exist_ok=True)

    workers = max(1, args.workers)
    print(
        f'Processing {len(jobs)} pair(s) with {workers} worker(s) '
        f'(force={args.force})',
        file=sys.stderr,
    )

    summary = RunSummary()
    total_pairs = len(jobs)
    completed = 0
    skipped_reasons: dict[str, str] = {}

    if workers == 1:
        result_iter = (_process_pair(job, args.force) for job in jobs)
    else:
        # spawn keeps workers hermetic; each opens its own DuckDB
        # connection (see :func:`_process_pair`) and DuckDB is not
        # fork-safe.
        ctx = multiprocessing.get_context('spawn')
        pool = ctx.Pool(processes=workers)
        result_iter = pool.imap_unordered(
            _process_pair_star, [(job, args.force) for job in jobs],
        )

    pbar = tqdm(
        total=total_pairs, desc='dataset × catalog',
        unit='pair', file=sys.stderr,
    )
    try:
        for result in result_iter:
            completed += 1
            pbar.update(1)
            tag = '[cached]' if result.from_cache else '[computed]'
            if result.error:
                summary.errored += 1
                summary.errors.append(
                    f'{result.db_id} × {result.catalog}: {result.error}'
                )
                tqdm.write(
                    f'[{completed}/{total_pairs}] '
                    f'{result.db_id} × {result.catalog} — ERROR: '
                    f'{result.error.splitlines()[0]}',
                    file=sys.stderr,
                )
            else:
                if result.skipped_reason:
                    skipped_reasons[result.db_id] = result.skipped_reason
                if result.from_cache:
                    summary.cached += 1
                else:
                    summary.processed += 1
                if result.n_rows == 0:
                    summary.empty_pairs += 1
                tqdm.write(
                    f'[{completed}/{total_pairs}] '
                    f'{result.db_id} × {result.catalog} '
                    f'— {result.elapsed_s:.2f}s — '
                    f'{result.n_rows} rows {tag}',
                    file=sys.stderr,
                )
            if completed % 10 == 0 or completed == total_pairs:
                _emit_progress_json(sys.stderr, completed, total_pairs, result)
    finally:
        pbar.close()
        if workers > 1:
            pool.close()
            pool.join()

    if summary.errored:
        print(
            f'\n{summary.errored} pair(s) failed — aborting aggregate write',
            file=sys.stderr,
        )
        for err in summary.errors[:5]:
            print(f'  {err}', file=sys.stderr)
        return 2

    if not args.no_prune:
        # ``dataset_snapshot`` is the fleet-wide inventory (``--only`` is
        # applied at pair-job dispatch, not at snapshot time), so the
        # active set is complete and pruning is safe even with ``--only``.
        active_triples = {
            (inputs.db_id, source, catalog)
            for inputs in dataset_snapshot
            for source, catalog in inputs.catalogs
        }
        pruned = _prune_stale_cache(root, active_triples)
        if pruned:
            print(f'pruned {pruned} stale cache file(s)', file=sys.stderr)

    if args.dry_run:
        print(f'\n[dry-run] would concat cache → {out}', file=sys.stderr)
        return 0

    cell_level_scope.merge_skip_summary(
        cell_level_scope.skip_summary_path(out),
        {job.db_id for job in jobs}, skipped_reasons,
    )
    if skipped_reasons:
        print(f'skipped {len(skipped_reasons)} out-of-scope dataset(s): '
              f'{", ".join(sorted(skipped_reasons))}', file=sys.stderr)
    print(f'\nConcatenating cache → {out}', file=sys.stderr)
    # Only include cache files that both (a) match a job we ran this
    # invocation and (b) actually exist on disk. Errored jobs and
    # `--only`-filtered pairs are excluded.
    cache_files = [
        job.cache_path for job in jobs if job.cache_path.exists()
    ]
    n_rows, n_datasets = _concat_and_write(root, out, cache_files, keep_tags)
    print(
        f'wrote {n_rows:,} rows across {n_datasets} dataset(s) → {out}',
        file=sys.stderr,
    )
    print(
        f'summary: processed={summary.processed} cached={summary.cached} '
        f'empty_pairs={summary.empty_pairs} errored={summary.errored}',
        file=sys.stderr,
    )
    return 0


def _process_pair_star(args_tuple: tuple[PairJob, bool]) -> PairResult:
    """Multiprocessing helper — unpacks the ``(job, force)`` tuple."""
    job, force = args_tuple
    return _process_pair(job, force)


if __name__ == '__main__':
    sys.exit(main())
