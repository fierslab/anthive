]


# ── Helpers ──────────────────────────────────────────────────────────────────

def _resolve_gene_case(panel: List[str], gene_set: Set[str], organism: str) -> List[str]:
    """Translate a human-uppercase panel to whatever case actually exists in
    the dataset.  Falls back to title-case for mouse.  Drops genes that are
    absent so the proposal only lists genes the user can actually plot."""
    out: List[str] = []
    gene_set_upper = {g.upper(): g for g in gene_set}
    is_mouse = organism and 'mus' in organism.lower()
    for canonical in panel:
        # Try canonical first (works for human)
        hit = gene_set_upper.get(canonical.upper())
        if hit:
            out.append(hit)
            continue
        # Mouse title-case fallback (P2RY12 -> P2ry12)
        if is_mouse:
            title = canonical.capitalize() if '-' not in canonical else canonical
            # Search in the actual gene set
            for g in gene_set:
                if g.upper() == canonical.upper() or g == title:
                    out.append(g)
                    break
    # De-dup preserving order
    seen: Set[str] = set()
    deduped: List[str] = []
    for g in out:
        if g not in seen:
            seen.add(g)
            deduped.append(g)
    return deduped


def _pick_top_cat(obscat_cols: List[str], k: int = 4) -> List[str]:
    """Pick up to k obs categorical columns by priority order."""
    available = set(obscat_cols)
    picked: List[str] = []
    seen: Set[str] = set()
    for candidate in TOP_CAT_PRIORITY:
        if candidate in available and candidate not in seen:
            picked.append(candidate)
            seen.add(candidate)
            if len(picked) >= k:
                return picked
    return picked


def _pick_top_num(obsnum_cols: List[str], k: int = 4) -> List[str]:
    """Pick up to k obs numerical columns; prefer module scores."""
    cols_lower = {c.lower(): c for c in obsnum_cols}
    picked: List[str] = []
    seen: Set[str] = set()

    # Pattern hits first — module scores are the most biology-relevant
    for pattern in TOP_NUM_PRIORITY_PATTERNS:
        for col in obsnum_cols:
            if pattern.lower() in col.lower() and col not in seen:
                picked.append(col)
                seen.add(col)
                if len(picked) >= k:
                    return picked

    # Exact-match fallback
    for candidate in TOP_NUM_PRIORITY_EXACT:
        if candidate in cols_lower.values() and candidate not in seen:
            picked.append(candidate)
            seen.add(candidate)
            if len(picked) >= k:
                return picked
        elif candidate.lower() in cols_lower and cols_lower[candidate.lower()] not in seen:
            actual = cols_lower[candidate.lower()]
            picked.append(actual)
            seen.add(actual)
            if len(picked) >= k:
                return picked

    return picked


def _propose_top_genes(celltype: Optional[str],
                       disease: Optional[List[str]],
                       gene_set: Set[str],
                       organism: str,
                       k: int = 10) -> List[str]:
    """Build the top_genes proposal for one dataset."""
    panel: List[str] = []
    celltype_lc = (celltype or '').strip().lower()
    base = MARKERS_BY_CELLTYPE.get(celltype_lc, DEFAULT_PANEL)

    # Disease boost: prepend disease-specific markers when relevant.
    for dis in (disease or []):
        dis_lc = dis.strip().lower()
        boost = DISEASE_GENES.get(dis_lc)
        if boost:
            panel.extend(boost)

    # Then add the cell-type panel.
    panel.extend(base)

    # De-dup + case-resolve against the actual gene list.
    resolved = _resolve_gene_case(panel, gene_set, organism)
    return resolved[:k]


def _load_duckdb_schema(duckdb_path: Path) -> Tuple[Set[str], List[str], List[str]]:
    """Return (gene_name_set, obscat_columns, obsnum_columns) from a duckdb.

    Read-only mode so we don't interfere with ant-serve.  Older conversions
    can omit the __obscat or __obsnum table entirely (e.g. proteomics
    datasets with no per-cell metadata) — we degrade to empty lists for
    whichever table is missing rather than failing the whole file."""
    conn = duckdb.connect(str(duckdb_path), read_only=True)
    try:
        gene_rows = conn.execute("SELECT gene_name FROM __genes").fetchall()
        gene_set = {row[0] for row in gene_rows}

        def _safe_describe(table: str) -> List[str]:
            try:
                rows = conn.execute(f"DESCRIBE {table}").fetchall()
            except duckdb.CatalogException:
                return []
            return [row[0] for row in rows if row[0] != 'cell_id']

        obscat_cols = _safe_describe('__obscat')
        obsnum_cols = _safe_describe('__obsnum')
    finally:
        conn.close()
    return gene_set, obscat_cols, obsnum_cols


def _mus_annotation(h5ad_path: Path) -> Dict[str, Any]:
    """Resolve organism / celltype / disease / tissue via the mus cascade.

    `resolve_annotation` expects the .h5ad path (not the .mus sidecar) so
    it can derive both the cascade root and the sidecar path correctly.
    Returns a flat dict, scalars unwrapped from any {value, source} wrappers.
    """
    if not h5ad_path.exists():
        # Fall back to parsing the .mus sidecar directly if the .h5ad has
        # been moved/deleted — we still want the annotation it carries.
        sidecar = h5ad_path.parent / (h5ad_path.name + '.mus')
        if not sidecar.exists():
            return {}
        return dict(_mus.parse_mus_file(sidecar))
    try:
        res = _mus.resolve_annotation(h5ad_path)
    except Exception:
        return {}
    if not res:
        return {}
    flat: Dict[str, Any] = {}
    for key, payload in res.items():
        if isinstance(payload, dict) and 'value' in payload:
            flat[key] = payload['value']
        else:
            flat[key] = payload
    return flat


# ── Main per-file routine ────────────────────────────────────────────────────

def _process_one(md_path: Path, force: bool, dry_run: bool) -> Optional[Dict[str, Any]]:
    """Update one .md.  Returns a report dict or None if skipped."""
    yaml_dict, body = _md.parse_md_file(md_path)
    if not yaml_dict:
        return {'path': str(md_path), 'status': 'skip', 'reason': 'no yaml'}

    # Skip index.md — those are collection-level, no per-dataset duckdb.
    if md_path.name == 'index.md':
        return {'path': str(md_path), 'status': 'skip', 'reason': 'collection index'}

    # Already populated and not forcing → skip.
    existing_genes = yaml_dict.get('top_genes')
    if existing_genes and isinstance(existing_genes, list) and not force:
        return {'path': str(md_path), 'status': 'skip',
                'reason': f'top_genes already set ({len(existing_genes)} entries)'}

    stem = md_path.stem
    folder = md_path.parent
    duckdb_path = folder / f"{stem}.duckdb"
    h5ad_path   = folder / f"{stem}.h5ad"

    if not duckdb_path.exists():
        return {'path': str(md_path), 'status': 'skip',
                'reason': f'no sibling duckdb at {duckdb_path.name}'}

    try:
        gene_set, obscat_cols, obsnum_cols = _load_duckdb_schema(duckdb_path)
    except Exception as e:
        return {'path': str(md_path), 'status': 'error',
                'reason': f'duckdb read failed: {e}'}

    annot = _mus_annotation(h5ad_path)
    # mus values can be scalars OR lists (cascade list-fields). Flatten both
    # organism and celltype to a single str; keep disease as a list.
    organism = annot.get('organism', '')
    if isinstance(organism, list):
        organism = organism[0] if organism else ''
    celltype = annot.get('cell_type') or annot.get('celltype')
    if isinstance(celltype, list):
        celltype = celltype[0] if celltype else None
    disease = annot.get('disease') or []
    if isinstance(disease, str):
        disease = [disease]

    top_genes = _propose_top_genes(celltype, disease, gene_set, organism)
    top_cat   = _pick_top_cat(obscat_cols)
    top_num   = _pick_top_num(obsnum_cols)

    report = {
        'path': str(md_path),
        'status': 'ok',
        'celltype': celltype,
        'organism': organism,
        'disease': disease,
        'n_genes_in_db': len(gene_set),
        'top_genes_proposed': top_genes,
        'top_cat_proposed':   top_cat,
        'top_num_proposed':   top_num,
        'n_obscat': len(obscat_cols),
        'n_obsnum': len(obsnum_cols),
    }

    if not top_genes:
        report['warning'] = 'no genes resolved — panel did not match dataset'

    if dry_run:
        return report

    # Write back to the .md.  We preserve order by only touching these 3 keys.
    yaml_dict['top_genes'] = top_genes if top_genes else None
    yaml_dict['top_cat']   = top_cat   if top_cat   else None
    yaml_dict['top_num']   = top_num   if top_num   else None
    _md.write_md_file(md_path, yaml_dict, body)
    return report


# ── CLI ──────────────────────────────────────────────────────────────────────

def main() -> int:
    parser = argparse.ArgumentParser(
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description=__doc__,
    )
    parser.add_argument('--all', action='store_true', default=True,
                        help='process every dataset-level .md (default)')
    parser.add_argument('--dry-run', action='store_true',
                        help="don't write, just print proposed values")
    parser.add_argument('--force', action='store_true',
                        help='overwrite even when top_genes is already set')
    parser.add_argument('--glob', default=None,
                        help='restrict to .md paths matching this glob, '
                             'relative to data/h5adstore/')
    args = parser.parse_args()

    store_root = Path('data/h5adstore').resolve()
    if not store_root.exists():
        print(f"data/h5adstore not found (cwd: {Path.cwd()})", file=sys.stderr)
        return 1

    if args.glob:
        md_files = sorted(store_root.glob(args.glob))
    else:
        md_files = sorted(store_root.glob('*/*.md'))

    if not md_files:
        print("No .md files found.", file=sys.stderr)
        return 1

    n_ok, n_skip, n_err = 0, 0, 0
    for md_path in md_files:
        # Skip staging / archive folders (leading underscore)
        if any(part.startswith('_') for part in md_path.parts):
            continue
        report = _process_one(md_path, force=args.force, dry_run=args.dry_run)
        if report is None:
            continue
        status = report['status']
        rel = md_path.relative_to(store_root)
        if status == 'ok':
            n_ok += 1
            top_genes = report.get('top_genes_proposed', [])
            top_cat   = report.get('top_cat_proposed', [])
            top_num   = report.get('top_num_proposed', [])
            print(f"OK  {rel}")
            print(f"    celltype={report.get('celltype')!r}  "
                  f"organism={report.get('organism')!r}  "
                  f"disease={report.get('disease')!r}")
            print(f"    top_genes ({len(top_genes)}):  {', '.join(top_genes)}")
            print(f"    top_cat   ({len(top_cat)}):    {', '.join(top_cat)}")
            print(f"    top_num   ({len(top_num)}):    {', '.join(top_num)}")
            if report.get('warning'):
                print(f"    !! {report['warning']}")
        elif status == 'skip':
            n_skip += 1
            print(f"SKIP {rel}  ({report['reason']})")
        else:
            n_err += 1
            print(f"ERR  {rel}  ({report['reason']})")

    print()
    mode = '(dry-run)' if args.dry_run else ''
    print(f"=== summary {mode}")
    print(f"  updated: {n_ok}")
    print(f"  skipped: {n_skip}")
    print(f"  errors:  {n_err}")
    return 0 if n_err == 0 else 2


if __name__ == '__main__':
    sys.exit(main())
