def normalize_sex(value: Any) -> Optional[str]:
    """Map an ant_sex value to 'f' / 'm'; everything else is None."""
    if value is None or (isinstance(value, float) and math.isnan(value)):
        return None
    text = str(value).strip().lower()
    if text in ('f', 'female', 'woman', 'xx'):
        return 'f'
    if text in ('m', 'male', 'man', 'xy'):
        return 'm'
    return None


_AD_TOKENS = {'ad', "alzheimer's disease", 'alzheimer disease', 'alzheimers disease',
              'alzheimer', 'alzheimers'}
_CONTROL_TOKENS = {'control', 'ctrl', 'normal', 'healthy', 'healthy control', 'non-ad',
                   'not ad', 'nci_control'}


def normalize_disease(value: Any) -> Optional[str]:
    """Map an ant_disease value to 'AD' / 'control'; every other value is None.

    Compound labels (AD_DLBD, AD_vascular, ...) are deliberately dropped:
    audit decision L21 is open and v1 tests plain AD against control only.
    """
    if value is None or (isinstance(value, float) and math.isnan(value)):
        return None
    text = str(value).strip().lower()
    if text in _AD_TOKENS:
        return 'AD'
    if text in _CONTROL_TOKENS:
        return 'control'
    return None


def normalize_app_nlgf(value: Any) -> Optional[str]:
    """Map an ant_app_nlgf value to 'nlgf' / 'control'; everything else is None."""
    if value is None or (isinstance(value, float) and math.isnan(value)):
        return None
    text = str(value).strip().lower()
    return text if text in ('nlgf', 'control') else None


def derive_apoe4_carrier_from_genotype(value: Any) -> Optional[str]:
    """e4 carrier / non-carrier from an APOE genotype string (33, E3/E4, e4e4...)."""
    if value is None or (isinstance(value, float) and math.isnan(value)):
        return None
    text = str(value).strip().lower()
    if text in ('', 'nan', 'na', 'n/a', 'unknown', 'unk', 'none'):
        return None
    digits = re.findall(r'[234]', text)
    if len(digits) == 2:
        return 'e4_carrier' if '4' in digits else 'noncarrier'
    return None


def normalize_apoe4_carrier(value: Any) -> Optional[str]:
    """Map an ant_apoe4_carrier value to 'e4_carrier' / 'noncarrier' / None."""
    if value is None or (isinstance(value, float) and math.isnan(value)):
        return None
    text = str(value).strip().lower()
    if text in ('carrier', 'e4_carrier', 'e4 carrier', 'apoe4 carrier', 'apoe4+', 'e4+',
                'yes', 'true', '1', '1.0', 'positive', 'apoe4_carrier', 'e4'):
        return 'e4_carrier'
    if text in ('noncarrier', 'non-carrier', 'non_carrier', 'e4_noncarrier', 'non carrier',
                'no', 'false', '0', '0.0', 'negative', 'apoe4_noncarrier', 'non-e4',
                'e4_non_carrier', 'e4 non-carrier', 'apoe4-', 'e4-', 'non-apoe4'):
        return 'noncarrier'
    return None


