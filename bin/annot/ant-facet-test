def datasets_from_results(out_root: Path, store_root: Path) -> List[Dict[str, Any]]:
    """Dataset dicts (as ``FacetResults`` expects them) for every gene run manifest under ``out_root``.

    ``supplementary_all_donors`` folders and the donor-pooled ``_pooled`` folder are not datasets of
    the catalogue (pools are added by the reader itself). ``is_secondary`` comes from the dataset
    ``.md`` when it can be found.
    """
    datasets: List[Dict[str, Any]] = []
    entries = {e.db_id: e for e in iter_h5adstore(store_root) if not e.study.startswith('_')}
    for path in sorted(out_root.glob('*/*.facet_run_manifest.json')):
        if path.parent.name.startswith('_'):
            continue
        manifest = json.loads(path.read_text())
        db_id = manifest.get('db_id')
        if not db_id or manifest.get('status') != 'done':
            continue
        entry = entries.get(db_id)
        is_secondary = False
        if entry is not None:
            is_secondary = parse_md_file(entry.md_path)[0].get('is_secondary') is True
        datasets.append({'db_id': db_id, 'group_folder': path.parent.name, 'stem': manifest['file'],
                         'title': db_id, 'is_secondary': is_secondary})
    return datasets


def summarize_replication(out_root: Path, store_root: Path, out_dir: Path, genes: List[str],
                          facets: Optional[List[str]] = None) -> pd.DataFrame:
    """Replication tables over all gene results (exploratory), per facet scope, written to ``out_dir``.

    * ``replication_summary.tsv``: per facet scope x facet x cell type group: counted cohorts and units, genes
      testable in at least two cohorts, genes with r < 0.05, replicated genes (r < 0.05 and the effect gate; up /
      down), genes with k >= 2 (two cohorts individually q_value < 0.05 in one direction), cohorts;
    * ``replicated_<scope>_<facet>_<group>.tsv``: the replicated genes (r_value, p_pc, k, m, direction, median_logFC,
      effect gate);
    * ``candidates.tsv``: the requested ``genes`` in every scope x facet x group where they were testable;
    * ``units.tsv``: every tested unit with its scope, cohort, anchor flag, reason, analysis level and replicates.

    Returns the summary frame.
    """
    out_dir.mkdir(parents=True, exist_ok=True)
    reader = facet_results.FacetResults(out_root)
    datasets = datasets_from_results(out_root, store_root)
    summary_rows: List[Dict[str, Any]] = []
    candidate_rows: List[Dict[str, Any]] = []
    unit_rows: List[Dict[str, Any]] = []
    wanted = {gene.upper() for gene in genes}
    for facet in facets or list(FACETS):
        for scope in reader.scopes_with_results(facet, datasets):
            rows, units = reader.facet_gene_table(facet, datasets, scope)
            if len(units):
                counted = reader.counting_units(units, True, facet)
                for record in counted.to_dict(orient='records'):
                    unit_rows.append({
                        'facet_scope': scope, 'facet': facet, 'db_id': record['db_id'], 'cell_type': record['cell_type'],
                        'celltype_source': record['celltype_source'], 'celltype_group': record['celltype_group'],
                        'cohort': record.get('cohort'), 'anchor': bool(record['counted_effective']),
                        'not_counted_reason': facet_results._not_counted_reason(record),
                        'analysis_level': record.get('analysis_level'), 'n_donors': record.get('n_donors'),
                        'disease_basis': record.get('disease_basis'), 'independence': record.get('independence')})
            for group, family in reader.replication_families(facet, datasets, True, scope).items():
                frame = family['frame']
                usable = frame[frame['r_value'].notna()]
                replicated = usable[usable['replicated'].astype(bool)]
                cohorts = sorted(family['units']['cohort_label'].dropna().unique())
                summary_rows.append({
                    'facet_scope': scope, 'facet': facet, 'celltype_group': group, 'n_cohorts': len(cohorts),
                    'n_anchor_units': int(len(family['units'])), 'genes_in_family': int(len(usable)),
                    'r_below_05': int((usable['r_value'] < 0.05).sum()),
                    'replicated': int(len(replicated)),
                    'replicated_up': int((replicated['r_direction'] == 'up').sum()),
                    'replicated_down': int((replicated['r_direction'] == 'down').sum()),
                    'genes_k_ge2': int((frame['k'] >= 2).sum()), 'cohorts': ';'.join(cohorts)})
                if len(replicated):
                    replicated.sort_values('r_value')[['gene', 'r_value', 'p_pc', 'k', 'm', 'r_direction', 'agreement',
                                                       'median_logFC', 'effect_gate_tau',
                                                       'median_abs_logFC']].to_csv(
                        out_dir / f'replicated_{scope}_{facet}_{group.replace(" ", "_").replace("/", "-")}.tsv',
                        sep='\t', index=False)
                for gene_key in wanted & set(frame.index):
                    record = frame.loc[gene_key]
                    candidate_rows.append({
                        'facet_scope': scope, 'facet': facet, 'celltype_group': group, 'gene': record['gene'],
                        'r_value': record['r_value'], 'p_pc': record['p_pc'], 'k': int(record['k']),
                        'm': int(record['m']), 'direction': record['r_direction'],
                        'median_logFC': record['median_logFC'], 'effect_gate_passed': bool(record['effect_gate_passed']),
                        'replicated': bool(record['replicated'])})
    summary = pd.DataFrame(summary_rows)
    summary.to_csv(out_dir / 'replication_summary.tsv', sep='\t', index=False)
    pd.DataFrame(candidate_rows).to_csv(out_dir / 'candidates.tsv', sep='\t', index=False)
    pd.DataFrame(unit_rows).to_csv(out_dir / 'units.tsv', sep='\t', index=False)
    return summary


def cmd_summarize(args: argparse.Namespace) -> None:
    store_root = Path(args.h5adstore_root).resolve()
    out_root = Path(args.out_root) if args.out_root else store_root / '_facet_tests'
    genes = [g.strip() for g in args.genes.split(',') if g.strip()] if args.genes else []
    summary = summarize_replication(out_root, store_root, Path(args.out_dir), genes)
    print(summary.drop(columns='cohorts').to_string(index=False))


def cmd_run(args: argparse.Namespace) -> None:
    store_root = Path(args.h5adstore_root).resolve()
    out_root = Path(args.out_root) if args.out_root else store_root / '_facet_tests'
    facets = [f.strip() for f in args.facets.split(',') if f.strip()]
    for facet in facets:
        if facet not in FACETS:
            sys.exit(f'unknown facet {facet}; choose from {FACETS}')
    if (args.exclude_donors_from or args.exclude_donors_where) and not args.out_root:
        sys.exit('--exclude-donors-from / --exclude-donors-where need an explicit --out-root '
                 '(the counted run takes its exclusions from the .md facet_donor_exclusions rule)')
    if args.all_donors and (args.exclude_donors_from or args.exclude_donors_where):
        sys.exit('--all-donors cannot be combined with command line exclusions')
    if not (args.all or args.db_id or args.pool):
        sys.exit('give --db-id, --pool or --all')
    entries = {e.db_id: e for e in iter_h5adstore(store_root) if not e.study.startswith('_')}
    if args.all:
        targets = sorted(entries)
    else:
        targets = [t.strip() for t in (args.db_id or '').split(',') if t.strip()]
    summary_rows = []
    for db_id in targets:
        entry = entries.get(db_id)
        if entry is None:
            print(f'unknown db_id {db_id}', file=sys.stderr)
            continue
        # cheap metadata gate first, so skipped datasets do not wait for load
        md_yaml, _ = parse_md_file(entry.md_path)
        rule_in_md = donor_exclusions.rule_from_md(md_yaml) is not None
        if args.all_donors and not rule_in_md:
            print(f'[skip] {db_id}: --all-donors needs a facet_donor_exclusions rule in the .md')
            continue
        out_manifest = (donor_exclusions.result_dir(out_root, entry.study, rule_in_md, args.all_donors)
                        / f'{entry.stem}.facet_run_manifest.json')
        if not args.force and args.all and manifest_is_current(out_manifest, entry.md_path):
            print(f'[skip existing] {db_id}')
            continue
        eligible, reason = dataset_eligibility(
            entry, md_yaml, mus.resolve_annotation(entry.h5ad_path, root=store_root),
            get_api_config(md_yaml))
        if not eligible:
            print(f'[skip] {db_id}: {reason}')
            summary_rows.append({'db_id': db_id, 'status': 'skipped', 'reason': reason})
            continue
        wait_for_load(args.max_load)
        begin = time.time()
        try:
            manifest = process_dataset(entry, store_root, out_root, facets, args.rscript,
                                       threads=args.threads, memory_limit_gb=args.memory_gb,
                                       keep_work=args.keep_work,
                                       exclusion_from=args.exclude_donors_from,
                                       exclusion_where=args.exclude_donors_where,
                                       all_donors=args.all_donors, tau_two_group=args.tau_two_group,
                                       tau_braak_per_stage=args.tau_braak_per_stage,
                                       tau_age_per_decade=args.tau_age_per_decade, age_floor=args.age_floor)
        except Exception as exc:
            print(f'[error] {db_id}: {exc}', file=sys.stderr)
            summary_rows.append({'db_id': db_id, 'status': 'error', 'reason': str(exc)[:300]})
            continue
        if manifest['status'] == 'skipped':
            print(f'[skip] {db_id}: {manifest["reason"]}')
            out_manifest.parent.mkdir(parents=True, exist_ok=True)
            out_manifest.write_text(json.dumps(manifest, indent=2, default=_json_default))
        else:
            n_ok = sum(1 for u in manifest['units'] if u['status'] == 'ok')
            print(f'[done] {db_id}: {n_ok}/{len(manifest["units"])} units tested, '
                  f'{manifest.get("n_result_rows", 0)} rows, {time.time() - begin:.0f}s')
        summary_rows.append({'db_id': db_id, 'status': manifest['status'],
                             'reason': manifest.get('reason', '')})
    if not args.all_donors:
        summary_rows.extend(run_pools(args, store_root, out_root, facets, entries))
    print(pd.DataFrame(summary_rows)['status'].value_counts().to_string() if summary_rows else 'nothing run')


def run_pools(args: argparse.Namespace, store_root: Path, out_root: Path, facets: List[str],
              entries: Dict[str, H5adEntry]) -> List[Dict[str, Any]]:
    """Run the donor-pooled units named by ``--pool`` (all of them with ``--all``).

    Pools are defined by the ``pool_members`` column of the cohort table (one
    row per pool, comma-separated member db_ids; see
    ``facet_results.pool_definitions``). A pool is skipped without ``--force``
    when its manifest records the current md hashes of all members.
    """
    definitions = facet_results.pool_definitions(out_root)
    if args.pool:
        wanted = [p.strip() for p in args.pool.split(',') if p.strip()]
    elif args.all:
        wanted = sorted(definitions)
    else:
        return []
    rows: List[Dict[str, Any]] = []
    for pool_id in wanted:
        member_ids = definitions.get(pool_id)
        if not member_ids:
            print(f'unknown pool {pool_id}', file=sys.stderr)
            continue
        members = [entries[m] for m in member_ids if m in entries]
        out_manifest = out_root / POOLED_DIRNAME / f'{pool_id}.facet_run_manifest.json'
        if not args.force and args.all and pool_manifest_current(out_manifest, members):
            print(f'[skip existing] pool:{pool_id}')
            continue
        wait_for_load(args.max_load)
        begin = time.time()
        try:
            manifest = process_pool(pool_id, members, store_root, out_root, facets, args.rscript,
                                    threads=args.threads, memory_limit_gb=args.memory_gb,
                                    keep_work=args.keep_work, tau_two_group=args.tau_two_group,
                                    tau_braak_per_stage=args.tau_braak_per_stage,
                                    tau_age_per_decade=args.tau_age_per_decade, age_floor=args.age_floor)
        except Exception as exc:
            print(f'[error] pool:{pool_id}: {exc}', file=sys.stderr)
            rows.append({'db_id': f'pool:{pool_id}', 'status': 'error', 'reason': str(exc)[:300]})
            continue
        if manifest['status'] == 'skipped':
            print(f'[skip] pool:{pool_id}: {manifest["reason"]}')
            out_manifest.parent.mkdir(parents=True, exist_ok=True)
            out_manifest.write_text(json.dumps(manifest, indent=2, default=_json_default))
        else:
            n_ok = sum(1 for u in manifest['units'] if u['status'] == 'ok')
            print(f'[done] pool:{pool_id}: {n_ok}/{len(manifest["units"])} units tested, '
                  f'{manifest.get("n_result_rows", 0)} rows, {time.time() - begin:.0f}s')
        rows.append({'db_id': f'pool:{pool_id}', 'status': manifest['status'], 'reason': manifest.get('reason', '')})
    return rows


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__.split('\n')[0])
    sub = parser.add_subparsers(dest='command', required=True)
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument('--h5adstore-root', default=None)
    inventory = sub.add_parser('inventory', parents=[common], help='metadata-level eligibility table')
    inventory.add_argument('--out', default=None)
    summarize = sub.add_parser('summarize', parents=[common], help='replication tables over all gene results')
    summarize.add_argument('--out-dir', required=True)
    summarize.add_argument('--out-root', default=None, help='default <h5adstore>/_facet_tests')
    summarize.add_argument('--genes', default=None, help='comma-separated candidate genes for candidates.tsv')
    run = sub.add_parser('run', parents=[common], help='run facet tests')
    group = run.add_mutually_exclusive_group()
    group.add_argument('--db-id', help='comma-separated db_ids (e.g. K22/AST)')
    group.add_argument('--all', action='store_true')
    run.add_argument('--facets', default=','.join(FACETS))
    run.add_argument('--out-root', default=None, help='default <h5adstore>/_facet_tests')
    run.add_argument('--rscript', default=os.environ.get('ANT_FACET_RSCRIPT', DEFAULT_RSCRIPT))
    run.add_argument('--threads', type=int, default=4)
    run.add_argument('--memory-gb', type=int, default=24)
    run.add_argument('--max-load', type=float, default=12.0)
    run.add_argument('--force', action='store_true')
    run.add_argument('--pool', default=None, help='comma-separated pool ids of the cohort table '
                     '(column pool_members); with --all every pool runs after the datasets')
    run.add_argument('--tau-two-group', type=float, default=TAU_TWO_GROUP,
                     help='treat threshold, log2 fold change, two-group contrasts (default log2(1.1))')
    run.add_argument('--tau-braak-per-stage', type=float, default=TAU_BRAAK_PER_STAGE,
                     help='treat threshold per Braak stage, log2 (default log2(1.1)/3)')
    run.add_argument('--tau-age-per-decade', type=float, default=TAU_AGE_PER_DECADE,
                     help='treat threshold per decade of age, log2 (default log2(1.1))')
    run.add_argument('--age-floor', type=float, default=AGE_FACET_MIN_AGE,
                     help='donors younger than this (years) leave the age facets; a dataset facet_min_age.age wins '
                          '(default 60, pending a decision)')
    run.add_argument('--keep-work', action='store_true', help='keep the temp work dir (debug)')
    donor_exclusions.add_cli_arguments(run)
    return parser


def main() -> None:
    args = build_parser().parse_args()
    if args.h5adstore_root is None:
        args.h5adstore_root = str(default_store_root())
    {'inventory': cmd_inventory, 'run': cmd_run, 'summarize': cmd_summarize}[args.command](args)


if __name__ == '__main__':
    main()
