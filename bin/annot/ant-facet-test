# --------------------------------------------------------------------------

def _single_value(series: pd.Series) -> Tuple[Any, bool]:
    """(value, conflicting). value None when all NULL or conflicting."""
    unique = series.dropna().unique()
    if len(unique) == 0:
        return None, False
    if len(unique) == 1:
        return unique[0], False
    return None, True


def build_donor_table(cells: pd.DataFrame, design_columns: Optional[Dict[str, Any]] = None
                      ) -> Tuple[pd.DataFrame, Dict[str, int]]:
    """One row per replicate (donor, animal, sample) with normalised facet values and covariates.

    Args:
        cells: per-cell frame with ant_donor (the replicate column, see ``process_target``) and any
            of ant_sex, ant_host_sex, ant_disease, ant_apoe4_carrier (or the old ant_apoe_carrier),
            ant_apoe, ant_app_nlgf, ant_braak, ant_age, ant_pmi, batch.

    Returns:
        (donor table, conflict counts per column). A replicate whose cells carry
        more than one distinct value for a facet gets NULL for it and is
        counted as conflicting (never silently picked). The table has ``sex``,
        ``host_sex``, ``disease``, ``apoe4_carrier``, ``app_nlgf`` (text) and ``braak``, ``age``,
        ``pmi`` (numbers). ``design_columns`` (``timepoint``: column, ``graft_line``: column,
        ``covariates``: [columns]) adds the text columns ``timepoint``, ``graft_line`` and ``design_cov`` (the
        covariate values joined by ``|``); a replicate with two values gets NULL.
    """
    cells = cells[cells['ant_donor'].notna()].copy()
    cells['ant_donor'] = cells['ant_donor'].astype(str)
    conflicts: Dict[str, int] = {}
    records: List[Dict[str, Any]] = []
    grouped = cells.groupby('ant_donor', sort=True)
    for donor, frame in grouped:
        record: Dict[str, Any] = {'donor': donor, 'n_cells_total': len(frame)}
        for facet_name, column, normaliser in (
                ('sex', 'ant_sex', normalize_sex),
                ('host_sex', 'ant_host_sex', normalize_sex),
                ('app_nlgf', 'ant_app_nlgf', normalize_app_nlgf),
                ('disease', 'ant_disease', normalize_disease)):
            if column in frame:
                raw = frame[column].map(lambda v: normaliser(v))
                value, conflict = _single_value(raw)
                record[facet_name] = value
                if conflict:
                    conflicts[facet_name] = conflicts.get(facet_name, 0) + 1
            else:
                record[facet_name] = None
        # apoe carrier: carrier column first, derive from genotype otherwise
        carrier_series = None
        carrier_column = next((column for column in APOE4_CARRIER_COLUMNS
                               if column in frame and frame[column].notna().any()), None)
        if carrier_column is not None:
            carrier_series = frame[carrier_column].map(normalize_apoe4_carrier)
        elif 'ant_apoe' in frame:
            carrier_series = frame['ant_apoe'].map(derive_apoe4_carrier_from_genotype)
        if carrier_series is not None:
            value, conflict = _single_value(carrier_series)
            record['apoe4_carrier'] = value
            if conflict:
                conflicts['apoe4_carrier'] = conflicts.get('apoe4_carrier', 0) + 1
        else:
            record['apoe4_carrier'] = None
        for facet_name, column in (('braak', 'ant_braak'), ('age', 'ant_age'), ('pmi', 'ant_pmi')):
            if column in frame:
                numeric = pd.to_numeric(frame[column], errors='coerce')
                unique = numeric.dropna().unique()
                if len(unique) == 1:
                    record[facet_name] = float(unique[0])
                elif len(unique) == 0:
                    record[facet_name] = np.nan
                else:
                    record[facet_name] = np.nan
                    if facet_name == 'braak':
                        conflicts['braak'] = conflicts.get('braak', 0) + 1
                    else:
                        # age / pmi may legitimately vary per sample: use the mean
                        record[facet_name] = float(np.nanmean(unique))
            else:
                record[facet_name] = np.nan
        for role, column in (('timepoint', (design_columns or {}).get('timepoint')),
                             ('graft_line', (design_columns or {}).get('graft_line'))):
            if column and column in frame:
                value, _ = _single_value(frame[column].astype(object).where(frame[column].notna(), None).map(
                    lambda v: None if v is None else str(v)))
                record[role] = value
            else:
                record[role] = None
        parts = []
        for column in (design_columns or {}).get('covariates') or []:
            value, _ = _single_value(frame[column].map(lambda v: None if pd.isna(v) else str(v))) \
                if column in frame else (None, False)
            parts.append(value)
        record['design_cov'] = None if (not parts or any(p is None for p in parts)) else '|'.join(parts)
        if 'batch' in frame:
            unique = frame['batch'].dropna().unique()
            record['batch'] = str(unique[0]) if len(unique) == 1 else None
        else:
            record['batch'] = None
        n_places = [int(frame[c].dropna().nunique()) for c in ('ant_tissue', 'ant_region') if c in frame]
        record['n_tissues'] = max(n_places) if n_places else 0
        records.append(record)
    return pd.DataFrame.from_records(records), conflicts


# --------------------------------------------------------------------------
# Cell-type stratifier
# --------------------------------------------------------------------------

def choose_strata(cells: pd.DataFrame, categorical_columns: Dict[str, str]
                  ) -> Tuple[pd.DataFrame, str]:
    """Cell type strata as a long (cell position, source, label) membership table.

    * ant_cell_type varies per cell: that column only (source 'ant_cell_type').
    * ant_cell_type is a constant (a dataset descriptor, e.g. "astrocyte"):
      two stratifier sets, because the constant can be wrong for a mixed file
      (audit L32) and per-cell subtypes can be expression-defined states:
      (a) one all-cells stratum labelled with the constant, source
      'constant_all_cells'; (b) when the dataset has a per-cell cell type
      column (ant_author_cell_type first, then an author column named like
      cell_type / class / annotation, 2..MAX_STRATUM_LEVELS levels) one
      stratum per level, source = that column name.
    * ant_cell_type absent: only (b); when no such column exists, ant_author_cluster
      (2..MAX_STRATUM_LEVELS levels) as a last resort; else a single 'all' stratum
      (source 'none': all cells pooled, not cell type specific).

    Returns (membership frame with columns pos, source, label; note).
    """
    positions = np.arange(len(cells))
    pieces: List[pd.DataFrame] = []
    notes: List[str] = []
    varying = 'ant_cell_type' in cells and cells['ant_cell_type'].nunique(dropna=True) > 1
    if varying:
        labels = cells['ant_cell_type']
        pieces.append(pd.DataFrame({'pos': positions, 'source': 'ant_cell_type',
                                    'label': labels.astype('object').to_numpy()}))
        notes.append('ant_cell_type per cell')
    else:
        constant = None
        if 'ant_cell_type' in cells and cells['ant_cell_type'].nunique(dropna=True) == 1:
            constant = str(cells['ant_cell_type'].dropna().iloc[0])
        if constant is not None:
            pieces.append(pd.DataFrame({'pos': positions, 'source': 'constant_all_cells',
                                        'label': constant}))
            notes.append(f'ant_cell_type constant ({constant})')
        candidates = ['ant_author_cell_type'] + [
            c for c in categorical_columns
            if c not in ('ant_author_cell_type', 'ant_cell_type') and not c.startswith('ant_')
            and CELLTYPE_CANDIDATE_RE.match(c)]
        for column in candidates:
            if column in cells:
                levels = cells[column].nunique(dropna=True)
                if 2 <= levels <= MAX_STRATUM_LEVELS:
                    pieces.append(pd.DataFrame({'pos': positions, 'source': column,
                                                'label': cells[column].astype('object').to_numpy()}))
                    notes.append(f'per-cell column {column} ({levels} levels)')
                    break
        if not pieces and constant is None and 'ant_author_cluster' in cells:
            # No cell type information at all: the author cluster column is the only
            # per-cell grouping. Expression-defined, so labelled as such in celltype_source.
            levels = cells['ant_author_cluster'].nunique(dropna=True)
            if 2 <= levels <= MAX_STRATUM_LEVELS:
                pieces.append(pd.DataFrame({'pos': positions, 'source': 'ant_author_cluster',
                                            'label': cells['ant_author_cluster'].astype('object').to_numpy()}))
                notes.append(f'ant_cell_type absent; ant_author_cluster used ({levels} levels)')
        if not pieces:
            pieces.append(pd.DataFrame({'pos': positions, 'source': 'none', 'label': 'all'}))
            notes.append('single stratum (no cell type information)')
    membership = pd.concat(pieces, ignore_index=True)
    membership = membership[membership['label'].notna()].copy()
    membership['label'] = membership['label'].astype(str)
    group_pools = _group_pool_strata(membership)
    if len(group_pools):
        membership = pd.concat([membership, group_pools], ignore_index=True)
        notes.append(f'{group_pools["label"].nunique()} derived cell type group pool(s)')
    return membership, '; '.join(notes)


def _group_pool_strata(membership: pd.DataFrame) -> pd.DataFrame:
    """Derived strata that pool every label of one cell type group.

    A cohort needs one all-cells unit per cell type group (replication counts
    one anchor per cohort and group). When a stratifier source has two or more
    labels in one group (Mic P2RY12 / Mic TPT1 / ... are all microglia), the
    cells of those labels are also pooled into one stratum labelled with the
    group name and source ``group_pool``. Unmapped labels and groups with a
    single label need no pool.

    Args:
        membership: Long (pos, source, label) frame of the per-source strata.

    Returns:
        Frame with columns pos, source (``group_pool``), label (the group); empty when
        no group has two labels.
    """
    pieces: List[pd.DataFrame] = []
    for source, frame in membership.groupby('source', sort=True):
        if source in ('none', GROUP_POOL_SOURCE):
            continue
        labels_by_group: Dict[str, List[str]] = {}
        for label in sorted(frame['label'].unique()):
            labels_by_group.setdefault(group_of(label), []).append(label)
        for group, labels in labels_by_group.items():
            if group == UNMAPPED or len(labels) < 2:
                continue
            positions = frame.loc[frame['label'].isin(labels), 'pos']
            pieces.append(pd.DataFrame({'pos': positions.to_numpy(), 'source': GROUP_POOL_SOURCE, 'label': group}))
    if not pieces:
        return pd.DataFrame({'pos': pd.Series(dtype=int), 'source': pd.Series(dtype=object),
                             'label': pd.Series(dtype=object)})
    pooled = pd.concat(pieces, ignore_index=True)
    return pooled.drop_duplicates(['pos', 'label'])


def find_batch_column(conn: duckdb.DuckDBPyConnection, donors_cells: pd.DataFrame) -> Optional[str]:
    """First visible non-ant obs column that looks like a batch key and is
    constant within donor (so it can enter a donor-level model)."""
    columns = view_columns(conn, 'obscat') if _has_view(conn, 'obscat') else {}
    for column in columns:
        if column.startswith('ant_') or not BATCH_NAME_RE.search(column):
            continue
        if column not in donors_cells:
            continue
        per_donor = donors_cells.groupby('ant_donor')[column].nunique(dropna=True)
        levels = donors_cells[column].nunique(dropna=True)
        if (per_donor <= 1).all() and levels >= 2:
            return column
    return None


# --------------------------------------------------------------------------
# Job planning (pure pandas; unit tested)
# --------------------------------------------------------------------------

def _is_confounded(facet_values: np.ndarray, batch_values: pd.Series) -> bool:
    """True when the facet is a function of batch (lies in the batch span)."""
    batch_dummies = pd.get_dummies(batch_values.astype(str)).to_numpy(dtype=float)
    if batch_dummies.shape[1] < 1:
        return False
    rank_batch = np.linalg.matrix_rank(batch_dummies)
    stacked = np.column_stack([batch_dummies, np.asarray(facet_values, dtype=float)])
    return int(np.linalg.matrix_rank(stacked)) == int(rank_batch)


def _meets_minimum(facet: str, design: pd.DataFrame, replicate_unit: Optional[str] = None) -> bool:
    """True when ``design`` (donors with a ``facet_value``) still allows the test of ``facet``."""
    if facet in NUMERIC_FACETS:
        return (len(design) >= facet_rules.min_numeric(replicate_unit)
                and design['facet_value'].nunique() >= NUMERIC_MIN_DISTINCT)
    floor = facet_rules.min_per_level(replicate_unit)
    counts = design['facet_value'].value_counts()
    return bool(counts.get(0.0, 0) >= floor and counts.get(1.0, 0) >= floor)


def _level_counts(facet: str, design: pd.DataFrame) -> Dict[str, Any]:
    """Replicates per level (two-group facet) or the range of a numeric facet."""
    if facet in NUMERIC_FACETS:
        values = design['facet_value'] * (AGE_UNIT_YEARS if facet in AGE_FACETS else 1.0)
        counts: Dict[str, Any] = {'n_donors': int(len(design)), 'value_min': float(values.min()),
                                  'value_max': float(values.max()), 'n_distinct': int(design['facet_value'].nunique())}
        if facet == 'braak':
            counts.update(braak_min=counts['value_min'], braak_max=counts['value_max'])
        return counts
    reference, tested = CONTRAST[facet]
    after = design['facet_value'].value_counts().to_dict()
    return {reference: int(after.get(0.0, 0)), tested: int(after.get(1.0, 0))}


def _small_sample(facet: str, design: pd.DataFrame) -> bool:
    """Informational flag (``n_lt5``): a level below 5 replicates, a numeric facet below 10. Never blocks."""
    if facet in NUMERIC_FACETS:
        return bool(len(design) < NUMERIC_MIN_DONORS_FOR_P)
    counts = design['facet_value'].value_counts()
    return bool(min(counts.get(0.0, 0), counts.get(1.0, 0)) < N_LT5_THRESHOLD)


def pathology_covariate(donors: pd.DataFrame) -> Tuple[Optional[str], Optional[pd.Series]]:
    """The pathology term of the age-adjusted model: Braak where at least 90 percent of the donors have it,
    else the 2x2 disease (AD = 1, control = 0) where at least 90 percent have it, else none.

    Returns:
        ``(name, values)`` with ``name`` ``braak`` or ``disease``; ``(None, None)`` when neither is known enough.
    """
    if len(donors) and donors['braak'].notna().mean() >= MIN_COVARIATE_COVERAGE and donors['braak'].nunique() > 1:
        return 'braak', donors['braak'].astype(float)
    disease = donors['disease'].map({'AD': 1.0, 'control': 0.0}) if 'disease' in donors else None
    if disease is not None and len(donors) and disease.notna().mean() >= MIN_COVARIATE_COVERAGE \
            and disease.nunique() > 1:
        return 'disease', disease
    return None, None


def plan_job(donor_table: pd.DataFrame, facet: str, stratum_donors: Iterable[str],
             scope: Optional[str] = None, replicate_unit: Optional[str] = None,
             refuse_confounded: Optional[str] = None) -> Dict[str, Any]:
    """Decide design, replicates and flags for one (cell type, facet) unit.

    Eligibility is the statistical minimum (``lib/facet_rules.py``): a two-group facet needs
    ``MIN_DONORS_PER_LEVEL`` replicates per level, a numeric facet (braak, age)
    ``NUMERIC_MIN_REPLICATES`` replicates with ``NUMERIC_MIN_DISTINCT`` distinct values. Covariates
    (sex, age, PMI, batch; never the facet itself) are added in that order only while the
    test keeps its minimum and ``MIN_RESIDUAL_DF`` residual degrees of freedom: a covariate that would
    break either is dropped, never the test.

    Args:
        donor_table: build_donor_table output.
        facet: one of FACETS.
        stratum_donors: replicates that have a pseudobulk sample for this cell type
            (>= MIN_CELLS_PER_SAMPLE cells).
        scope: facet scope of the dataset; in a xenograft the sex covariate is the host's.
        replicate_unit: ``donor``, ``animal`` or ``sample``: the minimums come from ``facet_rules.min_per_level`` /
            ``min_numeric`` (the same numbers for every unit until the human p-value floor is decided).
        refuse_confounded: name of the design covariate (``batch`` slot) that, when confounded with the facet,
            makes the unit untestable instead of being dropped (``app_nlgf`` with injection or graft covariates).

    Returns:
        dict with ``status`` ('ok' or a skip reason), ``design`` (DataFrame
        indexed by donor with columns facet_value, cov_sex, cov_age, cov_pmi,
        batch) and the reporting fields. ``n_lt5`` is the informational small-sample flag.
    """
    donors = donor_table[donor_table['donor'].isin(set(stratum_donors))].copy()
    out: Dict[str, Any] = {'facet': facet, 'n_donors_with_sample': len(donors)}
    numeric_facet = facet in NUMERIC_FACETS
    floor_per_level = facet_rules.min_per_level(replicate_unit)
    floor_numeric = facet_rules.min_numeric(replicate_unit)
    if numeric_facet:
        source_column = 'age' if facet in AGE_FACETS else facet
        valid = donors[donors[source_column].notna()].copy()
        out['n_donors_facet'] = len(valid)
        distinct = valid[source_column].nunique()
        if len(valid) < floor_numeric or distinct < NUMERIC_MIN_DISTINCT:
            out.update(status=f'{facet}: {len(valid)} replicates / {distinct} distinct values '
                              f'(need {floor_numeric} / {NUMERIC_MIN_DISTINCT})')
            return out
        valid['facet_value'] = valid[source_column].astype(float) / (AGE_UNIT_YEARS if facet in AGE_FACETS else 1.0)
        out['level_counts'] = _level_counts(facet, valid)
    else:
        reference, tested = CONTRAST[facet]
        valid = donors[donors[facet].isin([reference, tested])].copy()
        counts = valid[facet].value_counts().to_dict()
        out['n_donors_facet'] = len(valid)
        kept_levels = [lv for lv in (reference, tested) if counts.get(lv, 0) >= floor_per_level]
        out['level_counts'] = {reference: int(counts.get(reference, 0)), tested: int(counts.get(tested, 0))}
        if len(kept_levels) < 2:
            out.update(status=f'level with < {floor_per_level} donors '
                              f'({reference}={counts.get(reference, 0)}, {tested}={counts.get(tested, 0)})')
            return out
        valid['facet_value'] = (valid[facet] == tested).astype(float)

    design = valid.copy()
    total = len(design)
    for column in ('cov_sex', 'cov_age', 'cov_pmi', 'cov_path'):
        design[column] = np.nan
    covariates: List[str] = []
    omitted: List[str] = []
    n_columns = 2                                  # intercept + facet

    def has_room(extra_columns: int) -> bool:
        return len(design) - (n_columns + extra_columns) >= MIN_RESIDUAL_DF

    # sex covariate (the host's in a xenograft; not for the sex facet)
    sex_column = 'host_sex' if scope == facet_scopes.SCOPE_XENOGRAFT and 'host_sex' in design else 'sex'
    if facet != 'sex':
        sex_known = design[sex_column].isin(['f', 'm'])
        if sex_known.mean() >= MIN_COVARIATE_COVERAGE and design.loc[sex_known, sex_column].nunique() == 2:
            candidate = design[sex_known].copy()
            if _meets_minimum(facet, candidate, replicate_unit) and len(candidate) - (n_columns + 1) >= MIN_RESIDUAL_DF:
                design = candidate
                design['cov_sex'] = (design[sex_column] == 'm').astype(float)
                covariates.append('sex')
                n_columns += 1
            else:
                omitted.append('sex(df)')
        else:
            omitted.append('sex')
    # pathology (the age-adjusted model only): Braak, else the 2x2 disease; without it the variant is not run
    if facet == 'age_adjusted':
        path_name, path_values = pathology_covariate(design)
        if path_name is None:
            out.update(status='age_adjusted: no pathology covariate (Braak and disease known for fewer than 90 percent)')
            return out
        candidate = design[path_values.notna()].copy()
        if not (_meets_minimum(facet, candidate, replicate_unit)
                and len(candidate) - (n_columns + 1) >= MIN_RESIDUAL_DF):
            out.update(status='age_adjusted: too few replicates left for the pathology term and 4 residual df')
            return out
        design = candidate
        design['cov_path'] = path_values.reindex(design.index).to_numpy()
        covariates.append(f'pathology:{path_name}')
        n_columns += 1
    # age (not for the age facets), pmi
    for name in (('pmi',) if facet in AGE_FACETS else ('age', 'pmi')):
        if total < MIN_DONORS_FOR_AGE_PMI:
            continue
        coverage = design[name].notna().mean() if len(design) else 0.0
        if coverage >= MIN_COVARIATE_COVERAGE and design[name].nunique() > 1:
            candidate = design[design[name].notna()].copy()
            if _meets_minimum(facet, candidate, replicate_unit) and len(candidate) - (n_columns + 1) >= MIN_RESIDUAL_DF:
                design = candidate
                sd = design[name].std(ddof=0)
                design[f'cov_{name}'] = (design[name] - design[name].mean()) / (sd if sd > 0 else 1.0)
                covariates.append(name)
                n_columns += 1
            else:
                omitted.append(f'{name}(df)')
        elif design[name].notna().any():
            omitted.append(name)

    n_dropped_covariate = total - len(design)
    out['level_counts'] = _level_counts(facet, design)
    out['n_lt5'] = _small_sample(facet, design)

    # batch: only when donor-level, >= 2 levels, not confounded with the facet, with room left
    out['batch_used'] = False
    out['batch_confounded'] = False
    design['batch_value'] = design['batch'] if 'batch' in design else None
    batch_known = design['batch_value'].notna()
    if batch_known.all() and design['batch_value'].nunique() >= 2:
        n_batches = design['batch_value'].nunique()
        if _is_confounded(design['facet_value'].to_numpy(), design['batch_value']):
            out['batch_confounded'] = True
            design['batch_value'] = None
            if refuse_confounded:
                out.update(status=f'{facet} is confounded with {refuse_confounded}: not tested')
                return out
        elif n_batches <= max(2, len(design) // 4) and has_room(n_batches - 1):
            out['batch_used'] = True
            covariates.append('batch')
        else:
            design['batch_value'] = None
            omitted.append('batch(too many levels)' if n_batches > max(2, len(design) // 4) else 'batch(df)')
    else:
        design['batch_value'] = None

    out.update(status='ok', design=design, covariates=covariates, covariates_omitted=omitted,
               n_donors_analysed=len(design), n_donors_dropped_covariate=n_dropped_covariate)
    return out


# --------------------------------------------------------------------------
# Pseudobulk
# --------------------------------------------------------------------------

def pseudobulk(conn: duckdb.DuckDBPyConnection, counts_parquet: Path,
               sample_map: pd.DataFrame) -> pd.DataFrame:
    """Sum raw counts per sample.

    Args:
        conn: DuckDB connection.
        counts_parquet: <stem>.layer.counts.by_gene.parquet (cell_id, gene_id, value).
        sample_map: columns cell_id, sample_idx (one row per cell kept).

    Returns:
        long frame (sample_idx, gene_id, count). Donors that own several
        samples/libraries are collapsed by construction: the group key is the
        sample_idx (donor x cell type), not the library.
    """
    conn.register('sample_map_df', sample_map[['cell_id', 'sample_idx']])
    conn.execute('CREATE OR REPLACE TEMP TABLE sample_map AS SELECT * FROM sample_map_df')
    conn.unregister('sample_map_df')
    quoted = str(counts_parquet).replace("'", "''")
    frame = conn.execute(
        f"SELECT m.sample_idx, p.gene_id, SUM(p.value) AS count "
        f"FROM read_parquet('{quoted}') p JOIN sample_map m ON p.cell_id = m.cell_id "
        f"GROUP BY m.sample_idx, p.gene_id ORDER BY m.sample_idx, p.gene_id").df()
    conn.execute('DROP TABLE sample_map')
    return frame


def gene_symbols(conn: duckdb.DuckDBPyConnection) -> pd.DataFrame:
    """gene_id, gene_id_name (the __genes name), symbol (feature_name when present)."""
    has_varcat = conn.execute(
        "SELECT count(*) FROM information_schema.columns WHERE table_catalog='ds' "
        "AND table_name='__varcat' AND column_name='feature_name'").fetchone()[0] > 0
    genes = conn.execute('SELECT gene_id, gene_name FROM __genes ORDER BY gene_id').df()
    if has_varcat:
        feature = conn.execute('SELECT gene_id, feature_name FROM __varcat').df()
        genes = genes.merge(feature, on='gene_id', how='left')
        looks_ensembl = genes['gene_name'].astype(str).str.match(r'^ENS[A-Z]*G\d+')
        genes['symbol'] = np.where(looks_ensembl & genes['feature_name'].notna(),
                                   genes['feature_name'], genes['gene_name'])
        genes = genes.drop(columns=['feature_name'])
    else:
        genes['symbol'] = genes['gene_name']
    return genes


# --------------------------------------------------------------------------
# Composition check (donor-level proportion vs facet)
# --------------------------------------------------------------------------

def composition_test(proportions: pd.Series, design: pd.DataFrame, facet: str
                     ) -> Optional[float]:
    """p-value of the donor-level proportion of this cell type against the facet.

    Two-level facets: Mann-Whitney U. Numeric facets (Braak, age): Spearman. Exploratory, uncorrected.
    """
    from scipy import stats
    joined = design[['facet_value']].join(proportions.rename('proportion'), how='inner').dropna()
    if len(joined) < 4:
        return None
    if facet in NUMERIC_FACETS:
        if joined['facet_value'].nunique() < 2 or joined['proportion'].nunique() < 2:
            return None
        return float(stats.spearmanr(joined['facet_value'], joined['proportion']).pvalue)
    group_a = joined.loc[joined['facet_value'] == 0.0, 'proportion']
    group_b = joined.loc[joined['facet_value'] == 1.0, 'proportion']
    if len(group_a) < 2 or len(group_b) < 2:
        return None
    return float(stats.mannwhitneyu(group_a, group_b, alternative='two-sided').pvalue)


