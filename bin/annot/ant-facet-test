def git_head(path: Path) -> Optional[str]:
    try:
        return subprocess.run(['git', '-C', str(path), 'rev-parse', 'HEAD'], capture_output=True,
                              text=True, check=True).stdout.strip()
    except Exception:
        return None


def r_versions(rscript: str) -> Dict[str, str]:
    code = ('cat(R.version.string, as.character(packageVersion("limma")), '
            'as.character(packageVersion("edgeR")), sep="|")')
    try:
        raw = subprocess.run([rscript, '-e', code], capture_output=True, text=True,
                             check=True).stdout.strip().split('|')
        return {'R': raw[0], 'limma': raw[1], 'edgeR': raw[2]}
    except Exception as exc:  # pragma: no cover
        return {'error': str(exc)}


def run_r(rscript: str, work_dir: Path) -> None:
    env = dict(os.environ, OPENBLAS_NUM_THREADS='2', OMP_NUM_THREADS='1',
               MKL_NUM_THREADS='1')
    command = [rscript, str(R_SCRIPT), str(work_dir), str(SEED)]
    result = subprocess.run(command, capture_output=True, text=True, env=env)
    if result.returncode != 0:
        raise RuntimeError(f'R failed ({result.returncode}):\n{result.stdout[-2000:]}\n{result.stderr[-4000:]}')


def facet_notes_from_md(md_yaml: Dict[str, Any]) -> Dict[str, str]:
    """Per-dataset definition notes of facets (``facet_notes`` in the .md front matter).

    A dataset can state how one of its facets was defined, for example that
    ant_disease is a pathologic proxy and not a clinical diagnosis. The notes
    are copied into the run manifest so the result page can show them next to
    the model. Keys are facet names with or without the ``ant_`` prefix.

    Args:
        md_yaml: Parsed front matter of the dataset .md.

    Returns:
        ``{facet_name: note}`` (names without the ``ant_`` prefix, empty and
        non-string entries dropped). Empty dict when the key is absent.
    """
    raw = md_yaml.get('facet_notes')
    if not isinstance(raw, dict):
        return {}
    notes: Dict[str, str] = {}
    for name, note in raw.items():
        if isinstance(note, str) and note.strip():
            key = str(name)
            notes[key[4:] if key.startswith('ant_') else key] = ' '.join(note.split())
    return notes


def process_dataset(entry: H5adEntry, store_root: Path, out_root: Path, facets: List[str],
                    rscript: str, threads: int = 4, memory_limit_gb: int = 24,
                    keep_work: bool = False) -> Dict[str, Any]:
    """Run all requested facets over all strata of one dataset.

    Returns the manifest dict (also written next to the parquet). When the
    dataset is not testable the manifest has ``status`` 'skipped' and a reason.
    """
    started = time.time()
    md_yaml, _ = parse_md_file(entry.md_path)
    api_config = get_api_config(md_yaml)
    annotation = mus.resolve_annotation(entry.h5ad_path, root=store_root)
    manifest: Dict[str, Any] = {
        'tool': TOOL_VERSION, 'db_id': entry.db_id, 'group': entry.study, 'file': entry.stem,
        'dataset_sha256': md_yaml.get('sha256'), 'md_path': str(entry.md_path),
        'anthive4_git': git_head(script_dir.parent.parent),
        'h5adstore_git': git_head(store_root),
        'timestamp_utc': dt.datetime.now(dt.timezone.utc).isoformat(timespec='seconds'),
        'seed': SEED, 'facets_requested': facets,
        'facet_notes': facet_notes_from_md(md_yaml),
        'parameters': {
            'min_cells_per_sample': MIN_CELLS_PER_SAMPLE, 'min_donors_dataset': MIN_DONORS_DATASET,
            'min_donors_per_level': MIN_DONORS_PER_LEVEL, 'n_lt5_threshold': N_LT5_THRESHOLD,
            'numeric_min_donors_for_p': NUMERIC_MIN_DONORS_FOR_P,
            'min_donors_for_age_pmi': MIN_DONORS_FOR_AGE_PMI,
            'min_covariate_coverage': MIN_COVARIATE_COVERAGE,
            'counts_layers_accepted': list(COUNTS_LAYER_NAMES),
            'disease_provisional': True, 'normalisation': 'edgeR calcNormFactors TMM + limma voom',
            'gene_filter': 'edgeR filterByExpr(design) defaults',
            'eBayes': 'limma eBayes defaults (trend=FALSE, robust=FALSE)',
            'duckdb_threads': threads, 'duckdb_memory_limit_gb': memory_limit_gb,
        },
        'r_versions': r_versions(rscript),
    }
    eligible, reason = dataset_eligibility(entry, md_yaml, annotation, api_config)
    if not eligible:
        manifest.update(status='skipped', reason=reason)
        return manifest
    layer_name, counts_parquet = counts_layer_for(entry, md_yaml)  # type: ignore[misc]
    manifest['counts_layer'] = layer_name

    work_dir = Path(tempfile.mkdtemp(prefix='ant_facet_', dir=os.environ.get('ANT_FACET_TMP')))
    conn = open_dataset(entry, api_config, threads=threads, memory_limit_gb=memory_limit_gb,
                        temp_dir=work_dir, store_root=store_root)
    try:
        cat_columns = view_columns(conn, 'obscat') if _has_view(conn, 'obscat') else {}
        num_columns = view_columns(conn, 'obsnum') if _has_view(conn, 'obsnum') else {}
        wanted = ['ant_donor', 'ant_donor_uid', 'ant_sex', 'ant_disease', 'ant_apoe', 'ant_apoe_carrier',
                  'ant_braak', 'ant_age', 'ant_pmi', 'ant_cell_type', 'ant_author_cell_type',
                  'ant_tissue', 'ant_region', 'ant_author_cluster']
        extra_candidates = [c for c in cat_columns
                            if (CELLTYPE_CANDIDATE_RE.match(c) or BATCH_NAME_RE.search(c))
                            and not c.startswith('ant_')]
        cells = cell_table(conn, wanted + extra_candidates)
        if 'ant_donor' not in cells:
            manifest.update(status='skipped', reason='no ant_donor facet in the current mapping')
            return manifest
        batch_column = find_batch_column(conn, cells)
        if batch_column is not None:
            cells['batch'] = cells[batch_column]
        manifest['batch_column'] = batch_column
        n_donors_all = int(cells['ant_donor'].dropna().astype(str).nunique())
        manifest['n_cells'] = int(len(cells))
        manifest['n_donors'] = n_donors_all
        if n_donors_all < MIN_DONORS_DATASET:
            manifest.update(status='skipped', reason=f'{n_donors_all} donors (< {MIN_DONORS_DATASET})')
            return manifest

        donor_table, conflicts = build_donor_table(cells)
        manifest['donor_conflicts'] = conflicts
        # Cross-dataset donor keys (lib/donor_keys.py): ant_donor_uid, else
        # <group_id>:<ant_donor>. Each tested unit records its donors' keys so
        # replication can count distinct donors across datasets.
        donor_key_of, donor_key_stats = donor_key_map(
            zip(cells['ant_donor'], cells['ant_donor_uid'] if 'ant_donor_uid' in cells
                else [None] * len(cells)), entry.group_id)
        manifest['donor_keys'] = {'basis': DONOR_COUNT_BASIS, **donor_key_stats}
        membership, strata_note = choose_strata(cells, cat_columns)
        manifest['celltype_note'] = strata_note
        manifest['celltype_sources'] = sorted(membership['source'].unique().tolist())
        cell_frame = cells.assign(pos=np.arange(len(cells)))[['pos', 'cell_id', 'ant_donor']]
        usable = membership.merge(cell_frame, on='pos', how='inner')
        usable = usable[usable['ant_donor'].notna()].copy()
        usable['donor'] = usable['ant_donor'].astype(str)
        usable['stratum'] = usable['source'] + '::' + usable['label']

        # pseudobulk samples: donor x cell type with >= MIN_CELLS_PER_SAMPLE cells
        sample_sizes = usable.groupby(['stratum', 'source', 'label', 'donor']).size() \
            .rename('n_cells').reset_index()
        n_dropped_small = int((sample_sizes['n_cells'] < MIN_CELLS_PER_SAMPLE).sum())
        n_samples_all = int(len(sample_sizes))
        sample_sizes = sample_sizes[sample_sizes['n_cells'] >= MIN_CELLS_PER_SAMPLE].reset_index(drop=True)
        manifest['pseudobulk'] = {
            'n_donor_celltype_groups': n_samples_all,
            'n_dropped_lt_min_cells': n_dropped_small,
            'n_kept': int(len(sample_sizes)),
        }
        # donor totals (unique cells) for the composition proportions
        donor_totals = cells[cells['ant_donor'].notna()].assign(
            donor=lambda f: f['ant_donor'].astype(str)).groupby('donor').size()
        strata_donor_counts = sample_sizes.groupby('stratum')['donor'].nunique()
        manifest['strata'] = {str(k): int(v) for k, v in strata_donor_counts.items()}

        # plan jobs first so that we only aggregate samples that some job needs
        jobs: List[Dict[str, Any]] = []
        for stratum, frame in sample_sizes.groupby('stratum'):
            for facet in facets:
                plan = plan_job(donor_table, facet, frame['donor'])
                plan['stratum'] = str(stratum)
                plan['source'] = str(frame['source'].iloc[0])
                plan['label'] = str(frame['label'].iloc[0])
                jobs.append(plan)
        needed = {(job['stratum'], donor) for job in jobs if job['status'] == 'ok'
                  for donor in job['design']['donor']}
        keep = sample_sizes[[(s, d) in needed for s, d in zip(sample_sizes['stratum'], sample_sizes['donor'])]]
        keep = keep.reset_index(drop=True)
        keep['sample_idx'] = np.arange(len(keep))

        symbols = gene_symbols(conn)
        job_records: List[Dict[str, Any]] = []
        if len(keep):
            pb_cells = usable.merge(keep[['stratum', 'donor', 'sample_idx']], on=['stratum', 'donor'],
                                    how='inner')
            long_counts = pseudobulk(conn, counts_parquet, pb_cells[['cell_id', 'sample_idx']])
            manifest['pseudobulk']['n_nonzero_entries'] = int(len(long_counts))
            sample_key = {(row.stratum, row.donor): int(row.sample_idx) for row in keep.itertuples()}

            long_counts.to_csv(work_dir / 'counts_long.csv', index=False)
            symbols.to_csv(work_dir / 'genes.csv', index=False)
            sample_rows: List[Dict[str, Any]] = []
            composition_p: Dict[Tuple[int, str], Optional[float]] = {}
            job_id = 0
            for job in jobs:
                if job['status'] != 'ok':
                    continue
                job_id += 1
                job['job_id'] = job_id
                design = job['design']
                stratum_donor_cells = keep[keep['stratum'] == job['stratum']].set_index('donor')['n_cells']
                proportions = (stratum_donor_cells / donor_totals.reindex(stratum_donor_cells.index))
                job['composition_p'] = composition_test(proportions, design.set_index('donor'), job['facet'])
                job['composition_flag'] = bool(job['composition_p'] is not None
                                               and job['composition_p'] < COMPOSITION_ALPHA)
                job['n_cells_in_stratum'] = int(stratum_donor_cells.reindex(design['donor']).sum())
                for row in design.itertuples():
                    sample_rows.append({
                        'job_id': job_id, 'sample_idx': sample_key[(job['stratum'], row.donor)],
                        'donor': row.donor, 'facet_value': row.facet_value,
                        'cov_sex': row.cov_sex, 'cov_age': row.cov_age, 'cov_pmi': row.cov_pmi,
                        'batch': row.batch_value if isinstance(row.batch_value, str) else '',
                    })
            if sample_rows:
                pd.DataFrame(sample_rows).to_csv(work_dir / 'samples.csv', index=False)
                pd.DataFrame([{'job_id': j['job_id'], 'facet': j['facet'], 'stratum': j['stratum'],
                               'numeric': int(j['facet'] == 'braak')}
                              for j in jobs if j['status'] == 'ok']).to_csv(work_dir / 'jobs.csv', index=False)
                run_r(rscript, work_dir)
                results = pd.read_csv(work_dir / 'results.csv')
                job_summary = pd.read_csv(work_dir / 'job_summary.csv')
            else:
                results, job_summary = pd.DataFrame(), pd.DataFrame()
        else:
            results, job_summary = pd.DataFrame(), pd.DataFrame()

        # assemble the output table
        frames: List[pd.DataFrame] = []
        unit_records: List[Dict[str, Any]] = []
        summary_by_job = {int(r.job_id): r for r in job_summary.itertuples()} if len(job_summary) else {}
        for job in jobs:
            record: Dict[str, Any] = {
                'facet': job['facet'], 'cell_type': job['label'], 'celltype_source': job['source'],
                'status': job['status'],
                'n_donors_with_sample': job['n_donors_with_sample'],
                'level_counts': job.get('level_counts'),
            }
            if job['status'] != 'ok':
                unit_records.append(record)
                continue
            summary = summary_by_job.get(job['job_id'])
            record['donor_key_digests'] = sorted({
                key_digest(donor_key_of.get(str(donor), f'{entry.group_id}:{donor}'))
                for donor in job['design']['donor']})
            record.update({
                'n_lt5': bool(job['n_lt5']), 'batch_used': job['batch_used'],
                'batch_confounded': job['batch_confounded'],
                'covariates': job['covariates'], 'covariates_omitted': job['covariates_omitted'],
                'n_donors_analysed': job['n_donors_analysed'],
                'n_donors_dropped_covariate': job['n_donors_dropped_covariate'],
                'composition_p': job['composition_p'], 'composition_flag': job['composition_flag'],
                'n_cells_in_stratum': job['n_cells_in_stratum'],
                'n_genes_tested': int(summary.n_genes_tested) if summary is not None else 0,
                'n_genes_input': int(summary.n_genes_input) if summary is not None else 0,
                'r_status': summary.status if summary is not None else 'missing',
            })
            unit = results[results['job_id'] == job['job_id']].copy() if len(results) else pd.DataFrame()
            if len(unit):
                if job['n_lt5']:
                    for column in ('t', 'p_value', 'q_value', 'ci_low', 'ci_high'):
                        unit[column] = np.nan
                else:
                    record['n_sig_q05'] = int((unit['q_value'] < 0.05).sum())
                level_counts = job['level_counts']
                if job['facet'] == 'braak':
                    unit['n_donors_ref'] = np.nan
                    unit['n_donors_test'] = np.nan
                    unit['contrast'] = 'braak_per_unit'
                    unit['level_ref'] = None
                    unit['level_test'] = None
                else:
                    reference, tested = CONTRAST[job['facet']]
                    unit['n_donors_ref'] = level_counts[reference]
                    unit['n_donors_test'] = level_counts[tested]
                    unit['contrast'] = f'{tested}_vs_{reference}'
                    unit['level_ref'] = reference
                    unit['level_test'] = tested
                unit['n_donors'] = job['n_donors_analysed']
                unit['facet'] = job['facet']
                unit['cell_type'] = job['label']
                unit['celltype_source'] = job['source']
                unit['n_lt5'] = bool(job['n_lt5'])
                unit['descriptive_only'] = bool(job['n_lt5'])
                unit['batch_used'] = job['batch_used']
                unit['batch_confounded'] = job['batch_confounded']
                unit['covariates'] = ','.join(job['covariates'])
                unit['composition_p'] = job['composition_p']
                unit['composition_flag'] = job['composition_flag']
                unit['provisional'] = PROVISIONAL_FLAGS.get(job['facet'], False)
                frames.append(unit)
            unit_records.append(record)

        manifest['units'] = unit_records
        out_dir = out_root / entry.study
        out_dir.mkdir(parents=True, exist_ok=True)
        if frames:
            table = pd.concat(frames, ignore_index=True)
            table = table.merge(symbols[['gene_id', 'symbol']].rename(columns={'symbol': 'gene'}),
                                on='gene_id', how='left')
            table.insert(0, 'db_id', entry.db_id)
            table.insert(1, 'dataset', entry.stem)
            table['multi_tissue_donors'] = int((donor_table['n_tissues'] > 1).sum())
            table = table.drop(columns=['job_id'])
            table.to_parquet(out_dir / f'{entry.stem}.facet_tests.parquet', index=False)
            manifest['n_result_rows'] = int(len(table))
        manifest['multi_tissue_donors'] = int((donor_table['n_tissues'] > 1).sum())

        # composition table: donor x (cell type, and author cluster when present) proportions
        comp_frames = [usable.groupby(['donor', 'source', 'label']).size().rename('n_cells').reset_index()
                       .rename(columns={'label': 'level'}).assign(kind='cell_type')]
        if 'ant_author_cluster' in cells and 2 <= cells['ant_author_cluster'].nunique() <= 200:
            tmp = cells[cells['ant_donor'].notna() & cells['ant_author_cluster'].notna()].copy()
            tmp['donor'] = tmp['ant_donor'].astype(str)
            comp_frames.append(tmp.groupby(['donor', 'ant_author_cluster']).size().rename('n_cells')
                               .reset_index().rename(columns={'ant_author_cluster': 'level'})
                               .assign(kind='author_cluster'))
        composition = pd.concat(comp_frames, ignore_index=True)
        composition['n_cells_donor'] = composition['donor'].map(donor_totals)
        composition['proportion'] = composition['n_cells'] / composition['n_cells_donor']
        composition = composition.merge(donor_table[['donor', 'sex', 'disease', 'apoe_carrier', 'braak']],
                                        on='donor', how='left')
        composition.to_parquet(out_dir / f'{entry.stem}.facet_composition.parquet', index=False)

        manifest.update(status='done', runtime_seconds=round(time.time() - started, 1))
        manifest_path = out_dir / f'{entry.stem}.facet_run_manifest.json'
        manifest_path.write_text(json.dumps(manifest, indent=2, default=_json_default))
        return manifest
    finally:
        conn.close()
        if not keep_work:
            shutil.rmtree(work_dir, ignore_errors=True)


def _json_default(value: Any) -> Any:
    if isinstance(value, (np.integer,)):
        return int(value)
    if isinstance(value, (np.floating,)):
        return None if np.isnan(value) else float(value)
    if isinstance(value, (np.bool_,)):
        return bool(value)
    if isinstance(value, (set, tuple)):
        return list(value)
    return str(value)


