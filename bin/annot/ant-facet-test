def _as_text_list(value: Any) -> List[str]:
    if value is None:
        return []
    if isinstance(value, (list, tuple)):
        return [str(v).strip().lower() for v in value]
    return [str(value).strip().lower()]


def counts_layer_for(entry: H5adEntry, md_yaml: Dict[str, Any]) -> Optional[Tuple[str, Path]]:
    """Return (layer name, by_gene parquet path) of the first served raw-counts layer."""
    stats = md_yaml.get('layer_stats') or {}
    for layer in COUNTS_LAYER_NAMES:
        sidecar = entry.duckdb_path.parent / f'{entry.stem}.layer.{layer}.by_gene.parquet'
        if not sidecar.exists():
            continue
        layer_stat = stats.get(layer) or {}
        min_nonzero = layer_stat.get('min_nonzero')
        # Raw UMI layers have min nonzero value of exactly 1.
        if min_nonzero is not None and abs(float(min_nonzero) - 1.0) > 1e-9:
            continue
        return layer, sidecar
    return None


def dataset_eligibility(entry: H5adEntry, md_yaml: Dict[str, Any],
                        annotation: Dict[str, Any], api_config: Dict[str, Any],
                        require_counts: bool = True) -> Tuple[bool, str]:
    """Metadata-level scope gate (before any data are read).

    Returns (eligible, reason). Reason is the first failing criterion.
    ``require_counts=False`` is used by ``ant-facet-test-modules``, whose
    cell-mean variant does not need a raw-counts layer.
    """
    if entry.md_path.with_suffix('.inactive').exists() or \
            (entry.md_path.parent / f'{entry.stem}.inactive').exists():
        return False, 'inactive'
    if md_yaml.get('is_secondary') is True:
        return False, 'secondary (is_secondary true)'
    organism = _as_text_list(annotation.get('organism'))
    if not organism and entry.db_id in ASSUME_HUMAN_DB_IDS:
        organism = ['human']
    if organism != ['human']:
        return False, f'organism not human ({",".join(organism) or "missing"})'
    systems = set(_as_text_list(annotation.get('experimental_system')))
    excluded = systems & EXCLUDED_SYSTEMS
    if excluded:
        return False, f'experimental_system {sorted(excluded)[0]}'
    published = set(api_config.get('obs_rename', {}).values()) | \
        set((api_config.get('obs_derive') or {}).keys()) | \
        set((api_config.get('obs_constant') or {}).keys())
    if 'ant_host_sex' in published:
        return False, 'host sex facet present (xenograft / host animal)'
    if not entry.duckdb_path.exists():
        return False, 'no .duckdb'
    if require_counts and counts_layer_for(entry, md_yaml) is None:
        return False, 'no raw counts layer served'
    return True, 'ok'


# --------------------------------------------------------------------------
# Opening a dataset with the CURRENT .md mapping
# --------------------------------------------------------------------------

def open_dataset(entry: H5adEntry, api_config: Dict[str, Any], threads: int = 4,
                 memory_limit_gb: int = 24, temp_dir: Optional[Path] = None,
                 store_root: Optional[Path] = None) -> duckdb.DuckDBPyConnection:
    """In-memory connection with the .duckdb attached read-only as ``ds`` and
    TEMP ``obscat`` / ``obsnum`` views rebuilt from the current .md api config.
    """
    conn = duckdb.connect(':memory:', config={'threads': threads,
                                              'memory_limit': f'{memory_limit_gb}GB'})
    if temp_dir is not None:
        conn.execute(f"SET temp_directory='{temp_dir}'")
    conn.execute(f"ATTACH '{entry.duckdb_path}' AS ds (READ_ONLY)")
    conn.execute('USE ds')
    columns: Dict[str, List[str]] = {}
    for underscore in ('__obscat', '__obsnum'):
        columns[underscore] = [row[0] for row in conn.execute(
            "SELECT column_name FROM information_schema.columns "
            "WHERE table_catalog='ds' AND table_name = ? ORDER BY ordinal_position",
            [underscore]).fetchall()]
    for view_name, underscore, sibling in (('obscat', '__obscat', '__obsnum'),
                                           ('obsnum', '__obsnum', '__obscat')):
        if not columns[underscore]:
            continue
        sql = build_obs_view_sql(view_name, underscore, columns[underscore], api_config,
                                 sibling_underscore_table=sibling,
                                 sibling_columns=columns[sibling],
                                 db_label=entry.db_id, group_id=entry.group_id,
                                 store_root=store_root)
        assert sql.startswith('CREATE VIEW')
        conn.execute('CREATE OR REPLACE TEMP VIEW' + sql[len('CREATE VIEW'):])
    return conn


def view_columns(conn: duckdb.DuckDBPyConnection, view_name: str) -> Dict[str, str]:
    """Column name -> type of a TEMP obs view."""
    if not _has_view(conn, view_name):
        return {}
    rows = conn.execute(f'DESCRIBE {view_name}').fetchall()
    return {row[0]: row[1] for row in rows}


def cell_table(conn: duckdb.DuckDBPyConnection, wanted: Iterable[str]) -> pd.DataFrame:
    """cell_id plus the wanted obs columns (from either TEMP view) as strings/numbers.

    Columns absent from both views are skipped. Text columns come back as
    object, numeric as float.
    """
    cat_columns = view_columns(conn, 'obscat') if _has_view(conn, 'obscat') else {}
    num_columns = view_columns(conn, 'obsnum') if _has_view(conn, 'obsnum') else {}
    pieces_cat = [c for c in wanted if c in cat_columns]
    pieces_num = [c for c in wanted if c in num_columns and c not in cat_columns]
    select_cat = ', '.join(f'o."{c}"' for c in pieces_cat) or 'NULL AS _nocat'
    frame = conn.execute(
        f'SELECT c.cell_id, {select_cat} FROM __cells c '
        f'JOIN obscat o ON o.cell_name = c.cell_name ORDER BY c.cell_id'
        if pieces_cat else 'SELECT cell_id FROM __cells ORDER BY cell_id').df()
    if pieces_num:
        select_num = ', '.join(f'o."{c}"' for c in pieces_num)
        numeric = conn.execute(
            f'SELECT c.cell_id, {select_num} FROM __cells c '
            f'JOIN obsnum o ON o.cell_name = c.cell_name ORDER BY c.cell_id').df()
        frame = frame.merge(numeric, on='cell_id', how='left')
    n_cells = conn.execute('SELECT count(*) FROM __cells').fetchone()[0]
    if len(frame) != n_cells:
        raise RuntimeError(f'cell_name join changed the row count ({len(frame)} vs {n_cells}); '
                           f'duplicate cell names in __cells')
    return frame


def _has_view(conn: duckdb.DuckDBPyConnection, name: str) -> bool:
    return bool(conn.execute(
        "SELECT count(*) FROM duckdb_views() WHERE view_name = ?", [name]).fetchone()[0]) or \
        bool(conn.execute(
            "SELECT count(*) FROM information_schema.tables WHERE table_name = ?",
            [name]).fetchone()[0])


# --------------------------------------------------------------------------
# Donor table
# --------------------------------------------------------------------------

def _single_value(series: pd.Series) -> Tuple[Any, bool]:
    """(value, conflicting). value None when all NULL or conflicting."""
    unique = series.dropna().unique()
    if len(unique) == 0:
        return None, False
    if len(unique) == 1:
        return unique[0], False
    return None, True


def build_donor_table(cells: pd.DataFrame) -> Tuple[pd.DataFrame, Dict[str, int]]:
    """One row per donor with normalised facet values and covariates.

    Args:
        cells: per-cell frame with ant_donor and any of ant_sex, ant_disease,
            ant_apoe_carrier, ant_apoe, ant_braak, ant_age, ant_pmi, batch.

    Returns:
        (donor table, conflict counts per column). A donor whose cells carry
        more than one distinct value for a facet gets NULL for it and is
        counted as conflicting (never silently picked).
    """
    cells = cells[cells['ant_donor'].notna()].copy()
    cells['ant_donor'] = cells['ant_donor'].astype(str)
    conflicts: Dict[str, int] = {}
    records: List[Dict[str, Any]] = []
    grouped = cells.groupby('ant_donor', sort=True)
    for donor, frame in grouped:
        record: Dict[str, Any] = {'donor': donor, 'n_cells_total': len(frame)}
        for facet_name, column, normaliser in (
                ('sex', 'ant_sex', normalize_sex),
                ('disease', 'ant_disease', normalize_disease)):
            if column in frame:
                raw = frame[column].map(lambda v: normaliser(v))
                value, conflict = _single_value(raw)
                record[facet_name] = value
                if conflict:
                    conflicts[facet_name] = conflicts.get(facet_name, 0) + 1
            else:
                record[facet_name] = None
        # apoe carrier: carrier column first, derive from genotype otherwise
        carrier_series = None
        if 'ant_apoe_carrier' in frame and frame['ant_apoe_carrier'].notna().any():
            carrier_series = frame['ant_apoe_carrier'].map(normalize_apoe_carrier)
        elif 'ant_apoe' in frame:
            carrier_series = frame['ant_apoe'].map(derive_apoe_carrier_from_genotype)
        if carrier_series is not None:
            value, conflict = _single_value(carrier_series)
            record['apoe_carrier'] = value
            if conflict:
                conflicts['apoe_carrier'] = conflicts.get('apoe_carrier', 0) + 1
        else:
            record['apoe_carrier'] = None
        for facet_name, column in (('braak', 'ant_braak'), ('age', 'ant_age'), ('pmi', 'ant_pmi')):
            if column in frame:
                numeric = pd.to_numeric(frame[column], errors='coerce')
                unique = numeric.dropna().unique()
                if len(unique) == 1:
                    record[facet_name] = float(unique[0])
                elif len(unique) == 0:
                    record[facet_name] = np.nan
                else:
                    record[facet_name] = np.nan
                    if facet_name == 'braak':
                        conflicts['braak'] = conflicts.get('braak', 0) + 1
                    else:
                        # age / pmi may legitimately vary per sample: use the mean
                        record[facet_name] = float(np.nanmean(unique))
            else:
                record[facet_name] = np.nan
        if 'batch' in frame:
            unique = frame['batch'].dropna().unique()
            record['batch'] = str(unique[0]) if len(unique) == 1 else None
        else:
            record['batch'] = None
        n_places = [int(frame[c].dropna().nunique()) for c in ('ant_tissue', 'ant_region') if c in frame]
        record['n_tissues'] = max(n_places) if n_places else 0
        records.append(record)
    return pd.DataFrame.from_records(records), conflicts


# --------------------------------------------------------------------------
# Cell-type stratifier
# --------------------------------------------------------------------------

def choose_strata(cells: pd.DataFrame, categorical_columns: Dict[str, str]
                  ) -> Tuple[pd.DataFrame, str]:
    """Cell type strata as a long (cell position, source, label) membership table.

    * ant_cell_type varies per cell: that column only (source 'ant_cell_type').
    * ant_cell_type is a constant (a dataset descriptor, e.g. "astrocyte"):
      two stratifier sets, because the constant can be wrong for a mixed file
      (audit L32) and per-cell subtypes can be expression-defined states:
      (a) one all-cells stratum labelled with the constant, source
      'constant_all_cells'; (b) when the dataset has a per-cell cell type
      column (ant_author_cell_type first, then an author column named like
      cell_type / class / annotation, 2..MAX_STRATUM_LEVELS levels) one
      stratum per level, source = that column name.
    * ant_cell_type absent: only (b); when no such column exists, ant_author_cluster
      (2..MAX_STRATUM_LEVELS levels) as a last resort; else a single 'all' stratum
      (source 'none': all cells pooled, not cell type specific).

    Returns (membership frame with columns pos, source, label; note).
    """
    positions = np.arange(len(cells))
    pieces: List[pd.DataFrame] = []
    notes: List[str] = []
    varying = 'ant_cell_type' in cells and cells['ant_cell_type'].nunique(dropna=True) > 1
    if varying:
        labels = cells['ant_cell_type']
        pieces.append(pd.DataFrame({'pos': positions, 'source': 'ant_cell_type',
                                    'label': labels.astype('object').to_numpy()}))
        notes.append('ant_cell_type per cell')
    else:
        constant = None
        if 'ant_cell_type' in cells and cells['ant_cell_type'].nunique(dropna=True) == 1:
            constant = str(cells['ant_cell_type'].dropna().iloc[0])
        if constant is not None:
            pieces.append(pd.DataFrame({'pos': positions, 'source': 'constant_all_cells',
                                        'label': constant}))
            notes.append(f'ant_cell_type constant ({constant})')
        candidates = ['ant_author_cell_type'] + [
            c for c in categorical_columns
            if c not in ('ant_author_cell_type', 'ant_cell_type') and not c.startswith('ant_')
            and CELLTYPE_CANDIDATE_RE.match(c)]
        for column in candidates:
            if column in cells:
                levels = cells[column].nunique(dropna=True)
                if 2 <= levels <= MAX_STRATUM_LEVELS:
                    pieces.append(pd.DataFrame({'pos': positions, 'source': column,
                                                'label': cells[column].astype('object').to_numpy()}))
                    notes.append(f'per-cell column {column} ({levels} levels)')
                    break
        if not pieces and constant is None and 'ant_author_cluster' in cells:
            # No cell type information at all: the author cluster column is the only
            # per-cell grouping. Expression-defined, so labelled as such in celltype_source.
            levels = cells['ant_author_cluster'].nunique(dropna=True)
            if 2 <= levels <= MAX_STRATUM_LEVELS:
                pieces.append(pd.DataFrame({'pos': positions, 'source': 'ant_author_cluster',
                                            'label': cells['ant_author_cluster'].astype('object').to_numpy()}))
                notes.append(f'ant_cell_type absent; ant_author_cluster used ({levels} levels)')
        if not pieces:
            pieces.append(pd.DataFrame({'pos': positions, 'source': 'none', 'label': 'all'}))
            notes.append('single stratum (no cell type information)')
    membership = pd.concat(pieces, ignore_index=True)
    membership = membership[membership['label'].notna()].copy()
    membership['label'] = membership['label'].astype(str)
    return membership, '; '.join(notes)


def find_batch_column(conn: duckdb.DuckDBPyConnection, donors_cells: pd.DataFrame) -> Optional[str]:
    """First visible non-ant obs column that looks like a batch key and is
    constant within donor (so it can enter a donor-level model)."""
    columns = view_columns(conn, 'obscat') if _has_view(conn, 'obscat') else {}
    for column in columns:
        if column.startswith('ant_') or not BATCH_NAME_RE.search(column):
            continue
        if column not in donors_cells:
            continue
        per_donor = donors_cells.groupby('ant_donor')[column].nunique(dropna=True)
        levels = donors_cells[column].nunique(dropna=True)
        if (per_donor <= 1).all() and levels >= 2:
            return column
    return None


# --------------------------------------------------------------------------
# Job planning (pure pandas; unit tested)
# --------------------------------------------------------------------------

def _is_confounded(facet_values: np.ndarray, batch_values: pd.Series) -> bool:
    """True when the facet is a function of batch (lies in the batch span)."""
    batch_dummies = pd.get_dummies(batch_values.astype(str)).to_numpy(dtype=float)
    if batch_dummies.shape[1] < 1:
        return False
    rank_batch = np.linalg.matrix_rank(batch_dummies)
    stacked = np.column_stack([batch_dummies, np.asarray(facet_values, dtype=float)])
    return int(np.linalg.matrix_rank(stacked)) == int(rank_batch)


def plan_job(donor_table: pd.DataFrame, facet: str, stratum_donors: Iterable[str]
             ) -> Dict[str, Any]:
    """Decide design, donors and flags for one (cell type, facet) unit.

    Args:
        donor_table: build_donor_table output.
        facet: one of FACETS.
        stratum_donors: donors that have a pseudobulk sample for this cell type
            (>= MIN_CELLS_PER_SAMPLE cells).

    Returns:
        dict with ``status`` ('ok' or a skip reason), ``design`` (DataFrame
        indexed by donor with columns facet_value, cov_sex, cov_age, cov_pmi,
        batch) and the reporting fields.
    """
    donors = donor_table[donor_table['donor'].isin(set(stratum_donors))].copy()
    out: Dict[str, Any] = {'facet': facet, 'n_donors_with_sample': len(donors)}
    if facet == 'braak':
        valid = donors[donors['braak'].notna()].copy()
        out['n_donors_facet'] = len(valid)
        distinct = valid['braak'].nunique()
        if len(valid) < BRAAK_MIN_DONORS or distinct < BRAAK_MIN_DISTINCT:
            out.update(status=f'braak: {len(valid)} donors / {distinct} distinct values '
                              f'(need {BRAAK_MIN_DONORS} / {BRAAK_MIN_DISTINCT})')
            return out
        valid['facet_value'] = valid['braak'].astype(float)
        out['level_counts'] = {'n_donors': int(len(valid)),
                               'braak_min': float(valid['braak'].min()),
                               'braak_max': float(valid['braak'].max()),
                               'n_distinct': int(distinct)}
        out['n_lt5'] = len(valid) < NUMERIC_MIN_DONORS_FOR_P
        valid_donors = valid
    else:
        reference, tested = CONTRAST[facet]
        valid = donors[donors[facet].isin([reference, tested])].copy()
        counts = valid[facet].value_counts().to_dict()
        out['n_donors_facet'] = len(valid)
        kept_levels = [lv for lv in (reference, tested) if counts.get(lv, 0) >= MIN_DONORS_PER_LEVEL]
        out['level_counts'] = {reference: int(counts.get(reference, 0)),
                               tested: int(counts.get(tested, 0))}
        if len(kept_levels) < 2:
            out.update(status=f'level with < {MIN_DONORS_PER_LEVEL} donors '
                              f'({reference}={counts.get(reference, 0)}, {tested}={counts.get(tested, 0)})')
            return out
        valid['facet_value'] = (valid[facet] == tested).astype(float)
        out['n_lt5'] = min(counts.get(reference, 0), counts.get(tested, 0)) < N_LT5_THRESHOLD
        valid_donors = valid

    design = valid_donors.copy()
    covariates: List[str] = []
    omitted: List[str] = []
    total = len(design)

    # sex covariate (not for the sex facet)
    design['cov_sex'] = np.nan
    if facet != 'sex':
        sex_known = design['sex'].isin(['f', 'm'])
        if sex_known.mean() >= MIN_COVARIATE_COVERAGE and design.loc[sex_known, 'sex'].nunique() == 2:
            design = design[sex_known].copy()
            design['cov_sex'] = (design['sex'] == 'm').astype(float)
            covariates.append('sex')
        else:
            omitted.append('sex')
    # age, pmi
    for name in ('age', 'pmi'):
        design[f'cov_{name}'] = np.nan
        if total < MIN_DONORS_FOR_AGE_PMI:
            continue
        coverage = design[name].notna().mean() if len(design) else 0.0
        if coverage >= MIN_COVARIATE_COVERAGE and design[name].nunique() > 1:
            design = design[design[name].notna()].copy()
            sd = design[name].std(ddof=0)
            design[f'cov_{name}'] = (design[name] - design[name].mean()) / (sd if sd > 0 else 1.0)
            covariates.append(name)
        elif design[name].notna().any():
            omitted.append(name)

    # re-check the facet after covariate-driven donor loss
    n_dropped_covariate = total - len(design)
    if facet == 'braak':
        if len(design) < BRAAK_MIN_DONORS or design['facet_value'].nunique() < BRAAK_MIN_DISTINCT:
            out.update(status='braak: too few donors after covariate completeness filter')
            return out
        out['n_lt5'] = len(design) < NUMERIC_MIN_DONORS_FOR_P
        out['level_counts'] = {'n_donors': int(len(design)),
                               'braak_min': float(design['braak'].min()),
                               'braak_max': float(design['braak'].max()),
                               'n_distinct': int(design['braak'].nunique())}
    else:
        counts_after = design['facet_value'].value_counts().to_dict()
        if counts_after.get(0.0, 0) < MIN_DONORS_PER_LEVEL or counts_after.get(1.0, 0) < MIN_DONORS_PER_LEVEL:
            out.update(status='level with < 3 donors after covariate completeness filter')
            return out
        reference, tested = CONTRAST[facet]
        out['level_counts'] = {reference: int(counts_after.get(0.0, 0)),
                               tested: int(counts_after.get(1.0, 0))}
        out['n_lt5'] = min(counts_after.get(0.0, 0), counts_after.get(1.0, 0)) < N_LT5_THRESHOLD

    # batch: only when donor-level, >= 2 levels, not confounded with the facet
    out['batch_used'] = False
    out['batch_confounded'] = False
    design['batch_value'] = design['batch'] if 'batch' in design else None
    batch_known = design['batch_value'].notna()
    if batch_known.all() and design['batch_value'].nunique() >= 2:
        n_batches = design['batch_value'].nunique()
        if _is_confounded(design['facet_value'].to_numpy(), design['batch_value']):
            out['batch_confounded'] = True
            design['batch_value'] = None
        elif n_batches <= max(2, len(design) // 4):
            out['batch_used'] = True
            covariates.append('batch')
        else:
            design['batch_value'] = None
            omitted.append('batch(too many levels)')
    else:
        design['batch_value'] = None

    out.update(status='ok', design=design, covariates=covariates, covariates_omitted=omitted,
               n_donors_analysed=len(design), n_donors_dropped_covariate=n_dropped_covariate)
    return out


# --------------------------------------------------------------------------
# Pseudobulk
# --------------------------------------------------------------------------

def pseudobulk(conn: duckdb.DuckDBPyConnection, counts_parquet: Path,
               sample_map: pd.DataFrame) -> pd.DataFrame:
    """Sum raw counts per sample.

    Args:
        conn: DuckDB connection.
        counts_parquet: <stem>.layer.counts.by_gene.parquet (cell_id, gene_id, value).
        sample_map: columns cell_id, sample_idx (one row per cell kept).

    Returns:
        long frame (sample_idx, gene_id, count). Donors that own several
        samples/libraries are collapsed by construction: the group key is the
        sample_idx (donor x cell type), not the library.
    """
    conn.register('sample_map_df', sample_map[['cell_id', 'sample_idx']])
    conn.execute('CREATE OR REPLACE TEMP TABLE sample_map AS SELECT * FROM sample_map_df')
    conn.unregister('sample_map_df')
    quoted = str(counts_parquet).replace("'", "''")
    frame = conn.execute(
        f"SELECT m.sample_idx, p.gene_id, SUM(p.value) AS count "
        f"FROM read_parquet('{quoted}') p JOIN sample_map m ON p.cell_id = m.cell_id "
        f"GROUP BY m.sample_idx, p.gene_id").df()
    conn.execute('DROP TABLE sample_map')
    return frame


def gene_symbols(conn: duckdb.DuckDBPyConnection) -> pd.DataFrame:
    """gene_id, gene_id_name (the __genes name), symbol (feature_name when present)."""
    has_varcat = conn.execute(
        "SELECT count(*) FROM information_schema.columns WHERE table_catalog='ds' "
        "AND table_name='__varcat' AND column_name='feature_name'").fetchone()[0] > 0
    genes = conn.execute('SELECT gene_id, gene_name FROM __genes ORDER BY gene_id').df()
    if has_varcat:
        feature = conn.execute('SELECT gene_id, feature_name FROM __varcat').df()
        genes = genes.merge(feature, on='gene_id', how='left')
        looks_ensembl = genes['gene_name'].astype(str).str.match(r'^ENS[A-Z]*G\d+')
        genes['symbol'] = np.where(looks_ensembl & genes['feature_name'].notna(),
                                   genes['feature_name'], genes['gene_name'])
        genes = genes.drop(columns=['feature_name'])
    else:
        genes['symbol'] = genes['gene_name']
    return genes


# --------------------------------------------------------------------------
# Composition check (donor-level proportion vs facet)
# --------------------------------------------------------------------------

def composition_test(proportions: pd.Series, design: pd.DataFrame, facet: str
                     ) -> Optional[float]:
    """p-value of the donor-level proportion of this cell type against the facet.

    Two-level facets: Mann-Whitney U. Braak: Spearman. Exploratory, uncorrected.
    """
    from scipy import stats
    joined = design[['facet_value']].join(proportions.rename('proportion'), how='inner').dropna()
    if len(joined) < 4:
        return None
    if facet == 'braak':
        if joined['facet_value'].nunique() < 2 or joined['proportion'].nunique() < 2:
            return None
        return float(stats.spearmanr(joined['facet_value'], joined['proportion']).pvalue)
    group_a = joined.loc[joined['facet_value'] == 0.0, 'proportion']
    group_b = joined.loc[joined['facet_value'] == 1.0, 'proportion']
    if len(group_a) < 2 or len(group_b) < 2:
        return None
    return float(stats.mannwhitneyu(group_a, group_b, alternative='two-sided').pvalue)


