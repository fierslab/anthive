def tau_for_facet(facet: str, tau_two_group: float = TAU_TWO_GROUP, tau_braak_per_stage: float = TAU_BRAAK_PER_STAGE,
                  tau_age_per_decade: float = TAU_AGE_PER_DECADE) -> float:
    """limma treat threshold (log2 fold change) of one facet: per Braak stage, per decade of age, or per contrast."""
    if facet == 'braak':
        return tau_braak_per_stage
    if facet == 'age':
        return tau_age_per_decade
    return tau_two_group


SEX_EXPRESSION_Y_GENES = ('RPS4Y1', 'DDX3Y', 'UTY', 'KDM5D', 'USP9Y', 'EIF1AY', 'ZFY', 'NLGN4Y', 'TXLNGY', 'EIF2S3Y')
SEX_EXPRESSION_X_GENE = 'XIST'


def genomic_inflation(p_values: Iterable[float]) -> Optional[float]:
    """Genomic inflation factor: median of the chi-square(1) quantiles of the p values over 0.4549 (None below 50 p).

    Near 1 for a well-calibrated null; above ``facet_rules.LAMBDA_INFLATED`` the unit is flagged ``inflated``.
    """
    from scipy import stats as scipy_stats  # noqa: PLC0415
    values = np.asarray([p for p in p_values if p is not None and not math.isnan(p)], dtype=float)
    if len(values) < 50:
        return None
    values = np.clip(values, 1e-300, 1.0)
    return float(np.median(scipy_stats.chi2.isf(values, 1)) / 0.4549364231195724)


def sex_discordance(long_counts: pd.DataFrame, symbols: pd.DataFrame, sample_donor: Dict[int, str],
                    donor_sex: Dict[str, Optional[str]]) -> Dict[str, int]:
    """Donors whose expressed sex disagrees with their sex label (counts only, never identifiers).

    Per sample the score is log2(Y-gene CPM + 1) minus log2(XIST CPM + 1). With at least 2 labelled donors of each
    sex and a median gap of at least 2 between the sexes, a donor is discordant when its score lies on the other
    side of the midpoint by at least 1.

    Args:
        long_counts: ``sample_idx, gene_id, count`` of the pseudobulk samples of one stratum.
        symbols: ``gene_id, symbol``.
        sample_donor: sample_idx -> donor label.
        donor_sex: donor label -> ``f`` / ``m`` / None.

    Returns:
        ``{'n_checked': ..., 'n_discordant': ...}`` (zeros when the sexes are not separable here).
    """
    upper = symbols.assign(symbol=symbols['symbol'].astype(str).str.upper())
    y_ids = set(upper.loc[upper['symbol'].isin(SEX_EXPRESSION_Y_GENES), 'gene_id'])
    x_ids = set(upper.loc[upper['symbol'] == SEX_EXPRESSION_X_GENE, 'gene_id'])
    empty = {'n_checked': 0, 'n_discordant': 0}
    if not y_ids or not x_ids or not len(long_counts):
        return empty
    totals = long_counts.groupby('sample_idx')['count'].sum()
    y_counts = long_counts[long_counts['gene_id'].isin(y_ids)].groupby('sample_idx')['count'].sum()
    x_counts = long_counts[long_counts['gene_id'].isin(x_ids)].groupby('sample_idx')['count'].sum()
    scores = {}
    for sample, total in totals.items():
        if total <= 0 or sample_donor.get(int(sample)) is None:
            continue
        y_cpm = 1e6 * float(y_counts.get(sample, 0.0)) / float(total)
        x_cpm = 1e6 * float(x_counts.get(sample, 0.0)) / float(total)
        scores[sample_donor[int(sample)]] = math.log2(y_cpm + 1.0) - math.log2(x_cpm + 1.0)
    labelled = {d: s for d, s in scores.items() if donor_sex.get(d) in ('f', 'm')}
    females = [s for d, s in labelled.items() if donor_sex[d] == 'f']
    males = [s for d, s in labelled.items() if donor_sex[d] == 'm']
    if len(females) < 2 or len(males) < 2:
        return empty
    median_f, median_m = float(np.median(females)), float(np.median(males))
    if median_m - median_f < 2.0:
        return {'n_checked': len(labelled), 'n_discordant': 0}
    midpoint = (median_f + median_m) / 2.0
    wrong = sum(1 for d, s in labelled.items()
                if (donor_sex[d] == 'm' and s < midpoint - 1.0) or (donor_sex[d] == 'f' and s > midpoint + 1.0))
    return {'n_checked': len(labelled), 'n_discordant': int(wrong)}


def age_top_coding(donor_table: pd.DataFrame) -> Optional[float]:
    """The age at which ages are top-coded (ROSMAP 90+, PsychAD 90), or None.

    Detected as at least 3 donors, and at least 3 percent of the donors with a known age, sitting exactly on the
    maximum age when that maximum is 85 or more.
    """
    ages = pd.to_numeric(donor_table['age'], errors='coerce').dropna()
    if len(ages) < 20:
        return None
    top = float(ages.max())
    at_top = int((ages == top).sum())
    return top if top >= 85.0 and at_top >= 3 and at_top / len(ages) >= 0.03 else None


def split_by_design(donor_table: pd.DataFrame, donors: Iterable[str], design: Dict[str, Any]
                    ) -> List[Tuple[Optional[str], List[str]]]:
    """Replicates of one stratum grouped by timepoint and graft line (one ``app_nlgf`` unit per group).

    The amyloid response grows with age and depends on the grafted line, so a genotype contrast must not average over
    them. Without a declared ``timepoint_column`` or ``graft_line_column`` there is one group (label None). Replicates
    without a value for a declared column are left out. Labels read ``timepoint=6m|line=APOE33``.
    """
    roles = [(role, name) for role, name in (('timepoint', 'timepoint'), ('line', 'graft_line')) if design.get(name)]
    members = donor_table[donor_table['donor'].isin(set(donors))]
    if not roles:
        return [(None, list(members['donor']))]
    groups: List[Tuple[Optional[str], List[str]]] = []
    known = members.dropna(subset=[column for _, column in roles])
    for key, frame in known.groupby([column for _, column in roles], sort=True):
        key = key if isinstance(key, tuple) else (key,)
        label = '|'.join(f'{role}={value}' for (role, _), value in zip(roles, key))
        groups.append((label, list(frame['donor'])))
    return groups or [(None, [])]


def mark_persisting_age_genes(frames: List[pd.DataFrame]) -> None:
    """Fill ``persists_after_pathology_adjustment`` of the ``age`` rows (in place).

    A gene of the unadjusted age unit persists when, in the age unit of the same stratum that also has the pathology
    term in the model, it has ``q_value < 0.05`` with the same sign. Units without the adjusted twin keep NaN.
    """
    adjusted = {(f['cell_type'].iloc[0], f['celltype_source'].iloc[0]): f.set_index('gene_id')
                for f in frames if f['facet'].iloc[0] == 'age_adjusted'}
    for frame in frames:
        if frame['facet'].iloc[0] != 'age':
            continue
        twin = adjusted.get((frame['cell_type'].iloc[0], frame['celltype_source'].iloc[0]))
        if twin is None:
            continue
        q_adjusted = frame['gene_id'].map(twin['q_value'])
        sign_adjusted = np.sign(frame['gene_id'].map(twin['logFC']))
        persists = (q_adjusted < 0.05) & (sign_adjusted == np.sign(frame['logFC']))
        frame['persists_after_pathology_adjustment'] = np.where(q_adjusted.isna(), np.nan, persists.astype(float))


CONTROL_BASES = ('wt_host', 'humanised_app_host', 'other')


def app_nlgf_design_from_md(md_yaml: Dict[str, Any]) -> Dict[str, Any]:
    """The ``app_nlgf`` design of a dataset ``.md``: ``control_basis`` and the obs columns that stratify or adjust.

    ``control_basis`` (top-level key; ``wt_host``, ``humanised_app_host`` or ``other``) says what the control
    animal is. ``app_nlgf_design`` names the animal-level obs columns that must not be averaged over:
    ``timepoint_column`` and ``graft_line_column`` stratify (one unit per value combination),
    ``covariate_columns`` (injection arm, village) enter as a factor and make the unit untestable when
    confounded with the genotype.

    Raises:
        ValueError: unknown ``control_basis`` or a malformed ``app_nlgf_design``.
    """
    basis = md_yaml.get('control_basis')
    if basis is not None and basis not in CONTROL_BASES:
        raise ValueError(f'control_basis {basis!r} is not one of {", ".join(CONTROL_BASES)}')
    raw = md_yaml.get('app_nlgf_design') or {}
    if not isinstance(raw, dict):
        raise ValueError('app_nlgf_design must be a mapping')
    unknown = set(raw) - {'timepoint_column', 'graft_line_column', 'covariate_columns'}
    if unknown:
        raise ValueError(f'app_nlgf_design has unknown keys {sorted(unknown)}')
    covariates = raw.get('covariate_columns') or []
    if isinstance(covariates, str):
        covariates = [covariates]
    return {'control_basis': basis, 'timepoint': raw.get('timepoint_column'), 'graft_line': raw.get('graft_line_column'),
            'covariates': list(covariates)}


def design_columns_of(design: Dict[str, Any]) -> List[str]:
    """All obs columns named by an ``app_nlgf`` design."""
    return [c for c in [design.get('timepoint'), design.get('graft_line'), *design.get('covariates', [])] if c]


def md_file_sha256(md_path: Path) -> str:
    """sha256 of the dataset .md file (front matter incl. the api mapping).

    ``dataset_sha256`` in the manifest is the h5ad content hash and does not change
    when the mapping changes; this one does, so a stale output can be detected.
    """
    return hashlib.sha256(Path(md_path).read_bytes()).hexdigest()


def manifest_is_current(manifest_path: Path, md_path: Path) -> bool:
    """True when the manifest exists and was produced from the current .md file."""
    if not manifest_path.exists():
        return False
    try:
        recorded = json.loads(manifest_path.read_text()).get('md_sha256')
    except (OSError, ValueError):
        return False
    return recorded is not None and recorded == md_file_sha256(md_path)


def git_head(path: Path) -> Optional[str]:
    try:
        return subprocess.run(['git', '-C', str(path), 'rev-parse', 'HEAD'], capture_output=True,
                              text=True, check=True).stdout.strip()
    except Exception:
        return None


def r_versions(rscript: str) -> Dict[str, str]:
    code = ('cat(R.version.string, as.character(packageVersion("limma")), '
            'as.character(packageVersion("edgeR")), sep="|")')
    try:
        raw = subprocess.run([rscript, '-e', code], capture_output=True, text=True,
                             check=True).stdout.strip().split('|')
        return {'R': raw[0], 'limma': raw[1], 'edgeR': raw[2]}
    except Exception as exc:  # pragma: no cover
        return {'error': str(exc)}


def run_r(rscript: str, work_dir: Path) -> None:
    env = dict(os.environ, OPENBLAS_NUM_THREADS='2', OMP_NUM_THREADS='1',
               MKL_NUM_THREADS='1')
    command = [rscript, str(R_SCRIPT), str(work_dir), str(SEED)]
    result = subprocess.run(command, capture_output=True, text=True, env=env)
    if result.returncode != 0:
        raise RuntimeError(f'R failed ({result.returncode}):\n{result.stdout[-2000:]}\n{result.stderr[-4000:]}')


def facet_notes_from_md(md_yaml: Dict[str, Any]) -> Dict[str, str]:
    """Per-dataset definition notes of facets (``facet_notes`` in the .md front matter).

    A dataset can state how one of its facets was defined, for example that
    ant_disease is a pathologic proxy and not a clinical diagnosis. The notes
    are copied into the run manifest so the result page can show them next to
    the model. Keys are facet names with or without the ``ant_`` prefix.

    Args:
        md_yaml: Parsed front matter of the dataset .md.

    Returns:
        ``{facet_name: note}`` (names without the ``ant_`` prefix, empty and
        non-string entries dropped). Empty dict when the key is absent.
    """
    raw = md_yaml.get('facet_notes')
    if not isinstance(raw, dict):
        return {}
    notes: Dict[str, str] = {}
    for name, note in raw.items():
        if isinstance(note, str) and note.strip():
            key = str(name)
            notes[key[4:] if key.startswith('ant_') else key] = ' '.join(note.split())
    return notes


class Target(NamedTuple):
    """What one run tests and where its results go.

    A single dataset (``pool_id`` None) or a donor-pooled unit: the cells of
    several member files of one cohort (the regional files of a cell type
    group) pooled per donor before pseudobulking.
    """
    db_id: str
    study: str
    stem: str
    group_id: str
    members: List[H5adEntry]
    pool_id: Optional[str] = None


def pool_manifest_current(manifest_path: Path, members: List[H5adEntry]) -> bool:
    """True when a pooled manifest records the md hashes of all current members."""
    if not manifest_path.exists():
        return False
    try:
        recorded = json.loads(manifest_path.read_text()).get('md_sha256')
    except (OSError, ValueError):
        return False
    return recorded is not None and recorded == pool_md_sha256(members)


def pool_md_sha256(members: List[H5adEntry]) -> str:
    """sha256 over the member ids and their .md hashes (pooled counterpart of ``md_file_sha256``)."""
    lines = '\n'.join(f'{entry.db_id}:{md_file_sha256(entry.md_path)}' for entry in sorted(members, key=lambda e: e.db_id))
    return hashlib.sha256(lines.encode()).hexdigest()


def disease_basis_of(md_yamls: Iterable[Dict[str, Any]]) -> Optional[str]:
    """The ``disease_basis`` of a dataset (or of the member files of a pool).

    One value when all given ``.md`` agree, ``mixed`` when they differ, None
    when none declares it. Values: nia_reagan, braak_cerad, adnc, clinical_dx, author_dx.
    """
    values = {md.get('disease_basis') for md in md_yamls}
    values.discard(None)
    if not values:
        return None
    return values.pop() if len(values) == 1 else 'mixed'


def _stratum_derivation_note(strata_note: str, pooled: bool) -> str:
    return strata_note + ('; donor-pooled over member files' if pooled else '')


def process_dataset(entry: H5adEntry, store_root: Path, out_root: Path, facets: List[str],
                    rscript: str, threads: int = 4, memory_limit_gb: int = 24,
                    keep_work: bool = False, exclusion_from: Optional[List[str]] = None,
                    exclusion_where: Optional[List[str]] = None,
                    all_donors: bool = False, tau_two_group: float = TAU_TWO_GROUP,
                    tau_braak_per_stage: float = TAU_BRAAK_PER_STAGE,
                    tau_age_per_decade: float = TAU_AGE_PER_DECADE,
                    age_floor: float = AGE_FACET_MIN_AGE) -> Dict[str, Any]:
    """Run all requested facets over all strata of one dataset.

    The donors listed by the ``facet_donor_exclusions`` rule of the dataset
    ``.md`` (plus ``exclusion_from`` / ``exclusion_where``, see
    ``lib/donor_exclusions.py``) are left out; ``all_donors`` tests every
    donor instead and writes to the supplementary folder.

    Returns the manifest dict (also written next to the parquet). When the
    dataset is not testable the manifest has ``status`` 'skipped' and a reason.
    """
    target = Target(db_id=entry.db_id, study=entry.study, stem=entry.stem, group_id=entry.group_id,
                    members=[entry])
    return process_target(target, store_root, out_root, facets, rscript, threads, memory_limit_gb, keep_work,
                          exclusion_from, exclusion_where, all_donors, tau_two_group, tau_braak_per_stage,
                          tau_age_per_decade, age_floor)


def process_pool(pool_id: str, members: List[H5adEntry], store_root: Path, out_root: Path,
                 facets: List[str], rscript: str, threads: int = 4, memory_limit_gb: int = 24,
                 keep_work: bool = False, tau_two_group: float = TAU_TWO_GROUP,
                 tau_braak_per_stage: float = TAU_BRAAK_PER_STAGE,
                 tau_age_per_decade: float = TAU_AGE_PER_DECADE,
                    age_floor: float = AGE_FACET_MIN_AGE) -> Dict[str, Any]:
    """Donor-pooled run over the member files of one cohort.

    A donor's cells are pooled across the member files (the regional files of
    one cell type group, for example five MADRC regions) into one pseudobulk
    per (donor, cell type stratum); the pooled unit is the cohort's anchor and
    the per-region runs of the members are supplementary. Region is ignored
    (not a covariate); the manifest records ``pool`` with the members and
    ``multi_tissue_donors``. Results go to ``<out_root>/_pooled/<pool_id>.*``
    with ``db_id`` ``pool:<pool_id>``.
    """
    target = Target(db_id=f'pool:{pool_id}', study=POOLED_DIRNAME, stem=pool_id,
                    group_id=members[0].group_id, members=list(members), pool_id=pool_id)
    return process_target(target, store_root, out_root, facets, rscript, threads, memory_limit_gb, keep_work,
                          None, None, False, tau_two_group, tau_braak_per_stage, tau_age_per_decade, age_floor)


def process_target(target: Target, store_root: Path, out_root: Path, facets: List[str],
                   rscript: str, threads: int, memory_limit_gb: int, keep_work: bool,
                   exclusion_from: Optional[List[str]], exclusion_where: Optional[List[str]],
                   all_donors: bool, tau_two_group: float, tau_braak_per_stage: float,
                   tau_age_per_decade: float = TAU_AGE_PER_DECADE,
                    age_floor: float = AGE_FACET_MIN_AGE) -> Dict[str, Any]:
    """Shared implementation of ``process_dataset`` and ``process_pool``."""
    started = time.time()
    pooled = target.pool_id is not None
    first = target.members[0]
    md_by_db = {entry.db_id: parse_md_file(entry.md_path)[0] for entry in target.members}
    md_yaml = md_by_db[first.db_id]
    md_rule = donor_exclusions.rule_from_md(md_yaml)
    exclusion_rule = donor_exclusions.combine(md_rule, exclusion_from or [], exclusion_where or [])
    variant = donor_exclusions.VARIANT_ALL_DONORS if (all_donors and md_rule) else donor_exclusions.VARIANT_COUNTED
    facet_notes: Dict[str, str] = {}
    for md in md_by_db.values():
        facet_notes.update(facet_notes_from_md(md))
    manifest: Dict[str, Any] = {
        'tool': TOOL_VERSION, 'db_id': target.db_id, 'group': target.study, 'file': target.stem,
        'dataset_sha256': None if pooled else md_yaml.get('sha256'),
        'md_path': str(first.md_path),
        'md_sha256': pool_md_sha256(target.members) if pooled else md_file_sha256(first.md_path),
        'anthive4_git': git_head(script_dir.parent.parent),
        'h5adstore_git': git_head(store_root),
        'timestamp_utc': dt.datetime.now(dt.timezone.utc).isoformat(timespec='seconds'),
        'seed': SEED, 'facets_requested': facets,
        'facet_notes': facet_notes,
        'disease_basis': disease_basis_of(md_by_db.values()),
        'parameters': {
            'min_cells_per_sample': MIN_CELLS_PER_SAMPLE, 'min_donors_dataset': MIN_DONORS_DATASET,
            'min_donors_per_level': MIN_DONORS_PER_LEVEL, 'n_lt5_threshold': N_LT5_THRESHOLD,
            'numeric_min_donors_for_p': NUMERIC_MIN_DONORS_FOR_P,
            'numeric_min_replicates': NUMERIC_MIN_REPLICATES, 'numeric_min_distinct': NUMERIC_MIN_DISTINCT,
            'min_residual_df': MIN_RESIDUAL_DF,
            'small_sample_flag_blocks_test': False,
            'min_donors_for_age_pmi': MIN_DONORS_FOR_AGE_PMI,
            'min_covariate_coverage': MIN_COVARIATE_COVERAGE,
            'counts_layers_accepted': list(COUNTS_LAYER_NAMES),
            'disease_provisional': True, 'normalisation': 'edgeR calcNormFactors TMM + limma voom',
            'gene_filter': 'edgeR filterByExpr(design) defaults',
            'eBayes': 'limma eBayes defaults (trend=FALSE, robust=FALSE)',
            'treat': 'limma treat on the same fit; H0 |log2FC| <= tau; BH within the job (q_treat)',
            'tau_two_group_log2': tau_two_group, 'tau_braak_per_stage_log2': tau_braak_per_stage,
            'tau_age_per_decade_log2': tau_age_per_decade,
            'replicate_min_per_level': replicates.MIN_REPLICATES_PER_LEVEL,
            'replicate_min_numeric': replicates.MIN_REPLICATES_NUMERIC,
            'replicate_min_distinct_numeric': replicates.MIN_DISTINCT_NUMERIC,
            'duckdb_threads': threads, 'duckdb_memory_limit_gb': memory_limit_gb,
        },
        'r_versions': r_versions(rscript),
    }
    members: List[H5adEntry] = []
    member_notes: List[Dict[str, Any]] = []
    annotations: Dict[str, Dict[str, Any]] = {}
    member_scopes: Dict[str, Optional[str]] = {}
    for entry in target.members:
        md = md_by_db[entry.db_id]
        api = get_api_config(md)
        annotation = mus.resolve_annotation(entry.h5ad_path, root=store_root)
        annotations[entry.db_id] = annotation
        member_scopes[entry.db_id] = dataset_scope(entry, annotation, api)
        eligible, reason = dataset_eligibility(entry, md, annotation, api)
        if eligible:
            members.append(entry)
        elif not pooled:
            manifest.update(status='skipped', reason=reason)
            return manifest
        else:
            member_notes.append({'db_id': entry.db_id, 'status': 'skipped', 'reason': reason})
    if not members:
        manifest.update(status='skipped', reason='no eligible member file')
        return manifest
    scopes_of_members = {member_scopes[entry.db_id] for entry in members}
    if len(scopes_of_members) != 1:
        manifest.update(status='skipped', reason=f'member files span facet scopes {sorted(map(str, scopes_of_members))}')
        return manifest
    facet_scope = scopes_of_members.pop()
    manifest['facet_scope'] = facet_scope
    facets = facets_for_scope(facet_scope, facets)
    if 'age' in facets and 'age_adjusted' not in facets:
        facets = facets[:facets.index('age') + 1] + ['age_adjusted'] + facets[facets.index('age') + 1:]
    manifest['facets_tested_in_scope'] = facets
    try:
        app_design = app_nlgf_design_from_md(md_yaml)
    except ValueError as exc:
        manifest.update(status='skipped', reason=str(exc))
        return manifest
    manifest['control_basis'] = app_design['control_basis']
    manifest['app_nlgf_design'] = {k: v for k, v in app_design.items() if k != 'control_basis' and v}
    manifest['parameters_v3b'] = {'age_floor': age_floor, 'min_residual_df': MIN_RESIDUAL_DF,
                                  'min_test_residual_df': MIN_TEST_RESIDUAL_DF, 'lambda_inflated': LAMBDA_INFLATED,
                                  'voom': 'voomWithQualityWeights', 'eBayes_robust': True,
                                  'min_per_level_by_unit': MIN_PER_LEVEL_BY_UNIT,
                                  'min_numeric_by_unit': MIN_NUMERIC_BY_UNIT}
    if all_donors and md_rule is None:
        manifest.update(status='skipped', reason='--all-donors: this dataset has no facet_donor_exclusions '
                                                  'rule, its counted run already uses every donor')
        return manifest
    if pooled:
        manifest['pool'] = {'pool_id': target.pool_id, 'members': [e.db_id for e in members],
                            'skipped_members': member_notes,
                            'region_handling': 'ignored (not a covariate); donors pooled across member files',
                            'member_md_sha256': {e.db_id: md_file_sha256(e.md_path) for e in members}}
    layers: Dict[str, Tuple[str, Path]] = {}
    for entry in members:
        layers[entry.db_id] = counts_layer_for(entry, md_by_db[entry.db_id])  # type: ignore[assignment]
    manifest['counts_layer'] = layers[members[0].db_id][0]

    work_dir = Path(tempfile.mkdtemp(prefix='ant_facet_', dir=os.environ.get('ANT_FACET_TMP')))
    conns: Dict[str, duckdb.DuckDBPyConnection] = {}
    try:
        for entry in members:
            conns[entry.db_id] = open_dataset(entry, get_api_config(md_by_db[entry.db_id]), threads=threads,
                                              memory_limit_gb=memory_limit_gb, temp_dir=work_dir,
                                              store_root=store_root)
        cat_columns: Dict[str, str] = {}
        replicate_info: Dict[str, Dict[str, Any]] = {}
        cell_parts: List[pd.DataFrame] = []
        exclusion_reports: List[Dict[str, Any]] = []
        for file_index, entry in enumerate(members):
            conn = conns[entry.db_id]
            member_cat = view_columns(conn, 'obscat') if _has_view(conn, 'obscat') else {}
            for column, kind in member_cat.items():
                cat_columns.setdefault(column, kind)
            member_all = set(member_cat) | set(view_columns(conn, 'obsnum') if _has_view(conn, 'obsnum') else {})
            replicate = replicates.resolve_replicate(md_by_db[entry.db_id], annotations[entry.db_id], member_all)
            replicate_info[entry.db_id] = replicate
            replicate_column = replicate['replicate_column']
            wanted = ['ant_donor', 'ant_donor_uid', 'ant_sex', 'ant_host_sex', 'ant_disease', 'ant_apoe',
                      'ant_apoe4_carrier', 'ant_apoe_carrier', 'ant_app_nlgf', 'ant_braak', 'ant_age', 'ant_pmi',
                      'ant_cell_type',
                      'ant_author_cell_type', 'ant_tissue', 'ant_region', 'ant_author_cluster']
            if replicate_column and replicate_column not in wanted:
                wanted.append(replicate_column)
            extra_candidates = [c for c in member_cat
                                if (CELLTYPE_CANDIDATE_RE.match(c) or BATCH_NAME_RE.search(c))
                                and not c.startswith('ant_')]
            exclusion_columns = [c for c in (exclusion_rule.obs_columns if exclusion_rule else [])
                                 + donor_exclusions.declared_columns(md_by_db[entry.db_id])
                                 + (design_columns_of(app_design) if 'app_nlgf' in facets else [])
                                 if c not in wanted and c not in extra_candidates]
            cells_part = cell_table(conn, wanted + extra_candidates + exclusion_columns)
            missing_design = [c for c in design_columns_of(app_design) if 'app_nlgf' in facets and c not in cells_part]
            if missing_design:
                manifest.update(status='skipped',
                                reason=f'app_nlgf_design column(s) {missing_design} are not obs columns of the view')
                return manifest
            if replicate['replicate_unit'] == 'none' or not replicate_column:
                manifest.update(status='skipped', reason='replicate_unit is none: cell-level, descriptive only')
                return manifest
            if replicate_column not in cells_part:
                manifest.update(status='skipped', reason=f'replicate_column {replicate_column} is not an obs column')
                return manifest
            if replicate_column != 'ant_donor':
                cells_part['ant_donor'] = cells_part[replicate_column]
            cells_part, exclusion_report = donor_exclusions.apply_rule(cells_part, exclusion_rule, variant)
            if exclusion_report is not None:
                exclusion_reports.append(exclusion_report)
            if replicate['replicate_unit'] != 'donor' and 'ant_donor_uid' in cells_part:
                # the uid names the person; an animal or sample is keyed by its own label
                cells_part['ant_donor_uid'] = None
            if pooled:
                # one person, one key across the member files: the uid where it exists
                if 'ant_donor_uid' in cells_part:
                    cells_part['ant_donor'] = cells_part['ant_donor_uid'].where(
                        cells_part['ant_donor_uid'].notna(), cells_part['ant_donor'])
            cells_part['file_index'] = file_index
            cell_parts.append(cells_part)
        cells = pd.concat(cell_parts, ignore_index=True) if len(cell_parts) > 1 else cell_parts[0]
        if exclusion_reports:
            manifest['donor_exclusion'] = exclusion_reports[0] if len(exclusion_reports) == 1 else {
                'members': exclusion_reports}
        first_replicate = replicate_info[members[0].db_id]
        first_replicate_unit = first_replicate['replicate_unit']
        if any((r['replicate_unit'], r['replicate_column']) != (first_replicate['replicate_unit'],
                                                                first_replicate['replicate_column'])
               for r in replicate_info.values()):
            manifest.update(status='skipped', reason='member files declare different replicate units')
            return manifest
        manifest['replicate_unit'] = first_replicate['replicate_unit']
        manifest['replicate_column'] = first_replicate['replicate_column']
        manifest['replicate_basis'] = first_replicate['basis']
        batch_column = None if pooled else (donor_exclusions.declared_batch_column(md_yaml, cells)
                                            or find_batch_column(conns[first.db_id], cells))
        if batch_column is not None:
            cells['batch'] = cells[batch_column]
        manifest['batch_column'] = batch_column
        n_donors_all = int(cells['ant_donor'].dropna().astype(str).nunique())
        manifest['n_cells'] = int(len(cells))
        manifest['n_donors'] = n_donors_all
        if n_donors_all < MIN_DONORS_DATASET:
            manifest.update(status='skipped', reason=f'{n_donors_all} replicates (< {MIN_DONORS_DATASET}, '
                                                      f'the smallest numeric test)')
            return manifest

        donor_table, conflicts = build_donor_table(cells, {
            'timepoint': app_design['timepoint'], 'graft_line': app_design['graft_line'],
            'covariates': app_design['covariates']})
        manifest['donor_conflicts'] = conflicts
        floors = donor_exclusions.min_age_floors(md_yaml)
        floors.setdefault('age', age_floor)
        floors['age_adjusted'] = floors['age']
        below_floor, age_floor_report = donor_exclusions.below_age_floor(donor_table, floors)
        if age_floor_report:
            manifest['facet_min_age'] = age_floor_report
        top_coded_at = age_top_coding(donor_table)
        manifest['age_top_coded'] = top_coded_at
        # Cross-dataset donor keys (lib/donor_keys.py): ant_donor_uid, else
        # <group_id>:<ant_donor>. Each tested unit records its donors' keys so
        # replication can count distinct donors across datasets.
        donor_key_of, donor_key_stats = donor_key_map(
            zip(cells['ant_donor'], cells['ant_donor_uid'] if 'ant_donor_uid' in cells
                else [None] * len(cells)), target.group_id)
        manifest['donor_keys'] = {'basis': DONOR_COUNT_BASIS, **donor_key_stats}
        membership, strata_note = choose_strata(cells, cat_columns)
        manifest['celltype_note'] = _stratum_derivation_note(strata_note, pooled)
        manifest['celltype_sources'] = sorted(membership['source'].unique().tolist())
        cell_frame = cells.assign(pos=np.arange(len(cells)))[['pos', 'cell_id', 'ant_donor', 'file_index']]
        usable = membership.merge(cell_frame, on='pos', how='inner')
        usable = usable[usable['ant_donor'].notna()].copy()
        usable['donor'] = usable['ant_donor'].astype(str)
        usable['stratum'] = usable['source'] + '::' + usable['label']

        # pseudobulk samples: donor x cell type with >= MIN_CELLS_PER_SAMPLE cells
        sample_sizes = usable.groupby(['stratum', 'source', 'label', 'donor']).size() \
            .rename('n_cells').reset_index()
        n_dropped_small = int((sample_sizes['n_cells'] < MIN_CELLS_PER_SAMPLE).sum())
        n_samples_all = int(len(sample_sizes))
        sample_sizes = sample_sizes[sample_sizes['n_cells'] >= MIN_CELLS_PER_SAMPLE].reset_index(drop=True)
        manifest['pseudobulk'] = {
            'n_donor_celltype_groups': n_samples_all,
            'n_dropped_lt_min_cells': n_dropped_small,
            'n_kept': int(len(sample_sizes)),
        }
        # donor totals (unique cells) for the composition proportions
        donor_totals = cells[cells['ant_donor'].notna()].assign(
            donor=lambda f: f['ant_donor'].astype(str)).groupby('donor').size()
        strata_donor_counts = sample_sizes.groupby('stratum')['donor'].nunique()
        manifest['strata'] = {str(k): int(v) for k, v in strata_donor_counts.items()}

        # plan jobs first so that we only aggregate samples that some job needs
        jobs: List[Dict[str, Any]] = []
        for stratum, frame in sample_sizes.groupby('stratum'):
            for facet in facets:
                stratum_donor_labels = donor_exclusions.stratum_donors(frame['donor'], facet, below_floor)
                subsets: List[Tuple[Optional[str], Iterable[str]]] = [(None, stratum_donor_labels)]
                table, refuse = donor_table, None
                if facet == 'app_nlgf':
                    subsets = split_by_design(donor_table, stratum_donor_labels, app_design)
                    if app_design['covariates']:
                        table = donor_table.assign(batch=donor_table['design_cov'])
                        refuse = ' and '.join(app_design['covariates'])
                for subset_label, subset_donors in subsets:
                    plan = plan_job(table, facet, subset_donors, scope=facet_scope,
                                    replicate_unit=first_replicate_unit, refuse_confounded=refuse)
                    plan['stratum'] = str(stratum)
                    plan['source'] = str(frame['source'].iloc[0]) + (f'@{subset_label}' if subset_label else '')
                    plan['label'] = str(frame['label'].iloc[0])
                    plan['design_subset'] = subset_label
                    jobs.append(plan)
        needed = {(job['stratum'], donor) for job in jobs if job['status'] == 'ok'
                  for donor in job['design']['donor']}
        keep = sample_sizes[[(s, d) in needed for s, d in zip(sample_sizes['stratum'], sample_sizes['donor'])]]
        keep = keep.reset_index(drop=True)
        keep['sample_idx'] = np.arange(len(keep))

        symbols = gene_symbols(conns[members[0].db_id])
        job_records: List[Dict[str, Any]] = []
        discordance_by_stratum: Dict[str, Dict[str, int]] = {}
        if len(keep):
            pb_cells = usable.merge(keep[['stratum', 'donor', 'sample_idx']], on=['stratum', 'donor'],
                                    how='inner')
            if not pooled:
                long_counts = pseudobulk(conns[first.db_id], layers[first.db_id][1],
                                         pb_cells[['cell_id', 'sample_idx']])
            else:
                long_counts, symbols = pooled_pseudobulk(members, conns, layers, pb_cells)
            manifest['pseudobulk']['n_nonzero_entries'] = int(len(long_counts))
            sample_key = {(row.stratum, row.donor): int(row.sample_idx) for row in keep.itertuples()}
            donor_sex_label = dict(zip(donor_table['donor'], donor_table['sex']))
            for stratum_name, stratum_samples in keep.groupby('stratum'):
                ids = set(stratum_samples['sample_idx'])
                discordance_by_stratum[str(stratum_name)] = sex_discordance(
                    long_counts[long_counts['sample_idx'].isin(ids)], symbols,
                    {int(r.sample_idx): r.donor for r in stratum_samples.itertuples()}, donor_sex_label)

            long_counts.to_csv(work_dir / 'counts_long.csv', index=False)
            symbols.to_csv(work_dir / 'genes.csv', index=False)
            sample_rows: List[Dict[str, Any]] = []
            composition_p: Dict[Tuple[int, str], Optional[float]] = {}
            job_id = 0
            for job in jobs:
                if job['status'] != 'ok':
                    continue
                job_id += 1
                job['job_id'] = job_id
                design = job['design']
                stratum_donor_cells = keep[keep['stratum'] == job['stratum']].set_index('donor')['n_cells']
                proportions = (stratum_donor_cells / donor_totals.reindex(stratum_donor_cells.index))
                job['composition_p'] = composition_test(proportions, design.set_index('donor'), job['facet'])
                job['composition_flag'] = bool(job['composition_p'] is not None
                                               and job['composition_p'] < COMPOSITION_ALPHA)
                job['n_cells_in_stratum'] = int(stratum_donor_cells.reindex(design['donor']).sum())
                for row in design.itertuples():
                    sample_rows.append({
                        'job_id': job_id, 'sample_idx': sample_key[(job['stratum'], row.donor)],
                        'donor': row.donor, 'facet_value': row.facet_value,
                        'cov_sex': row.cov_sex, 'cov_age': row.cov_age, 'cov_pmi': row.cov_pmi,
                        'cov_path': row.cov_path,
                        'batch': row.batch_value if isinstance(row.batch_value, str) else '',
                    })
            if sample_rows:
                pd.DataFrame(sample_rows).to_csv(work_dir / 'samples.csv', index=False)
                pd.DataFrame([{'job_id': j['job_id'], 'facet': j['facet'], 'stratum': j['stratum'],
                               'numeric': int(j['facet'] in NUMERIC_FACETS),
                               'tau': tau_for_facet(j['facet'], tau_two_group, tau_braak_per_stage, tau_age_per_decade)}
                              for j in jobs if j['status'] == 'ok']).to_csv(work_dir / 'jobs.csv', index=False)
                run_r(rscript, work_dir)
                results = pd.read_csv(work_dir / 'results.csv')
                job_summary = pd.read_csv(work_dir / 'job_summary.csv')
            else:
                results, job_summary = pd.DataFrame(), pd.DataFrame()
        else:
            results, job_summary = pd.DataFrame(), pd.DataFrame()

        # assemble the output table
        frames: List[pd.DataFrame] = []
        unit_records: List[Dict[str, Any]] = []
        summary_by_job = {int(r.job_id): r for r in job_summary.itertuples()} if len(job_summary) else {}
        for job in jobs:
            numeric_facet = job['facet'] in NUMERIC_FACETS
            record: Dict[str, Any] = {
                'facet': job['facet'], 'cell_type': job['label'], 'celltype_source': job['source'],
                'status': job['status'],
                'n_donors_with_sample': job['n_donors_with_sample'],
                'level_counts': job.get('level_counts'),
                'replicate_unit': first_replicate['replicate_unit'],
                'replicate_column': first_replicate['replicate_column'],
                'facet_scope': facet_scope,
            }
            if job['status'] != 'ok':
                record.update(analysis_level=replicates.LEVEL_CELL, analysis_level_label=replicates.CELL_LEVEL_LABEL,
                              analysis_level_reason=job['status'])
                unit_records.append(record)
                continue
            level_counts = job['level_counts']
            level = replicates.analysis_level(
                first_replicate['replicate_unit'], numeric_facet,
                n_per_level=None if numeric_facet else level_counts,
                n_replicates=level_counts.get('n_donors') if numeric_facet else None,
                n_distinct=level_counts.get('n_distinct') if numeric_facet else None)
            record.update(analysis_level=level['analysis_level'], analysis_level_label=level['label'],
                          analysis_level_reason=level['reason'],
                          tau_log2=tau_for_facet(job['facet'], tau_two_group, tau_braak_per_stage, tau_age_per_decade))
            summary = summary_by_job.get(job['job_id'])
            record['donor_key_digests'] = sorted({
                key_digest(donor_key_of.get(str(donor), f'{target.group_id}:{donor}'))
                for donor in job['design']['donor']})
            record.update({
                'n_lt5': bool(job['n_lt5']), 'small_sample': bool(job['n_lt5']), 'descriptive_only': False,
                'batch_used': job['batch_used'],
                'batch_confounded': job['batch_confounded'],
                'covariates': job['covariates'], 'covariates_omitted': job['covariates_omitted'],
                'n_donors_analysed': job['n_donors_analysed'],
                'n_donors_dropped_covariate': job['n_donors_dropped_covariate'],
                'composition_p': job['composition_p'], 'composition_flag': job['composition_flag'],
                'n_cells_in_stratum': job['n_cells_in_stratum'],
                'n_genes_tested': int(summary.n_genes_tested) if summary is not None else 0,
                'n_genes_input': int(summary.n_genes_input) if summary is not None else 0,
                'r_status': summary.status if summary is not None else 'missing',
            })
            unit = results[results['job_id'] == job['job_id']].copy() if len(results) else pd.DataFrame()
            record.update(control_basis=app_design['control_basis'] if job['facet'] == 'app_nlgf' else None,
                          design_subset=job.get('design_subset'),
                          covariates_dropped=list(job['covariates_omitted']),
                          age_top_coded=top_coded_at if job['facet'] in AGE_FACETS else None,
                          n_sex_checked=discordance_by_stratum.get(job['stratum'], {}).get('n_checked'),
                          n_sex_discordant=discordance_by_stratum.get(job['stratum'], {}).get('n_discordant'))
            if len(unit):
                lambda_gc = genomic_inflation(unit['p_value'])
                record.update(lambda_gc=lambda_gc, df_total_median=float(unit['df_total'].median()),
                              inflated=bool(lambda_gc is not None and lambda_gc > LAMBDA_INFLATED))
                record['n_sig_q05'] = int((unit['q_value'] < 0.05).sum())
                record['n_sig_treat_q05'] = int((unit['q_treat'] < 0.05).sum())
                if numeric_facet:
                    unit['n_donors_ref'] = np.nan
                    unit['n_donors_test'] = np.nan
                    unit['contrast'] = NUMERIC_CONTRAST[job['facet']]
                    unit['level_ref'] = None
                    unit['level_test'] = None
                else:
                    reference, tested = CONTRAST[job['facet']]
                    unit['n_donors_ref'] = level_counts[reference]
                    unit['n_donors_test'] = level_counts[tested]
                    unit['contrast'] = f'{tested}_vs_{reference}'
                    unit['level_ref'] = reference
                    unit['level_test'] = tested
                unit['n_donors'] = job['n_donors_analysed']
                unit['facet'] = job['facet']
                unit['cell_type'] = job['label']
                unit['celltype_source'] = job['source']
                unit['tau_log2'] = record['tau_log2']
                unit['n_lt5'] = bool(job['n_lt5'])
                unit['small_sample'] = bool(job['n_lt5'])
                unit['descriptive_only'] = False
                unit['facet_scope'] = facet_scope
                unit['batch_used'] = job['batch_used']
                unit['batch_confounded'] = job['batch_confounded']
                unit['covariates'] = ','.join(job['covariates'])
                unit['composition_p'] = job['composition_p']
                unit['composition_flag'] = job['composition_flag']
                unit['provisional'] = PROVISIONAL_FLAGS.get(job['facet'], False)
                unit['persists_after_pathology_adjustment'] = np.nan
                frames.append(unit)
            unit_records.append(record)
        mark_persisting_age_genes(frames)

        manifest['units'] = unit_records
        out_dir = (out_root / POOLED_DIRNAME if pooled else
                   donor_exclusions.result_dir(out_root, target.study, md_rule is not None, all_donors))
        out_dir.mkdir(parents=True, exist_ok=True)
        if frames:
            table = pd.concat(frames, ignore_index=True)
            table = table.merge(symbols[['gene_id', 'symbol']].rename(columns={'symbol': 'gene'}),
                                on='gene_id', how='left')
            table.insert(0, 'db_id', target.db_id)
            table.insert(1, 'dataset', target.stem)
            table['multi_tissue_donors'] = int((donor_table['n_tissues'] > 1).sum())
            table = table.drop(columns=['job_id'])
            table.to_parquet(out_dir / f'{target.stem}.facet_tests.parquet', index=False)
            manifest['n_result_rows'] = int(len(table))
        manifest['multi_tissue_donors'] = int((donor_table['n_tissues'] > 1).sum())

        # composition table: donor x (cell type, and author cluster when present) proportions
        comp_frames = [usable.groupby(['donor', 'source', 'label']).size().rename('n_cells').reset_index()
                       .rename(columns={'label': 'level'}).assign(kind='cell_type')]
        if 'ant_author_cluster' in cells and 2 <= cells['ant_author_cluster'].nunique() <= 200:
            tmp = cells[cells['ant_donor'].notna() & cells['ant_author_cluster'].notna()].copy()
            tmp['donor'] = tmp['ant_donor'].astype(str)
            comp_frames.append(tmp.groupby(['donor', 'ant_author_cluster']).size().rename('n_cells')
                               .reset_index().rename(columns={'ant_author_cluster': 'level'})
                               .assign(kind='author_cluster'))
        composition = pd.concat(comp_frames, ignore_index=True)
        composition['n_cells_donor'] = composition['donor'].map(donor_totals)
        composition['proportion'] = composition['n_cells'] / composition['n_cells_donor']
        composition = composition.merge(donor_table[['donor', 'sex', 'disease', 'apoe4_carrier', 'braak']],
                                        on='donor', how='left')
        composition.to_parquet(out_dir / f'{target.stem}.facet_composition.parquet', index=False)

        manifest.update(status='done', runtime_seconds=round(time.time() - started, 1))
        manifest_path = out_dir / f'{target.stem}.facet_run_manifest.json'
        manifest_path.write_text(json.dumps(manifest, indent=2, default=_json_default))
        return manifest
    finally:
        for conn in conns.values():
            conn.close()
        if not keep_work:
            shutil.rmtree(work_dir, ignore_errors=True)


def pooled_pseudobulk(members: List[H5adEntry], conns: Dict[str, duckdb.DuckDBPyConnection],
                      layers: Dict[str, Tuple[str, Path]], pb_cells: pd.DataFrame
                      ) -> Tuple[pd.DataFrame, pd.DataFrame]:
    """Pseudobulk over several member files in one gene space.

    Each file's counts are summed per sample in its own DuckDB, then the gene
    ids are mapped to one id per gene symbol (counts of ids sharing a symbol
    are added) and the files are added together per (sample, gene).

    Args:
        members: Member datasets, in ``file_index`` order.
        conns: Open connection per member ``db_id``.
        layers: ``(layer name, counts parquet)`` per member ``db_id``.
        pb_cells: Cells to sum: ``cell_id``, ``sample_idx``, ``file_index``.

    Returns:
        ``(long counts (sample_idx, gene_id, count), genes (gene_id, gene_name, symbol))``
        with ids of the pooled gene space (sorted by symbol).
    """
    per_file: List[pd.DataFrame] = []
    symbol_tables: List[pd.DataFrame] = []
    for file_index, entry in enumerate(members):
        part = pb_cells[pb_cells['file_index'] == file_index]
        if not len(part):
            continue
        counts = pseudobulk(conns[entry.db_id], layers[entry.db_id][1], part[['cell_id', 'sample_idx']])
        symbols = gene_symbols(conns[entry.db_id])[['gene_id', 'symbol']]
        per_file.append(counts.merge(symbols, on='gene_id', how='inner').drop(columns='gene_id'))
        symbol_tables.append(symbols)
    all_symbols = sorted(set(pd.concat(symbol_tables)['symbol'].astype(str)))
    gene_id_of = {symbol: index for index, symbol in enumerate(all_symbols)}
    long_counts = pd.concat(per_file, ignore_index=True)
    long_counts['gene_id'] = long_counts['symbol'].astype(str).map(gene_id_of)
    long_counts = (long_counts.groupby(['sample_idx', 'gene_id'], as_index=False)['count'].sum()
                   .sort_values(['sample_idx', 'gene_id']).reset_index(drop=True))
    genes = pd.DataFrame({'gene_id': range(len(all_symbols)), 'gene_name': all_symbols, 'symbol': all_symbols})
    return long_counts, genes


def _json_default(value: Any) -> Any:
    if isinstance(value, (np.integer,)):
        return int(value)
    if isinstance(value, (np.floating,)):
        return None if np.isnan(value) else float(value)
    if isinstance(value, (np.bool_,)):
        return bool(value)
    if isinstance(value, (set, tuple)):
        return list(value)
    return str(value)


