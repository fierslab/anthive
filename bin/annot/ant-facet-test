def _default_rscript() -> str:
    """envs/facet-test-r of this checkout, or of the main checkout when run from a worktree."""
    candidates = [script_dir.parent.parent / 'envs' / 'facet-test-r' / 'bin' / 'Rscript']
    try:
        common = subprocess.run(['git', '-C', str(script_dir), 'rev-parse', '--git-common-dir'],
                                capture_output=True, text=True, check=True).stdout.strip()
        candidates.append((script_dir / common).resolve().parent / 'envs' / 'facet-test-r' / 'bin' / 'Rscript')
    except Exception:
        pass
    for candidate in candidates:
        if candidate.exists():
            return str(candidate)
    return str(candidates[0])


