# /// script
# requires-python = ">=3.10,<3.13"
# dependencies = [
#   "starcatpy>=1.0.0",
#   "anndata>=0.10.0",
#   "scanpy>=1.10.0",
#   "numpy>=1.24.0,<2.0",
#   "pandas>=2.0.0",
#   "scipy>=1.10.0",
#   "scikit-learn==1.3.2",
#   "mygene>=3.2.2",
#   "pyyaml>=6.0",
#   "duckdb>=0.10.0",
# ]
