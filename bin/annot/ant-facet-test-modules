def sidecar_modules(sidecar: Path, sources: Sequence[str]) -> pd.DataFrame:
    """Distinct (source, catalog, module) of the scores sidecar."""
    conn = duckdb.connect(':memory:')
    try:
        return conn.execute(
            'SELECT DISTINCT source, catalog, module FROM read_parquet(?) WHERE source IN '
            f'({",".join("?" for _ in sources)}) ORDER BY 1, 2, 3', [str(sidecar), *sources]).df()
    finally:
        conn.close()


def cell_mean_scores(conn: duckdb.DuckDBPyConnection, sidecar: Path, sample_map: pd.DataFrame,
                     sample_sizes: pd.Series, sources: Sequence[str]
                     ) -> Tuple[pd.DataFrame, pd.DataFrame]:
    """Donor-by-stratum mean of the per-cell scores (variant A).

    Args:
        conn: DuckDB connection.
        sidecar: ``<stem>.scores.parquet`` (cell_id, source, catalog, module, score).
        sample_map: columns cell_id, sample_idx (cells of the kept samples).
        sample_sizes: n cells per sample_idx (index = sample_idx).
        sources: sidecar sources to read.

    Returns:
        (mean scores: rows sample_idx, columns MultiIndex (source, catalog, module);
         coverage of the same shape: scored cells / cells of the sample).
    """
    conn.register('score_sample_map_df', sample_map[['cell_id', 'sample_idx']])
    conn.execute('CREATE OR REPLACE TEMP TABLE score_sample_map AS SELECT * FROM score_sample_map_df')
    conn.unregister('score_sample_map_df')
    quoted = str(sidecar).replace("'", "''")
    source_list = ','.join("'" + s.replace("'", "''") + "'" for s in sources)
    long = conn.execute(
        # AVG over doubles is order dependent: a parallel hash aggregate adds the
        # values in a thread and scheduling dependent order and the mean differs
        # in the last bits between runs and thread counts. The ordered aggregate
        # sums each group in cell_id order (unique within a group), so the result
        # does not depend on threads or load.
        f"SELECT m.sample_idx, s.source, s.catalog, s.module, "
        f"AVG(s.score ORDER BY s.cell_id) AS mean_score, "
        f"COUNT(s.score) AS n_scored FROM read_parquet('{quoted}') s "
        f"JOIN score_sample_map m ON s.cell_id = m.cell_id WHERE s.source IN ({source_list}) "
        f"GROUP BY m.sample_idx, s.source, s.catalog, s.module "
        f"ORDER BY m.sample_idx, s.source, s.catalog, s.module").df()
    conn.execute('DROP TABLE score_sample_map')
    long['column'] = list(zip(long['source'], long['catalog'], long['module']))
    means = long.pivot(index='sample_idx', columns='column', values='mean_score')
    scored = long.pivot(index='sample_idx', columns='column', values='n_scored')
    for frame in (means, scored):
        frame.columns = pd.MultiIndex.from_tuples(list(frame.columns),
                                                  names=['source', 'catalog', 'module'])
    coverage = scored.div(sample_sizes.reindex(scored.index), axis=0)
    return means, coverage


def pseudobulk_dense(long_counts: pd.DataFrame, sample_ids: np.ndarray, n_genes: int
                     ) -> np.ndarray:
    """Dense (samples x genes) count matrix, rows in ``sample_ids`` order, columns = gene_id."""
    position = pd.Series(np.arange(len(sample_ids)), index=sample_ids)
    matrix = np.zeros((len(sample_ids), n_genes), dtype=np.float64)
    wanted = long_counts[long_counts['sample_idx'].isin(position.index)]
    matrix[position.loc[wanted['sample_idx']].to_numpy(), wanted['gene_id'].to_numpy()] = \
        wanted['count'].to_numpy()
    return matrix


def load_module_genes(registry: GenesetRegistry, modules: pd.DataFrame, symbols: pd.DataFrame
                      ) -> Tuple[Dict[ModuleKey, np.ndarray], Dict[Tuple[str, str], Dict[str, int]]]:
    """Gene-column indices (position in the sorted gene_id list) of every distinct
    (catalog, module) of the sidecar (a module scored by several sources counts once; its
    key carries the source label ``gene_list``).

    Genes are matched exactly on the symbol, then on the stored gene name.
    Modules without a ``.grp`` gene list or with fewer than MIN_MODULE_GENES
    genes in the dataset are left out. Returns (indices, gene counts per module).
    """
    lookup: Dict[str, int] = {}
    for column in ('gene_name', 'symbol'):               # symbol wins on conflicts
        for position, name in enumerate(symbols[column].astype(str).to_numpy()):
            lookup[name] = position
    indices: Dict[ModuleKey, np.ndarray] = {}
    counts: Dict[Tuple[str, str], Dict[str, int]] = {}
    for catalog, module in sorted(set(zip(modules['catalog'], modules['module']))):
        geneset = registry.genesets.get(f'{catalog}/{module}')
        if geneset is None or geneset.format != 'grp':
            continue
        requested = sorted(set(geneset.genes))
        found = sorted({lookup[g] for g in requested if g in lookup})
        counts[(catalog, module)] = {'requested': len(requested), 'found': len(found)}
        if len(found) >= MIN_MODULE_GENES:
            indices[(GENE_LIST_SOURCE, catalog, module)] = np.array(found, dtype=int)
    return indices, counts


def module_in_stratum(registry: GenesetRegistry, catalog: str, module: str, stratum_label: str) -> bool:
    """Whether a module is tested in a stratum (cell type scope rule of the module docstring).

    A module the registry does not know (no ``.grp`` in the store) has no declared scope and is
    tested everywhere; a ``role: markers`` module is never tested.
    """
    geneset = registry.genesets.get(f'{catalog}/{module}')
    if geneset is None:
        return True
    scope = module_scope(geneset)
    return (not scope.is_markers) and scope.matches_label(stratum_label)


def default_geneset_store() -> Path:
    from config import get_config  # type: ignore
    value = get_config().get('geneset_store') or 'data/genesetstore'
    candidate = (script_dir.parent.parent / value).resolve()
    if candidate.exists():
        return candidate
    try:   # git worktree: the data folders live in the main checkout
        main_checkout = Path(aft.subprocess.run(
            ['git', '-C', str(script_dir), 'rev-parse', '--git-common-dir'],
            capture_output=True, text=True, check=True).stdout.strip())
        return ((script_dir / main_checkout).resolve().parent / value).resolve()
    except Exception:
        return candidate


