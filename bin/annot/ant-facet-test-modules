def replicated_modules(table: pd.DataFrame, out_root: Path, cohort_table: Path,
                       min_std_effect: float = EFFECT_GATE_STD) -> pd.DataFrame:
    """Partial-conjunction replication of modules per facet scope, facet, method, source and cell type group.

    The same structure as the gene replication (``lib/facet_results.py``): one anchor unit per cohort and cell type
    group (``FacetResults.counting_units``), the cohort p value of a direction is the two-sided permutation p halved
    when the estimate has that sign (1 minus the half otherwise), the m - 1 largest are combined by Simes, BH over
    the modules of the family gives ``r_value``; ``replicated`` is r < 0.05. The effect gate is a separate served
    condition: at least 2 cohorts each with a signed ``std_effect`` of at least ``min_std_effect`` in the replicated
    direction (``effect_gate_passed``, ``n_cohorts_ge_gate``); the median ``std_effect`` is descriptive. Units that are not
    descriptive only and whose dataset is in the cohort table with a counted role take part.

    Returns:
        One row per (family, module): ``facet_scope, facet, method, source, celltype_group, catalog, module, r_value,
        p_pc, m, k (cohorts with q_perm < 0.05 in the direction), direction, median_std_effect, effect_gate_passed,
        replicated``.
    """
    reader = facet_results.FacetResults(cohort_table.parent)
    cohorts = reader.cohorts()
    basis_of: Dict[str, Any] = {}
    for manifest_path in out_root.glob('*/*.facet_module_run_manifest.json'):
        manifest = json.loads(manifest_path.read_text())
        basis_of[manifest.get('db_id')] = manifest.get('disease_basis')
    output: List[pd.DataFrame] = []
    usable = table[~table['descriptive_only'].astype(bool)]
    for (scope, facet, method, source), family in usable.groupby(['facet_scope', 'facet', 'method', 'source']):
        units = family[['db_id', 'cell_type', 'celltype_source', 'n_donors']].drop_duplicates(
            ['db_id', 'cell_type', 'celltype_source']).reset_index(drop=True)
        units['unit'] = units.index
        info = units['db_id'].map(lambda db_id: cohorts.get(db_id) or {})
        units['cohort'] = [i.get('cohort') or None for i in info]
        units['cohort_label'] = [i.get('cohort_label') or None for i in info]
        units['role'] = [i.get('role') for i in info]
        units['counted'] = [bool(i.get('counted')) for i in info]
        units['descriptive_only'] = False
        units['is_secondary'] = False
        units['pooled'] = False
        units['disease_basis'] = units['db_id'].map(basis_of)
        units['celltype_group'] = units['cell_type'].map(group_of)
        counted = facet_results.FacetResults.counting_units(units, True, facet)
        counted = counted[counted['counted_effective']]
        for group, group_units in counted.groupby('celltype_group'):
            keyed = family.merge(group_units[['db_id', 'cell_type', 'celltype_source', 'cohort', 'n_siblings']],
                                 on=['db_id', 'cell_type', 'celltype_source'], how='inner')
            if keyed['cohort'].nunique() < 2:
                continue
            half = keyed['p_perm'] / 2.0
            keyed['p_up'] = np.where(keyed['estimate'] >= 0, half, 1.0 - half)
            keyed['p_down'] = np.where(keyed['estimate'] <= 0, half, 1.0 - half)
            keyed['module_key'] = keyed['catalog'].astype(str) + '/' + keyed['module'].astype(str)
            keyed['up'] = (keyed['q_perm'] * keyed['n_siblings']).clip(upper=1.0).lt(Q_THRESHOLD) & (keyed['estimate'] > 0)
            keyed['down'] = (keyed['q_perm'] * keyed['n_siblings']).clip(upper=1.0).lt(Q_THRESHOLD) & (keyed['estimate'] < 0)
            per_cohort = keyed.groupby(['module_key', 'cohort']).agg(
                catalog=('catalog', 'first'), module=('module', 'first'), p_up=('p_up', 'min'), p_down=('p_down', 'min'),
                n_siblings=('n_siblings', 'max'), up=('up', 'any'), down=('down', 'any'),
                effect=('std_effect', 'mean')).reset_index()
            per_cohort['p_up'] = (per_cohort['p_up'] * per_cohort['n_siblings']).clip(upper=1.0)
            per_cohort['p_down'] = (per_cohort['p_down'] * per_cohort['n_siblings']).clip(upper=1.0)
            p_up = per_cohort.pivot(index='module_key', columns='cohort', values='p_up')
            p_down = per_cohort.pivot(index='module_key', columns='cohort', values='p_down')
            stats_ = replication.replicability(p_up.to_numpy(), p_down.to_numpy(), method=facet_results.PC_METHOD)
            frame = pd.DataFrame({'p_pc': stats_['p_pc'], 'r_value': stats_['r_value'], 'direction': stats_['direction']},
                                 index=p_up.index)
            frame['m'] = p_up.notna().sum(axis=1).astype(int)
            k_up = per_cohort.groupby('module_key')['up'].sum().reindex(frame.index).fillna(0)
            k_down = per_cohort.groupby('module_key')['down'].sum().reindex(frame.index).fillna(0)
            frame['k'] = np.maximum(k_up, k_down).astype(int)
            frame['median_std_effect'] = per_cohort.groupby('module_key')['effect'].median().reindex(frame.index)
            direction_sign = frame['direction'].map({'up': 1.0, 'down': -1.0})
            signed = per_cohort.assign(_signed=per_cohort['effect'] * per_cohort['module_key'].map(direction_sign)) \
                .groupby('module_key')['_signed'].apply(lambda s: int((s >= min_std_effect).sum()))
            frame['n_cohorts_ge_gate'] = signed.reindex(frame.index).fillna(0).astype(int)
            frame['effect_gate_passed'] = frame['n_cohorts_ge_gate'] >= replication.DEFAULT_U
            frame['replicated'] = frame['r_value'] < replication.R_THRESHOLD
            names = per_cohort.groupby('module_key')[['catalog', 'module']].first().reindex(frame.index)
            frame = pd.concat([names, frame], axis=1).reset_index(drop=True)
            frame.insert(0, 'celltype_group', group)
            frame.insert(0, 'source', source)
            frame.insert(0, 'method', method)
            frame.insert(0, 'facet', facet)
            frame.insert(0, 'facet_scope', scope)
            output.append(frame[frame['r_value'].notna()])
    if not output:
        return pd.DataFrame(columns=['facet_scope', 'facet', 'method', 'source', 'celltype_group', 'catalog', 'module',
                                     'p_pc', 'r_value', 'direction', 'm', 'k', 'median_std_effect',
                                     'effect_gate_passed', 'replicated'])
    return pd.concat(output, ignore_index=True)


def summarize_results(out_root: Path, out_dir: Path, cohort_table: Optional[Path],
                      min_std_effect: float = 0.2) -> None:
    """Tables over all module result parquets: units, hits, recurring modules.

    Recurrence counts (dataset, stratum) units where a module is significant at
    q_perm < 0.05 AND q_param < 0.05, restricted to non-descriptive units, and
    reports how many positive and negative signs occur. Datasets are mapped to
    cohorts with the DRAFT cohort selection table (donor-overlap caveat of the
    design note): datasets with a role of duplicate / supplement / do not pool /
    never alongside / alternative B are dropped, and recurrence is counted over
    distinct cohorts (``n_cohorts``), not files (``n_datasets``). A hit also needs
    ``|std_effect| >= min_std_effect`` (default 0.2, the effect-size gate).
    """
    out_dir.mkdir(parents=True, exist_ok=True)
    files = sorted(out_root.glob('*/*.facet_module_tests.parquet'))
    if not files:
        print('no module result files')
        return
    table = pd.concat([pd.read_parquet(f) for f in files], ignore_index=True)
    if 'facet_scope' not in table:
        table['facet_scope'] = None
    table['facet_scope'] = table['facet_scope'].fillna(facet_scopes.DEFAULT_SCOPE)   # runs before v3: human only
    if 'descriptive_only' not in table:
        table['descriptive_only'] = table['n_lt5']
    table['unit'] = table['db_id'] + '|' + table['celltype_source'] + '::' + table['cell_type']
    gate = (table['std_effect'].abs() >= min_std_effect)
    table['significant'] = (table['q_param'] < Q_THRESHOLD) & (table['q_perm'] < Q_THRESHOLD) & gate
    table['sign'] = np.sign(table['estimate'])
    units = (table.groupby(['facet_scope', 'facet', 'method', 'source', 'unit', 'db_id', 'cell_type', 'celltype_source'])
             .agg(n_modules=('module', 'size'), n_donors=('n_donors', 'first'), n_lt5=('n_lt5', 'first'),
                  descriptive_only=('descriptive_only', 'first'),
                  n_sig_param=('q_param', lambda s: int((s < Q_THRESHOLD).sum())),
                  n_sig_perm=('q_perm', lambda s: int((s < Q_THRESHOLD).sum())),
                  n_sig_both=('significant', 'sum')).reset_index())
    units.to_csv(out_dir / 'module_units.tsv', sep='\t', index=False)
    per_facet = units[~units['descriptive_only']].groupby(['facet_scope', 'facet', 'method', 'source']).agg(
        testable_units=('unit', 'nunique'), datasets=('db_id', 'nunique'),
        units_with_param_hit=('n_sig_param', lambda s: int((s > 0).sum())),
        units_with_perm_hit=('n_sig_perm', lambda s: int((s > 0).sum())),
        total_param_hits=('n_sig_param', 'sum'), total_perm_hits=('n_sig_perm', 'sum'),
        total_both_hits=('n_sig_both', 'sum')).reset_index()
    per_facet.to_csv(out_dir / 'module_facet_summary.tsv', sep='\t', index=False)
    print(per_facet.to_string(index=False))

    eligible = table[~table['descriptive_only']].copy()
    eligible['cohort'] = eligible['db_id']
    if cohort_table is not None and cohort_table.exists():
        cohorts = pd.read_csv(cohort_table, sep='\t')
        excluded_roles = cohorts['role'].fillna('').str.contains(
            'duplicate|supplement|do not|never|alternative B|T20 only', case=False, regex=True)
        cohort_of = dict(zip(cohorts['db_id'], cohorts['cohort']))
        allowed = set(cohorts.loc[~excluded_roles, 'db_id'])
        eligible = eligible[eligible['db_id'].isin(allowed)].copy()
        eligible['cohort'] = eligible['db_id'].map(cohort_of)
    recurring = (eligible[eligible['significant']]
                 .groupby(['facet_scope', 'facet', 'method', 'source', 'catalog', 'module'])
                 .agg(n_cohorts=('cohort', 'nunique'), n_datasets=('db_id', 'nunique'), n_units=('unit', 'nunique'),
                      n_pos=('sign', lambda s: int((s > 0).sum())), n_neg=('sign', lambda s: int((s < 0).sum())),
                      median_std_effect=('std_effect', 'median')).reset_index())
    recurring['sign_consistent'] = (recurring['n_pos'] == 0) | (recurring['n_neg'] == 0)
    recurring = recurring.sort_values(['facet_scope', 'facet', 'method', 'n_cohorts', 'n_datasets'],
                                      ascending=[True, True, True, False, False])
    recurring.to_csv(out_dir / 'module_recurring.tsv', sep='\t', index=False)
    # also: how many cohorts were testable per facet/module family (denominator for recurrence)
    testable = (eligible.groupby(['facet_scope', 'facet', 'method', 'source'])
                .agg(n_cohorts_testable=('cohort', 'nunique'), n_datasets_testable=('db_id', 'nunique')).reset_index())
    testable.to_csv(out_dir / 'module_testable_cohorts.tsv', sep='\t', index=False)
    if cohort_table is not None and cohort_table.exists():
        replicated = replicated_modules(table, out_root, cohort_table, min_std_effect)
        replicated.to_csv(out_dir / 'module_replicated.tsv', sep='\t', index=False)
        families = (replicated.groupby(['facet_scope', 'facet', 'method', 'source', 'celltype_group'])
                    .agg(n_cohorts=('m', 'max'), modules=('module', 'size'),
                         r_below_05=('r_value', lambda s: int((s < 0.05).sum())),
                         replicated=('replicated', 'sum')).reset_index())
        families.to_csv(out_dir / 'module_replication_summary.tsv', sep='\t', index=False)
        print(families.to_string(index=False))
    calibration_rows = []
    for manifest_path in sorted(out_root.glob('*/*.facet_module_run_manifest.json')):
        manifest = json.loads(manifest_path.read_text())
        for unit in manifest.get('units', []):
            for source, record in (unit.get('calibration') or {}).items():
                calibration_rows.append({'db_id': manifest['db_id'], 'cell_type': unit['cell_type'],
                                         'celltype_source': unit['celltype_source'], 'facet': unit['facet'],
                                         'a_source': source, 'n_lt5': unit.get('n_lt5'), **record})
    if calibration_rows:
        pd.DataFrame(calibration_rows).to_csv(out_dir / 'module_calibration.tsv', sep='\t', index=False)


