def _entries(store_root: Path) -> Dict[str, Any]:
    return {e.db_id: e for e in aft.iter_h5adstore(store_root) if not e.study.startswith('_')}


def cmd_inventory(args: argparse.Namespace) -> None:
    store_root = Path(args.h5adstore_root).resolve()
    rows = []
    for entry in _entries(store_root).values():
        md_yaml, _ = aft.parse_md_file(entry.md_path)
        api_config = aft.get_api_config(md_yaml)
        annotation = aft.mus.resolve_annotation(entry.h5ad_path, root=store_root)
        eligible, reason = module_eligibility(entry, md_yaml, annotation, api_config)
        rows.append({'db_id': entry.db_id, 'file': entry.stem, 'eligible_metadata': eligible, 'reason': reason,
                     'has_counts': aft.counts_layer_for(entry, md_yaml) is not None if eligible else None})
    frame = pd.DataFrame(rows)
    if args.out:
        frame.to_csv(args.out, sep='\t', index=False)
    print(frame['reason'].value_counts().to_string())
    print('eligible with counts:', int((frame['eligible_metadata'] & frame['has_counts'].fillna(False)).sum()))


def cmd_run(args: argparse.Namespace) -> None:
    store_root = Path(args.h5adstore_root).resolve()
    out_root = Path(args.out_root) if args.out_root else store_root / '_facet_tests'
    facets = [f.strip() for f in args.facets.split(',') if f.strip()]
    for facet in facets:
        if facet not in aft.FACETS:
            sys.exit(f'unknown facet {facet}; choose from {aft.FACETS}')
    sources = [s.strip() for s in args.sources.split(',') if s.strip()]
    registry = GenesetRegistry(Path(args.geneset_store) if args.geneset_store else default_geneset_store())
    registry.scan()
    entries = _entries(store_root)
    targets = sorted(entries) if args.all else [t.strip() for t in args.db_id.split(',')]
    summary_rows = []
    for db_id in targets:
        entry = entries.get(db_id)
        if entry is None:
            print(f'unknown db_id {db_id}', file=sys.stderr)
            continue
        out_manifest = out_root / entry.study / f'{entry.stem}.facet_module_run_manifest.json'
        md_yaml, _ = aft.parse_md_file(entry.md_path)
        annotation = aft.mus.resolve_annotation(entry.h5ad_path, root=store_root)
        eligible, reason = module_eligibility(entry, md_yaml, annotation, aft.get_api_config(md_yaml))
        if not eligible:
            print(f'[skip] {db_id}: {reason}')
            summary_rows.append({'db_id': db_id, 'status': 'skipped', 'reason': reason})
            continue
        if out_manifest.exists() and not args.force and args.all:
            previous = json.loads(out_manifest.read_text())
            now_has_counts = aft.counts_layer_for(entry, md_yaml) is not None
            if previous.get('status') == 'done' and not (previous.get('no_counts') and now_has_counts):
                print(f'[skip existing] {db_id}')
                continue
        aft.wait_for_load(args.max_load)
        begin = time.time()
        try:
            manifest = process_dataset(entry, store_root, out_root, facets, registry, sources,
                                       args.permutations, threads=args.threads,
                                       memory_limit_gb=args.memory_gb,
                                       run_pseudobulk=not args.no_pseudobulk, keep_work=args.keep_work)
        except Exception as exc:
            import traceback
            traceback.print_exc()
            print(f'[error] {db_id}: {exc}', file=sys.stderr)
            summary_rows.append({'db_id': db_id, 'status': 'error', 'reason': str(exc)[:300]})
            continue
        if manifest['status'] == 'skipped':
            print(f'[skip] {db_id}: {manifest["reason"]}')
        else:
            n_ok = sum(1 for u in manifest['units'] if u['status'] == 'ok')
            print(f'[done] {db_id}: {n_ok}/{len(manifest["units"])} units, {manifest.get("n_result_rows", 0)} rows, '
                  f'no_counts={manifest["no_counts"]}, {time.time() - begin:.0f}s', flush=True)
        summary_rows.append({'db_id': db_id, 'status': manifest['status'], 'reason': manifest.get('reason', '')})
    if summary_rows:
        print(pd.DataFrame(summary_rows)['status'].value_counts().to_string())


def cmd_summarize(args: argparse.Namespace) -> None:
    store_root = Path(args.h5adstore_root).resolve()
    out_root = Path(args.out_root) if args.out_root else store_root / '_facet_tests'
    cohort = Path(args.cohort_table) if args.cohort_table else out_root / 'cohort_selection.DRAFT.tsv'
    summarize_results(out_root, Path(args.out_dir), cohort)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__.split('\n')[0])
    sub = parser.add_subparsers(dest='command', required=True)
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument('--h5adstore-root', default=None)
    common.add_argument('--out-root', default=None, help='default <h5adstore>/_facet_tests')
    inventory = sub.add_parser('inventory', parents=[common], help='eligibility table')
    inventory.add_argument('--out', default=None)
    run = sub.add_parser('run', parents=[common], help='run module facet tests')
    group = run.add_mutually_exclusive_group(required=True)
    group.add_argument('--db-id', help='comma-separated db_ids (e.g. G24/MMG)')
    group.add_argument('--all', action='store_true')
    run.add_argument('--facets', default=','.join(aft.FACETS))
    run.add_argument('--sources', default=','.join(DEFAULT_SOURCES),
                     help='sidecar sources to test (geneset = scanpy score_genes; ucell optional)')
    run.add_argument('--geneset-store', default=None)
    run.add_argument('--permutations', type=int, default=N_PERMUTATIONS)
    run.add_argument('--threads', type=int, default=4)
    run.add_argument('--memory-gb', type=int, default=24)
    run.add_argument('--max-load', type=float, default=12.0)
    run.add_argument('--force', action='store_true')
    run.add_argument('--no-pseudobulk', action='store_true', help='variant A only')
    run.add_argument('--keep-work', action='store_true')
    summarize = sub.add_parser('summarize', parents=[common], help='cross-dataset tables (exploratory)')
    summarize.add_argument('--out-dir', required=True)
    summarize.add_argument('--cohort-table', default=None)
    return parser


def main() -> None:
    args = build_parser().parse_args()
    if args.h5adstore_root is None:
        args.h5adstore_root = str(aft.default_store_root())
    {'inventory': cmd_inventory, 'run': cmd_run, 'summarize': cmd_summarize}[args.command](args)


if __name__ == '__main__':
    main()
