def module_eligibility(entry: Any, md_yaml: Dict[str, Any], annotation: Dict[str, Any],
                       api_config: Dict[str, Any]) -> Tuple[bool, str]:
    eligible, reason = aft.dataset_eligibility(entry, md_yaml, annotation, api_config,
                                               require_counts=False)
    if not eligible:
        return False, reason
    if not scores_path(entry.duckdb_path).exists():
        return False, 'no scores sidecar'
    return True, 'ok'


def package_versions() -> Dict[str, str]:
    return {'python': platform.python_version(), 'numpy': np.__version__, 'scipy': scipy.__version__,
            'pandas': pd.__version__, 'duckdb': duckdb.__version__}


MODULE_SAMPLES_SUFFIX = '.facet_module_samples.parquet'
MODULE_SCORES_SUFFIX = '.facet_module_sample_scores.parquet'


def _long_scores(matrix: pd.DataFrame, sample_ids: Sequence[int], method: str, label: str,
                 registry: GenesetRegistry) -> pd.DataFrame:
    """Per-sample module scores of one stratum as a long table (modules in scope of the stratum only)."""
    rows = matrix.reindex(list(sample_ids))
    columns = [tuple(column) for column in rows.columns]
    keep = [position for position, (_source, catalog, module) in enumerate(columns)
            if module_in_stratum(registry, catalog, module, label)]
    if not keep or rows.empty:
        return pd.DataFrame()
    values = rows.to_numpy(dtype=float)[:, keep]
    kept = [columns[position] for position in keep]
    frame = pd.DataFrame({
        'sample_idx': np.repeat(rows.index.to_numpy().astype('int64'), len(kept)),
        'source': np.tile([c[0] for c in kept], len(rows)), 'catalog': np.tile([c[1] for c in kept], len(rows)),
        'module': np.tile([c[2] for c in kept], len(rows)), 'score': values.ravel()})
    frame['method'] = method
    return frame.dropna(subset=['score'])


def write_module_sample_sidecars(out_dir: Path, stem: str, jobs: List[Dict[str, Any]],
                                 sample_key: Dict[Tuple[str, str], int], sample_n_cells: pd.Series,
                                 mean_scores: pd.DataFrame, background_scores: Dict[str, pd.DataFrame],
                                 registry: GenesetRegistry) -> int:
    """Write the replicate scores the module tests fitted (read by ``lib/facet_donor_values.py``).

    ``<stem>.facet_module_samples.parquet``: one row per (unit, replicate): ``facet``, ``cell_type``,
    ``celltype_source``, ``sample_idx``, ``facet_value``, the covariates as fitted, ``batch_code``, ``n_cells``.
    ``<stem>.facet_module_sample_scores.parquet``: ``sample_idx``, ``method``, ``source``, ``catalog``, ``module``,
    ``score`` for the modules in the cell type scope of the stratum (variant A: mean of the per-cell scores;
    variant B: the pseudobulk score). Replicate ids are never written. Returns the number of unit rows.
    """
    sample_rows: List[Dict[str, Any]] = []
    score_frames: List[pd.DataFrame] = []
    sample_ids_of_stratum: Dict[str, set] = {}
    label_of_stratum: Dict[str, str] = {}
    for job in jobs:
        if job['status'] != 'ok':
            continue
        design = job['design'].reset_index(drop=True)
        batch_codes = (pd.factorize(design['batch_value'].astype(str))[0]
                       if design['batch_value'].notna().all() and job['batch_used'] else np.full(len(design), -1))
        for position, row in enumerate(design.itertuples()):
            sample_idx = sample_key[(job['stratum'], row.donor)]
            sample_ids_of_stratum.setdefault(job['stratum'], set()).add(sample_idx)
            sample_rows.append({
                'facet': job['facet'], 'cell_type': job['label'], 'celltype_source': job['source'],
                'sample_idx': sample_idx, 'facet_value': row.facet_value, 'cov_sex': row.cov_sex,
                'cov_age': row.cov_age, 'cov_pmi': row.cov_pmi, 'cov_path': row.cov_path,
                'batch_code': int(batch_codes[position]), 'n_cells': int(sample_n_cells.loc[sample_idx])})
        label_of_stratum[job['stratum']] = job['label']
    if not sample_rows:
        for suffix in (MODULE_SAMPLES_SUFFIX, MODULE_SCORES_SUFFIX):
            (out_dir / f'{stem}{suffix}').unlink(missing_ok=True)
        return 0
    for stratum, ids in sample_ids_of_stratum.items():
        label = label_of_stratum[stratum]
        if len(mean_scores):
            score_frames.append(_long_scores(mean_scores, sorted(ids), METHOD_A, label, registry))
        if stratum in background_scores:
            score_frames.append(_long_scores(background_scores[stratum], sorted(ids), METHOD_B, label, registry))
    out_dir.mkdir(parents=True, exist_ok=True)
    pd.DataFrame(sample_rows).to_parquet(out_dir / f'{stem}{MODULE_SAMPLES_SUFFIX}', index=False)
    scores = pd.concat([f for f in score_frames if len(f)], ignore_index=True) if any(len(f) for f in score_frames) \
        else pd.DataFrame(columns=['sample_idx', 'source', 'catalog', 'module', 'score', 'method'])
    for column in ('source', 'catalog', 'module', 'method'):
        scores[column] = scores[column].astype('category')
    scores.to_parquet(out_dir / f'{stem}{MODULE_SCORES_SUFFIX}', index=False)
    return len(sample_rows)


def samples_only_problem(out_dir: Path, stem: str, md_sha256: str, jobs: List[Dict[str, Any]]) -> Optional[str]:
    """Why ``--samples-only`` must not write sidecars next to the stored module results (None: it may).

    The existing manifest must exist, come from the same ``.md`` and list the same tested units as this run.
    """
    try:
        existing = json.loads((out_dir / f'{stem}.facet_module_run_manifest.json').read_text())
    except (OSError, ValueError):
        return 'no readable module manifest; run the full module test first'
    if existing.get('md_sha256') != md_sha256:
        return 'the stored results were made from another .md; rerun the full module test'
    now = {(job['facet'], job['label'], job['source']) for job in jobs if job['status'] == 'ok'}
    before = {(unit['facet'], unit['cell_type'], unit['celltype_source']) for unit in existing.get('units', [])
              if unit.get('status') == 'ok'}
    if now != before:
        return f'the tested units differ from the stored results ({len(now ^ before)} units); rerun the full module test'
    return None


def process_dataset(entry: Any, store_root: Path, out_root: Path, facets: List[str],
                    registry: GenesetRegistry, sources: Sequence[str], n_permutations: int,
                    threads: int = 4, memory_limit_gb: int = 24, run_pseudobulk: bool = True,
                    keep_work: bool = False, null_control_seed: Optional[int] = None,
                    exclusion_from: Optional[List[str]] = None, exclusion_where: Optional[List[str]] = None,
                    all_donors: bool = False, samples_only: bool = False) -> Dict[str, Any]:
    """Run variants A and B over all strata and facets of one dataset; write parquet + manifest.

    ``samples_only``: compute the replicate scores and write only the sample sidecars
    (``write_module_sample_sidecars``) next to the stored results; no test is fitted, nothing else is
    written, and it refuses when the stored manifest does not match (``samples_only_problem``).

    Donor exclusions as in ``ant-facet-test`` (``facet_donor_exclusions`` of the .md,
    ``lib/donor_exclusions.py``); ``all_donors`` writes the full-donor run to the supplementary folder.
    """
    started = time.time()
    md_yaml, _ = aft.parse_md_file(entry.md_path)
    api_config = aft.get_api_config(md_yaml)
    annotation = aft.mus.resolve_annotation(entry.h5ad_path, root=store_root)
    md_rule = aft.donor_exclusions.rule_from_md(md_yaml)
    exclusion_rule = aft.donor_exclusions.combine(md_rule, exclusion_from or [], exclusion_where or [])
    variant = (aft.donor_exclusions.VARIANT_ALL_DONORS if (all_donors and md_rule)
               else aft.donor_exclusions.VARIANT_COUNTED)
    manifest: Dict[str, Any] = {
        'tool': TOOL_VERSION, 'db_id': entry.db_id, 'group': entry.study, 'file': entry.stem,
        'dataset_sha256': md_yaml.get('sha256'), 'md_path': str(entry.md_path),
        'md_sha256': aft.md_file_sha256(entry.md_path),
        'anthive4_git': aft.git_head(script_dir.parent.parent),
        'h5adstore_git': aft.git_head(store_root),
        'genesetstore_git': aft.git_head(registry.root),
        'timestamp_utc': dt.datetime.now(dt.timezone.utc).isoformat(timespec='seconds'),
        'seed': SEED, 'facets_requested': facets, 'sources': list(sources),
        'facet_notes': aft.facet_notes_from_md(md_yaml),
        'disease_basis': aft.disease_basis_of([md_yaml]),
        'versions': package_versions(),
        'parameters': {
            'n_permutations': n_permutations, 'permutation': 'facet labels shuffled across donors, '
            'covariates fixed, statistic = t of the full model, two-sided, p = (1+k)/(1+B)',
            'unit_seed': 'numpy default_rng([base seed, crc32 of "dataset|stratum|facet"])',
            'bh_family': '(dataset, stratum, facet, method) over the modules in the cell type scope of the stratum, '
                         'parametric and permutation separately',
            'celltype_scope': 'module tested only in strata of a matching cell type group (celltypes of the geneset store, '
                              'all = every stratum); role markers never tested',
            'n_bins': N_BINS, 'ctrl_size': CTRL_SIZE, 'min_module_genes': MIN_MODULE_GENES,
            'pseudobulk_expression': 'log2(CPM + 1), library size = all-gene count sum',
            'control_seed': 'default_rng([base seed, crc32 of "stratum|source|catalog|module"])',
            'min_score_coverage': MIN_SCORE_COVERAGE,
            'min_cells_per_sample': aft.MIN_CELLS_PER_SAMPLE, 'min_donors_dataset': aft.MIN_DONORS_DATASET,
            'min_donors_per_level': aft.MIN_DONORS_PER_LEVEL, 'n_lt5_threshold': aft.N_LT5_THRESHOLD,
            'numeric_min_donors_for_p': aft.NUMERIC_MIN_DONORS_FOR_P,
            'numeric_min_replicates': aft.NUMERIC_MIN_REPLICATES, 'numeric_min_distinct': aft.NUMERIC_MIN_DISTINCT,
            'min_residual_df': aft.MIN_RESIDUAL_DF, 'small_sample_flag_blocks_test': False,
            'min_donors_for_age_pmi': aft.MIN_DONORS_FOR_AGE_PMI,
            'min_covariate_coverage': aft.MIN_COVARIATE_COVERAGE, 'disease_provisional': True,
            'effect_gate_std_effect': EFFECT_GATE_STD,
            'effect_gate': 'passes_effect_gate = |std_effect| >= effect_gate_std_effect; modules count '
                           'as hits only when they pass it as well as q < 0.05',
            'duckdb_threads': threads, 'duckdb_memory_limit_gb': memory_limit_gb,
        },
    }
    eligible, reason = module_eligibility(entry, md_yaml, annotation, api_config)
    if not eligible:
        manifest.update(status='skipped', reason=reason)
        return manifest
    facet_scope = aft.dataset_scope(entry, annotation, api_config)
    manifest['facet_scope'] = facet_scope
    # the modules tool has no pathology-adjusted age model (sensitivity facets); app_nlgf runs with the gene tool's design
    facets = [f for f in aft.facets_for_scope(facet_scope, facets) if f not in aft.SENSITIVITY_FACETS]
    manifest['facets_tested_in_scope'] = facets
    try:
        app_design = aft.app_nlgf_design_from_md(md_yaml)
    except ValueError as exc:
        manifest.update(status='skipped', reason=str(exc))
        return manifest
    manifest['control_basis'] = app_design['control_basis']
    manifest['app_nlgf_design'] = {k: v for k, v in app_design.items() if k != 'control_basis' and v}
    if all_donors and md_rule is None:
        manifest.update(status='skipped', reason='--all-donors: this dataset has no facet_donor_exclusions '
                                                  'rule, its counted run already uses every donor')
        return manifest
    sidecar = scores_path(entry.duckdb_path)
    counts_info = aft.counts_layer_for(entry, md_yaml)
    no_counts = counts_info is None or not run_pseudobulk
    manifest['no_counts'] = counts_info is None
    manifest['counts_layer'] = counts_info[0] if counts_info else None

    work_dir = Path(tempfile.mkdtemp(prefix='ant_facet_mod_', dir=os.environ.get('ANT_FACET_TMP')))
    conn = aft.open_dataset(entry, api_config, threads=threads, memory_limit_gb=memory_limit_gb,
                            temp_dir=work_dir, store_root=store_root)
    try:
        cat_columns = aft.view_columns(conn, 'obscat') if aft._has_view(conn, 'obscat') else {}
        wanted = ['ant_donor', 'ant_donor_uid', 'ant_sex', 'ant_host_sex', 'ant_disease', 'ant_apoe',
                  'ant_apoe4_carrier', 'ant_apoe_carrier', 'ant_app_nlgf', 'ant_braak', 'ant_age', 'ant_pmi',
                  'ant_cell_type', 'ant_author_cell_type',
                  'ant_tissue', 'tissue_uberon', 'ant_region', *aft.AUTHOR_CLUSTER_COLUMNS]
        extra = [c for c in cat_columns if (aft.CELLTYPE_CANDIDATE_RE.match(c) or aft.BATCH_NAME_RE.search(c))
                 and not c.startswith('ant_')]
        design_columns = aft.design_columns_of(app_design) if 'app_nlgf' in facets else []
        exclusion_columns = [c for c in (exclusion_rule.obs_columns if exclusion_rule else [])
                             + aft.donor_exclusions.declared_columns(md_yaml) + design_columns
                             if c not in wanted and c not in extra]
        member_columns = set(cat_columns) | set(aft.view_columns(conn, 'obsnum') if aft._has_view(conn, 'obsnum') else {})
        replicate = aft.replicates.resolve_replicate(md_yaml, annotation, member_columns)
        manifest.update(replicate_unit=replicate['replicate_unit'], replicate_column=replicate['replicate_column'],
                        replicate_basis=replicate['basis'])
        if replicate['replicate_column'] and replicate['replicate_column'] not in wanted:
            wanted.append(replicate['replicate_column'])
        cells = aft.cell_table(conn, wanted + extra + exclusion_columns)
        missing_design = [c for c in design_columns if c not in cells]
        if missing_design:
            manifest.update(status='skipped',
                            reason=f'app_nlgf_design column(s) {missing_design} are not obs columns of the view')
            return manifest
        if replicate['replicate_unit'] == 'none' or not replicate['replicate_column']:
            manifest.update(status='skipped', reason='replicate_unit is none: cell-level, descriptive only')
            return manifest
        if replicate['replicate_column'] not in cells:
            manifest.update(status='skipped',
                            reason=f'replicate_column {replicate["replicate_column"]} is not an obs column')
            return manifest
        if replicate['replicate_column'] != 'ant_donor':
            cells['ant_donor'] = cells[replicate['replicate_column']]
        if replicate['replicate_unit'] != 'donor' and 'ant_donor_uid' in cells:
            cells['ant_donor_uid'] = None      # the uid names a person; an animal or sample is keyed by its label
        cells, exclusion_report = aft.donor_exclusions.apply_rule(cells, exclusion_rule, variant)
        if exclusion_report is not None:
            manifest['donor_exclusion'] = exclusion_report
        batch_column = (aft.donor_exclusions.declared_batch_column(md_yaml, cells)
                        or aft.find_batch_column(conn, cells))
        if batch_column is not None:
            cells['batch'] = cells[batch_column]
        manifest['batch_column'] = batch_column
        n_donors_all = int(cells['ant_donor'].dropna().astype(str).nunique())
        manifest['n_cells'] = int(len(cells))
        manifest['n_donors'] = n_donors_all
        if n_donors_all < aft.MIN_DONORS_DATASET:
            manifest.update(status='skipped', reason=f'{n_donors_all} replicates (< {aft.MIN_DONORS_DATASET}, '
                                                      f'the smallest numeric test)')
            return manifest

        donor_table, conflicts = aft.build_donor_table(cells, {
            'timepoint': app_design['timepoint'], 'graft_line': app_design['graft_line'],
            'covariates': app_design['covariates']})
        manifest['donor_conflicts'] = conflicts
        floors = aft.donor_exclusions.min_age_floors(md_yaml)
        floors.setdefault('age', aft.AGE_FACET_MIN_AGE)
        below_floor, age_floor_report = aft.donor_exclusions.below_age_floor(donor_table, floors)
        if age_floor_report:
            manifest['facet_min_age'] = age_floor_report
        # Cross-dataset donor keys (lib/donor_keys.py): ant_donor_uid, else
        # <group_id>:<ant_donor>. Each tested unit records its donors' keys so
        # replication can count distinct donors across datasets.
        donor_key_of, donor_key_stats = aft.donor_key_map(
            zip(cells['ant_donor'], cells['ant_donor_uid'] if 'ant_donor_uid' in cells
                else [None] * len(cells)), entry.group_id)
        manifest['donor_keys'] = {'basis': aft.DONOR_COUNT_BASIS, **donor_key_stats}
        manifest['null_control_seed'] = null_control_seed
        if null_control_seed is not None:
            # negative control: every facet column is shuffled across donors (age, PMI and
            # batch stay), so any hit is a false positive. Never write this to the real output.
            shuffler = np.random.default_rng([SEED, null_control_seed])
            facets = [name for name in facets if name != 'age']     # age is a covariate of the others: never shuffled
            for facet_name in (name for name in aft.FACETS if name != 'age'):
                if facet_name in donor_table:
                    donor_table[facet_name] = donor_table[facet_name].to_numpy()[shuffler.permutation(len(donor_table))]
        membership, strata_note = aft.choose_strata(cells, cat_columns)
        manifest['celltype_note'] = strata_note
        manifest['celltype_sources'] = sorted(membership['source'].unique().tolist())
        cell_frame = cells.assign(pos=np.arange(len(cells)))[['pos', 'cell_id', 'ant_donor']]
        usable = membership.merge(cell_frame, on='pos', how='inner')
        usable = usable[usable['ant_donor'].notna()].copy()
        usable['donor'] = usable['ant_donor'].astype(str)
        usable['stratum'] = usable['source'] + '::' + usable['label']

        sample_sizes = usable.groupby(['stratum', 'source', 'label', 'donor']).size() \
            .rename('n_cells').reset_index()
        n_groups = int(len(sample_sizes))
        n_dropped_small = int((sample_sizes['n_cells'] < aft.MIN_CELLS_PER_SAMPLE).sum())
        sample_sizes = sample_sizes[sample_sizes['n_cells'] >= aft.MIN_CELLS_PER_SAMPLE] \
            .reset_index(drop=True)
        manifest['samples'] = {'n_donor_celltype_groups': n_groups,
                               'n_dropped_lt_min_cells': n_dropped_small, 'n_kept': int(len(sample_sizes))}
        donor_totals = cells[cells['ant_donor'].notna()].assign(
            donor=lambda f: f['ant_donor'].astype(str)).groupby('donor').size()

        jobs: List[Dict[str, Any]] = []
        for stratum, frame in sample_sizes.groupby('stratum'):
            for facet in facets:
                stratum_donor_labels = aft.donor_exclusions.stratum_donors(frame['donor'], facet, below_floor)
                subsets: List[Tuple[Optional[str], Iterable[str]]] = [(None, stratum_donor_labels)]
                table, refuse = donor_table, None
                if facet == 'app_nlgf':
                    subsets = aft.split_by_design(donor_table, stratum_donor_labels, app_design)
                    if app_design['covariates']:
                        table = donor_table.assign(batch=donor_table['design_cov'])
                        refuse = ' and '.join(app_design['covariates'])
                for subset_label, subset_donors in subsets:
                    plan = aft.plan_job(table, facet, subset_donors, scope=facet_scope,
                                        replicate_unit=replicate['replicate_unit'], refuse_confounded=refuse)
                    plan.update(stratum=str(stratum), label=str(frame['label'].iloc[0]), design_subset=subset_label,
                                source=str(frame['source'].iloc[0]) + (f'@{subset_label}' if subset_label else ''))
                    jobs.append(plan)
        needed = {(job['stratum'], donor) for job in jobs if job['status'] == 'ok'
                  for donor in job['design']['donor']}
        keep = sample_sizes[[(s, d) in needed for s, d in zip(sample_sizes['stratum'], sample_sizes['donor'])]] \
            .reset_index(drop=True)
        keep['sample_idx'] = np.arange(len(keep))
        manifest['strata'] = {str(k): int(v) for k, v in keep.groupby('stratum')['donor'].nunique().items()}
        sample_key = {(r.stratum, r.donor): int(r.sample_idx) for r in keep.itertuples()}
        sample_n_cells = keep.set_index('sample_idx')['n_cells']

        modules = sidecar_modules(sidecar, sources)
        if modules.empty:
            manifest.update(status='skipped', reason=f'scores sidecar has no rows for sources {list(sources)}')
            return manifest
        catalog_report: Dict[str, Dict[str, int]] = {}
        symbols = aft.gene_symbols(conn)
        module_genes, gene_counts = load_module_genes(registry, modules, symbols)
        for source, catalog, module in modules.itertuples(index=False):
            entry_report = catalog_report.setdefault(f'{source}::{catalog}', {
                'n_modules_sidecar': 0, 'n_modules_with_gene_list_ge3': 0})
            entry_report['n_modules_sidecar'] += 1
            entry_report['n_modules_with_gene_list_ge3'] += int((GENE_LIST_SOURCE, catalog, module) in module_genes)
        manifest['catalogs'] = catalog_report

        # ---- variant A: donor means of the per-cell scores
        pb_cells = usable.merge(keep[['stratum', 'donor', 'sample_idx']], on=['stratum', 'donor'], how='inner')
        mean_scores = coverage = pd.DataFrame()
        if len(keep):
            mean_scores, coverage = cell_mean_scores(conn, sidecar, pb_cells[['cell_id', 'sample_idx']],
                                                     sample_n_cells, sources)

        # ---- variant B: pseudobulk log-CPM scores per stratum
        background_scores: Dict[str, pd.DataFrame] = {}
        control_counts: Dict[str, Dict[ModuleKey, int]] = {}
        pb_error = None
        if not no_counts and len(keep) and module_genes:
            try:
                long_counts = aft.pseudobulk(conn, counts_info[1], pb_cells[['cell_id', 'sample_idx']])
                gene_order = symbols['gene_id'].to_numpy()
                position_of_gene = pd.Series(np.arange(len(gene_order)), index=gene_order)
                long_counts = long_counts.assign(gene_id=position_of_gene.reindex(long_counts['gene_id']).to_numpy())
                long_counts = long_counts[long_counts['gene_id'].notna()].astype({'gene_id': int})
                for stratum, frame in keep.groupby('stratum'):
                    ids = frame['sample_idx'].to_numpy()
                    label = str(frame['label'].iloc[0])
                    in_scope = {key: genes for key, genes in module_genes.items()
                                if module_in_stratum(registry, key[1], key[2], label)}
                    if not in_scope:
                        continue
                    log_cpm = counts_to_log_cpm(pseudobulk_dense(long_counts, ids, len(gene_order)))
                    scores_b, n_ctrl = background_matched_scores(log_cpm, in_scope, str(stratum))
                    scores_b.index = ids
                    background_scores[str(stratum)] = scores_b
                    control_counts[str(stratum)] = n_ctrl
                    del log_cpm
            except Exception as exc:  # keep variant A
                pb_error = f'{type(exc).__name__}: {exc}'
                background_scores = {}
        manifest['pseudobulk_error'] = pb_error

        sidecar_dir = aft.donor_exclusions.result_dir(out_root, entry.study, md_rule is not None, all_donors)
        if samples_only:
            stale = samples_only_problem(sidecar_dir, entry.stem, manifest['md_sha256'], jobs)
            if stale:
                manifest.update(status='skipped', reason=f'--samples-only: {stale}')
                return manifest
        n_sample_rows = write_module_sample_sidecars(sidecar_dir, entry.stem, jobs, sample_key, sample_n_cells,
                                                     mean_scores, background_scores, registry)
        manifest['sample_sidecar_rows'] = n_sample_rows
        if samples_only:
            manifest.update(status='samples_only', units=[], runtime_seconds=round(time.time() - started, 1))
            return manifest

        frames: List[pd.DataFrame] = []
        unit_records: List[Dict[str, Any]] = []
        for job in jobs:
            record: Dict[str, Any] = {'facet': job['facet'], 'cell_type': job['label'],
                                      'celltype_source': job['source'], 'status': job['status'],
                                      'n_donors_with_sample': job['n_donors_with_sample'],
                                      'level_counts': job.get('level_counts'),
                                      'replicate_unit': replicate['replicate_unit'],
                                      'replicate_column': replicate['replicate_column'],
                                      'facet_scope': facet_scope, 'design_subset': job.get('design_subset'),
                                      'control_basis': app_design['control_basis'] if job['facet'] == 'app_nlgf' else None}
            if job['status'] != 'ok':
                record.update(analysis_level=aft.replicates.LEVEL_CELL,
                              analysis_level_label=aft.replicates.CELL_LEVEL_LABEL,
                              analysis_level_reason=job['status'])
                unit_records.append(record)
                continue
            numeric_facet = job['facet'] in aft.NUMERIC_FACETS
            level = aft.replicates.analysis_level(
                replicate['replicate_unit'], numeric_facet,
                n_per_level=None if numeric_facet else job['level_counts'],
                n_replicates=job['level_counts'].get('n_donors') if numeric_facet else None,
                n_distinct=job['level_counts'].get('n_distinct') if numeric_facet else None)
            record.update(analysis_level=level['analysis_level'], analysis_level_label=level['label'],
                          analysis_level_reason=level['reason'])
            below_floor = level['analysis_level'] == aft.replicates.LEVEL_BELOW_FLOOR
            design = job['design'].reset_index(drop=True)
            record['donor_key_digests'] = sorted({
                aft.key_digest(donor_key_of.get(str(donor), f'{entry.group_id}:{donor}'))
                for donor in design['donor']})
            sample_ids = [sample_key[(job['stratum'], donor)] for donor in design['donor']]
            stratum_cells = sample_n_cells.reindex(sample_ids).to_numpy()
            proportions = pd.Series(stratum_cells / donor_totals.reindex(design['donor']).to_numpy(),
                                    index=design['donor'])
            composition_p = aft.composition_test(proportions, design.set_index('donor'), job['facet'])
            # the subset joins the key only when there is one, so the seeds of every other unit stay as they were
            unit_key = (entry.db_id, job['stratum'], job['facet'], *([job['design_subset']] if job['design_subset'] else []))
            record.update(
                n_lt5=bool(job['n_lt5']), small_sample=bool(job['n_lt5']), descriptive_only=below_floor,
                batch_used=job['batch_used'], batch_confounded=job['batch_confounded'],
                covariates=job['covariates'], covariates_omitted=job['covariates_omitted'],
                n_donors_analysed=job['n_donors_analysed'],
                n_donors_dropped_covariate=job['n_donors_dropped_covariate'],
                composition_p=composition_p,
                composition_flag=bool(composition_p is not None and composition_p < aft.COMPOSITION_ALPHA),
                n_cells_in_stratum=int(stratum_cells.sum()),
                n_distinct_label_permutations=n_distinct_label_permutations(design['facet_value'].to_numpy()))
            per_method: Dict[Tuple[str, str], pd.DataFrame] = {}      # (method, source) -> frame
            # variant A: one BH family per sidecar source
            if len(mean_scores):
                a_values = mean_scores.reindex(sample_ids).reset_index(drop=True)
                low_cov = coverage.reindex(sample_ids).min(axis=0)
                in_scope_columns = np.array([module_in_stratum(registry, catalog, module, job['label'])
                                             for _source, catalog, module in a_values.columns])
                record['n_modules_in_scope'] = int(in_scope_columns.sum())
                record['n_modules_out_of_scope'] = int((~in_scope_columns).sum())
                for source in sorted(set(a_values.columns.get_level_values('source'))):
                    sub = a_values.loc[:, (a_values.columns.get_level_values('source') == source) & in_scope_columns]
                    if sub.shape[1] == 0:
                        continue
                    try:
                        a_frame = fit_modules(sub, design, job['batch_used'], below_floor,
                                              unit_key, n_permutations)
                    except ValueError as exc:
                        record[f'method_A_{source}_error'] = str(exc)
                        continue
                    a_frame['min_score_coverage'] = low_cov.reindex(a_frame.index).to_numpy()
                    per_method[(METHOD_A, source)] = a_frame
            # variant B
            scores_b = background_scores.get(job['stratum'])
            if scores_b is not None and len(scores_b.columns):
                try:
                    b_frame = fit_modules(scores_b.reindex(sample_ids).reset_index(drop=True), design,
                                          job['batch_used'], below_floor, unit_key, n_permutations)
                    b_frame['n_control_genes'] = [control_counts[job['stratum']].get(tuple(k)) for k in b_frame.index]
                    per_method[(METHOD_B, GENE_LIST_SOURCE)] = b_frame
                except ValueError as exc:
                    record['method_B_error'] = str(exc)
            for (method, source), frame in per_method.items():
                label = f'{method}_{source}'
                record[f'n_modules_{label}'] = int(len(frame))
                record[f'n_sig_q05_param_{label}'] = int((frame['q_param'] < Q_THRESHOLD).sum())
                record[f'n_sig_q05_perm_{label}'] = int((frame['q_perm'] < Q_THRESHOLD).sum())
            if (METHOD_B, GENE_LIST_SOURCE) in per_method:
                b_by_module = per_method[(METHOD_B, GENE_LIST_SOURCE)].copy()
                b_by_module.index = pd.MultiIndex.from_tuples([(k[1], k[2]) for k in b_by_module.index])
                calibration = {}
                for (method, source), frame in per_method.items():
                    if method != METHOD_A:
                        continue
                    a_by_module = frame.copy()
                    a_by_module.index = pd.MultiIndex.from_tuples([(k[1], k[2]) for k in a_by_module.index])
                    calibration[source] = correlate_methods(a_by_module, b_by_module)
                if calibration:
                    record['calibration'] = calibration
            unit_records.append(record)
            for (method, _source), frame in per_method.items():
                frame = frame.copy()
                index = pd.MultiIndex.from_tuples(frame.index, names=['source', 'catalog', 'module'])
                frame.index = index
                frame = frame.reset_index()
                frame['method'] = method
                frame['facet'] = job['facet']
                frame['cell_type'] = job['label']
                frame['celltype_source'] = job['source']
                frame['design_subset'] = job['design_subset']
                level_counts = job['level_counts']
                if job['facet'] in aft.NUMERIC_FACETS:
                    frame['contrast'] = aft.NUMERIC_CONTRAST[job['facet']]
                    frame['level_ref'] = None
                    frame['level_test'] = None
                    frame['n_donors_ref'] = np.nan
                    frame['n_donors_test'] = np.nan
                else:
                    reference, tested = aft.CONTRAST[job['facet']]
                    frame['contrast'] = f'{tested}_vs_{reference}'
                    frame['level_ref'], frame['level_test'] = reference, tested
                    frame['n_donors_ref'] = level_counts[reference]
                    frame['n_donors_test'] = level_counts[tested]
                frame['n_donors'] = job['n_donors_analysed']
                frame['n_lt5'] = bool(job['n_lt5'])
                frame['small_sample'] = bool(job['n_lt5'])
                frame['descriptive_only'] = below_floor
                frame['facet_scope'] = facet_scope
                frame['passes_effect_gate'] = frame['std_effect'].abs() >= EFFECT_GATE_STD
                frame['batch_used'] = job['batch_used']
                frame['batch_confounded'] = job['batch_confounded']
                frame['covariates'] = ','.join(job['covariates'])
                frame['composition_p'] = composition_p
                frame['composition_flag'] = record['composition_flag']
                frame['provisional'] = aft.PROVISIONAL_FLAGS.get(job['facet'], False)
                frames.append(frame)

        out_dir = aft.donor_exclusions.result_dir(out_root, entry.study, md_rule is not None, all_donors)
        out_dir.mkdir(parents=True, exist_ok=True)
        if frames:
            table = pd.concat(frames, ignore_index=True)
            if 'n_control_genes' not in table:
                table['n_control_genes'] = np.nan
            table['n_genes_requested'] = [gene_counts.get((c, m), {}).get('requested')
                                          for c, m in zip(table['catalog'], table['module'])]
            table['n_genes_found'] = [gene_counts.get((c, m), {}).get('found')
                                      for c, m in zip(table['catalog'], table['module'])]
            table['no_counts'] = bool(manifest['no_counts'])
            table['multi_tissue_donors'] = int((donor_table['n_tissues'] > 1).sum())
            table.insert(0, 'db_id', entry.db_id)
            table.insert(1, 'dataset', entry.stem)
            table.to_parquet(out_dir / f'{entry.stem}.facet_module_tests.parquet', index=False)
            manifest['n_result_rows'] = int(len(table))
            for (method, source), sub in table.groupby(['method', 'source']):
                manifest[f'n_modules_scored_{method}_{source}'] = int(
                    sub[['catalog', 'module']].drop_duplicates().shape[0])
        manifest['units'] = unit_records
        manifest['multi_tissue_donors'] = int((donor_table['n_tissues'] > 1).sum())
        manifest.update(status='done', runtime_seconds=round(time.time() - started, 1))
        (out_dir / f'{entry.stem}.facet_module_run_manifest.json').write_text(
            json.dumps(manifest, indent=2, default=aft._json_default))
        return manifest
    finally:
        conn.close()
        if not keep_work:
            shutil.rmtree(work_dir, ignore_errors=True)


