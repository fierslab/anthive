def benjamini_hochberg(p_values: np.ndarray) -> np.ndarray:
    """BH adjusted p values; NaN stay NaN and do not count towards the family size."""
    p_values = np.asarray(p_values, dtype=float)
    adjusted = np.full(p_values.shape, np.nan)
    valid = ~np.isnan(p_values)
    if not valid.any():
        return adjusted
    values = p_values[valid]
    order = np.argsort(values)
    ranked = values[order] * len(values) / (np.arange(len(values)) + 1)
    ranked = np.minimum.accumulate(ranked[::-1])[::-1]
    result = np.empty(len(values))
    result[order] = np.minimum(ranked, 1.0)
    adjusted[valid] = result
    return adjusted


def build_design(design: pd.DataFrame, batch_used: bool) -> Tuple[np.ndarray, np.ndarray, List[str]]:
    """Facet vector and nuisance matrix from a ``plan_job`` design frame.

    Returns (facet vector (n,), Z (n, q) with intercept + covariates, names of Z columns).
    Covariate columns that are entirely NaN are omitted, as in the R design of the gene tool.
    """
    n_donors = len(design)
    columns = [np.ones(n_donors)]
    names = ['intercept']
    for name in ('cov_sex', 'cov_age', 'cov_pmi'):
        if name in design and design[name].notna().any():
            columns.append(design[name].to_numpy(dtype=float))
            names.append(name)
    if batch_used:
        dummies = pd.get_dummies(design['batch_value'].astype(str), drop_first=True, dtype=float)
        for column in dummies.columns:
            columns.append(dummies[column].to_numpy())
            names.append(f'batch_{column}')
    return design['facet_value'].to_numpy(dtype=float), np.column_stack(columns), names


def _residualise(matrix: np.ndarray, basis: np.ndarray) -> np.ndarray:
    return matrix - basis @ (basis.T @ matrix)


def facet_effect_statistics(scores: np.ndarray, facet: np.ndarray, nuisance: np.ndarray
                            ) -> Dict[str, np.ndarray]:
    """OLS coefficient of ``facet`` for every column of ``scores`` (Frisch-Waugh).

    Args:
        scores: (n_donors, n_modules) donor-level scores, no NaN.
        facet: (n_donors,) facet vector (0/1 or numeric).
        nuisance: (n_donors, q) intercept + covariates.

    Returns:
        dict of arrays over modules: estimate, se, t, df (scalar array), p_param,
        ci_low, ci_high, residual_sd. Modules with zero residual variance get NaN.
    """
    n_donors = scores.shape[0]
    basis, _ = np.linalg.qr(nuisance)
    df = n_donors - nuisance.shape[1] - 1
    facet_resid = _residualise(facet[:, None], basis)[:, 0]
    facet_ss = float(facet_resid @ facet_resid)
    scores_resid = _residualise(scores, basis)
    estimate = (facet_resid @ scores_resid) / facet_ss
    rss = np.maximum((scores_resid ** 2).sum(axis=0) - estimate ** 2 * facet_ss, 0.0)
    scale = np.maximum((scores_resid ** 2).sum(axis=0), 1e-300)
    degenerate = rss <= 1e-12 * scale
    sigma2 = rss / df
    se = np.sqrt(sigma2 / facet_ss)
    with np.errstate(divide='ignore', invalid='ignore'):
        t_stat = np.where(degenerate, np.nan, estimate / se)
    p_param = 2 * stats.t.sf(np.abs(t_stat), df)
    quantile = stats.t.ppf(0.975, df)
    se = np.where(degenerate, np.nan, se)
    return {'estimate': np.where(degenerate, np.nan, estimate), 'se': se, 't': t_stat,
            'df': np.full(estimate.shape, float(df)), 'p_param': p_param,
            'ci_low': estimate - quantile * se, 'ci_high': estimate + quantile * se,
            'residual_sd': np.sqrt(rss / df)}


def permutation_p_values(scores: np.ndarray, facet: np.ndarray, nuisance: np.ndarray,
                         observed_t: np.ndarray, n_permutations: int,
                         rng: np.random.Generator) -> Tuple[np.ndarray, int]:
    """Two-sided permutation p of the facet t statistic by shuffling facet labels.

    Facet labels are permuted across donors, covariates stay fixed, the t
    statistic of the full model is recomputed for every module and shuffle.
    p = (1 + #{|t_perm| >= |t_obs|}) / (1 + B_effective); shuffles whose
    permuted facet is collinear with the covariates are discarded.

    Returns (p values over modules, effective number of permutations).
    """
    n_donors = scores.shape[0]
    basis, _ = np.linalg.qr(nuisance)
    df = n_donors - nuisance.shape[1] - 1
    scores_resid = _residualise(scores, basis)
    total_ss = (scores_resid ** 2).sum(axis=0)
    shuffle_index = np.argsort(rng.random((n_permutations, n_donors)), axis=1)
    permuted = facet[shuffle_index].T                              # (n_donors, B)
    permuted_resid = _residualise(permuted, basis)
    facet_ss = (permuted_resid ** 2).sum(axis=0)                   # (B,)
    usable = facet_ss > 1e-10 * max(float(facet @ facet), 1e-300)
    permuted_resid, facet_ss = permuted_resid[:, usable], facet_ss[usable]
    cross = permuted_resid.T @ scores_resid                        # (B, m)
    estimate = cross / facet_ss[:, None]
    rss = np.maximum(total_ss[None, :] - estimate ** 2 * facet_ss[:, None], 1e-300)
    with np.errstate(divide='ignore', invalid='ignore'):
        t_permuted = estimate / np.sqrt(rss / df / facet_ss[:, None])
    exceed = (np.abs(t_permuted) >= np.abs(observed_t)[None, :] - 1e-9).sum(axis=0)
    n_effective = int(usable.sum())
    p_values = (1.0 + exceed) / (1.0 + n_effective)
    p_values = np.where(np.isnan(observed_t), np.nan, p_values)
    return p_values, n_effective


def n_distinct_label_permutations(facet: np.ndarray) -> float:
    """Number of distinct arrangements of the facet labels (multinomial coefficient)."""
    _, counts = np.unique(facet, return_counts=True)
    log_value = math.lgamma(len(facet) + 1) - sum(math.lgamma(c + 1) for c in counts)
    return float(math.exp(min(log_value, 700.0)))


def unit_seed(*parts: Any) -> List[int]:
    """Deterministic numpy seed sequence from the base seed and a textual unit key."""
    return [SEED, zlib.crc32('|'.join(str(p) for p in parts).encode())]


def fit_modules(scores: pd.DataFrame, design: pd.DataFrame, batch_used: bool, descriptive_only: bool,
                 unit_key: Sequence[Any], n_permutations: int = N_PERMUTATIONS) -> pd.DataFrame:
    """Facet effect, parametric and permutation tests for every module of one unit.

    Args:
        scores: donor-level scores, rows aligned with ``design`` rows, columns = module ids.
        design: ``plan_job`` design frame (facet_value, cov_*, batch_value).
        batch_used: whether batch enters the model.
        descriptive_only: n_lt5 unit; p, q, t and CI are returned as NaN.
        unit_key: seed key (same for both methods so both see identical shuffles).
        n_permutations: number of label shuffles.

    Returns:
        frame indexed by module with estimate, se, t, df, p_param, ci_low, ci_high,
        std_effect, residual_sd, p_perm, q_param, q_perm, n_perm_effective.
        Modules with any non-finite donor score are dropped.
    """
    facet, nuisance, _ = build_design(design, batch_used)
    finite = np.isfinite(scores.to_numpy(dtype=float)).all(axis=0)
    scores = scores.loc[:, finite]
    values = scores.to_numpy(dtype=float)
    if np.linalg.matrix_rank(np.column_stack([nuisance, facet])) < nuisance.shape[1] + 1:
        raise ValueError('rank deficient design')
    if len(facet) - nuisance.shape[1] - 1 < MIN_RESIDUAL_DF:
        raise ValueError('fewer than 2 residual df')
    result = facet_effect_statistics(values, facet, nuisance)
    frame = pd.DataFrame(result, index=scores.columns)
    score_sd = values.std(axis=0, ddof=1)
    frame['score_sd'] = score_sd
    with np.errstate(divide='ignore', invalid='ignore'):
        frame['std_effect'] = np.where(score_sd > 0, frame['estimate'] / score_sd, np.nan)
    rng = np.random.default_rng(unit_seed(*unit_key))
    p_perm, n_effective = permutation_p_values(values, facet, nuisance, result['t'], n_permutations, rng)
    frame['p_perm'] = p_perm
    frame['n_perm_effective'] = n_effective
    if descriptive_only:
        for column in ('t', 'p_param', 'p_perm', 'ci_low', 'ci_high'):
            frame[column] = np.nan
    frame['q_param'] = benjamini_hochberg(frame['p_param'].to_numpy())
    frame['q_perm'] = benjamini_hochberg(frame['p_perm'].to_numpy())
    return frame


# --------------------------------------------------------------------------
# Variant B: pseudobulk log-CPM and background-matched module scores
# --------------------------------------------------------------------------

def counts_to_log_cpm(counts: np.ndarray) -> np.ndarray:
    """log2(CPM + 1) with library size = total counts of all genes of the sample."""
    library = counts.sum(axis=1, keepdims=True).astype(np.float64)
    library[library == 0] = 1.0
    return np.log2(counts / library * 1e6 + 1.0).astype(np.float32)


def control_gene_indices(gene_average: np.ndarray, module_genes: np.ndarray, n_bins: int,
                         ctrl_size: int, rng: np.random.Generator) -> np.ndarray:
    """Expression-matched control genes, scanpy ``score_genes`` logic.

    Genes are cut into bins of equal rank size of their average expression
    (``rank(method='min') // round(n_genes / (n_bins - 1))``). For every module
    gene, ``ctrl_size`` genes are drawn without replacement from its bin
    (module genes excluded; the whole bin when it holds fewer), and the union
    is the control set.
    """
    n_items = max(int(np.round(len(gene_average) / (n_bins - 1))), 1)
    bins = (pd.Series(gene_average).rank(method='min').to_numpy() // n_items).astype(int)
    is_module = np.zeros(len(gene_average), dtype=bool)
    is_module[module_genes] = True
    chosen: List[np.ndarray] = []
    for gene in module_genes:
        candidates = np.flatnonzero((bins == bins[gene]) & ~is_module)
        if len(candidates) > ctrl_size:
            candidates = rng.choice(candidates, size=ctrl_size, replace=False)
        chosen.append(candidates)
    return np.unique(np.concatenate(chosen)) if chosen else np.array([], dtype=int)


def background_matched_scores(log_cpm: np.ndarray, module_genes: Dict[ModuleKey, np.ndarray],
                              stratum_key: str, n_bins: int = N_BINS, ctrl_size: int = CTRL_SIZE
                              ) -> Tuple[pd.DataFrame, Dict[ModuleKey, int]]:
    """Per-sample module score = mean(module genes) - mean(control genes), all in log2 CPM.

    The control set of a module is drawn once per stratum (bins from the mean
    expression over the stratum's samples) with an rng seeded from
    (SEED, stratum, module), so results do not depend on processing order.

    Returns (samples x modules frame, number of control genes per module).
    """
    gene_average = log_cpm.mean(axis=0)
    columns: Dict[ModuleKey, np.ndarray] = {}
    n_controls: Dict[ModuleKey, int] = {}
    for key, genes in module_genes.items():
        rng = np.random.default_rng(unit_seed(stratum_key, *key))
        controls = control_gene_indices(gene_average, genes, n_bins, ctrl_size, rng)
        if len(controls) == 0:
            continue
        columns[key] = log_cpm[:, genes].mean(axis=1) - log_cpm[:, controls].mean(axis=1)
        n_controls[key] = int(len(controls))
    scores = pd.DataFrame(columns)
    if len(scores.columns):
        scores.columns = pd.MultiIndex.from_tuples(list(scores.columns),
                                                   names=['source', 'catalog', 'module'])
    return scores, n_controls


def correlate_methods(frame_a: pd.DataFrame, frame_b: pd.DataFrame) -> Dict[str, Any]:
    """Pearson / Spearman correlation of A and B effect estimates and t statistics across shared modules."""
    shared = frame_a.index.intersection(frame_b.index)
    record: Dict[str, Any] = {'n_modules_shared': int(len(shared))}
    if len(shared) < 4:
        return record
    for name in ('estimate', 'std_effect', 't'):
        a_values = frame_a.loc[shared, name].to_numpy(dtype=float)
        b_values = frame_b.loc[shared, name].to_numpy(dtype=float)
        ok = np.isfinite(a_values) & np.isfinite(b_values)
        if ok.sum() >= 4 and a_values[ok].std() > 0 and b_values[ok].std() > 0:
            record[f'pearson_{name}'] = float(stats.pearsonr(a_values[ok], b_values[ok])[0])
            record[f'spearman_{name}'] = float(stats.spearmanr(a_values[ok], b_values[ok])[0])
    both = np.isfinite(frame_a.loc[shared, 'estimate']) & np.isfinite(frame_b.loc[shared, 'estimate'])
    if both.any():
        record['sign_agreement'] = float((np.sign(frame_a.loc[shared, 'estimate'][both])
                                          == np.sign(frame_b.loc[shared, 'estimate'][both])).mean())
    return record


