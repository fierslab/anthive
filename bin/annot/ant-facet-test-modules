def module_eligibility(entry: Any, md_yaml: Dict[str, Any], annotation: Dict[str, Any],
                       api_config: Dict[str, Any]) -> Tuple[bool, str]:
    eligible, reason = aft.dataset_eligibility(entry, md_yaml, annotation, api_config,
                                               require_counts=False)
    if not eligible:
        return False, reason
    if not scores_path(entry.duckdb_path).exists():
        return False, 'no scores sidecar'
    return True, 'ok'


def package_versions() -> Dict[str, str]:
    return {'python': platform.python_version(), 'numpy': np.__version__, 'scipy': scipy.__version__,
            'pandas': pd.__version__, 'duckdb': duckdb.__version__}


def process_dataset(entry: Any, store_root: Path, out_root: Path, facets: List[str],
                    registry: GenesetRegistry, sources: Sequence[str], n_permutations: int,
                    threads: int = 4, memory_limit_gb: int = 24, run_pseudobulk: bool = True,
                    keep_work: bool = False) -> Dict[str, Any]:
    """Run variants A and B over all strata and facets of one dataset; write parquet + manifest."""
    started = time.time()
    md_yaml, _ = aft.parse_md_file(entry.md_path)
    api_config = aft.get_api_config(md_yaml)
    annotation = aft.mus.resolve_annotation(entry.h5ad_path, root=store_root)
    manifest: Dict[str, Any] = {
        'tool': TOOL_VERSION, 'db_id': entry.db_id, 'group': entry.study, 'file': entry.stem,
        'dataset_sha256': md_yaml.get('sha256'), 'md_path': str(entry.md_path),
        'anthive4_git': aft.git_head(script_dir.parent.parent),
        'h5adstore_git': aft.git_head(store_root),
        'genesetstore_git': aft.git_head(registry.root),
        'timestamp_utc': dt.datetime.now(dt.timezone.utc).isoformat(timespec='seconds'),
        'seed': SEED, 'facets_requested': facets, 'sources': list(sources),
        'versions': package_versions(),
        'parameters': {
            'n_permutations': n_permutations, 'permutation': 'facet labels shuffled across donors, '
            'covariates fixed, statistic = t of the full model, two-sided, p = (1+k)/(1+B)',
            'unit_seed': 'numpy default_rng([base seed, crc32 of "dataset|stratum|facet"])',
            'bh_family': '(dataset, stratum, facet, method) over modules, parametric and permutation separately',
            'n_bins': N_BINS, 'ctrl_size': CTRL_SIZE, 'min_module_genes': MIN_MODULE_GENES,
            'pseudobulk_expression': 'log2(CPM + 1), library size = all-gene count sum',
            'control_seed': 'default_rng([base seed, crc32 of "stratum|source|catalog|module"])',
            'min_score_coverage': MIN_SCORE_COVERAGE,
            'min_cells_per_sample': aft.MIN_CELLS_PER_SAMPLE, 'min_donors_dataset': aft.MIN_DONORS_DATASET,
            'min_donors_per_level': aft.MIN_DONORS_PER_LEVEL, 'n_lt5_threshold': aft.N_LT5_THRESHOLD,
            'numeric_min_donors_for_p': aft.NUMERIC_MIN_DONORS_FOR_P,
            'min_donors_for_age_pmi': aft.MIN_DONORS_FOR_AGE_PMI,
            'min_covariate_coverage': aft.MIN_COVARIATE_COVERAGE, 'disease_provisional': True,
            'duckdb_threads': threads, 'duckdb_memory_limit_gb': memory_limit_gb,
        },
    }
    eligible, reason = module_eligibility(entry, md_yaml, annotation, api_config)
    if not eligible:
        manifest.update(status='skipped', reason=reason)
        return manifest
    sidecar = scores_path(entry.duckdb_path)
    counts_info = aft.counts_layer_for(entry, md_yaml)
    no_counts = counts_info is None or not run_pseudobulk
    manifest['no_counts'] = counts_info is None
    manifest['counts_layer'] = counts_info[0] if counts_info else None

    work_dir = Path(tempfile.mkdtemp(prefix='ant_facet_mod_', dir=os.environ.get('ANT_FACET_TMP')))
    conn = aft.open_dataset(entry, api_config, threads=threads, memory_limit_gb=memory_limit_gb,
                            temp_dir=work_dir)
    try:
        cat_columns = aft.view_columns(conn, 'obscat') if aft._has_view(conn, 'obscat') else {}
        wanted = ['ant_donor', 'ant_sex', 'ant_disease', 'ant_apoe', 'ant_apoe_carrier',
                  'ant_braak', 'ant_age', 'ant_pmi', 'ant_cell_type', 'ant_author_cell_type',
                  'ant_tissue', 'ant_region', 'ant_author_cluster']
        extra = [c for c in cat_columns if (aft.CELLTYPE_CANDIDATE_RE.match(c) or aft.BATCH_NAME_RE.search(c))
                 and not c.startswith('ant_')]
        cells = aft.cell_table(conn, wanted + extra)
        if 'ant_donor' not in cells:
            manifest.update(status='skipped', reason='no ant_donor facet in the current mapping')
            return manifest
        batch_column = aft.find_batch_column(conn, cells)
        if batch_column is not None:
            cells['batch'] = cells[batch_column]
        manifest['batch_column'] = batch_column
        n_donors_all = int(cells['ant_donor'].dropna().astype(str).nunique())
        manifest['n_cells'] = int(len(cells))
        manifest['n_donors'] = n_donors_all
        if n_donors_all < aft.MIN_DONORS_DATASET:
            manifest.update(status='skipped', reason=f'{n_donors_all} donors (< {aft.MIN_DONORS_DATASET})')
            return manifest

        donor_table, conflicts = aft.build_donor_table(cells)
        manifest['donor_conflicts'] = conflicts
        membership, strata_note = aft.choose_strata(cells, cat_columns)
        manifest['celltype_note'] = strata_note
        manifest['celltype_sources'] = sorted(membership['source'].unique().tolist())
        cell_frame = cells.assign(pos=np.arange(len(cells)))[['pos', 'cell_id', 'ant_donor']]
        usable = membership.merge(cell_frame, on='pos', how='inner')
        usable = usable[usable['ant_donor'].notna()].copy()
        usable['donor'] = usable['ant_donor'].astype(str)
        usable['stratum'] = usable['source'] + '::' + usable['label']

        sample_sizes = usable.groupby(['stratum', 'source', 'label', 'donor']).size() \
            .rename('n_cells').reset_index()
        n_groups = int(len(sample_sizes))
        n_dropped_small = int((sample_sizes['n_cells'] < aft.MIN_CELLS_PER_SAMPLE).sum())
        sample_sizes = sample_sizes[sample_sizes['n_cells'] >= aft.MIN_CELLS_PER_SAMPLE] \
            .reset_index(drop=True)
        manifest['samples'] = {'n_donor_celltype_groups': n_groups,
                               'n_dropped_lt_min_cells': n_dropped_small, 'n_kept': int(len(sample_sizes))}
        donor_totals = cells[cells['ant_donor'].notna()].assign(
            donor=lambda f: f['ant_donor'].astype(str)).groupby('donor').size()

        jobs: List[Dict[str, Any]] = []
        for stratum, frame in sample_sizes.groupby('stratum'):
            for facet in facets:
                plan = aft.plan_job(donor_table, facet, frame['donor'])
                plan.update(stratum=str(stratum), source=str(frame['source'].iloc[0]),
                            label=str(frame['label'].iloc[0]))
                jobs.append(plan)
        needed = {(job['stratum'], donor) for job in jobs if job['status'] == 'ok'
                  for donor in job['design']['donor']}
        keep = sample_sizes[[(s, d) in needed for s, d in zip(sample_sizes['stratum'], sample_sizes['donor'])]] \
            .reset_index(drop=True)
        keep['sample_idx'] = np.arange(len(keep))
        manifest['strata'] = {str(k): int(v) for k, v in keep.groupby('stratum')['donor'].nunique().items()}
        sample_key = {(r.stratum, r.donor): int(r.sample_idx) for r in keep.itertuples()}
        sample_n_cells = keep.set_index('sample_idx')['n_cells']

        modules = sidecar_modules(sidecar, sources)
        catalog_report: Dict[str, Dict[str, int]] = {}
        symbols = aft.gene_symbols(conn)
        module_genes, gene_counts = load_module_genes(registry, modules, symbols)
        for source, catalog, module in modules.itertuples(index=False):
            entry_report = catalog_report.setdefault(f'{source}::{catalog}', {
                'n_modules_sidecar': 0, 'n_modules_with_gene_list_ge3': 0})
            entry_report['n_modules_sidecar'] += 1
            entry_report['n_modules_with_gene_list_ge3'] += int((source, catalog, module) in module_genes)
        manifest['catalogs'] = catalog_report

        # ---- variant A: donor means of the per-cell scores
        pb_cells = usable.merge(keep[['stratum', 'donor', 'sample_idx']], on=['stratum', 'donor'], how='inner')
        mean_scores = coverage = pd.DataFrame()
        if len(keep):
            mean_scores, coverage = cell_mean_scores(conn, sidecar, pb_cells[['cell_id', 'sample_idx']],
                                                     sample_n_cells, sources)

        # ---- variant B: pseudobulk log-CPM scores per stratum
        background_scores: Dict[str, pd.DataFrame] = {}
        control_counts: Dict[str, Dict[ModuleKey, int]] = {}
        pb_error = None
        if not no_counts and len(keep) and module_genes:
            try:
                long_counts = aft.pseudobulk(conn, counts_info[1], pb_cells[['cell_id', 'sample_idx']])
                gene_order = symbols['gene_id'].to_numpy()
                position_of_gene = pd.Series(np.arange(len(gene_order)), index=gene_order)
                long_counts = long_counts.assign(gene_id=position_of_gene.reindex(long_counts['gene_id']).to_numpy())
                long_counts = long_counts[long_counts['gene_id'].notna()].astype({'gene_id': int})
                for stratum, frame in keep.groupby('stratum'):
                    ids = frame['sample_idx'].to_numpy()
                    log_cpm = counts_to_log_cpm(pseudobulk_dense(long_counts, ids, len(gene_order)))
                    scores_b, n_ctrl = background_matched_scores(log_cpm, module_genes, str(stratum))
                    scores_b.index = ids
                    background_scores[str(stratum)] = scores_b
                    control_counts[str(stratum)] = n_ctrl
                    del log_cpm
            except Exception as exc:  # keep variant A
                pb_error = f'{type(exc).__name__}: {exc}'
                background_scores = {}
        manifest['pseudobulk_error'] = pb_error

        frames: List[pd.DataFrame] = []
        unit_records: List[Dict[str, Any]] = []
        for job in jobs:
            record: Dict[str, Any] = {'facet': job['facet'], 'cell_type': job['label'],
                                      'celltype_source': job['source'], 'status': job['status'],
                                      'n_donors_with_sample': job['n_donors_with_sample'],
                                      'level_counts': job.get('level_counts')}
            if job['status'] != 'ok':
                unit_records.append(record)
                continue
            design = job['design'].reset_index(drop=True)
            sample_ids = [sample_key[(job['stratum'], donor)] for donor in design['donor']]
            stratum_cells = sample_n_cells.reindex(sample_ids).to_numpy()
            proportions = pd.Series(stratum_cells / donor_totals.reindex(design['donor']).to_numpy(),
                                    index=design['donor'])
            composition_p = aft.composition_test(proportions, design.set_index('donor'), job['facet'])
            unit_key = (entry.db_id, job['stratum'], job['facet'])
            record.update(
                n_lt5=bool(job['n_lt5']), batch_used=job['batch_used'], batch_confounded=job['batch_confounded'],
                covariates=job['covariates'], covariates_omitted=job['covariates_omitted'],
                n_donors_analysed=job['n_donors_analysed'],
                n_donors_dropped_covariate=job['n_donors_dropped_covariate'],
                composition_p=composition_p,
                composition_flag=bool(composition_p is not None and composition_p < aft.COMPOSITION_ALPHA),
                n_cells_in_stratum=int(stratum_cells.sum()),
                n_distinct_label_permutations=n_distinct_label_permutations(design['facet_value'].to_numpy()))
            per_method: Dict[str, pd.DataFrame] = {}
            # variant A
            if len(mean_scores):
                a_values = mean_scores.reindex(sample_ids)
                low_cov = coverage.reindex(sample_ids).min(axis=0)
                try:
                    a_frame = fit_modules(a_values.reset_index(drop=True), design, job['batch_used'],
                                           bool(job['n_lt5']), unit_key, n_permutations)
                    a_frame['min_score_coverage'] = low_cov.reindex(a_frame.index).to_numpy()
                    per_method[METHOD_A] = a_frame
                except ValueError as exc:
                    record['method_A_error'] = str(exc)
            # variant B
            scores_b = background_scores.get(job['stratum'])
            if scores_b is not None and len(scores_b.columns):
                try:
                    b_frame = fit_modules(scores_b.reindex(sample_ids).reset_index(drop=True), design,
                                           job['batch_used'], bool(job['n_lt5']), unit_key, n_permutations)
                    b_frame['n_control_genes'] = [control_counts[job['stratum']].get(tuple(k)) for k in b_frame.index]
                    per_method[METHOD_B] = b_frame
                except ValueError as exc:
                    record['method_B_error'] = str(exc)
            for method, frame in per_method.items():
                n_sig_param = int((frame['q_param'] < Q_THRESHOLD).sum())
                n_sig_perm = int((frame['q_perm'] < Q_THRESHOLD).sum())
                record[f'n_modules_{method}'] = int(len(frame))
                record[f'n_sig_q05_param_{method}'] = n_sig_param
                record[f'n_sig_q05_perm_{method}'] = n_sig_perm
            if METHOD_A in per_method and METHOD_B in per_method:
                record['calibration'] = correlate_methods(per_method[METHOD_A], per_method[METHOD_B])
            unit_records.append(record)
            for method, frame in per_method.items():
                frame = frame.copy()
                index = pd.MultiIndex.from_tuples(frame.index, names=['source', 'catalog', 'module'])
                frame.index = index
                frame = frame.reset_index()
                frame['method'] = method
                frame['facet'] = job['facet']
                frame['cell_type'] = job['label']
                frame['celltype_source'] = job['source']
                level_counts = job['level_counts']
                if job['facet'] == 'braak':
                    frame['contrast'] = 'braak_per_unit'
                    frame['level_ref'] = None
                    frame['level_test'] = None
                    frame['n_donors_ref'] = np.nan
                    frame['n_donors_test'] = np.nan
                else:
                    reference, tested = aft.CONTRAST[job['facet']]
                    frame['contrast'] = f'{tested}_vs_{reference}'
                    frame['level_ref'], frame['level_test'] = reference, tested
                    frame['n_donors_ref'] = level_counts[reference]
                    frame['n_donors_test'] = level_counts[tested]
                frame['n_donors'] = job['n_donors_analysed']
                frame['n_lt5'] = bool(job['n_lt5'])
                frame['descriptive_only'] = bool(job['n_lt5'])
                frame['batch_used'] = job['batch_used']
                frame['batch_confounded'] = job['batch_confounded']
                frame['covariates'] = ','.join(job['covariates'])
                frame['composition_p'] = composition_p
                frame['composition_flag'] = record['composition_flag']
                frame['provisional'] = aft.PROVISIONAL_FLAGS.get(job['facet'], False)
                frames.append(frame)

        out_dir = out_root / entry.study
        out_dir.mkdir(parents=True, exist_ok=True)
        if frames:
            table = pd.concat(frames, ignore_index=True)
            if 'n_control_genes' not in table:
                table['n_control_genes'] = np.nan
            table['n_genes_requested'] = [gene_counts.get((s, c, m), {}).get('requested')
                                          for s, c, m in zip(table['source'], table['catalog'], table['module'])]
            table['n_genes_found'] = [gene_counts.get((s, c, m), {}).get('found')
                                      for s, c, m in zip(table['source'], table['catalog'], table['module'])]
            table['no_counts'] = bool(manifest['no_counts'])
            table['multi_tissue_donors'] = int((donor_table['n_tissues'] > 1).sum())
            table.insert(0, 'db_id', entry.db_id)
            table.insert(1, 'dataset', entry.stem)
            table.to_parquet(out_dir / f'{entry.stem}.facet_module_tests.parquet', index=False)
            manifest['n_result_rows'] = int(len(table))
            for method in (METHOD_A, METHOD_B):
                sub = table[table['method'] == method]
                manifest[f'n_modules_scored_{method}'] = int(sub[['source', 'catalog', 'module']]
                                                              .drop_duplicates().shape[0])
        manifest['units'] = unit_records
        manifest['multi_tissue_donors'] = int((donor_table['n_tissues'] > 1).sum())
        manifest.update(status='done', runtime_seconds=round(time.time() - started, 1))
        (out_dir / f'{entry.stem}.facet_module_run_manifest.json').write_text(
            json.dumps(manifest, indent=2, default=aft._json_default))
        return manifest
    finally:
        conn.close()
        if not keep_work:
            shutil.rmtree(work_dir, ignore_errors=True)


