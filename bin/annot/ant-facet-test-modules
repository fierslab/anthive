def _entries(store_root: Path) -> Dict[str, Any]:
    return {e.db_id: e for e in aft.iter_h5adstore(store_root) if not e.study.startswith('_')}


def cmd_inventory(args: argparse.Namespace) -> None:
    store_root = Path(args.h5adstore_root).resolve()
    rows = []
    for entry in _entries(store_root).values():
        md_yaml, _ = aft.parse_md_file(entry.md_path)
        api_config = aft.get_api_config(md_yaml)
        annotation = aft.mus.resolve_annotation(entry.h5ad_path, root=store_root)
        eligible, reason = module_eligibility(entry, md_yaml, annotation, api_config)
        rows.append({'db_id': entry.db_id, 'file': entry.stem, 'eligible_metadata': eligible, 'reason': reason,
                     'has_counts': aft.counts_layer_for(entry, md_yaml) is not None if eligible else None})
    frame = pd.DataFrame(rows)
    if args.out:
        frame.to_csv(args.out, sep='\t', index=False)
    print(frame['reason'].value_counts().to_string())
    print('eligible with counts:', int((frame['eligible_metadata'] & frame['has_counts'].fillna(False)).sum()))


def cmd_run(args: argparse.Namespace) -> None:
    store_root = Path(args.h5adstore_root).resolve()
    out_root = Path(args.out_root) if args.out_root else store_root / '_facet_tests'
    facets = [f.strip() for f in args.facets.split(',') if f.strip()]
    for facet in facets:
        if facet not in aft.FACETS:
            sys.exit(f'unknown facet {facet}; choose from {aft.FACETS}')
    if args.null_control_seed is not None and not args.out_root:
        sys.exit('--null-control-seed needs an explicit --out-root (never the real _facet_tests)')
    if (args.exclude_donors_from or args.exclude_donors_where) and not args.out_root:
        sys.exit('--exclude-donors-from / --exclude-donors-where need an explicit --out-root '
                 '(the counted run takes its exclusions from the .md facet_donor_exclusions rule)')
    if args.all_donors and (args.exclude_donors_from or args.exclude_donors_where):
        sys.exit('--all-donors cannot be combined with command line exclusions')
    sources = [s.strip() for s in args.sources.split(',') if s.strip()]
    registry = GenesetRegistry(Path(args.geneset_store) if args.geneset_store else default_geneset_store())
    registry.scan()
    entries = _entries(store_root)
    targets = sorted(entries) if args.all else [t.strip() for t in args.db_id.split(',')]
    summary_rows = []
    for db_id in targets:
        entry = entries.get(db_id)
        if entry is None:
            print(f'unknown db_id {db_id}', file=sys.stderr)
            continue
        md_yaml, _ = aft.parse_md_file(entry.md_path)
        rule_in_md = aft.donor_exclusions.rule_from_md(md_yaml) is not None
        if args.all_donors and not rule_in_md:
            print(f'[skip] {db_id}: --all-donors needs a facet_donor_exclusions rule in the .md')
            continue
        out_manifest = (aft.donor_exclusions.result_dir(out_root, entry.study, rule_in_md, args.all_donors)
                        / f'{entry.stem}.facet_module_run_manifest.json')
        annotation = aft.mus.resolve_annotation(entry.h5ad_path, root=store_root)
        eligible, reason = module_eligibility(entry, md_yaml, annotation, aft.get_api_config(md_yaml))
        if not eligible:
            print(f'[skip] {db_id}: {reason}')
            summary_rows.append({'db_id': db_id, 'status': 'skipped', 'reason': reason})
            continue
        if args.samples_only:
            if not out_manifest.exists():
                print(f'[skip] {db_id}: no stored module results to backfill')
                continue
            if not args.force and (out_manifest.parent / f'{entry.stem}{MODULE_SAMPLES_SUFFIX}').exists():
                print(f'[skip existing samples] {db_id}')
                continue
        elif out_manifest.exists() and not args.force and args.all:
            previous = json.loads(out_manifest.read_text())
            now_has_counts = aft.counts_layer_for(entry, md_yaml) is not None
            mapping_current = previous.get('md_sha256') == aft.md_file_sha256(entry.md_path)
            if previous.get('status') == 'done' and mapping_current \
                    and not (previous.get('no_counts') and now_has_counts):
                print(f'[skip existing] {db_id}')
                continue
        if args.wait_for_convert:
            wait_for_conversions()
        aft.wait_for_load(args.max_load)
        begin = time.time()
        try:
            manifest = process_dataset(entry, store_root, out_root, facets, registry, sources,
                                       args.permutations, threads=args.threads,
                                       memory_limit_gb=args.memory_gb,
                                       run_pseudobulk=not args.no_pseudobulk, keep_work=args.keep_work,
                                       null_control_seed=args.null_control_seed,
                                       exclusion_from=args.exclude_donors_from,
                                       exclusion_where=args.exclude_donors_where, all_donors=args.all_donors,
                                       samples_only=args.samples_only)
        except Exception as exc:
            import traceback
            traceback.print_exc()
            print(f'[error] {db_id}: {exc}', file=sys.stderr)
            summary_rows.append({'db_id': db_id, 'status': 'error', 'reason': str(exc)[:300]})
            continue
        if manifest['status'] == 'skipped':
            print(f'[skip] {db_id}: {manifest["reason"]}')
        elif manifest['status'] == 'samples_only':
            print(f'[samples] {db_id}: {manifest["sample_sidecar_rows"]} sample rows, {time.time() - begin:.0f}s', flush=True)
        else:
            n_ok = sum(1 for u in manifest['units'] if u['status'] == 'ok')
            print(f'[done] {db_id}: {n_ok}/{len(manifest["units"])} units, {manifest.get("n_result_rows", 0)} rows, '
                  f'no_counts={manifest["no_counts"]}, {time.time() - begin:.0f}s', flush=True)
        summary_rows.append({'db_id': db_id, 'status': manifest['status'], 'reason': manifest.get('reason', '')})
    if summary_rows:
        print(pd.DataFrame(summary_rows)['status'].value_counts().to_string())


def convert_processes_running() -> List[int]:
    """PIDs whose argv has an element that is the ant-convert script (matched on argv, not on
    the whole command line, so a shell that merely mentions the name does not count)."""
    pids: List[int] = []
    for proc_dir in Path('/proc').iterdir():
        if not proc_dir.name.isdigit():
            continue
        try:
            argv = (proc_dir / 'cmdline').read_bytes().split(b'\0')
        except OSError:
            continue
        if any(arg.endswith(b'bin/ingest/ant-convert') for arg in argv):
            pids.append(int(proc_dir.name))
    return pids


def wait_for_conversions(poll_seconds: int = 120) -> None:
    """Block while an ant-convert process runs (re-converted datasets must not be read mid-write)."""
    while convert_processes_running():
        print(f'  ant-convert running, sleeping {poll_seconds}s', file=sys.stderr, flush=True)
        time.sleep(poll_seconds)


def cmd_summarize(args: argparse.Namespace) -> None:
    store_root = Path(args.h5adstore_root).resolve()
    out_root = Path(args.out_root) if args.out_root else store_root / '_facet_tests'
    cohort = Path(args.cohort_table) if args.cohort_table else out_root / 'cohort_selection.DRAFT.tsv'
    summarize_results(out_root, Path(args.out_dir), cohort, min_std_effect=args.min_std_effect)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__.split('\n')[0])
    sub = parser.add_subparsers(dest='command', required=True)
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument('--h5adstore-root', default=None)
    common.add_argument('--out-root', default=None, help='default <h5adstore>/_facet_tests')
    inventory = sub.add_parser('inventory', parents=[common], help='eligibility table')
    inventory.add_argument('--out', default=None)
    run = sub.add_parser('run', parents=[common], help='run module facet tests')
    group = run.add_mutually_exclusive_group(required=True)
    group.add_argument('--db-id', help='comma-separated db_ids (e.g. G24/MMG)')
    group.add_argument('--all', action='store_true')
    run.add_argument('--facets', default=','.join(f for f in aft.FACETS if f not in aft.SENSITIVITY_FACETS))
    run.add_argument('--sources', default=','.join(DEFAULT_SOURCES),
                     help='sidecar sources to test (geneset = scanpy score_genes, ucell = UCell); one BH family per source')
    run.add_argument('--geneset-store', default=None)
    run.add_argument('--permutations', type=int, default=N_PERMUTATIONS)
    run.add_argument('--threads', type=int, default=4)
    run.add_argument('--memory-gb', type=int, default=24)
    run.add_argument('--max-load', type=float, default=12.0)
    run.add_argument('--force', action='store_true')
    run.add_argument('--no-pseudobulk', action='store_true', help='variant A only')
    run.add_argument('--samples-only', action='store_true',
                     help='write only the replicate score sidecars next to the stored results (no tests, no manifest); '
                          'refuses when the stored results do not match. Backfills the donor value plots of modules')
    run.add_argument('--keep-work', action='store_true')
    aft.donor_exclusions.add_cli_arguments(run)
    run.add_argument('--wait-for-convert', action='store_true',
                     help='before each dataset, wait until no bin/ingest/ant-convert process is running')
    run.add_argument('--null-control-seed', type=int, default=None,
                     help='negative control: shuffle facet labels across donors before testing; '
                          'requires --out-root (refuses the default store output)')
    summarize = sub.add_parser('summarize', parents=[common], help='cross-dataset tables (exploratory)')
    summarize.add_argument('--out-dir', required=True)
    summarize.add_argument('--cohort-table', default=None)
    summarize.add_argument('--min-std-effect', type=float, default=EFFECT_GATE_STD,
                           help='effect-size gate on |std_effect| for a hit (default 0.2)')
    return parser


def main() -> None:
    args = build_parser().parse_args()
    if args.h5adstore_root is None:
        args.h5adstore_root = str(aft.default_store_root())
    {'inventory': cmd_inventory, 'run': cmd_run, 'summarize': cmd_summarize}[args.command](args)


if __name__ == '__main__':
    main()
