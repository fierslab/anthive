def pseudobulk_quarters(conn: duckdb.DuckDBPyConnection, counts_parquet: Path, group_map: pd.DataFrame) -> None:
    """Create the TEMP table ``pb(group_id, gene_id, s, nnz)``: summed counts and detected cells per (group, gene)."""
    conn.register('group_map_df', group_map[['cell_id', 'group_id']])
    conn.execute('CREATE OR REPLACE TEMP TABLE group_map AS SELECT * FROM group_map_df')
    conn.unregister('group_map_df')
    quoted = str(counts_parquet).replace("'", "''")
    conn.execute('DROP TABLE IF EXISTS pb')
    conn.execute(f"CREATE TEMP TABLE pb AS SELECT m.group_id, p.gene_id, SUM(p.value) AS s, COUNT(*) AS nnz "
                 f"FROM read_parquet('{quoted}') p JOIN group_map m ON p.cell_id = m.cell_id "
                 f"GROUP BY m.group_id, p.gene_id")


def quarter_arrays(conn: duckdb.DuckDBPyConnection, n_replicates: int, min_total_per_replicate: float
                   ) -> Tuple[np.ndarray, np.ndarray, np.ndarray, np.ndarray]:
    """Read ``pb`` into arrays.

    Returns:
        ``(quarter_lib (n, 4), quarter_nnz (n, 4), candidate gene ids, quarter_counts (n, 4, candidates))`` where a
        candidate gene has at least ``min_total_per_replicate`` counts per replicate on average.
    """
    totals = conn.execute('SELECT group_id, SUM(s) AS total, SUM(nnz) AS nnz FROM pb GROUP BY group_id').fetchnumpy()
    quarter_lib = np.zeros(n_replicates * dv.N_QUARTERS)
    quarter_nnz = np.zeros(n_replicates * dv.N_QUARTERS)
    group = np.asarray(totals['group_id'])
    quarter_lib[group] = np.asarray(totals['total'])
    quarter_nnz[group] = np.asarray(totals['nnz'])
    threshold = float(min_total_per_replicate) * n_replicates
    candidates = np.asarray(conn.execute(
        'SELECT gene_id FROM pb GROUP BY gene_id HAVING SUM(s) >= ? ORDER BY gene_id', [threshold]).fetchnumpy()['gene_id'])
    position = pd.Series(np.arange(len(candidates)), index=candidates)
    quarter_counts = np.zeros((n_replicates * dv.N_QUARTERS, len(candidates)), dtype=np.float32)
    cursor = conn.execute('SELECT group_id, gene_id, s FROM pb WHERE gene_id IN '
                          '(SELECT gene_id FROM pb GROUP BY gene_id HAVING SUM(s) >= ?)', [threshold])
    while True:
        chunk = cursor.fetch_df_chunk(vectors_per_chunk=250)
        if len(chunk) == 0:
            break
        quarter_counts[chunk['group_id'].to_numpy(), position.reindex(chunk['gene_id']).to_numpy()] = \
            chunk['s'].to_numpy(dtype=np.float32)
    return (quarter_lib.reshape(n_replicates, dv.N_QUARTERS), quarter_nnz.reshape(n_replicates, dv.N_QUARTERS),
            candidates, quarter_counts.reshape(n_replicates, dv.N_QUARTERS, len(candidates)))


def panel_counts(conn: duckdb.DuckDBPyConnection, gene_ids: List[int], n_replicates: int) -> np.ndarray:
    """Counts of the given genes per replicate (quarters summed): (replicates, genes)."""
    out = np.zeros((n_replicates, len(gene_ids)))
    if not gene_ids:
        return out
    frame = conn.execute(f'SELECT group_id // {dv.N_QUARTERS} AS replicate, gene_id, SUM(s) AS s FROM pb '
                         f'WHERE gene_id IN ({",".join(str(int(g)) for g in gene_ids)}) GROUP BY 1, 2').df()
    column = pd.Series(np.arange(len(gene_ids)), index=gene_ids)
    out[frame['replicate'].to_numpy(), column.reindex(frame['gene_id']).to_numpy()] = frame['s'].to_numpy()
    return out


def cell_mean_quarters(conn: duckdb.DuckDBPyConnection, sidecar: Path, sources: Tuple[str, ...], n_replicates: int
                       ) -> Tuple[List[Tuple[str, str, str]], np.ndarray, np.ndarray]:
    """Sum and count of the per-cell module scores per (replicate, quarter) for the cells of ``group_map``.

    Returns:
        ``(keys, sums (n, 4, modules), counts (n, 4, modules))`` with keys ``(source, catalog, module)``.
    """
    quoted = str(sidecar).replace("'", "''")
    source_list = ','.join("'" + s.replace("'", "''") + "'" for s in sources)
    frame = conn.execute(
        f"SELECT m.group_id, s.source, s.catalog, s.module, SUM(s.score) AS total, COUNT(s.score) AS n "
        f"FROM read_parquet('{quoted}') s JOIN group_map m ON s.cell_id = m.cell_id WHERE s.source IN ({source_list}) "
        f"GROUP BY m.group_id, s.source, s.catalog, s.module").df()
    keys = sorted(set(zip(frame['source'], frame['catalog'], frame['module'])))
    index = {key: i for i, key in enumerate(keys)}
    sums = np.zeros((n_replicates * dv.N_QUARTERS, len(keys)))
    counts = np.zeros_like(sums)
    columns = np.array([index[key] for key in zip(frame['source'], frame['catalog'], frame['module'])], dtype=int)
    sums[frame['group_id'].to_numpy(), columns] = frame['total'].to_numpy()
    counts[frame['group_id'].to_numpy(), columns] = frame['n'].to_numpy()
    return (keys, sums.reshape(n_replicates, dv.N_QUARTERS, len(keys)),
            counts.reshape(n_replicates, dv.N_QUARTERS, len(keys)))


def gene_spans(symbols: pd.Series) -> np.ndarray:
    """Genomic span (bp) of each symbol from the GENCODE GTF of ``lib/gene_classes.py`` (NaN when unannotated or no GTF)."""
    path = gene_classes.gtf_path()
    if path is None:
        return np.full(len(symbols), np.nan)
    try:
        annotation = gene_classes._load(path)  # noqa: SLF001
    except OSError:
        return np.full(len(symbols), np.nan)
    return np.array([annotation.get(str(symbol).upper(), (None, np.nan))[1] for symbol in symbols], dtype=float)


