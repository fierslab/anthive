def result_stem(stem: str, min_cells: int) -> str:
    """Stem of the output files: the sensitivity runs (``--min-cells`` other than 40) carry a ``.minN`` marker."""
    return stem if min_cells == dv.MIN_CELLS_PER_REPLICATE else f'{stem}.min{min_cells}'


def unit_seed(*parts: Any, base: int = SEED) -> int:
    """Deterministic bootstrap seed of one unit from the run seed and a textual key."""
    return (base * 1_000_003 + zlib.crc32('|'.join(str(p) for p in parts).encode())) % (2 ** 63)


def long_gene_index(mean_expr: np.ndarray, spans: np.ndarray, n_each: int = LONG_GENE_N) -> Optional[np.ndarray]:
    """Mean log2 CPM of the ``n_each`` longest minus the ``n_each`` shortest genes, per replicate.

    Args:
        mean_expr: (replicates, genes) log2 CPM.
        spans: (genes,) genomic span in bp, NaN where unannotated.

    Returns:
        (replicates,) index (an RNA integrity proxy: nuclear long gene capture falls with degradation), or None when
        fewer than ``2 * n_each`` genes are annotated.
    """
    annotated = np.flatnonzero(np.isfinite(spans))
    if len(annotated) < 2 * n_each:
        return None
    order = annotated[np.argsort(spans[annotated])]
    return mean_expr[:, order[-n_each:]].mean(axis=1) - mean_expr[:, order[:n_each]].mean(axis=1)


def ambient_score(group_counts: np.ndarray, library: np.ndarray) -> np.ndarray:
    """Mean log2(CPM + 1) of the ambient marker genes per replicate (NaN when no panel gene exists).

    Args:
        group_counts: (replicates, panel genes) counts.
        library: (replicates,) total counts.
    """
    if group_counts.shape[1] == 0:
        return np.full(group_counts.shape[0], np.nan)
    return np.log2(group_counts / library[:, None] * 1e6 + 1.0).mean(axis=1)


def composition_matrix(cells: pd.DataFrame, donors: List[str], column: str) -> Optional[pd.DataFrame]:
    """Replicate x author cluster proportions of the cells of one stratum (None without 2 to 200 clusters)."""
    frame = cells[cells['donor'].isin(set(donors)) & cells[column].notna()]
    if frame.empty or not 2 <= frame[column].nunique() <= MAX_CLUSTERS:
        return None
    table = pd.crosstab(frame['donor'], frame[column]).reindex(donors).fillna(0.0)
    return table.div(table.sum(axis=1).replace(0, np.nan), axis=0).fillna(0.0)


def float32_frame(frame: pd.DataFrame) -> pd.DataFrame:
    """Float columns as float32 (the parquet files are large; the estimates carry about 6 digits of information)."""
    out = frame.copy()
    for column in out.columns:
        if out[column].dtype == np.float64:
            out[column] = out[column].astype(FLOAT_COLUMNS_DTYPE)
    return out


