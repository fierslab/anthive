# Command line
# --------------------------------------------------------------------------

def manifest_is_current(manifest_path: Path, md_path: Path) -> bool:
    """True when the manifest exists and was made from the current ``.md`` by this tool version."""
    try:
        recorded = json.loads(manifest_path.read_text())
    except (OSError, ValueError):
        return False
    return recorded.get('md_sha256') == aft.md_file_sha256(md_path) and recorded.get('tool') == TOOL_VERSION


def cmd_run(args: argparse.Namespace) -> None:
    """``run``: analyse the selected datasets."""
    store_root = Path(args.h5adstore_root).resolve()
    out_root = Path(args.out_root) if args.out_root else store_root / '_facet_tests'
    entries = {e.db_id: e for e in aft.iter_h5adstore(store_root) if not e.study.startswith('_')}
    targets = sorted(entries) if args.all else [t.strip() for t in (args.db_id or '').split(',') if t.strip()]
    if not targets:
        sys.exit('give --db-id or --all')
    registry = None
    if not args.no_modules:
        geneset_store = Path(args.genesetstore) if args.genesetstore else aftm.default_geneset_store()
        registry = GenesetRegistry(geneset_store)
        registry.scan()
        if registry.errors:
            print(f'genesetstore {geneset_store}: {len(registry.errors)} problem(s), first: {registry.errors[0]}', file=sys.stderr)
    summary = []
    for db_id in targets:
        entry = entries.get(db_id)
        if entry is None:
            print(f'unknown db_id {db_id}', file=sys.stderr)
            continue
        manifest_path = out_root / entry.study / f'{result_stem(entry.stem, args.min_cells)}{RESULT_SUFFIXES[2]}'
        if args.all and not args.force and manifest_is_current(manifest_path, entry.md_path):
            print(f'[skip existing] {db_id}')
            continue
        aft.wait_for_load(args.max_load)
        begin = time.time()
        try:
            manifest = process_dataset(entry, store_root, out_root, registry, seed=args.seed, n_boot=args.n_boot,
                                       min_cells=args.min_cells, run_modules=not args.no_modules,
                                       threads=args.threads, memory_limit_gb=args.memory_gb, keep_work=args.keep_work)
        except Exception as exc:  # noqa: BLE001
            print(f'[error] {db_id}: {type(exc).__name__}: {exc}', file=sys.stderr)
            summary.append({'db_id': db_id, 'status': 'error', 'reason': str(exc)[:300]})
            continue
        if manifest['status'] == 'skipped':
            print(f'[skip] {db_id}: {manifest["reason"]}')
        else:
            print(f'[done] {db_id}: {manifest["n_strata_analysed"]} strata, {manifest["n_gene_rows"]} gene rows, '
                  f'{manifest["n_module_rows"]} module rows, {time.time() - begin:.0f}s')
        summary.append({'db_id': db_id, 'status': manifest['status'], 'reason': manifest.get('reason', '')})
    if summary:
        print(pd.DataFrame(summary)['status'].value_counts().to_string())


def build_parser() -> argparse.ArgumentParser:
    """Command line parser."""
    parser = argparse.ArgumentParser(description=__doc__.split('\n')[0])
    sub = parser.add_subparsers(dest='command', required=True)
    run = sub.add_parser('run', help='estimate donor variability')
    run.add_argument('--h5adstore-root', default=None)
    group = run.add_mutually_exclusive_group()
    group.add_argument('--db-id', help='comma-separated db_ids (e.g. G24/MMG)')
    group.add_argument('--all', action='store_true')
    run.add_argument('--out-root', default=None, help='default <h5adstore>/_facet_tests')
    run.add_argument('--genesetstore', default=None)
    run.add_argument('--seed', type=int, default=SEED)
    run.add_argument('--n-boot', type=int, default=dv.N_BOOT, help='bootstrap replicates for the intervals (reduced for big units)')
    run.add_argument('--min-cells', type=int, default=dv.MIN_CELLS_PER_REPLICATE,
                     help='cells a replicate needs in a stratum (default 40; 20 is the sensitivity run, written with a .min20 marker)')
    run.add_argument('--no-modules', action='store_true')
    run.add_argument('--threads', type=int, default=4)
    run.add_argument('--memory-gb', type=int, default=24)
    run.add_argument('--max-load', type=float, default=12.0)
    run.add_argument('--force', action='store_true')
    run.add_argument('--keep-work', action='store_true')
    return parser


def main() -> None:
    """Entry point."""
    args = build_parser().parse_args()
    if args.h5adstore_root is None:
        args.h5adstore_root = str(aft.default_store_root())
    {'run': cmd_run}[args.command](args)


if __name__ == '__main__':
    main()
