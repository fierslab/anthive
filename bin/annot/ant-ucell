# Cells loaded and ranked per chunk (--chunk-cells). The sparse expression of a
# chunk is about 12 bytes per nonzero entry; ranking adds one dense batch of
# _RANK_BATCH cells (float32 values plus float64 ranks, near 500 MB at 30k genes).
_DEFAULT_CHUNK_CELLS = 50_000
_RANK_BATCH = 2000

# UCell rank cap. Any gene ranked below this cutoff contributes a constant
# (MAX_RANK + 1) instead of its raw rank, so the many tied zeros in sparse
# scRNA don't drag every cell to the same mean score. Matches R UCell.
_MAX_RANK = 1500

# Modules with fewer than this many genes present in the dataset are skipped.
# UCell on very small sets (< min_n) produces highly variable scores.
_DEFAULT_MIN_N = 5

# ── registry helpers ──────────────────────────────────────────────────────────

def _load_geneset_registry() -> GenesetRegistry:
    """Return a scanned, error-free geneset registry (or exit)."""
    config = get_config()
    store_value = config.get('geneset_store')
    if not store_value:
        sys.exit('ERROR: geneset_store not configured in anthive.yaml')
    store_path = (SCRIPT_DIR.parent.parent / store_value).resolve()
    if not store_path.exists():
        sys.exit(f'ERROR: geneset store does not exist: {store_path}')
    registry = GenesetRegistry(store_path)
    registry.scan()
    if registry.errors:
        for err in registry.errors:
            print(f'  store error: {err}', file=sys.stderr)
        sys.exit('ERROR: geneset store has errors — fix with `ant geneset validate`')
    return registry


def _h5adstore_root() -> Path:
    """Return the resolved h5adstore root (or exit)."""
    config = get_config()
    h5ad_root_value = config.get('h5ad_store') or str(__import__('config').get_data_folder(config))
    root = (SCRIPT_DIR.parent.parent / h5ad_root_value).resolve()
    if not root.exists():
        sys.exit(f'ERROR: h5ad store does not exist: {root}')
    return root


def _resolve_target(
    registry: GenesetRegistry, target: str
) -> List[Tuple[Experiment, List[Geneset]]]:
    """Resolve '<study>/<exp>' → all genesets, or '<study>/<exp>/<gs>' → one."""
    target = target.strip().strip('/')
    parts = target.split('/')

    if len(parts) == 2:
        experiment = registry.get_experiment(target)
        if experiment is None:
            sys.exit(f'ERROR: experiment {target!r} not found in geneset store')
        members = [
            g for g in registry.list_genesets()
            if g.experiment.experiment_id == target
        ]
        if not members:
            sys.exit(f'ERROR: experiment {target!r} contains no genesets')
        return [(experiment, members)]

    if len(parts) == 3:
        geneset = registry.get(target)
        if geneset is None:
            sys.exit(f'ERROR: geneset {target!r} not found in geneset store')
        return [(geneset.experiment, [geneset])]

    sys.exit(
        f"ERROR: target {target!r} must be '<study>/<experiment>' "
        f"or '<study>/<experiment>/<geneset>'"
    )


# ── expression source ─────────────────────────────────────────────────────────

class ExpressionSource:
    """Cell-chunked, sparse reader of one layer of a dataset's duckdb.

    Reads the by-cell layer sidecar (``<stem>.layer.<layer>.by_cell.parquet``,
    or the legacy in-duckdb layer table), so only the cells of the requested
    chunk are ever loaded; the h5ad is not touched.

    Attributes:
        n_genes: number of genes of the dataset (the UCell gene universe).
    """

    def __init__(self, duckdb_path: Path, layer: str = 'X') -> None:
        """Open ``duckdb_path`` read-only and resolve the layer source.

        Args:
            duckdb_path: path to the dataset's ``.duckdb``.
            layer: expression layer (log-normalised).
        """
        self._db = AnthiveDB(Path(duckdb_path))
        self._conn = self._db.connect()
        self._source = self._db._layer_source_for_gene_filter(layer, 'by_cell')
        self._gene_ids = np.sort(np.array(
            [row[0] for row in self._conn.execute('SELECT gene_id FROM __genes').fetchall()],
            dtype=np.int64))
        self.n_genes = len(self._gene_ids)

    def close(self) -> None:
        """Close the duckdb connection."""
        self._db.close()

    def resolve_genes(self, symbols: List[str]) -> Dict[str, int]:
        """Map gene symbols to matrix columns (Ensembl-indexed duckdbs resolve through ``__varcat``).

        Args:
            symbols: gene symbols.

        Returns:
            ``{symbol: column index}`` for the symbols present in the dataset.
        """
        unique = sorted(set(symbols))
        columns: Dict[str, int] = {}
        for start in range(0, len(unique), 2000):
            found, _route = self._db._resolve_symbols_to_gene_ids(unique[start:start + 2000])
            for symbol, gene_id in found.items():
                columns[symbol] = int(np.searchsorted(self._gene_ids, gene_id))
        return columns

    def read_cells(self, cell_ids: np.ndarray) -> csr_matrix:
        """Load the expression of some cells as a sparse (cells x genes) float32 matrix.

        Args:
            cell_ids: sorted, unique ``__cells.cell_id`` values.

        Returns:
            CSR matrix, row i = ``cell_ids[i]``, columns in ``gene_id`` order.
        """
        self._conn.register('_ucell_chunk_ids', pd.DataFrame({'cell_id': cell_ids}))
        try:
            data = self._conn.execute(
                f'SELECT cell_id, gene_id, value FROM {self._source} '
                f'WHERE cell_id BETWEEN ? AND ? AND cell_id IN (SELECT cell_id FROM _ucell_chunk_ids)',
                [int(cell_ids[0]), int(cell_ids[-1])],
            ).fetchnumpy()
        finally:
            self._conn.unregister('_ucell_chunk_ids')
        rows = np.searchsorted(cell_ids, np.asarray(data['cell_id'], dtype=np.int64))
        columns = np.searchsorted(self._gene_ids, np.asarray(data['gene_id'], dtype=np.int64))
        values = np.asarray(data['value'], dtype=np.float32)
        return csr_matrix((values, (rows, columns)), shape=(len(cell_ids), self.n_genes))


# ── UCell scoring core ────────────────────────────────────────────────────────

def _build_gene_sets_dict(
    genesets: List[Geneset],
    var_names: set,
    min_n: int,
) -> Tuple[Dict[str, List[str]], Dict[str, int], List[str]]:
    """Filter genesets to present genes; return (gene_sets_dict, counts, skipped).

    Args:
        genesets: list of Geneset objects from the geneset registry.
        var_names: set of gene names present in the dataset.
        min_n: minimum number of genes required for a module to be scored.

    Returns:
        gene_sets_dict: mapping module_name → list of present gene names.
        module_gene_counts: mapping module_name → count of present genes.
        skipped: list of module names that had too few genes.
    """
    gene_sets_dict: Dict[str, List[str]] = {}
    module_gene_counts: Dict[str, int] = {}
    skipped: List[str] = []
    for gs in genesets:
        present = [g for g in gs.genes if g in var_names]
        module_gene_counts[gs.name] = len(present)
        if len(present) < min_n:
            skipped.append(gs.name)
        else:
            gene_sets_dict[gs.name] = present
    return gene_sets_dict, module_gene_counts, skipped


def _ucell_dense(expr_dense: np.ndarray, module_indices: List[np.ndarray]) -> np.ndarray:
    """Compute UCell scores for dense expression, one score per cell and module.

    Implements the Mann-Whitney U statistic of Andreatta & Carmona 2021 with
    the R UCell ``maxRank`` cap. For each cell, genes are ranked by expression
    (rank 1 = highest, ties get the average rank); ranks beyond ``_MAX_RANK``
    count as ``_MAX_RANK + 1``. For a gene set S of size k:

        U     = sum(rank(g) for g in S) - k*(k+1)/2
        score = 1 - U / (k * _MAX_RANK)

    A cell's score depends on that cell only, so any partition of the cells
    gives the same result.

    Args:
        expr_dense: (n_cells, n_genes) float array.
        module_indices: per module, the column indices of its genes.

    Returns:
        (n_cells, n_modules) float64 array in the order of ``module_indices``.
    """
    # rankdata ranks ascending; negate values for descending ranks.
    ranks = rankdata(-expr_dense, method='average', axis=1).astype(np.float32)
    np.minimum(ranks, _MAX_RANK + 1, out=ranks)
    scores = np.empty((expr_dense.shape[0], len(module_indices)), dtype=np.float64)
    for module_position, gene_indices in enumerate(module_indices):
        gene_count = len(gene_indices)
        set_rank_sums = ranks[:, gene_indices].sum(axis=1, dtype=np.float64)
        u_statistic = set_rank_sums - gene_count * (gene_count + 1) / 2.0
        scores[:, module_position] = 1.0 - u_statistic / (float(gene_count) * _MAX_RANK)
    return scores


def _ucell_sparse(matrix: csr_matrix, module_indices: List[np.ndarray]) -> np.ndarray:
    """UCell scores of a sparse chunk, densified and ranked one batch at a time.

    Args:
        matrix: (cells, genes) sparse expression.
        module_indices: per module, the column indices of its genes.

    Returns:
        (cells, modules) float64 scores.
    """
    scores = np.empty((matrix.shape[0], len(module_indices)), dtype=np.float64)
    # A batch of 2000 cells x 30k genes keeps the float64 rank matrix near 500 MB.
    for start in range(0, matrix.shape[0], _RANK_BATCH):
        end = min(start + _RANK_BATCH, matrix.shape[0])
        scores[start:end] = _ucell_dense(matrix[start:end].toarray(), module_indices)
    return scores


def _run_ucell(
    source: ExpressionSource,
    cell_ids: np.ndarray,
    module_indices: List[np.ndarray],
    chunk_cells: int,
) -> Iterator[Tuple[np.ndarray, np.ndarray]]:
    """Score ``cell_ids`` in chunks of at most ``chunk_cells`` cells.

    Peak memory is proportional to the chunk (its sparse expression plus one
    rank batch), not to the number of cells of the scope.

    Args:
        source: expression reader.
        cell_ids: ``__cells.cell_id`` of the cells to score.
        module_indices: per module, the column indices of its genes.
        chunk_cells: cells loaded and ranked per chunk.

    Yields:
        ``(chunk cell_ids, scores)`` with scores of shape (chunk cells, modules).
    """
    ordered_ids = np.unique(np.asarray(cell_ids, dtype=np.int64))
    for start in range(0, len(ordered_ids), chunk_cells):
        chunk_ids = ordered_ids[start:start + chunk_cells]
        print(f'    cells {start:,}-{start + len(chunk_ids):,} of {len(ordered_ids):,}', flush=True)
        yield chunk_ids, _ucell_sparse(source.read_cells(chunk_ids), module_indices)


def _long_scores(blocks: List[Tuple[np.ndarray, np.ndarray, List[str]]]) -> pd.DataFrame:
    """Turn accumulated score blocks into one long (cell_id, module, score) frame.

    Args:
        blocks: ``(cell_ids, scores (cells x modules), module names)`` triples.

    Returns:
        Long DataFrame with columns cell_id, module, score.
    """
    parts = []
    for cell_ids, scores, module_names in blocks:
        n_cells, n_modules = scores.shape
        parts.append(pd.DataFrame({
            'cell_id': np.tile(cell_ids, n_modules),
            'module': np.repeat(np.array(module_names, dtype=object), n_cells),
            'score': scores.ravel(order='F'),
        }))
    return pd.concat(parts, ignore_index=True)


def _ucell_experiments(
    source: ExpressionSource,
    experiments: List[Tuple[Experiment, List[Geneset]]],
    entry: H5adEntry,
    min_n: int,
    verbose: bool,
    dry_run: bool,
    cells: pd.DataFrame,
    chunk_cells: int = _DEFAULT_CHUNK_CELLS,
) -> List[Dict]:
    """Score several experiments with UCell and write one sidecar catalog each.

    The expensive step is ranking the genes of every cell, so the modules of
    all experiments that share a cell type scope are scored together: the cells
    of the scope are ranked once, however many catalogs apply. The cells are
    processed in chunks of ``chunk_cells``; each catalog is written once, after
    all chunks are done.

    Args:
        source: expression reader of the dataset.
        experiments: (Experiment, its Geneset list) pairs.
        entry: H5adEntry for the target dataset (carries duckdb_path etc.).
        min_n: minimum gene overlap required to score a module.
        verbose: if True, print per-module stats.
        dry_run: if True, score but do not write to disk.
        cells: per-cell frame (cell_id, cell_name, group) from
            ``celltype_scope.cell_type_groups``; a module is scored on the cells
            of its cell type scope only.
        chunk_cells: cells ranked per chunk.

    Returns:
        One result dict per experiment with keys ``catalog``, ``status`` (``ok``,
        ``dry-run``, ``error``), ``n_rows``, and (on error) ``error``.
    """
    results: Dict[str, Dict] = {}
    gene_columns = source.resolve_genes([gene for _exp, genesets in experiments
                                         for geneset in genesets for gene in geneset.genes])
    var_names = set(gene_columns)
    # unit key -> (experiment id, module name, gene columns, scope)
    units: Dict[str, Tuple[str, str, np.ndarray, Any]] = {}
    for experiment, genesets in experiments:
        catalog_id = experiment.experiment_id
        print(f'\n  Experiment: {catalog_id}')
        gene_sets_dict, _counts, skipped_modules = _build_gene_sets_dict(genesets, var_names, min_n)
        n_pairs = sum(len(genes) for genes in gene_sets_dict.values())
        print(f'  Network: {len(genesets)} modules ({len(gene_sets_dict)} scoreable), '
              f'{n_pairs:,} (module, gene) pairs')
        if skipped_modules:
            print(f'  WARNING: {len(skipped_modules)} modules have <{min_n} genes in '
                  f'the dataset and will be absent from UCell output: {skipped_modules}', file=sys.stderr)
        if not gene_sets_dict:
            results[catalog_id] = {'catalog': catalog_id, 'status': 'error', 'n_rows': 0,
                                   'error': f'no scoreable modules (all below min_n={min_n})'}
            continue
        for geneset in genesets:
            if geneset.name in gene_sets_dict:
                columns = np.array([gene_columns[gene] for gene in gene_sets_dict[geneset.name]], dtype=np.intp)
                units[f'u{len(units)}'] = (catalog_id, geneset.name, columns, module_scope(geneset))

    t_score = time.time()
    by_scope: Dict[tuple, List[str]] = {}
    for unit_key, (_cat, _mod, _columns, scope) in units.items():
        by_scope.setdefault(scope.key(), []).append(unit_key)
    # catalog -> score blocks (cell ids, scores, module names), one per chunk and scope
    blocks: Dict[str, List[Tuple[np.ndarray, np.ndarray, List[str]]]] = {}
    failed: Dict[str, str] = {}
    for unit_keys in by_scope.values():
        scope = units[unit_keys[0]][3]
        scoped_cells = cells[scope.cell_mask(cells['group']).to_numpy()]
        label = 'all cells' if scope.groups is None else f'groups {sorted(scope.groups)}'
        if scoped_cells.empty:
            print(f'  - {len(unit_keys)} module(s) ({"/".join(scope.celltypes)}): no cell of that '
                  f'cell type group, not scored')
            continue
        print(f'  scope {label}: {len(scoped_cells):,} cells, {len(unit_keys)} module(s) of '
              f'{len({units[k][0] for k in unit_keys})} catalog(s)')
        positions_of: Dict[str, List[int]] = {}
        for position, key in enumerate(unit_keys):
            positions_of.setdefault(units[key][0], []).append(position)
        scope_blocks: Dict[str, List[Tuple[np.ndarray, np.ndarray, List[str]]]] = {c: [] for c in positions_of}
        try:
            for chunk_ids, chunk_scores in _run_ucell(
                    source, scoped_cells['cell_id'].to_numpy(), [units[k][2] for k in unit_keys], chunk_cells):
                for catalog_id, positions in positions_of.items():
                    scope_blocks[catalog_id].append(
                        (chunk_ids, chunk_scores[:, positions], [units[unit_keys[p]][1] for p in positions]))
        except Exception as exc:
            message = str(exc).strip() or repr(exc)
            error = f'{type(exc).__name__}: {message}'
            print(f'  ERROR: UCell scoring failed: {error}', file=sys.stderr)
            for key in unit_keys:
                failed[units[key][0]] = error
            continue
        for catalog_id, catalog_blocks in scope_blocks.items():
            blocks.setdefault(catalog_id, []).extend(catalog_blocks)
    print(f'  UCell finished in {time.time() - t_score:.1f}s')

    for experiment, _genesets in experiments:
        catalog_id = experiment.experiment_id
        if catalog_id in results:
            continue
        if catalog_id in failed:
            results[catalog_id] = {'catalog': catalog_id, 'status': 'error', 'error': failed[catalog_id],
                                   'n_rows': 0}
            continue
        if catalog_id not in blocks:
            if not dry_run:
                removed = delete_scores(entry.duckdb_path, 'ucell', catalog_id)
                if removed:
                    print(f'  removed {removed} stale rows of source=ucell catalog={catalog_id}')
            results[catalog_id] = {'catalog': catalog_id, 'status': 'error', 'n_rows': 0,
                                   'error': 'no cell of the dataset belongs to the cell type scope of the catalog'}
            continue
        long_df = _long_scores(blocks.pop(catalog_id))
        if verbose:
            for module, values in long_df.groupby('module')['score']:
                print(f'    {catalog_id}/{module}: n={len(values)}  '
                      f'range=[{values.min():.3f}, {values.max():.3f}]  mean={values.mean():.3f}')
        if dry_run:
            print(f'  (dry-run) would write {len(long_df):,} rows for {catalog_id}')
            results[catalog_id] = {'catalog': catalog_id, 'status': 'dry-run', 'n_rows': len(long_df)}
            continue
        n_written = upsert_scores(duckdb_path=entry.duckdb_path, source='ucell', catalog=catalog_id, rows=long_df)
        print(f'  Wrote {n_written:,} rows → source=ucell catalog={catalog_id}')
        results[catalog_id] = {'catalog': catalog_id, 'status': 'ok', 'n_rows': n_written}
    return [results[experiment.experiment_id] for experiment, _ in experiments]


# ── main ──────────────────────────────────────────────────────────────────────

def main() -> int:
    """CLI entry point. Returns process exit code."""
    parser = argparse.ArgumentParser(
        description='UCell scoring (rank-based Mann-Whitney U) from the genesetstore.',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__,
    )
    parser.add_argument(
        'db_id',
        help='h5adstore dataset to score, e.g. M23/AST or Mathys2023/astrocytes',
    )
    parser.add_argument(
        'genesets', nargs='+',
        help='one or more experiment_id or geneset_id, e.g. Habib2020/DAA_states_human',
    )
    parser.add_argument('--min-n',       type=int,   default=_DEFAULT_MIN_N,
                        help='minimum gene overlap to score a module (default 5)')
    parser.add_argument('--layer', default=None,
                        help='expression layer (default: .md default_layer, else X)')
    parser.add_argument('--chunk-cells', type=int, default=_DEFAULT_CHUNK_CELLS,
                        help='cells loaded and ranked at a time; peak memory grows with '
                             f'the chunk, scores do not change (default {_DEFAULT_CHUNK_CELLS})')
    parser.add_argument('--overwrite',   action='store_true',
                        help='re-score even if (source=ucell, catalog=<experiment>) '
                             'already exists in the sidecar')
    parser.add_argument('--dry-run',     action='store_true',
                        help='score but do not write the sidecar')
    parser.add_argument('-v', '--verbose', action='store_true')
    args = parser.parse_args()

    registry = _load_geneset_registry()
    h5ad_root = _h5adstore_root()

    entry = find_h5ad(h5ad_root, args.db_id)
    if entry is None:
        sys.exit(f'ERROR: dataset {args.db_id!r} not found in h5adstore ({h5ad_root})')

    if not entry.duckdb_path.exists():
        sys.exit(
            f'ERROR: {entry.duckdb_path} not found. '
            f'Run `ant-convert {entry.h5ad_path}` first.'
        )

    # Collect (experiment, [genesets]) pairs, deduplicating across inputs.
    by_experiment: Dict[str, List[Geneset]] = {}
    experiments_by_id: Dict[str, Experiment] = {}
    seen_geneset_ids: set = set()
    for raw_id in args.genesets:
        for experiment, members in _resolve_target(registry, raw_id):
            experiments_by_id[experiment.experiment_id] = experiment
            for gs in members:
                if gs.geneset_id not in seen_geneset_ids:
                    seen_geneset_ids.add(gs.geneset_id)
                    by_experiment.setdefault(experiment.experiment_id, []).append(gs)

    if not by_experiment:
        sys.exit('ERROR: no genesets resolved')

    # Filter out already-scored (source=ucell, catalog=experiment) unless --overwrite.
    if not args.overwrite:
        existing = read_scores(entry.duckdb_path, source='ucell')
        already_done = set(existing['catalog'].unique()) if not existing.empty else set()
        for exp_id in list(by_experiment):
            if exp_id in already_done:
                print(
                    f'  SKIP {exp_id}: already scored with source=ucell '
                    f'(use --overwrite to redo)'
                )
                del by_experiment[exp_id]
        if not by_experiment:
            print('All requested experiments already scored. Nothing to do.')
            return 0

    n_total_modules = sum(len(gss) for gss in by_experiment.values())
    print(
        f'Plan: {entry.db_id} ({entry.readable_id}) ← '
        f'{len(by_experiment)} experiment(s), {n_total_modules} module(s)'
    )

    md_metadata, _ = parse_md_file(entry.md_path)
    has_lognorm = md_metadata.get('has_lognorm', True)
    if args.chunk_cells < 1:
        sys.exit('ERROR: --chunk-cells must be at least 1')
    if has_lognorm is False:
        sys.exit(
            f'ERROR: {entry.md_path.name} declares has_lognorm: false — '
            f'no log-normalised layer. UCell requires log-norm or raw '
            f'expression; cannot proceed.'
        )

    print(f'\n=== {entry.db_id} ({entry.readable_id}) ===')
    layer = args.layer or md_metadata.get('default_layer') or 'X'
    print(f'  duckdb: {entry.duckdb_path} (layer {layer!r}, chunks of {args.chunk_cells:,} cells)')
    source = ExpressionSource(entry.duckdb_path, layer)
    print(f'  {source.n_genes:,} genes')
    cells = cell_type_groups(entry, h5ad_root)
    print(f'  cell type groups: {group_summary(cells)}')

    try:
        all_results = _ucell_experiments(
            source=source,
            experiments=[(experiments_by_id[exp_id], genesets) for exp_id, genesets in by_experiment.items()],
            entry=entry, min_n=args.min_n, verbose=args.verbose, dry_run=args.dry_run, cells=cells,
            chunk_cells=args.chunk_cells,
        )
    finally:
        source.close()

    # Summary
    print(f'\n[summary for {entry.db_id}]')
    for res in all_results:
        status = res['status']
        catalog = res['catalog']
        n_rows = res['n_rows']
        if status == 'error':
            print(f'  ERROR  {catalog}: {res["error"]}')
        elif status == 'dry-run':
            print(f'  DRY    {catalog}: {n_rows:,} rows (not written)')
        else:
            print(f'  OK     {catalog}: {n_rows:,} rows written')

    # Exit code rules:
    #   0 = at least one experiment produced output (or pure dry-run).
    #   1 = all experiments in this invocation failed to score.
    n_ok = sum(1 for r in all_results if r['status'] in ('ok', 'dry-run'))
    n_errors = sum(1 for r in all_results if r['status'] == 'error')
    if n_ok:
        if n_errors:
            print(
                f'\nNOTE: {n_errors} of {len(all_results)} experiment(s) '
                f'failed; {n_ok} succeeded — treating overall run as PASS.',
                file=sys.stderr,
            )
        return 0
    return 1


if __name__ == '__main__':
    sys.exit(main())
