        ),
    ),
    window: int = Query(
        200, ge=2, le=50_000,
        description="Rolling-window size in cells along ``x`` (higher = smoother line).",
    ),
    step_size: int = Query(
        1, ge=1, le=50_000,
        description=(
            "Stride between plotted rolling-window centers (1 = one point per cell). "
            "Larger values subsample the plot (faster render, less visual clutter) AND "
            "feed into `show_ci_corrected`'s n_eff formula: "
            "`n_eff = min(window, actual_n) · step_size / window`. "
            "For a truly-independent-windows CI, set step_size == window."
