def _intro_md(title: str, caption: str) -> str:
    """Cell 1 markdown: title + caption + JupyterLite persistence disclaimer."""
    return (
        f"# {title}\n"
        f"\n"
        f"{caption}\n"
        f"\n"
        f"> **Disclaimer.** This notebook lives only in your browser "
        f"(JupyterLite saves to the local IndexedDB). To persist your "
