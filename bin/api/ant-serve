@app.post("/admin/gene-stats-index/rebuild", tags=["admin"])
def gene_stats_index_rebuild(
    only: Optional[str] = Query(None, description='Comma-separated db_ids to (re)compute; default: all'),
    top_n: int = Query(100, description='Per-dataset top-N variable genes for the hot set'),
    force: bool = Query(False, description='Ignore per-dataset cache; recompute everything'),
    workers: int = Query(4, description='Parallel workers for the precompute'),
):
    """Kick off a background rebuild of ``gene_stats_index.parquet``.

    Fires ``bin/annot/ant-gene-stats-precompute`` as a **subprocess** —
    returns immediately with the PID. The rebuild runs to completion on
    its own and writes to the standard output path; call ``/reload``
    once it's done to swap the in-memory index. Progress lines land in
    ``tmp/gene_stats_precompute.log``.
    """
    import subprocess

    script = script_dir.parent / 'annot' / 'ant-gene-stats-precompute'
    if not script.exists():
        raise HTTPException(status_code=500, detail=f'precompute tool missing: {script}')

    args = [
        str(script),
        '--h5adstore-root', str(registry.data_folder),
        '--workers', str(int(workers)),
        '--top-n', str(int(top_n)),
    ]
    if only:
        args += ['--only', only]
    if force:
        args += ['--force']

    log_path = get_log_dir() / 'gene_stats_precompute.log'
    log_path.parent.mkdir(parents=True, exist_ok=True)
    log_fh = log_path.open('ab', buffering=0)
    proc = subprocess.Popen(
        args, stdout=log_fh, stderr=subprocess.STDOUT,
        # Detach so the parent (uvicorn) can be restarted without SIGKILLing us.
        start_new_session=True,
    )
    return {
        'status':   'started',
        'pid':      proc.pid,
        'args':     args,
        'log_path': str(log_path),
    }


