def _json_safe(obj: Any) -> Any:
    """Recursively replace NaN/Inf floats with None so json.dumps never chokes."""
    if isinstance(obj, float) and not math.isfinite(obj):
        return None
    if isinstance(obj, dict):
        return {k: _json_safe(v) for k, v in obj.items()}
    if isinstance(obj, list):
        return [_json_safe(v) for v in obj]
    return obj


_SESSION_ID_PATTERN = r'^[0-9a-f]{32}$'


class AnalyticsQueryRequest(BaseModel):
    sql: str
    session_id: Optional[str] = Field(None, pattern=_SESSION_ID_PATTERN)
    # seconds; clamped server-side to ANTHIVE_QUERY_TIMEOUT (120)
    timeout: Optional[int] = Field(None, gt=0)
    # prior session IDs to attach as tables (e.g. module_score results)
    attach_sessions: Optional[List[Annotated[str, Field(pattern=_SESSION_ID_PATTERN)]]] = Field(
        None, max_length=8)


class AnalyticsVizRequest(BaseModel):
    session_id: str = Field(..., pattern=_SESSION_ID_PATTERN)
    code: str
    output_format: str = 'png'


@app.get("/databases/{db_id:path}/analytics/schema", tags=["analytics"])
async def analytics_schema(db_id: str):
    """Return the schema of all DuckDB tables in a dataset.

    Lists every table with its column names, types, row count, and a 3-row
    sample.  Use this to understand what fields are available before writing
    an analytics_query SQL statement.
    """
    try:
        db_url = registry.get_database_path(db_id)
    except KeyError:
        raise HTTPException(status_code=404, detail=f"Dataset '{db_id}' not found.")
    def _sync_schema():
        conn = connection_pool.get_connection(db_url)
        try:
            return analytics.get_schema(conn)
        finally:
            connection_pool.return_connection(db_url, conn)
    try:
        schema = await asyncio.to_thread(_sync_schema)
    except Exception as exc:
        raise HTTPException(status_code=500, detail=str(exc))
    return _json_safe({"db_id": db_id, "tables": schema})


@app.post("/databases/{db_id:path}/analytics/query", tags=["analytics"])
async def analytics_query(db_id: str, request: AnalyticsQueryRequest):
    """Execute a read-only SELECT query and persist results as a Parquet file.

    The full result set is saved server-side; only column metadata and a small
    preview (first 10 rows) are returned.  Use the returned session_id in a
    subsequent POST /analytics/viz call to visualise the data.

    To use results from a prior module_score call, pass its session_id in
    `attach_sessions`. The scores become available as a table called `scores`
    with columns (cell_name, module_score). Example:

        {"sql": "SELECT o.cell_type, AVG(s.module_score) FROM scores s JOIN obscat o USING (cell_name) GROUP BY 1",
         "attach_sessions": ["abc123..."]}

    Constraints:
    - Only SELECT / WITH … SELECT queries are accepted.
    - Result is capped at 500 000 rows (configurable via ANTHIVE_ANALYTICS_ROWS).
    - Query is killed after 120 s (configurable via ANTHIVE_QUERY_TIMEOUT).
    """
    try:
        db_url = registry.get_database_path(db_id)
    except KeyError:
        raise HTTPException(status_code=404, detail=f"Dataset '{db_id}' not found.")
    # analytics.run_query opens and closes its own dedicated connection so that
    # closing it on timeout actually cancels the in-flight DuckDB query.
    try:
        _mv_path = _module_variability_path()
        _extra_views = ({"module_variability": str(_mv_path)}
                        if _mv_path.exists() else None)
        result = await asyncio.to_thread(
            lambda: analytics.run_query(
                db_url, request.sql, request.session_id,
                s3_config=registry._s3_config,
                timeout=request.timeout,
                attach_sessions=request.attach_sessions,
                extra_parquet_views=_extra_views,
            )
        )
    except (ValueError, RuntimeError) as exc:
        raise HTTPException(status_code=400, detail=str(exc))
    except TimeoutError as exc:
        raise HTTPException(status_code=408, detail=str(exc))
    except Exception as exc:
        raise HTTPException(status_code=500, detail=str(exc))
    return _json_safe(result)


@app.post("/analytics/viz", tags=["analytics"])
async def analytics_viz(request: AnalyticsVizRequest, http_request: Request):
    """Execute a Python visualisation script and return the figure as base64.

    ADMINS ONLY (Authelia 'admins' group). The AST scan is not a sandbox:
    it can be bypassed, so running caller-supplied Python is restricted to
    admins. The subprocess gets no inherited environment.

    The script runs in a subprocess with a blocked-import AST scan and a
    wall-clock timeout.  Two variables are pre-injected:

      DATA_PATH   — path to the Parquet file saved by a prior analytics_query
      OUTPUT_PATH — path where the script MUST save its figure, e.g.:
                        plt.savefig(OUTPUT_PATH, bbox_inches='tight', dpi=150)

    The script may use: pandas, matplotlib, seaborn, numpy, scipy, sklearn,
    statsmodels, and other data-science packages.  Imports of os, sys,
    subprocess, socket, requests, and similar modules are blocked.
    Scripts are killed after 60 s (configurable via ANTHIVE_VIZ_TIMEOUT).
    """
    _require_admin(http_request)
    try:
        figure_b64, output_format = await asyncio.to_thread(
            analytics.run_viz,
            request.session_id, request.code, request.output_format,
        )
    except FileNotFoundError as exc:
        raise HTTPException(status_code=404, detail=str(exc))
    except (ValueError, RuntimeError) as exc:
        raise HTTPException(status_code=400, detail=str(exc))
    except TimeoutError as exc:
        raise HTTPException(status_code=408, detail=str(exc))
    except Exception as exc:
        raise HTTPException(status_code=500, detail=str(exc))
    mime_types = {'png': 'image/png', 'svg': 'image/svg+xml', 'pdf': 'application/pdf'}
    return {
        "session_id":    request.session_id,
        "output_format": output_format,
        "mime_type":     mime_types.get(output_format, 'image/png'),
        "figure_b64":    figure_b64,
    }


@app.post("/databases/{db_id:path}/module_score", tags=["analytics"])
async def module_score(db_id: str, request: ModuleScoreRequest):
    """Compute per-cell module scores (Scanpy score_genes / Seurat AddModuleScore equivalent).

    For each cell: score = mean(module genes) − mean(expression-matched control genes).
    Control genes are sampled from the same expression bins as the module genes
    using the precomputed __gene_bins table.

    Returns summary statistics and a session_id. The full per-cell scores are saved
    as a Parquet file that can be visualized via POST /analytics/viz or queried
    via POST /analytics/query using the session_id.

    Requires __gene_bins (built by ant-duckdb-check on databases with a log-normalized layer).
    """
    filters = _parse_subset(request.subset)

    def _sync_score():
        with _pooled_db(db_id) as db:
            scores_df, meta = db.score_module(
                module_genes=request.genes,
                layer=request.layer,
                n_control=request.n_control,
                seed=request.seed,
            )

            # Apply subset filters if any
            if filters:
                cat_fields = db._get_categorical_fields()
                num_fields = db._get_numerical_fields()
                filter_df = db.get_cell_table(metadata_fields=list(filters.keys()), filters=filters)
                keep_cells = set(filter_df['cell_name'])
                scores_df = scores_df[scores_df['cell_name'].isin(keep_cells)]

            return scores_df, meta

    try:
        scores_df, meta = await asyncio.to_thread(_sync_score)
    except KeyError as exc:
        raise HTTPException(status_code=404, detail=str(exc))
    except ValueError as exc:
        raise HTTPException(status_code=400, detail=str(exc))
    except Exception as exc:
        raise HTTPException(status_code=500, detail=str(exc))

    # Save to Parquet for downstream analytics_viz / analytics_query
    import uuid as _uuid
    session_id = _uuid.uuid4().hex
    parquet_path = analytics._get_tmp_dir() / f"{session_id}.parquet"
    scores_df.to_parquet(parquet_path, index=False)

    # Summary statistics
    s = scores_df['module_score']
    summary = {
        'mean':   round(float(s.mean()), 6),
        'std':    round(float(s.std()), 6),
        'min':    round(float(s.min()), 6),
        'q25':    round(float(s.quantile(0.25)), 6),
        'median': round(float(s.median()), 6),
        'q75':    round(float(s.quantile(0.75)), 6),
        'max':    round(float(s.max()), 6),
    }

    return _json_safe({
        'db_id':           db_id,
        'session_id':      session_id,
        'genes_found':     meta['genes_found'],
        'genes_missing':   meta['genes_missing'],
        'n_cells':         len(scores_df),
        'n_control_genes': meta['n_control_genes'],
        'layer':           request.layer,
        'n_control':       request.n_control,
        'seed':            request.seed,
        'summary':         summary,
    })


# ── Pseudobulk endpoint ────────────────────────────────────────────────────────
#
# Aggregates an integer-counts layer to a wide gene × group matrix grouped by
# one or more obs categorical columns. Output is the DESeq2/edgeR-shaped
# counts matrix (rows = genes, columns = groups, plus a gene_name column) plus
# colData embedded as Arrow custom metadata, so a single fetch hands a bulk
# DE consumer everything it needs.
#
# Default format is parquet. Sync inline body when the estimated payload fits
# under `?max_inline_mb=` (default 100); otherwise the response is JSON with
# an `artifact_url` and the parquet is written under
# `webapp/artifacts/pseudobulk/<token>.parquet` (served by nginx at
# `/artifacts/`, same Authelia gate as `/api/`).

_PSEUDOBULK_ARTIFACT_SUBDIR = 'artifacts/pseudobulk'
_PSEUDOBULK_ARTIFACT_TTL_S = 60 * 60          # 1 hour
_PSEUDOBULK_CLEAN_INTERVAL_S = 5 * 60         # sweep every 5 min
_PSEUDOBULK_GROUP_SEP = '_x_'                 # delimiter used in group_id


def _pseudobulk_artifacts_dir() -> Path:
    """Resolve the on-disk artifact directory. Mirrors `ant-mcp`'s `plots_dir`
    convention: under `webapp/`, served by the reverse proxy.
    """
    return get_webapp_dir() / 'artifacts' / 'pseudobulk'


def _layer_looks_integer(layer_stats: Optional[Dict[str, Any]]) -> Tuple[bool, str]:
    """Inspect a single layer's stats dict and decide if it looks like raw
    integer counts.  Returns (is_integer, reason).

    Heuristics (any one disqualifies):
      * dtype is float* and min_nonzero < 1
      * min_value < 0
      * max_value < 2 (a normalized layer caps around log2 of small numbers)
      * dtype is one of int8/16/32/64 → definitively integer
    """
    if not isinstance(layer_stats, dict):
        return False, "no layer_stats recorded in catalog metadata"
    dtype = str(layer_stats.get('dtype', '')).lower()
    min_value = layer_stats.get('min_value')
    min_nonzero = layer_stats.get('min_nonzero')
    max_value = layer_stats.get('max_value')

    if dtype.startswith('int') or dtype.startswith('uint'):
        return True, f"dtype={dtype}"

    # Float dtype: it MIGHT still be integer-valued. Check the nonzero floor.
    if min_value is not None and min_value < -1e-6:
        return False, (
            f"layer has negative values (min={min_value}); "
            "this looks like a transformed layer, not raw counts"
        )
    if min_nonzero is not None and 0 < min_nonzero < 0.999:
        return False, (
            f"layer has fractional nonzero values (min_nonzero={min_nonzero}); "
            "this looks log-normalized — try ?layer=counts"
        )
    if max_value is not None and max_value < 20:
        # A log-norm layer typically caps below ~20; raw counts go to thousands.
        return False, (
            f"layer's max_value is {max_value}, far below typical raw-counts "
            "magnitude; this looks transformed — try ?layer=counts"
        )
    # Float but plausibly integer-valued (whole-number floats from a counts-as-float storage).
    return True, f"dtype={dtype}, max={max_value}"


def _split_group_by(group_by: str) -> List[str]:
    """Parse `?group_by=col1,col2` into a list of column names. Rejects empty
    or duplicate entries; preserves caller order so column-id construction
    is reproducible."""
    if not group_by:
        raise HTTPException(422, detail="group_by is required (?group_by=col1[,col2,...])")
    cols = [c.strip() for c in group_by.split(',') if c.strip()]
    if not cols:
        raise HTTPException(422, detail="group_by must contain at least one column name")
    seen, out = set(), []
    for col in cols:
        if col in seen:
            continue
        seen.add(col)
        out.append(col)
    return out


def _build_subset_where_obscat(
    filters: Optional[Dict[str, Any]],
    cat_fields: List[str],
    num_fields: List[str],
    obscat_alias: str,
    obsnum_alias: Optional[str],
) -> Tuple[str, List[Any], bool]:
    """Build a WHERE-fragment + bound params from a parsed subset dict.

    Returns (sql_fragment, params, needs_obsnum_join). The fragment is a
    parenthesised AND-of-clauses suitable for splicing into `WHERE ... AND
    (<fragment>)`. Empty when filters is None / empty.

    Unknown fields raise 400 — the caller almost certainly typo'd a column
    name and a silent skip would mask the bug.
    """
    if not filters:
        return '', [], False
    parts: List[str] = []
    params: List[Any] = []
    needs_num_join = False
    for field, value in filters.items():
        if field in cat_fields:
            col_sql = f"{obscat_alias}.{safe_ident(field)}"
        elif field in num_fields:
            if obsnum_alias is None:
                raise HTTPException(400, detail=(
                    f"subset filter references numerical field '{field}' "
                    "which requires an obsnum join; the pseudobulk endpoint "
                    "currently supports categorical filters only"
                ))
            needs_num_join = True
            col_sql = f"{obsnum_alias}.{safe_ident(field)}"
        else:
            raise HTTPException(400, detail=(
                f"subset field '{field}' is not a known obs column "
                "(check spelling and casing against /databases/{db_id}/info)"
            ))

        if isinstance(value, tuple) and len(value) == 2:
            parts.append(f"{col_sql} BETWEEN ? AND ?")
            params.extend([value[0], value[1]])
        elif isinstance(value, list):
            placeholders = ', '.join(['?'] * len(value))
            parts.append(f"{col_sql} IN ({placeholders})")
            params.extend(value)
        else:
            parts.append(f"{col_sql} = ?")
            params.append(value)
    if not parts:
        return '', [], needs_num_join
    return '(' + ' AND '.join(parts) + ')', params, needs_num_join


# In-memory artifact registry: token -> {path, created_at, expires_at, db_id}.
# The on-disk file IS the source of truth; the dict is purely a fast-path index
# for the cleanup sweep so we don't restat every file every 5 min.
_pseudobulk_artifacts: Dict[str, Dict[str, Any]] = {}
_pseudobulk_artifacts_lock = Lock()


def _pseudobulk_register_artifact(token: str, path: Path, db_id: str) -> None:
    with _pseudobulk_artifacts_lock:
        now = time.time()
        _pseudobulk_artifacts[token] = {
            'path': str(path),
            'db_id': db_id,
            'created_at': now,
            'expires_at': now + _PSEUDOBULK_ARTIFACT_TTL_S,
        }


def _pseudobulk_sweep_artifacts() -> int:
    """Delete expired artifact files. Returns the count removed."""
    cutoff = time.time()
    removed = 0
    artifacts_dir = _pseudobulk_artifacts_dir()
    if not artifacts_dir.exists():
        return 0
    # Walk the dir directly — survives server restarts that wipe the in-memory dict.
    for file_path in artifacts_dir.iterdir():
        try:
            if not file_path.is_file():
                continue
            age = cutoff - file_path.stat().st_mtime
            if age > _PSEUDOBULK_ARTIFACT_TTL_S:
                file_path.unlink()
                removed += 1
        except OSError:
            continue
    if removed:
        with _pseudobulk_artifacts_lock:
            for tok in list(_pseudobulk_artifacts.keys()):
                entry = _pseudobulk_artifacts[tok]
                if not Path(entry['path']).exists():
                    _pseudobulk_artifacts.pop(tok, None)
    return removed


async def _pseudobulk_cleanup_loop() -> None:
    """Background task: sweep expired pseudobulk artifact files every 5 min."""
    while True:
        await asyncio.sleep(_PSEUDOBULK_CLEAN_INTERVAL_S)
        try:
            removed = await asyncio.to_thread(_pseudobulk_sweep_artifacts)
            if removed:
                log.info("pseudobulk: cleaned up %d expired artifact(s)", removed)
        except Exception as exc:
            log.warning("pseudobulk: cleanup sweep failed: %s", exc)


def _pseudobulk_artifact_url(token: str, fmt: str, request: Optional[Request]) -> str:
    """Return the public URL for an artifact. Constructed relative to the
    reverse-proxy mount, NOT the FastAPI `root_path` (artifacts are served
    statically by nginx at `/artifacts/`, parallel to `/api/`)."""
    base = ''
    if request is not None:
        # The Authelia/Caddy gate fronts us at the same scheme + host. We need
        # the *external* base, which the proxy passes via X-Forwarded-* or by
        # rewriting `request.base_url` (FastAPI's root_path='/api' makes
        # request.url_for return /api/... — wrong for static artifacts).
        scheme = request.headers.get('x-forwarded-proto', request.url.scheme)
        host = request.headers.get('x-forwarded-host') or request.headers.get('host', '')
        if host:
            base = f"{scheme}://{host}"
    return f"{base}/{_PSEUDOBULK_ARTIFACT_SUBDIR}/{token}.{fmt}"


def _pseudobulk_estimate_size_bytes(n_genes: int, n_groups: int) -> int:
    """Rough estimate of the parquet payload size in bytes.

    Wide matrix of int64 with parquet's typical ~2-3x compression for sparse
    counts. We use: n_genes * n_groups * 8 bytes * 0.4 compression + 30%
    overhead. Tuned to NOT under-estimate for the 25k genes × 300 groups case.
    """
    raw = n_genes * n_groups * 8
    return int(raw * 0.4 * 1.3)


def _pseudobulk_meta_dict(
    *,
    db_id: str,
    layer: str,
    group_by_cols: List[str],
    subset_filters: Optional[Dict[str, Any]],
    min_cells: int,
    n_genes: int,
    kept_sizes_df: 'pd.DataFrame',
    dropped_sizes_df: 'pd.DataFrame',
) -> Dict[str, Any]:
    """Build the meta dict embedded in parquet Arrow metadata + mirrored in
    async JSON response.  Pure pandas → dict; no IO."""
    groups = []
    for col_index, (_, row) in enumerate(kept_sizes_df.iterrows()):
        entry = {
            'group_id': row['group_id'],
            'n_cells': int(row['n_cells']),
            'column_index': col_index + 1,  # column 0 is gene_name
        }
        for col in group_by_cols:
            entry[col] = None if pd.isna(row[col]) else row[col]
        groups.append(entry)

    dropped = []
    for _, row in dropped_sizes_df.iterrows():
        entry = {'n_cells': int(row['n_cells']), 'reason': 'below min_cells'}
        for col in group_by_cols:
            entry[col] = None if pd.isna(row[col]) else row[col]
        dropped.append(entry)

    return {
        'db_id':            db_id,
        'layer':            layer,
        'group_by':         list(group_by_cols),
        'subset':           subset_filters or {},
        'min_cells':        int(min_cells),
        'n_genes':          int(n_genes),
        'n_groups':         len(groups),
        'n_dropped_groups': len(dropped),
        'groups':           groups,
        'dropped_groups':   dropped,
        'generated_at':     datetime.utcnow().isoformat() + 'Z',
        'api_version':      API_VERSION,
    }


def _pseudobulk_to_parquet_bytes(
    wide_df: 'pd.DataFrame', meta: Dict[str, Any],
) -> bytes:
    """Serialise the wide gene × group counts matrix as parquet bytes with
    `anthive_pseudobulk_meta` embedded in the Arrow schema metadata."""
    import pyarrow as pa
    import pyarrow.parquet as pq

    table = pa.Table.from_pandas(wide_df, preserve_index=False)
    meta_json = json.dumps(meta, default=str).encode('utf-8')
    new_metadata = dict(table.schema.metadata or {})
    new_metadata[b'anthive_pseudobulk_meta'] = meta_json
    table = table.replace_schema_metadata(new_metadata)
    buf = BytesIO()
    pq.write_table(table, buf, compression='zstd')
    return buf.getvalue()


def _pseudobulk_caption(
    *, db_id: str, layer: str, group_by_cols: List[str],
    n_genes: int, n_groups: int, n_dropped: int, min_cells: int,
) -> str:
    """One-line caption mirroring /plot's X-Plot-Caption pattern. Latin-1
    safe (no em-dash / × / curly quotes) since it ships in an HTTP header."""
    return (
        f"Pseudobulk count matrix for {db_id} grouped by ({','.join(group_by_cols)}), "
        f"layer {layer}. {n_genes:,} genes x {n_groups:,} groups; "
        f"{n_dropped:,} (group,) combinations dropped below min_cells={min_cells}. "
        f"Generated {datetime.utcnow().date().isoformat()}."
    )


def _pseudobulk_compute(
    *,
    db_id: str,
    layer: str,
    group_by_cols: List[str],
    subset_filters: Optional[Dict[str, Any]],
    min_cells: int,
) -> Tuple['pd.DataFrame', Dict[str, Any], 'pd.DataFrame', 'pd.DataFrame']:
    """Synchronous core: run the SQL aggregation and return
    (wide_df, meta_dict, kept_sizes_df, dropped_sizes_df).

    Runs entirely inside DuckDB (one GROUP BY + one pivot), so 25k×300
    matrices come back in ~seconds even on the S25/V6A scale (235k cells).
    """
    with _pooled_db(db_id) as db:
        conn = db._conn
        cat_fields = db._get_categorical_fields()
        num_fields = db._get_numerical_fields()
        layers = db._get_layers()

        if layer not in layers:
            raise HTTPException(404, detail=(
                f"layer '{layer}' not found in {db_id}. Available: "
                + ', '.join(sorted(layers))
            ))
        for col in group_by_cols:
            if col not in cat_fields:
                raise HTTPException(400, detail=(
                    f"group_by column '{col}' is not a categorical obs "
                    f"column in {db_id}. Available categorical columns: "
                    + ', '.join(sorted(cat_fields)[:20])
                    + ('...' if len(cat_fields) > 20 else '')
                ))

        # Layer-integer validation: trust catalog layer_stats first; if
        # missing, fall back to a single MIN/MAX/MIN-positive scan.
        try:
            md_path = registry.databases.get(db_id, {}).get('md_path')
            file_meta = registry.metadata_cache.get(db_id, {}) or {}
        except Exception:
            file_meta = {}
        layer_stats_all = file_meta.get('layer_stats', {}) if isinstance(file_meta, dict) else {}
        layer_stats = layer_stats_all.get(layer) if isinstance(layer_stats_all, dict) else None

        if layer_stats is None:
            # Use the layer view (works for both Parquet-backed and legacy dbs)
            layer_view = safe_ident(f"layer__{layer}")
            row = conn.execute(
                f"SELECT MIN(value), MAX(value), MIN(CASE WHEN value > 0 THEN value END) FROM {layer_view}"
            ).fetchone() or (0, 0, None)
            layer_stats = {
                'dtype': 'float',  # we have to guess; treat as float and lean on heuristics
                'min_value': float(row[0]) if row[0] is not None else 0.0,
                'max_value': float(row[1]) if row[1] is not None else 0.0,
                'min_nonzero': float(row[2]) if row[2] is not None else None,
            }

        is_int, reason = _layer_looks_integer(layer_stats)
        if not is_int:
            raise HTTPException(400, detail=(
                f"layer '{layer}' does not look like integer counts: {reason}. "
                "DESeq2/edgeR require raw integer counts; try ?layer=counts "
                f"(available layers on {db_id}: {sorted(layers)})."
            ))

        # Compose group_id expression: oc."col1" || '_x_' || oc."col2"
        casted_parts = [
            f"CAST(oc.{safe_ident(c)} AS VARCHAR)" for c in group_by_cols
        ]
        sep_sql_literal = "'" + _PSEUDOBULK_GROUP_SEP + "'"
        group_expr = (
            casted_parts[0] if len(casted_parts) == 1
            else (f" || {sep_sql_literal} || ".join(casted_parts))
        )
        not_null_clause = ' AND '.join(
            f"oc.{safe_ident(c)} IS NOT NULL" for c in group_by_cols
        )

        # Subset WHERE
        subset_frag, subset_params, needs_obsnum = _build_subset_where_obscat(
            subset_filters, cat_fields, num_fields, 'oc',
            obsnum_alias='onum' if num_fields else None,
        )
        obsnum_join = (
            "LEFT JOIN __obsnum onum ON onum.cell_id = oc.cell_id"
            if needs_obsnum else ""
        )

        where_parts = [not_null_clause]
        if subset_frag:
            where_parts.append(subset_frag)
        where_sql = ' AND '.join(where_parts)

        # Use the by-gene parquet view for the layer aggregation —
        # it is sorted by gene_id which makes the GROUP BY gene_name fast.
        # For legacy in-DuckDB dbs the view backs through __layer__<layer>.
        layer_table = safe_ident(f"layer__{layer}")

        # 1) Group sizes (cells per group, regardless of expression)
        size_select_cols = ', '.join(
            f"oc.{safe_ident(c)} AS {safe_ident(c)}" for c in group_by_cols
        )
        sql_sizes = f"""
            SELECT
                {group_expr} AS group_id,
                COUNT(*) AS n_cells,
                {size_select_cols}
            FROM __obscat oc
            {obsnum_join}
            WHERE {where_sql}
            GROUP BY group_id, {', '.join(safe_ident(c) for c in group_by_cols)}
        """
        sizes_df = conn.execute(sql_sizes, subset_params).fetchdf()
        if sizes_df.empty:
            raise HTTPException(404, detail=(
                f"no cells matched (group_by={group_by_cols}, "
                f"subset={subset_filters}). Verify the columns are populated."
            ))

        kept_df = sizes_df[sizes_df['n_cells'] >= min_cells].copy()
        dropped_df = sizes_df[sizes_df['n_cells'] < min_cells].copy()
        if kept_df.empty:
            raise HTTPException(404, detail=(
                f"every group has < min_cells={min_cells} cells. "
                f"{len(sizes_df)} group(s) found; max group size = "
                f"{int(sizes_df['n_cells'].max())}. "
                "Lower min_cells or pick a coarser group_by."
            ))

        kept_ids = kept_df['group_id'].astype(str).tolist()
        ids_placeholders = ','.join(['?'] * len(kept_ids))

        # 2) Aggregated counts (long form). Use the layer__<layer> view
        #    (Parquet-backed since the 2026-07 migration; joins __cells/__genes
        #    to expose cell_name and gene_name).
        sql_counts = f"""
            WITH cells_in_groups AS (
                SELECT
                    oc.cell_id AS cell_id,
                    {group_expr} AS group_id
                FROM __obscat oc
                {obsnum_join}
                WHERE {where_sql}
            )
            SELECT
                g.gene_name AS gene_name,
                cig.group_id AS group_id,
                SUM(l.value) AS counts
            FROM {layer_table} l
            JOIN cells_in_groups cig ON cig.cell_id = l.cell_id
            JOIN __genes g ON g.gene_id = l.gene_id
            WHERE cig.group_id IN ({ids_placeholders})
            GROUP BY g.gene_name, cig.group_id
        """
        counts_long = conn.execute(
            sql_counts, list(subset_params) + list(kept_ids),
        ).fetchdf()

        # 3) Gene catalog (all genes, even those with 0 counts in every kept group)
        genes_df = conn.execute(
            "SELECT gene_name FROM __genes ORDER BY gene_name"
        ).fetchdf()
        n_genes = len(genes_df)

        # Pivot long → wide. Ensure every kept group has a column; fill zeros.
        if counts_long.empty:
            wide = pd.DataFrame({'gene_name': genes_df['gene_name']})
            for gid in sorted(kept_ids):
                wide[gid] = 0
        else:
            pivoted = counts_long.pivot_table(
                index='gene_name', columns='group_id', values='counts',
                aggfunc='sum', fill_value=0,
            )
            # Re-index against the FULL gene catalog so genes silent in every
            # group still appear as a zero-filled row (DESeq2's filterByExpr
            # expects the full matrix, not the post-filter one).
            pivoted = pivoted.reindex(genes_df['gene_name'].values, fill_value=0)
            # Add any kept group ids that ended up with literally zero expression.
            for gid in kept_ids:
                if gid not in pivoted.columns:
                    pivoted[gid] = 0
            pivoted = pivoted[sorted(pivoted.columns.tolist())]
            wide = pivoted.reset_index()
            wide = wide.rename(columns={'index': 'gene_name'})
            if 'gene_name' not in wide.columns:
                wide.insert(0, 'gene_name', genes_df['gene_name'].values)

        # Coerce count columns to int64 (DESeq2 / edgeR want integers).
        for col in wide.columns:
            if col == 'gene_name':
                continue
            wide[col] = wide[col].fillna(0).round().astype('int64')

        # Move gene_name to first column
        cols = ['gene_name'] + [c for c in wide.columns if c != 'gene_name']
        wide = wide[cols]

        # Sort kept_df / dropped_df by group_id so the metadata `column_index`
        # matches the parquet column order (which we already sorted above).
        kept_df = kept_df.sort_values('group_id').reset_index(drop=True)
        dropped_df = dropped_df.sort_values('group_id').reset_index(drop=True)

        meta = _pseudobulk_meta_dict(
            db_id=db_id, layer=layer, group_by_cols=group_by_cols,
            subset_filters=subset_filters, min_cells=min_cells,
            n_genes=n_genes,
            kept_sizes_df=kept_df, dropped_sizes_df=dropped_df,
        )
        return wide, meta, kept_df, dropped_df


@app.get("/databases/{db_id:path}/pseudobulk", tags=["data"])
async def get_pseudobulk(
    db_id: str,
    request: Request,
    group_by: str = Query(
        ...,
        description=(
            "Comma-separated list of obs **categorical** columns that define "
            "the pseudobulk groups. ``leiden`` → one column per leiden level; "
            "``leiden,donor`` → one column per (leiden x donor) combination."
        ),
    ),
    layer: str = Query(
        'counts',
        description=(
            "Layer to aggregate. Must be integer-valued for DESeq2 / edgeR-"
            "style downstream tooling; the endpoint validates layer_stats "
            "and 400s with a helpful message if the layer looks log-norm."
        ),
    ),
    min_cells: int = Query(
        10, ge=1, le=10_000,
        description="Drop groups with fewer than this many cells (default 10).",
    ),
    subset: List[str] = Query(
        default=[],
        description=(
            "Pre-filter applied BEFORE the GROUP BY (repeatable). "
            "Same format as the plot endpoints: ``field:value``, "
            "``field:v1,v2``, ``field:min..max``. "
            "Only categorical filters are supported here."
        ),
    ),
    max_inline_mb: int = Query(
        100, ge=1, le=2000,
        description=(
            "Auto-escalation threshold: if the estimated payload exceeds "
            "this many megabytes, the response becomes JSON with an "
            "``artifact_url`` pointing to the parquet on the server "
            "(TTL 1 hour)."
        ),
    ),
    async_mode: bool = Query(
        False, alias='async',
        description="Force async/temp-file mode regardless of estimated size.",
    ),
    output_format: str = Query(
        'parquet', alias='format', regex='^(parquet|csv|tsv)$',
        description=(
            "Output format. ``parquet`` (default) embeds the colData via "
            "Arrow custom metadata key ``anthive_pseudobulk_meta``. ``csv`` "
            "and ``tsv`` force wide layout; the colData is gone from the "
            "body — read it from the ``X-Pseudobulk-Meta`` response header."
        ),
    ),
):
    """Aggregate a counts layer to a wide gene x group matrix (rows = genes,
    columns = groups, plus ``gene_name``) ready to feed DESeq2 / edgeR.

    **Sync mode (default)** — returns the parquet bytes inline.  Arrow
    schema metadata key ``anthive_pseudobulk_meta`` carries colData
    (per-group cell counts + the obs-column values that defined the
    group) so consumers don't need a second call.

    **Async mode** — auto-engaged when the estimated payload exceeds
    ``max_inline_mb`` (default 100 MB) or when ``?async=true``. Response
    becomes JSON ``{artifact_url, expires_at, size_bytes, sha256,
    groups, n_genes, n_groups, n_dropped_groups}``; the parquet is
    written to ``webapp/artifacts/pseudobulk/<token>.parquet`` and
    served at ``/artifacts/pseudobulk/<token>.parquet`` with TTL 1 h.

    Layer-integer check: the endpoint reads ``layer_stats`` from the
    catalog metadata and refuses to aggregate a log-normalized layer.
    Pass ``?layer=counts`` for the canonical raw-counts layer.
    """
    group_by_cols = _split_group_by(group_by)
    subset_filters = _parse_subset(subset)

    try:
        wide, meta, _kept_df, _dropped_df = await asyncio.to_thread(
            _pseudobulk_compute,
            db_id=db_id,
            layer=layer,
            group_by_cols=group_by_cols,
            subset_filters=subset_filters,
            min_cells=min_cells,
        )
    except HTTPException:
        raise
    except KeyError as exc:
        raise HTTPException(status_code=404, detail=f"db_id {db_id!r} not found: {exc}")
    except ValueError as exc:
        raise HTTPException(status_code=400, detail=str(exc))
    except Exception as exc:
        log.exception("pseudobulk: compute failed for db_id=%s", db_id)
        raise HTTPException(status_code=500, detail=f"pseudobulk failed: {exc}")

    n_genes = meta['n_genes']
    n_groups = meta['n_groups']
    n_dropped = meta['n_dropped_groups']

    caption = _pseudobulk_caption(
        db_id=db_id, layer=layer, group_by_cols=group_by_cols,
        n_genes=n_genes, n_groups=n_groups, n_dropped=n_dropped,
        min_cells=min_cells,
    )

    base_headers = {
        'X-Pseudobulk-N-Groups':         str(n_groups),
        'X-Pseudobulk-N-Genes':          str(n_genes),
        'X-Pseudobulk-Dropped-Groups':   str(n_dropped),
        'X-Pseudobulk-Layer':            layer,
        'X-Pseudobulk-Group-By':         ','.join(group_by_cols),
        'X-Plot-Caption':                caption,
    }

    # CSV / TSV are always synchronous (text body — we don't write csv artifacts).
    if output_format in ('csv', 'tsv'):
        sep = '\t' if output_format == 'tsv' else ','
        buf = StringIO()
        wide.to_csv(buf, sep=sep, index=False)
        body = buf.getvalue().encode('utf-8')
        # Stash a compact meta hint in a header (truncated if too big).
        compact_meta = {
            k: v for k, v in meta.items()
            if k in ('db_id', 'layer', 'group_by', 'min_cells',
                     'n_genes', 'n_groups', 'n_dropped_groups')
        }
        header_meta = json.dumps(compact_meta, default=str)
        if len(header_meta) > 4000:
            header_meta = header_meta[:3996] + '...'
        ct = (
            'text/tab-separated-values; charset=utf-8'
            if output_format == 'tsv' else 'text/csv; charset=utf-8'
        )
        fname = (
            f"{db_id.replace('/', '_')}_pseudobulk_"
            f"{'_'.join(group_by_cols)}.{output_format}"
        )
        return Response(
            content=body,
            media_type=ct,
            headers={
                **base_headers,
                'X-Pseudobulk-Meta':       header_meta,
                'Content-Disposition':     f'attachment; filename="{fname}"',
            },
        )

    # parquet: build bytes once. May be inline or written to artifact.
    parquet_bytes = await asyncio.to_thread(_pseudobulk_to_parquet_bytes, wide, meta)
    size_bytes = len(parquet_bytes)

    est_size = _pseudobulk_estimate_size_bytes(n_genes, n_groups)
    threshold_bytes = max_inline_mb * 1024 * 1024
    # Use the ACTUAL serialised size for the escalation decision — the rough
    # estimate is only used as a hint. (We always serialise; even in async
    # mode we'd serialise to write the file.)
    must_escalate = async_mode or size_bytes > threshold_bytes

    if not must_escalate:
        fname = (
            f"{db_id.replace('/', '_')}_pseudobulk_"
            f"{'_'.join(group_by_cols)}.parquet"
        )
        return Response(
            content=parquet_bytes,
            media_type='application/x-parquet',
            headers={
                **base_headers,
                'Content-Disposition':     f'attachment; filename="{fname}"',
                'X-Pseudobulk-Size-Bytes': str(size_bytes),
                'X-Pseudobulk-Estimated-Bytes': str(est_size),
            },
        )

    # Async branch — write to disk + return JSON pointer.
    import uuid as _uuid
    import hashlib as _hl
    artifacts_dir = _pseudobulk_artifacts_dir()
    artifacts_dir.mkdir(parents=True, exist_ok=True)
    token = _uuid.uuid4().hex
    artifact_path = artifacts_dir / f"{token}.parquet"
    await asyncio.to_thread(artifact_path.write_bytes, parquet_bytes)
    sha256 = _hl.sha256(parquet_bytes).hexdigest()
    _pseudobulk_register_artifact(token, artifact_path, db_id)

    expires_at = datetime.utcfromtimestamp(time.time() + _PSEUDOBULK_ARTIFACT_TTL_S)
    body = {
        'artifact_url':      _pseudobulk_artifact_url(token, 'parquet', request),
        'expires_at':        expires_at.isoformat() + 'Z',
        'expires_in':        _PSEUDOBULK_ARTIFACT_TTL_S,
        'size_bytes':        size_bytes,
        'sha256':            sha256,
        'db_id':             meta['db_id'],
        'layer':             meta['layer'],
        'group_by':          meta['group_by'],
        'subset':            meta['subset'],
        'min_cells':         meta['min_cells'],
        'n_genes':           meta['n_genes'],
        'n_groups':          meta['n_groups'],
        'n_dropped_groups':  meta['n_dropped_groups'],
        'groups':            meta['groups'],
        'dropped_groups':    meta['dropped_groups'],
        'caption':           caption,
    }
    return JSONResponse(
        content=json.loads(json.dumps(body, default=str)),
        headers={
            **base_headers,
            'X-Pseudobulk-Async':           'true',
            'X-Pseudobulk-Artifact-Token':  token,
            'X-Pseudobulk-Size-Bytes':      str(size_bytes),
        },
    )


@app.post("/admin/release/{db_id:path}", tags=["admin"], dependencies=[Depends(_require_admin_or_local)])
def release_database(
    db_id: str,
    duration_seconds: float = 300.0,
    drain_timeout_seconds: float = 30.0,
):
    """Evict a database from the connection pool so a writer can take the
    DuckDB r/w lock.

    Closes idle pooled connections, marks the db_key as evicted (refuses new
    connections), and waits up to `drain_timeout_seconds` for in-use
    connections to be returned. The eviction self-expires after
    `duration_seconds` (safety net so a crashed writer can't lock ant-serve
    out indefinitely).

    Returns:
      - ok: True if the db is fully released; False if in-use connections
        didn't drain in time (the writer should retry or fail)
      - closed_idle: number of pooled connections that were closed
      - still_in_use: 0 on success, else the count of stubbornly in-use conns
      - eviction_expires_in: seconds until the eviction auto-clears

    Used by AnnotationWriter / ant-merge-h5ad / ant-score / ant-starcat
    before they open the duckdb in r/w mode.
    """
    try:
        db_url = registry.get_database_path(db_id)
    except KeyError:
        raise HTTPException(status_code=404, detail=f"db_id {db_id!r} not found")
    result = connection_pool.release(
        db_url,
        duration_seconds=duration_seconds,
        drain_timeout_seconds=drain_timeout_seconds,
    )
    log.info("admin.release db_id=%s result=%s", db_id, result)
    return result


@app.post("/admin/restore/{db_id:path}", tags=["admin"], dependencies=[Depends(_require_admin_or_local)])
def restore_database(db_id: str):
    """Clear an eviction set by /admin/release/{db_id}. The connection pool
    opens a fresh r/o instance on the next request.

    The writer that held the release may have added obs columns
    (AnnotationWriter ALTER TABLE), so this dataset's cached metadata is
    reloaded too; otherwise /info would keep the old column list until a
    full rescan.
    """
    try:
        db_url = registry.get_database_path(db_id)
    except KeyError:
        raise HTTPException(status_code=404, detail=f"db_id {db_id!r} not found")
    result = connection_pool.restore(db_url)
    registry.gene_list_cache.pop(db_id, None)
    try:
        extra = registry._db_extra.get(db_id, {})
        registry.metadata_cache[db_id] = registry._load_database_metadata(db_id, extra)
        registry._databases_list_cache = None
        result['metadata_reloaded'] = True
    except Exception as exc:  # restore itself succeeded; keep the old metadata
        log.warning("admin.restore: metadata reload failed for %s: %s", db_id, exc)
        result['metadata_reloaded'] = False
    log.info("admin.restore db_id=%s result=%s", db_id, result)
    return result


@app.post("/admin/refresh-views/{db_id:path}", tags=["admin"], dependencies=[Depends(_require_admin_or_local)])
def refresh_views(db_id: str):
    """Rebuild the obscat/obsnum views on this dataset's duckdb from the
    current .md ``api:`` section (obs_rename / obs_hidden).

    Useful after editing the .md's api section out-of-band (via a text
    editor or a git pull) — the views need a rebuild for the change to
    take effect. Called internally by /admin/api-config after a write;
    can be called directly for a manual refresh.

    Applies the release → open r/w → CREATE OR REPLACE VIEW → restore
    dance so an in-flight query completes cleanly.
    """
    from anthive_db import build_obs_view_sql, safe_ident  # noqa: PLC0415
    from metadata import parse_md_file, get_api_config, MetadataError  # noqa: PLC0415
    import duckdb as _duckdb  # noqa: PLC0415

    try:
        duckdb_url = registry.get_database_path(db_id)
    except KeyError:
        raise HTTPException(status_code=404, detail=f"db_id {db_id!r} not found")

    md_path = registry._db_md_bases.get(db_id)
    if md_path is None or not md_path.exists():
        raise HTTPException(400, detail=f"no .md on disk for {db_id}")
    duckdb_path = Path(str(duckdb_url).replace('file://', ''))
    if not duckdb_path.exists():
        raise HTTPException(400, detail=f"duckdb not local: {duckdb_path}")

    try:
        yaml_dict, _ = parse_md_file(md_path)
        api_config = get_api_config(yaml_dict)
    except MetadataError as exc:
        raise HTTPException(400, detail=f"invalid api: section in {md_path.name}: {exc}")

    # Release from pool so we can open r/w.
    release_result = connection_pool.release(
        duckdb_url, duration_seconds=60.0, drain_timeout_seconds=30.0,
    )
    if not release_result.get('ok'):
        raise HTTPException(503, detail=f"could not release {db_id} from pool: {release_result}")

    try:
        conn = _duckdb.connect(str(duckdb_path), read_only=False)
        try:
            rebuilt = []
            # Cache sibling column lists so obs_derive can reference the
            # other __obs* table (e.g. an obscat 'braak_stage' → obsnum
            # 'braak' derivation).
            _sibling_cols: Dict[str, list] = {}
            # If an obs_derive targets a dtype whose __obs* table doesn't
            # exist (e.g. a numerical derivation on a dataset with zero
            # numerical native cols), auto-create an empty stub keyed by
            # cell_id so the derived view has a home. The stub carries no
            # data — the CASE expression pulls from the sibling table.
            derive_by_dtype = {'numerical': set(), 'categorical': set()}
            for new_col, spec in (api_config.get('obs_derive') or {}).items():
                dt = spec.get('dtype')
                if dt in derive_by_dtype:
                    derive_by_dtype[dt].add(new_col)
            # obs_constant contributes the same way — if a dataset has no
            # __obscat and we want to publish a constant categorical col,
            # we need the empty stub keyed by cell_id.
            for new_col, spec in (api_config.get('obs_constant') or {}).items():
                dt = spec.get('dtype')
                if dt in derive_by_dtype:
                    derive_by_dtype[dt].add(new_col)
            for view_name, underscore in (('obsnum', '__obsnum'), ('obscat', '__obscat')):
                exists = conn.execute(
                    "SELECT COUNT(*) FROM information_schema.tables "
                    "WHERE table_name = ? AND table_type = 'BASE TABLE'",
                    [underscore],
                ).fetchone()[0]
                dtype = 'numerical' if underscore.endswith('obsnum') else 'categorical'
                needs_stub = (not exists) and derive_by_dtype[dtype]
                if not exists and not needs_stub:
                    continue
                if needs_stub:
                    conn.execute(
                        f"CREATE TABLE {safe_ident(underscore)} AS "
                        f"SELECT cell_id FROM __cells"
                    )
                cols = [r[0] for r in conn.execute(
                    "SELECT column_name FROM information_schema.columns "
                    "WHERE table_name = ?", [underscore]
                ).fetchall()]
                _sibling_cols[underscore] = cols
                sibling_underscore = '__obsnum' if underscore.endswith('obscat') else '__obscat'
                sibling_cols = _sibling_cols.get(sibling_underscore)
                if sibling_cols is None:
                    try:
                        sibling_cols = [r[0] for r in conn.execute(
                            "SELECT column_name FROM information_schema.columns "
                            "WHERE table_name = ?", [sibling_underscore]
                        ).fetchall()]
                    except Exception:
                        sibling_cols = []
                conn.execute(f"DROP VIEW IF EXISTS {safe_ident(view_name)}")
                conn.execute(build_obs_view_sql(
                    view_name, underscore, cols, api_config,
                    sibling_underscore_table=sibling_underscore,
                    sibling_columns=sibling_cols,
                ))
                rebuilt.append(view_name)
            conn.execute("CHECKPOINT")
        finally:
            conn.close()
    finally:
        connection_pool.restore(duckdb_url)

    # Invalidate the cached obs col list for this dataset so /info picks up
    # the renamed/hidden cols. Without this the view is fresh on disk but
    # ant-serve's per-dataset metadata cache still shows the old cols.
    try:
        extra = registry._db_extra.get(db_id, {})
        registry.metadata_cache[db_id] = registry._load_database_metadata(db_id, extra)
        registry._databases_list_cache = None
    except Exception as exc:
        log.warning("admin.refresh-views: metadata reload failed for %s: %s", db_id, exc)

    log.info("admin.refresh-views db_id=%s rebuilt=%s", db_id, rebuilt)
    return {
        'status': 'success',
        'db_id': db_id,
        'rebuilt': rebuilt,
        'obs_rename':       api_config.get('obs_rename', {}),
        'obs_hidden':       api_config.get('obs_hidden', []),
        'obs_value_rename': api_config.get('obs_value_rename', {}),
        'obs_value_hidden': api_config.get('obs_value_hidden', {}),
        'obs_derive':       api_config.get('obs_derive', {}),
        'obs_constant':     api_config.get('obs_constant', {}),
    }


@app.post("/admin/api-config/{db_id:path}", tags=["admin"])
async def set_api_config(db_id: str, request: Request):
    """Update the ``api:`` section in this dataset's .md and rebuild views.

    Body (JSON): ``{"obs_rename": {...}, "obs_hidden": [...]}``. Either
    field may be omitted; existing values are then left alone. To CLEAR a
    field, pass an empty ``{}`` or ``[]``.

    Writes only to the .md file — the git commit is the admin's job
    (h5adstore is a separate repo). Rebuilds the obscat/obsnum views
    so the change is live immediately.
    """
    from metadata import parse_md_file, write_md_file, get_api_config, MetadataError  # noqa: PLC0415

    md_path = registry._db_md_bases.get(db_id)
    if md_path is None or not md_path.exists():
        raise HTTPException(404, detail=f"no .md on disk for {db_id}")

    body = await request.json()
    if not isinstance(body, dict):
        raise HTTPException(400, detail="body must be a JSON object")

    yaml_dict, body_md = parse_md_file(md_path)
    api_section = dict(yaml_dict.get('api') or {})

    _FIELDS = {
        'obs_rename':       dict,   # {internal → public}
        'obs_hidden':       list,   # [internal names to drop]
        'obs_value_rename': dict,   # {col: {old_val → new_val}}
        'obs_value_hidden': dict,   # {col: [values to NULL]}
        'obs_derive':       dict,   # {new_col: {source, dtype, map, default}}
        'obs_constant':     dict,   # {new_col: {value, dtype}}
    }
    for name, expected_type in _FIELDS.items():
        val = body.get(name)
        if val is None:
            continue
        if not isinstance(val, expected_type):
            raise HTTPException(400,
                detail=f"'{name}' must be a JSON {expected_type.__name__}")
        # copy so we don't share the request body's mutable object
        api_section[name] = expected_type(val) if expected_type is list else dict(val)
    yaml_dict['api'] = api_section

    # Validate BEFORE writing to disk. If we accepted a bad api section and
    # crashed on the next view rebuild, the .md would need manual repair.
    try:
        get_api_config(yaml_dict)
    except MetadataError as exc:
        raise HTTPException(400, detail=str(exc))

    write_md_file(md_path, yaml_dict, body_md)
    log.info("admin.api-config db_id=%s wrote %s", db_id, md_path.name)

    # Rebuild views to make the new rename+hide live immediately.
    return await asyncio.to_thread(refresh_views, db_id)


@app.post("/admin/rescan", tags=["admin"], dependencies=[Depends(_require_admin_or_local)])
def rescan_databases():
    """
    Force rescan of data folder and reload all metadata

    Triggers a complete rescan of the data folder, clearing all caches
    and re-discovering databases and metadata.

    Useful after:
    - Adding new database files
    - Updating metadata files (.md, index.md)
    - Removing database files

    Returns:
    - status: 'success'
    - previous_count: Number of databases before rescan
    - current_count: Number of databases after rescan
    - added: List of added database IDs
    - removed: List of removed database IDs
    - databases: Complete list of current database IDs
    """
    try:
        result = registry.rescan()
        # rebuild module-score and by-gene reverse indices too
        if geneset_registry is not None:
            _build_score_index()
            _build_by_gene_index()
            result['scored_databases'] = len(_score_index_by_db)
        # Drop the plot-response cache — any cached image may now be stale.
        result['plot_cache_cleared'] = _plot_cache_clear()
        return result
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


