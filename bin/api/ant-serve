from contextlib import contextmanager

@contextmanager
def _pooled_db(db_id: str):
    """Context manager: AnthiveDB backed by the connection pool (local or S3)."""
    db_url = registry.get_database_path(db_id)
    try:
        conn = connection_pool.get_connection(db_url)
    except EvictedDatabaseError as exc:
        raise HTTPException(
            status_code=503,
            detail=f"{exc}",
            headers={"Retry-After": "5"},
        )
    try:
        yield AnthiveDB(conn=conn, owns_conn=False)
    finally:
        connection_pool.return_connection(db_url, conn)


@app.get("/health", tags=["info"])
async def health_check():
    """
    Health check + speed signal for load balancers and client-side server
    selection.

    Returns 200 if healthy, 503 if unhealthy.  `mean_response_ms` /
    `p50_response_ms` are computed over the last 1024 non-probe requests;
    a client picking between multiple anthive servers should prefer the
    one with the lowest values (null = no samples yet).

    Health and /metrics requests are excluded from the timing samples so
    that polling doesn't skew the metric.
    """
    try:
        database_count = len(registry.databases)
        error_count = sum(1 for m in registry.metadata_cache.values() if 'error' in m)

        if database_count == 0:
            raise HTTPException(
                status_code=503,
                detail="No databases available"
            )

        timing = _timing_snapshot()
        return {
            "status": "healthy",
            "databases": database_count,
            "database_errors": error_count,
            "uptime_seconds": int(registry.get_uptime()),
            "api_version": API_VERSION,
            # Speed signal — lower = faster.  null when no samples yet.
            "mean_response_ms": timing['mean_ms'],
            "p50_response_ms":  timing['p50_ms'],
            "n_samples":        timing['n_samples'],
        }
    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(
            status_code=503,
            detail=f"Health check failed: {str(e)}"
        )


# ── chat assistant — singleton state ──────────────────────────────────────────
#
# The chat history store is created lazily on first request that needs it.
# Lazy init keeps ant-serve's startup snappy when chat is disabled.
_chat_history: Optional[ChatHistory] = None


def _get_chat_history(cfg) -> ChatHistory:
    """Lazy-create the ChatHistory singleton at first use."""
    global _chat_history
    if _chat_history is None:
        _chat_history = ChatHistory(cfg.history_path)
    return _chat_history


def _chat_user_from_request(request: Request) -> str:
    """Pull the Authelia/nginx Remote-User header off an incoming request.

    Locked per pika #217 §9: chat history is keyed on Authelia Remote-User
    × session_id. If Remote-User is missing the request is unauthenticated
    — refuse the chat endpoint with 401 (the public auth gate should
    already have blocked it; we re-verify here as defence in depth).
    """
    # Caddy / nginx upstream both forward the header lowercased through
    # FastAPI's case-insensitive ``request.headers`` view.
    user = (request.headers.get('Remote-User')
            or request.headers.get('X-Remote-User')
            or '').strip()
    if not user:
        raise HTTPException(
            status_code=401,
            detail="chat endpoint requires authentication "
                   "(Remote-User header not set)",
        )
    return user


@app.get("/chat/status", tags=["chat"])
async def chat_status():
    """Whether the in-app chat assistant is available on this deployment.

    Always reachable (no 404 in any state). Returns
    ``{"enabled": true, "model": "<id>"}`` when fully active, else
    ``{"enabled": false}``. The web client polls this on every page
    load and only renders the chat widget when ``enabled`` is true.

    Three states roll up into the wire response:

      - chat.enabled=true + api_key present → {enabled: true, model: …}
      - chat.enabled=true + no api_key       → {enabled: false}   (silently off + startup warning)
      - chat.enabled=false                   → {enabled: false}   (default)

    Contract locked with anthive-web in pika #217/§9.
    """
    cfg = load_chat_config(get_config())
    return status_payload(cfg)


class _ChatPostBody(BaseModel):
    """POST /api/chat request body — locked per pika #217 §9.3.

    ``model`` is an optional per-turn override: if set AND it's in
    ``chat.allowed_models``, the turn uses that model instead of the
    configured default. Unknown/disallowed models 400 with a list of
    valid ids.
    """
    session_id: str
    message: str
    context: Dict[str, Any] = {}
    model: Optional[str] = None


@app.post("/chat", tags=["chat"])
async def chat_post(request: Request, body: _ChatPostBody):
    """Streamed assistant turn. text/event-stream of token / action / error / done frames.

    See ``lib/chat_agent.run_turn`` for the per-turn behaviour. The
    contract is locked with anthive-web in pika #217 §9.3; do not
    change the frame shape without an opposite-side rev.

    Returns 404 when the chat assistant is not active on this deployment.
    """
    cfg = load_chat_config(get_config())
    if not cfg.active:
        raise HTTPException(status_code=404, detail="chat assistant is not active")
    user = _chat_user_from_request(request)
    store = _get_chat_history(cfg)

    # Validate the optional model override against allowed_models. Empty
    # allowed_models means "no picker" — only the default may be used.
    model_override: Optional[str] = None
    if body.model and body.model != cfg.model:
        if not cfg.allow_model(body.model):
            valid_ids = [m.get('id') for m in cfg.allowed_models] or [cfg.model]
            raise HTTPException(
                status_code=400,
                detail=f"model {body.model!r} is not in chat.allowed_models. "
                       f"Valid: {valid_ids}",
            )
        model_override = body.model

    # Internal API base = the same host:port ant-serve is listening on,
    # so the tool's self-call doesn't traverse Caddy + Authelia. The
    # rest_api_host / rest_api_port live in anthive.yaml; for the
    # standard supervisor-launched setup this resolves to
    # http://localhost:8080/api.
    _cfg = get_config()
    internal_host = _cfg.get('rest_api_host', 'localhost')
    internal_port = _cfg.get('rest_api_port', 8080)
    if internal_host in ('0.0.0.0', '::'):
        internal_host = 'localhost'
    internal_api_url = f'http://{internal_host}:{internal_port}/api'

    async def _generate():
        async for frame in _chat_run_turn(
            cfg=cfg,
            history_store=store,
            user=user,
            session_id=body.session_id,
            message=body.message,
            context=body.context,
            internal_api_url=internal_api_url,
            internal_api_auth=None,        # localhost loopback — no auth needed
            model_override=model_override,
        ):
            yield frame

    return StreamingResponse(
        _generate(),
        media_type='text/event-stream',
        headers={
            # SSE-friendly: disable proxy buffering (Caddy + nginx).
            'Cache-Control': 'no-cache',
            'X-Accel-Buffering': 'no',
        },
    )


@app.get("/chat/history", tags=["chat"])
async def chat_history(
    request: Request,
    session_id: str = Query(..., description="Client-chosen session id; the transcript is keyed on (Remote-User, session_id)."),
):
    """Return the transcript for one (Remote-User, session_id) pair.

    Locked contract: ``{"messages": [{"role": "user"|"assistant"|"action", "content": "..."}]}``.
    Empty list when there's no history yet.

    Returns 404 when the chat assistant is not active on this deployment
    (matches the web spec: only ``/chat/status`` is reachable when off).
    """
    cfg = load_chat_config(get_config())
    if not cfg.active:
        raise HTTPException(status_code=404, detail="chat assistant is not active")
    user = _chat_user_from_request(request)
    store = _get_chat_history(cfg)
    messages = store.list_messages(user, session_id)
    return {'messages': messages}


@app.get("/chat/usage", tags=["chat"])
async def chat_usage(
    request: Request,
    session_id: str = Query(..., description="Same session_id used by /chat and /chat/history."),
):
    """Cost + token usage for one (Remote-User, session_id).

    Returns aggregate counters across every LLM call made in this
    session. Useful for rendering a "$0.0024 · 12.4k tokens (3.2k
    cached)" badge in the chat header.

    Response shape::

        {
          "turns":             3,            // distinct user messages
          "llm_calls":         7,            // total LLM round-trips
          "prompt_tokens":     45123,
          "completion_tokens": 3104,
          "cached_tokens":     38400,        // prompt tokens served from cache
          "cache_write_tokens":  600,        // tokens written to cache (one-off)
          "total_tokens":      48227,
          "cached_fraction":   0.851,        // cached / prompt — cache effectiveness
          "cost_usd":          0.0024,
          "by_model": [
            {"model": "anthropic/claude-opus-4", "llm_calls": 5,
             "prompt_tokens": ..., "completion_tokens": ...,
             "cached_tokens": ..., "cost_usd": 0.0021},
            ...
          ]
        }

    Empty session returns the same shape with zero fields. Returns 404
    when the chat assistant is not active.
    """
    cfg = load_chat_config(get_config())
    if not cfg.active:
        raise HTTPException(status_code=404, detail="chat assistant is not active")
    user = _chat_user_from_request(request)
    store = _get_chat_history(cfg)
    return store.session_usage(user, session_id)


@app.get("/version", tags=["info"])
async def get_version():
    """Single-shot "what's the current API contract?" probe.

    Designed for LLM clients (vark, Claude bindings, anything that
    caches a generated client against a particular API version): hit
    this on session start, compare ``version`` against your cached
    value, and if it differs re-read ``openapi_url`` to regenerate
    bindings, or ``changelog_url`` to see what changed.

    Response is intentionally small + stable: just the version stamp,
    the recommended antclient pin, pointers to the canonical contract
    surfaces, the list of supported plot geoms, and the list of
    endpoints flagged ``deprecated`` in OpenAPI (so callers prefer
    the non-deprecated alternatives).
    """
    root = str(app.root_path or '')
    # Collect deprecated paths from the OpenAPI spec — single source of truth.
    deprecated = []
    try:
        schema = app.openapi()
        for path, ops in schema.get('paths', {}).items():
            for method, op in ops.items():
                if isinstance(op, dict) and op.get('deprecated'):
                    deprecated.append(f"{method.upper()} {path}")
    except Exception:
        pass
    return {
        "version":              API_VERSION,
        "released":             API_VERSION_RELEASED,
        "compatible_antclient": API_COMPATIBLE_ANTCLIENT,
        "openapi_url":          f"{root}/openapi.json",
        "swagger_ui_url":       f"{root}/docs",
        "redoc_url":            f"{root}/redoc",
        "changelog_url":        f"{root}/changelog",
        "plot_geoms":           sorted(_PLOT_GEOMS),
        "plot_output_formats":  sorted(_PLOT_MIME_TYPES.keys()),
        "deprecated_endpoints": sorted(deprecated),
    }


@app.get("/changelog", tags=["info"])
async def get_changelog():
    """Serve ``doc/API_CHANGELOG.md`` as text/markdown.

    This is the human-readable counterpart to ``/version``: a structured
    history of what changed between API versions, why, and how to
    migrate.  Pair with ``/openapi.json`` (canonical machine contract).
    """
    repo_root = Path(__file__).parent.parent.parent
    changelog_path = repo_root / 'doc' / 'API_CHANGELOG.md'
    if not changelog_path.exists():
        raise HTTPException(
            status_code=404,
            detail="API_CHANGELOG.md not found in the repo (doc/API_CHANGELOG.md).",
        )
    return Response(
        content=changelog_path.read_text(encoding='utf-8'),
        media_type='text/markdown; charset=utf-8',
    )


@app.get("/metrics", tags=["info"])
async def get_metrics():
    """
    Performance metrics endpoint.

    Returns:
    - uptime_seconds
    - requests: total, errors, error_rate (counted from middleware ring,
      excluding /health, /metrics, plot-cache stats)
    - latency_ms: mean / p50 / p95 / p99 / max over the last 1024 non-probe
      requests, plus n_samples.  Use these to compare server speed across
      replicas.
    - connection_pool: hit/miss/in_use stats
    - caches: database/metadata/gene cache sizes
    """
    try:
        pool_stats = connection_pool.get_stats()
        timing = _timing_snapshot()

        return {
            "uptime_seconds": int(registry.get_uptime()),
            "requests": {
                "total":      timing['total'],
                "errors":     timing['errors'],
                "error_rate": timing['errors'] / max(1, timing['total']),
            },
            "latency_ms": {
                "n_samples": timing['n_samples'],
                "mean":      timing['mean_ms'],
                "p50":       timing['p50_ms'],
                "p95":       timing['p95_ms'],
                "p99":       timing['p99_ms'],
                "max":       timing['max_ms'],
            },
            "connection_pool": pool_stats,
            "caches": {
                "databases": len(registry.databases),
                "metadata_cached": len(registry.metadata_cache),
                "gene_lists_cached": len(registry.gene_list_cache),
                "metadata_stats_cached": len(registry.metadata_stats_cache)
            }
        }
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


