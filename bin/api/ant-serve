@app.post("/admin/gene-stats-cache/gc", tags=["admin"])
def gene_stats_cache_gc():
    """Drop cache rows whose fingerprint no longer matches the current dataset state.

    Called rarely — the cache stays correct without it (stale rows are simply
    never re-fetched), but this reclaims space after a bulk ant-convert run.
    """
    keep: Dict[str, str] = {}
    for db_id_inner, meta in registry.metadata_cache.items():
        db_url = registry.databases.get(db_id_inner, '')
        mus_sha = str(meta.get('sha256') or '').strip()
        duckdb_mtime = 0.0
        if not db_url.startswith('s3://'):
            try:
                duckdb_mtime = Path(db_url).stat().st_mtime
            except OSError:
                pass
        fp = GeneStatsCache.fingerprint(mus_sha or None, duckdb_mtime)
        if fp:
            keep[db_id_inner] = fp
    n = registry.gene_stats_cache.gc_stale(keep)
    return {'gc_deleted': n, 'fingerprints_kept': len(keep)}


# ── Genesets ───────────────────────────────────────────────────────────────────

def _require_geneset_registry() -> GenesetRegistry:
    if geneset_registry is None:
        raise HTTPException(status_code=503, detail="Geneset store is not configured")
    return geneset_registry


def _build_score_index() -> None:
    """
    Walk every database in the registry, find columns matching
    <study>::<experiment>::<geneset> in obsnum, and build the bidirectional
    index. Cheap (one information_schema query per db).
    """
    global _score_index_by_db, _score_index_by_geneset, _score_columns
    new_by_db: Dict[str, List[str]] = {}
    new_by_geneset: Dict[str, List[str]] = {}
    new_columns: Dict[Tuple[str, str], str] = {}

    if registry is None:
        return

    for db_id in registry.databases.keys():
        try:
            db_url = registry.get_database_path(db_id)
            conn = connection_pool.get_connection(db_url)
        except Exception as exc:
            log.warning("score-index: skipping %s (open failed: %s)", db_id, exc)
            continue
        try:
            rows = conn.execute("""
                SELECT column_name FROM information_schema.columns
                WHERE table_name = 'obsnum'
            """).fetchall()
            for (col,) in rows:
                geneset_id = parse_score_column(col)
                if not geneset_id:
                    continue
                new_by_db.setdefault(db_id, []).append(geneset_id)
                new_by_geneset.setdefault(geneset_id, []).append(db_id)
                new_columns[(db_id, geneset_id)] = col
        except Exception as exc:
            log.warning("score-index: scan failed for %s: %s", db_id, exc)
        finally:
            try:
                connection_pool.return_connection(db_url, conn)
            except Exception:
                pass

    # Sort for deterministic output
    for ids in new_by_db.values():
        ids.sort()
    for ids in new_by_geneset.values():
        ids.sort()

    _score_index_by_db = new_by_db
    _score_index_by_geneset = new_by_geneset
    _score_columns = new_columns
    log.info(
        "score-index: %d database(s) with scored genesets, %d distinct geneset(s)",
        len(new_by_db), len(new_by_geneset),
    )


def _build_by_gene_index() -> None:
    """Build UPPER(gene) → [{match}] reverse lookup across genesets + starCAT.

    Loads every geneset gene list and the full starCAT weight table once.
    Results are cached in ``_by_gene_index`` and survive until the next
    rescan.  Typical footprint: a few thousand entries × a few dozen matches
    each = well under 50 MB.
    """
    global _by_gene_index
    new_index: Dict[str, List[Dict[str, Any]]] = {}

    # ── genesets ────────────────────────────────────────────────────────
    if geneset_registry is not None:
        for geneset in geneset_registry.genesets.values():
            try:
                gene_list = geneset.genes
            except Exception as exc:
                log.warning("by-gene index: skip geneset %s (%s)", geneset.geneset_id, exc)
                continue
            summary = geneset.to_summary()
            for position, gene_symbol in enumerate(gene_list, start=1):
                key = gene_symbol.upper()
                entry: Dict[str, Any] = {
                    'kind': 'geneset',
                    'study': summary['study'],
                    'experiment': summary['experiment'],
                    'name': summary['name'],
                    'display_name': summary.get('display_name') or summary['name'],
                    'description': summary.get('description', ''),
                    'n_genes': summary['n_genes'],
                    'rank': position,
                    # starCAT-only fields absent here
                    'catalog_id': None,
                    'weight': None,
                }
                new_index.setdefault(key, []).append(entry)

    # ── starCAT ─────────────────────────────────────────────────────────
    try:
        import catalogs as _catalogs_mod  # noqa: PLC0415
        import os
        starcat_root_str = str(_catalogs_mod.DEFAULT_STARCATSTORE_ROOT)
        starcat_catalogs = _catalogs_mod._cached_starcat_catalogs(starcat_root_str)
        for catalog in starcat_catalogs:
            for module in catalog.modules:
                try:
                    weight_map = module.weights()  # Dict[gene, float]
                except Exception as exc:
                    log.warning("by-gene index: skip starcat %s/%s (%s)",
                                catalog.catalog_id, module.name, exc)
                    continue
                if not weight_map:
                    continue
                for gene_symbol, weight in weight_map.items():
                    key = gene_symbol.upper()
                    entry = {
                        'kind': 'starcat_module',
                        'catalog_id': catalog.catalog_id,
                        'name': module.name,
                        'display_name': module.name,
                        'description': module.description,
                        'n_genes': module.n_genes,
                        'weight': weight,
                        'rank': None,
                        # geneset-only fields absent here
                        'study': None,
                        'experiment': None,
                    }
                    new_index.setdefault(key, []).append(entry)
    except Exception as exc:
        log.warning("by-gene index: starCAT scan failed: %s", exc)

    _by_gene_index = new_index
    n_genes = len(new_index)
    n_matches = sum(len(v) for v in new_index.values())
    log.info("by-gene index: %d gene keys, %d total match entries", n_genes, n_matches)


def _annotate_with_scored_in(summary: Dict[str, Any]) -> Dict[str, Any]:
