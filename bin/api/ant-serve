            "Used by the JupyterLite 'open this plot as a notebook' button "
            "to avoid the filename-includes-query-string bug in "
            "jupyterlab-open-url-parameter — a URL with NO query string "
            "lets the extension save the file with a clean basename."
        ),
    ),
    filename: str = FastAPIPath(
        ...,
        description=(
            "The saved filename basename in JupyterLite's in-browser FS "
            "(without the ``.ipynb`` extension). Server ignores it for the "
            "actual response — the b64 blob drives content — but echoes it "
            "back via the URL so JupyterLite's open-url extension saves "
            "the notebook with this name. Must match ``[A-Za-z0-9_-]{1,100}``."
        ),
    ),
    request: Request = None,  # type: ignore[assignment]
):
    """Notebook generator with all plot params encoded as a base64-url-safe
    JSON blob in the URL path, plus a biology-keyed ``filename`` segment
    that JupyterLite uses as the in-browser-FS basename.

    The encoded blob is a JSON object::

        {"db_id": "S25/V6A", "geom": "volcano",
         "study": "DE_…", "term": "Sex_donor", "contrast": "F",
         "log2fc_clip": 3, ...}

    encoded with ``base64.urlsafe_b64encode(json.dumps(params).encode())``
    (Python) or the JS equivalent (``btoa`` with ``+`` → ``-`` and
    ``/`` → ``_``). Trailing ``=`` padding is optional — the decoder is
    tolerant.

    ``filename`` is purely cosmetic (the b64 blob still drives the
    response). Use ``/notebook/{b64params}/meta`` to compute the
    biology-keyed filename before opening JupyterLite, then put that
    filename in this URL — JupyterLite saves the notebook under that
    basename instead of literal ``plot.ipynb``.
    """
    # ``filename`` is cosmetic — the response body is driven entirely by
    # the b64 blob. Validate it just enough to refuse abuse / weird URLs.
    if not _NOTEBOOK_FILENAME_RE.match(filename):
        raise HTTPException(
            400,
            detail=(
                "filename must match [A-Za-z0-9_-]{1,100} (got "
                f"{filename!r})."
            ),
        )
    db_id, geom, params = _decode_b64_notebook_params(b64params)
    return await _build_notebook_response(db_id, geom, params, request)


@app.get(
    "/notebook/{b64params}/meta",
    tags=["plots"],
    response_class=JSONResponse,
)
def plot_notebook_descriptor_endpoint(
    b64params: str = FastAPIPath(
        ...,
        description=(
            "Base64-url-safe-encoded JSON of the plot params (same encoding "
            "as ``/notebook/{b64params}/{filename}.ipynb``)."
        ),
    ),
    request: Request = None,  # type: ignore[assignment]
):
    """Return the biology-keyed title + filename for a notebook URL,
    WITHOUT rendering the plot.

    Used by the web client's "open as notebook" button to pre-compute the
    JupyterLite-FS in-browser filename BEFORE opening JupyterLite, so the
    saved file's basename matches the biology (e.g. ``S25_V6A_scatter_P2RY12``)
    instead of the literal ``plot`` fallback.

    Pure / param-only — no DB I/O. Field-kind resolution against the live
    PlotContext is skipped (kinds default to ``None``) so the descriptor
    output is slightly fuzzier than the full render-time descriptor, but
    still readable and stable. Returns::

        {"title": "S25/V6A: P2RY12 expression on embedding",
         "filename": "S25_V6A_scatter_P2RY12",
         "filename_truncated": false}
    """
    db_id, geom, params = _decode_b64_notebook_params(b64params)
    if geom not in _PLOT_GEOMS:
        raise HTTPException(
            400,
            detail=f"Unknown geom '{geom}'. Valid: {sorted(_PLOT_GEOMS)}",
        )

    # Reuse the same param-folding logic as _build_notebook_response so
    # the descriptor sees the same kwargs the real plot would. We do NOT
    # render — just build a PlotRequest and run the static descriptor.
    try:
        common = _common_plot_params_from_dict(db_id, params, request)
    except HTTPException:
        raise

    plot_kwargs: Dict[str, Any] = {}
    for raw_key, raw_value in params.items():
        if raw_key == 'format':
            continue
        if raw_key in _NOTEBOOK_COMMON_PARAMS:
            continue
        if isinstance(raw_value, str):
            coerced = _coerce_query_value(raw_key, raw_value)
        else:
            coerced = raw_value
        kwarg_name = _NOTEBOOK_PARAM_RENAME.get(raw_key, raw_key)
        plot_kwargs[kwarg_name] = coerced

    import inspect as _inspect
    allowed = set(_inspect.signature(_build_plot_request).parameters.keys())
    plot_kwargs = {k: v for k, v in plot_kwargs.items() if k in allowed}

    try:
        plot_req = _build_plot_request(common, geom, **plot_kwargs)
    except TypeError as exc:
        raise HTTPException(400, detail=f"Bad plot params: {exc}")

    # Static descriptor — no DB context. For scatter/hexbin with no
    # explicit x, the descriptor will say "embedding"; that's the
    # acceptable fallback (kinds aren't resolved here).
    desc = plotting.build_plot_descriptor(**_descriptor_inputs_static(plot_req))
    return JSONResponse(
        content={
            'title':              desc['title'],
            'filename':           desc['filename'],
            'filename_truncated': desc['filename_truncated'] == '1',
        },
        headers={'Cache-Control': 'no-store'},
    )


def _plot_request_force_png(req: PlotRequest) -> PlotRequest:
    """Return a copy of ``req`` with output_format='png'.

    PlotRequest is frozen — we can't mutate; we replace via dataclasses.replace.
    """
    from dataclasses import replace as _dc_replace
    if req.output_format == 'png':
        return req
    return _dc_replace(req, output_format='png')


