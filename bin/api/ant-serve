    }


# ── /facets ──────────────────────────────────────────────────────────
#
# A facet is a standardized ``ant_*`` obs column that appears across
# multiple datasets under a common name (ant_disease, ant_sex, ant_donor,
# ant_braak, ...). The catalog fields (n_cells, n_genes, ...) are NOT
# facets; only obs columns matching the ant_<tag> pattern qualify.
#
# ``/facets`` returns the fleet-wide inventory (one row per distinct
# ant_* column across all datasets). ``/facets/{name}`` returns the
# per-facet detail (dataset list, value distribution, signal strength
# from module_variability.parquet).
#
# Two caches: the inventory (recomputed on rescan of the registry) and a
# per-facet value-distribution cache (recomputed on rescan of the
# registry).

_FACET_INVENTORY_CACHE: Dict[str, Any] = {
    "rows": None,          # list of dicts, or None
    "signature": None,     # (registry cache signature, mv mtime)
}


def _is_facet_column(name: str) -> bool:
    """A facet is an obs column whose name starts with 'ant_'."""
    return isinstance(name, str) and name.startswith('ant_') and len(name) > 4


def _collect_facet_columns_per_dataset() -> Dict[str, Dict[str, str]]:
    """Return {db_id: {facet_name: 'categorical'|'numerical'}}.

    Reads from the cached metadata list so no DuckDB scan is needed.
    """
    result: Dict[str, Dict[str, str]] = {}
    for db in registry.list_databases():
        db_id = db.get('id')
        if not db_id:
            continue
        obs = db.get('obs') or {}
        facets: Dict[str, str] = {}
        for col in obs.get('categorical') or []:
            if _is_facet_column(col):
                facets[col] = 'categorical'
        for col in obs.get('numerical') or []:
            if _is_facet_column(col):
                # In the rare case a facet appears in both, categorical wins.
                facets.setdefault(col, 'numerical')
        if facets:
            result[db_id] = facets
    return result


def _facet_signal_strength_by_name() -> Dict[str, float]:
    """For each ant_* facet name, the max variance-explained ``value`` in
    module_variability across all rows where tag_column == facet. Missing = 0.0.

    Only the scale-invariant [0, 1] variance-explained statistics count as
    signal here (eta2, omega2, R2, |spearman|). Raw F, mean_score, and total_var
    are on unrelated scales and would distort ranking.
    """
    import numpy as _np
    out: Dict[str, float] = {}
    df = _load_module_variability()
    if df is None or df.empty:
        return out
    keep_stats = {'eta2', 'omega2', 'R2', 'spearman'}
    keep_sources = {'geneset', 'ucell'}
    working = df[df['tag_column'].str.startswith('ant_', na=False)]
    working = working[working['statistic'].isin(keep_stats)]
    working = working[working['source'].isin(keep_sources)]
    if working.empty:
        return out
    # Signed spearman contributes symmetrically.
    abs_values = _np.abs(working['value'].astype(float, copy=False).to_numpy())
    finite_mask = _np.isfinite(abs_values)
    working = working.loc[finite_mask].assign(_abs=abs_values[finite_mask])
    if working.empty:
        return out
    grouped = working.groupby('tag_column')['_abs'].max()
    for tag_column, val in grouped.items():
        out[str(tag_column)] = float(val)
    return out


def _build_facet_inventory() -> List[Dict[str, Any]]:
    """One row per distinct ant_* obs column across all datasets."""
    per_dataset = _collect_facet_columns_per_dataset()
    signal = _facet_signal_strength_by_name()

    aggregate: Dict[str, Dict[str, Any]] = {}
    for db_id, facets in per_dataset.items():
        for facet_name, kind in facets.items():
            entry = aggregate.setdefault(facet_name, {
                'facet': facet_name,
                'kinds': set(),  # collected then reduced to type + mixed flag
                'datasets': [],
            })
            entry['kinds'].add(kind)
            entry['datasets'].append(db_id)

    rows: List[Dict[str, Any]] = []
    for facet_name, entry in aggregate.items():
        kinds = entry['kinds']
        if kinds == {'categorical'}:
            type_ = 'categorical'
            mixed = False
        elif kinds == {'numerical'}:
            type_ = 'numerical'
            mixed = False
        else:
            # Majority vote across datasets carrying this facet.
            cat_n = sum(1 for db_id in entry['datasets']
                        if per_dataset[db_id][facet_name] == 'categorical')
            num_n = len(entry['datasets']) - cat_n
            type_ = 'categorical' if cat_n >= num_n else 'numerical'
            mixed = True
        rows.append({
            'facet': facet_name,
            'type': type_,
            'type_mixed': mixed,
            'n_datasets': len(entry['datasets']),
            'signal_strength': float(signal.get(facet_name, 0.0)),
        })

    rows.sort(key=lambda r: (-r['n_datasets'], r['facet']))
    return rows


@app.get("/facets", tags=["facets"])
async def list_facets():
    """Return the fleet-wide inventory of ``ant_*`` facets.

    Response shape::

        {
          "n_facets": int,
          "facets": [
            {
              "facet": "ant_disease",
              "type": "categorical",
              "type_mixed": false,
              "n_datasets": 24,
              "signal_strength": 0.42,
            },
            ...
          ]
        }

    ``signal_strength`` is the max variance-explained ``value`` across all
    rows in ``module_variability.parquet`` where ``tag_column == facet``.
    Zero when the facet has no signal recorded (or when the parquet is
    absent).
    """
    def _sync() -> List[Dict[str, Any]]:
        return _build_facet_inventory()
    rows = await asyncio.to_thread(_sync)
    return {"n_facets": len(rows), "facets": rows}


def _facet_value_distribution(facet_name: str, kind: str,
                              datasets: List[str],
                              per_facet_limit: int = 200) -> Dict[str, Any]:
    """Per-value cell counts + per-dataset carrier counts across datasets.

    Returns::

        {
          "kind": "categorical",
          "values": [{"value": "...", "n_cells": int, "n_datasets": int}, ...],
          "total_cells": int,
        }

    For numerical facets we return a min/max/mean summary per dataset
    plus fleet-wide min/max::

        {
          "kind": "numerical",
          "fleet_min": float, "fleet_max": float,
          "per_dataset": [{"db_id": "...", "min": ..., "max": ..., "mean": ...}, ...],
          "total_cells": int,
        }
    """
    total_cells = 0
    if kind == 'categorical':
        # Aggregate value -> (n_cells across datasets, n_datasets carrying it).
        val_cells: Dict[str, int] = {}
        val_datasets: Dict[str, int] = {}
        for db_id in datasets:
            try:
                with _pooled_db(db_id) as db:
                    conn = db._conn
                    if not _is_facet_column(facet_name):
                        continue
                    ident = safe_ident(facet_name)
                    rows_top = conn.execute(
                        f"SELECT {ident} AS v, COUNT(*) AS n "
                        f"FROM obscat WHERE {ident} IS NOT NULL "
                        f"GROUP BY v ORDER BY n DESC LIMIT ?",
                        [per_facet_limit],
                    ).fetchall()
                    for value, count in rows_top:
                        key = str(value) if value is not None else ''
                        val_cells[key] = val_cells.get(key, 0) + int(count)
                        val_datasets[key] = val_datasets.get(key, 0) + 1
                        total_cells += int(count)
            except Exception:
                # Skip datasets whose duckdb can't be opened or scanned.
                continue
        values = [
            {'value': v, 'n_cells': val_cells[v], 'n_datasets': val_datasets[v]}
            for v in sorted(val_cells, key=lambda k: (-val_cells[k], k))
        ]
        return {
            'kind': 'categorical',
            'values': values,
            'total_cells': total_cells,
        }

    # numerical
    import math as _math
    fleet_min = _math.inf
    fleet_max = -_math.inf
    per_dataset: List[Dict[str, Any]] = []
    for db_id in datasets:
        try:
            with _pooled_db(db_id) as db:
                conn = db._conn
                ident = safe_ident(facet_name)
                row = conn.execute(
                    f"SELECT MIN({ident}), MAX({ident}), AVG({ident}), COUNT({ident}) "
                    f"FROM obsnum WHERE {ident} IS NOT NULL"
                ).fetchone()
                if row is None:
                    continue
                mn, mx, avg, cnt = row
                if mn is None or mx is None or cnt is None or int(cnt) == 0:
                    continue
                mn_f, mx_f = float(mn), float(mx)
                if mn_f < fleet_min:
                    fleet_min = mn_f
                if mx_f > fleet_max:
                    fleet_max = mx_f
                total_cells += int(cnt)
                per_dataset.append({
                    'db_id': db_id,
                    'min': mn_f,
                    'max': mx_f,
                    'mean': float(avg) if avg is not None else None,
                    'n_cells': int(cnt),
                })
        except Exception:
            continue
    return {
        'kind': 'numerical',
        'fleet_min': (None if fleet_min == _math.inf else fleet_min),
        'fleet_max': (None if fleet_max == -_math.inf else fleet_max),
        'per_dataset': per_dataset,
        'total_cells': total_cells,
    }


@app.get("/facets/{facet_name}", tags=["facets"])
async def get_facet_detail(
    facet_name: str,
    top_modules: int = Query(200, ge=1, le=5000, description="Cap on module-variability rows returned."),
    per_facet_value_limit: int = Query(200, ge=1, le=2000, description="Cap on distinct categorical values."),
):
    """Detailed page data for one facet.

    Returns dataset list, value distribution, and the top module-variability
    rows filtered on ``tag_column == facet_name``. See the ``/facets``
    inventory for the list of names.

    404 when the facet name is not present in the catalog.
    """
    if not _is_facet_column(facet_name):
        raise HTTPException(
            status_code=400,
            detail=f"'{facet_name}' is not a facet (must start with 'ant_').",
        )

    per_dataset_kind = _collect_facet_columns_per_dataset()
    dataset_kinds: List[Tuple[str, str]] = [
        (db_id, facets[facet_name])
        for db_id, facets in per_dataset_kind.items()
        if facet_name in facets
    ]
    if not dataset_kinds:
        raise HTTPException(
            status_code=404,
            detail=f"No datasets carry facet '{facet_name}'.",
        )

    # Type is the majority vote across datasets that carry the facet.
    cat_n = sum(1 for _, k in dataset_kinds if k == 'categorical')
    num_n = len(dataset_kinds) - cat_n
    facet_type = 'categorical' if cat_n >= num_n else 'numerical'
    type_mixed = 0 < cat_n < len(dataset_kinds)

    datasets_with_type = [d for d, _ in dataset_kinds]

    # Pull dataset metadata (title, group, n_cells) from the cache.
    dbs_by_id = {d['id']: d for d in registry.list_databases() if d.get('id')}
    dataset_summaries: List[Dict[str, Any]] = []
    total_n_cells = 0
    for db_id, kind in dataset_kinds:
        db = dbs_by_id.get(db_id, {})
        n_cells = int(db.get('n_cells') or 0)
        total_n_cells += n_cells
        collection = db.get('collection') or {}
        dataset_summaries.append({
            'db_id': db_id,
            'title': db.get('title') or db_id,
            'group': collection.get('group') or db.get('group_id'),
            'group_id': db.get('group_id'),
            'file_id': db.get('file_id'),
            'n_cells': n_cells,
            'kind_on_this_dataset': kind,
        })
    dataset_summaries.sort(key=lambda d: (-d['n_cells'], d['db_id']))

    def _sync_distribution() -> Dict[str, Any]:
        return _facet_value_distribution(
            facet_name, facet_type, datasets_with_type,
            per_facet_limit=per_facet_value_limit,
        )
    distribution = await asyncio.to_thread(_sync_distribution)

    # Filter module_variability on tag_column == facet_name. Restrict to the
    # scale-invariant statistics (eta2, omega2, R2, spearman); raw F / mean_score
    # /total_var are on different scales and would drown out real signal in the
    # ranking.
    df = _load_module_variability()
    modules_rows: List[Dict[str, Any]] = []
    n_modules_total = 0
    if df is not None and not df.empty:
        import numpy as _np
        keep_stats = {'eta2', 'omega2', 'R2', 'spearman'}
        keep_sources = {'geneset', 'ucell'}
        slice_ = df[df['tag_column'] == facet_name]
        slice_ = slice_[slice_['statistic'].isin(keep_stats)]
        slice_ = slice_[slice_['source'].isin(keep_sources)]
        if not slice_.empty:
            values = slice_['value'].astype(float, copy=False).to_numpy()
            slice_ = slice_.loc[_np.isfinite(values)]
            n_modules_total = int(len(slice_))
            # Sort by absolute value so signed spearman contributes with sign
            # preserved but ordering reflects strength.
            slice_ = slice_.assign(_abs=_np.abs(
                slice_['value'].astype(float, copy=False).to_numpy()
            ))
            slice_ = slice_.sort_values('_abs', ascending=False).head(top_modules)
            slice_ = slice_.drop(columns=['_abs'])
            modules_rows = slice_.to_dict(orient='records')

    return {
        'facet': facet_name,
        'type': facet_type,
        'type_mixed': type_mixed,
        'n_datasets': len(dataset_kinds),
        'total_n_cells': total_n_cells,
        'datasets': dataset_summaries,
        'value_distribution': distribution,
        'modules': {
            'rows': modules_rows,
            'n_total': n_modules_total,
            'truncated': n_modules_total > len(modules_rows),
        },
    }


# ── gene-variance-by-facet cache ─────────────────────────────────────────────
#
# Small OrderedDict-backed LRU keyed on (db_id, facet, top, fingerprint).
# The fingerprint (duckdb mtime for local, URL for S3) invalidates entries
# the moment the underlying data is rebuilt: the new key simply misses.
# Mirrors the plot cache pattern above so a reader coming from there finds
# familiar shape.

_GENE_VARIANCE_CACHE_MAX_ENTRIES = 128
_gene_variance_cache: "_PlotOrderedDict[Tuple[str, str, int, str], dict]" = _PlotOrderedDict()
_gene_variance_cache_lock = _PlotLock()
_gene_variance_cache_stats = {'hits': 0, 'misses': 0, 'evictions': 0}


def _gene_variance_cache_get(key: Tuple[str, str, int, str]) -> Optional[dict]:
    with _gene_variance_cache_lock:
        entry = _gene_variance_cache.get(key)
        if entry is None:
            _gene_variance_cache_stats['misses'] += 1
            return None
        _gene_variance_cache.move_to_end(key)
        _gene_variance_cache_stats['hits'] += 1
        return entry


def _gene_variance_cache_put(key: Tuple[str, str, int, str], entry: dict) -> None:
    with _gene_variance_cache_lock:
        _gene_variance_cache[key] = entry
        _gene_variance_cache.move_to_end(key)
        while len(_gene_variance_cache) > _GENE_VARIANCE_CACHE_MAX_ENTRIES:
            _gene_variance_cache.popitem(last=False)
            _gene_variance_cache_stats['evictions'] += 1


@app.get("/databases/{db_id:path}/gene-variance-by-facet", tags=["facets"])
async def gene_variance_by_facet(
    db_id: str,
    facet: str = Query(..., description="Name of the ant_* obs column to bucket cells by."),
    top: int = Query(50, ge=1, le=500, description="Number of top-signal genes to return."),
):
    """Rank genes by between-group variance of their mean expression across a facet.

    For one dataset and one ``ant_*`` obs column (categorical or numerical),
    partitions cells into groups, computes the mean layer value per (gene,
    group), and ranks genes by the sample variance of those group means.
    Numerical facets are bucketed into 5 quantile bins (``q1``..``q5``) via
    DuckDB ``NTILE``.

    Parameters
    ----------
    db_id : path
        Composite ``group/file`` dataset identifier.
    facet : str
        Obs column to group by. Must start with ``ant_``.
    top : int
        Cap on returned genes, sorted by signal descending. Default 50, max 500.

    Response
    --------
    ``{db_id, facet, facet_type, layer, n_groups, groups, n_cells_per_group,
    n_genes_returned, genes: [{gene, signal, group_means: {grp: mean}}, ...]}``.
    Genes are ordered by ``signal`` descending. ``signal`` is
    ``VAR_SAMP(mean_over_cells)`` across groups. Groups with fewer than 2
    non-null cells are still returned in group sizes but a gene is only
    included when it has non-zero expression in at least 2 groups.
    """
    if not _is_facet_column(facet):
        raise HTTPException(
            status_code=400,
            detail=f"'{facet}' is not a facet (must start with 'ant_').",
        )

    try:
        meta = registry.get_database_metadata(db_id)
    except KeyError as exc:
        raise HTTPException(status_code=404, detail=str(exc))

    obs = meta.get('obs') or {}
    cat_cols = set(obs.get('categorical') or [])
    num_cols = set(obs.get('numerical') or [])
    if facet in cat_cols:
        facet_type = 'categorical'
    elif facet in num_cols:
        facet_type = 'numerical'
    else:
        raise HTTPException(
            status_code=400,
            detail=f"facet '{facet}' is not present in dataset '{db_id}'.",
        )

    layer = meta.get('default_layer') or 'X'

    try:
        db_url = registry.get_database_path(db_id)
    except KeyError as exc:
        raise HTTPException(status_code=404, detail=str(exc))
    fingerprint = _plot_db_fingerprint(db_url)

    cache_key = (db_id, facet, int(top), fingerprint)
    cached = _gene_variance_cache_get(cache_key)
    if cached is not None:
        return cached

    # Parquet fast-path — the precompute covers all (dataset, facet)
    # triples where the dataset appears in ``gene_stats_index.parquet``
    # (the hot-gene set, task #324). Miss → live compute below.
    variance_index = registry.gene_variance_index
    if variance_index.is_loaded() and variance_index.has_pair(db_id, facet):
        top_rows = variance_index.top_by_facet(db_id, facet, int(top))
        facet_meta = variance_index.facet_metadata(db_id, facet)
        if top_rows is not None and facet_meta is not None:
            # Group sizes were not persisted (we intentionally keep the
            # parquet compact); the endpoint historically reports per-group
            # counts. We can serve the group list without the counts and
            # let clients look them up via `/facet-groups` if needed.
            group_means_union: Dict[str, Any] = {}
            for entry in top_rows:
                for g in entry.get('group_means', {}).keys():
                    group_means_union.setdefault(g, None)
            groups_sorted = sorted(group_means_union.keys())

            result = {
                'db_id':             db_id,
                'facet':             facet,
                'facet_type':        facet_meta['facet_type'] or facet_type,
                'layer':             facet_meta['layer'] or layer,
                'n_groups':          facet_meta['n_groups'] or len(groups_sorted),
                'groups':            groups_sorted,
                # ``n_cells_per_group`` is not stored in the parquet
                # (compactness); leave as an empty dict on the fast path
                # so callers can distinguish "not measured" from a zero.
                'n_cells_per_group': {},
                'n_genes_returned':  len(top_rows),
                'genes':             [
                    {
                        'gene':        entry['gene'],
                        'signal':      entry.get('signal', 0.0) or 0.0,
                        'eta_squared': entry.get('eta_squared'),
                        'F_stat':      entry.get('F_stat'),
                        'total_var':   entry.get('total_var'),
                        'group_means': entry.get('group_means', {}),
                    }
                    for entry in top_rows
                ],
                'served_from':       'parquet',
            }
            _gene_variance_cache_put(cache_key, result)
            return result

    def _sync() -> Dict[str, Any]:
        facet_ident = safe_ident(facet)
        layer_view = safe_ident(f"layer__{layer}")

        with _pooled_db(db_id) as db:
            conn = db._conn

            # The facet name is the *public* obs column (post rename / derive),
            # so we go through the `obscat` / `obsnum` views rather than the
            # underscore tables. These views join on ``cell_name``, so we
            # bridge back to ``cell_id`` via ``__cells`` for the layer join.
            obs_view = safe_ident('obsnum' if facet_type == 'numerical' else 'obscat')

            if facet_type == 'numerical':
                nonnull_row = conn.execute(
                    f"SELECT COUNT(*) FROM {obs_view} WHERE {facet_ident} IS NOT NULL"
                ).fetchone()
                nonnull = int(nonnull_row[0]) if nonnull_row and nonnull_row[0] is not None else 0
                if nonnull == 0:
                    raise HTTPException(
                        status_code=400,
                        detail=f"facet '{facet}' is all-NULL on '{db_id}'.",
                    )
                distinct_row = conn.execute(
                    f"SELECT COUNT(DISTINCT {facet_ident}) FROM {obs_view} WHERE {facet_ident} IS NOT NULL"
                ).fetchone()
                distinct_n = int(distinct_row[0]) if distinct_row and distinct_row[0] is not None else 0
                if distinct_n < 2:
                    raise HTTPException(
                        status_code=400,
                        detail=(
                            f"facet '{facet}' resolves to a single group on '{db_id}'; "
                            "need at least 2 groups for variance."
                        ),
                    )

                group_sizes_sql = f"""
                    WITH binned AS (
                        SELECT cell_name,
                               'q' || CAST(NTILE(5) OVER (ORDER BY {facet_ident}) AS VARCHAR) AS grp
                        FROM {obs_view}
                        WHERE {facet_ident} IS NOT NULL
                    )
                    SELECT grp, COUNT(*) AS n
                    FROM binned
                    GROUP BY grp
                    ORDER BY grp
                """

                main_sql = f"""
                    WITH binned AS (
                        SELECT cell_name,
                               'q' || CAST(NTILE(5) OVER (ORDER BY {facet_ident}) AS VARCHAR) AS grp
                        FROM {obs_view}
                        WHERE {facet_ident} IS NOT NULL
                    ),
                    per_cell AS (
                        SELECT x.gene_name AS gene, x.value AS val, b.grp AS grp
                        FROM {layer_view} x
                        JOIN binned b ON b.cell_name = x.cell_name
                    ),
                    group_means AS (
                        SELECT gene, grp, AVG(val) AS mean, COUNT(*) AS n
                        FROM per_cell
                        GROUP BY gene, grp
                    ),
                    gene_stats AS (
                        SELECT gene, VAR_SAMP(mean) AS signal, COUNT(*) AS n_groups
                        FROM group_means
                        GROUP BY gene
                        HAVING COUNT(*) >= 2
                    ),
                    top_genes AS (
                        SELECT gene, signal FROM gene_stats
                        ORDER BY signal DESC NULLS LAST
                        LIMIT ?
                    )
                    SELECT tg.gene, tg.signal, gm.grp, gm.mean, gm.n
                    FROM top_genes tg
                    JOIN group_means gm ON gm.gene = tg.gene
                    ORDER BY tg.signal DESC, gm.grp
                """
            else:
                nonnull_row = conn.execute(
                    f"SELECT COUNT(*) FROM {obs_view} WHERE {facet_ident} IS NOT NULL"
                ).fetchone()
                nonnull = int(nonnull_row[0]) if nonnull_row and nonnull_row[0] is not None else 0
                if nonnull == 0:
                    raise HTTPException(
                        status_code=400,
                        detail=f"facet '{facet}' is all-NULL on '{db_id}'.",
                    )
                distinct_row = conn.execute(
                    f"SELECT COUNT(DISTINCT {facet_ident}) FROM {obs_view} WHERE {facet_ident} IS NOT NULL"
                ).fetchone()
                distinct_n = int(distinct_row[0]) if distinct_row and distinct_row[0] is not None else 0
                if distinct_n < 2:
                    raise HTTPException(
                        status_code=400,
                        detail=(
                            f"facet '{facet}' resolves to a single group on '{db_id}'; "
                            "need at least 2 groups for variance."
                        ),
                    )

                group_sizes_sql = f"""
                    SELECT CAST({facet_ident} AS VARCHAR) AS grp, COUNT(*) AS n
                    FROM {obs_view}
                    WHERE {facet_ident} IS NOT NULL
                    GROUP BY grp
                    ORDER BY grp
                """

                main_sql = f"""
                    WITH cell_grp AS (
                        SELECT o.cell_name AS cell_name,
                               CAST(o.{facet_ident} AS VARCHAR) AS grp
                        FROM {obs_view} o
                        WHERE o.{facet_ident} IS NOT NULL
                    ),
                    per_cell AS (
                        SELECT x.gene_name AS gene, x.value AS val, cg.grp AS grp
                        FROM {layer_view} x
                        JOIN cell_grp cg ON cg.cell_name = x.cell_name
                    ),
                    group_means AS (
                        SELECT gene, grp, AVG(val) AS mean, COUNT(*) AS n
                        FROM per_cell
                        GROUP BY gene, grp
                    ),
                    gene_stats AS (
                        SELECT gene, VAR_SAMP(mean) AS signal, COUNT(*) AS n_groups
                        FROM group_means
                        GROUP BY gene
                        HAVING COUNT(*) >= 2
                    ),
                    top_genes AS (
                        SELECT gene, signal FROM gene_stats
                        ORDER BY signal DESC NULLS LAST
                        LIMIT ?
                    )
                    SELECT tg.gene, tg.signal, gm.grp, gm.mean, gm.n
                    FROM top_genes tg
                    JOIN group_means gm ON gm.gene = tg.gene
                    ORDER BY tg.signal DESC, gm.grp
                """

            size_rows = conn.execute(group_sizes_sql).fetchall()
            n_cells_per_group = {str(grp): int(n) for grp, n in size_rows}

            rows = conn.execute(main_sql, [int(top)]).fetchall()

        # Pivot to per-gene records preserving signal order.
        gene_order: List[str] = []
        gene_signal: Dict[str, float] = {}
        gene_means: Dict[str, Dict[str, float]] = {}
        for gene, signal, grp, mean, _n in rows:
            if gene not in gene_signal:
                gene_order.append(gene)
                gene_signal[gene] = float(signal) if signal is not None else 0.0
                gene_means[gene] = {}
            gene_means[gene][str(grp)] = float(mean) if mean is not None else 0.0

        genes_payload = [
            {
                'gene': gene,
                'signal': gene_signal[gene],
                'group_means': gene_means[gene],
            }
            for gene in gene_order
        ]

        groups_sorted = sorted(n_cells_per_group.keys())

        return {
            'db_id': db_id,
            'facet': facet,
            'facet_type': facet_type,
            'layer': layer,
            'n_groups': len(groups_sorted),
            'groups': groups_sorted,
            'n_cells_per_group': n_cells_per_group,
            'n_genes_returned': len(genes_payload),
            'genes': genes_payload,
            'served_from': 'live',
        }

    try:
        result = await asyncio.to_thread(_sync)
    except HTTPException:
        raise
    except KeyError as exc:
        raise HTTPException(status_code=404, detail=str(exc))
    except Exception as exc:
        raise HTTPException(status_code=500, detail=f"gene-variance-by-facet failed: {exc}")

    _gene_variance_cache_put(cache_key, result)
    return result


@app.get("/admin/gene-variance-cache/stats", tags=["admin"])
def gene_variance_cache_stats():
    """Return the gene-variance-by-facet cache stats (size / hits / misses)."""
    with _gene_variance_cache_lock:
        size = len(_gene_variance_cache)
    hits = _gene_variance_cache_stats['hits']
    misses = _gene_variance_cache_stats['misses']
    return {
        'size':         size,
        'max_entries':  _GENE_VARIANCE_CACHE_MAX_ENTRIES,
        'hits':         hits,
        'misses':       misses,
        'evictions':    _gene_variance_cache_stats['evictions'],
    }


# ── /catalogs ────────────────────────────────────────────────────────
#
# Cross-source module catalog view. Currently:
#   - `source=geneset`  → the same experiments as /genesets, uniformly
#                          shaped so clients don't have to distinguish.
#   - `source=starcat` → starCAT reference catalogs (e.g. MICROGLIA_V1)
#                          with per-program gene weights, module groups,
#                          and derived score recipes (composite +
#                          binary thresholds + multinomial).
#
# The gene weights come from the raw `.tsv` on disk (rows = programs,
# columns = genes). Loaded lazily per module — full weight matrix isn't
# held in RAM.


def _catalog_source_from_score_column_source(source: str) -> str:
    """Map score-parquet 'source' field to the /catalogs 'source' key.

    Currently 1:1 — 'geneset' → 'geneset', 'starcat' → 'starcat'.
    Kept as an indirection so future score sources plug in without
    refactoring callers.
    """
    return source


def _build_catalog_registry():
    """Return {(source, catalog_id): Catalog}. Rebuilt on rescan."""
    import catalogs as _catalogs_mod   # lazy — keeps startup light
    gs = _require_geneset_registry()
    return _catalogs_mod.build_registry(gs)


@app.get("/catalogs", tags=["genesets"])
def list_catalogs(source: Optional[str] = None):
    """List all module catalogs (geneset + starcat).

    Each entry summarises the catalog (module + score count, gene
    universe size). Use `GET /catalogs/{source}/{catalog_id}` to get
    the module list, and `GET /catalogs/{source}/{catalog_id}/{module}`
    for one module's genes + weights.
    """
    reg = _build_catalog_registry()
    items = list(reg.values())
    if source:
        items = [c for c in items if c.source == source]
    return {
        "count": len(items),
        "catalogs": [c.to_summary() for c in items],
    }


# More-specific routes MUST be declared before the catch-all
# `/catalogs/{source}/{catalog_id:path}` — FastAPI matches by declaration
# order. We support one- and two-segment catalog IDs (starcat catalogs
# have one segment, e.g. MICROGLIA_V1_0; genesets have two, e.g.
# Sierksma2025/WGCNA).

@app.get("/catalogs/{source}/{a}/{b}/modules/{module_name}",
         tags=["genesets"])
def _get_catalog_module_2seg(source: str, a: str, b: str,
                                    module_name: str,
                                    top: Optional[int] = Query(None, ge=1, le=5000)):
    return get_catalog_module(source, f"{a}/{b}", module_name, top)


@app.get("/catalogs/{source}/{a}/{b}/scores/{score_name}",
         tags=["genesets"])
def _get_catalog_score_2seg(source: str, a: str, b: str, score_name: str):
    return get_catalog_score_recipe(source, f"{a}/{b}", score_name)


@app.get("/catalogs/{source}/{catalog_id}/modules/{module_name}",
         tags=["genesets"])
def get_catalog_module(
    source: str, catalog_id: str, module_name: str,
    top: Optional[int] = Query(None, ge=1, le=5000,
                               description="If set, return only the top-N genes by absolute weight (starcat) or first-N (geneset)."),
):
    """One module — full gene list ± weights.

    For starcat catalogs the response includes:
      - `weights`: dict {gene: weight}
      - `top_genes`: list of {gene, weight, rank} (ranked by |weight|)
      - `group`: module grouping (identity / states / activation / ...)

    For geneset catalogs (`source=geneset`) weights are None and the
    plain gene list is returned in `genes` / `top_genes`.
    """
    reg = _build_catalog_registry()
    cat = reg.get((source, catalog_id))
    if cat is None:
        raise HTTPException(status_code=404,
                            detail=f"catalog {source!r} / {catalog_id!r} not found")
    mod = cat.get_module(module_name)
    if mod is None:
        raise HTTPException(status_code=404,
                            detail=f"module {module_name!r} not in catalog {catalog_id!r}")
    weights = mod.weights()
    tops = mod.top_genes(top or 30)
    out = {
        **mod.to_summary(),
        "top_genes": [
            {"gene": g, "weight": w, "rank": i + 1}
            for i, (g, w) in enumerate(tops)
        ],
    }
    if weights is not None and (top is None or top >= len(weights)):
        # Only ship the full weight map when the caller didn't ask for
        # a top-N slice, or when the requested top-N covers everything.
        out["weights"] = weights
    return out


@app.get("/catalogs/{source}/{catalog_id}/scores/{score_name}",
         tags=["genesets"])
def get_catalog_score_recipe(source: str, catalog_id: str,
                                    score_name: str):
    """Return one derived score recipe (composite / binary / multinomial).

    Lets callers reproduce the score client-side, or explain what a
    binary `Border_CAM_pos` column actually means — it's `usage of
    Microglia_Border_CAM > threshold` (threshold in the response).
    """
    reg = _build_catalog_registry()
    cat = reg.get((source, catalog_id))
    if cat is None:
        raise HTTPException(status_code=404,
                            detail=f"catalog {source!r} / {catalog_id!r} not found")
    score = next((s for s in cat.scores if s.name == score_name), None)
    if score is None:
        raise HTTPException(status_code=404,
                            detail=f"score {score_name!r} not in catalog {catalog_id!r}")
    return score.to_dict()


@app.post("/catalogs/rescan", tags=["genesets"])
def rescan_catalogs():
    """Invalidate the starCAT + geneset catalog cache — reloads from disk."""
    import catalogs as _catalogs_mod
    _catalogs_mod._cached_starcat_catalogs.cache_clear()
    reg = _build_catalog_registry()
    return {"count": len(reg),
            "catalogs": [c.to_summary() for c in reg.values()]}


# `get_catalog` (below) is the catch-all `{catalog_id:path}` route.
# Declared LAST so the more-specific `/modules/{name}` and
# `/scores/{name}` routes above take priority.

@app.get("/catalogs/{source}/{catalog_id:path}", tags=["genesets"])
def get_catalog(source: str, catalog_id: str):
    """One catalog — module summaries + score recipes + metadata.

    `catalog_id` uses a path-style key: for geneset it's
    `study/experiment` (e.g. `Sierksma2025/WGCNA`); for starcat it's
    the file stem (e.g. `MICROGLIA_V1_0`).
    """
    reg = _build_catalog_registry()
    cat = reg.get((source, catalog_id))
    if cat is None:
        raise HTTPException(
            status_code=404,
            detail=f"catalog {source!r} / {catalog_id!r} not found",
        )
    return {
        **cat.to_summary(),
        "modules": [m.to_summary() for m in cat.modules],
        "scores":  [s.to_dict() for s in cat.scores],
    }


@app.get("/databases/{db_id:path}/module_scores", tags=["databases"])
def get_database_module_scores(db_id: str):
    """List all pre-computed module-score columns for one dataset.

    For each scored geneset, returns:
      - geneset_id        canonical geneset id (study/experiment/name)
      - column_name       obs/duckdb column where the score is stored
      - geneset_known     True if the geneset is in the registered genesetstore
      - method            (if known)
      - description       (if known)
      - n_genes           (if known)
      - stats             {min, max, mean, std, median}  computed from the column

    Use the resulting column names directly in analytics_query, e.g.:
        SELECT cell_name, "Sierksma2025::WGCNA::Brown_Lysosome"
        FROM   obsnum
    """
    if registry is None or db_id not in registry.databases:
        raise HTTPException(status_code=404, detail=f"Database not found: {db_id}")

    db_url = registry.get_database_path(db_id)
    conn = connection_pool.get_connection(db_url)
    try:
        cols = conn.execute("""
            SELECT column_name FROM information_schema.columns
            WHERE table_name = 'obsnum'
        """).fetchall()
        score_cols = [c[0] for c in cols if is_score_column(c[0])]

        out = []
        gset_reg = geneset_registry  # may be None if store not configured
        for col in sorted(score_cols):
            geneset_id = parse_score_column(col)
            row = {
                "geneset_id":   geneset_id,
                "column_name":  col,
                "geneset_known": False,
                "method":       None,
                "description":  None,
                "n_genes":      None,
                "stats":        None,
            }
            if gset_reg is not None:
                gs = gset_reg.get(geneset_id)
                if gs is not None:
                    row["geneset_known"] = True
                    row["method"]       = gs.experiment.method
                    row["description"]  = gs.metadata.get('description') or ''
                    row["n_genes"]      = gs.n_genes
            try:
                # safe_ident() validates against [A-Za-z0-9_:.\- ] and quotes
                # — defends against a crafted column name (`"); DROP …`) even
                # though the connection is read-only.
                qcol = safe_ident(col)
                stats_row = conn.execute(f"""
                    SELECT
                      COUNT(*) AS n,
                      MIN({qcol}) AS min,
                      MAX({qcol}) AS max,
                      AVG({qcol}) AS mean,
                      STDDEV({qcol}) AS std,
                      MEDIAN({qcol}) AS median
                    FROM __obsnum
                """).fetchone()
                if stats_row is not None:
                    n, mn, mx, mean, std, med = stats_row
                    row["stats"] = {
                        "n":      int(n) if n is not None else None,
                        "min":    float(mn)   if mn   is not None else None,
                        "max":    float(mx)   if mx   is not None else None,
                        "mean":   float(mean) if mean is not None else None,
                        "std":    float(std)  if std  is not None else None,
                        "median": float(med)  if med  is not None else None,
                    }
            except Exception as exc:
                row["stats"] = {"error": str(exc)}
            out.append(row)
    finally:
        connection_pool.return_connection(db_url, conn)

    return {
        "db_id": db_id,
        "count": len(out),
        "column_naming": {
            "separator": SCORE_COLUMN_SEPARATOR,
            "template":  SCORE_COLUMN_TEMPLATE,
        },
        "scored_genesets": out,
    }


@app.get("/databases/{db_id:path}/files", tags=["databases"])
def list_database_files(db_id: str):
    """List downloadable stored ("static") artifacts for one dataset — the raw
    ``.h5ad``, the served ``.duckdb``, and sidecars (``.scores.parquet``,
    ``.h5ad.mus``) that actually exist. Available to anyone who can see the
    dataset (download == catalog visibility). Each entry:
    ``{kind, filename, size_bytes, source}`` where source is ``s3`` | ``local``.
    """
    if registry is None or db_id not in registry.databases:
        raise HTTPException(status_code=404, detail=f"Database not found: {db_id}")
    return {"db_id": db_id, "files": registry.list_artifacts(db_id)}


@app.get("/databases/{db_id:path}/download/{kind}", tags=["databases"])
def download_database_file(db_id: str, kind: str):
    """Download one stored artifact.

    Only ``kind='h5ad'`` is served — the ``.duckdb``, ``.scores.parquet``, and
    ``.h5ad.mus`` sidecars are internal / derived and are deliberately NOT
    exposed to any API consumer (web, vark, pyvark).

    S3-backed objects 307-redirect to a short-lived (5 min) presigned URL so
    the browser pulls straight from object storage (no multi-GB proxy through
    the server); local-only objects stream via FileResponse. Gate == catalog
    visibility: any dataset the caller can see is downloadable.
    """
    if registry is None or db_id not in registry.databases:
        raise HTTPException(status_code=404, detail=f"Database not found: {db_id}")
    resolved = registry.artifact_download(db_id, kind)
    if resolved is None:
        raise HTTPException(status_code=404,
                            detail=f"No '{kind}' file available for {db_id}")
    from fastapi.responses import FileResponse, RedirectResponse  # noqa: PLC0415
    source, target, filename = resolved
    if source == 's3':
        return RedirectResponse(url=target, status_code=307)
    return FileResponse(str(target), filename=filename,
                        media_type='application/octet-stream')


@app.get("/databases/{db_id:path}/download-static/{filename}", tags=["databases"])
def download_database_static_file(db_id: str, filename: str):
    """Download one file from the collection's ``static/`` folder.

    Paper PDFs and supplementary tables shipped with the collection. Path-
    traversal safe: ``filename`` must be a plain basename resolved inside
    ``<data_folder>/<group>/static/``. Gate == catalog visibility.
    """
    if registry is None or db_id not in registry.databases:
        raise HTTPException(status_code=404, detail=f"Database not found: {db_id}")
    target = registry.static_file_download(db_id, filename)
    if target is None:
        raise HTTPException(status_code=404,
                            detail=f"No static file '{filename}' for {db_id}")
    from fastapi.responses import FileResponse  # noqa: PLC0415
    return FileResponse(str(target), filename=target.name,
                        media_type='application/octet-stream')


@app.get("/skill", tags=["info"], response_class=Response)
def get_skill():
    """Return the Anthive Claude Code skill file (SKILL.md).

    Collaborators can install it with:
        curl -n https://anthive.example.org/api/skill -o ~/.claude/skills/anthive/SKILL.md
    """
    skill_path = script_dir.parent / ".claude" / "skills" / "anthive" / "SKILL.md"
    if not skill_path.exists():
        raise HTTPException(status_code=404, detail="SKILL.md not found")
    return Response(
        content=skill_path.read_text(),
        media_type="text/markdown",
        headers={"Content-Disposition": "inline; filename=SKILL.md"},
    )


def main():
    """Main entry point"""
    parser = argparse.ArgumentParser(
        description="Anthive REST API Server",
        formatter_class=argparse.RawDescriptionHelpFormatter
    )

    # Get config for defaults
    config = get_config()

    parser.add_argument(
        '--data-folder',
        type=Path,
        default=get_data_folder(config),
        help='Path to the h5adstore (default: h5adstore key / ANTHIVE_H5ADSTORE)'
    )
    parser.add_argument(
        '--host',
        default=config.get('rest_api_host', '127.0.0.1'),
        help='Host to bind to (default: from config or 127.0.0.1)'
    )
    parser.add_argument(
        '--port',
        type=int,
        default=config.get('rest_api_port', 8000),
        help='Port to bind to (default: from config or 8000)'
    )
    parser.add_argument(
        '--reload',
        action='store_true',
        help='Enable auto-reload for development'
    )

    args = parser.parse_args()

    auth_mode = get_auth_settings(config)['mode']
    if auth_mode == 'none':
        banner = '!' * 72
        print(f"{banner}\n  auth.mode = none: NO LOGIN. Every visitor can read every dataset\n"
              f"  this server exposes. Admin features (editors, viz, rescans) are OFF.\n"
              f"  Only use this for a public read-only mirror or a loopback-only box.\n"
              f"{banner}", file=sys.stderr, flush=True)

    # Initialize global connection pool and registry (Phase 2)
    global registry, connection_pool, geneset_registry
    s3_config = config.get('s3') or {}
    try:
        print("Initializing connection pool...")
        connection_pool = ConnectionPool(
            s3_config=s3_config,
            threads=config.get('duckdb_server_threads', 8),
            memory_limit=str(config.get('duckdb_server_memory_limit', 'auto')),
            temp_directory=str(get_duckdb_temp_dir(config)),
            allowed_directories=[str(args.data_folder)] + list(config.get('duckdb_allowed_directories') or []),
            max_open_databases=config.get('duckdb_max_open_databases', 48),
        )
        print("Initializing database registry...")
        registry = DatabaseRegistry(args.data_folder, connection_pool, s3_config=s3_config)
    except FileNotFoundError as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)

    if len(registry.databases) == 0:
        print(f"Warning: No databases found in {args.data_folder}")
        print("The server will start but no databases will be available.")

    # Initialize geneset registry (optional)
    # Repo root is two levels up: bin/api/ant-serve → bin/api/ → bin/ → repo
    # (was `script_dir.parent` pre-2026-06 reorg, when ant-serve lived in bin/).
    geneset_store_value = config.get('geneset_store')
    if geneset_store_value:
        geneset_path = (script_dir.parent.parent / geneset_store_value).resolve()
        if geneset_path.exists():
            print(f"Initializing geneset registry: {geneset_path}")
            geneset_registry = GenesetRegistry(geneset_path)
            geneset_registry.scan()
            print(
                f"  {len(geneset_registry.experiments)} experiment(s), "
                f"{len(geneset_registry.genesets)} geneset(s)"
            )
            if geneset_registry.errors:
                print(f"  ⚠ {len(geneset_registry.errors)} parse error(s)")
        else:
            print(f"Geneset store path does not exist: {geneset_path} (skipping)")

    # Run md-check on the data folder (read-only: report only, never modify)
    print("\nRunning md-check on data folder...")
    try:
        from md_check import MdCheckReport, check_md_folder, write_log_entry
        md_report = MdCheckReport()
        check_md_folder(Path(args.data_folder), md_report, fix=False)
        print(
            f"  Checked {md_report.checked} .md file(s): "
            f"{md_report.index_count} index.md, {md_report.data_count} data .md"
        )
        if md_report.has_errors() or md_report.has_warnings():
            md_report.print_summary()
            log_messages = md_report.collect_log_messages()
            if log_messages:
                write_log_entry(
                    Path(args.data_folder), 'ant-serve md-check', log_messages
                )
        else:
            print("  ✓ All .md files OK")
    except Exception as e:
        print(f"  ⚠ md-check failed: {e}")

    # Start server
    print(f"\n{'='*60}")
    print(f"Starting Anthive REST API Server")
    print(f"{'='*60}")
    print(f"  Version: {API_VERSION}")
    print(f"  Host: {args.host}")
    print(f"  Port: {args.port}")
    print(f"  Data folder: {args.data_folder}")
    print(f"  Databases: {len(registry.databases)}")
    print(f"  URL: http://{args.host}:{args.port}")
    print(f"  Docs: http://{args.host}:{args.port}/docs")
    print(f"{'='*60}\n")

    uvicorn.run(
        app,
        host=args.host,
        port=args.port,
        reload=args.reload
    )


if __name__ == '__main__':
    main()
