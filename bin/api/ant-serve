def _resolve_collection_dir(group_id: str) -> Tuple[Optional[Path], Optional[str]]:
    """Locate the data_folder/<group>/ directory that owns this group_id.

    Returns (path, group_name). When no existing folder claims the
    group_id, returns (None, None) — the caller decides whether to
    create a new folder (PUT) or report missing (GET shape).
    """
    from metadata import parse_md_file  # noqa: PLC0415  — local to skip on cold paths
    root = registry.data_folder
    for index_path in sorted(root.glob('*/index.md')):
        try:
            meta, _ = parse_md_file(index_path)
        except Exception:
            continue
        if str(meta.get('group_id') or '').strip() == group_id:
            return index_path.parent, str(meta.get('group') or index_path.parent.name)
    return None, None


@app.get("/collections/{group_id}/source", tags=["collections"])
def get_collection_source(group_id: str, request: Request):
    """Read a collection's ``index.md`` for the admin editor.

    Returns ``{exists, group, group_id, frontmatter, body}``. When no
    index.md exists for this group_id, ``exists=False`` and
    ``frontmatter`` carries sane defaults (group, group_id, year). Never
    returns 404 for a missing file — the editor can create one via PUT.
    """
    _require_admin(request)
    from metadata import parse_md_file  # noqa: PLC0415
    import datetime as _dt  # noqa: PLC0415

    folder, group_name = _resolve_collection_dir(group_id)
    if folder is None:
        # No existing folder claims this group_id. Return a skeleton so
        # the editor can populate + create on PUT.
        return {
            'exists': False,
            'group': group_id,        # fallback display name
            'group_id': group_id,
            'frontmatter': {
                'group': group_id,
                'group_id': group_id,
                'year': _dt.datetime.now().year,
            },
            'body': '',
        }

    index_path = folder / 'index.md'
    if not index_path.is_file():
        return {
            'exists': False,
            'group': group_name or folder.name,
            'group_id': group_id,
            'frontmatter': {
                'group': group_name or folder.name,
                'group_id': group_id,
                'year': _dt.datetime.now().year,
            },
            'body': '',
        }
    try:
        meta, body = parse_md_file(index_path)
    except Exception as exc:
        raise HTTPException(status_code=500,
                            detail=f"failed to parse {index_path}: {exc}")
    return {
        'exists': True,
        'group': str(meta.get('group') or folder.name),
        'group_id': group_id,
        'frontmatter': meta,
        'body': body or '',
    }


class CollectionSourceBody(BaseModel):
    frontmatter: Dict[str, Any]
    body: str = ''


@app.put("/collections/{group_id}/source", tags=["collections"])
def put_collection_source(
    group_id: str,
    payload: CollectionSourceBody,
    request: Request,
):
    """Write a collection's ``index.md``. Creates folder + file if missing.

    The full frontmatter dict the client sends is written as the YAML
    block — unknown / complex keys (e.g. ``annotation: {...}``) are
    preserved verbatim, since the client roundtrips them. The data
    h5adstore is a git repo and this endpoint does NOT commit; the
    admin runs git themselves after a save batch.
    """
    _require_admin(request)
    from metadata import write_md_file  # noqa: PLC0415

    fm = dict(payload.frontmatter or {})
    # Lock both identity fields server-side (per pika #260 — defense-
    # in-depth, even though the editor UI also keeps them read-only):
    #   - group_id    → URL value
    #   - group       → existing file's value when the collection exists;
    #                   on creation falls back to the client's group OR
    #                   the URL group_id.
    fm['group_id'] = group_id
    body = payload.body or ''

    folder, existing_group_name = _resolve_collection_dir(group_id)
    if folder is None:
        # New collection — folder name comes from fm['group'] when
        # provided, else the group_id itself. We never let it leave
        # the data_folder root.
        new_name = str(fm.get('group') or group_id).strip()
        if (not new_name or '/' in new_name or new_name.startswith('.')
                or new_name.startswith('_')):
            raise HTTPException(
                status_code=400,
                detail=(f"refusing to create folder for group_id={group_id!r}: "
                        f"frontmatter.group={new_name!r} is not a safe folder name."),
            )
        folder = registry.data_folder / new_name
        folder.mkdir(parents=True, exist_ok=True)
        # Lock 'group' to what we just created so the value in the file
        # matches the directory name we'll never rename.
        fm['group'] = new_name
    else:
        # Existing collection: 'group' is read-only — force it back to
        # whatever's in the existing file (or fall back to the folder
        # name). The client's value is intentionally ignored.
        fm['group'] = existing_group_name or folder.name

    index_path = folder / 'index.md'
    try:
        write_md_file(index_path, fm, body)
    except Exception as exc:
        raise HTTPException(status_code=500,
                            detail=f"failed to write {index_path}: {exc}")

    # Refresh the in-memory metadata cache for every dataset that lives
    # under this collection folder. The dataset payload embeds the
    # collection block (citation, authors, description body) from this
    # index.md, so a write here must invalidate those cached entries too.
    try:
        touched = 0
        for db_id_i, extra in list(registry._db_extra.items()):
            rel_path = extra.get('rel_path') or ''
            if rel_path and Path(rel_path).parts[:1] == (folder.name,):
                registry.metadata_cache[db_id_i] = (
                    registry._load_database_metadata(db_id_i, extra)
                )
                touched += 1
        registry._databases_list_cache = None
        log.info("collection PUT source: refreshed %d dataset cache entries "
                 "under %s", touched, folder.name)
    except Exception as exc:
        log.warning("collection PUT source: cache refresh failed for %s: %s",
                    group_id, exc)

    rel = index_path.relative_to(registry.data_folder)
    return {'ok': True, 'path': str(rel)}


# ── Dataset (.md) editor ──────────────────────────────────────────────────────
#
# Sibling pair of the collection endpoints above. Per anthive-web pika #263 /
# #264 — Mark's lean dataset editor needs admin-gated GET + PUT on the
# per-dataset .md frontmatter. Read/write is straightforward; the catch is
# server-side READ-ONLY ENFORCEMENT — most fields are machine-computed and
# must not be mutable through this endpoint (sha256/n_obs/etc define dataset
# integrity).

# Fields the editor is allowed to change. Everything else: locked to the
# existing file's value on PUT (or dropped on creation when missing).
_DATASET_EDITABLE_FIELDS: Set[str] = {
    'title', 'description', 'year',
    'top_genes', 'top_cat', 'top_num',
    'is_secondary',
    # Curator-controlled layer visibility. layer_stats stays locked (machine
    # computed union of all layers); layers_include/exclude decide which of
    # those layers are actually served through /info + plot endpoints.
    'layers_include', 'layers_exclude',
}

# Machine fields that define identity / integrity / layer schema. PUT MUST
# preserve these from the existing file regardless of what the client sends.
_DATASET_LOCKED_FIELDS: Set[str] = {
    'id', 'version', 'sha256', 'date',
    'n_obs', 'n_vars',
    'layer_stats', 'layer_description',
    'embedding_description', 'default_layer',
    'obscat_include', 'obsnum_include',
    'obscat_exclude', 'obsnum_exclude',
}


def _resolve_dataset_md_path(db_id: str) -> Tuple[Optional[Path], Optional[str], Optional[str]]:
    """Locate the .md file owning ``db_id`` (group_id/file_id form).

    Returns (md_path, group_id, file_id). Falls back to (None, group, file)
    when no existing dataset claims the id — the PUT path needs that to
    decide whether to create.
    """
    from h5adstore import find_h5ad  # noqa: PLC0415
    entry = find_h5ad(registry.data_folder, db_id)
    if entry is None:
        # Split for the not-found case so the caller can still construct a
        # sane skeleton response on GET.
        parts = db_id.split('/', 1)
        return None, parts[0] if parts else db_id, parts[1] if len(parts) > 1 else ''
    return entry.md_path, entry.group_id, entry.file_id


@app.get("/databases/{db_id:path}/source", tags=["databases"])
def get_dataset_source(db_id: str, request: Request):
    """Read a dataset's ``.md`` for the admin editor (admin-gated).

    Returns ``{exists, db_id, frontmatter, body}``. Non-existent dataset
    returns ``exists=false`` (NOT 404) with a skeleton frontmatter carrying
    at least ``id`` derived from the URL — the editor can populate the
    rest and create on PUT (though create-from-zero is unusual; most
    edits target an existing dataset already in the catalog).
    """
    _require_admin(request)
    from metadata import parse_md_file  # noqa: PLC0415

    md_path, group_id, file_id = _resolve_dataset_md_path(db_id)
    if md_path is None or not md_path.is_file():
        # Skeleton response — keep it minimal; the editor barely creates
        # datasets from scratch (.h5ad has to exist first), this branch
        # is mostly for typo'd db_ids.
        return {
            'exists': False,
            'db_id': db_id,
            'frontmatter': {'id': file_id or db_id},
            'body': '',
        }
    try:
        fm, body = parse_md_file(md_path)
    except Exception as exc:
        raise HTTPException(status_code=500,
                            detail=f"failed to parse {md_path}: {exc}")
    return {
        'exists': True,
        'db_id': db_id,
        'frontmatter': fm,
        'body': body or '',
    }


class DatasetSourceBody(BaseModel):
    frontmatter: Dict[str, Any]
    body: str = ''


@app.put("/databases/{db_id:path}/source", tags=["databases"])
def put_dataset_source(
    db_id: str,
    payload: DatasetSourceBody,
    request: Request,
):
    """Write a dataset's ``.md``, with strict server-side field-level locks.

    Read-only / machine-computed fields (id, sha256, n_obs, layer_stats, …)
    are taken from the EXISTING file and forced into the written
    frontmatter regardless of what the client sends. The deprecated
    ``annotation`` block is preserved verbatim from the existing file (or
    dropped if absent). Only the editor's whitelist
    (``_DATASET_EDITABLE_FIELDS``) may be set from client input.

    Refuses to create a brand-new .md from this endpoint — there must
    be an existing dataset (a real .h5ad on disk) for write to succeed.
    Creating a dataset from zero is an ingest concern (ant-ingest /
    ant-convert), not a metadata-editor one.
    """
    _require_admin(request)
    from metadata import parse_md_file, write_md_file  # noqa: PLC0415

    md_path, _gid, _fid = _resolve_dataset_md_path(db_id)
    if md_path is None or not md_path.is_file():
        raise HTTPException(
            status_code=404,
            detail=(f"no .md exists for db_id={db_id!r}; the dataset editor "
                    f"only edits existing datasets — use the ingest pipeline "
                    f"(ant-ingest / ant-convert) to create new ones."),
        )

    try:
        existing_fm, _existing_body = parse_md_file(md_path)
    except Exception as exc:
        raise HTTPException(status_code=500,
                            detail=f"failed to parse {md_path}: {exc}")

    client_fm = dict(payload.frontmatter or {})

    # Start from the existing frontmatter (preserves every key — locked,
    # unknown, deprecated) byte-for-byte. Then overlay ONLY the whitelist
    # of editable fields from the client. This is "verbatim preserve +
    # selective overlay" rather than "client-wins" — exactly the
    # locked-fields contract from pika #263.
    new_fm = dict(existing_fm)
    overlay_fields = []
    for key in _DATASET_EDITABLE_FIELDS:
        if key in client_fm:
            new_fm[key] = client_fm[key]
            overlay_fields.append(key)

    # Defense-in-depth: if the client tried to send any locked field with
    # a different value, log it (the verbatim preserve above already
    # guarantees the existing value wins, so no behavioural effect — but
    # surfacing the attempt in the audit log is useful).
    if log is not None:
        for key in _DATASET_LOCKED_FIELDS:
            if key in client_fm and client_fm[key] != existing_fm.get(key):
                log.warning(
                    "dataset edit: client tried to mutate locked field "
                    "%r on %s (ignored; kept existing value)",
                    key, db_id,
                )

    try:
        write_md_file(md_path, new_fm, payload.body or '')
    except Exception as exc:
        raise HTTPException(status_code=500,
                            detail=f"failed to write {md_path}: {exc}")

    # Refresh the in-memory metadata cache so /info reflects the edit
    # immediately (without waiting for a restart or /admin/rescan). Same
    # pattern used by /admin/refresh-views. Failure here is soft; the file
    # is already on disk and the next restart will pick it up.
    try:
        extra = registry._db_extra.get(db_id, {})
        registry.metadata_cache[db_id] = registry._load_database_metadata(db_id, extra)
        registry._databases_list_cache = None
    except Exception as exc:
        log.warning("dataset PUT source: cache refresh failed for %s: %s",
                    db_id, exc)

    rel = md_path.relative_to(registry.data_folder)
    return {
        'ok': True,
        'path': str(rel),
        'overlaid_fields': overlay_fields,
    }


# ── .h5ad.mus sidecar editor (admin-only) ────────────────────────────────────
#
# Sibling pair to /databases/{db_id}/source — same shape, same admin
# gate. Edits the PER-DATASET .h5ad.mus sidecar (NOT the .env cascade).
# Editor uses this to apply curation proposals against fields like
# cell_type, organism, tissue, disease, suspension_type, technology —
# anthive-web pika 2026-06-28 #260 → #263.
#
# Vocab gate: every field with a controlled vocabulary (via
# lib.mus.is_controlled() + validate_value()) is checked before write.
# Hallucinated values from the LLM curator can't land here even if
# the editor passes them through.

# Fields locked from client edits on the .mus side: machine-generated
# identity / integrity / timestamp keys that this endpoint must
# preserve verbatim.
_MUS_LOCKED_FIELDS: Set[str] = {
    'sha256', 'created', 'updated',
}


@app.get("/databases/{db_id:path}/source.mus", tags=["databases"])
def get_dataset_mus_source(db_id: str, request: Request):
    """Read a dataset's per-dataset ``.h5ad.mus`` sidecar.

    Returns the PER-DATASET fields (what's literally in the sidecar
    file) AND the cascade-RESOLVED view (per-dataset + folder-level
    .env cascade). The editor uses ``fields`` to show what the user
    can directly edit and ``resolved`` to show the effective value
    (incl. inherited-from-folder).

    Missing sidecar → ``exists: false`` with empty fields. Never 404
    on the existence axis.
    """
    _require_admin(request)
    from h5adstore import find_h5ad   # noqa: PLC0415
    from mus import parse_mus_file, read_cascade, sidecar_path  # noqa: PLC0415

    entry = find_h5ad(registry.data_folder, db_id)
    if entry is None:
        raise HTTPException(status_code=404, detail=f"unknown db_id {db_id!r}")
    mus_path = sidecar_path(entry.h5ad_path)
    direct_fields = parse_mus_file(mus_path)
    # Cascade-resolved (per-dataset overlays the folder .env cascade).
    cascade = read_cascade(entry.h5ad_path.parent, root=registry.data_folder)
    resolved = dict(cascade)
    resolved.update(direct_fields)
    rel = mus_path.relative_to(registry.data_folder) if mus_path.is_absolute() and registry.data_folder in mus_path.parents else mus_path.name
    return {
        'exists': mus_path.is_file(),
        'db_id': entry.db_id,
        'path': str(rel),
        'fields': direct_fields,
        'resolved': resolved,
    }


class DatasetMusBody(BaseModel):
    fields: Dict[str, Any]


@app.put("/databases/{db_id:path}/source.mus", tags=["databases"])
def put_dataset_mus_source(
    db_id: str,
    payload: DatasetMusBody,
    request: Request,
):
    """Write a dataset's ``.h5ad.mus`` sidecar.

    Mechanics (mirrors the .md editor's verbatim-preserve + selective-
    overlay contract — pika #260):

      1. Read existing per-dataset .h5ad.mus into a dict.
      2. Force machine fields (sha256/created/updated) back to their
         existing values — the client cannot mutate them. ``updated``
         is bumped to NOW server-side so downstream tooling can tell
         "the curator touched this".
      3. Vocab-gate every client field via lib.mus.validate_value().
         Any controlled field with an out-of-vocab value rejects the
         whole write with 400 + the list of bad fields.
      4. Overlay the client fields onto the existing dict.
      5. Write atomically via ``write_mus_file``.

    Returns {ok, path, written_fields}.
    """
    _require_admin(request)
    from h5adstore import find_h5ad   # noqa: PLC0415
    from mus import (   # noqa: PLC0415
        parse_mus_file, sidecar_path, write_mus_file,
        is_controlled, validate_value, _as_list,
    )
    import datetime as _dt  # noqa: PLC0415

    entry = find_h5ad(registry.data_folder, db_id)
    if entry is None:
        raise HTTPException(status_code=404, detail=f"unknown db_id {db_id!r}")
    mus_path = sidecar_path(entry.h5ad_path)
    existing = parse_mus_file(mus_path) if mus_path.is_file() else {}

    client_fields = dict(payload.fields or {})

    # Strip locked fields from client input — log the attempt.
    for key in list(client_fields.keys()):
        if key in _MUS_LOCKED_FIELDS:
            client_value = client_fields.pop(key)
            existing_value = existing.get(key)
            if client_value != existing_value and log is not None:
                log.warning(
                    "dataset .mus edit: client tried to mutate locked field "
                    "%r on %s (ignored; kept %r)",
                    key, db_id, existing_value,
                )

    # Vocab gate. For controlled fields, every list item must be in vocab.
    invalid: list = []
    for key, value in client_fields.items():
        if not is_controlled(key):
            continue
        for item in _as_list(value):
            item_str = str(item)
            if not validate_value(key, item_str):
                invalid.append(f"{key}={item_str!r}")
    if invalid:
        raise HTTPException(
            status_code=400,
            detail=(f"mus vocab gate refused {len(invalid)} field value(s) — "
                    f"not in the controlled vocabulary: {', '.join(invalid)}"),
        )

    # Merge: existing + client overrides + machine-preserved fields.
    new_fields = dict(existing)
    new_fields.update(client_fields)
    # Re-pin the locked fields verbatim from existing (sha256 / created
    # / updated). 'updated' gets bumped to now since the curator
    # touched the file.
    for key in _MUS_LOCKED_FIELDS:
        if key in existing:
            new_fields[key] = existing[key]
    new_fields['updated'] = _dt.datetime.utcnow().strftime('%Y-%m-%dT%H:%M:%SZ')

    try:
        write_mus_file(mus_path, new_fields)
    except Exception as exc:
        raise HTTPException(status_code=500,
                            detail=f"failed to write {mus_path}: {exc}")

    # Refresh the in-memory metadata cache so /info reflects the .mus edit
    # immediately. The metadata payload includes annotation fields resolved
    # through lib.mus.resolve_annotation (organism, tissue, cell_type, etc.),
    # so a .mus write must invalidate the same cache the .md write does.
    try:
        extra = registry._db_extra.get(db_id, {})
        registry.metadata_cache[db_id] = registry._load_database_metadata(db_id, extra)
        registry._databases_list_cache = None
    except Exception as exc:
        log.warning("dataset PUT source.mus: cache refresh failed for %s: %s",
                    db_id, exc)

    rel = mus_path.relative_to(registry.data_folder) if (mus_path.is_absolute() and registry.data_folder in mus_path.parents) else mus_path.name
    return {
        'ok': True,
        'path': str(rel),
        'written_fields': sorted(client_fields.keys()),
    }


# ── mus vocab (read-only) ─────────────────────────────────────────────────────


@app.get("/mus/vocab", tags=["databases"])
def get_mus_vocab():
    """Read-only mus vocabulary — what the .mus editor renders as dropdowns.

    Per anthive-web pika 2026-06-29 #265: the .mus annotation editor
    populates ``<select>`` widgets for controlled fields (organism /
    cell_type / tissue / disease / suspension_type / technology / …)
    from the SAME source the PUT-time vocab gate uses, so client-side
    options can never drift from server-side validation.

    Not admin-gated — the vocab itself is non-sensitive and shipped in
    the codebase (``lib/_mus_vocab.yaml``); refusing reads here would
    just push curators to scrape the file themselves.

    Shape::

        {
          "required":   [<field>, ...],
          "soft":       [<field>, ...],
          "vocabulary": {<controlled_field>: [<allowed_value>, ...], ...}
        }
    """
    from mus import (   # noqa: PLC0415
        required_fields, soft_fields, allowed_values, is_controlled,
        load_vocabulary,
    )
    vocab_data = load_vocabulary() or {}
    # The yaml's controlled-vocab payload lives under 'vocabulary', not at
    # the top level. We also union with required + soft so soft controlled
    # fields (like 'disease') aren't missed if listed under a different key.
    candidates = set(required_fields()) | set(soft_fields()) | set(
        (vocab_data.get('vocabulary') or {}).keys()
    )
    vocab: Dict[str, List[str]] = {}
    for field in candidates:
        if is_controlled(field):
            allowed = allowed_values(field) or []
            vocab[field] = list(allowed)
    return {
        'required':   list(required_fields()),
        'soft':       list(soft_fields()),
        'vocabulary': vocab,
    }


@app.get("/version", tags=["info"])
def get_version():
    """Single-shot "what's the current API contract?" probe.

    Designed for LLM clients (vark, Claude bindings, anything that
    caches a generated client against a particular API version): hit
    this on session start, compare ``version`` against your cached
    value, and if it differs re-read ``openapi_url`` to regenerate
    bindings, or ``changelog_url`` to see what changed.

    Response is intentionally small + stable: just the version stamp,
    the recommended antclient pin, pointers to the canonical contract
    surfaces, the list of supported plot geoms, and the list of
    endpoints flagged ``deprecated`` in OpenAPI (so callers prefer
    the non-deprecated alternatives).
    """
    root = str(app.root_path or '')
    # Collect deprecated paths from the OpenAPI spec — single source of truth.
    deprecated = []
    try:
        schema = app.openapi()
        for path, ops in schema.get('paths', {}).items():
            for method, op in ops.items():
                if isinstance(op, dict) and op.get('deprecated'):
                    deprecated.append(f"{method.upper()} {path}")
    except Exception:
        pass
    return {
        "version":              API_VERSION,
        "released":             API_VERSION_RELEASED,
        "compatible_antclient": API_COMPATIBLE_ANTCLIENT,
        "openapi_url":          f"{root}/openapi.json",
        "swagger_ui_url":       f"{root}/docs",
        "redoc_url":            f"{root}/redoc",
        "changelog_url":        f"{root}/changelog",
        "plot_geoms":           sorted(_PLOT_GEOMS),
        "plot_output_formats":  sorted(_PLOT_MIME_TYPES.keys()),
        "deprecated_endpoints": sorted(deprecated),
    }


@app.get("/changelog", tags=["info"])
def get_changelog():
    """Serve ``doc/API_CHANGELOG.md`` as text/markdown.

    This is the human-readable counterpart to ``/version``: a structured
    history of what changed between API versions, why, and how to
    migrate.  Pair with ``/openapi.json`` (canonical machine contract).
    """
    repo_root = Path(__file__).parent.parent.parent
    changelog_path = repo_root / 'doc' / 'API_CHANGELOG.md'
    if not changelog_path.exists():
        raise HTTPException(
            status_code=404,
            detail="API_CHANGELOG.md not found in the repo (doc/API_CHANGELOG.md).",
        )
    return Response(
        content=changelog_path.read_text(encoding='utf-8'),
        media_type='text/markdown; charset=utf-8',
    )


@app.get("/metrics", tags=["info"])
def get_metrics():
    """
    Performance metrics endpoint.

    Returns:
    - uptime_seconds
    - requests: total, errors, error_rate (counted from middleware ring,
      excluding /health, /metrics, plot-cache stats)
    - latency_ms: mean / p50 / p95 / p99 / max over the last 1024 non-probe
      requests, plus n_samples.  Use these to compare server speed across
      replicas.
    - connection_pool: hit/miss/in_use stats
    - caches: database/metadata/gene cache sizes
    """
    try:
        pool_stats = connection_pool.get_stats()
        timing = _timing_snapshot()

        return {
            "uptime_seconds": int(registry.get_uptime()),
            "requests": {
                "total":      timing['total'],
                "errors":     timing['errors'],
                "error_rate": timing['errors'] / max(1, timing['total']),
            },
            "latency_ms": {
                "n_samples": timing['n_samples'],
                "mean":      timing['mean_ms'],
                "p50":       timing['p50_ms'],
                "p95":       timing['p95_ms'],
                "p99":       timing['p99_ms'],
                "max":       timing['max_ms'],
            },
            "connection_pool": pool_stats,
            "caches": {
                "databases": len(registry.databases),
                "metadata_cached": len(registry.metadata_cache),
                "gene_lists_cached": len(registry.gene_list_cache),
                "metadata_stats_cached": len(registry.metadata_stats_cache)
            }
        }
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


