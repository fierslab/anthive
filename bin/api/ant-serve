def _denovo_snippet_for(geom: str, plot_params: Dict[str, Any]) -> str:
    """Geom-specific matplotlib snippet that re-renders the plot from ``df``.

    Returns runnable matplotlib/seaborn for all 15 geoms. The DE-driven
    geoms (volcano / ma / forest / de_heatmap) get a rough approximation
    — no clamps, no adjustText labels, no significance overlays. Those
    polish steps live server-side in ``lib/plotting.py``; the PNG from
    cell 4 is the canonical version.
    """
    x_field = plot_params.get('x')
    y_field = plot_params.get('y')
    color_field = plot_params.get('color')

    # ── forest ────────────────────────────────────────────────────────────
    if geom == 'forest':
        return (
            "import matplotlib.pyplot as plt\n"
            "import numpy as np\n"
            "\n"
            "# df already has: gene_name, term, contrast, log2fc, padj\n"
            "# (and optionally ci_low / ci_high / estimate / SE — use when present)\n"
            "sub = df.copy().sort_values('log2fc').reset_index(drop=True)\n"
            "fig, ax = plt.subplots(figsize=(7, max(3, 0.25 * len(sub))))\n"
            "y = np.arange(len(sub))\n"
            "\n"
            "# Confidence interval: ci_low/ci_high columns when present, else fall back to ±SE,\n"
            "# else just point.\n"
            "lo = sub.get('ci_low')\n"
            "hi = sub.get('ci_high')\n"
            "if lo is not None and hi is not None and lo.notna().any():\n"
            "    xerr = np.array([sub['log2fc'] - lo, hi - sub['log2fc']])\n"
            "    ax.errorbar(sub['log2fc'], y, xerr=xerr, fmt='o', capsize=3,\n"
            "                color='#444', ecolor='#888')\n"
            "else:\n"
            "    ax.plot(sub['log2fc'], y, 'o', color='#444')\n"
            "\n"
            "# Highlight significant rows\n"
            "sig = sub['padj'] <= 0.05\n"
            "ax.plot(sub.loc[sig, 'log2fc'], y[sig], 'o', color='#cc4444')\n"
            "\n"
            "labels = [f\"{row['term']} / {row['contrast']}\" for _, row in sub.iterrows()]\n"
            "ax.set_yticks(y)\n"
            "ax.set_yticklabels(labels, fontsize=8)\n"
            "ax.axvline(0, color='gray', lw=0.5, linestyle='--')\n"
            "ax.set_xlabel('log2 fold change')\n"
            "ax.set_title(f\"forest — {df['gene_name'].iloc[0] if 'gene_name' in df else '<gene>'}\")\n"
            "plt.tight_layout()\n"
            "plt.show()"
        )

    # ── volcano ───────────────────────────────────────────────────────────
    if geom == 'volcano':
        return (
            "import matplotlib.pyplot as plt\n"
            "import numpy as np\n"
            "\n"
            "# df has: gene_name, log2fc, padj (and possibly other DE columns)\n"
            "floor = 1e-300\n"
            "neg_log10p = -np.log10(df['padj'].clip(lower=floor))\n"
            "sig = (df['padj'] <= 0.05) & (df['log2fc'].abs() >= 1.0)\n"
            "up = sig & (df['log2fc'] > 0)\n"
            "down = sig & (df['log2fc'] < 0)\n"
            "\n"
            "fig, ax = plt.subplots(figsize=(7, 5))\n"
            "ax.scatter(df.loc[~sig, 'log2fc'], neg_log10p[~sig], s=3, color='#bbbbbb', alpha=0.5)\n"
            "ax.scatter(df.loc[down, 'log2fc'], neg_log10p[down], s=8, color='#3b76b8', label='down')\n"
            "ax.scatter(df.loc[up,   'log2fc'], neg_log10p[up],   s=8, color='#d95f5f', label='up')\n"
            "ax.axvline(0,  color='#444', lw=0.6)\n"
            "ax.axhline(-np.log10(0.05), color='#888', lw=0.6, ls='--')\n"
            "ax.axvline( 1, color='#888', lw=0.6, ls='--')\n"
            "ax.axvline(-1, color='#888', lw=0.6, ls='--')\n"
            "ax.set_xlabel('log2 fold change')\n"
            "ax.set_ylabel('-log10 adjusted p')\n"
            "ax.legend(loc='best', fontsize=8)\n"
            "plt.tight_layout(); plt.show()"
        )

    # ── ma ────────────────────────────────────────────────────────────────
    if geom == 'ma':
        return (
            "import matplotlib.pyplot as plt\n"
            "import numpy as np\n"
            "\n"
            "# df needs base_mean (DESeq2/edgeR) — gracefully fail when absent.\n"
            "if 'base_mean' not in df or df['base_mean'].isna().all():\n"
            "    raise RuntimeError(\n"
            "        \"MA plot needs base_mean per gene. This study didn't emit it; \"\n"
            "        \"use volcano instead, or backfill via ant-de-fill-base-mean.\"\n"
            "    )\n"
            "\n"
            "x = np.log10(df['base_mean'].clip(lower=1e-6))\n"
            "sig = (df['padj'] <= 0.05) & (df['log2fc'].abs() >= 1.0)\n"
            "\n"
            "fig, ax = plt.subplots(figsize=(7, 5))\n"
            "ax.scatter(x[~sig], df.loc[~sig, 'log2fc'], s=3, color='#bbbbbb', alpha=0.5)\n"
            "ax.scatter(x[sig], df.loc[sig, 'log2fc'], s=8, color='#d95f5f', label='sig')\n"
            "ax.axhline(0, color='#444', lw=0.6)\n"
            "ax.axhline( 1, color='#888', lw=0.6, ls='--')\n"
            "ax.axhline(-1, color='#888', lw=0.6, ls='--')\n"
            "ax.set_xlabel('log10 mean expression')\n"
            "ax.set_ylabel('log2 fold change')\n"
            "ax.legend(loc='best', fontsize=8)\n"
            "plt.tight_layout(); plt.show()"
        )

    # ── de_heatmap ────────────────────────────────────────────────────────
    if geom == 'de_heatmap':
        return (
            "import matplotlib.pyplot as plt\n"
            "import numpy as np\n"
            "\n"
            "# The CSV from /plot/de_heatmap?format=csv arrives in long form:\n"
            "# columns are (contrast, gene, value, padj). Pivot to matrix.\n"
            "matrix = df.pivot_table(index='contrast', columns='gene',\n"
            "                        values='value', aggfunc='first')\n"
            "\n"
            "vmax = float(np.nanmax(np.abs(matrix.values)))\n"
            "fig, ax = plt.subplots(figsize=(max(6, 0.4 * matrix.shape[1] + 2),\n"
            "                                max(4, 0.25 * matrix.shape[0] + 1)))\n"
            "im = ax.imshow(matrix.values, cmap='RdBu_r', vmin=-vmax, vmax=vmax, aspect='auto')\n"
            "\n"
            "ax.set_xticks(np.arange(matrix.shape[1]))\n"
            "ax.set_xticklabels(matrix.columns, rotation=90, fontsize=7)\n"
            "ax.set_yticks(np.arange(matrix.shape[0]))\n"
            "ax.set_yticklabels(matrix.index, fontsize=7)\n"
            "plt.colorbar(im, ax=ax, label='value', shrink=0.7)\n"
            "plt.tight_layout(); plt.show()"
        )

    # ── scatter ───────────────────────────────────────────────────────────
    if geom == 'scatter':
        is_embedding = isinstance(x_field, str) and (
            x_field.startswith('X_') or x_field.lower() == 'umap'
        )
        if is_embedding or x_field is None:
            color = color_field
            return (
                "import matplotlib.pyplot as plt\n"
                "import seaborn as sns\n"
                "\n"
                "# Embedding scatter: dim_0 / dim_1 are the projection axes.\n"
                f"COLOR_FIELD = {color!r}\n"
                "fig, ax = plt.subplots(figsize=(7, 6))\n"
                "if COLOR_FIELD and COLOR_FIELD in df.columns:\n"
                "    if df[COLOR_FIELD].dtype == 'object' or str(df[COLOR_FIELD].dtype).startswith('category'):\n"
                "        sns.scatterplot(data=df, x='dim_0', y='dim_1', hue=COLOR_FIELD, s=4, ax=ax, linewidth=0)\n"
                "    else:\n"
                "        sc = ax.scatter(df['dim_0'], df['dim_1'], c=df[COLOR_FIELD], s=4, cmap='inferno_r')\n"
                "        fig.colorbar(sc, ax=ax, label=COLOR_FIELD)\n"
                "else:\n"
                "    ax.scatter(df['dim_0'], df['dim_1'], s=4, color='steelblue')\n"
                "ax.set_xlabel('dim_0'); ax.set_ylabel('dim_1')\n"
                "plt.tight_layout()"
            )
        # XY scatter
        return (
            "import matplotlib.pyplot as plt\n"
            "import seaborn as sns\n"
            "\n"
            f"X_FIELD = {x_field!r}\n"
            f"Y_FIELD = {y_field!r}\n"
            f"COLOR_FIELD = {color_field!r}\n"
            "fig, ax = plt.subplots(figsize=(7, 6))\n"
            "if COLOR_FIELD and COLOR_FIELD in df.columns:\n"
            "    if df[COLOR_FIELD].dtype == 'object' or str(df[COLOR_FIELD].dtype).startswith('category'):\n"
            "        sns.scatterplot(data=df, x=X_FIELD, y=Y_FIELD, hue=COLOR_FIELD, s=10, ax=ax, linewidth=0)\n"
            "    else:\n"
            "        sc = ax.scatter(df[X_FIELD], df[Y_FIELD], c=df[COLOR_FIELD], s=10, cmap='inferno_r')\n"
            "        fig.colorbar(sc, ax=ax, label=COLOR_FIELD)\n"
            "else:\n"
            "    ax.scatter(df[X_FIELD], df[Y_FIELD], s=10, color='steelblue')\n"
            "ax.set_xlabel(X_FIELD); ax.set_ylabel(Y_FIELD)\n"
            "plt.tight_layout()"
        )

    # ── hexbin ────────────────────────────────────────────────────────────
    if geom == 'hexbin':
        is_embedding = isinstance(x_field, str) and (
            x_field.startswith('X_') or x_field.lower() == 'umap'
        )
        x_col = "'dim_0'" if is_embedding or x_field is None else f"{x_field!r}"
        y_col = "'dim_1'" if is_embedding or x_field is None else f"{y_field!r}"
        return (
            "import matplotlib.pyplot as plt\n"
            "import numpy as np\n"
            "\n"
            f"X_COL = {x_col}\n"
            f"Y_COL = {y_col}\n"
            f"COLOR_FIELD = {color_field!r}\n"
            "fig, ax = plt.subplots(figsize=(7, 6))\n"
            "if COLOR_FIELD and COLOR_FIELD in df.columns:\n"
            "    hb = ax.hexbin(df[X_COL], df[Y_COL], C=df[COLOR_FIELD],\n"
            "                    reduce_C_function=np.mean, gridsize=30, cmap='inferno_r')\n"
            "    fig.colorbar(hb, ax=ax, label=f'mean({COLOR_FIELD})')\n"
            "else:\n"
            "    hb = ax.hexbin(df[X_COL], df[Y_COL], gridsize=30, cmap='inferno_r', mincnt=1)\n"
            "    fig.colorbar(hb, ax=ax, label='count')\n"
            "ax.set_xlabel(X_COL); ax.set_ylabel(Y_COL)\n"
            "plt.tight_layout()"
        )

    # ── violin / box ──────────────────────────────────────────────────────
    if geom in {'violin', 'box'}:
        fn = 'violinplot' if geom == 'violin' else 'boxplot'
        return (
            "import matplotlib.pyplot as plt\n"
            "import seaborn as sns\n"
            "\n"
            f"X_FIELD = {x_field!r}\n"
            f"Y_FIELD = {y_field!r}\n"
            "fig, ax = plt.subplots(figsize=(8, 5))\n"
            f"sns.{fn}(data=df, x=X_FIELD, y=Y_FIELD, ax=ax)\n"
            "plt.xticks(rotation=30, ha='right')\n"
            "plt.tight_layout()"
        )

    # ── bar ───────────────────────────────────────────────────────────────
    if geom == 'bar':
        return (
            "import matplotlib.pyplot as plt\n"
            "\n"
            f"X_FIELD = {x_field!r}\n"
            f"Y_FIELD = {y_field!r}\n"
            "fig, ax = plt.subplots(figsize=(8, 5))\n"
            "if Y_FIELD and Y_FIELD in df.columns:\n"
            "    df.groupby(X_FIELD)[Y_FIELD].mean().plot.bar(ax=ax, color='steelblue')\n"
            "    ax.set_ylabel(f'mean({Y_FIELD})')\n"
            "else:\n"
            "    df[X_FIELD].value_counts().plot.bar(ax=ax, color='steelblue')\n"
            "    ax.set_ylabel('count')\n"
            "ax.set_xlabel(X_FIELD)\n"
            "plt.xticks(rotation=30, ha='right')\n"
            "plt.tight_layout()"
        )

    # ── histogram ─────────────────────────────────────────────────────────
    if geom == 'histogram':
        return (
            "import matplotlib.pyplot as plt\n"
            "\n"
            f"X_FIELD = {x_field!r}\n"
            "fig, ax = plt.subplots(figsize=(7, 4))\n"
            "ax.hist(df[X_FIELD].dropna(), bins=30, color='steelblue', edgecolor='white')\n"
            "ax.set_xlabel(X_FIELD); ax.set_ylabel('count')\n"
            "plt.tight_layout()"
        )

    # ── ecdf ──────────────────────────────────────────────────────────────
    if geom == 'ecdf':
        return (
            "import matplotlib.pyplot as plt\n"
            "import numpy as np\n"
            "\n"
            f"X_FIELD = {x_field!r}\n"
            "values = np.sort(df[X_FIELD].dropna().values)\n"
            "fig, ax = plt.subplots(figsize=(7, 5))\n"
            "ax.plot(values, np.arange(len(values)) / max(len(values), 1), drawstyle='steps-post')\n"
            "ax.set_xlabel(X_FIELD); ax.set_ylabel('ECDF')\n"
            "plt.tight_layout()"
        )

    # ── kde (1-D) ─────────────────────────────────────────────────────────
    if geom == 'kde':
        return (
            "import matplotlib.pyplot as plt\n"
            "import seaborn as sns\n"
            "\n"
            f"X_FIELD = {x_field!r}\n"
            f"COLOR_FIELD = {color_field!r}\n"
            "fig, ax = plt.subplots(figsize=(7, 4))\n"
            "if COLOR_FIELD and COLOR_FIELD in df.columns:\n"
            "    sns.kdeplot(data=df, x=X_FIELD, hue=COLOR_FIELD, ax=ax, fill=False)\n"
            "else:\n"
            "    sns.kdeplot(data=df, x=X_FIELD, ax=ax, fill=True)\n"
            "ax.set_xlabel(X_FIELD)\n"
            "plt.tight_layout()"
        )

    # ── kde2d ─────────────────────────────────────────────────────────────
    if geom == 'kde2d':
        return (
            "import matplotlib.pyplot as plt\n"
            "import seaborn as sns\n"
            "\n"
            f"X_FIELD = {x_field!r}\n"
            f"Y_FIELD = {y_field!r}\n"
            "fig, ax = plt.subplots(figsize=(7, 6))\n"
            "sns.kdeplot(data=df, x=X_FIELD, y=Y_FIELD, fill=True, cmap='inferno_r', ax=ax)\n"
            "ax.set_xlabel(X_FIELD); ax.set_ylabel(Y_FIELD)\n"
            "plt.tight_layout()"
        )

    # ── heatmap (gene × category) ─────────────────────────────────────────
    if geom == 'heatmap':
        return (
            "import matplotlib.pyplot as plt\n"
            "import seaborn as sns\n"
            "\n"
            "# Heatmap CSV is already pivoted (rows = category, cols = gene/module,\n"
            "# values = mean expression). If the first column is the row label,\n"
            "# set it as the index before plotting.\n"
            "matrix = df.copy()\n"
            "non_numeric = [c for c in matrix.columns if matrix[c].dtype == 'object']\n"
            "if non_numeric:\n"
            "    matrix = matrix.set_index(non_numeric[0])\n"
            "fig, ax = plt.subplots(figsize=(max(6, 0.5 * matrix.shape[1]), max(4, 0.4 * matrix.shape[0])))\n"
            "sns.heatmap(matrix, cmap='RdBu_r', center=0, ax=ax, cbar_kws={'label': 'mean expr'})\n"
            "plt.tight_layout()"
        )

    # ── rolling (trajectory) ──────────────────────────────────────────────
    if geom == 'rolling':
        return (
            "import matplotlib.pyplot as plt\n"
            "\n"
            f"X_FIELD = {x_field!r}\n"
            f"Y_FIELD = {y_field!r}\n"
            "window = 200\n"
            "sorted_df = df.sort_values(X_FIELD).reset_index(drop=True)\n"
            "rolled = sorted_df[Y_FIELD].rolling(window=window, min_periods=1).mean()\n"
            "fig, ax = plt.subplots(figsize=(8, 4))\n"
            "ax.plot(sorted_df[X_FIELD], rolled, color='steelblue', linewidth=2)\n"
            "ax.set_xlabel(X_FIELD); ax.set_ylabel(f'rolling mean({Y_FIELD}, w={window})')\n"
            "plt.tight_layout()"
        )

    # Defensive fallback — should be unreachable given the geom validator.
    return (
        f"# No de-novo snippet available for geom={geom!r}.\n"
        "# The server-rendered PNG in cell 4 is the canonical output.\n"
        "df.head()"
    )


def _build_notebook_for_plot(
    *,
    db_id: str,
    geom: str,
    plot_params: Dict[str, Any],
    caption: str,
    base_url: str,
    title: Optional[str] = None,
) -> Dict[str, Any]:
    """Assemble the nbformat-4 JSON dict for a plot URL.

    Eight cells (API 2.11.0+):
      1. markdown — title + caption + persistence disclaimer
      2. code     — connect to the anthive server (generic auth setup)
      3. code     — DB_ID / GEOM / PLOT_PARAMS (biology) / RENDER_PARAMS (visual)
      4. code     — render the plot via the API (PNG + caption inline)
      5. markdown — "Pull the raw data" intro
      6. code     — fetch the data as a pandas DataFrame
      7. markdown — "Render the plot yourself" intro
      8. code     — matplotlib/seaborn snippet that re-renders from df

    ``title`` is the biology-keyed X-Plot-Title for cell 1. Falls back to
    ``"{db_id} - {geom}"`` for callers that don't provide it.
    """
    heading = title if title else f"{db_id} - {geom}"
    biology_params, render_params = _split_plot_render_params(plot_params)

    cells = [
        {
            "cell_type": "markdown",
            "metadata": {},
            "source": _intro_md(heading, caption),
        },
        {
            "cell_type": "code",
            "metadata": {},
            "execution_count": None,
            "outputs": [],
            "source": _auth_cell(base_url),
        },
        {
            "cell_type": "code",
            "metadata": {},
            "execution_count": None,
            "outputs": [],
            "source": _params_cell(db_id, geom, biology_params, render_params),
        },
        {
            "cell_type": "code",
            "metadata": {},
            "execution_count": None,
            "outputs": [],
            "source": _plot_render_cell(),
        },
        {
            "cell_type": "markdown",
            "metadata": {},
            "source": _data_pull_intro_md(),
        },
        {
            "cell_type": "code",
            "metadata": {},
            "execution_count": None,
            "outputs": [],
            "source": _data_pull_cell(),
        },
        {
            "cell_type": "markdown",
            "metadata": {},
            "source": _denovo_intro_md(),
        },
        {
            "cell_type": "code",
            "metadata": {},
            "execution_count": None,
            "outputs": [],
            "source": _denovo_snippet_for(geom, plot_params),
        },
    ]

    return {
        "nbformat": 4,
        "nbformat_minor": 5,
        "metadata": {
            "kernelspec": {
                "name": "python3",
                "display_name": "Python 3 (Pyodide)",
                "language": "python",
            },
            "language_info": {
                "name": "python",
                "version": "3.11",
                "file_extension": ".py",
                "mimetype": "text/x-python",
            },
            "anthive": {
                "generator": "ant-serve",
                "api_version": API_VERSION,
                "db_id": db_id,
                "geom": geom,
            },
        },
        "cells": cells,
    }


def _common_plot_params_from_dict(
    db_id: str,
    params: Dict[str, Any],
    request: Request,
) -> "CommonPlotParams":
    """Construct a CommonPlotParams from a flat dict, falling back to the
    same defaults FastAPI's Query() declarations carry.  Used by the
    b64-encoded-params notebook route (where the params come from a URL
    path segment, not request.query_params), so the existing notebook
    builder can run uniformly off CommonPlotParams.

    Anything in ``params`` that isn't a known shared knob is silently
    ignored — geom-specific params travel via plot_kwargs separately.
    """
    common = CommonPlotParams.__new__(CommonPlotParams)
    common.db_id = db_id
    common.output_format = str(params.get('format', 'png'))
    common.layer = str(params.get('layer', 'X'))
    common.width = float(params.get('width', 8.0))
    common.height = float(params.get('height', 6.0))
    common.dpi = int(params.get('dpi', 150))
    common.palette_categorical = str(params.get('palette_categorical', 'tab10'))
    common.palette_continuous = str(params.get('palette_continuous', 'inferno_r'))
    common.palette_divergent = str(params.get('palette_divergent', 'RdBu_r'))
    cs = params.get('color_scale')
    common.color_scale = str(cs) if cs is not None else None
    common.font_family = str(params.get('font_family', 'DejaVu Sans'))
    common.font_size = float(params.get('font_size', 10.0))
    raw_subset = params.get('subset', [])
    if isinstance(raw_subset, str):
        common.subset = [raw_subset]
    else:
        common.subset = list(raw_subset) if raw_subset else []
    s = params.get('sample')
    common.sample = int(s) if s is not None else None
    common.request = request
    if common.output_format not in _PLOT_MIME_TYPES:
        raise HTTPException(
            400,
            detail=f"Unknown format '{common.output_format}'. Valid: "
                   + ', '.join(sorted(_PLOT_MIME_TYPES.keys())),
        )
    return common


async def _build_notebook_response(
    db_id: str,
    geom: str,
    all_params: Dict[str, Any],
    request: Request,
):
    """Core notebook builder, shared by the query-string route and the
    base64-path-encoded route. ``all_params`` is a flat dict containing
    BOTH shared knobs (layer, width, …, subset, sample) and per-geom
    params (x, y, color, study, term, …) — same keys the URL query
    string carries.
    """
    if geom not in _PLOT_GEOMS:
        raise HTTPException(
            400,
            detail=f"Unknown geom '{geom}'. Valid: {sorted(_PLOT_GEOMS)}",
        )

    common = _common_plot_params_from_dict(db_id, all_params, request)

    # Build the kwargs dict for _build_plot_request from non-common params.
    plot_kwargs: Dict[str, Any] = {}
    notebook_params: Dict[str, Any] = {}
    for raw_key, raw_value in all_params.items():
        # `format` is selected per-cell inside the notebook — drop it from
        # the user-facing PARAMS dict.
        if raw_key == 'format':
            continue
        notebook_params[raw_key] = raw_value
        if raw_key in _NOTEBOOK_COMMON_PARAMS:
            continue
        # In dict-mode we may already have a typed value (int / float /
        # bool). Only coerce if it's still a string.
        if isinstance(raw_value, str):
            coerced = _coerce_query_value(raw_key, raw_value)
        else:
            coerced = raw_value
        kwarg_name = _NOTEBOOK_PARAM_RENAME.get(raw_key, raw_key)
        plot_kwargs[kwarg_name] = coerced

    import inspect as _inspect
    allowed = set(_inspect.signature(_build_plot_request).parameters.keys())
    plot_kwargs = {k: v for k, v in plot_kwargs.items() if k in allowed}

    try:
        plot_req = _build_plot_request(common, geom, **plot_kwargs)
    except TypeError as exc:
        raise HTTPException(400, detail=f"Bad plot params: {exc}")

    plot_req = _plot_request_force_png(plot_req)
    plot_response = await _render_plot(plot_req, request)
    caption = plot_response.headers.get('X-Plot-Caption') or ''
    title = plot_response.headers.get('X-Plot-Title') or f"{db_id}: {geom}"
    plot_filename = (
        plot_response.headers.get('X-Plot-Filename')
        or f"{db_id.replace('/', '_')}_{geom}"
    )
    filename_truncated = (
        plot_response.headers.get('X-Plot-Filename-Truncated') == 'true'
    )

    # The X-Anthive-Auth-Case header is kept for client telemetry, but the
    # notebook content no longer branches on it — the generic auth cell
    # works for all four cases.
    case, _remote_user, _passwordless = _detect_notebook_auth(request)
    base_url = _notebook_base_url(request)

    notebook_dict = _build_notebook_for_plot(
        db_id=db_id,
        geom=geom,
        plot_params=notebook_params,
        caption=caption,
        title=title,
        base_url=base_url,
    )

    filename = f"{plot_filename}.ipynb"
    headers = {
        "Content-Disposition": f'attachment; filename="{filename}"',
        "Cache-Control": "no-store",
        "X-Anthive-Auth-Case": case,
        "X-Plot-Title": title,
        "X-Plot-Filename": plot_filename,
        "X-Plot-Caption": caption,
    }
    if filename_truncated:
        headers["X-Plot-Filename-Truncated"] = 'true'
    return Response(
        content=json.dumps(notebook_dict, indent=1),
        media_type="application/x-ipynb+json",
        headers=headers,
    )


@app.get(
    "/databases/{db_id:path}/plot/{geom}/notebook",
    tags=["plots"],
    response_class=JSONResponse,
)
# Alias with explicit .ipynb extension — JupyterLite's ?fromURL= handler uses
# the URL basename to decide the saved filename. Without an .ipynb extension
# it either skips the save or stores the file unrecognised, breaking the
# auto-open. The alias lets clients hit the same endpoint with a URL ending
# in .ipynb so JupyterLite materialises and opens it correctly.
@app.get(
    "/databases/{db_id:path}/plot/{geom}/notebook.ipynb",
    tags=["plots"],
    response_class=JSONResponse,
)
async def plot_notebook_endpoint(
    common: CommonPlotParams = Depends(),
    geom: str = FastAPIPath(
        ...,
        description=(
            "Plot geom (same value as the path segment in "
            "``/plot/{geom}``): ``scatter`` | ``hexbin`` | ``violin`` | "
            "``box`` | ``bar`` | ``histogram`` | ``ecdf`` | ``kde`` | "
            "``heatmap`` | ``rolling`` | ``kde2d`` | ``volcano`` | "
            "``ma`` | ``forest`` | ``de_heatmap``."
        ),
    ),
):
    """Return a JupyterLite-compatible ``.ipynb`` for this plot.

    Same query-param surface as ``/plot/{geom}`` — the resulting notebook
    re-issues the same plot request via ``vark.AnthiveClient`` and renders
    the figure inline with the caption underneath.

    **JupyterLite integration.** Pass the absolute URL of this endpoint as
    ``?fromURL=…`` to JupyterLite's index:

        /jupyter/lab/index.html?fromURL=<urlencoded-notebook-URL>

    JupyterLite then materialises the notebook in the user's in-browser
    filesystem (IndexedDB-backed). The user can edit and re-run cells; to
    persist their changes off-browser they use *File → Download*.

    The active auth line in cell 2 is always ``c = AnthiveClient(BASE_URL)``
    — works inside JupyterLite at this server's origin (Authelia cookie /
    HTTP Basic carried by the browser) and outside via the
    ``pyvark[vark-config]`` credential lookup. A commented explicit-password
    line is templated alongside for users who copy the notebook elsewhere.
    """
    request = common.request
    if request is None:
        # Should never happen — CommonPlotParams always injects the request.
        raise HTTPException(500, detail="Could not access inbound Request object.")

    # Flatten the inbound query params into a dict so the shared
    # ``_build_notebook_response`` helper can drive both this query-string
    # route AND the base64-path-encoded route uniformly. Repeats become
    # lists (matches URL semantics).
    all_params: Dict[str, Any] = {}
    for raw_key, raw_value in request.query_params.multi_items():
        if raw_key in all_params:
            existing = all_params[raw_key]
            if isinstance(existing, list):
                existing.append(raw_value)
            else:
                all_params[raw_key] = [existing, raw_value]
        else:
            all_params[raw_key] = raw_value
    return await _build_notebook_response(common.db_id, geom, all_params, request)


def _decode_b64_notebook_params(b64params: str) -> Tuple[str, str, Dict[str, Any]]:
    """Decode a base64-urlsafe JSON blob of notebook params.

    Returns ``(db_id, geom, params)`` where ``params`` has db_id / geom
    already popped out. Raises HTTPException(400) on any decode failure
    or missing required keys.
    """
    import base64 as _b64
    try:
        # Tolerate missing padding.
        padded = b64params + '=' * (-len(b64params) % 4)
        raw = _b64.urlsafe_b64decode(padded)
        params = json.loads(raw.decode('utf-8'))
    except (ValueError, json.JSONDecodeError, UnicodeDecodeError) as exc:
        raise HTTPException(
            400,
            detail=f"Could not decode base64-url-safe JSON params: {exc}",
        )
    if not isinstance(params, dict):
        raise HTTPException(
            400, detail="Decoded payload must be a JSON object.",
        )
    db_id = params.pop('db_id', None)
    geom = params.pop('geom', None)
    if not db_id or not geom:
        raise HTTPException(
            400,
            detail="Encoded params dict must include 'db_id' and 'geom'.",
        )
    return str(db_id), str(geom), params


# Pattern for the per-URL "saved filename" segment in the b64-encoded
# notebook routes. Matches the sanitiser used by
# ``plotting._filename_sanitise`` and caps length at 100 chars — long
# enough for any biology-keyed filename (descriptor cap is 80) plus a
# little slack, short enough to refuse weird/abusive URLs.
import re as _re_notebook_filename
_NOTEBOOK_FILENAME_RE = _re_notebook_filename.compile(r'^[A-Za-z0-9_-]{1,100}$')


# Shared notebook-generator docstring fragment, referenced by both
# route handlers (the back-compat /plot.ipynb route and the
# biology-keyed /{filename}.ipynb route).
_NOTEBOOK_B64_DOC = (
    "Notebook generator with all plot params encoded as a base64-url-safe "
    "JSON blob in the URL path. Functionally equivalent to "
    "``GET /databases/{db_id}/plot/{geom}/notebook.ipynb?<params>`` but with "
    "NO query string — required for JupyterLite's ``?fromURL=`` deep link "
    "to save the resulting notebook with a recognisable ``.ipynb`` basename.\n\n"
    "Two URL shapes are accepted, with identical behaviour:\n\n"
    "* ``/notebook/{b64}/plot.ipynb`` — back-compat for older clients.\n"
    "* ``/notebook/{b64}/{filename}.ipynb`` — ``filename`` can be any "
    "``[A-Za-z0-9_-]{1,100}`` token; lets the client pass the biology-keyed "
    "filename (from ``/notebook/{b64}/meta``) so JupyterLite saves the "
    "file under the descriptive basename instead of literal ``plot``."
)


@app.get(
    "/notebook/{b64params}/plot.ipynb",
    tags=["plots"],
    response_class=JSONResponse,
)
async def plot_notebook_b64_endpoint(
    b64params: str = FastAPIPath(
        ...,
        description=(
            "Base64-url-safe-encoded JSON of the plot params. MUST include "
            "``db_id`` and ``geom`` keys; everything else maps to the same "
            "params as ``/databases/{db_id}/plot/{geom}/notebook?...``."
        ),
    ),
    request: Request = None,  # type: ignore[assignment]
):
    """Back-compat alias of ``/notebook/{b64params}/{filename}.ipynb`` with
    ``filename=plot``. Pre-API-2.9.2 clients use this URL.
    """
    db_id, geom, params = _decode_b64_notebook_params(b64params)
    return await _build_notebook_response(db_id, geom, params, request)


@app.get(
    "/notebook/{b64params}/{filename}.ipynb",
    tags=["plots"],
    response_class=JSONResponse,
)
async def plot_notebook_b64_named_endpoint(
    b64params: str = FastAPIPath(
        ...,
        description=(
            "Base64-url-safe-encoded JSON of the plot params. MUST include "
            "``db_id`` and ``geom`` keys; everything else maps to the same "
            "params as ``/databases/{db_id}/plot/{geom}/notebook?...``. "
            "Used by the JupyterLite 'open this plot as a notebook' button "
            "to avoid the filename-includes-query-string bug in "
            "jupyterlab-open-url-parameter — a URL with NO query string "
            "lets the extension save the file with a clean basename."
        ),
    ),
    filename: str = FastAPIPath(
        ...,
        description=(
            "The saved filename basename in JupyterLite's in-browser FS "
            "(without the ``.ipynb`` extension). Server ignores it for the "
            "actual response — the b64 blob drives content — but echoes it "
            "back via the URL so JupyterLite's open-url extension saves "
            "the notebook with this name. Must match ``[A-Za-z0-9_-]{1,100}``."
        ),
    ),
    request: Request = None,  # type: ignore[assignment]
):
    """Notebook generator with all plot params encoded as a base64-url-safe
    JSON blob in the URL path, plus a biology-keyed ``filename`` segment
    that JupyterLite uses as the in-browser-FS basename.

    The encoded blob is a JSON object::

        {"db_id": "S25/V6A", "geom": "volcano",
         "study": "DE_…", "term": "Sex_donor", "contrast": "F",
         "log2fc_clip": 3, ...}

    encoded with ``base64.urlsafe_b64encode(json.dumps(params).encode())``
    (Python) or the JS equivalent (``btoa`` with ``+`` → ``-`` and
    ``/`` → ``_``). Trailing ``=`` padding is optional — the decoder is
    tolerant.

    ``filename`` is purely cosmetic (the b64 blob still drives the
    response). Use ``/notebook/{b64params}/meta`` to compute the
    biology-keyed filename before opening JupyterLite, then put that
    filename in this URL — JupyterLite saves the notebook under that
    basename instead of literal ``plot.ipynb``.
    """
    # ``filename`` is cosmetic — the response body is driven entirely by
    # the b64 blob. Validate it just enough to refuse abuse / weird URLs.
    if not _NOTEBOOK_FILENAME_RE.match(filename):
        raise HTTPException(
            400,
            detail=(
                "filename must match [A-Za-z0-9_-]{1,100} (got "
                f"{filename!r})."
            ),
        )
    db_id, geom, params = _decode_b64_notebook_params(b64params)
    return await _build_notebook_response(db_id, geom, params, request)


@app.get(
    "/notebook/{b64params}/meta",
    tags=["plots"],
    response_class=JSONResponse,
)
async def plot_notebook_descriptor_endpoint(
    b64params: str = FastAPIPath(
        ...,
        description=(
            "Base64-url-safe-encoded JSON of the plot params (same encoding "
            "as ``/notebook/{b64params}/{filename}.ipynb``)."
        ),
    ),
    request: Request = None,  # type: ignore[assignment]
):
    """Return the biology-keyed title + filename for a notebook URL,
    WITHOUT rendering the plot.

    Used by the web client's "open as notebook" button to pre-compute the
    JupyterLite-FS in-browser filename BEFORE opening JupyterLite, so the
    saved file's basename matches the biology (e.g. ``S25_V6A_scatter_P2RY12``)
    instead of the literal ``plot`` fallback.

    Pure / param-only — no DB I/O. Field-kind resolution against the live
    PlotContext is skipped (kinds default to ``None``) so the descriptor
    output is slightly fuzzier than the full render-time descriptor, but
    still readable and stable. Returns::

        {"title": "S25/V6A: P2RY12 expression on embedding",
         "filename": "S25_V6A_scatter_P2RY12",
         "filename_truncated": false}
    """
    db_id, geom, params = _decode_b64_notebook_params(b64params)
    if geom not in _PLOT_GEOMS:
        raise HTTPException(
            400,
            detail=f"Unknown geom '{geom}'. Valid: {sorted(_PLOT_GEOMS)}",
        )

    # Reuse the same param-folding logic as _build_notebook_response so
    # the descriptor sees the same kwargs the real plot would. We do NOT
    # render — just build a PlotRequest and run the static descriptor.
    try:
        common = _common_plot_params_from_dict(db_id, params, request)
    except HTTPException:
        raise

    plot_kwargs: Dict[str, Any] = {}
    for raw_key, raw_value in params.items():
        if raw_key == 'format':
            continue
        if raw_key in _NOTEBOOK_COMMON_PARAMS:
            continue
        if isinstance(raw_value, str):
            coerced = _coerce_query_value(raw_key, raw_value)
        else:
            coerced = raw_value
        kwarg_name = _NOTEBOOK_PARAM_RENAME.get(raw_key, raw_key)
        plot_kwargs[kwarg_name] = coerced

    import inspect as _inspect
    allowed = set(_inspect.signature(_build_plot_request).parameters.keys())
    plot_kwargs = {k: v for k, v in plot_kwargs.items() if k in allowed}

    try:
        plot_req = _build_plot_request(common, geom, **plot_kwargs)
    except TypeError as exc:
        raise HTTPException(400, detail=f"Bad plot params: {exc}")

    # Static descriptor — no DB context. For scatter/hexbin with no
    # explicit x, the descriptor will say "embedding"; that's the
    # acceptable fallback (kinds aren't resolved here).
    desc = plotting.build_plot_descriptor(**_descriptor_inputs_static(plot_req))
    return JSONResponse(
        content={
            'title':              desc['title'],
            'filename':           desc['filename'],
            'filename_truncated': desc['filename_truncated'] == '1',
        },
        headers={'Cache-Control': 'no-store'},
    )


def _plot_request_force_png(req: PlotRequest) -> PlotRequest:
    """Return a copy of ``req`` with output_format='png'.

    PlotRequest is frozen — we can't mutate; we replace via dataclasses.replace.
    """
    from dataclasses import replace as _dc_replace
    if req.output_format == 'png':
        return req
    return _dc_replace(req, output_format='png')


