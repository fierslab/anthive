        regex='^(estimate|log2fc|zeff|effsize)$',
        description=(
            "Which __de column to plot. Default: auto-pick the first of "
            "estimate / log2fc / zeff / effsize that has non-null values "
            "for this (study, term)."
        ),
    ),
    padj_threshold: float = Query(
        0.05, gt=0.0, le=1.0,
        description="padj cutoff for the sig_overlay dot.",
    ),
    sig_overlay: bool = Query(
        False,
        description="When true, draw a small black dot in each cell whose padj <= padj_threshold.",
    ),
    vmin: Optional[float] = Query(
        None,
        description=(
            "Hard lower clip for the colour scale. Overrides vmin_quantile "
            "when set. On an auto-divergent palette, setting only vmax "
            "mirrors to -vmax for vmin (symmetric)."
        ),
    ),
    vmax: Optional[float] = Query(
        None,
        description=(
            "Hard upper clip for the colour scale. Overrides vmax_quantile "
            "when set."
        ),
    ),
    vmin_quantile: Optional[float] = Query(
        None, gt=0.0, lt=1.0,
        description=(
            "Auto-clip the lower bound at the Qth quantile of the pivoted "
            "matrix's finite cell values (0-1 exclusive). Ignored when "
            "vmin is explicitly set."
        ),
    ),
    vmax_quantile: Optional[float] = Query(
        None, gt=0.0, lt=1.0,
        description=(
            "Auto-clip the upper bound at the Qth quantile of the pivoted "
            "matrix's finite cell values (0-1 exclusive). Ignored when "
            "vmax is explicitly set."
        ),
    ),
    sort: Optional[str] = Query(
        None,
        description=(
            "Row or column label to sort by. If the label matches a gene "
            "(column header), rows are reordered by that column's values. "
            "If it matches a contrast (row header), columns are reordered "
            "by that row's values. Ascending by default; NaNs go to the "
            "end. Overrides positional ordering from ?contrasts= / ?genes=."
        ),
    ),
    sort_desc: bool = Query(
        False,
        description="Reverse the sort direction (descending).",
    ),
):
    """Contrasts × genes/modules heatmap of pre-computed DE values.

    Renders Sierksma Fig 2E / 4B-style matrices directly from the
    `__de` table. Cell capacity: 2000 (contrasts × genes); pre-filter
    with ``contrasts`` and / or ``genes`` for tighter views.

    Both `contrasts` and `genes` accept the `-` prefix to exclude a
    value (e.g. `genes=-APOE` = "everything except APOE", or
    `genes=A,B,-A` = `{B}`). Mixing positives and negatives starts
    with the positive set and then removes the negatives.

    Defaults to a divergent palette centred on zero (effect-size data
    is signed); flip with ``color_scale=sequential`` for one-sided
    value columns.
    """
    req = _build_plot_request(
        common, 'de_heatmap',
        de_study=study, de_term=term,
        de_contrasts=contrasts, de_genes=genes,
        de_value=value,
        padj_threshold=padj_threshold,
        sig_overlay=sig_overlay,
        vmin=vmin, vmax=vmax,
        vmin_quantile=vmin_quantile, vmax_quantile=vmax_quantile,
        sort=sort, sort_desc=sort_desc,
    )
    return await _render_plot(req, common.request)


