    common: CommonPlotParams = Depends(),
    x: str = Query(..., description="X-axis continuous field (gene or numerical obs)."),
    y: str = Query(..., description="Y-axis continuous field (gene or numerical obs)."),
    transform_x: Optional[str] = Query(
        None,
        description="Per-axis transform: linear (default) | log | log1p | signed_log1p | asinh | signed_sqrt | rank.",
    ),
    transform_y: Optional[str] = Query(None),
    asinh_scale: float = Query(1.0, gt=0.0, le=1000.0),
    kde_n: int = Query(
        15_000, ge=100, le=200_000,
        description="Subsample size for the KDE fit. Full evaluation on >100k cells is slow with no visible gain.",
    ),
    kde_bw: Optional[float] = Query(
        0.22, gt=0.0, le=10.0,
        description="Bandwidth (Gaussian KDE scale). Lower = sharper. Set 0 / omit for Scott's rule.",
    ),
    n_levels: int = Query(10, ge=2, le=30, description="Number of filled contour levels."),
    iso_overlay: bool = Query(True, description="Draw thin white iso-density lines over the filled contours."),
    point_overlay: bool = Query(False, description="Raster scatter under the contours (off by default for clarity)."),
    marginals: bool = Query(False, description="Add univariate KDE strips on top of x and right of y."),
    regline: Optional[str] = Query(
        None,
        regex='^global$',
        description=(
            "Overlay a regression line + R² / Pearson / Spearman / slope. "
            "Only ``global`` is supported on kde2d (no categorical colour "
            "input). ``by_group`` returns 422."
        ),
    ),
):
    """2-D Gaussian kernel-density estimate over two continuous fields
    (e.g. two WGCNA module scores, or two gene expressions).

    Workflow:

    * apply the per-axis transform (default linear)
    * fit a Gaussian KDE on a ``kde_n``-cell subsample
    * evaluate the density on a 200×200 grid
    * render as ``n_levels`` filled magma contours + optional iso-density overlay
