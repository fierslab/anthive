@app.get("/databases/{db_id:path}/plot/scatter", tags=["plots"])
async def plot_scatter_endpoint(
    common: CommonPlotParams = Depends(),
    x: Optional[str] = Query(
        None,
        description=(
            "X-axis field.  **Omit** for the default embedding (``X_umap``). "
            "Pass an embedding key (``X_umap``, ``X_pca``, …) for an embedding "
            "scatter.  Pass a continuous field (gene or numerical obs) for a "
            "generic 2-axis scatter (then ``y`` is required)."
        ),
    ),
    y: Optional[str] = Query(
        None,
        description="Y-axis field (continuous) — required when ``x`` is continuous; ignored for embedding scatter.",
    ),
    color: Optional[str] = Query(
        None, description="Colour-encoding field — gene, numerical, or categorical.",
    ),
    point_size: float = Query(3.0, gt=0.0, le=200.0, description="Marker size in pt²."),
    alpha: float = Query(0.8, ge=0.0, le=1.0, description="Marker opacity."),
    log_x: bool = Query(False, description="Legacy alias for ``transform_x=log1p`` (XY-mode only)."),
    log_y: bool = Query(False, description="Legacy alias for ``transform_y=log1p`` (XY-mode only)."),
    transform_x: Optional[str] = Query(
        None,
        description=(
            "Per-axis transform applied BEFORE plotting (XY-mode only). One of: "
            "linear (default), log, log1p, signed_log1p, asinh, signed_sqrt, rank. "
            "Use signed_log1p / asinh for fields straddling zero (e.g. module "
            "eigengene scores); rank to give every cell equal visual weight."
        ),
    ),
    transform_y: Optional[str] = Query(None, description="Same kinds as ``transform_x`` for the y axis."),
    asinh_scale: float = Query(
        1.0, gt=0.0, le=1000.0,
        description="Scale factor for asinh transform: y = asinh(x/scale). Lower = more aggressive compression.",
    ),
    vmin: Optional[float] = Query(None, description="Continuous colour-scale lower clip. Leave empty for auto."),
    vmax: Optional[float] = Query(
        None,
        description="Continuous colour-scale upper clip — useful when one outlier washes out the gradient.",
    ),
    marginals: bool = Query(False, description="XY-mode overlay: univariate KDE strips on x and y."),
    regline: Optional[str] = Query(
        None,
        regex='^(global|by_group)$',
        description=(
            "XY-mode overlay: regression line + R²/Pearson/Spearman/slope. "
            "``global`` for one line; ``by_group`` for one per categorical-colour group (cap 30)."
        ),
    ),
):
    """Cell-level scatter, **polymorphic**:

    * No ``x`` (or an embedding key) → embedding scatter.
    * Continuous ``x`` + ``y`` → generic gene-vs-gene / numerical-vs-numerical scatter.

    Continuous ``color`` fields auto-pick ``palette_continuous`` or
    ``palette_divergent`` based on whether values straddle zero.
    """
    req = _build_plot_request(
        common, 'scatter',
        x=x, y=y, color=color,
        point_size=point_size, alpha=alpha,
        log_x=log_x, log_y=log_y,
        transform_x=transform_x, transform_y=transform_y,
        asinh_scale=asinh_scale,
        vmin=vmin, vmax=vmax,
        marginals=marginals, regline=regline,
    )
    return await _render_plot(req, common.request)


