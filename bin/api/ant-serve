# ── obs-column click tracking (anthive-web pika #259 — Mark go) ──────────────
#
# Tiny SQLite counter. POST increments on every user plot click; GET returns
# the most-popular obs columns per dataset. The dataset page renders these as
# a "frequently used" chip row above the curated favourites.
#
# Storage: var/obs_clicks.db (var/ holds persistent state; tmp/ may be wiped).
# Per-host, not synced to S3.

_obs_click_store_instance: 'Optional[Any]' = None


def _get_obs_click_store():
    """Lazy singleton at <state_dir>/obs_clicks.db."""
    global _obs_click_store_instance
    if _obs_click_store_instance is None:
        from obs_clicks import ObsClickStore  # noqa: PLC0415
        _obs_click_store_instance = ObsClickStore(get_state_dir() / 'obs_clicks.db')
    return _obs_click_store_instance


class ObsClickBody(BaseModel):
    column: str


@app.post("/databases/{db_id:path}/obs_click", tags=["databases"], status_code=204)
async def post_obs_click(db_id: str, body: ObsClickBody):
    """Fire-and-forget: bump the click counter for (db_id, column).

    Intentionally NOT admin-gated — any plot interaction by any visitor
    counts as usage. Response is 204 (no content) so the keepalive fetch
    from the navigating browser doesn't waste bytes on a body.

    Rejects unsafe column names (anything with a slash, leading dot, or
    over 200 chars) — basic sanity check. We don't validate the column
    exists in the dataset; a stale click on a recently-renamed column
    just sits in the counter table until next wipe.
    """
    column = (body.column or '').strip()
    if not column or '/' in column or column.startswith('.') or len(column) > 200:
        raise HTTPException(status_code=400, detail="invalid column name")
    try:
        store = _get_obs_click_store()
        await asyncio.to_thread(store.click, db_id, column)
    except Exception as exc:
        # Don't fail the click — log + swallow.
        log.warning("obs_click store write failed: %s", exc)
    return Response(status_code=204)


@app.get("/databases/{db_id:path}/obs_top", tags=["databases"])
async def get_obs_top(db_id: str, n: int = 8):
    """Top-N most-clicked obs columns for ``db_id``.

    Returns ``{"columns": [{"column": "...", "count": N}, ...]}`` ordered
    by count desc. Empty list when nothing's been clicked yet (the web
    just hides the "frequently used" row in that case).
    """
    if n < 1 or n > 100:
        raise HTTPException(status_code=400, detail="n must be between 1 and 100")
    store = _get_obs_click_store()
    columns = await asyncio.to_thread(store.top, db_id, n)
    return {'columns': columns}


# ── curation proposals (AI-suggested edits, read-only here) ──────────────────
#
# Phase 1 of the AI-curation work (see doc/TODO_curation.md). `ant-curate`
# (bin/annot/) runs a single-shot LLM call against a dataset's metadata
# and drops proposals into tmp/curation/<db_id>.yaml. The metadata editor
# (anthive-web /admin/edit/{db}) reads them from here and surfaces them as
# accept/reject pills next to each field. Apply is the editor's job
# (PUT /databases/{db_id}/source — already there) — this endpoint never
# writes.

@app.get("/databases/{db_id:path}/curation", tags=["databases"])
def get_dataset_curation(db_id: str, request: Request):
    """Return any AI-curation proposals for ``db_id``, generated by ant-curate.

    Admin-gated — same Authelia 'admins' check as /source.

    Returns ``{exists, db_id, generated_at, model, n_proposals, proposals: {…}}``
    when a proposal file exists. ``exists=False`` (NOT 404) with an empty
    proposals dict when none has been generated yet — the editor can show
    a "Generate AI suggestions" button in that case.

    Proposal shape per field_path:
      {current, proposed, confidence (0..1), rationale}

    Valid field_paths are documented in bin/annot/ant-curate's prompt:
      .md.title / .md.description / .md.top_genes / .md.top_cat / .md.top_num
      .mus.organism / .mus.tissue / .mus.cell_type / .mus.disease
      .mus.suspension_type / .mus.technology
    """
    _require_admin(request)
    import yaml as _yaml  # noqa: PLC0415

    safe_id = db_id.replace('/', '__')
    proposal_path = get_tmp_dir() / 'curation' / f'{safe_id}.yaml'

    if not proposal_path.is_file():
        return {
            'exists': False,
            'db_id': db_id,
            'generated_at': None,
            'model': None,
            'n_proposals': 0,
            'proposals': {},
        }
    try:
        record = _yaml.safe_load(proposal_path.read_text(encoding='utf-8')) or {}
    except Exception as exc:
        raise HTTPException(
            status_code=500,
            detail=f"failed to read curation proposals: {exc}",
        )
    proposals = record.get('proposals') or {}
    return {
        'exists': True,
        'db_id': db_id,
        'generated_at': record.get('generated_at'),
        'model': record.get('model'),
        'n_proposals': len(proposals),
        'proposals': proposals,
    }


