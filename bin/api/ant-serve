@app.get("/databases/{db_id:path}/gene_stats", tags=["genes"])
async def get_gene_stats(
    db_id: str,
    genes: Optional[str] = Query(None, description="Comma-separated gene names, e.g. APOE,CLU. Omit to use top=N."),
    layer: Optional[str] = Query(None, description="Layer name (default: dataset's default_layer, or X)"),
    top: Optional[int] = Query(None, description="When genes= is omitted, return stats for the top-N most variable genes (by std). Max 200."),
):
    """
    Get expression statistics for one or more genes.

    Either ``genes`` (comma-separated list) or ``top`` must be supplied:

    - **genes**: explicit list — stats for those genes on the specified layer.
    - **top**: omit ``genes`` and supply ``top=N`` to return the N most variable
      genes (by std across all cells), ranked highest-first.  Maximum 200.
      Useful for datasets with no curated gene panel.

    When ``layer`` is omitted the dataset's ``default_layer`` is used (falls
    back to ``X`` if not configured).

    Computed efficiently from sparse data without transferring all cells.

    Returns per-gene:
    - **n_cells**: total cell count
    - **n_nonzero**: cells with non-zero expression
    - **pct_nonzero**: % cells expressing the gene
    - **mean**, **std**: over all cells (zeros = 0)
    - **mean_nonzero**, **std_nonzero**, **median_nonzero**, **q10_nonzero**, **q90_nonzero**, **max**: expressing cells only

    Example:
        GET /databases/LC5/SPM/gene_stats?genes=APOE,CLU
        GET /databases/LC5/VNF/gene_stats?top=20
    """
    if genes is None and top is None:
        raise HTTPException(status_code=422, detail="Supply either genes= or top=")
    if top is not None and top > 200:
        top = 200
    try:
        def _sync_work():
            # Build the per-(db, layer) cache fingerprint. Mirrors the
            # /gene_stats_all pattern (mus sha + day-bucketed mtime); when
            # either signal is missing we bypass the cache rather than
            # risk staleness.
            cache = registry.gene_stats_cache
            try:
                meta = registry.get_database_metadata(db_id) or {}
            except KeyError:
                meta = {}
            resolved_layer = layer or meta.get('default_layer') or 'X'
            mus_sha = str(meta.get('sha256') or '').strip()
            duckdb_mtime = 0.0
            db_url = registry.databases.get(db_id)
            if db_url and not db_url.startswith('s3://'):
                try:
                    duckdb_mtime = Path(db_url).stat().st_mtime
                except OSError:
                    duckdb_mtime = 0.0
            fingerprint = GeneStatsCache.fingerprint(mus_sha or None, duckdb_mtime)

            with _pooled_db(db_id) as db:
                if genes is not None:
                    gene_list = [g.strip() for g in genes.split(',') if g.strip()]
                    stats = _cached_gene_stats(
                        db, db_id, gene_list, resolved_layer, fingerprint, cache,
                    )
                    return {"db_id": db_id, "layer": resolved_layer, "stats": stats}

                # top-N most variable: pull a candidate pool by mean, compute
                # std for each (batched, cache-aware), then keep the highest-std N.
                n_top = top or 20
                candidate_genes = _get_top_genes_by_mean(db, min(n_top * 10, 500), resolved_layer)
                if not candidate_genes:
                    # Fallback: pull first N gene names from genes table.
                    rows = db._conn.execute(
                        "SELECT gene_name FROM genes ORDER BY gene_name LIMIT ?",
                        [min(n_top * 10, 500)]
                    ).fetchall()
                    candidate_genes = [r[0] for r in rows]
                all_stats = _cached_gene_stats(
                    db, db_id, candidate_genes, resolved_layer, fingerprint, cache,
                )
                # Sort by std descending; genes with no std sort last.
                all_stats.sort(key=lambda s: (s.get('std') or 0), reverse=True)
                return {"db_id": db_id, "layer": resolved_layer,
                        "stats": all_stats[:n_top], "top_by": "std"}
        return await asyncio.to_thread(_sync_work)
    except HTTPException:
        raise
    except KeyError as exc:
        raise HTTPException(status_code=404, detail=str(exc))
    except Exception as exc:
        raise HTTPException(status_code=500, detail=str(exc))


def _cached_gene_stats(db, db_id: str, gene_list: List[str], layer: str,
                       fingerprint: Optional[str], cache) -> List[Dict[str, Any]]:
    """Batched per-(db, gene) stats with SQLite caching.

    Buckets the requested genes into cache hits vs misses (case_sensitive=True
    to match the endpoint), computes misses via one batched ``db.get_gene_stats``
    call, and writes them back to cache. Preserves the caller's gene ordering.

    Also reuses the dataset-level distribution cache so the rank_mean /
    scaled_mean columns are populated without a fresh layer scan.
    """
    if not gene_list:
        return []
    # Case_sensitive=True is the endpoint's implicit behavior; keep it stable
    # so cache keys don't churn between callers.
    case_sensitive = True
    cached: Dict[str, Dict[str, Any]] = {}
    missing: List[str] = []
    if fingerprint:
        for g in gene_list:
            hit = cache.get(db_id, g, case_sensitive, layer, fingerprint)
            if hit is not None:
                cached[g] = hit
            else:
                missing.append(g)
    else:
        missing = list(gene_list)

    computed: List[Dict[str, Any]] = []
    if missing:
        precomputed_dist = None
        if fingerprint:
            precomputed_dist = cache.get_distribution(db_id, layer, fingerprint)
        computed = db.get_gene_stats(
            missing, layer=layer, case_sensitive=case_sensitive,
            precomputed_dist=precomputed_dist,
        )
        # Write back — under the caller's queried names (matches cache keys).
        if fingerprint:
            if precomputed_dist is None and getattr(db, '_last_distribution', None):
                cache.put_distribution(db_id, layer, fingerprint, db._last_distribution)
            for s in computed:
                queried = s.get('gene')
                if not queried:
                    continue
                cache.put(db_id, queried, case_sensitive, layer, fingerprint, s)

    # Preserve caller order.
    by_gene: Dict[str, Dict[str, Any]] = {}
    by_gene.update(cached)
    for s in computed:
        g = s.get('gene')
        if g is not None:
            by_gene[g] = s
    return [by_gene[g] for g in gene_list if g in by_gene]


@app.get("/gene_stats_all", tags=["genes"])
async def get_gene_stats_all(
    genes: str = Query(..., description="Comma-separated gene names, e.g. APOE,CLU"),
    case_sensitive: bool = Query(False, description="Case-sensitive gene name matching (default: False)"),
    organism: Optional[str] = Query(None, description="Comma-separated organism filter (e.g. 'mouse' or 'human,mouse')"),
    cell_type: Optional[str] = Query(None, description="Comma-separated mus cell_type filter (e.g. 'microglial cell,astrocyte')"),
    source: Optional[str] = Query(None, description="Comma-separated source filter (e.g. 'internal' or 'internal,external')"),
    access: Optional[str] = Query(None, description="Comma-separated access filter ('internal' / 'public')"),
    tissue: Optional[str] = Query(None, description="Comma-separated tissue filter (free text; UBERON-aligned where available)"),
    include_remote: bool = Query(False, description="Include S3-remote duckdbs (slow). Default false — only locally-resident datasets are queried."),
    refresh: bool = Query(False, description="Bypass the cache; recompute and overwrite cached entries")
):
    """
    Get expression statistics for selected genes across **all** databases that have a `default_layer`.

    For each qualifying database the `default_layer` is used automatically.
    Gene names are matched case-insensitively by default (so `APOE` matches `Apoe`).
    When the stored name differs from the queried name a `gene_found` field is included in the result.

    **Filters** (all optional, comma-separated, AND-combined across params, OR within a param):
    - `organism`: human, mouse, rat, macaque, zebrafish, drosophila
    - `cell_type`: mus controlled vocab (microglial cell, astrocyte, oligodendrocyte, …)
    - `source`: internal, external
    - `access`: internal, public
    - `tissue`: free text, UBERON-aligned where available (e.g. brain)
    - `include_remote`: include S3-remote-only datasets (slow). Default off.

    **Serving path** (fastest → slowest):
    1. Precomputed fleet-wide parquet (`gene_stats_index.parquet`) — covers
       the hot-gene set built by `ant-gene-stats-precompute`. Sub-second.
    2. Per-(db, gene) SQLite cache (90-day TTL, `tmp/gene_stats_cache.db`)
       for previously-scanned live queries.
    3. Live `AnthiveDB.get_gene_stats` — the historical slow path, still
       used for genes not in either cache.

    Each result carries a `served_from` field (`parquet` / `cache` /
    `live` / `mixed`). The top-level `parquet` block reports overall hit
    counts against the precomputed index.

    Pass `refresh=true` to bypass ALL caches (including the parquet) and
    force live recompute.

    Returns:
    - **results**: list of per-database entries, each with `db_id`, `title`, `n_cells`, `layer`, `stats`
    - **n_databases**: number of databases queried
    - **n_skipped**: number of databases skipped (no default_layer or error)
    - **n_filtered**: number of databases excluded by filters / remote flag
    - **cache_hits / cache_misses / cache_writes**: counters for visibility

    Example:
        GET /gene_stats_all?genes=APOE,TREM2
        GET /gene_stats_all?genes=APOE,TREM2&organism=mouse&cell_type=microglial%20cell
        GET /gene_stats_all?genes=APOE&source=internal&access=internal
    """
    gene_list = [g.strip() for g in genes.split(',') if g.strip()]

    def _csv_set(raw: Optional[str]) -> Optional[set]:
        if not raw:
            return None
        # mus values often have spaces ("microglial cell") — strip but preserve case.
        return {v.strip() for v in raw.split(',') if v.strip()}

    organism_f = _csv_set(organism)
    cell_type_f = _csv_set(cell_type)
    source_f = _csv_set(source)
    access_f = _csv_set(access)
    tissue_f = _csv_set(tissue)

    def _meta_matches(meta: Dict[str, Any]) -> bool:
        def _has(field, allowed):
            if allowed is None:
                return True
            return str(meta.get(field, '')).strip() in allowed
        return (
            _has('organism', organism_f)
            and _has('cell_type', cell_type_f)
            and _has('source', source_f)
            and _has('access', access_f)
            and _has('tissue', tissue_f)
        )

    # ── Build the work-list: dbs that survive filters and have a layer ────
    targets: List[Tuple[str, Dict[str, Any], str, Optional[str]]] = []
    n_filtered = 0
    n_skipped_no_layer = 0
    for db_id_inner, meta in registry.metadata_cache.items():
        layer = meta.get('default_layer')
        if not layer:
            n_skipped_no_layer += 1
            continue
        db_url = registry.databases.get(db_id_inner, '')
        if (not include_remote) and db_url.startswith('s3://'):
            n_filtered += 1
            continue
        if not _meta_matches(meta):
            n_filtered += 1
            continue

        # Compute the cache fingerprint for this db. Use mus sha256 + day-
        # bucketed mtime. If either is missing, fingerprint=None → bypass cache.
        mus_sha = str(meta.get('sha256') or '').strip()
        duckdb_mtime = 0.0
        if not db_url.startswith('s3://'):
            try:
                duckdb_mtime = Path(db_url).stat().st_mtime
            except OSError:
                duckdb_mtime = 0.0
        fingerprint = GeneStatsCache.fingerprint(mus_sha or None, duckdb_mtime)
        targets.append((db_id_inner, meta, layer, fingerprint))

    cache = registry.gene_stats_cache
    gene_stats_index = registry.gene_stats_index

    # ── Per-db worker: parquet-first, then SQLite cache, then live query ──
    def _query_one(db_id_inner: str, meta: Dict[str, Any], layer: str,
                   fingerprint: Optional[str]) -> Tuple[Optional[Dict[str, Any]], int, int, int, int]:
        """Return ``(entry, hits, misses, writes, parquet_hits)`` for one dataset.

        Layered lookup:
          1. Fleet-wide precomputed parquet (`gene_stats_index.parquet`) —
             a hot-gene set covering the vast majority of the /genes atlas
             traffic. O(1) hash lookup, no duckdb open.
          2. Per-(db, gene) SQLite cache — for genes previously scanned live.
          3. Live `AnthiveDB.get_gene_stats` — the historical slow path.
        `served_from` on the entry reflects which of the three actually
        answered every queried gene ('parquet' / 'cache' / 'live' /
        'parquet+live' when mixed).
        """
        hits = misses = writes = 0
        parquet_hits = 0
        parquet_stats: List[Dict[str, Any]] = []
        cached_stats: List[Dict[str, Any]] = []

        # (1) Parquet-first — bucket parquet hits vs the rest.
        remaining_genes: List[str] = []
        if not refresh:
            for g in gene_list:
                hit = gene_stats_index.lookup(db_id_inner, g, case_sensitive)
                if hit is not None:
                    parquet_stats.append(hit)
                    parquet_hits += 1
                else:
                    remaining_genes.append(g)
        else:
            remaining_genes = list(gene_list)

        # (2) SQLite cache — for genes not served by parquet.
        missing_genes: List[str] = []
        if fingerprint and not refresh:
            for g in remaining_genes:
                hit = cache.get(db_id_inner, g, case_sensitive, layer, fingerprint)
                if hit is not None:
                    cached_stats.append(hit)
                    hits += 1
                else:
                    missing_genes.append(g)
                    misses += 1
        else:
            missing_genes = list(remaining_genes)
            misses = len(remaining_genes)

        # (3) Live query — final fallback (the historical slow path).
        computed_stats: List[Dict[str, Any]] = []
        if missing_genes:
            precomputed_dist: Optional[Dict[str, Any]] = None
            if fingerprint and not refresh:
                precomputed_dist = cache.get_distribution(db_id_inner, layer, fingerprint)
            try:
                with _pooled_db(db_id_inner) as db:
                    computed_stats = db.get_gene_stats(
                        missing_genes, layer=layer, case_sensitive=case_sensitive,
                        precomputed_dist=precomputed_dist,
                    )
                    if (fingerprint
                            and precomputed_dist is None
                            and getattr(db, '_last_distribution', None)):
                        cache.put_distribution(
                            db_id_inner, layer, fingerprint, db._last_distribution
                        )
            except Exception:
                return None, hits, misses, writes, parquet_hits

            if fingerprint:
                for s in computed_stats:
                    queried = s.get('gene')
                    if not queried:
                        continue
                    cache.put(db_id_inner, queried, case_sensitive, layer, fingerprint, s)
                    writes += 1

        # Re-order to match gene_list (so the response is stable per-call).
        all_stats = parquet_stats + cached_stats + computed_stats
        by_gene = {s.get('gene'): s for s in all_stats if s.get('gene')}
        ordered = [by_gene[g] for g in gene_list if g in by_gene]
        # Genes that returned nothing at all (e.g. resolve failed) — pass through.
        ordered.extend(s for s in all_stats if s.get('gene') not in gene_list)

        # served_from surface — mirrors the layering above.
        n_total = len(gene_list)
        if parquet_hits == n_total:
            served_from = 'parquet'
        elif parquet_hits == 0 and hits == n_total:
            served_from = 'cache'
        elif parquet_hits == 0 and hits == 0:
            served_from = 'live'
        elif parquet_hits > 0 and (hits + len(computed_stats)) == 0:
            served_from = 'parquet'    # some genes not in the parquet were absent from the db
        elif parquet_hits > 0:
            served_from = 'mixed'
        else:
            served_from = 'live'

        entry = {
            'db_id': db_id_inner,
            'group': registry._db_extra.get(db_id_inner, {}).get('group_id', ''),
            'title': meta.get('title', db_id_inner),
            'n_cells': meta.get('n_cells', 0),
            'layer': layer,
            'served_from': served_from,
            'stats': ordered,
        }
        return entry, hits, misses, writes, parquet_hits

    # ── Run in parallel — duckdb queries release the GIL on .execute ──────
    def _run_all_parallel():
        from concurrent.futures import ThreadPoolExecutor, as_completed

        results_local: List[Dict[str, Any]] = []
        h_total = m_total = w_total = p_total = 0
        skipped_local = 0
        with ThreadPoolExecutor(max_workers=12) as pool:
            futures = {
                pool.submit(_query_one, db_id_, meta_, layer_, fp_): db_id_
                for (db_id_, meta_, layer_, fp_) in targets
            }
            for fut in as_completed(futures):
                entry, h, m, w, p = fut.result()
                h_total += h
                m_total += m
                w_total += w
                p_total += p
                if entry is None:
                    skipped_local += 1
                else:
                    results_local.append(entry)
        return results_local, skipped_local, h_total, m_total, w_total, p_total

    results, n_skipped_err, cache_hits, cache_misses, cache_writes, parquet_hits = await asyncio.to_thread(
        _run_all_parallel
    )
    n_skipped = n_skipped_no_layer + n_skipped_err

    # ── Cross-database CV per gene ─────────────────────────────────────────
    # Collect mean expression per gene across all databases (skip not-found)
    from collections import defaultdict
    import math as _math

    gene_means: Dict[str, List[float]] = defaultdict(list)
    for r in results:
        for s in r['stats']:
            if 'error' not in s and s.get('mean', 0) > 0:
                gene_means[s['gene']].append(s['mean'])

    # CV = std(means) / mean(means) across databases
    gene_cv: Dict[str, float] = {}
    for gene, means in gene_means.items():
        if len(means) >= 2:
            mu = sum(means) / len(means)
            if mu > 0:
                variance = sum((m - mu) ** 2 for m in means) / (len(means) - 1)
                gene_cv[gene] = round(_math.sqrt(variance) / mu, 4)

    # Rank CV among queried genes (0 = least variable, 1 = most variable)
    if gene_cv:
        sorted_genes = sorted(gene_cv, key=lambda g: gene_cv[g])
        n_cv = len(sorted_genes)
        gene_cv_rank = {g: round(i / (n_cv - 1), 4) if n_cv > 1 else 0.5
                        for i, g in enumerate(sorted_genes)}
        for r in results:
            for s in r['stats']:
                gene = s.get('gene')
                if gene in gene_cv:
                    s['cross_db_cv']      = gene_cv[gene]
                    s['rank_cross_db_cv'] = gene_cv_rank[gene]
    # ──────────────────────────────────────────────────────────────────────

    return {
        'genes': gene_list,
        'case_sensitive': case_sensitive,
        'n_databases': len(results),
        'n_skipped': n_skipped,
        'n_filtered': n_filtered,
        'filters': {
            'organism': sorted(organism_f) if organism_f else None,
            'cell_type': sorted(cell_type_f) if cell_type_f else None,
            'source': sorted(source_f) if source_f else None,
            'access': sorted(access_f) if access_f else None,
            'tissue': sorted(tissue_f) if tissue_f else None,
            'include_remote': include_remote,
        },
        'cache': {
            'hits': cache_hits,
            'misses': cache_misses,
            'writes': cache_writes,
            'refresh': refresh,
        },
        'parquet': {
            'hits':         parquet_hits,
            'loaded':       registry.gene_stats_index.is_loaded(),
            'n_index_rows': registry.gene_stats_index.n_rows,
        },
        'results': results,
    }


_CELLS_STREAM_CHUNK_ROWS = 5_000


def _cells_json_chunks(df: pd.DataFrame):
    """Yield the /cells JSON body (``{n_cells, n_columns, columns, data}``)
    in row chunks. Byte-identical to one ``df.to_json(orient='records')``
    wrapped in the metadata envelope, built directly (no re-parse) to avoid
    DataFrame -> JSON -> dicts -> JSON amplification."""
    columns = [str(col) for col in df.columns.tolist()]
    yield (f'{{"n_cells":{int(len(df))},"n_columns":{int(len(df.columns))},'
           f'"columns":{json.dumps(columns)},"data":[').encode('utf-8')
    first = True
    for start in range(0, len(df), _CELLS_STREAM_CHUNK_ROWS):
        records = df.iloc[start:start + _CELLS_STREAM_CHUNK_ROWS].to_json(
            orient='records', double_precision=6)[1:-1]
        if not records:
            continue
        if not first:
            yield b','
        yield records.encode('utf-8')
        first = False
    yield b']}'


def _cells_csv_chunks(df: pd.DataFrame):
    """Yield ``df.to_csv(index=False)`` in row chunks (header once)."""
    if len(df) == 0:
        yield df.to_csv(index=False).encode('utf-8')
        return
    for start in range(0, len(df), _CELLS_STREAM_CHUNK_ROWS):
        yield df.iloc[start:start + _CELLS_STREAM_CHUNK_ROWS].to_csv(
            index=False, header=(start == 0)).encode('utf-8')


@app.get("/databases/{db_id:path}/cells", tags=["data"])
def get_cells(
    db_id: str,
    genes: Optional[str] = Query(None, description="Comma-separated gene names"),
    metadata: Optional[str] = Query(None, description="Comma-separated metadata fields, '*' for all"),
    layer: str = Query("X", description="Layer name"),
    filter: Optional[List[str]] = Query(None, description="Filters: field:value or field:min,max"),
    limit: int = Query(50000, description="Maximum cells (default 50000, max 500000)"),
    format: str = Query("json", description="Output format: json, csv, parquet")
):
    """
    Get cell table with expression and metadata

    Query Parameters:
    - genes: Comma-separated gene names to include
    - metadata: Comma-separated fields, "*" for all, empty/omit for none
    - layer: Layer name (default: "X")
    - filter: Filters in format field:value or field:min,max
    - limit: Maximum cells (optional, returns all if not specified)
    - format: Output format (json, csv, parquet)

    Examples:
        GET /databases/my_db/cells?genes=CD4,CD8&metadata=cell_type&layer=X
        GET /databases/my_db/cells?genes=CD4&filter=cell_type:T-cell&limit=100
        GET /databases/my_db/cells?metadata=*&format=csv
    """
    try:
        # Cap limit to prevent OOM on large datasets
        limit = min(limit, 500_000)

        # Parse parameters
        gene_list = genes.split(',') if genes else None

        # Handle metadata parameter
        if metadata is None or metadata == "":
            metadata_list = None  # No metadata
        elif metadata == "*":
            metadata_list = ["*"]  # All metadata
        else:
            metadata_list = metadata.split(',')

        # Parse filters
        filters = {}
        if filter:
            for f in filter:
                # Split at the first lone ':' so score columns like
                # 'GWAS0000::GWAS::bellenguez' keep their '::' separators.
                parts = re.split(r'(?<!:):(?!:)', f, maxsplit=1)
                if len(parts) != 2 or not parts[0]:
                    raise ValueError(f"Invalid filter format: {f}")
                field, value = parts

                # Values stay text: AnthiveDB coerces per column type, so a
                # categorical label like '007' is not mangled into 7.0.
                # 'a,b' is a numeric range or a 2-value IN list (AnthiveDB
                # picks by column type); three or more values are an IN list.
                if ',' in value:
                    items = value.split(',')
                    filters[field] = tuple(items) if len(items) == 2 else items
                else:
                    filters[field] = value

        # Get data
        with _pooled_db(db_id) as db:
            df = db.get_cell_table(
                genes=gene_list,
                metadata_fields=metadata_list,
                layer=layer,
                filters=filters,
                limit=limit
            )

        # Return in requested format. CSV and JSON are streamed in row chunks:
        # one to_csv/to_json call over a large frame holds the GIL for
        # seconds (2.8 s for 543k cells x 20 genes), stalling every other
        # request; per-chunk calls in the threadpool cap that at ~0.1 s.
        if format == "csv":
            # Generate filename (max 60 chars)
            base_name = db_id.replace('/', '_')
            filename = f"{base_name}_cells.csv"
            if len(filename) > 60:
                # Truncate base_name to fit within 60 chars including suffix
                max_base = 60 - len("_cells.csv")
                filename = f"{base_name[:max_base]}_cells.csv"
            return StreamingResponse(
                _cells_csv_chunks(df),
                media_type="text/csv",
                headers={"Content-Disposition": f"attachment; filename={filename}"}
            )
        elif format == "parquet":
            output = BytesIO()
            df.to_parquet(output, index=False)
            # Generate filename (max 60 chars)
            base_name = db_id.replace('/', '_')
            filename = f"{base_name}_cells.parquet"
            if len(filename) > 60:
                # Truncate base_name to fit within 60 chars including suffix
                max_base = 60 - len("_cells.parquet")
                filename = f"{base_name[:max_base]}_cells.parquet"
            return Response(
                content=output.getvalue(),
                media_type="application/octet-stream",
                headers={"Content-Disposition": f"attachment; filename={filename}"}
            )
        else:  # json
            return StreamingResponse(_cells_json_chunks(df), media_type="application/json")

    except HTTPException:
        raise
    except KeyError as e:
        raise HTTPException(status_code=404, detail=str(e))
    except ValueError as e:
        raise HTTPException(status_code=400, detail=str(e))
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


