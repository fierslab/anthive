def _handle_rolling(req: PlotRequest, ctx: PlotContext) -> Tuple[bytes, str]:
    """Rolling-mean trajectory along a continuous x (typically pseudotime).

    Required:
        x:    a continuous obs/gene field — the trajectory axis.
        y:    comma-separated list of continuous fields (genes or
              numerical obs).  Each becomes a line.
    Optional:
        color: categorical → one line per group per y.
    """
    if not req.x or not req.y:
        raise HTTPException(400, detail=(
            "geom='rolling' requires x (continuous trajectory axis, "
            "e.g. pseudotime) AND y (comma-separated continuous fields)."
        ))
    x_name, x_kind = ctx.resolve(req.x)
    if x_kind == 'categorical':
        raise HTTPException(400, detail=(
            f"geom='rolling' x must be continuous (gene or numerical); "
            f"'{req.x}' resolved as '{x_kind}'."
        ))

    # Resolve every y in the comma-separated list.
    y_raw = [s.strip() for s in req.y.split(',') if s.strip()]
    y_resolved: List[str] = []
    y_kinds: List[str] = []
    for token in y_raw:
        name, kind = ctx.resolve(token)
        if kind == 'categorical':
            raise HTTPException(400, detail=(
                f"geom='rolling' y fields must be continuous; "
                f"'{token}' resolved as 'categorical'."
            ))
        y_resolved.append(name)
        y_kinds.append(kind)
    if not y_resolved:
        raise HTTPException(400, detail="geom='rolling' needs at least one y field.")

    # Optional grouping.
    color_field_name: Optional[str] = None
    color_kind = 'categorical'
    if req.color:
        color_field_name, color_kind = ctx.resolve(req.color)
        if color_kind != 'categorical':
            raise HTTPException(400, detail=(
                f"geom='rolling' color must be categorical (group split); "
                f"'{req.color}' resolved as '{color_kind}'."
            ))

    # Fetch x + all y values + optional grouping in a single trip.  Genes
    # go via the layer; numerical obs come from obsnum.
    genes: List[str] = []
    metas: List[str] = []
    if x_kind == 'gene':   genes.append(x_name)
    else:                  metas.append(x_name)
    for name, kind in zip(y_resolved, y_kinds):
        (genes if kind == 'gene' else metas).append(name)
    if color_field_name:
        metas.append(color_field_name)
    # de-dupe preserving order
    genes = list(dict.fromkeys(genes))
    metas = list(dict.fromkeys(metas))
    data_df = ctx.db.get_cell_table(
        genes=genes or None,
        metadata_fields=metas or None,
        layer=req.layer,
        filters=req.filters,
        sample=req.sample,
    )

    n_cells = int(len(data_df))
    n_groups = (int(data_df[color_field_name].nunique())
                if color_field_name else None)
    if req.output_format in _PLOT_DATA_FORMATS:
        return _emit_dataframe(data_df, req)
    caption = plotting.build_caption(
        req.db_id, req.geom, x_name, x_kind,
        ', '.join(y_resolved), color_field_name, req.layer,
        n_cells=n_cells, n_groups=n_groups,
        sample=req.sample, subset=_subset_for_caption(req),
        window=req.window, show_band=req.show_band,
        log_x=req.log_x, log_y=req.log_y,
        palette_cat=req.palette_cat,
    )
    image_bytes = plotting.plot_rolling(
        data_df=data_df,
        x_field=x_name,
        y_fields=y_resolved,
        color_field=color_field_name,
        color_kind=color_kind,
        window=req.window,
        show_band=req.show_band,
        width=req.width, height=req.height, dpi=req.dpi,
        output_format=req.output_format,
        palette_cat=req.palette_cat,
        palette_cont=req.palette_cont,
        palette_div=req.palette_div,
        title_extra=req.db_id,
        caption=caption, source_url=req.source_url,
        font_family=req.font_family, font_size=req.font_size,
    )
    return image_bytes, caption


def _handle_heatmap(req: PlotRequest, ctx: PlotContext) -> Tuple[bytes, str]:
    if not req.y:
        raise HTTPException(400, detail="geom='heatmap' requires y (categorical field)")
    y_name, y_kind = ctx.resolve(req.y)
    if y_kind != 'categorical':
        raise HTTPException(400, detail=(
            f"geom='heatmap' requires y to be categorical; '{req.y}' resolved as '{y_kind}'"
        ))
    if req.x:
        # Resolve each gene exactly once (was duplicated in the v0 implementation).
        gene_list: List[str] = []
        for g in (s.strip() for s in req.x.split(',')):
            hits = ctx.db.search_genes(g, exact=True, limit=1)
            if hits:
                gene_list.append(hits[0])
        if not gene_list:
            raise HTTPException(400, detail=f"None of the genes in x='{req.x}' were found")
    else:
        gene_list = _get_top_genes_by_mean(ctx.db, req.n_genes, req.layer)

    data_df = ctx.db.get_cell_table(genes=gene_list, metadata_fields=[y_name],
                                    layer=req.layer, filters=req.filters, sample=req.sample)
    mean_expr_df = data_df.groupby(y_name)[gene_list].mean()

    n_cells = int(len(data_df))
    n_groups = int(mean_expr_df.shape[0])
    # Row-cardinality cap. y=donor_id (500 levels) × default 20 genes
    # produces a 500-row heatmap nobody can read. Refuse early with
    # the same helpful-400 shape as bar / de_heatmap. n_genes is
    # already constrained at the endpoint (le=200), so we only cap rows.
    _HEATMAP_ROW_CAP = 100
    if n_groups > _HEATMAP_ROW_CAP:
        raise HTTPException(400, detail=(
            f"heatmap has {n_groups} rows (y='{y_name}': {n_groups} levels); "
            f"capped at {_HEATMAP_ROW_CAP}. Pick a lower-cardinality y "
            f"field or apply a subset filter."
        ))
    if req.output_format in _PLOT_DATA_FORMATS:
        # Heatmap exports the AGGREGATED matrix (per-group mean per gene),
        # since that's what's drawn — raw cell-level data wouldn't
        # reconstruct the figure without re-aggregation.
        return _emit_dataframe(mean_expr_df.reset_index(), req)
    caption = plotting.build_caption(
        req.db_id, req.geom, req.x, 'gene', y_name, None, req.layer,
        n_cells=n_cells, n_groups=n_groups,
        sample=req.sample, subset=_subset_for_caption(req),
        zscore=req.zscore,
        color_scale=req.color_scale,
        palette_cont=req.palette_cont, palette_div=req.palette_div,
    )
    image_bytes = plotting.plot_heatmap(
        mean_expr_df=mean_expr_df,
        width=req.width, height=req.height, dpi=req.dpi,
        output_format=req.output_format,
        palette_cont=req.palette_cont,
        palette_div=req.palette_div,
        color_scale=req.color_scale,
        zscore=req.zscore,
        title_extra=req.db_id,
        caption=caption, source_url=req.source_url,
        font_family=req.font_family, font_size=req.font_size,
    )
    return image_bytes, caption


# ── DE-driven handlers ────────────────────────────────────────────────────────

def _de_contrast_dataframe(req: PlotRequest, ctx: PlotContext) -> Any:
    """Pull every row from __de for (req.de_study, req.de_term, req.de_contrast)
    into a pandas DataFrame.  Raises 404-flavoured HTTPException if the triple
    matches nothing.

    Returns columns: gene_name, log2fc, zeff, effsize, efftype, pvalue, padj,
    estimate, SE, ci_low, ci_high, base_mean (extracted from stats_extra).
    """
    if not req.de_study:
        raise HTTPException(400, detail=f"geom='{req.geom}' requires ?study=<study_id>")
    if not req.de_term:
        raise HTTPException(400, detail=f"geom='{req.geom}' requires ?term=<term>")
    if not req.de_contrast:
        raise HTTPException(400, detail=f"geom='{req.geom}' requires ?contrast=<contrast>")
    if not lib_de_storage.has_de_data(ctx.db.conn):
        raise HTTPException(
            404, detail=f"dataset '{req.db_id}' has no DE data ingested",
        )
    sql = """
        SELECT g.gene_name,
               d.log2fc, d.zeff, d.effsize, d.efftype,
               d.pvalue, d.padj,
               d.estimate, d.SE, d.ci_low, d.ci_high,
               d.stats_extra
        FROM __de d
        JOIN __genes g USING (gene_id)
        WHERE d.study_id = ? AND d.term = ? AND d.contrast = ?
    """
    df = ctx.db.conn.execute(sql, [req.de_study, req.de_term, req.de_contrast]).fetchdf()
    if len(df) == 0:
        raise HTTPException(
            404,
            detail=(f"no DE rows for study={req.de_study!r}, term={req.de_term!r}, "
                    f"contrast={req.de_contrast!r} on '{req.db_id}'"),
        )
    # Pull base_mean out of stats_extra JSON if present, so the MA plot can use it.
    import json as _json
    def _extract_base_mean(s):
        if not s:
            return None
        try:
            return _json.loads(s).get('base_mean')
        except (TypeError, _json.JSONDecodeError):
            return None
    df['base_mean'] = df['stats_extra'].map(_extract_base_mean)
    return df


def _handle_volcano(req: PlotRequest, ctx: PlotContext) -> Tuple[bytes, str]:
    df = _de_contrast_dataframe(req, ctx)
    if req.output_format in _PLOT_DATA_FORMATS:
        return _emit_dataframe(df, req)
    # Mirror plot_volcano's axis-fallback logic when building the caption,
    # so the X-Plot-Caption header agrees with the in-figure title for
    # zeff-only studies (the fallback auto-zeros log2fc_threshold and
    # switches the axis label).  Without this, web clients see
    # title='padj only' but caption='|log2fc|>=1' — visibly inconsistent.
    has_log2fc = df['log2fc'].notna().any()
    if has_log2fc:
        axis_label   = 'log2fc'
        threshold_in_caption = req.log2fc_threshold
    else:
        kind = (df['efftype'].mode().iat[0]
                if 'efftype' in df.columns and df['efftype'].notna().any() else 'effect')
        axis_label = kind
        threshold_in_caption = (
            0.0 if req.log2fc_threshold == 1.0 else req.log2fc_threshold
        )
    if threshold_in_caption and threshold_in_caption > 0:
        thresh_text = f"|{axis_label}|>={threshold_in_caption:g}"
    else:
        thresh_text = "padj only"
    n_genes = int(len(df))
    if has_log2fc:
        n_sig = int(((df['padj'].fillna(1.0) <= req.padj_threshold)
                     & (df['log2fc'].abs() >= req.log2fc_threshold)).sum())
        effect_blurb = (
            f'log2 fold change on the x-axis (positive = higher in '
            f'{req.de_contrast}, negative = lower in {req.de_contrast})'
        )
    else:
        n_sig = int((df['padj'].fillna(1.0) <= req.padj_threshold).sum())
        effect_blurb = f'{axis_label} on the x-axis (effect size on a study-native scale)'
    knobs: List[str] = []
    if req.log2fc_clip is not None and req.log2fc_clip > 0:
        knobs.append(
            f'effect axis clamped to [-{req.log2fc_clip:g}, +{req.log2fc_clip:g}] '
            f'(out-of-range points pinned to the boundary; significance still '
            f'uses the raw value)'
        )
    if req.neglog10p_clip is not None and req.neglog10p_clip > 0:
        knobs.append(
            f'-log10(padj) axis clamped at {req.neglog10p_clip:g} '
            f'(saturated p=0 genes pin to the ceiling)'
        )
    knobs_text = f' Visual clamps: {"; ".join(knobs)}.' if knobs else ''
    caption = (
        f"Volcano plot of the differential-expression contrast '{req.de_contrast}' "
        f"under the '{req.de_term}' term of study '{req.de_study}' in dataset "
        f"{req.db_id}. Each point is one gene; {effect_blurb}, "
        f"-log10(adjusted p-value) on the y-axis. "
        f"{n_genes:,} genes tested; "
        f"{n_sig:,} pass the significance gate (padj<={req.padj_threshold:g}, {thresh_text}) "
        f"and are coloured by direction of effect, the rest plotted in grey. "
        f"Top {req.n_label} most-significant genes annotated by name; "
        f"label positions de-overlapped via adjustText with thin leader lines.{knobs_text}"
    )
    image_bytes = plotting.plot_volcano(
        df,
        padj_threshold=req.padj_threshold,
        log2fc_threshold=req.log2fc_threshold,
        log2fc_clip=req.log2fc_clip,
        neglog10p_clip=req.neglog10p_clip,
        n_label=req.n_label,
        width=req.width, height=req.height, dpi=req.dpi,
        output_format=req.output_format,
        palette_cat=req.palette_cat,
        title_extra=f'{req.db_id} · {req.de_term} · {req.de_contrast}',
        caption=caption, source_url=req.source_url,
        font_family=req.font_family, font_size=req.font_size,
    )
    return image_bytes, caption


def _handle_ma(req: PlotRequest, ctx: PlotContext) -> Tuple[bytes, str]:
    df = _de_contrast_dataframe(req, ctx)
    if req.output_format in _PLOT_DATA_FORMATS:
        return _emit_dataframe(df, req)
    if df['base_mean'].notna().sum() == 0:
        raise HTTPException(
            400,
            detail=(f"MA plot needs base_mean for each gene, but the DE rows for "
                    f"{req.de_study}/{req.de_term}/{req.de_contrast} don't carry it. "
                    f"This typically means the upstream tool (GLMM / wilcoxon) "
                    f"didn't emit baseMean — try the DESeq2 / edgeR DE source "
                    f"instead, or use the volcano plot."),
        )
    n_genes = int(df['base_mean'].notna().sum())
    n_sig = int(((df['padj'].fillna(1.0) <= req.padj_threshold)
                 & (df['log2fc'].abs() >= req.log2fc_threshold)).sum())
    knobs: List[str] = []
    if req.log2fc_clip is not None and req.log2fc_clip > 0:
        knobs.append(
            f'log2fc axis (y) clamped to [-{req.log2fc_clip:g}, +{req.log2fc_clip:g}]'
        )
    if req.logmean_clip is not None:
        knobs.append(
            f'log10(mean expression) axis (x) clamped at {req.logmean_clip:g} '
            f'(high-expressor tail compressed)'
        )
    knobs_text = f' Visual clamps: {"; ".join(knobs)}.' if knobs else ''
    caption = (
        f"MA plot of the differential-expression contrast '{req.de_contrast}' under "
        f"the '{req.de_term}' term of study '{req.de_study}' in dataset {req.db_id}. "
        f"x-axis: log10(mean expression across cells); y-axis: log2 fold change "
        f"(positive = higher in {req.de_contrast}). Each point is one gene; "
        f"{n_genes:,} genes have a non-null mean expression (the requirement for "
        f"MA), and {n_sig:,} pass the significance gate (padj<={req.padj_threshold:g}, "
        f"|log2fc|>={req.log2fc_threshold:g}). "
        f"Top {req.n_label} most-significant genes annotated, label positions "
        f"de-overlapped via adjustText.{knobs_text}"
    )
    image_bytes = plotting.plot_ma(
        df,
        padj_threshold=req.padj_threshold,
        log2fc_threshold=req.log2fc_threshold,
        log2fc_clip=req.log2fc_clip,
        logmean_clip=req.logmean_clip,
        n_label=req.n_label,
        width=req.width, height=req.height, dpi=req.dpi,
        output_format=req.output_format,
        palette_cat=req.palette_cat,
        title_extra=f'{req.db_id} · {req.de_term} · {req.de_contrast}',
        caption=caption, source_url=req.source_url,
        font_family=req.font_family, font_size=req.font_size,
    )
    return image_bytes, caption


def _handle_forest(req: PlotRequest, ctx: PlotContext) -> Tuple[bytes, str]:
    if not req.de_gene:
        raise HTTPException(400, detail="geom='forest' requires ?gene=<gene_name>")
    if not lib_de_storage.has_de_data(ctx.db.conn):
        raise HTTPException(
            404, detail=f"dataset '{req.db_id}' has no DE data ingested",
        )
    # de_storage.get_gene_rows returns dicts; convert to a DataFrame.
    rows = lib_de_storage.get_gene_rows(ctx.db.conn, req.de_gene)
    if not rows:
        raise HTTPException(
            404, detail=f"gene '{req.de_gene}' not found in any DE study on '{req.db_id}'",
        )
    import pandas as _pd
    df = _pd.DataFrame(rows)
    # Filter further if user supplied study / term / contrast (optional narrowing).
    if req.de_study:
        df = df[df['study_id'] == req.de_study]
    if req.de_term:
        df = df[df['term'] == req.de_term]
    if req.de_contrast:
        df = df[df['contrast'] == req.de_contrast]
    if len(df) == 0:
        raise HTTPException(
            404,
            detail=(f"gene {req.de_gene!r} has DE rows but none match the "
                    f"requested filters (study={req.de_study!r}, term={req.de_term!r}, "
                    f"contrast={req.de_contrast!r})"),
        )
    if req.output_format in _PLOT_DATA_FORMATS:
        return _emit_dataframe(df, req)
    n_studies = int(df['study_id'].nunique())
    n_terms = int(df['term'].nunique())
    n_contrasts = int(df['contrast'].nunique())
    has_ci = (df.get('ci_low', _pd.Series(dtype=float)).notna().any()
              and df.get('ci_high', _pd.Series(dtype=float)).notna().any())
    n_sig = int((df['padj'].fillna(1.0) <= req.padj_threshold).sum())
    filter_bits = []
    if req.de_study:    filter_bits.append(f"study='{req.de_study}'")
    if req.de_term:     filter_bits.append(f"term='{req.de_term}'")
    if req.de_contrast: filter_bits.append(f"contrast='{req.de_contrast}'")
    filter_text = (
        ' (further restricted to ' + ', '.join(filter_bits) + ')'
        if filter_bits else ''
    )
    ci_text = '95% CI bars drawn from ci_low / ci_high' if has_ci else 'no CI bars (the upstream studies did not store ci_low / ci_high)'
    caption = (
        f"Forest plot of gene {req.de_gene!r} across every (study, term, contrast) "
        f"with a DE result in dataset {req.db_id}{filter_text}. "
        f"Each row is one contrast: {len(df):,} row{'s' if len(df) != 1 else ''} total spanning "
        f"{n_studies} stud{'ies' if n_studies != 1 else 'y'}, {n_terms} term{'s' if n_terms != 1 else ''}, "
        f"{n_contrasts} contrast{'s' if n_contrasts != 1 else ''}. "
        f"Point = log2 fold change (falling back to the model estimate when log2fc is null); "
        f"{ci_text}. Rows with padj<={req.padj_threshold:g} are highlighted "
        f"({n_sig:,} pass)."
    )
    image_bytes = plotting.plot_forest(
        df,
        gene_name=req.de_gene,
        padj_threshold=req.padj_threshold,
        width=req.width, height=req.height, dpi=req.dpi,
        output_format=req.output_format,
        palette_cat=req.palette_cat,
        title_extra=req.db_id,
        caption=caption, source_url=req.source_url,
        font_family=req.font_family, font_size=req.font_size,
    )
    return image_bytes, caption


# Registry: geom → handler. Adding a new geom is now: write a handler,
# add a line here, add the geom name to _PLOT_GEOMS.
# Cap on the number of cells a de_heatmap can render. Larger and the
# image becomes a soup of mini-rectangles; users should pre-filter the
# contrast / gene axes via de_contrasts / de_genes.
_DE_HEATMAP_CAP = 2000

# Candidate value columns, in the order we'd auto-pick the first that
# has any non-null values. Caller can override with de_value.
_DE_HEATMAP_VALUE_COLS = ('estimate', 'log2fc', 'zeff', 'effsize')


def _handle_de_heatmap(req: PlotRequest, ctx: PlotContext) -> Tuple[bytes, str]:
    """Render a contrasts × genes/modules matrix of pre-computed DE values.

    Implements Sierksma Fig 2E / 4B-style heatmaps directly from
    `__de` rows: rows = contrast, columns = gene/module, fill =
    requested DE column (default: first of estimate / log2fc / zeff /
    effsize with non-null values for the (study, term) slice).
    """
    if not req.de_study:
        raise HTTPException(400, detail="geom='de_heatmap' requires de_study")
    if not req.de_term:
        raise HTTPException(400, detail="geom='de_heatmap' requires de_term")
    if not lib_de_storage.has_de_data(ctx.db.conn):
        raise HTTPException(
            404, detail=f"dataset '{req.db_id}' has no DE data ingested",
        )

    # Pick the value column. If caller specified, validate it's one of
    # the supported ones; else auto-pick.
    value_col: str
    if req.de_value:
        if req.de_value not in _DE_HEATMAP_VALUE_COLS:
            raise HTTPException(400, detail=(
                f"de_value must be one of {_DE_HEATMAP_VALUE_COLS}, "
                f"got {req.de_value!r}"
            ))
        value_col = req.de_value
    else:
        # Probe each candidate column for non-null content under the
        # (study, term) slice. Take the first one with data.
        chosen = None
        for col in _DE_HEATMAP_VALUE_COLS:
            n = ctx.db.conn.execute(
                f"SELECT count(*) FROM __de "
                f"WHERE study_id = ? AND term = ? AND {col} IS NOT NULL",
                [req.de_study, req.de_term],
            ).fetchone()[0]
            if n:
                chosen = col
                break
        if not chosen:
            raise HTTPException(404, detail=(
                f"no non-null DE values for study={req.de_study!r}, "
                f"term={req.de_term!r} (checked {_DE_HEATMAP_VALUE_COLS})"
            ))
        value_col = chosen

    # Optional contrast / gene filters (comma-separated). Refresh against
    # the live data so a typo gives an early 400.
    contrast_filter = None
    if req.de_contrasts:
        contrast_filter = [c.strip() for c in req.de_contrasts.split(',') if c.strip()]
    gene_filter = None
    if req.de_genes:
        gene_filter = [g.strip() for g in req.de_genes.split(',') if g.strip()]

    # Build SQL.
    where_parts = ["d.study_id = ?", "d.term = ?"]
    params: List = [req.de_study, req.de_term]
    if contrast_filter:
        placeholders = ','.join(['?'] * len(contrast_filter))
        where_parts.append(f"d.contrast IN ({placeholders})")
        params.extend(contrast_filter)
    if gene_filter:
        placeholders = ','.join(['?'] * len(gene_filter))
        where_parts.append(f"g.gene_name IN ({placeholders})")
        params.extend(gene_filter)
    sql = f"""
        SELECT d.contrast, g.gene_name, d.{value_col} AS value, d.padj
        FROM __de d JOIN __genes g USING (gene_id)
        WHERE {' AND '.join(where_parts)}
    """
    df = ctx.db.conn.execute(sql, params).fetchdf()
    if len(df) == 0:
        # Specialise the message when a filter is entirely off-target
        # (helps the user fix a typo). Probe whether the (study, term)
        # has ANY rows; if yes, the filter killed everything.
        if contrast_filter or gene_filter:
            base_n = ctx.db.conn.execute(
                "SELECT count(*) FROM __de WHERE study_id=? AND term=?",
                [req.de_study, req.de_term],
            ).fetchone()[0]
            if base_n > 0:
                # Surface a 'none of contrasts=' / 'none of genes='
                # message with the available alternatives.
                if contrast_filter:
                    avail = ctx.db.conn.execute(
                        "SELECT DISTINCT contrast FROM __de "
                        "WHERE study_id=? AND term=? ORDER BY contrast LIMIT 20",
                        [req.de_study, req.de_term],
                    ).fetchdf()['contrast'].tolist()
                    raise HTTPException(404, detail=(
                        f"none of contrasts={contrast_filter} match any DE "
                        f"rows for study={req.de_study!r}, term={req.de_term!r}. "
                        f"Available contrasts (up to 20): {avail}"
                    ))
                if gene_filter:
                    avail = ctx.db.conn.execute(
                        "SELECT DISTINCT g.gene_name FROM __de d "
                        "JOIN __genes g USING (gene_id) "
                        "WHERE d.study_id=? AND d.term=? "
                        "ORDER BY g.gene_name LIMIT 20",
                        [req.de_study, req.de_term],
                    ).fetchdf()['gene_name'].tolist()
                    raise HTTPException(404, detail=(
                        f"none of genes={gene_filter} match any DE rows "
                        f"for study={req.de_study!r}, term={req.de_term!r}. "
                        f"Available genes (up to 20): {avail}"
                    ))
        raise HTTPException(404, detail=(
            f"no DE rows for study={req.de_study!r}, term={req.de_term!r}"
            + (f" matching contrasts={contrast_filter}" if contrast_filter else "")
            + (f" matching genes={gene_filter}" if gene_filter else "")
        ))

    # Pivot into a contrast × gene matrix. Preserve a stable ordering:
    # rows in the order the filter requested (or natural sort of distinct
    # contrasts); columns same logic.
    n_contrasts = int(df['contrast'].nunique())
    n_genes = int(df['gene_name'].nunique())
    if n_contrasts * n_genes > _DE_HEATMAP_CAP:
        raise HTTPException(400, detail=(
            f"de_heatmap would have {n_contrasts * n_genes} cells "
            f"({n_contrasts} contrasts × {n_genes} genes/modules); "
            f"capped at {_DE_HEATMAP_CAP}. Narrow with de_contrasts="
            f"<list> and/or de_genes=<list>."
        ))

    # Flag user-requested filter values that didn't resolve. A typo in
    # ?contrasts=Foo would otherwise silently produce a smaller-than-
    # expected matrix (QA review B7).
    present_contrasts = set(df['contrast'].unique())
    present_genes = set(df['gene_name'].unique())
    missing_contrasts = (
        [c for c in contrast_filter if c not in present_contrasts]
        if contrast_filter else []
    )
    missing_genes = (
        [g for g in gene_filter if g not in present_genes]
        if gene_filter else []
    )
    if missing_contrasts and contrast_filter and not (set(contrast_filter) & present_contrasts):
        raise HTTPException(404, detail=(
            f"none of contrasts={contrast_filter} match any DE rows for "
            f"study={req.de_study!r}, term={req.de_term!r}. Available "
            f"contrasts (up to 20): "
            f"{sorted(present_contrasts)[:20]}"
        ))
    if missing_genes and gene_filter and not (set(gene_filter) & present_genes):
        raise HTTPException(404, detail=(
            f"none of genes={gene_filter} match any DE rows for "
            f"study={req.de_study!r}, term={req.de_term!r}. Available "
            f"genes (up to 20): {sorted(present_genes)[:20]}"
        ))

    if contrast_filter:
        row_order = [c for c in contrast_filter if c in present_contrasts]
    else:
        row_order = sorted(present_contrasts)
    if gene_filter:
        col_order = [g for g in gene_filter if g in present_genes]
    else:
        col_order = sorted(present_genes)

    matrix = df.pivot_table(
        index='contrast', columns='gene_name', values='value', aggfunc='first',
    ).reindex(index=row_order, columns=col_order)

    sig_mask = None
    if req.sig_overlay:
        sig_mat = df.pivot_table(
            index='contrast', columns='gene_name', values='padj', aggfunc='first',
        ).reindex(index=row_order, columns=col_order)
        sig_mask = sig_mat.le(req.padj_threshold).fillna(False)

    if req.output_format in _PLOT_DATA_FORMATS:
        # Export as long-form (one row per cell) — keeps the structure
        # explicit and avoids pandas-CSV's confusing multi-index header.
        return _emit_dataframe(
            df.rename(columns={'gene_name': 'gene'})[
                ['contrast', 'gene', 'value', 'padj']
            ],
            req,
        )

    n_sig_cells = int(sig_mask.sum().sum()) if sig_mask is not None else None
    extras: List[str] = []
    if req.sig_overlay:
        extras.append(
            f'Cells with padj<={req.padj_threshold:g} are overlaid with an '
            f'asterisk marker ({n_sig_cells:,} cells)'
        )
    if req.color_scale and req.color_scale != 'auto':
        extras.append(f'colour scale forced {req.color_scale}')
    extras_text = (' ' + '. '.join(extras) + '.') if extras else ''
    caption = (
        f"Differential-expression heatmap of the '{req.de_term}' term of study "
        f"'{req.de_study}' in dataset {req.db_id}: a {n_contrasts} x {n_genes} matrix "
        f"with contrasts on the rows and gene{'s' if n_genes != 1 else ''} / module{'s' if n_genes != 1 else ''} on the columns, "
        f"filled with the {value_col!r} column from __de (auto-picked from "
        f"{list(_DE_HEATMAP_VALUE_COLS)} unless overridden by &value=).{extras_text}"
    )
    if missing_contrasts:
        caption += f" (dropped {len(missing_contrasts)} unmatched contrasts: {missing_contrasts[:5]})"
    if missing_genes:
        caption += f" (dropped {len(missing_genes)} unmatched genes: {missing_genes[:5]})"
    image_bytes = plotting.plot_de_heatmap(
        matrix,
        value_label=value_col,
        row_label='contrast',
        col_label='gene' if n_genes > 50 else 'module/gene',
        sig_mask=sig_mask,
        width=req.width, height=req.height, dpi=req.dpi,
        output_format=req.output_format,
        palette_cont=req.palette_cont,
        palette_div=req.palette_div,
        color_scale=req.color_scale,
        annot=False,
        title_extra=req.db_id,
        caption=caption, source_url=req.source_url,
        font_family=req.font_family, font_size=req.font_size,
    )
    return image_bytes, caption


_PLOT_HANDLERS: Dict[str, Any] = {
    'scatter':    _handle_scatter,   # polymorphic — embedding when x is obsm,
    'hexbin':     _handle_hexbin,    # XY when x/y are continuous fields
    'violin':     _handle_grouped,
    'box':        _handle_grouped,
    'bar':        _handle_grouped,
    'histogram':  _handle_distribution,
    'ecdf':       _handle_distribution,
    'kde':        _handle_distribution,
    'heatmap':    _handle_heatmap,
    'rolling':    _handle_rolling,   # rolling-mean trajectory along pseudotime
    'kde2d':      _handle_kde2d,     # 2-D Gaussian KDE of two continuous fields
    'volcano':    _handle_volcano,   # DE: log2fc × -log10(padj)
    'ma':         _handle_ma,        # DE: base_mean × log2fc
    'forest':     _handle_forest,    # DE: one gene across many studies/terms/contrasts
    'de_heatmap': _handle_de_heatmap,# DE: contrasts × genes/modules matrix
}


# ── shared plot-request infrastructure ────────────────────────────────────────
#
# Every plot endpoint follows the same three-step pipeline:
#   1. CommonPlotParams (Depends) gathers the shared knobs (db_id, format,
#      figure size, palettes, fonts, subset, sample, the Request).
#   2. _build_plot_request() folds those plus the per-geom params into a
#      frozen PlotRequest — the contract the handlers consume.
#   3. _render_plot() does the cache lookup / handler dispatch / response.
#
# Per-geom endpoints therefore stay two lines of body, and their signatures
# document exactly which params apply to that geom (no kitchen-sink Query
# list, no "this param only matters for hexbin" comments).


class CommonPlotParams:
    """Shared plot-request parameters, injected via FastAPI ``Depends``.

    Every per-geom endpoint declares ``common: CommonPlotParams = Depends()``
    and receives the dataset id (from the path) plus every shared knob in a
    single object — keeping per-geom signatures focused on the params that
    geom actually understands.
    """

    def __init__(
        self,
        db_id: str = FastAPIPath(..., description="Dataset id, e.g. ``S25/V6W``"),
        output_format: str = Query(
            'png', alias='format',
            description=(
                "Output format. Image: ``png`` | ``svg`` | ``pdf``. "
                "Data export (same URL + params, returns the post-subset/"
                "post-sample dataframe the plot was built from, "
                "Content-Disposition: attachment): ``csv`` | ``tsv``."
            ),
        ),
        layer: str = Query('X', description="Expression layer to read (default ``X``)."),
        width: float = Query(8.0, gt=1.0, le=32.0, description="Figure width in inches (1–32)."),
        height: float = Query(6.0, gt=1.0, le=32.0, description="Figure height in inches (1–32)."),
        dpi: int = Query(150, ge=72, le=600, description="Resolution in dots per inch (72–600)."),
        palette_categorical: str = Query(
            'tab10',
            description=(
                "Qualitative palette for categorical / discrete colour. "
                "Examples: ``tab10``, ``tab20``, ``Set1``, ``Set2``, ``Paired``, ``Dark2``. "
                "Auto-bumps ``tab10`` → ``tab20`` when there are >10 distinct categories."
            ),
        ),
        palette_continuous: str = Query(
            'inferno_r',
            description=(
                "Sequential cmap for one-sided continuous data (counts, gene "
                "expression, %mt, …). Built-in matplotlib options: "
                "``inferno_r``, ``viridis``, ``plasma``, ``mako``, plus the "
                "title-case sequentials ``Blues`` / ``Reds`` / ``Greens`` / "
                "``Oranges`` / ``Purples`` / ``Greys``. Anthive also "
                "registers single-colour white→colour gradients: "
                "``magenta`` / ``blue`` / ``red`` / ``green`` / ``orange`` / "
                "``purple`` / ``cyan`` / ``yellow`` / ``black`` / ``tan`` / "
                "``greenyellow`` / ``turquoise`` / ``hotpink`` / ``brown`` "
                "and the reversed colour→white variants ``magenta_r`` / "
                "``blue_r`` / … (For greyscale use matplotlib's ``Greys`` "
                "or ``gray`` — anthive leaves those intact. Matplotlib's "
                "``pink`` is also preserved — use ``hotpink`` for the "
                "simple white→hot-pink gradient.)"
            ),
        ),
        palette_divergent: str = Query(
            'RdBu_r',
            description=(
                "Divergent cmap for data that straddles zero (z-scores, log "
                "fold change). Auto-selected when the data is detected as "
                "divergent. Examples: ``RdBu_r``, ``coolwarm``, ``PiYG``, ``BrBG``."
            ),
        ),
        color_scale: Optional[str] = Query(
            None,
            regex='^(auto|sequential|divergent)$',
            description=(
                "Override the sequential-vs-divergent heuristic for "
                "continuous colour. Default ``auto`` (or omitted) picks "
                "divergent when the data straddles zero with comparable "
                "magnitudes on each side; otherwise sequential. Force "
                "``sequential`` for one-sided ramps (uses "
                "``palette_continuous``) or ``divergent`` to centre on "
                "zero (uses ``palette_divergent``). Ignored for "
                "categorical colour."
            ),
        ),
        font_family: str = Query(
            'DejaVu Sans',
            description="matplotlib font family (e.g. 'Arial', 'Helvetica', 'DejaVu Sans', 'serif').",
        ),
        font_size: float = Query(
            10.0, ge=6.0, le=36.0,
            description="Base font size in pt; titles & ticks scale relative to this.",
        ),
        subset: List[str] = Query(
            default=[],
            description=(
                "Cell-subset filter(s) applied before plotting. Repeatable. "
                "Formats: ``field:value`` (exact), ``field:v1,v2`` (IN list), "
                "``field:min..max`` (range). Example: "
                "``?subset=sex:female&subset=condition:AD``."
            ),
        ),
        sample: Optional[int] = Query(
            None, ge=1, le=1_000_000,
            description=(
                "Random subsample: draw at most this many cells using DuckDB "
                "reservoir sampling (near-zero overhead, applied after subset "
                "filters). Example: ``sample=10000``."
            ),
        ),
        request: Request = None,  # type: ignore[assignment]
    ):
        if output_format not in _PLOT_MIME_TYPES:
            raise HTTPException(
                400,
                detail=f"Unknown format '{output_format}'. Valid: "
                       + ', '.join(sorted(_PLOT_MIME_TYPES.keys())),
            )
        self.db_id = db_id
        self.output_format = output_format
        self.layer = layer
        self.width = width
        self.height = height
        self.dpi = dpi
        self.palette_categorical = palette_categorical
        self.palette_continuous = palette_continuous
        self.palette_divergent = palette_divergent
        self.color_scale = color_scale
        self.font_family = font_family
        self.font_size = font_size
        self.subset = subset
        self.sample = sample
        self.request = request


def _build_plot_request(
    common: CommonPlotParams,
    geom: str,
    *,
    x: Optional[str] = None,
    y: Optional[str] = None,
    color: Optional[str] = None,
    bins: int = 20,
    point_size: float = 3.0,
    alpha: float = 0.8,
    ci: bool = True,
    n_genes: int = 20,
    gridsize: int = 60,
    mincnt: int = 1,
    log_x: bool = False,
    log_y: bool = False,
    transform_x: Optional[str] = None,
    transform_y: Optional[str] = None,
    asinh_scale: float = 1.0,
    vmin: Optional[float] = None,
    vmax: Optional[float] = None,
    vmin_quantile: Optional[float] = None,
    vmax_quantile: Optional[float] = None,
    window: int = 200,
    show_band: bool = False,
    zscore: bool = True,
    # kde2d-specific knobs
    kde_n: int = 15_000,
    kde_bw: Optional[float] = 0.22,
    n_levels: int = 10,
    iso_overlay: bool = True,
    point_overlay: bool = False,
    # marginals / regression overlays (XY scatter / hexbin / kde2d)
    marginals: bool = False,
    regline: Optional[str] = None,
    # DE-driven geoms — pass-through with safe defaults.
    de_study: Optional[str] = None,
    de_term: Optional[str] = None,
    de_contrast: Optional[str] = None,
    de_gene: Optional[str] = None,
    padj_threshold: float = 0.05,
    log2fc_threshold: float = 1.0,
    log2fc_clip: Optional[float] = None,
    neglog10p_clip: Optional[float] = None,
    logmean_clip: Optional[float] = None,
    n_label: int = 20,
    # de_heatmap-specific
    de_contrasts: Optional[str] = None,
    de_genes: Optional[str] = None,
    de_value: Optional[str] = None,
    sig_overlay: bool = False,
    # bar-geom: 'dodge' (default) | 'stack' for composition plots
    bar_mode: str = 'dodge',
    normalize: bool = False,
    facet: Optional[str] = None,
    group_by: Optional[str] = None,
    color_scale: Optional[str] = None,
) -> PlotRequest:
    """Fold ``CommonPlotParams`` + geom-specific kwargs into a ``PlotRequest``.

    Geom-specific kwargs default to the values the unified endpoint used to
    pass, so handlers see the same inputs regardless of which endpoint
    routed them.  Per-geom endpoints only override the kwargs that geom
    actually exposes — every other field falls back to its safe default.
    """
    return PlotRequest(
        db_id=common.db_id, geom=geom,
        x=x, y=y, color=color,
        output_format=common.output_format, layer=common.layer,
        width=common.width, height=common.height, dpi=common.dpi,
        bins=bins,
        point_size=point_size, alpha=alpha,
        palette_cat=common.palette_categorical,
        palette_cont=common.palette_continuous,
        palette_div=common.palette_divergent,
        font_family=common.font_family, font_size=common.font_size,
        ci=ci, n_genes=n_genes,
        gridsize=gridsize, mincnt=mincnt,
        log_x=log_x, log_y=log_y,
        transform_x=transform_x, transform_y=transform_y,
        asinh_scale=asinh_scale,
        vmin=vmin, vmax=vmax,
