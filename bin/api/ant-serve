@app.post("/databases/{db_id:path}/query/sql", tags=["query"])
async def execute_sql_query(db_id: str, request: QueryRequest):
    """
    Execute a raw SQL query on the database

    Request Body:
    - query: SQL query string
    - limit: Optional limit to append (capped at 100000)

    Returns results in JSON format.
    All queries are read-only for security. Only SELECT queries are allowed.
    """
    try:
        # Validate SQL (block writes, DDL, file-reading functions)
        analytics.validate_sql(request.query)
        effective_limit = min(request.limit or 100_000, 100_000)
        with _pooled_db(db_id) as db:
            df = db.execute_sql(request.query, limit=effective_limit)

        # Convert to JSON-safe format
        df = df.where(pd.notna(df), None)

        return {
            "query": request.query,
            "n_rows": len(df),
            "n_columns": len(df.columns),
            "columns": df.columns.tolist(),
            "dtypes": {col: str(dtype) for col, dtype in df.dtypes.items()},
            "data": df.to_dict(orient='records')
        }

    except KeyError as e:
        raise HTTPException(status_code=404, detail=str(e))
    except Exception as e:
        raise HTTPException(status_code=400, detail=f"Query error: {str(e)}")



