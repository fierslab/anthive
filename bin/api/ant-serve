@app.post("/admin/gene-stats-cache/gc", tags=["admin"])
async def gene_stats_cache_gc():
    """Drop cache rows whose fingerprint no longer matches the current dataset state.

    Called rarely — the cache stays correct without it (stale rows are simply
    never re-fetched), but this reclaims space after a bulk ant-convert run.
    """
    keep: Dict[str, str] = {}
    for db_id_inner, meta in registry.metadata_cache.items():
        db_url = registry.databases.get(db_id_inner, '')
        mus_sha = str(meta.get('sha256') or '').strip()
        duckdb_mtime = 0.0
        if not db_url.startswith('s3://'):
            try:
                duckdb_mtime = Path(db_url).stat().st_mtime
            except OSError:
                pass
        fp = GeneStatsCache.fingerprint(mus_sha or None, duckdb_mtime)
        if fp:
            keep[db_id_inner] = fp
    n = registry.gene_stats_cache.gc_stale(keep)
    return {'gc_deleted': n, 'fingerprints_kept': len(keep)}


# ── Genesets ───────────────────────────────────────────────────────────────────

def _require_geneset_registry() -> GenesetRegistry:
    if geneset_registry is None:
        raise HTTPException(status_code=503, detail="Geneset store is not configured")
    return geneset_registry


def _build_score_index() -> None:
    """
    Walk every database in the registry, find columns matching
    <study>::<experiment>::<geneset> in obsnum, and build the bidirectional
    index. Cheap (one information_schema query per db).
    """
    global _score_index_by_db, _score_index_by_geneset, _score_columns
    new_by_db: Dict[str, List[str]] = {}
    new_by_geneset: Dict[str, List[str]] = {}
    new_columns: Dict[Tuple[str, str], str] = {}

    if registry is None:
        return

    for db_id in registry.databases.keys():
        try:
            db_url = registry.get_database_path(db_id)
            conn = connection_pool.get_connection(db_url)
        except Exception as exc:
            log.warning("score-index: skipping %s (open failed: %s)", db_id, exc)
            continue
        try:
            rows = conn.execute("""
                SELECT column_name FROM information_schema.columns
                WHERE table_name = 'obsnum'
            """).fetchall()
            for (col,) in rows:
                geneset_id = parse_score_column(col)
                if not geneset_id:
                    continue
                new_by_db.setdefault(db_id, []).append(geneset_id)
                new_by_geneset.setdefault(geneset_id, []).append(db_id)
                new_columns[(db_id, geneset_id)] = col
        except Exception as exc:
            log.warning("score-index: scan failed for %s: %s", db_id, exc)
        finally:
            try:
                connection_pool.return_connection(db_url, conn)
            except Exception:
                pass

    # Sort for deterministic output
    for ids in new_by_db.values():
        ids.sort()
    for ids in new_by_geneset.values():
        ids.sort()

    _score_index_by_db = new_by_db
    _score_index_by_geneset = new_by_geneset
    _score_columns = new_columns
    log.info(
        "score-index: %d database(s) with scored genesets, %d distinct geneset(s)",
        len(new_by_db), len(new_by_geneset),
    )


def _annotate_with_scored_in(summary: Dict[str, Any]) -> Dict[str, Any]:
    """Mutate a geneset summary dict to include scored_in (list of db_ids)."""
    summary['scored_in'] = list(_score_index_by_geneset.get(summary['geneset_id'], []))
    return summary


@app.get("/genesets", tags=["genesets"])
async def list_genesets(
    organism: Optional[str] = None,
    method: Optional[str] = None,
    study: Optional[str] = None,
):
    """List all genesets, optionally filtered by organism/method/study.

    Each entry includes `scored_in` — a list of `db_id`s where the geneset is
    already pre-computed as an obs column (no on-the-fly scoring required).
