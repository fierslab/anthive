@app.get("/databases/{db_id:path}/plot/volcano", tags=["plots"])
async def plot_volcano_endpoint(
    common: CommonPlotParams = Depends(),
    study: str = Query(..., description="DE study id (see `GET /databases/{id}/de` for the list)."),
    term: str = Query(..., description="Model term within the study (e.g. `patient_geno_short_relevel`)."),
