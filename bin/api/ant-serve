@app.get("/databases/{db_id:path}/analytics/schema", tags=["analytics"])
async def analytics_schema(db_id: str):
    """Return the schema of all DuckDB tables in a dataset.

    Lists every table with its column names, types, row count, and a 3-row
    sample.  Use this to understand what fields are available before writing
    an analytics_query SQL statement.
    """
    try:
        db_url = registry.get_database_path(db_id)
    except KeyError:
        raise HTTPException(status_code=404, detail=f"Dataset '{db_id}' not found.")
    def _sync_schema():
        conn = connection_pool.get_connection(db_url)
        try:
            return analytics.get_schema(conn)
        finally:
            connection_pool.return_connection(db_url, conn)
    try:
        schema = await asyncio.to_thread(_sync_schema)
    except Exception as exc:
        raise HTTPException(status_code=500, detail=str(exc))
    return _json_safe({"db_id": db_id, "tables": schema})


@app.post("/databases/{db_id:path}/analytics/query", tags=["analytics"])
async def analytics_query(db_id: str, request: AnalyticsQueryRequest):
    """Execute a read-only SELECT query and persist results as a Parquet file.

    The full result set is saved server-side; only column metadata and a small
    preview (first 10 rows) are returned.  Use the returned session_id in a
    subsequent POST /analytics/viz call to visualise the data.

    To use results from a prior module_score call, pass its session_id in
    `attach_sessions`. The scores become available as a table called `scores`
    with columns (cell_name, module_score). Example:

        {"sql": "SELECT o.cell_type, AVG(s.module_score) FROM scores s JOIN obscat o USING (cell_name) GROUP BY 1",
         "attach_sessions": ["abc123..."]}

    Constraints:
    - Only SELECT / WITH … SELECT queries are accepted.
    - Result is capped at 500 000 rows (configurable via ANTHIVE_ANALYTICS_ROWS).
    - Query is killed after 120 s (configurable via ANTHIVE_QUERY_TIMEOUT).
    """
    try:
        db_url = registry.get_database_path(db_id)
    except KeyError:
        raise HTTPException(status_code=404, detail=f"Dataset '{db_id}' not found.")
    # analytics.run_query opens and closes its own dedicated connection so that
    # closing it on timeout actually cancels the in-flight DuckDB query.
    try:
        result = await asyncio.to_thread(
            lambda: analytics.run_query(
                db_url, request.sql, request.session_id,
                s3_config=registry._s3_config,
                timeout=request.timeout,
                attach_sessions=request.attach_sessions,
            )
        )
    except (ValueError, RuntimeError) as exc:
        raise HTTPException(status_code=400, detail=str(exc))
    except TimeoutError as exc:
        raise HTTPException(status_code=408, detail=str(exc))
    except Exception as exc:
        raise HTTPException(status_code=500, detail=str(exc))
    return _json_safe(result)


@app.post("/analytics/viz", tags=["analytics"])
async def analytics_viz(request: AnalyticsVizRequest):
    """Execute a Python visualisation script and return the figure as base64.

    The script runs in a subprocess with a blocked-import AST scan and a
    wall-clock timeout.  Two variables are pre-injected:

      DATA_PATH   — path to the Parquet file saved by a prior analytics_query
      OUTPUT_PATH — path where the script MUST save its figure, e.g.:
                        plt.savefig(OUTPUT_PATH, bbox_inches='tight', dpi=150)

    The script may use: pandas, matplotlib, seaborn, numpy, scipy, sklearn,
    statsmodels, and other data-science packages.  Imports of os, sys,
    subprocess, socket, requests, and similar modules are blocked.
    Scripts are killed after 60 s (configurable via ANTHIVE_VIZ_TIMEOUT).
    """
    try:
        figure_b64, output_format = await asyncio.to_thread(
            analytics.run_viz,
            request.session_id, request.code, request.output_format,
        )
    except FileNotFoundError as exc:
        raise HTTPException(status_code=404, detail=str(exc))
    except (ValueError, RuntimeError) as exc:
        raise HTTPException(status_code=400, detail=str(exc))
    except TimeoutError as exc:
        raise HTTPException(status_code=408, detail=str(exc))
    except Exception as exc:
        raise HTTPException(status_code=500, detail=str(exc))
    mime_types = {'png': 'image/png', 'svg': 'image/svg+xml', 'pdf': 'application/pdf'}
    return {
        "session_id":    request.session_id,
        "output_format": output_format,
        "mime_type":     mime_types.get(output_format, 'image/png'),
        "figure_b64":    figure_b64,
    }


@app.post("/databases/{db_id:path}/module_score", tags=["analytics"])
async def module_score(db_id: str, request: ModuleScoreRequest):
    """Compute per-cell module scores (Scanpy score_genes / Seurat AddModuleScore equivalent).

    For each cell: score = mean(module genes) − mean(expression-matched control genes).
    Control genes are sampled from the same expression bins as the module genes
    using the precomputed __gene_bins table.

    Returns summary statistics and a session_id. The full per-cell scores are saved
    as a Parquet file that can be visualized via POST /analytics/viz or queried
    via POST /analytics/query using the session_id.

    Requires __gene_bins (built by ant-duckdb-check on databases with a log-normalized layer).
    """
    filters = _parse_subset(request.subset)

    def _sync_score():
        with _pooled_db(db_id) as db:
            scores_df, meta = db.score_module(
                module_genes=request.genes,
                layer=request.layer,
                n_control=request.n_control,
                seed=request.seed,
            )

            # Apply subset filters if any
            if filters:
                cat_fields = db._get_categorical_fields()
                num_fields = db._get_numerical_fields()
                filter_df = db.get_cell_table(metadata_fields=list(filters.keys()), filters=filters)
                keep_cells = set(filter_df['cell_name'])
                scores_df = scores_df[scores_df['cell_name'].isin(keep_cells)]

            return scores_df, meta

    try:
        scores_df, meta = await asyncio.to_thread(_sync_score)
    except KeyError as exc:
        raise HTTPException(status_code=404, detail=str(exc))
    except ValueError as exc:
        raise HTTPException(status_code=400, detail=str(exc))
    except Exception as exc:
        raise HTTPException(status_code=500, detail=str(exc))

    # Save to Parquet for downstream analytics_viz / analytics_query
    import uuid as _uuid
    session_id = _uuid.uuid4().hex
    parquet_path = analytics._get_tmp_dir() / f"{session_id}.parquet"
    scores_df.to_parquet(parquet_path, index=False)

    # Summary statistics
    s = scores_df['module_score']
    summary = {
        'mean':   round(float(s.mean()), 6),
        'std':    round(float(s.std()), 6),
        'min':    round(float(s.min()), 6),
        'q25':    round(float(s.quantile(0.25)), 6),
        'median': round(float(s.median()), 6),
        'q75':    round(float(s.quantile(0.75)), 6),
        'max':    round(float(s.max()), 6),
    }

    return _json_safe({
        'db_id':           db_id,
        'session_id':      session_id,
        'genes_found':     meta['genes_found'],
        'genes_missing':   meta['genes_missing'],
        'n_cells':         len(scores_df),
        'n_control_genes': meta['n_control_genes'],
        'layer':           request.layer,
        'n_control':       request.n_control,
        'seed':            request.seed,
        'summary':         summary,
    })


@app.post("/admin/release/{db_id:path}", tags=["admin"])
async def release_database(
    db_id: str,
    duration_seconds: float = 300.0,
    drain_timeout_seconds: float = 30.0,
):
    """Evict a database from the connection pool so a writer can take the
    DuckDB r/w lock.

    Closes idle pooled connections, marks the db_key as evicted (refuses new
    connections), and waits up to `drain_timeout_seconds` for in-use
    connections to be returned. The eviction self-expires after
    `duration_seconds` (safety net so a crashed writer can't lock ant-serve
    out indefinitely).

    Returns:
      - ok: True if the db is fully released; False if in-use connections
        didn't drain in time (the writer should retry or fail)
      - closed_idle: number of pooled connections that were closed
      - still_in_use: 0 on success, else the count of stubbornly in-use conns
      - eviction_expires_in: seconds until the eviction auto-clears

    Used by AnnotationWriter / ant-merge-h5ad / ant-score / ant-starcat
    before they open the duckdb in r/w mode.
    """
    try:
        db_url = registry.get_database_path(db_id)
    except KeyError:
        raise HTTPException(status_code=404, detail=f"db_id {db_id!r} not found")
    result = connection_pool.release(
        db_url,
        duration_seconds=duration_seconds,
        drain_timeout_seconds=drain_timeout_seconds,
    )
    log.info("admin.release db_id=%s result=%s", db_id, result)
    return result


@app.post("/admin/restore/{db_id:path}", tags=["admin"])
async def restore_database(db_id: str):
    """Clear an eviction set by /admin/release/{db_id}. The connection pool
    will issue fresh r/o connections on the next request."""
    try:
        db_url = registry.get_database_path(db_id)
    except KeyError:
        raise HTTPException(status_code=404, detail=f"db_id {db_id!r} not found")
    result = connection_pool.restore(db_url)
    log.info("admin.restore db_id=%s result=%s", db_id, result)
    return result


@app.post("/admin/rescan", tags=["admin"])
async def rescan_databases():
    """
    Force rescan of data folder and reload all metadata

    Triggers a complete rescan of the data folder, clearing all caches
    and re-discovering databases and metadata.

    Useful after:
    - Adding new database files
    - Updating metadata files (.md, index.md)
    - Removing database files

    Returns:
    - status: 'success'
    - previous_count: Number of databases before rescan
    - current_count: Number of databases after rescan
    - added: List of added database IDs
    - removed: List of removed database IDs
    - databases: Complete list of current database IDs
    """
    try:
        result = registry.rescan()
        # rebuild module-score reverse index too
        if geneset_registry is not None:
            _build_score_index()
            result['scored_databases'] = len(_score_index_by_db)
        # Drop the plot-response cache — any cached image may now be stale.
        result['plot_cache_cleared'] = _plot_cache_clear()
        return result
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


@app.get("/admin/plot-cache/stats", tags=["admin"])
async def plot_cache_stats():
    """Return the plot response cache stats (hits / misses / evictions / size)."""
    with _plot_cache_lock:
        size = len(_plot_cache)
        total_bytes = sum(len(e.get('bytes', b'')) for e in _plot_cache.values())
    hits, misses = _plot_cache_stats['hits'], _plot_cache_stats['misses']
    total = hits + misses
    return {
        'size':         size,
        'max_size':     _PLOT_CACHE_MAX_ENTRIES,
        'memory_bytes': total_bytes,
        'hits':         hits,
        'misses':       misses,
        'evictions':    _plot_cache_stats['evictions'],
        'hit_rate':     (hits / total) if total else 0.0,
    }


@app.post("/admin/plot-cache/clear", tags=["admin"])
async def plot_cache_clear():
    """Drop all cached plot responses."""
    n = _plot_cache_clear()
    return {'cleared': n}


