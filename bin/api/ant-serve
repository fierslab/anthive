    study_y: Optional[str] = Query(
        None,
        description=(
            "B-side DE study_id. Defaults to ``study`` (A side) when "
            "``db_y`` is omitted; required when ``db_y`` differs from "
            "the path db_id."
        ),
    ),
    term_y: str = Query(..., description="B-side model term."),
    contrast_y: str = Query(..., description="B-side contrast."),
    # ── per-axis stat ──
    axis_x: str = Query(
        'log2fc',
        regex='^(log2fc|signed_log10p|zeff)$',
        description=(
            "Stat plotted on the X axis. One of ``log2fc`` (default), "
            "``signed_log10p`` ( -log10(padj) * sign(log2fc) ), or "
            "``zeff`` (z-effect)."
        ),
    ),
    axis_y: str = Query(
        'log2fc',
        regex='^(log2fc|signed_log10p|zeff)$',
        description="Stat plotted on the Y axis. Same kinds as ``axis_x``.",
    ),
    padj_threshold: float = Query(
        0.05, gt=0.0, le=1.0,
        description=(
            "padj cutoff applied independently to each side to drive "
            "the 4-way significance category colouring."
        ),
    ),
    n_label: int = Query(
        8, ge=0, le=100,
        description=(
            "Top-N concordant + top-N discordant genes to label by name "
            "(ranked by |stat_x * stat_y|, same sign vs opposite sign). "
            "0 disables labelling."
        ),
    ),
    mode: str = Query(
        'scatter',
        regex='^(scatter|hex)$',
        description=(
            "Render mode. ``scatter`` (default): one dot per gene with "
            "4-way colour. ``hex``: hexbin density (better when there "
            "are many genes)."
        ),
    ),
    log2fc_clip: Optional[float] = Query(
        None, gt=0.0, le=400.0,
        description=(
            "Back-compat symmetric clamp applied to BOTH axes — only "
            "meaningful when the same stat is used on both sides. Prefer "
            "the per-axis ``clip_x`` / ``clip_y`` when ``axis_x`` and "
            "``axis_y`` differ. Points beyond the clamp are pinned to the "
            "boundary; significance / label ranks still use the raw values."
        ),
    ),
    clip_x: Optional[float] = Query(
        None, gt=0.0, le=400.0,
        description=(
            "Symmetric visual clamp applied to the X axis in ``axis_x``'s "
            "own units (e.g. log2fc, signed_log10p, or zeff). Overrides "
            "``log2fc_clip`` on the X axis when both are set."
        ),
    ),
    clip_y: Optional[float] = Query(
        None, gt=0.0, le=400.0,
        description=(
            "Symmetric visual clamp applied to the Y axis in ``axis_y``'s "
            "own units. Overrides ``log2fc_clip`` on the Y axis when both "
            "are set."
        ),
    ),
):
    """Quadrant scatter comparing two DE contrasts on the same gene set.

    Each gene is one point at ``(stat_x, stat_y)`` where ``stat`` is
    the DE statistic on each axis. Quadrants encode concordance vs
    discordance; the 4-way colour split flags genes that are significant
    in one side / the other / both / neither.

    Genes present in only one side are dropped from the scatter
    (inner-join on ``gene_name``), but the caption reports the full
    set sizes (``|X|``, ``|Y|``, union, intersection) so the user can
    see how much got dropped.

    Cross-dataset comparisons are allowed only when both datasets have
    the same ``organism`` field in the obs catalog metadata; a
    mismatch returns 400.
    """
    req = _build_plot_request(
        common, 'de_quadrant',
        de_study=study, de_term=term, de_contrast=contrast,
        db_y=db_y,
        de_study_y=study_y, de_term_y=term_y, de_contrast_y=contrast_y,
        axis_x=axis_x, axis_y=axis_y,
        padj_threshold=padj_threshold,
        log2fc_clip=log2fc_clip,
        clip_x=clip_x,
        clip_y=clip_y,
        n_label=n_label,
        mode=mode,
    )
    return await _render_plot(req, common.request)


