    req = _build_plot_request(
        common, 'kde2d',
        x=x, y=y,
        transform_x=transform_x, transform_y=transform_y,
        asinh_scale=asinh_scale,
        kde_n=kde_n, kde_bw=kde_bw if kde_bw and kde_bw > 0 else None,
        n_levels=n_levels,
        iso_overlay=iso_overlay,
        point_overlay=point_overlay,
        marginals=marginals,
        regline=regline,
    )
    return await _render_plot(req, common.request)


