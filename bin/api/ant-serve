        font_family=req.font_family, font_size=req.font_size,
    )
    return image_bytes, caption


def _handle_grouped(req: PlotRequest, ctx: PlotContext) -> Tuple[bytes, str]:
    """Handles violin / box / bar — x=categorical, optional y, optional
    second-factor `color` (rendered as side-by-side dodged hue, never stacked).
    """
    if not req.x:
        raise HTTPException(400, detail=f"geom='{req.geom}' requires x (categorical field)")
    x_name, x_kind = ctx.resolve(req.x)
    if x_kind != 'categorical':
        raise HTTPException(400, detail=(
            f"geom='{req.geom}' requires x to be categorical; '{req.x}' resolved as '{x_kind}'"
        ))

    hue_name: Optional[str] = None
    if req.color:
        hue_name, hue_kind = ctx.resolve(req.color)
        if hue_kind != 'categorical':
            raise HTTPException(400, detail=(
                f"geom='{req.geom}' 'split by' requires categorical; "
                f"'{req.color}' resolved as '{hue_kind}'"
            ))

    facet_name: Optional[str] = None
    if req.facet:
        facet_name, facet_kind = ctx.resolve(req.facet)
        if facet_kind != 'categorical':
            raise HTTPException(400, detail=(
                f"facet requires categorical; "
                f"'{req.facet}' resolved as '{facet_kind}'"
            ))

    group_by_name: Optional[str] = None
    if req.group_by:
        group_by_name, group_by_kind = ctx.resolve(req.group_by)
        if group_by_kind != 'categorical':
            raise HTTPException(400, detail=(
                f"group_by requires categorical; "
                f"'{req.group_by}' resolved as '{group_by_kind}'"
            ))

    extra_meta = (
        [x_name]
        + ([hue_name] if hue_name else [])
        + ([facet_name] if facet_name else [])
        + ([group_by_name] if group_by_name else [])
    )
    y_name = None
    y_kind = None
    if req.y:
        y_name, y_kind = ctx.resolve(req.y)
        if y_kind == 'gene':
            data_df = ctx.db.get_cell_table(
                genes=[y_name], metadata_fields=extra_meta,
                layer=req.layer, filters=req.filters, sample=req.sample,
            )
        else:
            data_df = ctx.db.get_cell_table(
                metadata_fields=extra_meta + [y_name],
                filters=req.filters, sample=req.sample,
            )
    else:
        data_df = ctx.db.get_cell_table(
            metadata_fields=extra_meta,
            filters=req.filters, sample=req.sample,
        )

    # stat= is only meaningful when y is a gene AND we're not stacking.
    # For non-gene y or count-only bars, silently coerce back to 'mean' so
    # the caption + rendering stay honest.
    stat = getattr(req, 'stat', 'mean') or 'mean'
    is_stacked_bar = (req.geom == 'bar' and hue_name is not None
                      and req.bar_mode == 'stack')
    if stat != 'mean' and (y_kind != 'gene' or is_stacked_bar):
        stat = 'mean'

    n_cells = int(len(data_df))
    n_groups = int(data_df[x_name].nunique())

    # Bar-specific cardinality cap. A bar plot with thousands of bars is
    # unreadable; refuse early with a helpful 400 so the web UI can surface
    # the constraint in-status (matches the MA/volcano pattern). Violin/box
    # don't suffer the same explosion problem and are uncapped.
    #
    # Cap counts BARS, not segments. In dodge mode bars = x × color
    # (each (x,color) combination renders one bar). In stack mode the
    # color levels become segments WITHIN a bar, so the bar count is
    # just the x cardinality — a composition like 40 samples × 29 donor
    # lines (1160 dodge bars) is 40 stacked bars and renders cleanly.
    # Facet cap — runs for ALL grouped geoms because every multi-panel
    # layout becomes unreadable past a small number of panels.
    if facet_name:
        n_facets = int(data_df[facet_name].nunique())
        _FACET_CAP = 8
        if n_facets > _FACET_CAP:
            raise HTTPException(400, detail=(
                f"facet='{facet_name}' has {n_facets} levels; capped at "
                f"{_FACET_CAP}. Pick a lower-cardinality facet field or "
                f"set a subset filter to narrow it."
            ))

    if req.geom == 'bar':
        is_stacked = (hue_name is not None and req.bar_mode == 'stack')
        if is_stacked:
            n_bars = n_groups
        else:
            n_split = int(data_df[hue_name].nunique()) if hue_name else 1
            n_bars = n_groups * n_split
        # facet does NOT multiply bars — x positions are shared across
        # panels, segments live within bars in stack mode.
        _BAR_CAP = 100
        if n_bars > _BAR_CAP:
            if is_stacked:
                detail = (
                    f"stacked bar plot would have {n_bars} bars "
                    f"(x='{x_name}': {n_groups} levels); capped at {_BAR_CAP}. "
                    f"Pick a lower-cardinality x field or set a subset filter."
                )
            elif hue_name:
                detail = (
                    f"bar plot would have {n_bars} bars (x='{x_name}': "
                    f"{n_groups} levels × color='{hue_name}': "
                    f"{int(data_df[hue_name].nunique())} levels); "
                    f"capped at {_BAR_CAP}. Pick a lower-cardinality field, "
                    f"try bar_mode=stack, set a subset filter, or use a "
                    f"different geom."
                )
            else:
                detail = (
                    f"bar plot would have {n_bars} bars (x='{x_name}': "
                    f"{n_groups} levels); capped at {_BAR_CAP}. "
                    f"Pick a lower-cardinality field, set a subset filter, "
                    f"or use a different geom."
                )
            raise HTTPException(400, detail=detail)

    if req.output_format in _PLOT_DATA_FORMATS:
        return _emit_dataframe(data_df, req)

    # %expressing annotation — only when y is a gene. Fraction of cells
    # per (x, hue) group with y > 0. Passed to plot_grouped for tiny grey
    # text above each violin/box/bar. For bar plots we ALSO reuse this to
    # implement stat='pct_expressing' / 'mean_nonzero' directly (below).
    pct_expr_by_group: Optional[Dict[Tuple[Any, ...], float]] = None
    n_expr_by_group: Optional[Dict[Tuple[Any, ...], Tuple[int, int]]] = None
    if y_name and y_kind == 'gene' and req.geom in ('violin', 'box', 'bar'):
        # Compute per-(x [, hue]) fraction of cells with y > 0.
        group_keys = [x_name] + ([hue_name] if hue_name else [])
        try:
            grouped = data_df.groupby(group_keys, observed=True)[y_name]
            n_total = grouped.size()
            n_expr  = grouped.apply(lambda s: int((s > 0).sum()))
            frac    = (n_expr / n_total.replace(0, 1)).astype(float)
            pct_expr_by_group = frac.to_dict()
            n_expr_by_group   = {k: (int(n_expr[k]), int(n_total[k]))
                                 for k in n_total.index}
        except Exception as exc:  # pragma: no cover — defensive
            log.warning("pct_expressing calc failed: %s", exc)
            pct_expr_by_group = None
            n_expr_by_group = None

    caption = plotting.build_caption(
        req.db_id, req.geom, x_name, x_kind, y_name, hue_name, req.layer,
        n_cells=n_cells, n_groups=n_groups,
        sample=req.sample, subset=_subset_for_caption(req),
        # Caption claims "with CI" only when bar mode actually computes
        # one. Stacked bars use raw aggregates, no bootstrap.
        ci=(req.ci if req.geom == 'bar' and req.bar_mode != 'stack' else None),
        bar_mode=req.bar_mode if req.geom == 'bar' else None,
        normalize=req.normalize if req.geom == 'bar' else None,
        stat=stat if req.geom == 'bar' else None,
        facet=req.facet, group_by=req.group_by,
        palette_cat=req.palette_cat,
        log_x=req.log_x, log_y=req.log_y,
    )
    image_bytes = plotting.plot_grouped(
        data_df=data_df, x_field=x_name, y_field=y_name, hue_field=hue_name,
        geom=req.geom, ci=req.ci,
        bar_mode=req.bar_mode, normalize=req.normalize,
        stat=stat,
        pct_expr_by_group=pct_expr_by_group,
        n_expr_by_group=n_expr_by_group,
        facet_field=facet_name,
        group_by_field=group_by_name,
        width=req.width, height=req.height, dpi=req.dpi,
        output_format=req.output_format,
        palette_cat=req.palette_cat,
        caption=caption, source_url=req.source_url,
        font_family=req.font_family, font_size=req.font_size,
    )
    return image_bytes, caption


def _handle_distribution(req: PlotRequest, ctx: PlotContext) -> Tuple[bytes, str]:
    """Handles histogram / ecdf / kde — univariate distribution of x, optional color hue."""
    if not req.x:
        raise HTTPException(400, detail=f"geom='{req.geom}' requires x (gene or numerical field)")
    x_name, x_kind = ctx.resolve(req.x)
    color_name: Optional[str] = None
    color_kind: Optional[str] = None
    if req.color:
        color_name, color_kind = ctx.resolve(req.color)
        if color_kind not in ('categorical', 'numerical', 'gene'):
            raise HTTPException(400, detail=(
                f"geom='{req.geom}' color must be categorical, numerical, or "
                f"a gene; '{req.color}' resolved as '{color_kind}'."
            ))
        if color_kind != 'categorical' and not req.bin_color:
            raise HTTPException(400, detail=(
                f"geom='{req.geom}' color must be categorical to split the "
                f"distribution. '{req.color}' resolved as '{color_kind}' — "
                f"pass bin_color=N (2..20) with optional bin_color_method="
                f"quantile|width to bin it into N categorical groups."
            ))

    # Assemble the fetch list: x + optional color, each on the correct
    # side (genes vs metadata).
    genes: List[str] = []
    metas: List[str] = []
    if x_kind == 'gene':   genes.append(x_name)
    else:                  metas.append(x_name)
    if color_name:
        if color_kind == 'gene':
            genes.append(color_name)
        else:
            metas.append(color_name)
    data_df = ctx.db.get_cell_table(
        genes=list(dict.fromkeys(genes)) or None,
        metadata_fields=list(dict.fromkeys(metas)) or None,
        layer=req.layer,
        filters=req.filters,
        sample=req.sample,
    )

    # Bin continuous color into N categorical groups if requested.
    # Rewrites color_name (and drops the source col) so downstream sees
    # a clean categorical hue.
    if color_name and color_kind in ('numerical', 'gene') and req.bin_color:
        data_df, color_name, _ = _bin_numerical_column(
            data_df, color_name, req.bin_color, req.bin_color_method,
        )
        color_kind = 'categorical'

    # exclude_zero — drop cells where the (gene) x axis is 0. Only for
    # kde and histogram (ecdf zeros are a legitimate visible feature).
    # Numerical obs zeros are silently kept (may be meaningful).
    n_total_pre_zero = int(len(data_df))
    n_dropped_zero = 0
    if (getattr(req, 'exclude_zero', False)
            and x_kind == 'gene'
            and req.geom in ('kde', 'histogram')
            and x_name in data_df.columns):
        # Use a boolean mask so we handle NaN safely.
        keep_mask = data_df[x_name] > 0
        n_dropped_zero = int((~keep_mask).sum())
        data_df = data_df.loc[keep_mask].copy()

    n_cells = int(len(data_df))
    n_groups = int(data_df[color_name].nunique()) if color_name else None
    if req.output_format in _PLOT_DATA_FORMATS:
        return _emit_dataframe(data_df, req)
    caption = plotting.build_caption(
        req.db_id, req.geom, x_name, x_kind, None, color_name, req.layer,
        n_cells=n_cells, n_groups=n_groups,
        sample=req.sample, subset=_subset_for_caption(req),
        bins=req.bins if req.geom == 'histogram' else None,
        log_x=req.log_x, log_y=req.log_y,
        palette_cat=req.palette_cat,
        exclude_zero=(True if n_dropped_zero else None),
        n_excluded_zero=(n_dropped_zero if n_dropped_zero else None),
        n_total_pre_zero=(n_total_pre_zero if n_dropped_zero else None),
    )
    image_bytes = plotting.plot_distribution(
        data_df=data_df, x_field=x_name,
        geom=req.geom, color_field=color_name,
        bins=req.bins,
        width=req.width, height=req.height, dpi=req.dpi,
        output_format=req.output_format,
        caption=caption, source_url=req.source_url,
        font_family=req.font_family, font_size=req.font_size,
    )
    return image_bytes, caption


def _handle_rolling(req: PlotRequest, ctx: PlotContext) -> Tuple[bytes, str]:
    """Rolling-mean trajectory along a continuous x (typically pseudotime).

    Required:
        x:    a continuous obs/gene field — the trajectory axis.
        y:    comma-separated list of continuous fields (genes or
              numerical obs).  Each becomes a line.
    Optional:
        color: categorical → one line per group per y.
    """
    if not req.x or not req.y:
        raise HTTPException(400, detail=(
            "geom='rolling' requires x (continuous trajectory axis, "
            "e.g. pseudotime) AND y (comma-separated continuous fields)."
        ))
    x_name, x_kind = ctx.resolve(req.x)
    if x_kind == 'categorical':
        raise HTTPException(400, detail=(
            f"geom='rolling' x must be continuous (gene or numerical); "
            f"'{req.x}' resolved as '{x_kind}'."
        ))

    # Resolve every y in the comma-separated list.
    y_raw = [s.strip() for s in req.y.split(',') if s.strip()]
    y_resolved: List[str] = []
    y_kinds: List[str] = []
    for token in y_raw:
        name, kind = ctx.resolve(token)
        if kind == 'categorical':
            raise HTTPException(400, detail=(
                f"geom='rolling' y fields must be continuous; "
                f"'{token}' resolved as 'categorical'."
            ))
        y_resolved.append(name)
        y_kinds.append(kind)
    if not y_resolved:
        raise HTTPException(400, detail="geom='rolling' needs at least one y field.")

    # Optional grouping.  Categorical → one line per group.  Numerical /
    # gene → require bin_color so we can categorise it below.
    color_field_name: Optional[str] = None
    color_kind = 'categorical'
    if req.color:
        color_field_name, color_kind = ctx.resolve(req.color)
        if color_kind not in ('categorical', 'numerical', 'gene'):
            raise HTTPException(400, detail=(
                f"geom='rolling' color must be categorical, numerical, or a "
                f"gene; '{req.color}' resolved as '{color_kind}'."
            ))
        if color_kind != 'categorical' and not req.bin_color:
            raise HTTPException(400, detail=(
                f"geom='rolling' color must be categorical to split by group. "
                f"'{req.color}' resolved as '{color_kind}' — pass "
                f"bin_color=N (2..20) with an optional bin_color_method="
                f"quantile|width to bin it into N categorical groups."
            ))

    # Fetch x + all y values + optional grouping in a single trip.  Genes
    # go via the layer; numerical obs come from obsnum.
    genes: List[str] = []
    metas: List[str] = []
    if x_kind == 'gene':   genes.append(x_name)
    else:                  metas.append(x_name)
    for name, kind in zip(y_resolved, y_kinds):
        (genes if kind == 'gene' else metas).append(name)
    if color_field_name:
        if color_kind == 'gene':
            genes.append(color_field_name)
        else:
            metas.append(color_field_name)
    # de-dupe preserving order
    genes = list(dict.fromkeys(genes))
    metas = list(dict.fromkeys(metas))
    data_df = ctx.db.get_cell_table(
        genes=genes or None,
        metadata_fields=metas or None,
        layer=req.layer,
        filters=req.filters,
        sample=req.sample,
    )

    # Post-fetch: bin the color column into N categorical groups if the
    # caller asked for it AND the resolved kind is continuous.  Colour
    # field name is rewritten (e.g. 'Age · 3 quantile bins') so caption +
    # legend self-document.
    if color_field_name and color_kind in ('numerical', 'gene') and req.bin_color:
        data_df, color_field_name, _ = _bin_numerical_column(
            data_df, color_field_name, req.bin_color, req.bin_color_method,
        )
        color_kind = 'categorical'

    n_cells = int(len(data_df))
    n_groups = (int(data_df[color_field_name].nunique())
                if color_field_name else None)
    if req.output_format in _PLOT_DATA_FORMATS:
        return _emit_dataframe(data_df, req)
    caption = plotting.build_caption(
        req.db_id, req.geom, x_name, x_kind,
        ', '.join(y_resolved), color_field_name, req.layer,
        n_cells=n_cells, n_groups=n_groups,
        sample=req.sample, subset=_subset_for_caption(req),
        window=req.window, step_size=req.step_size,
        show_band=req.show_band, show_ci=req.show_ci,
        show_ci_corrected=req.show_ci_corrected,
        rank_x=req.rank_x,
        log_x=req.log_x, log_y=req.log_y,
        palette_cat=req.palette_cat,
    )  # step_size threads to plot_rolling for both plotting stride + n_eff formula

    image_bytes = plotting.plot_rolling(
        data_df=data_df,
        x_field=x_name,
        y_fields=y_resolved,
        color_field=color_field_name,
        color_kind=color_kind,
        window=req.window,
        step_size=req.step_size,
        show_band=req.show_band,
        show_ci=req.show_ci,
        show_ci_corrected=req.show_ci_corrected,
        rank_x=req.rank_x,
        width=req.width, height=req.height, dpi=req.dpi,
        output_format=req.output_format,
        palette_cat=req.palette_cat,
        palette_cont=req.palette_cont,
        palette_div=req.palette_div,
        title_extra=req.db_id,
        caption=caption, source_url=req.source_url,
        font_family=req.font_family, font_size=req.font_size,
    )
    return image_bytes, caption


def _handle_heatmap(req: PlotRequest, ctx: PlotContext) -> Tuple[bytes, str]:
    if not req.y:
        raise HTTPException(400, detail="geom='heatmap' requires y (categorical field)")
    y_name, y_kind = ctx.resolve(req.y)
    if y_kind != 'categorical':
        raise HTTPException(400, detail=(
            f"geom='heatmap' requires y to be categorical; '{req.y}' resolved as '{y_kind}'"
        ))
    if req.x:
        # Resolve each gene exactly once (was duplicated in the v0 implementation).
        gene_list: List[str] = []
        for g in (s.strip() for s in req.x.split(',')):
            hits = ctx.db.search_genes(g, exact=True, limit=1)
            if hits:
                gene_list.append(hits[0])
        if not gene_list:
            raise HTTPException(400, detail=f"None of the genes in x='{req.x}' were found")
    else:
        gene_list = _get_top_genes_by_mean(ctx.db, req.n_genes, req.layer)

    data_df = ctx.db.get_cell_table(genes=gene_list, metadata_fields=[y_name],
                                    layer=req.layer, filters=req.filters, sample=req.sample)
    mean_expr_df = data_df.groupby(y_name)[gene_list].mean()

    n_cells = int(len(data_df))
    n_groups = int(mean_expr_df.shape[0])
    # Row-cardinality cap. y=donor_id (500 levels) × default 20 genes
    # produces a 500-row heatmap nobody can read. Refuse early with
    # the same helpful-400 shape as bar / de_heatmap. n_genes is
    # already constrained at the endpoint (le=200), so we only cap rows.
    _HEATMAP_ROW_CAP = 100
    if n_groups > _HEATMAP_ROW_CAP:
        raise HTTPException(400, detail=(
            f"heatmap has {n_groups} rows (y='{y_name}': {n_groups} levels); "
            f"capped at {_HEATMAP_ROW_CAP}. Pick a lower-cardinality y "
            f"field or apply a subset filter."
        ))
    if req.output_format in _PLOT_DATA_FORMATS:
        # Heatmap exports the AGGREGATED matrix (per-group mean per gene),
        # since that's what's drawn — raw cell-level data wouldn't
        # reconstruct the figure without re-aggregation.
        return _emit_dataframe(mean_expr_df.reset_index(), req)
    caption = plotting.build_caption(
        req.db_id, req.geom, req.x, 'gene', y_name, None, req.layer,
        n_cells=n_cells, n_groups=n_groups,
        sample=req.sample, subset=_subset_for_caption(req),
        zscore=req.zscore,
        color_scale=req.color_scale,
        palette_cont=req.palette_cont, palette_div=req.palette_div,
    )
    image_bytes = plotting.plot_heatmap(
        mean_expr_df=mean_expr_df,
        width=req.width, height=req.height, dpi=req.dpi,
        output_format=req.output_format,
        palette_cont=req.palette_cont,
        palette_div=req.palette_div,
        color_scale=req.color_scale,
        zscore=req.zscore,
        title_extra=req.db_id,
        caption=caption, source_url=req.source_url,
        font_family=req.font_family, font_size=req.font_size,
    )
    return image_bytes, caption


