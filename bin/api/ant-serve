@app.get("/groups/{group_id}", tags=["databases"])
def get_group_info(group_id: str):
    """
    Return collection-level metadata + prose for a single group.

    The web UI uses this to render a per-collection landing page —
    citation, accession, free-text description from index.md plus the
    list of datasets in the group. The 3-char `group_id` (e.g. `S25`)
    is the catalog short code; resolution scans the registry for any
    dataset whose .md frontmatter or nearest-ancestor index.md carries
    this id.

    Returns:
    - group: Long-form group name (e.g. "Sierksma2025")
    - group_id: 3-char catalog code (e.g. "S25")
    - experiment, authors, year, doi, pmid, accession, default_dataset:
      Fields from index.md frontmatter
    - description: Prose body of index.md (markdown, unrendered)
    - datasets: List of {db_id, title, id} for every dataset in the group

    404 if no dataset in the catalog belongs to this group_id.
    """
    # Find datasets whose group_id matches. We use ONLY the
    # collection-root index.md (data/h5adstore/<data_project>/index.md)
    # — nested subfolder index.md files (e.g. Sierksma2025/Village.6M/
    # index.md) are NOT consulted for group_id resolution or for the
    # description body returned below.
    matching: List[Dict] = []
    index_path: Optional[Path] = None
    for db_id, md_path in registry._db_md_bases.items():
        file_meta, _body = parse_md_file(md_path)
        gid: Optional[str] = file_meta.get('group_id')
        # Resolve the collection-root index.md for this dataset.
        try:
            relpath = md_path.relative_to(registry.data_folder)
            dp = relpath.parts[0] if relpath.parts else None
        except ValueError:
            dp = None
        root_index = (
            registry.data_folder / dp / 'index.md' if dp else None
        )
        root_index = root_index if (root_index and root_index.exists()) else None
        if not gid and root_index is not None:
            cand_meta, _ = parse_md_file(root_index)
            gid = cand_meta.get('group_id')
        if gid != group_id:
            continue
        # First matching dataset locks in the index.md.
        if index_path is None and root_index is not None:
            index_path = root_index
        matching.append({
            'db_id': db_id,
            'title': file_meta.get('title') or md_path.stem,
            'id': file_meta.get('id'),
        })

    if not matching:
        raise HTTPException(
            status_code=404,
            detail=f"No datasets found for group_id={group_id!r}",
        )

    collection_meta: Dict = {}
    collection_body: str = ''
    if index_path is not None:
        collection_meta, collection_body = parse_md_file(index_path)

    return {
        'group': collection_meta.get('group'),
        'group_id': group_id,
        'experiment': collection_meta.get('experiment'),
        'authors': collection_meta.get('authors'),
        'year': collection_meta.get('year'),
        'date': collection_meta.get('date'),
        'doi': collection_meta.get('doi'),
        'pmid': collection_meta.get('pmid'),
        'accession': collection_meta.get('accession'),
        'default_dataset': collection_meta.get('default_dataset'),
        'description': collection_body or None,
        'datasets': sorted(matching, key=lambda x: (x.get('title') or '').lower()),
    }


