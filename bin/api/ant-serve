        exclude_zero=exclude_zero,
    )


def _emit_dataframe(df, req) -> Tuple[bytes, str]:
    """Serialise a handler's source dataframe as CSV / TSV bytes.

    Used by every plot handler when the request asked for
    output_format='csv' or 'tsv' — same URL + params as the image
    render, but the response carries the post-subset/post-sample
    dataframe the handler queried from the DB. Lets the web UI
    expose a "⬇ data" button that's guaranteed consistent with the
    plotted image (no client-side reconstruction).

    The caption is reused for the X-Plot-Caption response header so
    downstream consumers see the same context as the image path.
    """
    import io
    sep = '\t' if req.output_format == 'tsv' else ','
    buf = io.StringIO()
    df.to_csv(buf, sep=sep, index=False)
    n_rows, n_cols = df.shape if hasattr(df, 'shape') else (len(df), 0)
    # HTTP headers are latin-1; avoid em-dash / multiplication-sign chars.
    caption = (
        f"data behind /plot/{req.geom} for {req.db_id}: "
        f"{n_rows} rows x {n_cols} cols"
    )
    return buf.getvalue().encode('utf-8'), caption


def _resolve_descriptor_inputs(
    plot_req: PlotRequest,
    ctx: 'PlotContext',
) -> Dict[str, Any]:
    """Resolve the biology-relevant fields of ``plot_req`` against ``ctx``
    so ``plotting.build_plot_descriptor`` can produce a title/filename.

    Pure dispatch — no DB queries beyond ``ctx.resolve`` (which itself just
    looks at cached field lists). Failures resolve to ``None`` rather than
    raising; the descriptor builder copes with missing kinds.
    """
    def _safe_resolve(name: Optional[str]) -> Tuple[Optional[str], Optional[str]]:
        if not name:
            return None, None
        try:
            resolved, kind = ctx.resolve(name)
            return resolved, kind
        except Exception:
            return name, None

    _x, x_kind = _safe_resolve(plot_req.x)
    _y, y_kind = _safe_resolve(plot_req.y)
    _color, color_kind = _safe_resolve(plot_req.color)

    # Embedding-default fallback: scatter / hexbin with no x land on the
    # dataset's default embedding (X_umap when present, else first
    # available). Mirror the handler's choice so the title says e.g.
    # "P2RY12 expression on X_umap" instead of "... on embedding".
    x_for_descriptor = plot_req.x
    if (
        plot_req.geom in ('scatter', 'hexbin')
        and not plot_req.x
        and ctx.available_embeddings
    ):
        x_for_descriptor = (
            'X_umap' if 'X_umap' in ctx.available_embeddings
            else ctx.available_embeddings[0]
        )
        x_kind = 'embedding'

    return {
        'geom':         plot_req.geom,
        'db_id':        plot_req.db_id,
        'x':            x_for_descriptor,
        'x_kind':       x_kind,
        'y':            plot_req.y,
        'y_kind':       y_kind,
        'color':        plot_req.color,
        'color_kind':   color_kind,
        'filters':      plot_req.filters,
        'de_study':     plot_req.de_study,
        'de_term':      plot_req.de_term,
        'de_contrast':  plot_req.de_contrast,
        'de_gene':      plot_req.de_gene,
        'db_y':         plot_req.db_y,
        'de_term_y':    plot_req.de_term_y,
        'de_contrast_y':plot_req.de_contrast_y,
    }


def _descriptor_inputs_static(plot_req: PlotRequest) -> Dict[str, Any]:
    """Best-effort descriptor inputs when no PlotContext is available
    (cache HIT path before we open the DB). Falls back to the request's
    raw field names with unknown kinds — the descriptor builder still
    produces a sensible result, the embedding-vs-XY branch may be slightly
    fuzzy for raw scatter/hexbin requests but the cached descriptor was
    computed against the live ctx on MISS and is reused verbatim."""
    return {
        'geom':         plot_req.geom,
        'db_id':        plot_req.db_id,
        'x':            plot_req.x,
        'x_kind':       None,
        'y':            plot_req.y,
        'y_kind':       None,
        'color':        plot_req.color,
        'color_kind':   None,
        'filters':      plot_req.filters,
        'de_study':     plot_req.de_study,
        'de_term':      plot_req.de_term,
        'de_contrast':  plot_req.de_contrast,
        'de_gene':      plot_req.de_gene,
        'db_y':         plot_req.db_y,
        'de_term_y':    plot_req.de_term_y,
        'de_contrast_y':plot_req.de_contrast_y,
    }


def _load_plot_session_columns(session_ids: List[str]) -> Dict[str, 'pd.DataFrame']:
    """Read attach_sessions Parquet files into a flat {col_name → DataFrame[cell_name, value]} map.

    Each session at ``tmp/<session_id>.parquet`` was written by
    ``/analytics/query`` (which materialises a SELECT result) or
    ``/module_score`` (which materialises the per-cell scores). Both
    write a frame with a ``cell_name`` column plus one or more value
    columns. Here we surface each value column as a separate
    plottable field.

    Naming:
      - First session's value columns appear under their own names.
      - Second/third session's columns get ``session_1::col`` /
        ``session_2::col`` prefixes to avoid collisions.

    Errors:
      - Missing parquet → 400 (session expired / typo). Caller sees a
        clean error rather than a silent fallthrough.
      - No ``cell_name`` column → 400 (the parquet doesn't follow the
        plottable contract — e.g. an analytics_query that aggregated
        across all cells).
    """
    columns_map: Dict[str, 'pd.DataFrame'] = {}
    if not session_ids:
        return columns_map
    import pandas as _pd  # local import to keep startup light
    tmp_dir = analytics._get_tmp_dir()
    for idx, session_id in enumerate(session_ids):
        pq_path = tmp_dir / f'{session_id}.parquet'
        if not pq_path.exists():
            raise HTTPException(
                status_code=400,
                detail=(
                    f"attach_sessions: session '{session_id}' not found "
                    f"(expired or never existed)."
                ),
            )
        try:
            df = _pd.read_parquet(pq_path)
        except Exception as exc:
            raise HTTPException(
                status_code=400,
                detail=f"attach_sessions: failed to read session '{session_id}': {exc}",
            )
        if 'cell_name' not in df.columns:
            raise HTTPException(
                status_code=400,
                detail=(
                    f"attach_sessions: session '{session_id}' has no "
                    f"'cell_name' column — not a per-cell result, can't "
                    f"plot it. (Use the session in analytics_query instead.)"
                ),
            )
        prefix = f'session_{idx}::' if idx > 0 else ''
        for col in df.columns:
            if col == 'cell_name':
                continue
            exposed_name = f'{prefix}{col}' if prefix else col
            columns_map[exposed_name] = df[['cell_name', col]].rename(
                columns={col: exposed_name}
            )
    return columns_map


async def _render_plot(plot_req: PlotRequest, request: Request) -> Response:
    """Cache-aware execution of a plot request.

    Hits the in-memory LRU first (keyed on db_id + normalised query string +
    format + file fingerprint).  On miss, runs the geom's handler in a worker
    thread, stores the result, returns a ``Response`` with the standard
    ``X-Plot-Caption`` / ``X-Plot-Title`` / ``X-Plot-Filename`` /
    ``X-Plot-Cache`` / ``ETag`` headers.

    Per-geom endpoints don't need to know any of this — they call
    ``await _render_plot(req, common.request)`` and they're done.
    """
    try:
        db_fingerprint = _plot_db_fingerprint(registry.get_database_path(plot_req.db_id))
    except KeyError:
        raise HTTPException(status_code=404, detail=f"Dataset '{plot_req.db_id}' not found")

    query_string = request.url.query if request is not None else ''
    cache_key = _plot_cache_key(
        plot_req.db_id, plot_req.geom, query_string,
        plot_req.output_format, db_fingerprint,
    )
    def _ascii_safe(s: str) -> str:
        # X-Plot-Caption rides in an HTTP response header. RFC 7230 +
        # starlette enforce latin-1 encoding, so en-dashes / em-dashes /
        # × / · / · would crash response init. Strip non-latin-1 by
        # replacing each non-encodable codepoint with a '?' so the
        # caption is best-effort but never blocks the image.
        return s.encode('latin-1', errors='replace').decode('latin-1')

    def _ext_for_format(fmt: str) -> str:
        return fmt if fmt in _PLOT_DATA_FORMATS else fmt

    bypass_cache = request is not None and request.query_params.get('cache') == 'miss'
    cached = None if bypass_cache else _plot_cache_get(cache_key)
    if cached is not None:
        # Older cache entries (pre-2.9.0) don't carry title/filename. Fall
        # back to building them now from the raw request — kinds will be
        # None so embedding-vs-XY may degrade, but the result is still
        # readable and the next MISS will repopulate with full kinds.
        cached_title = cached.get('title')
        cached_filename = cached.get('filename')
        cached_truncated = cached.get('filename_truncated', False)
        if cached_title is None or cached_filename is None:
            desc = plotting.build_plot_descriptor(**_descriptor_inputs_static(plot_req))
            cached_title = desc['title']
            cached_filename = desc['filename']
            cached_truncated = desc['filename_truncated'] == '1'
        headers = {
            'X-Plot-Caption':   _ascii_safe(cached['caption']),
            'X-Plot-Title':     _ascii_safe(cached_title),
            'X-Plot-Filename':  _ascii_safe(cached_filename),
            'X-Plot-Format':    plot_req.output_format,
            'X-Source-URL':     cached['source_url'],
            'X-Plot-Cache':     'HIT',
            'ETag':             f'"{cache_key}"',
            'Cache-Control':    'public, max-age=3600',
        }
        if cached_truncated:
            headers['X-Plot-Filename-Truncated'] = 'true'
        if plot_req.output_format in _PLOT_DATA_FORMATS:
            headers['Content-Disposition'] = (
                f'attachment; filename="{cached_filename}.{_ext_for_format(plot_req.output_format)}"'
            )
        return Response(
            content=cached['bytes'],
            media_type=cached['mime'],
            headers=headers,
        )

    handler = _PLOT_HANDLERS[plot_req.geom]

    # Resolve attach_sessions BEFORE opening the DB — each session id maps to
    # tmp/<id>.parquet (written by /analytics/query or /module_score). Each
    # non-cell_name column becomes a virtual obs column that the handler can
    # `color=` / `x=` / `y=` by. Reuses analytics._get_tmp_dir() so the
    # session pool is shared with the SQL sandbox.
    session_columns = _load_plot_session_columns(plot_req.attach_sessions)

    def _sync_plot():
        from dataclasses import replace as _dc_replace
        with _pooled_db(plot_req.db_id) as db:
            cat_fields = db._get_categorical_fields()
            num_fields = db._get_numerical_fields()
            ctx = PlotContext(
                db=db,
                available_embeddings=db._get_embeddings(),
                categorical_fields=cat_fields,
                numerical_fields=num_fields,
                session_columns=session_columns,
            )
            # Back-compat: rewrite legacy bare canonical names to ant_* when
            # the ant_* column exists in this dataset's view.
            available_obs: Set[str] = set(cat_fields) | set(num_fields)
            alias_notices: list[str] = []
            resolved_x, notice_x = _alias_canonical(plot_req.x, available_obs)
            resolved_y, notice_y = _alias_canonical(plot_req.y, available_obs)
            resolved_color, notice_color = _alias_canonical(plot_req.color, available_obs)
            resolved_facet, notice_facet = _alias_canonical(plot_req.facet, available_obs)
            resolved_group_by, notice_group_by = _alias_canonical(
                plot_req.group_by, available_obs
            )
            for notice in (notice_x, notice_y, notice_color, notice_facet, notice_group_by):
                if notice:
                    alias_notices.append(notice)
            active_req = _dc_replace(
                plot_req,
                x=resolved_x,
                y=resolved_y,
                color=resolved_color,
                facet=resolved_facet,
                group_by=resolved_group_by,
            )
            descriptor_inputs = _resolve_descriptor_inputs(active_req, ctx)
            image_bytes, caption = handler(active_req, ctx)
            return image_bytes, caption, descriptor_inputs, alias_notices

    try:
        image_bytes, caption, descriptor_inputs, alias_notices = await asyncio.to_thread(
            _sync_plot
        )
    except HTTPException:
        raise
    except KeyError as e:
        raise HTTPException(status_code=404, detail=str(e))
    except ValueError as e:
        raise HTTPException(status_code=400, detail=str(e))
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

    desc = plotting.build_plot_descriptor(**descriptor_inputs)
    title = desc['title']
    filename = desc['filename']
    truncated = desc['filename_truncated'] == '1'

    mime = _PLOT_MIME_TYPES[plot_req.output_format]
    _plot_cache_put(cache_key, {
        'bytes':              image_bytes,
        'caption':            caption,
        'title':              title,
        'filename':           filename,
        'filename_truncated': truncated,
        'source_url':         plot_req.source_url,
        'mime':               mime,
    })
    # Starlette runs BackgroundTask after the response has been sent — the
    # client doesn't wait on the trim.  Sync target is run in a threadpool,
    # so it never blocks the event loop.  Only fired on cache MISS (HIT
    # paths don't allocate anything worth trimming).
    headers = {
        'X-Plot-Caption':   _ascii_safe(caption),
        'X-Plot-Title':     _ascii_safe(title),
        'X-Plot-Filename':  _ascii_safe(filename),
        'X-Plot-Format':    plot_req.output_format,
        'X-Source-URL':     plot_req.source_url,
        'X-Plot-Cache':     'BYPASS' if bypass_cache else 'MISS',
        'ETag':             f'"{cache_key}"',
        'Cache-Control':    'public, max-age=3600',
    }
    if truncated:
        headers['X-Plot-Filename-Truncated'] = 'true'
    if alias_notices:
        headers['X-Anthive-Deprecated-Alias'] = ', '.join(alias_notices)
    if plot_req.output_format in _PLOT_DATA_FORMATS:
        headers['Content-Disposition'] = (
            f'attachment; filename="{filename}.{_ext_for_format(plot_req.output_format)}"'
        )
    return Response(
        content=image_bytes,
        media_type=mime,
        headers=headers,
        background=BackgroundTask(_release_memory),
    )


# ── per-geom plot endpoints ───────────────────────────────────────────────────
#
# Each endpoint declares only the Query params that geom understands.  The
# OpenAPI schema (Swagger UI at /api/docs) now shows one focused page per
# geom instead of a 30-knob kitchen sink, and FastAPI 422 errors actually
# tell the caller which geom-relevant param was wrong.


@app.get("/databases/{db_id:path}/plot/scatter", tags=["plots"])
async def plot_scatter_endpoint(
    common: CommonPlotParams = Depends(),
    x: Optional[str] = Query(
        None,
        description=(
            "X-axis field.  **Omit** for the default embedding (``X_umap``). "
            "Pass an embedding key (``X_umap``, ``X_pca``, …) for an embedding "
            "scatter.  Pass a continuous field (gene or numerical obs) for a "
            "generic 2-axis scatter (then ``y`` is required)."
        ),
    ),
    y: Optional[str] = Query(
        None,
        description="Y-axis field (continuous) — required when ``x`` is continuous; ignored for embedding scatter.",
    ),
    color: Optional[str] = Query(
        None, description="Colour-encoding field — gene, numerical, or categorical.",
    ),
    point_size: float = Query(3.0, gt=0.0, le=200.0, description="Marker size in pt²."),
    alpha: float = Query(0.8, ge=0.0, le=1.0, description="Marker opacity."),
    log_x: bool = Query(False, description="Legacy alias for ``transform_x=log1p`` (XY-mode only)."),
    log_y: bool = Query(False, description="Legacy alias for ``transform_y=log1p`` (XY-mode only)."),
    transform_x: Optional[str] = Query(
        None,
        description=(
            "Per-axis transform applied BEFORE plotting (XY-mode only). One of: "
            "linear (default), log, log1p, signed_log1p, asinh, signed_sqrt, rank. "
            "Use signed_log1p / asinh for fields straddling zero (e.g. module "
            "eigengene scores); rank to give every cell equal visual weight."
        ),
    ),
    transform_y: Optional[str] = Query(None, description="Same kinds as ``transform_x`` for the y axis."),
    asinh_scale: float = Query(
        1.0, gt=0.0, le=1000.0,
        description="Scale factor for asinh transform: y = asinh(x/scale). Lower = more aggressive compression.",
    ),
    vmin: Optional[float] = Query(None, description="Continuous colour-scale lower clip. Leave empty for auto."),
    vmax: Optional[float] = Query(
        None,
        description="Continuous colour-scale upper clip — useful when one outlier washes out the gradient.",
    ),
    marginals: bool = Query(False, description="XY-mode overlay: univariate KDE strips on x and y."),
    regline: Optional[str] = Query(
        None,
        regex='^(global|by_group)$',
        description=(
            "XY-mode overlay: regression line + R²/Pearson/Spearman/slope. "
            "``global`` for one line; ``by_group`` for one per categorical-colour group (cap 30)."
        ),
    ),
    bin_color: Optional[int] = Query(
        None, ge=2, le=20,
        description=(
            "Bin a continuous ``color`` (numerical obs or gene) into N "
            "categorical bins before plotting.  Ignored when ``color`` is "
            "already categorical or unset."
        ),
    ),
    bin_color_method: str = Query(
        'quantile',
        regex='^(quantile|width)$',
        description=(
            "How ``bin_color`` cuts the range: ``quantile`` (equal-count, "
            "default) or ``width`` (equal-width)."
        ),
    ),
):
    """Cell-level scatter, **polymorphic**:

    * No ``x`` (or an embedding key) → embedding scatter.
    * Continuous ``x`` + ``y`` → generic gene-vs-gene / numerical-vs-numerical scatter.

    Continuous ``color`` fields auto-pick ``palette_continuous`` or
    ``palette_divergent`` based on whether values straddle zero.
    """
    req = _build_plot_request(
        common, 'scatter',
        x=x, y=y, color=color,
        point_size=point_size, alpha=alpha,
        log_x=log_x, log_y=log_y,
        transform_x=transform_x, transform_y=transform_y,
        asinh_scale=asinh_scale,
        vmin=vmin, vmax=vmax,
        marginals=marginals, regline=regline,
        bin_color=bin_color, bin_color_method=bin_color_method,
    )
    return await _render_plot(req, common.request)


