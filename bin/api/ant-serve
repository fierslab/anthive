# object for those, NOT the per-geom kwargs path), so we MUST NOT forward
# them as _build_plot_request kwargs.
_NOTEBOOK_COMMON_PARAMS = {
    'format', 'layer', 'width', 'height', 'dpi',
    'palette_categorical', 'palette_continuous', 'palette_divergent',
    'font_family', 'font_size', 'subset', 'sample',
}


def _coerce_query_value(name: str, raw: str) -> Any:
    """Best-effort cast of a raw query-string value to the right Python type."""
    caster = _NOTEBOOK_PARAM_TYPES.get(name)
    if caster is None:
        return raw
    try:
        return caster(raw)
    except (ValueError, TypeError):
        # On a bad cast, fall back to the string so the downstream handler
        # raises a clean 4xx instead of us masking the error here.
        return raw


def _detect_notebook_auth(request: Request) -> Tuple[str, Optional[str], bool]:
    """Inspect the inbound request to pick the right auth-block template.

    Returns ``(case, remote_user, passwordless)`` where ``case`` is one of
    ``authelia``, ``basic``, ``public``, ``unknown``.
    """
    import os
    # Headers are case-insensitive in Starlette / FastAPI.
    remote_user = (
        request.headers.get('Remote-User')
        or request.headers.get('X-Forwarded-User')
    )
    if remote_user:
        return 'authelia', remote_user, False
    # HTTP Basic — try to extract the username.
    auth_header = request.headers.get('Authorization', '')
    if auth_header.lower().startswith('basic '):
        try:
            import base64
            raw = base64.b64decode(auth_header.split(' ', 1)[1]).decode('utf-8', 'replace')
            user_part = raw.split(':', 1)[0] or None
        except Exception:
            user_part = None
        return 'basic', user_part, False
    # Explicit passwordless signal — only trust an env var. Anything else
    # gets the "auth probably required, prefill commented" treatment.
    if os.environ.get('ANTHIVE_PUBLIC') in ('1', 'true', 'yes'):
        return 'public', None, True
    return 'unknown', None, False


def _notebook_base_url(request: Request) -> str:
    """Public base URL of the API, suitable for use inside the notebook.

    Prefers X-Forwarded-Host (set by Caddy / nginx), falls back to the
    inbound Host header. Always ends in ``/api`` (the FastAPI app's
    ``root_path``).
    """
    forwarded_host = request.headers.get('X-Forwarded-Host')
    forwarded_proto = request.headers.get('X-Forwarded-Proto')
    host = forwarded_host or request.headers.get('Host') or 'localhost'
    # If we're behind a proxy, default to https unless explicitly told otherwise.
    if forwarded_proto:
        proto = forwarded_proto
    elif forwarded_host:
        proto = 'https'
    else:
        proto = request.url.scheme or 'http'
    return f"{proto}://{host}/api"


