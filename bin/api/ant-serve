def _alias_canonical(
    name: Optional[str],
    available: Set[str],
) -> tuple[Optional[str], Optional[str]]:
    """Rewrite a legacy bare canonical tag name to its ``ant_*`` column.

    Returns ``(resolved_name, deprecated_alias_str_or_None)``.
    The alias string is ``"old → new"`` when a rewrite occurred, else
    ``None``.  A rewrite only fires when the bare name is *not* itself a
    real column in ``available`` and the ``ant_*`` form *is*.

    Args:
        name: The raw query-param value supplied by the caller.
        available: Column names present in the target view.

    Returns:
        Tuple of the (possibly rewritten) name and a deprecation notice
        string if a rewrite occurred, or ``(name, None)`` otherwise.
    """
    if name is None:
        return None, None
    if name in available:
        return name, None  # bare name is a real column — trust it
    new_name = BACKCOMPAT_LEGACY_NAMES.get(name)
    if new_name and new_name in available:
        return new_name, f"{name} -> {new_name}"
    return name, None  # unknown — let the endpoint 404/400 normally


