# ── 500 detail scrubbing ─────────────────────────────────────────────────────
#
# Many handlers map unexpected exceptions to HTTPException(500, detail=str(e)).
# A DuckDB error string can echo query fragments or data, so 500 details never
# leave the server: the client gets a generic message plus an error id, and the
# real detail goes to the log under that id. 4xx and crafted 503 details
# (retry hints, "not configured") pass through unchanged.

from fastapi.exception_handlers import http_exception_handler as _default_http_exception_handler
from starlette.exceptions import HTTPException as _StarletteHTTPException


def _scrubbed_500(request: Request, detail: Any) -> JSONResponse:
    error_id = uuid.uuid4().hex[:12]
    log.error("500 error_id=%s %s %s: %s", error_id, request.method,
              request.url.path, detail)
    return JSONResponse(
        status_code=500,
        content={"detail": f"Internal server error (error id {error_id})",
                 "error_id": error_id},
    )


@app.exception_handler(_StarletteHTTPException)
async def _http_exception_scrubber(request: Request, exc: _StarletteHTTPException):
    if exc.status_code == 500:
        return _scrubbed_500(request, exc.detail)
    return await _default_http_exception_handler(request, exc)


@app.exception_handler(Exception)
async def _unhandled_exception_scrubber(request: Request, exc: Exception):
    log.exception("unhandled exception on %s %s", request.method, request.url.path)
    return _scrubbed_500(request, repr(exc))


# ── Request logging + timing middleware ───────────────────────────────────────
#
# The middleware logs every request AND feeds a ring buffer of recent
# latency samples used by /metrics and /health.  /health exposes
# `mean_response_ms` + `p50_response_ms` so a client picking between
# multiple anthive servers can choose the fastest one (lower = faster).
#
# Health/metrics requests themselves are excluded — otherwise client
# probing would dominate the stat.
from starlette.middleware.base import BaseHTTPMiddleware
