def _parse_size_mb(value) -> int:
    """Parse a size string like ``'8GB'``, ``'512MB'``, ``'1024'`` (MB), or an
    int (assumed MB) into megabytes.  Used for the DuckDB budget config.
    """
    if isinstance(value, (int, float)):
        return int(value)
    text = str(value).strip().upper().replace(' ', '')
    multipliers = {'TB': 1024 * 1024, 'GB': 1024, 'MB': 1, 'KB': 1 / 1024.0, 'B': 1 / (1024 * 1024)}
    for suffix, mult in multipliers.items():
        if text.endswith(suffix):
            return max(1, int(float(text[:-len(suffix)]) * mult))
    return int(float(text))  # bare number → assume MB


def _auto_total_memory_budget_mb() -> int:
    """Default DuckDB memory ceiling per dataset instance: 25% of system RAM,
    capped at 16 GB."""
    import os
    try:
        total_bytes = os.sysconf('SC_PAGE_SIZE') * os.sysconf('SC_PHYS_PAGES')
    except (ValueError, OSError):
        return 4 * 1024  # 4 GB safe fallback
    budget_mb = int(total_bytes * 0.25 / (1024 * 1024))
    return max(1024, min(budget_mb, 16 * 1024))


def _sql_str(value: str) -> str:
    """Quote a Python string as a DuckDB string literal."""
    return "'" + str(value).replace("'", "''") + "'"


def _dir_prefix(path: str) -> str:
    """Absolute directory path with a trailing slash (allowed_directories form)."""
    import os
    return os.path.abspath(path).rstrip('/') + '/'


