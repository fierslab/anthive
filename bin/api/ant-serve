def _parse_size_mb(value) -> int:
    """Parse a size string like ``'8GB'``, ``'512MB'``, ``'1024'`` (MB), or an
    int (assumed MB) into megabytes.  Used for the DuckDB budget config.
    """
    if isinstance(value, (int, float)):
        return int(value)
    text = str(value).strip().upper().replace(' ', '')
    multipliers = {'TB': 1024 * 1024, 'GB': 1024, 'MB': 1, 'KB': 1 / 1024.0, 'B': 1 / (1024 * 1024)}
    for suffix, mult in multipliers.items():
        if text.endswith(suffix):
            return max(1, int(float(text[:-len(suffix)]) * mult))
    return int(float(text))  # bare number → assume MB


def _auto_total_memory_budget_mb() -> int:
    """Total DuckDB memory budget, shared across ALL in-flight pool
    connections. Defaults to 25% of system RAM, capped at 16 GB.

    The progressive-throttling logic in ConnectionPool divides this
    among the connections in use right now (with a floor), so a solo
    query gets the full budget and concurrent queries share it.
    """
    import os
    try:
        total_bytes = os.sysconf('SC_PAGE_SIZE') * os.sysconf('SC_PHYS_PAGES')
    except (ValueError, OSError):
        return 4 * 1024  # 4 GB safe fallback
    budget_mb = int(total_bytes * 0.25 / (1024 * 1024))
    return max(1024, min(budget_mb, 16 * 1024))


def _auto_memory_limit(max_connections: int = 3) -> str:
    """Back-compat shim for callers that still expect a per-connection
    string limit.  Returns the floor of the adaptive scheme (total /
    max_connections) so existing call sites keep working.
    """
    total_mb = _auto_total_memory_budget_mb()
    per_mb = max(256, total_mb // max(max_connections, 1))
    return f'{per_mb}MB'


