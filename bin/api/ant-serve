def _resolve_field_kind(
    field_name: str,
    available_embeddings: List[str],
    categorical_fields: List[str],
    numerical_fields: List[str],
    db,
) -> tuple:
    """Classify field_name as (resolved_name, kind).

    kind ∈ {embedding, categorical, numerical, gene}.
    Resolution order: embedding → categorical → numerical → gene (gene is last
    as it requires a DB query). Raises HTTPException(400) if not found.
    """
    if field_name in available_embeddings:
        return field_name, 'embedding'
    if field_name in categorical_fields:
        return field_name, 'categorical'
    if field_name in numerical_fields:
        return field_name, 'numerical'
    matches = db.search_genes(field_name, exact=True, case_sensitive=False, limit=1)
    if matches:
        return matches[0], 'gene'
    raise HTTPException(
        status_code=400,
        detail=(
            f"Field '{field_name}' is not a known embedding, categorical field, "
            f"numerical field, or gene in this dataset."
        ),
    )


def _get_top_genes_by_mean(db, n_genes: int, layer: str) -> List[str]:
    """Return top n_genes names ranked by mean expression.

    Both branches use bound parameters (`?`) for n_genes and `safe_ident()`
    for the layer table — no f-string SQL interpolation of user input.
    """
    try:
        db.require_gene_bins()
        rows = db._conn.execute(
            'SELECT g.gene_name FROM __gene_bins b '
            'JOIN __genes g USING (gene_id) '
            'ORDER BY b.mean_expr DESC '
            'LIMIT ?',
            [n_genes],
        ).fetchall()
        return [r[0] for r in rows]
    except Exception:
        # Validate the layer exists, then route through safe_ident so the
        # identifier is properly quoted (closes a SQL-injection vector that
        # surfaced in the v0 implementation).
        available = db._get_layers()
        if layer not in available:
            raise HTTPException(
                status_code=400,
                detail=f"Layer '{layer}' not in this dataset (available: {available})",
            )
        layer_table = safe_ident(f"layer__{layer}")
        rows = db._conn.execute(
            f'SELECT gene_name, AVG(value) AS avg_expr '
            f'FROM {layer_table} '
            f'GROUP BY gene_name '
            f'ORDER BY avg_expr DESC '
            f'LIMIT ?',
            [n_genes],
        ).fetchall()
        return [r[0] for r in rows]


# ── subset / filter helpers ───────────────────────────────────────────────────


def _parse_subset(subset_params: List[str]) -> Optional[Dict[str, Any]]:
    """Parse ?subset=field:value query params into a filters dict for AnthiveDB.

    Supported formats (all URL-encoded as needed):
      field:value          exact categorical match
      field:v1,v2,v3      IN list (multiple categorical values)
      field:min..max       numerical range (BETWEEN min AND max)

    Multiple subset params for the same field are merged into an IN list.
    Returns None when the list is empty.
    """
    if not subset_params:
        return None

    merged: Dict[str, Any] = {}
    for param in subset_params:
        if ':' not in param:
            continue
        field, _, raw = param.partition(':')
        field = field.strip()
        raw = raw.strip()
        if not field or not raw:
            continue

        # Range: field:min..max
        if '..' in raw:
            parts = raw.split('..', 1)
            try:
                lo, hi = float(parts[0]), float(parts[1])
                merged[field] = (lo, hi)
                continue
            except ValueError:
                pass  # fall through to string handling

        # Single or comma-separated list
        values = [v.strip() for v in raw.split(',') if v.strip()]
        if field in merged:
            existing = merged[field]
            existing_list = existing if isinstance(existing, list) else [existing]
            merged[field] = existing_list + values
        else:
            merged[field] = values if len(values) > 1 else values[0]

    return merged or None


# ── plot response cache ───────────────────────────────────────────────────────
#
# In-memory LRU keyed on (db_id, query string, output format, duckdb mtime
# fingerprint). Plots are deterministic in their inputs, so repeat requests
# return the cached bytes instantly. mtime in the key invalidates a stale
# entry the moment the duckdb is rebuilt (the new key simply misses; the
# LRU bound evicts the old entry over time). /admin/rescan also wipes the
# cache eagerly.

import hashlib as _plot_hashlib
import os as _plot_os
from collections import OrderedDict as _PlotOrderedDict
from threading import Lock as _PlotLock

_PLOT_CACHE_MAX_ENTRIES = 256
_plot_cache: "_PlotOrderedDict[str, dict]" = _PlotOrderedDict()
_plot_cache_lock = _PlotLock()
_plot_cache_stats = {'hits': 0, 'misses': 0, 'evictions': 0}


def _plot_db_fingerprint(db_url: str) -> str:
    """Stable per-deposit fingerprint. mtime for local files, the URL
    itself for s3:// (S3 deposits don't change underneath a running server)."""
    if db_url.startswith('s3://'):
        return db_url
    try:
        return f"{_plot_os.path.getmtime(db_url):.0f}"
    except OSError:
        return db_url


# ── memory hygiene ────────────────────────────────────────────────────────────
#
# Long-running Python servers that briefly handle large pandas / numpy arrays
# tend to retain a lot of memory in glibc's malloc arenas — the pages have
# been freed back to glibc but glibc holds them rather than handing them back
# to the OS.  Cheap RSS recovery: gc.collect() to drop reference cycles,
# then malloc_trim(0) to release those arenas.
#
# We bind libc once at startup so it stays cheap on each plot render.  If
# libc.so.6 isn't available (non-Linux, weird stripped envs), we just skip
# the trim — gc.collect() still runs.
_libc_malloc_trim = None
try:
    _libc_name = ctypes.util.find_library('c')
    if _libc_name:
        _libc = ctypes.CDLL(_libc_name, use_errno=True)
        if hasattr(_libc, 'malloc_trim'):
            _libc.malloc_trim.argtypes = [ctypes.c_size_t]
            _libc.malloc_trim.restype = ctypes.c_int
            _libc_malloc_trim = _libc.malloc_trim
except (OSError, AttributeError):
    _libc_malloc_trim = None


def _release_memory() -> None:
    """Drop Python reference cycles and return freed pages back to the OS.

    Cheap when the heap is small; takes a few ms when there's a lot to
    collect.  Called at the end of each plot render — it's the natural
    point where DataFrame / matplotlib figure references go out of scope
    and there's something for the trim to actually return.
    """
    gc.collect()
    if _libc_malloc_trim is not None:
        try:
            _libc_malloc_trim(0)
        except Exception:
            pass


def _plot_cache_key(
    db_id: str, geom: str, query: str, output_format: str, fingerprint: str,
) -> str:
    # Normalise the URL query so equivalent calls collide on the same key:
    #   - sort params by key (order shouldn't matter)
    #   - canonicalise numerics so "dpi=80" / "dpi=80.0" / "dpi=80.00" agree
    # Non-numeric values pass through unchanged.
    # ``geom`` is included explicitly because the per-geom endpoints encode
    # it in the URL path (not the query string) — without it, two different
    # geoms with the same params (e.g. /plot/violin?x=X vs /plot/box?x=X)
    # would collide on the same cache entry.
    from urllib.parse import parse_qsl, urlencode
    canonical = []
    for key, value in parse_qsl(query, keep_blank_values=True):
        try:
            num = float(value)
        except (ValueError, TypeError):
            canonical.append((key, value))
            continue
        canonical.append((key, str(int(num)) if num.is_integer() else repr(num)))
    canonical.sort()
    raw = f"{db_id}|{geom}|{urlencode(canonical)}|{output_format}|{fingerprint}"
    return _plot_hashlib.sha1(raw.encode()).hexdigest()


def _plot_cache_get(key: str) -> Optional[dict]:
    with _plot_cache_lock:
        entry = _plot_cache.get(key)
        if entry is None:
            _plot_cache_stats['misses'] += 1
            return None
        _plot_cache.move_to_end(key)
        _plot_cache_stats['hits'] += 1
        return entry


def _plot_cache_put(key: str, entry: dict) -> None:
    with _plot_cache_lock:
        _plot_cache[key] = entry
        _plot_cache.move_to_end(key)
        while len(_plot_cache) > _PLOT_CACHE_MAX_ENTRIES:
            _plot_cache.popitem(last=False)
            _plot_cache_stats['evictions'] += 1


def _plot_cache_clear() -> int:
    """Drop every cached plot. Returns the number of entries removed."""
    with _plot_cache_lock:
        n = len(_plot_cache)
        _plot_cache.clear()
        return n


# ── plot dispatch (handler registry) ──────────────────────────────────────────
#
# Each geom (scatter / violin-box-bar / histogram-ecdf-kde / heatmap) has its
# own handler. The dispatch keeps the endpoint body thin and makes it trivial
# to add a new geom: write a handler, register it. The handler receives a
# PlotRequest + a PlotContext (db connection + a resolve helper for typing
# field names against the dataset's schema).

from dataclasses import dataclass as _plot_dataclass


@_plot_dataclass(frozen=True)
class PlotRequest:
    """Validated inputs to a plot handler — what the endpoint forwards."""
    db_id: str
    geom: str
    x: Optional[str]
    y: Optional[str]
    color: Optional[str]
    output_format: str
    layer: str
    width: float
    height: float
    dpi: int
    bins: int
    point_size: float
    alpha: float
    palette_cat: str      # categorical / qualitative
    palette_cont: str     # sequential continuous (counts, expression, …)
    palette_div: str      # divergent continuous (z-scores, log fold change, …)
    font_family: str
    font_size: float
    ci: bool
    n_genes: int
    gridsize: int        # hexbin: number of hex bins along x-axis
    mincnt: int          # hexbin: minimum cells per hex to render
    log_x: bool          # legacy alias for transform_x='log1p' (XY-mode)
    log_y: bool          # legacy alias for transform_y='log1p' (XY-mode)
    transform_x: Optional[str]   # XY-mode + kde2d: 'linear'|'log'|'log1p'|'signed_log1p'|'asinh'|'signed_sqrt'|'rank'
    transform_y: Optional[str]   # same kinds for the y axis
    asinh_scale: float           # scale factor for asinh transform (y = asinh(x/s))
    vmin: Optional[float]  # hexbin / scatter colorbar lower clip (None = auto)
    vmax: Optional[float]  # hexbin / scatter colorbar upper clip (None = auto)
    vmin_quantile: Optional[float]   # hexbin auto-clip lower (e.g. 0.10); ignored if vmin is set
    vmax_quantile: Optional[float]   # hexbin auto-clip upper (e.g. 0.90); ignored if vmax is set
    # kde2d-specific knobs
    kde_n: int                   # subsample size for the KDE fit
    kde_bw: Optional[float]      # bandwidth (None → Scott's rule)
    n_levels: int                # number of filled contour levels
    iso_overlay: bool            # white iso-density contours over the filled levels
    point_overlay: bool          # raster scatter under the contours
    # marginal + regression overlays (XY-mode scatter / hexbin / kde2d)
    marginals: bool              # univariate KDE strips on each axis
    regline: Optional[str]       # 'global' | 'by_group' | None
    window: int          # rolling: window size in cells
    show_band: bool      # rolling: show IQR ribbon around the line
    zscore: bool         # heatmap: z-score per gene (centred divergent) vs raw means
    # DE-driven geoms (volcano / ma / forest): selectors + visual thresholds.
    de_study: Optional[str]      # __de_study.study_id (volcano / ma / forest)
    de_term: Optional[str]       # __de.term (volcano / ma)
    de_contrast: Optional[str]   # __de.contrast (volcano / ma)
    de_gene: Optional[str]       # __genes.gene_name (forest)
    padj_threshold: float        # volcano / ma / forest: cutoff for sig colouring
    log2fc_threshold: float      # volcano / ma: |log2fc| cutoff
    log2fc_clip: Optional[float] # volcano / ma / de_quadrant (back-compat): symmetric clamp of the log2fc axis. For de_quadrant prefer clip_x / clip_y.
    clip_x: Optional[float]      # de_quadrant: per-axis symmetric clamp in axis_x's own units
    clip_y: Optional[float]      # de_quadrant: per-axis symmetric clamp in axis_y's own units
    neglog10p_clip: Optional[float]  # volcano: upper clamp of -log10(padj)
    logmean_clip: Optional[float]    # ma: upper clamp of log10(mean expression)
    n_label: int                 # volcano / ma: top-N genes to label
    # de_heatmap-specific:
    de_contrasts: Optional[str]  # comma-list to restrict the contrast (row) axis
    de_genes: Optional[str]      # comma-list to restrict the gene/module (col) axis
    de_value: Optional[str]      # which __de column to plot — None = auto-pick
    sig_overlay: bool            # mark significant cells (padj <= padj_threshold)
    sort: Optional[str]          # de_heatmap: row OR column label to sort by
    sort_desc: bool              # de_heatmap: descending sort (default ascending)
    # de_quadrant-specific — B-side selectors + per-axis stat choice.
    # The A side reuses de_study / de_term / de_contrast above (on the
    # path db_id). db_y defaults to the path db_id (intra-dataset compare).
    db_y: Optional[str]
    de_study_y: Optional[str]
    de_term_y: Optional[str]
    de_contrast_y: Optional[str]
    axis_x: str                  # 'log2fc' | 'signed_log10p' | 'zeff'
    axis_y: str                  # same kinds for the y axis
    mode: str                    # 'scatter' | 'hex'
    # bar-geom layout knobs
    bar_mode: str                # 'dodge' (default, side-by-side) | 'stack'
    normalize: bool              # stacked bar: scale each bar to 100% (proportions)
    facet: Optional[str]         # 3rd categorical for small-multiples panels
    group_by: Optional[str]      # in-plot grouping: cluster x-bars by this categorical
    color_scale: Optional[str]   # explicit cmap family: 'auto'|'sequential'|'divergent'
    filters: Optional[Dict[str, Any]]
    sample: Optional[int]
    source_url: str


@_plot_dataclass
class PlotContext:
    """Database handle + schema/resolver helpers shared across handlers."""
    db: Any
    available_embeddings: List[str]
    categorical_fields: List[str]
    numerical_fields: List[str]

    def resolve(self, field_name: str):
        return _resolve_field_kind(
            field_name, self.available_embeddings,
            self.categorical_fields, self.numerical_fields, self.db,
        )


def _subset_for_caption(req: 'PlotRequest') -> Optional[str]:
    """Return a short human string summarising any active filters, for the
    caption footer.  ASCII-only — the caption travels in the X-Plot-Caption
    HTTP header (RFC 7230 latin-1 only).  Truncates long value lists."""
    if not req.filters:
        return None
    parts = []
    for key, value in req.filters.items():
        if isinstance(value, list):
            if len(value) <= 3:
                parts.append(f"{key} in ({', '.join(map(str, value))})")
            else:
                parts.append(f"{key} in ({', '.join(map(str, value[:3]))} + {len(value) - 3} more)")
        else:
            parts.append(f"{key} = {value}")
    return '; '.join(parts) or None


def _handle_scatter(req: PlotRequest, ctx: PlotContext) -> Tuple[bytes, str]:
    # Polymorphism: when x is provided AND it's a continuous field (gene
    # or numerical obs), draw a generic 2-axis scatter via _handle_xy.
    # When x is unset / an embedding key, draw the embedding scatter below.
    if req.x:
        x_resolved, x_kind = ctx.resolve(req.x)
        if x_kind in ('gene', 'numerical'):
            if not req.y:
                raise HTTPException(400, detail=(
                    f"Scatter with x='{req.x}' ({x_kind}) needs a y field too. "
                    f"For embedding scatter, omit x (defaults to X_umap)."
                ))
            return _handle_xy(req, ctx)
    emb_id = req.x or ('X_umap' if 'X_umap' in ctx.available_embeddings
                       else (ctx.available_embeddings[0] if ctx.available_embeddings else None))
    if not emb_id:
        raise HTTPException(400, detail="No embeddings available for scatter plot")
    embedding_df = ctx.db.get_embedding_data(emb_id, n_dims=2, filters=req.filters, sample=req.sample)

    color_df = None
    color_field_name = None
    color_kind = 'categorical'
    if req.color:
        color_field_name, color_kind = ctx.resolve(req.color)
        # Reject embedding-typed color fields: they have multiple
        # dimensions (X_umap → dim_0/dim_1), no single per-cell scalar
        # to colour by. Without this the downstream path tries
        # pd.to_numeric on a column that doesn't exist on color_df.
        if color_kind not in ('categorical', 'numerical', 'gene'):
            raise HTTPException(400, detail=(
                f"color={req.color!r} resolved as '{color_kind}'; "
                f"color must be a categorical / numerical obs field or a gene."
            ))
        sampled_cells = embedding_df['cell_name'].tolist() if req.sample else None
        color_filters = dict(req.filters) if req.filters else {}
        if sampled_cells:
            color_filters['cell_name'] = sampled_cells
        used_filters = color_filters if sampled_cells else req.filters
        if color_kind == 'gene':
            color_df = ctx.db.get_cell_table(genes=[color_field_name], layer=req.layer, filters=used_filters)
        else:
            color_df = ctx.db.get_cell_table(metadata_fields=[color_field_name], filters=used_filters)

    x_label = str(embedding_df.columns[-2]).replace('dim_', 'Dim ')
    y_label = str(embedding_df.columns[-1]).replace('dim_', 'Dim ')
    n_cells = int(len(embedding_df))
    n_groups = (int(color_df[color_field_name].nunique())
                if color_df is not None and color_kind == 'categorical' else None)
    if req.output_format in _PLOT_DATA_FORMATS:
        df_out = embedding_df.copy()
        if color_df is not None and color_field_name:
            df_out = df_out.merge(
                color_df[['cell_name', color_field_name]],
                on='cell_name', how='left',
            )
        return _emit_dataframe(df_out, req)
    caption = plotting.build_caption(
        req.db_id, req.geom, emb_id, 'embedding',
        None, color_field_name, req.layer,
        n_cells=n_cells, n_groups=n_groups,
        sample=req.sample, subset=_subset_for_caption(req),
        color_kind=color_kind if color_field_name else None,
        vmin=req.vmin, vmax=req.vmax,
        color_scale=req.color_scale,
        palette_cat=req.palette_cat,
        palette_cont=req.palette_cont, palette_div=req.palette_div,
        alpha=req.alpha,
    )
    image_bytes = plotting.plot_scatter(
        embedding_df=embedding_df,
        color_df=color_df,
        color_field=color_field_name,
        color_kind=color_kind,
        x_label=x_label,
        y_label=y_label,
        width=req.width, height=req.height, dpi=req.dpi,
        output_format=req.output_format,
        point_size=req.point_size, alpha=req.alpha,
        palette_cat=req.palette_cat,
        palette_cont=req.palette_cont,
        palette_div=req.palette_div,
        color_scale=req.color_scale,
        vmin=req.vmin, vmax=req.vmax,
        title_extra=f'{req.db_id} · {emb_id}',
        caption=caption, source_url=req.source_url,
        font_family=req.font_family, font_size=req.font_size,
    )
    return image_bytes, caption


def _handle_hexbin(req: PlotRequest, ctx: PlotContext) -> Tuple[bytes, str]:
    """Hexbin embedding plot — same input contract as `_handle_scatter` but
    aggregates cells into hex bins instead of drawing every point.

    Continuous color (gene/numerical) → per-hex mean.
    Categorical color                  → modal category per hex, with hex
                                          alpha driven by dominance ratio
                                          (top1 / top2 count).
    No color                           → cell density.
    """
    # Same polymorphism as scatter: x = continuous field + y given →
    # delegate to _handle_xy for a generic 2-axis hexbin.
    if req.x:
        x_resolved, x_kind = ctx.resolve(req.x)
        if x_kind in ('gene', 'numerical'):
            if not req.y:
                raise HTTPException(400, detail=(
                    f"Hexbin with x='{req.x}' ({x_kind}) needs a y field too. "
                    f"For embedding hexbin, omit x."
                ))
            return _handle_xy(req, ctx)
    emb_id = req.x or ('X_umap' if 'X_umap' in ctx.available_embeddings
                       else (ctx.available_embeddings[0] if ctx.available_embeddings else None))
    if not emb_id:
        raise HTTPException(400, detail="No embeddings available for hexbin plot")
    embedding_df = ctx.db.get_embedding_data(emb_id, n_dims=2, filters=req.filters, sample=req.sample)

    color_df = None
    color_field_name = None
    color_kind = 'numerical'
    if req.color:
        color_field_name, color_kind = ctx.resolve(req.color)
        # Reject embedding-typed color fields: they have multiple
        # dimensions (X_umap → dim_0/dim_1), no single per-cell scalar
        # to colour by. Without this the downstream path tries
        # pd.to_numeric on a column that doesn't exist on color_df.
        if color_kind not in ('categorical', 'numerical', 'gene'):
            raise HTTPException(400, detail=(
                f"color={req.color!r} resolved as '{color_kind}'; "
                f"color must be a categorical / numerical obs field or a gene."
            ))
        sampled_cells = embedding_df['cell_name'].tolist() if req.sample else None
        color_filters = dict(req.filters) if req.filters else {}
        if sampled_cells:
            color_filters['cell_name'] = sampled_cells
        used_filters = color_filters if sampled_cells else req.filters
        if color_kind == 'gene':
            color_df = ctx.db.get_cell_table(genes=[color_field_name], layer=req.layer, filters=used_filters)
        else:
            color_df = ctx.db.get_cell_table(metadata_fields=[color_field_name], filters=used_filters)

    x_label = str(embedding_df.columns[-2]).replace('dim_', 'Dim ')
    y_label = str(embedding_df.columns[-1]).replace('dim_', 'Dim ')
    n_cells = int(len(embedding_df))
    n_groups = (int(color_df[color_field_name].nunique())
                if color_df is not None and color_kind == 'categorical' else None)
    caption = plotting.build_caption(
        req.db_id, req.geom, emb_id, 'embedding',
        None, color_field_name, req.layer,
        n_cells=n_cells, n_groups=n_groups,
        sample=req.sample, subset=_subset_for_caption(req),
        color_kind=color_kind if color_field_name else None,
        gridsize=req.gridsize, mincnt=req.mincnt,
        vmin=req.vmin, vmax=req.vmax,
        vmin_quantile=req.vmin_quantile, vmax_quantile=req.vmax_quantile,
        color_scale=req.color_scale,
        palette_cat=req.palette_cat,
        palette_cont=req.palette_cont, palette_div=req.palette_div,
        alpha=req.alpha,
    )
    if req.output_format in _PLOT_DATA_FORMATS:
        df_out = embedding_df.copy()
        if color_df is not None and color_field_name:
            df_out = df_out.merge(
                color_df[['cell_name', color_field_name]],
                on='cell_name', how='left',
            )
        return _emit_dataframe(df_out, req)
    image_bytes = plotting.plot_hexbin(
        embedding_df=embedding_df,
        color_df=color_df,
        color_field=color_field_name,
        color_kind=color_kind,
        x_label=x_label, y_label=y_label,
        width=req.width, height=req.height, dpi=req.dpi,
        output_format=req.output_format,
        palette_cat=req.palette_cat,
        palette_cont=req.palette_cont,
        palette_div=req.palette_div,
        color_scale=req.color_scale,
        alpha=req.alpha,
        gridsize=req.gridsize, mincnt=req.mincnt,
        vmin=req.vmin, vmax=req.vmax,
        vmin_quantile=req.vmin_quantile, vmax_quantile=req.vmax_quantile,
        title_extra=f'{req.db_id} · {emb_id}',
        caption=caption, source_url=req.source_url,
        font_family=req.font_family, font_size=req.font_size,
    )
    return image_bytes, caption


def _handle_xy(req: PlotRequest, ctx: PlotContext) -> Tuple[bytes, str]:
    """Generic 2-variable (xy_scatter / xy_hexbin) — x and y are BOTH
    continuous (gene or numerical obs).  Optional `color` (any kind).

    Distinct from `scatter` / `hexbin` which use an obsm embedding for
    the axes.  Useful for gene-vs-gene, expression-vs-module-score,
    QC-vs-gene comparisons, etc.
    """
    if not req.x or not req.y:
        raise HTTPException(400, detail=(
            f"geom='{req.geom}' requires BOTH x and y (continuous fields). "
            f"For embedding-based scatter/hexbin omit x."
        ))
    x_name, x_kind = ctx.resolve(req.x)
    y_name, y_kind = ctx.resolve(req.y)
    if x_kind == 'categorical' or y_kind == 'categorical':
        raise HTTPException(400, detail=(
            f"geom='{req.geom}' requires x and y to be continuous (gene or numerical). "
            f"For categorical x use violin/box/bar; for embedding use scatter/hexbin."
        ))

    # Fetch x + y values for every cell.  Genes go via the layer, numerical
    # obs come from obsnum.
    genes_to_fetch: List[str] = []
    metas_to_fetch: List[str] = []
    if x_kind == 'gene':   genes_to_fetch.append(x_name)
    else:                  metas_to_fetch.append(x_name)
    if y_kind == 'gene':   genes_to_fetch.append(y_name)
    else:                  metas_to_fetch.append(y_name)
    # de-dupe in case x == y (silly but legal)
    genes_to_fetch = list(dict.fromkeys(genes_to_fetch))
    metas_to_fetch = list(dict.fromkeys(metas_to_fetch))
    data_df = ctx.db.get_cell_table(
        genes=genes_to_fetch or None,
        metadata_fields=metas_to_fetch or None,
        layer=req.layer,
        filters=req.filters,
        sample=req.sample,
    )
    # Build a fake "embedding df" with [cell_name, <x_name>, <y_name>] so we
    # can re-use plot_scatter / plot_hexbin — they treat the last two
    # columns as the spatial axes.  Apply the configured axis transforms
    # before passing the data along.  Default 'linear' means no-op; the
    # legacy `log_x`/`log_y` booleans still work as a back-compat shim
    # (they map to transform_x='log1p' / transform_y='log1p').
    import numpy as _np
    # Two copies: `_raw_df` keeps the un-transformed columns for the
    # CSV-export branch (so users downloading "data behind the plot"
    # get the actual axis values, not their log/asinh/signed_log1p
    # transforms — see QA review B2). `embedding_df` is what gets
    # passed to the renderer with transforms applied.
    _raw_df = data_df[['cell_name', x_name, y_name]].copy()
    embedding_df = _raw_df.copy()
    tx = req.transform_x or 'linear'
    ty = req.transform_y or 'linear'
    if req.log_x and tx == 'linear':
        tx = 'log1p'      # back-compat: log_x=true → transform_x='log1p'
    if req.log_y and ty == 'linear':
        ty = 'log1p'
    if tx != 'linear':
        embedding_df[x_name] = plotting.apply_axis_transform(
            _np.asarray(embedding_df[x_name], dtype=float), tx,
            asinh_scale=req.asinh_scale or 1.0,
        )
    if ty != 'linear':
        embedding_df[y_name] = plotting.apply_axis_transform(
            _np.asarray(embedding_df[y_name], dtype=float), ty,
            asinh_scale=req.asinh_scale or 1.0,
        )
    # Drop rows where either axis ended up NaN after transform (e.g. log
    # of a non-positive).  Without this matplotlib silently empties the plot.
    keep = (_np.isfinite(_np.asarray(embedding_df[x_name], dtype=float))
            & _np.isfinite(_np.asarray(embedding_df[y_name], dtype=float)))
    embedding_df = embedding_df[keep].reset_index(drop=True)
    x_axis_label = plotting._axis_label_with_transform(x_name, tx)
    y_axis_label = plotting._axis_label_with_transform(y_name, ty)

    # Optional colour.
    color_df = None
    color_field_name = None
    color_kind = 'categorical'
    if req.color:
        color_field_name, color_kind = ctx.resolve(req.color)
        if color_field_name in (x_name, y_name):
            # Reuse the value we already fetched.
            color_df = data_df[['cell_name', color_field_name]].copy()
        else:
            if color_kind == 'gene':
                color_df = ctx.db.get_cell_table(
                    genes=[color_field_name], layer=req.layer,
                    filters=req.filters, sample=req.sample,
                )
            else:
                color_df = ctx.db.get_cell_table(
                    metadata_fields=[color_field_name],
                    filters=req.filters, sample=req.sample,
                )
            # Align to the cells we fetched for x/y (in case the colour
            # query path landed a different sample).
            color_df = color_df.set_index('cell_name').reindex(
                embedding_df['cell_name']
            ).reset_index()

    n_cells = int(len(embedding_df))
    n_groups = (int(color_df[color_field_name].nunique())
                if color_df is not None and color_kind == 'categorical' else None)
    if req.output_format in _PLOT_DATA_FORMATS:
        # Export uses the RAW (pre-transform) frame so the CSV row
        # values match the axis labels — not the transformed view.
        df_out = _raw_df.copy()
        if color_df is not None and color_field_name and color_field_name not in df_out.columns:
            df_out = df_out.merge(
                color_df[['cell_name', color_field_name]],
                on='cell_name', how='left',
            )
        return _emit_dataframe(df_out, req)
    caption = plotting.build_caption(
        req.db_id, req.geom, req.x, x_kind, req.y, color_field_name, req.layer,
        n_cells=n_cells, n_groups=n_groups,
        sample=req.sample, subset=_subset_for_caption(req),
        color_kind=color_kind if color_field_name else None,
        gridsize=req.gridsize, mincnt=req.mincnt,
        vmin=req.vmin, vmax=req.vmax,
        vmin_quantile=req.vmin_quantile, vmax_quantile=req.vmax_quantile,
        log_x=req.log_x, log_y=req.log_y,
        transform_x=req.transform_x, transform_y=req.transform_y,
        asinh_scale=req.asinh_scale,
        color_scale=req.color_scale,
        palette_cat=req.palette_cat,
        palette_cont=req.palette_cont, palette_div=req.palette_div,
        marginals=req.marginals, regline=req.regline,
        alpha=req.alpha,
    )

    # Pick the renderer based on the geom name — accept both the new
    # polymorphic names (scatter / hexbin) and the older xy_* aliases.
    plot_fn = plotting.plot_hexbin if req.geom in ('hexbin', 'xy_hexbin') else plotting.plot_scatter
    common_kwargs = dict(
        embedding_df=embedding_df,
        color_df=color_df,
        color_field=color_field_name,
        color_kind=color_kind,
        x_label=x_axis_label, y_label=y_axis_label,
        width=req.width, height=req.height, dpi=req.dpi,
        output_format=req.output_format,
        palette_cat=req.palette_cat,
        palette_cont=req.palette_cont,
        palette_div=req.palette_div,
        color_scale=req.color_scale,
        title_extra=req.db_id,
        caption=caption, source_url=req.source_url,
        font_family=req.font_family, font_size=req.font_size,
    )
    if plot_fn is plotting.plot_hexbin:
        image_bytes = plot_fn(
            **common_kwargs,
            alpha=req.alpha,
            gridsize=req.gridsize, mincnt=req.mincnt,
            vmin=req.vmin, vmax=req.vmax,
            vmin_quantile=req.vmin_quantile, vmax_quantile=req.vmax_quantile,
            marginals=req.marginals, regline=req.regline,
        )
    else:
        image_bytes = plot_fn(
            **common_kwargs,
            point_size=req.point_size, alpha=req.alpha,
            vmin=req.vmin, vmax=req.vmax,
            marginals=req.marginals, regline=req.regline,
        )
    return image_bytes, caption


def _handle_kde2d(req: PlotRequest, ctx: PlotContext) -> Tuple[bytes, str]:
    """2-D Gaussian kernel density of two continuous obs/gene fields.

    Same input contract as the XY-mode scatter/hexbin: x and y must
    both resolve to continuous fields (gene or numerical obs).
    """
    if not req.x or not req.y:
        raise HTTPException(400, detail=(
            "geom='kde2d' requires BOTH x and y (continuous fields)."
        ))
    x_name, x_kind = ctx.resolve(req.x)
    y_name, y_kind = ctx.resolve(req.y)
    if x_kind not in ('gene', 'numerical') or y_kind not in ('gene', 'numerical'):
        raise HTTPException(400, detail=(
            f"geom='kde2d' requires x and y to be continuous (gene or "
            f"numerical). Got x='{req.x}' ({x_kind}) and y='{req.y}' ({y_kind})."
        ))

    # Pull both axes in one go.
    genes, metas = [], []
    if x_kind == 'gene':   genes.append(x_name)
    else:                  metas.append(x_name)
    if y_kind == 'gene':   genes.append(y_name)
    else:                  metas.append(y_name)
    data_df = ctx.db.get_cell_table(
        genes=list(dict.fromkeys(genes)) or None,
        metadata_fields=list(dict.fromkeys(metas)) or None,
        layer=req.layer,
        filters=req.filters,
        sample=req.sample,
    )

    # Resolve transforms (legacy log_x/log_y → 'log1p' if transform is unset).
    tx = req.transform_x or 'linear'
    ty = req.transform_y or 'linear'
    if req.log_x and tx == 'linear':
        tx = 'log1p'
    if req.log_y and ty == 'linear':
        ty = 'log1p'

    n_cells = int(len(data_df))
    if req.output_format in _PLOT_DATA_FORMATS:
        return _emit_dataframe(data_df, req)
    caption = plotting.build_caption(
        req.db_id, req.geom, req.x, x_kind, req.y, None, req.layer,
        n_cells=n_cells, sample=req.sample, subset=_subset_for_caption(req),
        kde_n=req.kde_n, kde_bw=req.kde_bw, n_levels=req.n_levels,
        iso_overlay=req.iso_overlay, point_overlay=req.point_overlay,
        transform_x=req.transform_x, transform_y=req.transform_y,
        asinh_scale=req.asinh_scale,
        log_x=req.log_x, log_y=req.log_y,
        color_scale=req.color_scale,
        palette_cont=req.palette_cont,
        marginals=req.marginals, regline=req.regline,
    )
    image_bytes = plotting.plot_kde2d(
        data_df=data_df,
        x_field=x_name,
        y_field=y_name,
        transform_x=tx, transform_y=ty,
        asinh_scale=req.asinh_scale or 1.0,
        kde_n=req.kde_n, kde_bw=req.kde_bw,
        n_levels=req.n_levels,
        palette_cont=req.palette_cont,
        color_scale=req.color_scale,
        iso_overlay=req.iso_overlay,
        point_overlay=req.point_overlay,
        marginals=req.marginals,
        regline=req.regline,
        width=req.width, height=req.height, dpi=req.dpi,
        output_format=req.output_format,
        title_extra=req.db_id,
        caption=caption, source_url=req.source_url,
        font_family=req.font_family, font_size=req.font_size,
    )
    return image_bytes, caption


def _handle_grouped(req: PlotRequest, ctx: PlotContext) -> Tuple[bytes, str]:
    """Handles violin / box / bar — x=categorical, optional y, optional
    second-factor `color` (rendered as side-by-side dodged hue, never stacked).
    """
    if not req.x:
        raise HTTPException(400, detail=f"geom='{req.geom}' requires x (categorical field)")
    x_name, x_kind = ctx.resolve(req.x)
    if x_kind != 'categorical':
        raise HTTPException(400, detail=(
            f"geom='{req.geom}' requires x to be categorical; '{req.x}' resolved as '{x_kind}'"
        ))

    hue_name: Optional[str] = None
    if req.color:
        hue_name, hue_kind = ctx.resolve(req.color)
        if hue_kind != 'categorical':
            raise HTTPException(400, detail=(
                f"geom='{req.geom}' 'split by' requires categorical; "
                f"'{req.color}' resolved as '{hue_kind}'"
            ))

    facet_name: Optional[str] = None
    if req.facet:
        facet_name, facet_kind = ctx.resolve(req.facet)
        if facet_kind != 'categorical':
            raise HTTPException(400, detail=(
                f"facet requires categorical; "
                f"'{req.facet}' resolved as '{facet_kind}'"
            ))

    group_by_name: Optional[str] = None
    if req.group_by:
        group_by_name, group_by_kind = ctx.resolve(req.group_by)
        if group_by_kind != 'categorical':
            raise HTTPException(400, detail=(
                f"group_by requires categorical; "
                f"'{req.group_by}' resolved as '{group_by_kind}'"
            ))

    extra_meta = (
        [x_name]
        + ([hue_name] if hue_name else [])
        + ([facet_name] if facet_name else [])
        + ([group_by_name] if group_by_name else [])
    )
    y_name = None
    if req.y:
        y_name, y_kind = ctx.resolve(req.y)
        if y_kind == 'gene':
            data_df = ctx.db.get_cell_table(
                genes=[y_name], metadata_fields=extra_meta,
                layer=req.layer, filters=req.filters, sample=req.sample,
            )
        else:
            data_df = ctx.db.get_cell_table(
                metadata_fields=extra_meta + [y_name],
                filters=req.filters, sample=req.sample,
            )
    else:
        data_df = ctx.db.get_cell_table(
            metadata_fields=extra_meta,
            filters=req.filters, sample=req.sample,
        )

    n_cells = int(len(data_df))
    n_groups = int(data_df[x_name].nunique())

    # Bar-specific cardinality cap. A bar plot with thousands of bars is
    # unreadable; refuse early with a helpful 400 so the web UI can surface
    # the constraint in-status (matches the MA/volcano pattern). Violin/box
    # don't suffer the same explosion problem and are uncapped.
    #
    # Cap counts BARS, not segments. In dodge mode bars = x × color
    # (each (x,color) combination renders one bar). In stack mode the
    # color levels become segments WITHIN a bar, so the bar count is
    # just the x cardinality — a composition like 40 samples × 29 donor
    # lines (1160 dodge bars) is 40 stacked bars and renders cleanly.
    # Facet cap — runs for ALL grouped geoms because every multi-panel
    # layout becomes unreadable past a small number of panels.
    if facet_name:
        n_facets = int(data_df[facet_name].nunique())
        _FACET_CAP = 8
        if n_facets > _FACET_CAP:
            raise HTTPException(400, detail=(
                f"facet='{facet_name}' has {n_facets} levels; capped at "
                f"{_FACET_CAP}. Pick a lower-cardinality facet field or "
                f"set a subset filter to narrow it."
            ))

    if req.geom == 'bar':
        is_stacked = (hue_name is not None and req.bar_mode == 'stack')
        if is_stacked:
            n_bars = n_groups
        else:
            n_split = int(data_df[hue_name].nunique()) if hue_name else 1
            n_bars = n_groups * n_split
        # facet does NOT multiply bars — x positions are shared across
        # panels, segments live within bars in stack mode.
        _BAR_CAP = 100
        if n_bars > _BAR_CAP:
            if is_stacked:
                detail = (
                    f"stacked bar plot would have {n_bars} bars "
                    f"(x='{x_name}': {n_groups} levels); capped at {_BAR_CAP}. "
                    f"Pick a lower-cardinality x field or set a subset filter."
                )
            elif hue_name:
                detail = (
                    f"bar plot would have {n_bars} bars (x='{x_name}': "
                    f"{n_groups} levels × color='{hue_name}': "
                    f"{int(data_df[hue_name].nunique())} levels); "
                    f"capped at {_BAR_CAP}. Pick a lower-cardinality field, "
                    f"try bar_mode=stack, set a subset filter, or use a "
                    f"different geom."
                )
            else:
                detail = (
                    f"bar plot would have {n_bars} bars (x='{x_name}': "
                    f"{n_groups} levels); capped at {_BAR_CAP}. "
                    f"Pick a lower-cardinality field, set a subset filter, "
                    f"or use a different geom."
                )
            raise HTTPException(400, detail=detail)

    if req.output_format in _PLOT_DATA_FORMATS:
        return _emit_dataframe(data_df, req)

    caption = plotting.build_caption(
        req.db_id, req.geom, x_name, x_kind, y_name, hue_name, req.layer,
        n_cells=n_cells, n_groups=n_groups,
        sample=req.sample, subset=_subset_for_caption(req),
        # Caption claims "with CI" only when bar mode actually computes
        # one. Stacked bars use raw aggregates, no bootstrap.
        ci=(req.ci if req.geom == 'bar' and req.bar_mode != 'stack' else None),
        bar_mode=req.bar_mode if req.geom == 'bar' else None,
        normalize=req.normalize if req.geom == 'bar' else None,
        facet=req.facet, group_by=req.group_by,
        palette_cat=req.palette_cat,
        log_x=req.log_x, log_y=req.log_y,
    )
    image_bytes = plotting.plot_grouped(
        data_df=data_df, x_field=x_name, y_field=y_name, hue_field=hue_name,
        geom=req.geom, ci=req.ci,
        bar_mode=req.bar_mode, normalize=req.normalize,
        facet_field=facet_name,
        group_by_field=group_by_name,
        width=req.width, height=req.height, dpi=req.dpi,
        output_format=req.output_format,
        palette_cat=req.palette_cat,
        caption=caption, source_url=req.source_url,
        font_family=req.font_family, font_size=req.font_size,
    )
    return image_bytes, caption


def _handle_distribution(req: PlotRequest, ctx: PlotContext) -> Tuple[bytes, str]:
    """Handles histogram / ecdf / kde — univariate distribution of x, optional color hue."""
    if not req.x:
        raise HTTPException(400, detail=f"geom='{req.geom}' requires x (gene or numerical field)")
    x_name, x_kind = ctx.resolve(req.x)
    color_name = None
    if req.color:
        color_name, _ = ctx.resolve(req.color)
        if x_kind == 'gene':
            data_df = ctx.db.get_cell_table(genes=[x_name], metadata_fields=[color_name],
                                            layer=req.layer, filters=req.filters, sample=req.sample)
        else:
            data_df = ctx.db.get_cell_table(metadata_fields=[x_name, color_name],
                                            filters=req.filters, sample=req.sample)
    else:
        if x_kind == 'gene':
            data_df = ctx.db.get_cell_table(genes=[x_name], layer=req.layer,
                                            filters=req.filters, sample=req.sample)
        else:
            data_df = ctx.db.get_cell_table(metadata_fields=[x_name],
                                            filters=req.filters, sample=req.sample)

    n_cells = int(len(data_df))
    n_groups = int(data_df[color_name].nunique()) if color_name else None
    if req.output_format in _PLOT_DATA_FORMATS:
        return _emit_dataframe(data_df, req)
    caption = plotting.build_caption(
        req.db_id, req.geom, x_name, x_kind, None, color_name, req.layer,
        n_cells=n_cells, n_groups=n_groups,
        sample=req.sample, subset=_subset_for_caption(req),
        bins=req.bins if req.geom == 'histogram' else None,
        log_x=req.log_x, log_y=req.log_y,
        palette_cat=req.palette_cat,
    )
    image_bytes = plotting.plot_distribution(
        data_df=data_df, x_field=x_name,
        geom=req.geom, color_field=color_name,
        bins=req.bins,
        width=req.width, height=req.height, dpi=req.dpi,
        output_format=req.output_format,
        caption=caption, source_url=req.source_url,
        font_family=req.font_family, font_size=req.font_size,
    )
    return image_bytes, caption


def _handle_rolling(req: PlotRequest, ctx: PlotContext) -> Tuple[bytes, str]:
    """Rolling-mean trajectory along a continuous x (typically pseudotime).

    Required:
        x:    a continuous obs/gene field — the trajectory axis.
        y:    comma-separated list of continuous fields (genes or
              numerical obs).  Each becomes a line.
    Optional:
        color: categorical → one line per group per y.
    """
    if not req.x or not req.y:
        raise HTTPException(400, detail=(
            "geom='rolling' requires x (continuous trajectory axis, "
            "e.g. pseudotime) AND y (comma-separated continuous fields)."
        ))
    x_name, x_kind = ctx.resolve(req.x)
    if x_kind == 'categorical':
        raise HTTPException(400, detail=(
            f"geom='rolling' x must be continuous (gene or numerical); "
            f"'{req.x}' resolved as '{x_kind}'."
        ))

    # Resolve every y in the comma-separated list.
    y_raw = [s.strip() for s in req.y.split(',') if s.strip()]
    y_resolved: List[str] = []
    y_kinds: List[str] = []
    for token in y_raw:
        name, kind = ctx.resolve(token)
        if kind == 'categorical':
            raise HTTPException(400, detail=(
                f"geom='rolling' y fields must be continuous; "
                f"'{token}' resolved as 'categorical'."
            ))
        y_resolved.append(name)
        y_kinds.append(kind)
    if not y_resolved:
        raise HTTPException(400, detail="geom='rolling' needs at least one y field.")

    # Optional grouping.
    color_field_name: Optional[str] = None
    color_kind = 'categorical'
    if req.color:
        color_field_name, color_kind = ctx.resolve(req.color)
        if color_kind != 'categorical':
            raise HTTPException(400, detail=(
                f"geom='rolling' color must be categorical (group split); "
                f"'{req.color}' resolved as '{color_kind}'."
            ))

    # Fetch x + all y values + optional grouping in a single trip.  Genes
    # go via the layer; numerical obs come from obsnum.
    genes: List[str] = []
    metas: List[str] = []
    if x_kind == 'gene':   genes.append(x_name)
    else:                  metas.append(x_name)
    for name, kind in zip(y_resolved, y_kinds):
        (genes if kind == 'gene' else metas).append(name)
    if color_field_name:
        metas.append(color_field_name)
    # de-dupe preserving order
    genes = list(dict.fromkeys(genes))
    metas = list(dict.fromkeys(metas))
    data_df = ctx.db.get_cell_table(
        genes=genes or None,
        metadata_fields=metas or None,
        layer=req.layer,
        filters=req.filters,
        sample=req.sample,
    )

    n_cells = int(len(data_df))
    n_groups = (int(data_df[color_field_name].nunique())
                if color_field_name else None)
    if req.output_format in _PLOT_DATA_FORMATS:
        return _emit_dataframe(data_df, req)
    caption = plotting.build_caption(
        req.db_id, req.geom, x_name, x_kind,
        ', '.join(y_resolved), color_field_name, req.layer,
        n_cells=n_cells, n_groups=n_groups,
        sample=req.sample, subset=_subset_for_caption(req),
        window=req.window, show_band=req.show_band,
        log_x=req.log_x, log_y=req.log_y,
        palette_cat=req.palette_cat,
    )
    image_bytes = plotting.plot_rolling(
        data_df=data_df,
        x_field=x_name,
        y_fields=y_resolved,
        color_field=color_field_name,
        color_kind=color_kind,
        window=req.window,
        show_band=req.show_band,
        width=req.width, height=req.height, dpi=req.dpi,
        output_format=req.output_format,
        palette_cat=req.palette_cat,
        palette_cont=req.palette_cont,
        palette_div=req.palette_div,
        title_extra=req.db_id,
        caption=caption, source_url=req.source_url,
        font_family=req.font_family, font_size=req.font_size,
    )
    return image_bytes, caption


def _handle_heatmap(req: PlotRequest, ctx: PlotContext) -> Tuple[bytes, str]:
    if not req.y:
        raise HTTPException(400, detail="geom='heatmap' requires y (categorical field)")
    y_name, y_kind = ctx.resolve(req.y)
    if y_kind != 'categorical':
        raise HTTPException(400, detail=(
            f"geom='heatmap' requires y to be categorical; '{req.y}' resolved as '{y_kind}'"
        ))
    if req.x:
        # Resolve each gene exactly once (was duplicated in the v0 implementation).
        gene_list: List[str] = []
        for g in (s.strip() for s in req.x.split(',')):
            hits = ctx.db.search_genes(g, exact=True, limit=1)
            if hits:
                gene_list.append(hits[0])
        if not gene_list:
            raise HTTPException(400, detail=f"None of the genes in x='{req.x}' were found")
    else:
        gene_list = _get_top_genes_by_mean(ctx.db, req.n_genes, req.layer)

    data_df = ctx.db.get_cell_table(genes=gene_list, metadata_fields=[y_name],
                                    layer=req.layer, filters=req.filters, sample=req.sample)
    mean_expr_df = data_df.groupby(y_name)[gene_list].mean()

    n_cells = int(len(data_df))
    n_groups = int(mean_expr_df.shape[0])
    # Row-cardinality cap. y=donor_id (500 levels) × default 20 genes
    # produces a 500-row heatmap nobody can read. Refuse early with
    # the same helpful-400 shape as bar / de_heatmap. n_genes is
    # already constrained at the endpoint (le=200), so we only cap rows.
    _HEATMAP_ROW_CAP = 100
    if n_groups > _HEATMAP_ROW_CAP:
        raise HTTPException(400, detail=(
            f"heatmap has {n_groups} rows (y='{y_name}': {n_groups} levels); "
            f"capped at {_HEATMAP_ROW_CAP}. Pick a lower-cardinality y "
            f"field or apply a subset filter."
        ))
    if req.output_format in _PLOT_DATA_FORMATS:
        # Heatmap exports the AGGREGATED matrix (per-group mean per gene),
        # since that's what's drawn — raw cell-level data wouldn't
        # reconstruct the figure without re-aggregation.
        return _emit_dataframe(mean_expr_df.reset_index(), req)
    caption = plotting.build_caption(
        req.db_id, req.geom, req.x, 'gene', y_name, None, req.layer,
        n_cells=n_cells, n_groups=n_groups,
        sample=req.sample, subset=_subset_for_caption(req),
        zscore=req.zscore,
        color_scale=req.color_scale,
        palette_cont=req.palette_cont, palette_div=req.palette_div,
    )
    image_bytes = plotting.plot_heatmap(
        mean_expr_df=mean_expr_df,
        width=req.width, height=req.height, dpi=req.dpi,
        output_format=req.output_format,
        palette_cont=req.palette_cont,
        palette_div=req.palette_div,
        color_scale=req.color_scale,
        zscore=req.zscore,
        title_extra=req.db_id,
        caption=caption, source_url=req.source_url,
        font_family=req.font_family, font_size=req.font_size,
    )
    return image_bytes, caption


