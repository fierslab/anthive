async def plot_bar_endpoint(
    common: CommonPlotParams = Depends(),
    x: str = Query(..., description="Categorical obs field — bar positions."),
    y: Optional[str] = Query(
        None,
        description="Continuous field — bars show mean (with optional 95% CI). Omit for cell-count bars.",
    ),
    color: Optional[str] = Query(None, description="Second categorical: dodged side-by-side by default, stacked when ``bar_mode=stack``."),
    ci: bool = Query(True, description="Overlay 95% bootstrap CI error bars on mean bars (dodge mode only; stacked segments are raw aggregates)."),
    bar_mode: str = Query(
        'dodge',
        regex='^(dodge|stack)$',
        description="Layout when a ``color`` categorical is set. 'dodge' (default) draws bars side-by-side per (x × color); 'stack' segments each x bar by the color levels (composition plot, e.g. Sierksma Fig 1B).",
    ),
    normalize: bool = Query(
        False,
        description="Stacked bar only: scale each bar to 100% so segments show within-group proportions instead of raw counts. Ignored in dodge mode.",
    ),
    stat: str = Query(
        'mean',
        regex='^(mean|mean_nonzero|pct_expressing)$',
        description=(
            "Aggregation statistic per (x, split) group when y is set. "
            "'mean' (default, scanpy convention) averages over ALL cells "
            "including zeros — this is the correct log-norm mean. "
            "'mean_nonzero' averages only over cells with y > 0 (useful "
            "when the zero-mass swamps the signal). 'pct_expressing' "
            "returns the fraction of cells with y > 0 (0..1 range). "
            "Ignored for cell-count bars (y omitted) and stacked bars."
        ),
    ),
    facet: Optional[str] = Query(
        None,
        description="Optional 3rd categorical for small-multiples — one panel per facet value, shared x order / hue colours / y axis. Capped at 8 panels.",
    ),
    group_by: Optional[str] = Query(
        None,
        description="Optional in-plot grouping by a 3rd categorical — x-bars are clustered together by this field with a gap + a group-label band, all in ONE axes. Does not multiply bars (bar count = #x levels). Different from facet (separate panels).",
    ),
):
    """Bar plot — cell counts when ``y`` is omitted, mean(±CI) of ``y`` per
    group when ``y`` is provided.

    Stacked mode (``bar_mode=stack``) is intended for composition plots:
    one bar per x level, segmented by the ``color`` categorical. The
    number-of-bars cap counts x levels only (the segments don't multiply
    the bar count); legitimate compositions like ~40 samples × 29 donor
    lines stay under the cap."""
    req = _build_plot_request(
        common, 'bar', x=x, y=y, color=color, ci=ci,
        bar_mode=bar_mode, normalize=normalize, stat=stat,
        facet=facet, group_by=group_by,
    )
    return await _render_plot(req, common.request)


