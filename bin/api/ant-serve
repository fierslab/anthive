_by_gene_index: Dict[str, List[Dict[str, Any]]] = {}


async def _daily_metadata_refresh() -> None:
    """Background task: re-scan and refresh any stale metadata entries once per day."""
    while True:
        await asyncio.sleep(_METADATA_CACHE_TTL_S3)   # 24 h
        print("Daily metadata refresh: scanning for changes...")
        try:
            registry._scan_databases()
            registry._cache_all_metadata(force_reload=False)
        except Exception as exc:
            print(f"Daily metadata refresh error: {exc}")


async def _build_startup_indexes() -> None:
    try:
        await asyncio.to_thread(_build_score_index)
        log.info(
            "Module-score index: %d database(s), %d distinct geneset(s)",
            len(_score_index_by_db), len(_score_index_by_geneset),
        )
    except Exception as exc:
        log.warning("Failed to build module-score index: %s", exc)
    try:
        await asyncio.to_thread(_build_by_gene_index)
    except Exception as exc:
        log.warning("Failed to build by-gene index: %s", exc)


@asynccontextmanager
async def lifespan(app: FastAPI):
    """Lifespan context manager for startup and shutdown (Phase 2)"""
    # Startup
    global registry, connection_pool
    if registry is None or connection_pool is None:
        print("ERROR: Registry or connection pool not initialized!")
        sys.exit(1)
    asyncio.create_task(_daily_metadata_refresh())
    asyncio.create_task(_pseudobulk_cleanup_loop())
    # Chat assistant — emit a one-line warning when enabled but unkeyed.
    # Locked per web's §7: never crash on a missing key.
    try:
        _chat_cfg = load_chat_config(get_config())
        warn_if_misconfigured(_chat_cfg, log)
        if _chat_cfg.active:
            log.info("Chat assistant ACTIVE — model=%s", _chat_cfg.model)
    except Exception as exc:
        log.warning("chat-config load failed: %s", exc)
    if geneset_registry is not None:
        # Both indexes open every database; with S3-remote datasets that is
        # minutes of network reads, so build them off the startup path.
        asyncio.create_task(_build_startup_indexes())
    # Slave-mode banner — make the deployment role obvious in the logs
    # so it's the first thing visible when debugging "why won't this
    # write?". Banner ONLY fires when role=slave is opt-in; primaries
    # see no change.
    try:
        from config import is_slave  # noqa: PLC0415
        if is_slave():
            log.warning(
                "── DEPLOYMENT ROLE = SLAVE ──"
                "  reads + plot serving allowed; ALL writes refused "
                "(sync-push, annotation writers, ant-priority set, "
                "ant-ingest). Edit on the primary."
            )
            print("  ── DEPLOYMENT ROLE = SLAVE ──")
            print("     reads + plots allowed; ALL writes refused on this host")
    except Exception as exc:  # noqa: BLE001
        log.warning("slave-banner check failed: %s", exc)

    log.info("Server startup complete — %d databases", len(registry.databases))
    print("Server startup complete")
    yield
    # Shutdown
    log.info("Server shutting down")
    print("Shutting down...")
    if connection_pool:
        connection_pool.close_all()
    print("Server shutdown complete")


