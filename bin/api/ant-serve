    return (
        f"DB_ID = {db_id!r}\n"
        f"GEOM  = {geom!r}\n"
        "\n"
        "# What to plot - dataset, fields, filters, etc.\n"
        f"PLOT_PARAMS = {plot_literal}\n"
        "\n"
        "# Visual rendering tweaks - change these freely.\n"
        f"RENDER_PARAMS = {render_literal}"
    )


