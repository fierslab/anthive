def _is_biology_param(name: str) -> bool:
    """Classify a notebook param key into the biology bucket (vs render).

    Unknown params default to biology — they're more likely to be plot
    selectors than visual knobs, and grouping them with PLOT_PARAMS keeps
    rendering tweaks small + scannable.
    """
    if name in _NOTEBOOK_RENDER_PARAMS:
        return False
    return True  # both known-biology and unknown go here


def _dict_call_literal(items: Dict[str, Any]) -> str:
    """Render a dict as a ``dict(...)`` call expression.

    Empty dicts collapse to ``dict()`` on a single line. Non-empty
    dicts use one kwarg per line, 4-space indented, with a trailing
    comma on the last entry, e.g.::

        dict(
            gene='MEmagenta',
            study='Module_DE...',
        )

    Falls back to dict-literal syntax for individual non-identifier keys
    via ``**{"weird.key": "value"}``; the ``**{...}`` chunk gets its own
    line just like a normal kwarg.
    """
    if not items:
        return "dict()"
    import keyword as _keyword
    parts: list[str] = []
    weird: Dict[str, Any] = {}
    for key, val in items.items():
        if isinstance(key, str) and key.isidentifier() and not _keyword.iskeyword(key):
            parts.append(f"{key}={val!r}")
        else:
            weird[key] = val
    if weird:
        # Render the non-identifier keys as **{...}.
        weird_literal = (
            "{"
            + ", ".join(f"{k!r}: {v!r}" for k, v in weird.items())
            + "}"
        )
        parts.append(f"**{weird_literal}")
    indented = ",\n".join(f"    {part}" for part in parts)
    return "dict(\n" + indented + ",\n)"


def _split_plot_render_params(
    plot_params: Dict[str, Any],
) -> Tuple[Dict[str, Any], Dict[str, Any]]:
    """Split a flat params dict into (biology, render) sub-dicts.

    Order is preserved from the input — biology entries keep their
    relative order, render entries keep theirs.
    """
    biology: Dict[str, Any] = {}
    render: Dict[str, Any] = {}
    for key, val in plot_params.items():
        if _is_biology_param(key):
            biology[key] = val
        else:
            render[key] = val
    return biology, render


