def _require_geneset_registry() -> GenesetRegistry:
    if geneset_registry is None:
        raise HTTPException(status_code=503, detail="Geneset store is not configured")
    return geneset_registry


def _build_score_index() -> None:
    """
    Walk every database in the registry, find columns matching
    <study>::<experiment>::<geneset> in obsnum, and build the bidirectional
    index. Cheap (one information_schema query per db).
    """
    global _score_index_by_db, _score_index_by_geneset, _score_columns
    new_by_db: Dict[str, List[str]] = {}
    new_by_geneset: Dict[str, List[str]] = {}
    new_columns: Dict[Tuple[str, str], str] = {}

    if registry is None:
        return

    for db_id in registry.databases.keys():
        try:
            db_url = registry.get_database_path(db_id)
            conn = connection_pool.get_connection(db_url)
        except Exception as exc:
            log.warning("score-index: skipping %s (open failed: %s)", db_id, exc)
            continue
        try:
            rows = conn.execute("""
                SELECT column_name FROM information_schema.columns
                WHERE table_name = 'obsnum'
            """).fetchall()
            for (col,) in rows:
                geneset_id = parse_score_column(col)
                if not geneset_id:
                    continue
                new_by_db.setdefault(db_id, []).append(geneset_id)
                new_by_geneset.setdefault(geneset_id, []).append(db_id)
                new_columns[(db_id, geneset_id)] = col
        except Exception as exc:
            log.warning("score-index: scan failed for %s: %s", db_id, exc)
        finally:
            try:
                connection_pool.return_connection(db_url, conn)
            except Exception:
                pass

    # Sort for deterministic output
    for ids in new_by_db.values():
        ids.sort()
    for ids in new_by_geneset.values():
        ids.sort()

    _score_index_by_db = new_by_db
    _score_index_by_geneset = new_by_geneset
    _score_columns = new_columns
    log.info(
        "score-index: %d database(s) with scored genesets, %d distinct geneset(s)",
        len(new_by_db), len(new_by_geneset),
    )


def _annotate_with_scored_in(summary: Dict[str, Any]) -> Dict[str, Any]:
    """Mutate a geneset summary dict to include scored_in (list of db_ids)."""
    summary['scored_in'] = list(_score_index_by_geneset.get(summary['geneset_id'], []))
    return summary


@app.get("/genesets", tags=["genesets"])
async def list_genesets(
    organism: Optional[str] = None,
    method: Optional[str] = None,
    study: Optional[str] = None,
):
    """List all genesets, optionally filtered by organism/method/study.

    Each entry includes `scored_in` — a list of `db_id`s where the geneset is
    already pre-computed as an obs column (no on-the-fly scoring required).
    """
    registry = _require_geneset_registry()
    items = registry.list_genesets(organism=organism, method=method, study=study)
    return {
        "count": len(items),
        "column_naming": {
            "separator": SCORE_COLUMN_SEPARATOR,
            "template":  SCORE_COLUMN_TEMPLATE,
            "example":   "Sierksma2025::WGCNA::Brown_Lysosome",
        },
        "genesets": [_annotate_with_scored_in(g.to_summary()) for g in items],
    }


@app.get("/genesets/{study}/{experiment}", tags=["genesets"])
async def get_geneset_experiment(study: str, experiment: str):
    """Return experiment metadata + the list of genesets it contains."""
    registry = _require_geneset_registry()
    experiment_id = f"{study}/{experiment}"
    exp = registry.get_experiment(experiment_id)
    if exp is None:
        raise HTTPException(status_code=404, detail=f"Experiment {experiment_id} not found")
    members = [g for g in registry.list_genesets(study=study) if g.experiment.name == experiment]
    return {
        "experiment_id": exp.experiment_id,
        "study": exp.study,
        "name": exp.name,
        "metadata": exp.metadata,
        "body": exp.body,
        "genesets": [_annotate_with_scored_in(g.to_summary()) for g in members],
    }


@app.get("/genesets/{study}/{experiment}/{name}", tags=["genesets"])
async def get_geneset(study: str, experiment: str, name: str):
    """Return one geneset (merged metadata + gene list).

    Includes `scored_in` (list of db_ids) and `column_name` (the obs column name
    used in pre-scored datasets).
    """
    registry = _require_geneset_registry()
    geneset_id = f"{study}/{experiment}/{name}"
    geneset = registry.get(geneset_id)
    if geneset is None:
        raise HTTPException(status_code=404, detail=f"Geneset {geneset_id} not found")
    detail = geneset.to_detail()
    detail['scored_in'] = list(_score_index_by_geneset.get(geneset_id, []))
    detail['column_name'] = SCORE_COLUMN_TEMPLATE.format(
        study=geneset.experiment.study,
        experiment=geneset.experiment.name,
        name=geneset.name,
    )
    return detail


@app.post("/genesets/rescan", tags=["genesets"])
async def rescan_genesets():
    """Re-scan the geneset store from disk and rebuild the score index."""
    geneset_reg = _require_geneset_registry()
    geneset_reg.scan()
    h5ad_db_ids = set(globals()['registry'].databases.keys()) if globals().get('registry') else None
    errors, warnings = validate_geneset_registry(geneset_reg, h5ad_db_ids=h5ad_db_ids)
    _build_score_index()
    return {
        "experiments": len(geneset_reg.experiments),
        "genesets": len(geneset_reg.genesets),
        "scored_databases": len(_score_index_by_db),
        "errors": errors,
        "warnings": warnings,
    }


@app.get("/databases/{db_id:path}/module_scores", tags=["databases"])
async def get_database_module_scores(db_id: str):
    """List all pre-computed module-score columns for one dataset.

    For each scored geneset, returns:
      - geneset_id        canonical geneset id (study/experiment/name)
      - column_name       obs/duckdb column where the score is stored
      - geneset_known     True if the geneset is in the registered genesetstore
      - method            (if known)
      - description       (if known)
      - n_genes           (if known)
      - stats             {min, max, mean, std, median}  computed from the column

    Use the resulting column names directly in analytics_query, e.g.:
        SELECT cell_name, "Sierksma2025::WGCNA::Brown_Lysosome"
        FROM   obsnum
    """
    if registry is None or db_id not in registry.databases:
        raise HTTPException(status_code=404, detail=f"Database not found: {db_id}")

    db_url = registry.get_database_path(db_id)
    conn = connection_pool.get_connection(db_url)
    try:
        cols = conn.execute("""
            SELECT column_name FROM information_schema.columns
            WHERE table_name = 'obsnum'
        """).fetchall()
        score_cols = [c[0] for c in cols if is_score_column(c[0])]

        out = []
        gset_reg = geneset_registry  # may be None if store not configured
        for col in sorted(score_cols):
            geneset_id = parse_score_column(col)
            row = {
                "geneset_id":   geneset_id,
                "column_name":  col,
                "geneset_known": False,
                "method":       None,
                "description":  None,
                "n_genes":      None,
                "stats":        None,
            }
            if gset_reg is not None:
                gs = gset_reg.get(geneset_id)
                if gs is not None:
                    row["geneset_known"] = True
                    row["method"]       = gs.experiment.method
                    row["description"]  = gs.metadata.get('description') or ''
                    row["n_genes"]      = gs.n_genes
            try:
                # safe_ident() validates against [A-Za-z0-9_:.\- ] and quotes
                # — defends against a crafted column name (`"); DROP …`) even
                # though the connection is read-only.
                qcol = safe_ident(col)
                stats_row = conn.execute(f"""
                    SELECT
                      COUNT(*) AS n,
                      MIN({qcol}) AS min,
                      MAX({qcol}) AS max,
                      AVG({qcol}) AS mean,
                      STDDEV({qcol}) AS std,
                      MEDIAN({qcol}) AS median
                    FROM __obsnum
                """).fetchone()
                if stats_row is not None:
                    n, mn, mx, mean, std, med = stats_row
                    row["stats"] = {
                        "n":      int(n) if n is not None else None,
                        "min":    float(mn)   if mn   is not None else None,
                        "max":    float(mx)   if mx   is not None else None,
                        "mean":   float(mean) if mean is not None else None,
                        "std":    float(std)  if std  is not None else None,
                        "median": float(med)  if med  is not None else None,
                    }
            except Exception as exc:
                row["stats"] = {"error": str(exc)}
            out.append(row)
    finally:
        connection_pool.return_connection(db_url, conn)

    return {
        "db_id": db_id,
        "count": len(out),
        "column_naming": {
            "separator": SCORE_COLUMN_SEPARATOR,
            "template":  SCORE_COLUMN_TEMPLATE,
        },
        "scored_genesets": out,
    }


@app.get("/skill", tags=["info"], response_class=Response)
async def get_skill():
    """Return the Anthive Claude Code skill file (SKILL.md).

    Collaborators can install it with:
        curl -n https://data.nevel.eu/api/skill -o ~/.claude/skills/anthive/SKILL.md
    """
    skill_path = script_dir.parent / ".claude" / "skills" / "anthive" / "SKILL.md"
    if not skill_path.exists():
        raise HTTPException(status_code=404, detail="SKILL.md not found")
    return Response(
        content=skill_path.read_text(),
        media_type="text/markdown",
        headers={"Content-Disposition": "inline; filename=SKILL.md"},
    )


def main():
    """Main entry point"""
    parser = argparse.ArgumentParser(
        description="Anthive REST API Server",
        formatter_class=argparse.RawDescriptionHelpFormatter
    )

    # Get config for defaults
    config = get_config()

    parser.add_argument(
        '--data-folder',
        type=Path,
        default=Path('./data'),
        help='Path to data folder containing .duckdb files (default: ./data)'
    )
    parser.add_argument(
        '--host',
        default=config.get('rest_api_host', '127.0.0.1'),
        help='Host to bind to (default: from config or 127.0.0.1)'
    )
    parser.add_argument(
        '--port',
        type=int,
        default=config.get('rest_api_port', 8000),
        help='Port to bind to (default: from config or 8000)'
    )
    parser.add_argument(
        '--reload',
        action='store_true',
        help='Enable auto-reload for development'
    )

    args = parser.parse_args()

    # Initialize global connection pool and registry (Phase 2)
    global registry, connection_pool, geneset_registry
    s3_config = config.get('s3') or {}
    try:
        print("Initializing connection pool...")
        connection_pool = ConnectionPool(
            max_connections_per_db=config.get('duckdb_max_connections', 3),
            s3_config=s3_config,
            memory_limit=str(config.get('duckdb_memory_limit', 'auto')),
            threads=config.get('duckdb_threads', 2),
            total_memory_budget=str(config.get('duckdb_total_memory_budget', 'auto')),
            min_memory_per_conn=str(config.get('duckdb_min_memory_per_conn', '256MB')),
            temp_directory=config.get('duckdb_temp_directory') or './tmp/duckdb_spill',
        )
        print("Initializing database registry...")
        registry = DatabaseRegistry(args.data_folder, connection_pool, s3_config=s3_config)
    except FileNotFoundError as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)

    if len(registry.databases) == 0:
        print(f"Warning: No databases found in {args.data_folder}")
        print("The server will start but no databases will be available.")

    # Initialize geneset registry (optional)
    geneset_store_value = config.get('geneset_store')
    if geneset_store_value:
        geneset_path = (script_dir.parent / geneset_store_value).resolve()
        if geneset_path.exists():
            print(f"Initializing geneset registry: {geneset_path}")
            geneset_registry = GenesetRegistry(geneset_path)
            geneset_registry.scan()
            print(
                f"  {len(geneset_registry.experiments)} experiment(s), "
                f"{len(geneset_registry.genesets)} geneset(s)"
            )
            if geneset_registry.errors:
                print(f"  ⚠ {len(geneset_registry.errors)} parse error(s)")
        else:
            print(f"Geneset store path does not exist: {geneset_path} (skipping)")

    # Run md-check on the data folder (read-only: report only, never modify)
    print("\nRunning md-check on data folder...")
    try:
        from md_check import MdCheckReport, check_md_folder, write_log_entry
        md_report = MdCheckReport()
        check_md_folder(Path(args.data_folder), md_report, fix=False)
        print(
            f"  Checked {md_report.checked} .md file(s): "
            f"{md_report.index_count} index.md, {md_report.data_count} data .md"
        )
        if md_report.has_errors() or md_report.has_warnings():
            md_report.print_summary()
            log_messages = md_report.collect_log_messages()
            if log_messages:
                write_log_entry(
                    Path(args.data_folder), 'ant-serve md-check', log_messages
                )
        else:
            print("  ✓ All .md files OK")
    except Exception as e:
        print(f"  ⚠ md-check failed: {e}")

    # Start server
    print(f"\n{'='*60}")
    print(f"Starting Anthive REST API Server")
    print(f"{'='*60}")
    print(f"  Version: {API_VERSION}")
    print(f"  Host: {args.host}")
    print(f"  Port: {args.port}")
    print(f"  Data folder: {args.data_folder}")
    print(f"  Databases: {len(registry.databases)}")
    print(f"  URL: http://{args.host}:{args.port}")
    print(f"  Docs: http://{args.host}:{args.port}/docs")
    print(f"{'='*60}\n")

    uvicorn.run(
        app,
        host=args.host,
        port=args.port,
        reload=args.reload
    )


if __name__ == '__main__':
    main()
