class EvictedDatabaseError(RuntimeError):
    """Raised when get_connection() is called on a db_key that has been
    administratively evicted (a writer is holding the duckdb r/w lock)."""


class ConnectionPool:
    """Connection pool for DuckDB databases

    Maintains a pool of reusable connections per database for better performance.
    Phase 2 enhancement for concurrent request handling.

    Supports eviction (POST /admin/release/{db_id}) for the AnnotationWriter
    workflow — when an annotator wants to take the duckdb r/w lock, ant-serve
    must first close its r/o handles and refuse to issue new ones until the
    writer is done.
    """

    EVICTION_DEFAULT_SECONDS = 300.0

    def __init__(self, max_connections_per_db: int = 3, s3_config: Optional[Dict] = None,
                 memory_limit: str = 'auto', threads: int = 2,
                 total_memory_budget: str = 'auto',
                 min_memory_per_conn: str = '256MB',
                 temp_directory: Optional[str] = None):
        """
        Memory model — progressive throttling
        --------------------------------------
        ``total_memory_budget`` is a single shared budget across ALL in-flight
        pool connections.  On each ``get_connection()`` we compute
        ``per_conn = max(min_memory_per_conn, total / in_use_count)`` and
        ``SET memory_limit`` on the returned connection.  Effects:

        * Solo query: gets the full budget (e.g. 8 GB).
        * Concurrent queries: each new request shrinks the per-conn budget;
          when 8 are running, each has total/8 (with a floor).
        * Existing queries keep whatever memory_limit they were issued at
          acquire time — we don't reach into a running query.
        * Above the budget DuckDB spills to ``temp_directory`` (if set) or
          OOM-errors (if not), so set ``temp_directory`` if you expect
          big aggregations under contention.

        Args:
            total_memory_budget: total DuckDB RAM across the whole pool.
                ``'auto'`` = 25% of system RAM, capped at 16 GB.
                Pass any size string (``'4GB'``, ``'512MB'``, ``'8192'`` (MB), …).
            min_memory_per_conn: floor on the per-connection budget. Even
                under heavy concurrency, every connection gets at least
                this much, so a single huge query never starves out.
            temp_directory: where DuckDB spills when a query exceeds its
                budget.  ``None`` disables spilling (queries OOM-error
                instead).  The directory is created if missing.
            memory_limit: DEPRECATED — kept for callers that still pass it,
                folded into ``total_memory_budget`` if explicitly given.
        """
        import os
        self.max_connections_per_db = max_connections_per_db
        self.s3_config = s3_config or {}
        self.threads = threads

        if total_memory_budget == 'auto':
            self.total_memory_mb = _auto_total_memory_budget_mb()
        else:
            self.total_memory_mb = _parse_size_mb(total_memory_budget)
        self.min_memory_mb = max(64, _parse_size_mb(min_memory_per_conn))
        # Back-compat: surface the static-budget number too (some metrics expose it).
        self.memory_limit = (
            memory_limit if memory_limit != 'auto'
            else _auto_memory_limit(max_connections_per_db)
        )

        self.temp_directory = temp_directory
        if temp_directory:
            try:
                os.makedirs(temp_directory, exist_ok=True)
            except OSError as exc:
                log.warning("ConnectionPool: cannot create temp_directory %r: %s — "
                            "spilling disabled, queries past budget will OOM.",
                            temp_directory, exc)
                self.temp_directory = None

        log.info(
            'ConnectionPool: total_memory_budget=%dMB (shared, adaptive per-conn, '
            'floor=%dMB), threads=%d/conn, max_conns_per_db=%d, temp_directory=%s',
            self.total_memory_mb, self.min_memory_mb, threads,
            max_connections_per_db, self.temp_directory or '(disabled)',
        )
        self.pools: Dict[str, List[Any]] = defaultdict(list)
        self.in_use: Dict[str, int] = defaultdict(int)
        self.locks: Dict[str, Lock] = defaultdict(Lock)
        self.eviction_until: Dict[str, float] = {}  # db_key -> unix timestamp
        self.total_connections = 0
        self.hits = 0
        self.misses = 0
        # Last per-conn budget computed at acquire — surfaced in /metrics so
        # operators can see when throttling kicks in.
        self.last_per_conn_mb = self.total_memory_mb
        self._httpfs_installed = False

    def _make_connection(self, db_key: str):
        """Create a new DuckDB connection for a local path or S3 URL"""
        import duckdb
        if db_key.startswith('s3://'):
            conn = duckdb.connect()
            if not self._httpfs_installed:
                conn.execute("INSTALL httpfs;")
                self._httpfs_installed = True
            conn.execute("LOAD httpfs;")
            s3 = self.s3_config
            raw_ep = (s3.get('endpoint') or '').strip()
            ep_host = raw_ep.removeprefix('https://').removeprefix('http://')
            use_ssl = not raw_ep.startswith('http://')
            use_path_style = s3.get('use_path_style') or bool(ep_host)
            # DuckDB 1.x: use CREATE SECRET instead of SET s3_* variables
            fields = [
                f"TYPE S3",
                f"KEY_ID '{s3.get('access_key_id') or ''}'",
                f"SECRET '{s3.get('secret_access_key') or ''}'",
            ]
            if ep_host:
                fields.append(f"ENDPOINT '{ep_host}'")
            if s3.get('region'):
                fields.append(f"REGION '{s3['region']}'")
            fields.append(f"USE_SSL {'true' if use_ssl else 'false'}")
            if use_path_style:
                fields.append("URL_STYLE 'path'")
            conn.execute(f"CREATE OR REPLACE SECRET _s3 ({', '.join(fields)})")
            conn.execute(f"ATTACH '{db_key}' AS db (READ_ONLY);")
            conn.execute("USE db;")
        else:
            conn = duckdb.connect(db_key, read_only=True)
        # Static settings only — memory_limit is set per-acquire by
        # _apply_adaptive_settings so the budget tracks current load.
        conn.execute(f"SET threads = {self.threads}")
        if self.temp_directory:
            # Quote the path; DuckDB SET expects a string literal.
            conn.execute(f"SET temp_directory = '{self.temp_directory}'")
        return conn

    def _adaptive_per_conn_mb(self) -> int:
        """Compute the per-connection memory budget given current load.

        Sums ``in_use`` across every db in the pool, adds 1 for the
        connection being acquired right now, and divides the total
        budget across that count — floored at ``min_memory_mb``.

        Threading note: the read is unlocked across dbs.  Worst case it's
        stale by one or two — the budget is heuristic, slight skew is
        fine.  We never need an exact concurrent count.
        """
        in_use_total = sum(self.in_use.values())
        n_after_acquire = max(1, in_use_total + 1)
        return max(self.min_memory_mb, self.total_memory_mb // n_after_acquire)

    def _apply_adaptive_settings(self, conn) -> int:
        """Set ``memory_limit`` on a connection based on current load.

        Returns the budget (MB) that was applied — caller can log it.
        Failures are non-fatal (we log + continue with whatever the
        connection's previous limit was).
        """
        budget_mb = self._adaptive_per_conn_mb()
        try:
            conn.execute(f"SET memory_limit = '{budget_mb}MB'")
            self.last_per_conn_mb = budget_mb
        except Exception as exc:
            log.warning("ConnectionPool: SET memory_limit=%dMB failed: %s",
                        budget_mb, exc)
        return budget_mb

    def _is_evicted_unlocked(self, db_key: str) -> bool:
        """Caller must hold self.locks[db_key]. Auto-clears expired evictions."""
        deadline = self.eviction_until.get(db_key)
        if deadline is None:
            return False
        if time.time() >= deadline:
            self.eviction_until.pop(db_key, None)
            return False
        return True

    def get_connection(self, db_key: str):
        """Get a connection from the pool or create a new one"""
        with self.locks[db_key]:
            if self._is_evicted_unlocked(db_key):
                expires_in = self.eviction_until[db_key] - time.time()
                raise EvictedDatabaseError(
                    f"db_key {db_key!r} is currently evicted by a writer "
                    f"(expires in {expires_in:.0f}s). Retry shortly or call "
                    f"POST /admin/restore/{{db_id}} to clear."
                )

            # Try to get an existing connection
            if self.pools[db_key]:
                conn = self.pools[db_key].pop()
                self.in_use[db_key] += 1
                self.hits += 1
                # Rebalance: this acquire raises the in-use count, so the
                # per-conn budget shrinks for this connection accordingly.
                self._apply_adaptive_settings(conn)
                return conn

            # Create new connection if under limit
            if self.in_use[db_key] < self.max_connections_per_db:
                conn = self._make_connection(db_key)
                self.in_use[db_key] += 1
                self.total_connections += 1
                self.misses += 1
                self._apply_adaptive_settings(conn)
                return conn

            # Fallback: create an extra connection beyond the pool limit
            self.misses += 1
            conn = self._make_connection(db_key)
            self._apply_adaptive_settings(conn)
            return conn

    def release(self, db_key: str, *,
                duration_seconds: Optional[float] = None,
                drain_timeout_seconds: float = 30.0) -> Dict[str, Any]:
        """Mark db_key evicted, close idle conns, wait for in-use to drain.

        Used by POST /admin/release/{db_id}. Returns dict with status and
        counts so the caller can decide whether to proceed.
        """
        if duration_seconds is None:
            duration_seconds = self.EVICTION_DEFAULT_SECONDS

        with self.locks[db_key]:
            # Close idle connections
            n_closed = 0
            while self.pools[db_key]:
                conn = self.pools[db_key].pop()
                try:
                    conn.close()
                except Exception:
                    pass
                n_closed += 1
            # Mark evicted
            self.eviction_until[db_key] = time.time() + duration_seconds

        # Wait for in-use to drain (outside the per-key lock so request
        # handlers can finish and call return_connection)
        deadline = time.monotonic() + drain_timeout_seconds
        while True:
            in_use = self.in_use.get(db_key, 0)
            if in_use <= 0:
                break
            if time.monotonic() > deadline:
                return {
                    'ok': False,
                    'closed_idle': n_closed,
                    'still_in_use': in_use,
                    'eviction_expires_in': duration_seconds,
                    'reason': f"in_use did not drain within {drain_timeout_seconds:.0f}s",
                }
            time.sleep(0.1)

        # Drain happened; also close any conns that came back during the wait
        with self.locks[db_key]:
            late_returns = 0
            while self.pools[db_key]:
                conn = self.pools[db_key].pop()
                try:
                    conn.close()
                except Exception:
                    pass
                late_returns += 1

        return {
            'ok': True,
            'closed_idle': n_closed + late_returns,
            'still_in_use': 0,
            'eviction_expires_in': duration_seconds,
        }

    def restore(self, db_key: str) -> Dict[str, Any]:
        """Clear eviction state so new connections can be issued again."""
        with self.locks[db_key]:
            was_evicted = self._is_evicted_unlocked(db_key)
            self.eviction_until.pop(db_key, None)
        return {'was_evicted': was_evicted}

    def return_connection(self, db_key: str, conn):
        """Return a connection to the pool"""
        with self.locks[db_key]:
            if len(self.pools[db_key]) < self.max_connections_per_db:
                self.pools[db_key].append(conn)
                self.in_use[db_key] = max(0, self.in_use[db_key] - 1)
            else:
                # Close if pool is full
                conn.close()
                self.in_use[db_key] = max(0, self.in_use[db_key] - 1)

    def close_all(self):
        """Close all pooled connections"""
        for db_key, conns in self.pools.items():
            for conn in conns:
                try:
                    conn.close()
                except:
                    pass
            conns.clear()
        self.pools.clear()
        self.in_use.clear()

    def get_stats(self) -> Dict[str, Any]:
        """Get pool statistics — includes the adaptive-throttling state so
        operators can see when concurrent load is squeezing the per-conn
        memory budget.
        """
        in_use = sum(self.in_use.values())
        # Predict what the NEXT acquire would get, given current load.
        next_budget_mb = max(self.min_memory_mb,
                             self.total_memory_mb // max(1, in_use + 1))
        return {
            'total_connections': self.total_connections,
            'active_databases': len(self.pools),
            'pooled_connections': sum(len(p) for p in self.pools.values()),
            'in_use': in_use,
            'cache_hits': self.hits,
            'cache_misses': self.misses,
            'hit_rate': self.hits / max(1, self.hits + self.misses),
            'memory': {
                'total_budget_mb':         self.total_memory_mb,
                'min_per_conn_mb':         self.min_memory_mb,
                'last_per_conn_mb':        self.last_per_conn_mb,
                'next_acquire_per_conn_mb': next_budget_mb,
                # How aggressively throttled: 1.0 = no throttling, 0.5 = half budget per conn, etc.
                'throttle_ratio':          next_budget_mb / self.total_memory_mb,
                'temp_directory':          self.temp_directory,
            },
        }


