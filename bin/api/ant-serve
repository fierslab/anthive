@app.get("/databases/{db_id:path}/plot/kde2d", tags=["plots"])
async def plot_kde2d_endpoint(
    common: CommonPlotParams = Depends(),
    x: str = Query(..., description="X-axis continuous field (gene or numerical obs)."),
    y: str = Query(..., description="Y-axis continuous field (gene or numerical obs)."),
    transform_x: Optional[str] = Query(
        None,
        description="Per-axis transform: linear (default) | log | log1p | signed_log1p | asinh | signed_sqrt | rank.",
    ),
    transform_y: Optional[str] = Query(None),
    asinh_scale: float = Query(1.0, gt=0.0, le=1000.0),
    kde_n: int = Query(
        15_000, ge=100, le=200_000,
        description="Subsample size for the KDE fit. Full evaluation on >100k cells is slow with no visible gain.",
    ),
    kde_bw: Optional[float] = Query(
        0.22, gt=0.0, le=10.0,
        description="Bandwidth (Gaussian KDE scale). Lower = sharper. Set 0 / omit for Scott's rule.",
    ),
    n_levels: int = Query(10, ge=2, le=30, description="Number of contour levels (per group in multi-category mode)."),
    iso_overlay: bool = Query(True, description="Draw thin white iso-density lines over the filled contours (single-group mode only)."),
    point_overlay: bool = Query(False, description="Raster scatter under the contours (off by default for clarity)."),
    marginals: bool = Query(False, description="Add univariate KDE strips on top of x and right of y."),
    regline: Optional[str] = Query(
        None,
        regex='^global$',
        description=(
            "Overlay a regression line + R² / Pearson / Spearman / slope. "
            "Only ``global`` is supported on kde2d."
        ),
    ),
    color: Optional[str] = Query(
        None,
        description=(
            "Optional grouping field.  Categorical → one line-contour set "
            "per group, overlaid on shared axes with a category legend "
            "(cap 8 groups).  Continuous → pair with ``bin_color=N`` to "
            "bin into categorical groups first."
        ),
    ),
    bin_color: Optional[int] = Query(
        None, ge=2, le=20,
        description=(
            "Bin a continuous ``color`` (numerical obs or gene) into N "
            "categorical groups before splitting the density.  Required "
            "when ``color`` is not already categorical."
        ),
    ),
    bin_color_method: str = Query(
        'quantile',
        regex='^(quantile|width)$',
        description=(
            "How ``bin_color`` cuts the range: ``quantile`` (equal-count, "
            "default) or ``width`` (equal-width)."
        ),
    ),
    exclude_zero: bool = Query(
        False,
        description=(
            "When x AND/OR y is a gene, drop cells where the gene axis "
            "== 0 before fitting the KDE. Reveals the shape of the "
            "co-expressing population. Ignored on numerical obs axes."
        ),
    ),
):
    """2-D Gaussian kernel-density estimate over two continuous fields
    (e.g. two WGCNA module scores, or two gene expressions).

    Workflow:

    * apply the per-axis transform (default linear)
    * fit a Gaussian KDE on a ``kde_n``-cell subsample
    * evaluate the density on a shared 200×200 grid
    * single-group → filled sequential contours + optional iso lines
    * multi-group (``color`` set) → one line-contour set per group in
      distinct palette colors, with a categorical legend
    """
    req = _build_plot_request(
        common, 'kde2d',
        x=x, y=y, color=color,
        transform_x=transform_x, transform_y=transform_y,
        asinh_scale=asinh_scale,
        kde_n=kde_n, kde_bw=kde_bw if kde_bw and kde_bw > 0 else None,
        n_levels=n_levels,
        iso_overlay=iso_overlay,
        point_overlay=point_overlay,
        marginals=marginals,
        regline=regline,
        bin_color=bin_color, bin_color_method=bin_color_method,
        exclude_zero=exclude_zero,
    )
    return await _render_plot(req, common.request)


