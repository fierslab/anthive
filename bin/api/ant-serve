        common, 'volcano',
        de_study=study, de_term=term, de_contrast=contrast,
        padj_threshold=padj_threshold, log2fc_threshold=log2fc_threshold,
        log2fc_clip=log2fc_clip, neglog10p_clip=neglog10p_clip,
