class EvictedDatabaseError(RuntimeError):
    """Raised when get_connection() is called on a db_key that has been
    administratively evicted (a writer is holding the duckdb r/w lock)."""


class _DbInstance:
    """One private DuckDB instance holding a single dataset ATTACHed as ``db``.

    ``in_use`` counts cursors handed out and not yet returned. ``retired``
    instances receive no new cursors and close when their last cursor comes
    back (rescan / release while a query is still running).
    """

    __slots__ = ('conn', 'in_use', 'retired')

    def __init__(self, conn):
        self.conn = conn
        self.in_use = 0
        self.retired = False


class ConnectionPool:
    """Per-dataset DuckDB instances, handed out as one cursor per request.

    Each dataset gets its own in-memory DuckDB instance with the ``.duckdb``
    ATTACHed read-only as ``db``. Resource settings (threads, memory_limit,
    temp_directory) are fixed at instance creation; the instance is then
    hardened (``allowed_directories`` + ``enable_external_access=false``) and
    ``lock_configuration=true`` so no query can widen its own access or change
    limits. Requests get ``conn.cursor()`` + ``USE db``, so concurrent requests
    never share a DuckDB connection object.

    Why a private in-memory instance instead of ``duckdb.connect(path)``: DuckDB
    shares one instance per file path inside a process, so settings are
    per-instance (a per-connection ``SET memory_limit`` changes it for every
    query on that file) and a second ``connect(path)`` with a different config
    is refused. An ATTACHed file keeps ``information_schema`` scoped to that
    one dataset, which a single shared instance with every dataset attached
    would not.

    Open instances are capped (LRU, idle ones only) because every instance
    starts ``threads - 1`` worker threads eagerly.

    Supports eviction (POST /admin/release/{db_id}) for the AnnotationWriter
    workflow: the instance is closed (file lock dropped) once in-flight
    cursors drain, and no new cursors are issued until restore or expiry.
    """

    EVICTION_DEFAULT_SECONDS = 300.0

    def __init__(self, s3_config: Optional[Dict] = None, threads: int = 8,
                 memory_limit: str = 'auto',
                 temp_directory: Optional[str] = None,
                 allowed_directories: Optional[List[str]] = None,
                 max_open_databases: int = 48):
        """
        Args:
            s3_config: anthive.yaml ``s3`` block, for ``s3://`` datasets.
            threads: DuckDB worker threads per dataset instance.
            memory_limit: DuckDB memory ceiling per dataset instance.
                ``'auto'`` = 25% of system RAM, capped at 16 GB.
            temp_directory: spill directory (created if missing). ``None``
                disables spilling.
            allowed_directories: directories queries may read (the data
                folder, symlink targets, ...). The directory of each attached
                ``.duckdb`` is added per instance automatically.
            max_open_databases: cap on simultaneously open dataset instances;
                the least recently used idle instance is closed past it.
        """
        import os
        self.s3_config = s3_config or {}
        self.threads = max(1, int(threads))
        self.memory_limit_mb = (
            _auto_total_memory_budget_mb() if str(memory_limit) == 'auto'
            else _parse_size_mb(memory_limit)
        )
        self.max_open_databases = max(1, int(max_open_databases))

        self.temp_directory = temp_directory
        if temp_directory:
            try:
                os.makedirs(temp_directory, exist_ok=True)
                self.temp_directory = os.path.abspath(temp_directory)
            except OSError as exc:
                log.warning("ConnectionPool: cannot create temp_directory %r: %s; "
                            "spilling disabled, queries past the limit will OOM.",
                            temp_directory, exc)
                self.temp_directory = None

        allowed = set()
        for directory in (allowed_directories or []):
            allowed.add(_dir_prefix(directory))
            try:
                allowed.add(_dir_prefix(os.path.realpath(directory)))
            except OSError:
                pass
        if self.temp_directory:
            allowed.add(_dir_prefix(self.temp_directory))
        bucket = self.s3_config.get('bucket')
        if bucket:
            prefix = (self.s3_config.get('prefix') or '').strip('/')
            allowed.add(f"s3://{bucket}/{prefix + '/' if prefix else ''}")
        self.allowed_directories = sorted(allowed)

        self._registry_lock = Lock()
        self._locks: Dict[str, Lock] = {}
        self._instances: "OrderedDict[str, _DbInstance]" = OrderedDict()  # LRU order
        self._retiring: Dict[str, List[_DbInstance]] = {}
        self._owners: Dict[int, _DbInstance] = {}      # id(cursor) -> instance
        self.in_use: Dict[str, int] = {}
        self.eviction_until: Dict[str, float] = {}     # db_key -> unix timestamp
        self.total_connections = 0                      # instances opened
        self.hits = 0
        self.misses = 0
        self.lru_closes = 0
        self._httpfs_installed = False

        log.info(
            'ConnectionPool: per-db instance memory_limit=%dMB threads=%d '
            'max_open_databases=%d temp_directory=%s allowed_directories=%s',
            self.memory_limit_mb, self.threads, self.max_open_databases,
            self.temp_directory or '(disabled)', self.allowed_directories,
        )

    # ── instance lifecycle ────────────────────────────────────────────────

    def _lock_for(self, db_key: str) -> Lock:
        with self._registry_lock:
            lock = self._locks.get(db_key)
            if lock is None:
                lock = self._locks[db_key] = Lock()
            return lock

    def _configure_s3(self, conn) -> None:
        """Load httpfs and register the S3 secret. Must run before hardening."""
        if not self._httpfs_installed:
            conn.execute("INSTALL httpfs")
            self._httpfs_installed = True
        conn.execute("LOAD httpfs")
        s3 = self.s3_config
        raw_ep = (s3.get('endpoint') or '').strip()
        ep_host = raw_ep.removeprefix('https://').removeprefix('http://')
        use_ssl = not raw_ep.startswith('http://')
        use_path_style = s3.get('use_path_style') or bool(ep_host)
        fields = [
            "TYPE S3",
            f"KEY_ID {_sql_str(s3.get('access_key_id') or '')}",
            f"SECRET {_sql_str(s3.get('secret_access_key') or '')}",
        ]
        if ep_host:
            fields.append(f"ENDPOINT {_sql_str(ep_host)}")
        if s3.get('region'):
            fields.append(f"REGION {_sql_str(s3['region'])}")
        fields.append(f"USE_SSL {'true' if use_ssl else 'false'}")
        if use_path_style:
            fields.append("URL_STYLE 'path'")
        conn.execute(f"CREATE OR REPLACE SECRET _s3 ({', '.join(fields)})")

    def _open_instance(self, db_key: str) -> _DbInstance:
        """Open a private instance, ATTACH the dataset read-only, harden, lock."""
        import os
        config = {'threads': str(self.threads), 'memory_limit': f'{self.memory_limit_mb}MB'}
        if self.temp_directory:
            config['temp_directory'] = self.temp_directory
        conn = duckdb.connect(':memory:', config=config)
        try:
            allowed = list(self.allowed_directories)
            if db_key.startswith('s3://'):
                self._configure_s3(conn)
            else:
                # Parquet sidecars sit next to the .duckdb and are read via
                # their resolved path, which may be outside the data folder
                # when the dataset is symlinked in from another store.
                allowed.append(_dir_prefix(os.path.dirname(os.path.realpath(db_key))))
                allowed.append(_dir_prefix(os.path.dirname(os.path.abspath(db_key))))
            conn.execute(f"ATTACH {_sql_str(db_key)} AS db (READ_ONLY)")
            allowed_sql = ', '.join(_sql_str(path) for path in sorted(set(allowed)))
            conn.execute(f"SET allowed_directories = [{allowed_sql}]")
            conn.execute("SET enable_external_access = false")
            conn.execute("SET lock_configuration = true")
        except Exception:
            conn.close()
            raise
        return _DbInstance(conn)

    def _close_instance(self, instance: _DbInstance) -> None:
        try:
            instance.conn.close()
        except duckdb.Error as exc:
            log.warning("ConnectionPool: closing instance failed: %s", exc)

    def _retire_current_unlocked(self, db_key: str) -> int:
        """Caller holds the db_key lock. Close the current instance if idle,
        else mark it retired so its last returning cursor closes it.
        Returns 1 when an instance was closed right away."""
        with self._registry_lock:
            instance = self._instances.pop(db_key, None)
        if instance is None:
            return 0
        if instance.in_use == 0:
            self._close_instance(instance)
            return 1
        instance.retired = True
        self._retiring.setdefault(db_key, []).append(instance)
        return 0

    def _enforce_open_cap(self) -> None:
        """Close least-recently-used idle instances beyond max_open_databases."""
        with self._registry_lock:
            excess = len(self._instances) - self.max_open_databases
            candidates = list(self._instances.keys()) if excess > 0 else []
        for db_key in candidates:
            if excess <= 0:
                break
            lock = self._lock_for(db_key)
            if not lock.acquire(blocking=False):
                continue
            try:
                with self._registry_lock:
                    instance = self._instances.get(db_key)
                    if instance is None or instance.in_use > 0:
                        continue
                    del self._instances[db_key]
                self._close_instance(instance)
                self.lru_closes += 1
                excess -= 1
            finally:
                lock.release()

    def _is_evicted_unlocked(self, db_key: str) -> bool:
        """Caller must hold the db_key lock. Auto-clears expired evictions."""
        deadline = self.eviction_until.get(db_key)
        if deadline is None:
            return False
        if time.time() >= deadline:
            self.eviction_until.pop(db_key, None)
            return False
        return True

    # ── public API ────────────────────────────────────────────────────────

    def get_connection(self, db_key: str):
        """Return a fresh cursor on this dataset's instance (``USE db`` applied).

        Every cursor must go back through ``return_connection``.
        """
        with self._lock_for(db_key):
            if self._is_evicted_unlocked(db_key):
                expires_in = self.eviction_until[db_key] - time.time()
                raise EvictedDatabaseError(
                    f"db_key {db_key!r} is currently evicted by a writer "
                    f"(expires in {expires_in:.0f}s). Retry shortly or call "
                    f"POST /admin/restore/{{db_id}} to clear."
                )
            with self._registry_lock:
                instance = self._instances.get(db_key)
            if instance is None:
                instance = self._open_instance(db_key)
                self.total_connections += 1
                self.misses += 1
            else:
                self.hits += 1
            with self._registry_lock:
                self._instances[db_key] = instance
                self._instances.move_to_end(db_key)
            cursor = instance.conn.cursor()
            try:
                cursor.execute("USE db")
            except Exception:
                cursor.close()
                raise
            instance.in_use += 1
            self.in_use[db_key] = self.in_use.get(db_key, 0) + 1
            with self._registry_lock:
                self._owners[id(cursor)] = instance
        self._enforce_open_cap()
        return cursor

    def return_connection(self, db_key: str, conn):
        """Close a cursor from ``get_connection`` and release its slot."""
        with self._lock_for(db_key):
            with self._registry_lock:
                instance = self._owners.pop(id(conn), None)
            try:
                conn.close()
            except duckdb.Error as exc:
                log.warning("ConnectionPool: closing cursor for %s failed: %s", db_key, exc)
            if instance is None:
                return
            instance.in_use -= 1
            self.in_use[db_key] = max(0, self.in_use.get(db_key, 0) - 1)
            if instance.retired and instance.in_use == 0:
                self._close_instance(instance)
                retiring = self._retiring.get(db_key, [])
                if instance in retiring:
                    retiring.remove(instance)
                if not retiring:
                    self._retiring.pop(db_key, None)

    def release(self, db_key: str, *,
                duration_seconds: Optional[float] = None,
                drain_timeout_seconds: float = 30.0) -> Dict[str, Any]:
        """Mark db_key evicted, close its instance once in-flight cursors drain.

        Used by POST /admin/release/{db_id}. Returns a dict with status and
        counts so the caller can decide whether to proceed. On a drain
        timeout the eviction stays set and the instance closes as soon as the
        last cursor returns, so a writer retrying shortly will get the lock.
        """
        if duration_seconds is None:
            duration_seconds = self.EVICTION_DEFAULT_SECONDS

        with self._lock_for(db_key):
            self.eviction_until[db_key] = time.time() + duration_seconds
            n_closed = self._retire_current_unlocked(db_key)

        deadline = time.monotonic() + drain_timeout_seconds
        while self.in_use.get(db_key, 0) > 0:
            if time.monotonic() > deadline:
                return {
                    'ok': False,
                    'closed_idle': n_closed,
                    'still_in_use': self.in_use.get(db_key, 0),
                    'eviction_expires_in': duration_seconds,
                    'reason': f"in_use did not drain within {drain_timeout_seconds:.0f}s",
                }
            time.sleep(0.05)

        return {
            'ok': True,
            'closed_idle': n_closed,
            'still_in_use': 0,
            'eviction_expires_in': duration_seconds,
        }

    def restore(self, db_key: str) -> Dict[str, Any]:
        """Clear eviction state so a fresh instance is opened on next use."""
        with self._lock_for(db_key):
            was_evicted = self._is_evicted_unlocked(db_key)
            self.eviction_until.pop(db_key, None)
        return {'was_evicted': was_evicted}

    def close_all(self):
        """Retire every instance: idle ones close now, busy ones on last return.

        Used by rescan: the next request opens a fresh instance that sees the
        current schema, while queries already running finish on the old one.
        """
        with self._registry_lock:
            keys = list(self._instances.keys())
        for db_key in keys:
            with self._lock_for(db_key):
                self._retire_current_unlocked(db_key)

    def get_stats(self) -> Dict[str, Any]:
        """Pool statistics for /metrics."""
        with self._registry_lock:
            open_instances = len(self._instances)
            retiring = sum(len(v) for v in self._retiring.values())
        return {
            'total_connections': self.total_connections,
            'active_databases': open_instances,
            'pooled_connections': open_instances,
            'retiring_instances': retiring,
            'in_use': sum(self.in_use.values()),
            'cache_hits': self.hits,
            'cache_misses': self.misses,
            'hit_rate': self.hits / max(1, self.hits + self.misses),
            'lru_closes': self.lru_closes,
            'max_open_databases': self.max_open_databases,
            'memory': {
                'per_db_limit_mb': self.memory_limit_mb,
                'threads_per_db': self.threads,
                'temp_directory': self.temp_directory,
            },
        }


