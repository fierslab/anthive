def _auth_cell(base_url: str) -> str:
    """Cell 2: connect to the anthive server.

    Generic phrasing — does NOT mention Authelia or any specific gateway.
    The active line is ``c = AnthiveClient(BASE_URL)`` which works for all
    four deployment cases (public / JupyterLite cookie / vark-config /
    explicit auth). The explicit-password line is provided as a commented
    escape hatch.
    """
    return (
        "# Connect to the anthive server.\n"
        "#\n"
        "# In JupyterLite (the in-browser flavour of this notebook) you're already\n"
        "# authenticated via your browser session — no credentials below are needed.\n"
        "#\n"
        "# Anywhere else (a local Jupyter, your laptop's IDE, a CI runner):\n"
        "#  - the easiest path is to install `pyvark[vark-config]` and let pyvark\n"
        "#    pick up credentials stored by the Go `vark` CLI. See\n"
        "#    https://codeberg.org/mfiers/pyvark#reusing-vark-cli-credentials\n"
        "#  - or pass auth=(\"user\", \"password\") explicitly to AnthiveClient(...)\n"
        "#\n"
        "# Documentation:\n"
        "#   pyvark: https://codeberg.org/mfiers/pyvark\n"
        "#   vark:   https://codeberg.org/mfiers/vark\n"
        "\n"
        "# JupyterLite/Pyodide auto-installs plotting deps + pyvark from PyPI on first use:\n"
        "import sys\n"
        "if \"pyodide\" in sys.modules:\n"
        "    import micropip\n"
        "    await micropip.install([\"pyvark\", \"seaborn\"])\n"
        "from vark import AnthiveClient\n"
        "\n"
        f"BASE_URL = {base_url!r}\n"
        "c = AnthiveClient(BASE_URL)  # JupyterLite + vark-config both work without explicit auth=\n"
        "# c = AnthiveClient(BASE_URL, auth=(\"<user>\", \"<password>\"))  # explicit-credentials fallback"
    )


def _params_cell(
    db_id: str,
    geom: str,
    biology_params: Dict[str, Any],
    render_params: Dict[str, Any],
) -> str:
    """Cell 3: define DB_ID, GEOM, PLOT_PARAMS (biology), RENDER_PARAMS (visual)."""
    plot_literal = _dict_call_literal(biology_params)
