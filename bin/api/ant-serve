        iso_overlay=iso_overlay, point_overlay=point_overlay,
        marginals=marginals, regline=regline,
        de_study=de_study, de_term=de_term,
        de_contrast=de_contrast, de_gene=de_gene,
        padj_threshold=padj_threshold,
        log2fc_threshold=log2fc_threshold,
        log2fc_clip=log2fc_clip,
        clip_x=clip_x,
        clip_y=clip_y,
        neglog10p_clip=neglog10p_clip,
        logmean_clip=logmean_clip,
        n_label=n_label,
        de_contrasts=de_contrasts,
        de_genes=de_genes,
        de_value=de_value,
        sig_overlay=sig_overlay,
        sort=sort,
        sort_desc=sort_desc,
        db_y=db_y,
        de_study_y=de_study_y,
        de_term_y=de_term_y,
