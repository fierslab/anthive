# ── /module-variability ──────────────────────────────────────────────
#
# Fleet-wide, per-(dataset × module × tag × statistic) table produced by
# `bin/annot/ant-module-variability`. Long-format parquet at
# <h5adstore>/module_variability.parquet.
#
# Kept in memory (a few MB) and reloaded when the file's mtime changes.

_MODULE_VARIABILITY_CACHE: Dict[str, Any] = {
    "df": None,       # pandas DataFrame or None
    "mtime": 0.0,     # last-seen mtime on disk
}


def _module_variability_path() -> Path:
    return Path(registry.data_folder) / "module_variability.parquet"


def _load_module_variability(force: bool = False):
    """Return the cached DataFrame; reload lazily on mtime change."""
    import pandas as _pd
    path = _module_variability_path()
    if not path.exists():
        _MODULE_VARIABILITY_CACHE["df"] = None
        _MODULE_VARIABILITY_CACHE["mtime"] = 0.0
        return None
    mtime = path.stat().st_mtime
    if (not force and _MODULE_VARIABILITY_CACHE["df"] is not None
            and _MODULE_VARIABILITY_CACHE["mtime"] == mtime):
        return _MODULE_VARIABILITY_CACHE["df"]
    df = _pd.read_parquet(path)
    _MODULE_VARIABILITY_CACHE["df"] = df
    _MODULE_VARIABILITY_CACHE["mtime"] = mtime
    return df


@app.get("/module-variability", tags=["genesets"])
def get_module_variability(
    dataset: Optional[str] = Query(None, description="Filter by db_id."),
    db_id: Optional[str] = Query(None, description="Alias for `dataset` (accepted for client-side symmetry with other endpoints)."),
    source: Optional[str] = Query(None, description="'geneset' or 'starcat'."),
    catalog: Optional[str] = Query(None, description="E.g. 'Sierksma2025/WGCNA' or 'MICROGLIA_V1'."),
    module: Optional[str] = Query(None, description="Module / program name."),
    tag: Optional[str] = Query(None, description="Tag from the obscol_tags vocab."),
    tag_column: Optional[str] = Query(None, description="Original obs column name that carries the tag."),
    statistic: Optional[str] = Query(None, description="'eta2' | 'omega2' | 'R2' | 'spearman' | 'F' | 'mean_range' | 'total_var' | 'mean_score'."),
    min: Optional[float] = Query(None, alias="min", description="Lower bound on `value`."),
    max: Optional[float] = Query(None, alias="max", description="Upper bound on `value`."),
    min_abs: Optional[float] = Query(None, description="Lower bound on |value| (for signed stats like spearman)."),
    sort: str = Query("value:desc", description="'value:desc' (default), 'value:asc', 'abs_value:desc'."),
    limit: int = Query(500, ge=1, le=100000, description="Max rows returned."),
    format: str = Query("json", pattern="^(json|csv|tsv)$"),
):
    """Per-(dataset × source × catalog × module × tag × statistic) statistics.

    Statistics — variance-explained frame, comparable across categorical /
    numerical tags AND across datasets with different overall variability:
      - `eta2`, `omega2` — for categorical tags (fraction of module-score
                          variance explained by the tag categories).
      - `R2`             — for numerical tags (Pearson).
      - `spearman`       — signed monotone association (numerical tags).
      - `mean_range`     — max−min group mean (categorical).
      - `F`              — Fisher F statistic (categorical).
      - `total_var`      — Var(module score) on this dataset (denominator).
      - `mean_score`     — mean of the module on this dataset.

    Also see the [/analytics/query] endpoint — the same table is attached
    there as a view named `module_variability` for full SQL access.
    """
    df = _load_module_variability()
    if df is None or df.empty:
        raise HTTPException(status_code=503, detail=(
            "module_variability.parquet not present under "
            f"{registry.data_folder}. Run `ant module-variability` to generate."
        ))

    # ``db_id`` is an alias for ``dataset`` — callers writing generic
    # "identify the dataset by its db_id" client code shouldn't have to know
    # this endpoint uses a different name. Explicit ``dataset`` wins if both
    # are supplied and disagree.
    if dataset is None and db_id is not None:
        dataset = db_id

    # Back-compat alias: ?tag_column=braak → ant_braak when ant_braak exists
    # in the parquet's tag_column values and braak itself does not.
    alias_notices: list[str] = []
    if tag_column is not None:
        available_tag_columns: Set[str] = set(df['tag_column'].unique())
        resolved_tag_column, tc_notice = _alias_canonical(tag_column, available_tag_columns)
        if tc_notice:
            alias_notices.append(tc_notice)
        tag_column = resolved_tag_column

    # Filter
    working = df
    if dataset:   working = working[working['dataset']    == dataset]
    if source:    working = working[working['source']     == source]
    if catalog:   working = working[working['catalog']    == catalog]
    if module:    working = working[working['module']     == module]
    if tag:       working = working[working['tag']        == tag]
    if tag_column: working = working[working['tag_column'] == tag_column]
    if statistic: working = working[working['statistic']  == statistic]
    if min is not None: working = working[working['value'] >= min]
    if max is not None: working = working[working['value'] <= max]
    if min_abs is not None:
        import numpy as _np
        working = working[_np.abs(working['value']) >= min_abs]

    # NaN / ±Inf in ``value`` (missing statistics or degenerate F/eta² on
    # constant groups) are not JSON-compliant floats — a stray one causes
    # ``to_dict`` → jsonable_encoder to raise ValueError → uvicorn 500. Drop
    # them here so the endpoint never bombs on a legitimate query. If the
    # user explicitly asked for the raw value with ``min_abs`` unset that
    # would otherwise let NaN through, we still filter — anyone wanting the
    # NaN rows can select ``statistic=NaN`` explicitly, which is impossible
    # (statistic column carries the *name*, not the *value*).
    import numpy as _np
    _finite_mask = _np.isfinite(working['value'].astype(float, copy=False))
    working = working[_finite_mask]

    # Sort
    if sort == "value:asc":
        working = working.sort_values('value', ascending=True)
    elif sort == "abs_value:desc":
        import numpy as _np
        working = working.assign(_abs=_np.abs(working['value'])).sort_values(
            '_abs', ascending=False).drop(columns=['_abs'])
    else:   # value:desc default
        working = working.sort_values('value', ascending=False)

    truncated = len(working) > limit
    working = working.head(limit)

    extra_headers: Dict[str, str] = {}
    if alias_notices:
        extra_headers['X-Anthive-Deprecated-Alias'] = ', '.join(alias_notices)

    if format in ("csv", "tsv"):
        sep = "," if format == "csv" else "\t"
        csv = working.to_csv(index=False, sep=sep)
        return Response(
            content=csv,
            media_type="text/csv" if format == "csv" else "text/tab-separated-values",
            headers={
                "X-Total-Available": str(len(df)),
                "X-Rows-Returned": str(len(working)),
                "X-Truncated": "true" if truncated else "false",
                **extra_headers,
            },
        )
    payload: Dict[str, Any] = {
        "n_rows": int(len(working)),
        "n_total": int(len(df)),
        "truncated": bool(truncated),
        "sort": sort,
        "rows": working.to_dict(orient="records"),
    }
    if extra_headers:
        return JSONResponse(content=payload, headers=extra_headers)
    return payload


