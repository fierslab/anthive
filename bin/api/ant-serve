    ),
    color: Optional[str] = Query(
        None,
        description=(
            "Categorical field — splits each y into one line per group (e.g. "
            "wild-type vs knockout).  Pass a numerical obs field or gene "
            "together with ``bin_color=N`` to split by binned quantile/width "
