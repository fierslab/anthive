        None, gt=0.0, le=50.0,
        description=(
            "Symmetric visual clamp on the log2fc axis — points with |log2fc| beyond "
            "this are drawn at ±clip (their actual value still drives significance). "
            "Useful to compress huge sex-chromosome / lineage-marker outliers so the "
            "bulk of the distribution gets visual space."
        ),
    ),
    neglog10p_clip: Optional[float] = Query(
