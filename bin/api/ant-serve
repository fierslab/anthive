def _emit_dataframe(df, req) -> Tuple[bytes, str]:
    """Serialise a handler's source dataframe as CSV / TSV bytes.

    Used by every plot handler when the request asked for
    output_format='csv' or 'tsv' — same URL + params as the image
    render, but the response carries the post-subset/post-sample
    dataframe the handler queried from the DB. Lets the web UI
    expose a "⬇ data" button that's guaranteed consistent with the
    plotted image (no client-side reconstruction).

    The caption is reused for the X-Plot-Caption response header so
    downstream consumers see the same context as the image path.
    """
    import io
    sep = '\t' if req.output_format == 'tsv' else ','
    buf = io.StringIO()
    df.to_csv(buf, sep=sep, index=False)
    n_rows, n_cols = df.shape if hasattr(df, 'shape') else (len(df), 0)
    # HTTP headers are latin-1; avoid em-dash / multiplication-sign chars.
    caption = (
        f"data behind /plot/{req.geom} for {req.db_id}: "
        f"{n_rows} rows x {n_cols} cols"
    )
    return buf.getvalue().encode('utf-8'), caption


def _resolve_descriptor_inputs(
    plot_req: PlotRequest,
    ctx: 'PlotContext',
) -> Dict[str, Any]:
    """Resolve the biology-relevant fields of ``plot_req`` against ``ctx``
    so ``plotting.build_plot_descriptor`` can produce a title/filename.

    Pure dispatch — no DB queries beyond ``ctx.resolve`` (which itself just
    looks at cached field lists). Failures resolve to ``None`` rather than
    raising; the descriptor builder copes with missing kinds.
    """
    def _safe_resolve(name: Optional[str]) -> Tuple[Optional[str], Optional[str]]:
        if not name:
            return None, None
        try:
            resolved, kind = ctx.resolve(name)
            return resolved, kind
        except Exception:
            return name, None

    _x, x_kind = _safe_resolve(plot_req.x)
    _y, y_kind = _safe_resolve(plot_req.y)
    _color, color_kind = _safe_resolve(plot_req.color)

    # Embedding-default fallback: scatter / hexbin with no x land on the
    # dataset's default embedding (X_umap when present, else first
    # available). Mirror the handler's choice so the title says e.g.
    # "P2RY12 expression on X_umap" instead of "... on embedding".
    x_for_descriptor = plot_req.x
    if (
        plot_req.geom in ('scatter', 'hexbin')
        and not plot_req.x
        and ctx.available_embeddings
    ):
        x_for_descriptor = (
            'X_umap' if 'X_umap' in ctx.available_embeddings
            else ctx.available_embeddings[0]
        )
        x_kind = 'embedding'

    return {
        'geom':         plot_req.geom,
        'db_id':        plot_req.db_id,
        'x':            x_for_descriptor,
        'x_kind':       x_kind,
        'y':            plot_req.y,
        'y_kind':       y_kind,
        'color':        plot_req.color,
        'color_kind':   color_kind,
        'filters':      plot_req.filters,
        'de_study':     plot_req.de_study,
        'de_term':      plot_req.de_term,
        'de_contrast':  plot_req.de_contrast,
        'de_gene':      plot_req.de_gene,
    }


def _descriptor_inputs_static(plot_req: PlotRequest) -> Dict[str, Any]:
    """Best-effort descriptor inputs when no PlotContext is available
    (cache HIT path before we open the DB). Falls back to the request's
    raw field names with unknown kinds — the descriptor builder still
    produces a sensible result, the embedding-vs-XY branch may be slightly
    fuzzy for raw scatter/hexbin requests but the cached descriptor was
    computed against the live ctx on MISS and is reused verbatim."""
    return {
        'geom':         plot_req.geom,
        'db_id':        plot_req.db_id,
        'x':            plot_req.x,
        'x_kind':       None,
        'y':            plot_req.y,
        'y_kind':       None,
        'color':        plot_req.color,
        'color_kind':   None,
        'filters':      plot_req.filters,
        'de_study':     plot_req.de_study,
        'de_term':      plot_req.de_term,
        'de_contrast':  plot_req.de_contrast,
        'de_gene':      plot_req.de_gene,
    }


async def _render_plot(plot_req: PlotRequest, request: Request) -> Response:
    """Cache-aware execution of a plot request.

    Hits the in-memory LRU first (keyed on db_id + normalised query string +
    format + file fingerprint).  On miss, runs the geom's handler in a worker
    thread, stores the result, returns a ``Response`` with the standard
    ``X-Plot-Caption`` / ``X-Plot-Title`` / ``X-Plot-Filename`` /
    ``X-Plot-Cache`` / ``ETag`` headers.

    Per-geom endpoints don't need to know any of this — they call
    ``await _render_plot(req, common.request)`` and they're done.
    """
    try:
        db_fingerprint = _plot_db_fingerprint(registry.get_database_path(plot_req.db_id))
    except KeyError:
        raise HTTPException(status_code=404, detail=f"Dataset '{plot_req.db_id}' not found")

    query_string = request.url.query if request is not None else ''
    cache_key = _plot_cache_key(
        plot_req.db_id, plot_req.geom, query_string,
        plot_req.output_format, db_fingerprint,
    )
    def _ascii_safe(s: str) -> str:
        # X-Plot-Caption rides in an HTTP response header. RFC 7230 +
        # starlette enforce latin-1 encoding, so en-dashes / em-dashes /
        # × / · / · would crash response init. Strip non-latin-1 by
        # replacing each non-encodable codepoint with a '?' so the
        # caption is best-effort but never blocks the image.
        return s.encode('latin-1', errors='replace').decode('latin-1')

    def _ext_for_format(fmt: str) -> str:
        return fmt if fmt in _PLOT_DATA_FORMATS else fmt

    cached = _plot_cache_get(cache_key)
    if cached is not None:
        # Older cache entries (pre-2.9.0) don't carry title/filename. Fall
        # back to building them now from the raw request — kinds will be
        # None so embedding-vs-XY may degrade, but the result is still
        # readable and the next MISS will repopulate with full kinds.
        cached_title = cached.get('title')
        cached_filename = cached.get('filename')
        cached_truncated = cached.get('filename_truncated', False)
        if cached_title is None or cached_filename is None:
            desc = plotting.build_plot_descriptor(**_descriptor_inputs_static(plot_req))
            cached_title = desc['title']
            cached_filename = desc['filename']
            cached_truncated = desc['filename_truncated'] == '1'
        headers = {
            'X-Plot-Caption':   _ascii_safe(cached['caption']),
            'X-Plot-Title':     _ascii_safe(cached_title),
            'X-Plot-Filename':  _ascii_safe(cached_filename),
            'X-Plot-Format':    plot_req.output_format,
            'X-Source-URL':     cached['source_url'],
            'X-Plot-Cache':     'HIT',
            'ETag':             f'"{cache_key}"',
            'Cache-Control':    'public, max-age=3600',
        }
        if cached_truncated:
            headers['X-Plot-Filename-Truncated'] = 'true'
        if plot_req.output_format in _PLOT_DATA_FORMATS:
            headers['Content-Disposition'] = (
                f'attachment; filename="{cached_filename}.{_ext_for_format(plot_req.output_format)}"'
            )
        return Response(
            content=cached['bytes'],
            media_type=cached['mime'],
            headers=headers,
        )

    handler = _PLOT_HANDLERS[plot_req.geom]

    def _sync_plot():
        with _pooled_db(plot_req.db_id) as db:
            ctx = PlotContext(
                db=db,
                available_embeddings=db._get_embeddings(),
                categorical_fields=db._get_categorical_fields(),
                numerical_fields=db._get_numerical_fields(),
            )
            descriptor_inputs = _resolve_descriptor_inputs(plot_req, ctx)
            image_bytes, caption = handler(plot_req, ctx)
            return image_bytes, caption, descriptor_inputs

    try:
        image_bytes, caption, descriptor_inputs = await asyncio.to_thread(_sync_plot)
    except HTTPException:
        raise
    except KeyError as e:
        raise HTTPException(status_code=404, detail=str(e))
    except ValueError as e:
        raise HTTPException(status_code=400, detail=str(e))
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

    desc = plotting.build_plot_descriptor(**descriptor_inputs)
    title = desc['title']
    filename = desc['filename']
    truncated = desc['filename_truncated'] == '1'

    mime = _PLOT_MIME_TYPES[plot_req.output_format]
    _plot_cache_put(cache_key, {
        'bytes':              image_bytes,
        'caption':            caption,
        'title':              title,
        'filename':           filename,
        'filename_truncated': truncated,
        'source_url':         plot_req.source_url,
        'mime':               mime,
    })
    # Starlette runs BackgroundTask after the response has been sent — the
    # client doesn't wait on the trim.  Sync target is run in a threadpool,
    # so it never blocks the event loop.  Only fired on cache MISS (HIT
    # paths don't allocate anything worth trimming).
    headers = {
        'X-Plot-Caption':   _ascii_safe(caption),
        'X-Plot-Title':     _ascii_safe(title),
        'X-Plot-Filename':  _ascii_safe(filename),
        'X-Plot-Format':    plot_req.output_format,
        'X-Source-URL':     plot_req.source_url,
        'X-Plot-Cache':     'MISS',
        'ETag':             f'"{cache_key}"',
        'Cache-Control':    'public, max-age=3600',
    }
    if truncated:
        headers['X-Plot-Filename-Truncated'] = 'true'
    if plot_req.output_format in _PLOT_DATA_FORMATS:
        headers['Content-Disposition'] = (
            f'attachment; filename="{filename}.{_ext_for_format(plot_req.output_format)}"'
        )
    return Response(
        content=image_bytes,
        media_type=mime,
        headers=headers,
        background=BackgroundTask(_release_memory),
    )


