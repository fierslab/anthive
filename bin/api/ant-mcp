        ci: bool = True,
        n_genes: int = 20,
        gridsize: int = 60,
        mincnt: int = 1,
        log_x: bool = False,
        log_y: bool = False,
        vmin: Optional[float] = None,
        vmax: Optional[float] = None,
        window: int = 200,
        show_band: bool = False,
        subset: Optional[List[str]] = None,
        sample: Optional[int] = None,
    ):
        """Generate a plot for a single-cell dataset and return a URL (and optionally an inline image).

        Field types are auto-detected from the field name — no annotation needed.

        geom choices:
          scatter     2D scatter.  Polymorphic on x:
                        x = embedding key (or omitted)        → embedding scatter
                        x = gene/numerical AND y is set       → gene-vs-gene scatter
                      Use color= for hue.  Categorical → tab10 with legend;
                      continuous → inferno_r with colorbar (auto RdBu_r when
                      data straddles 0).
          hexbin      Same polymorphism as scatter, hex-aggregated.  Categorical
                      color → modal class per hex, alpha = dominance.  Three
                      knobs: gridsize, mincnt, vmin/vmax.
          violin      Per-category distribution.  x=cat, y=gene/num,
                      optional color=second-cat for split.
          box         Same as violin, box-plot style.
          bar         Mean ± 95% CI per category.  x=cat, y=gene/num
                      (omit y for cell counts), optional color=second-cat.
          histogram   Distribution of a gene or numerical field.
          ecdf        Empirical CDF.
          kde         Kernel density estimate.
          heatmap     Mean expression across a gene list × category groups
                      (z-scored, divergent cmap).  x=comma-separated genes or
                      omit for top n_genes.  y=categorical group.
          rolling     Rolling-mean trajectory along a continuous axis (e.g.
                      pseudotime).  x=continuous, y=comma-separated continuous
                      fields, optional color=categorical for per-group lines.
                      Knobs: window (cells), show_band (IQR ribbon).

        Three palettes — pick the right family for the data:
          palette_categorical  default 'tab10'      qualitative (auto-bumps to tab20 if >10 grps)
          palette_continuous   default 'inferno_r'  sequential (counts, expression)
          palette_divergent    default 'RdBu_r'     auto-applied when continuous straddles 0

        SUBSETTING — restrict cells:
          subset=['sex:female', 'condition:AD']   AND across fields
          subset=['celltype:Microglia,Astrocyte']  OR within field
          subset=['nCount_RNA:1000..10000']        numerical range

        SAMPLING — speed up plots:
          sample=50000 (scatter), 20000 (violin/kde/ecdf), 10000 (bar/heatmap)

        Per-cell plots are DESCRIPTIVE: cells of one donor are not independent,
        so a difference between groups of cells is not a donor-level result
        (call explain('per-cell-per-donor'); for donor-level effects use the
        facet tools or aggregate per ant_donor).

        Returns:
          A URL to an HTML page (PNG/SVG) or PDF.  When the client sends
          X-Image-Output: inline, an embedded image block is also returned.

        Args:
            db_id:         Dataset identifier from search_datasets.
            geom:          One of the geom names above.
            x, y, color:   Field names; semantics geom-specific.
            output_format: 'png' (default), 'svg', or 'pdf'.
            layer:         Expression layer (default 'X').
            width/height:  Figure size in inches.
            dpi:           Output resolution (default 150).
            point_size:    Scatter point size (default 3).
            alpha:         Scatter / hexbin transparency.
            palette_*:     See three-palette note above.
            ci:            Show 95% CI on bar plots.
            n_genes:       Top genes for heatmap when x is not given.
            gridsize:      Hexbin: hex columns along x (default 60).
            mincnt:        Hexbin: minimum cells per hex (default 1).
            log_x, log_y:  Apply log1p to x/y on gene-vs-gene scatter/hexbin.
            vmin, vmax:    Clip the continuous colour scale (None = auto).
            window:        Rolling: window size in cells (default 200).
            show_band:     Rolling: shade IQR ribbon (default False).
            subset:        See SUBSETTING above.
            sample:        See SAMPLING above.
        """
        if geom not in PLOT_GEOM_PARAMS:
            return f"Unknown geom '{geom}'. Valid: {sorted(PLOT_GEOM_PARAMS)}"
        candidate_params = dict(
            x=x, y=y, color=color,
            format=output_format, layer=layer,
            width=width, height=height, dpi=dpi,
            bins=bins, point_size=point_size, alpha=alpha,
            palette_categorical=palette_categorical,
            palette_continuous=palette_continuous,
            palette_divergent=palette_divergent,
            ci=ci, n_genes=n_genes,
            gridsize=gridsize, mincnt=mincnt,
            log_x=log_x, log_y=log_y,
            vmin=vmin, vmax=vmax,
            window=window, show_band=show_band,
            subset=subset or [], sample=sample,
        )
        allowed = PLOT_COMMON_PARAMS | PLOT_GEOM_PARAMS[geom]
        image_bytes, headers = await _get_plot(
            f'/databases/{db_id}/plot/{geom}',
            **{name: value for name, value in candidate_params.items() if name in allowed},
        )
        caption = headers.get('x-plot-caption', '')
        return _make_plot_response(image_bytes, output_format, caption)

    # ── analytics tools ────────────────────────────────────────────────────────

    @mcp.tool()
    async def analytics_schema(db_id: str) -> str:
        """Explore the DuckDB schema of a dataset — list tables, columns, and sample rows.

        Call this first when planning a custom analysis to understand what tables
        and fields are available.  Then write a SQL query with analytics_query.

        Args:
            db_id: Dataset identifier (e.g. 'S25/SGM').
        """
        try:
            data = await _get(f'/databases/{db_id}/analytics/schema')
        except httpx.HTTPStatusError as error:
            if error.response.status_code == 404:
                return f"Dataset '{db_id}' not found. Use search_datasets to find valid IDs."
            raise

        lines = [f"Schema for {db_id}:\n"]
        for table in data.get('tables', []):
            row_count = table.get('row_count')
            count_str = f"  ({row_count:,} rows)" if row_count is not None else ''
            lines.append(f"Table: {table['table']}{count_str}")
            for col in table.get('columns', []):
                lines.append(f"  {col['name']}  [{col['type']}]")
            sample = table.get('sample', [])
            if sample:
                lines.append(f"  Sample: {sample[0]}")
            lines.append('')
        sidecar = data.get('score_sidecar') or {}
        if sidecar.get('available'):
            by_source = ', '.join(f"{source}: {count}" for source, count in
                                  sorted((sidecar.get('n_scores_by_source') or {}).items()))
            lines.append(f"View: {sidecar.get('view', 'score_sidecar')}  ({sidecar.get('n_scores', 0)} scores"
                         + (f"; {by_source}" if by_source else '') + ")")
            for col in sidecar.get('columns', []):
                lines.append(f"  {col['name']}  [{col['type']}]")
            if sidecar.get('note'):
                lines.append(f"  {sidecar['note']}")
            for example in sidecar.get('example_sql') or []:
                lines.append(f"  Example: {example}")
            lines.append("  list_module_scores(db_id) lists every score with its own query.")
        return '\n'.join(lines)

    @mcp.tool()
    async def analytics_query(
        db_id: str, sql: str,
        timeout: Optional[int] = None,
        attach_sessions: Optional[list[str]] = None,
    ) -> str:
        """Execute a read-only SQL query against a dataset and save results server-side.

        IMPORTANT: do ALL filtering, grouping, aggregation, pivoting, and
        transformation here in SQL — DuckDB is orders of magnitude faster than
        pandas for these operations on large single-cell datasets.  The Python
        analytics_viz step should contain only plotting code that operates on the
        already-aggregated result.

        Only SELECT / WITH … SELECT queries are permitted.  Results are stored as
        a Parquet file on the server — no bulk data travels over MCP.  Use the
        returned session_id in analytics_viz to visualise the result.

        Returns column names, dtypes, total row count, and a 10-row preview.

        DuckDB supports window functions, PIVOT, LIST_AGG, MEDIAN, QUANTILE,
        CORR, and full standard SQL.  Prefer complex SQL over complex Python.

        JOINING MODULE SCORES: If you previously called module_score and got a
        session_id, pass it in attach_sessions to make the scores available as a
        table called `scores` (columns: cell_name, module_score). Example:
            sql: "SELECT o.cell_type, AVG(s.module_score) FROM scores s JOIN obscat o USING (cell_name) GROUP BY 1"
            attach_sessions: ["<session_id from module_score>"]

        PRE-COMPUTED SCORES IN THE SCORES SIDECAR: most datasets keep their gene
        set scores in a sidecar file, not in obsnum. Read them from the view
        `score_sidecar` (cell_id, cell_name, source, catalog, module,
        column_name, score); always filter on source, catalog and module.
        list_module_scores gives the exact query per score, e.g.
            SELECT cell_name, score FROM score_sidecar
            WHERE source = 'geneset' AND catalog = 'Sierksma2025/WGCNA' AND module = 'Brown_Lysosome'

        Args:
            db_id:   Dataset identifier (e.g. 'S25/SGM').
            sql:     SELECT query.
            timeout: Query timeout in seconds (default 120). Increase for complex
                     multi-CTE queries on large datasets, e.g. timeout=300.
            attach_sessions: List of session IDs from prior module_score or
                     analytics_query calls. The first is available as table
                     `scores`, additional ones as `session_1`, `session_2`, etc.
        """
        body: Dict[str, Any] = {'sql': sql}
        if timeout is not None:
            body['timeout'] = timeout
        if attach_sessions:
            body['attach_sessions'] = attach_sessions
        try:
            data = await _get_post(f'/databases/{db_id}/analytics/query', body)
        except httpx.HTTPStatusError as error:
            code = error.response.status_code
            if code == 404:
                return f"Dataset '{db_id}' not found."
            if code in (400, 408):
                return f"Query error: {error.response.text}"
            raise

        session_id_val = data['session_id']
        row_count = data['row_count']
        columns = data['columns']
        dtypes = data['dtypes']
        preview_rows = data.get('preview', [])
        is_full_table = data.get('full_table', False)
        is_truncated = data.get('truncated', False)

        lines = [
            f"session_id: {session_id_val}",
            f"rows: {row_count:,}" + (" (truncated at limit)" if is_truncated else ''),
            "columns: " + ', '.join(f"{c} [{t}]" for c, t in zip(columns, dtypes)),
            '',
        ]

        if is_full_table and preview_rows:
            # Render full result as a markdown table
            col_widths = [max(len(str(c)), max((len(str(r.get(c, ''))) for r in preview_rows), default=0))
                          for c in columns]
            header = '| ' + ' | '.join(str(c).ljust(col_widths[i]) for i, c in enumerate(columns)) + ' |'
            separator = '| ' + ' | '.join('-' * col_widths[i] for i in range(len(columns))) + ' |'
            lines += [header, separator]
            for row in preview_rows:
                cells = [str(row.get(c, '')).ljust(col_widths[i]) for i, c in enumerate(columns)]
                lines.append('| ' + ' | '.join(cells) + ' |')
        else:
            lines.append('Preview (first 10 rows):')
            for row in preview_rows:
                lines.append(f"  {row}")

        lines += [
            '',
            f"Use analytics_viz(session_id='{session_id_val}', code=...) to visualise.",
        ]
        return '\n'.join(lines)

    @mcp.tool()
    async def analytics_viz(
        session_id: str,
        code: str,
        output_format: str = 'png',
    ):
        """Execute a Python visualisation script against a prior analytics_query result.

        IMPORTANT: do NOT transform or aggregate data here — that belongs in the
        analytics_query SQL step.  This script should only plot the already-small
        aggregated DataFrame that analytics_query produced.

        The script runs server-side in a sandboxed subprocess.  Two variables are
        pre-injected — use them to load data and save the figure:

            df = pd.read_parquet(DATA_PATH)   # already loaded for you
            # … build your plot …
            plt.savefig(OUTPUT_PATH, bbox_inches='tight', dpi=150)

        Available libraries: pandas, matplotlib, seaborn, numpy, scipy, sklearn.
        Blocked: os, sys, subprocess, socket, requests, and other I/O modules.

        Returns a URL to the rendered figure (same mechanism as the plot tool).

        Args:
            session_id:    ID returned by analytics_query.
            code:          Python source for the visualisation.
            output_format: 'png' (default), 'svg', or 'pdf'.
        """
        try:
            data = await _get_post('/analytics/viz', {
                'session_id': session_id,
                'code': code,
                'output_format': output_format,
            })
        except httpx.HTTPStatusError as error:
            code_status = error.response.status_code
            if code_status == 404:
                return f"Session '{session_id}' not found. Run analytics_query first."
            if code_status in (400, 408):
                return f"Visualization error: {error.response.text}"
            raise

        figure_b64 = data['figure_b64']
        fmt = data.get('output_format', output_format)
        caption = f"Analytics visualization (session {session_id})"
        return _make_plot_response(base64.b64decode(figure_b64), fmt, caption)

    @mcp.tool()
    async def list_genesets(
        organism: Optional[str] = None,
        method: Optional[str] = None,
        study: Optional[str] = None,
    ) -> str:
        """List available curated genesets in the geneset store.

        Genesets are organized as <Study>/<Experiment>/<name>. An "experiment"
        is one analysis run (e.g. WGCNA, cNMF, DGE) on a parent dataset; each
        contains one or more named genesets in .grp (unranked) or .rnk (ranked)
        format. Use get_geneset to fetch one geneset's genes for downstream
        analysis (e.g. as input to module_score).

        Args:
            organism: Filter to one organism (e.g. 'human', 'mouse').
            method:   Filter to one method (WGCNA, cNMF, DGE, GSEA, manual).
            study:    Filter to one study folder (e.g. 'Sierksma2025').
        """
        try:
            data = await _get('/genesets', organism=organism, method=method, study=study)
        except httpx.HTTPStatusError as exc:
            if exc.response.status_code == 503:
                return "Geneset store is not configured on this server."
            return f"Error {exc.response.status_code}: {exc.response.text}"

        items = data.get('genesets', [])
        if not items:
            return "No genesets found matching the filters."

        naming = data.get('column_naming', {})
        lines = [
            f"{data['count']} geneset(s):"
        ]
        if naming:
            lines.append(
                f"(score-column convention: {naming.get('template', '?')}; "
                f"separator {naming.get('separator', '?')!r})"
            )
        for geneset in items:
            description = geneset.get('description') or ''
            scored_in = geneset.get('scored_in') or []
            scored_str = (
                f"  pre-scored in: {', '.join(scored_in)}"
                if scored_in else "  pre-scored in: (none)"
            )
            lines.append(
                f"  {geneset['geneset_id']}  "
                f"[{geneset['format']}, {geneset['n_genes']} genes, "
                f"organism={geneset.get('organism', '?')}, "
                f"method={geneset.get('method', '?')}, "
                f"parent={geneset.get('parent_dataset') or '-'}]\n"
                + scored_str
                + (f"\n      {description}" if description else "")
            )
        return '\n'.join(lines)

    def _rank_phrase(rank: Optional[float], n_compared: Any) -> str:
        """'0.83, a higher mean score than 83% of 159 other gene sets' for a rank in [0, 1]."""
        if rank is None:
            return 'no rank'
        return f"{float(rank):.2f}, a higher mean score than {float(rank) * 100:.0f}% of {n_compared} other gene sets"

    async def _geneset_rank_lines(geneset_id: str, db_id: str) -> List[str]:
        """Lines for ``get_geneset`` from ``/genesets/{id}/rank?db_id=``."""
        try:
            rank = await _get(f'/genesets/{geneset_id.strip("/")}/rank', db_id=db_id)
        except httpx.HTTPStatusError as exc:
            return [f"  Rank in {db_id}: error {exc.response.status_code}: {exc.response.text[:200]}"]
        lines = [f"  Rank among gene sets in {db_id} (fraction of the other sets with a lower mean score; "
                 f"within this dataset only; at least {rank.get('min_peers')} peers and {rank.get('min_cells')} cells):"]
        for entry in rank.get('datasets') or []:
            for source, label in (('geneset', 'scanpy score_genes, primary'), ('ucell', 'UCell, secondary')):
                result = entry.get(source) or {}
                if not result.get('available') or result.get('rank') is None:
                    lines.append(f"    {label}: not available ({result.get('reason') or 'no rank'})")
                    continue
                lines.append(f"    {label}: rank {_rank_phrase(result['rank'], result.get('n_modules_compared'))} "
                             f"({result.get('n_cells')} cells; mean {_fmt_number(result.get('mean'))}, SD over cells "
                             f"{_fmt_number(result.get('std'))})")
                for group in result.get('cell_types') or []:
                    lines.append(f"      {group.get('cell_type') or 'all cells'}: rank "
                                 f"{_rank_phrase(group.get('rank'), group.get('n_modules_compared'))} ({group.get('n_cells')} cells)")
        for missing in rank.get('not_available') or []:
            lines.append(f"    {missing.get('db_id')}: not available ({missing.get('reason')})")
        return lines

    @mcp.tool()
    async def get_geneset(geneset_id: str, db_id: Optional[str] = None) -> str:
        """Fetch a single geneset by ID and return its metadata + gene list.

        The geneset_id format is '<Study>/<Experiment>/<name>', e.g.
        'Sierksma2025/WGCNA/Brown_Lysosome'. Use list_genesets to discover IDs.

        Returns merged metadata (experiment + per-geneset), the full gene list,
        and (for .rnk format) the rank values.

        With db_id (one of the datasets it is pre-scored in) it also gives the
        set's RANK AMONG GENE SETS in that dataset: the fraction of the other
        gene sets scored on the same cells with a lower mean score (0 lowest,
        1 highest), overall and per cell type group, from the scanpy score
        (primary) and UCell (secondary; depends on set size). A mean module
        score is not comparable between datasets; the rank is a within-dataset
        number only, never compare ranks across datasets. The first request
        per dataset can take up to a minute. Call explain('rank-among-gene-sets')
        and explain('module-scores') before explaining it to a user.

        Args:
            geneset_id: Full ID '<Study>/<Experiment>/<name>'.
            db_id: Optional dataset id for the rank among gene sets (e.g. 'G24/MMG').
        """
        try:
            data = await _get(f'/genesets/{geneset_id}')
        except httpx.HTTPStatusError as exc:
            if exc.response.status_code == 404:
                return f"Geneset {geneset_id!r} not found. Use list_genesets to discover available IDs."
            if exc.response.status_code == 503:
                return "Geneset store is not configured on this server."
            return f"Error {exc.response.status_code}: {exc.response.text}"

        lines = [
            f"Geneset: {data['geneset_id']}",
            f"  Display name:  {data.get('display_name', data['name'])}",
            f"  Format:        {data['format']}",
            f"  N genes:       {data['n_genes']}",
            f"  Organism:      {data.get('organism') or '-'}",
            f"  Method:        {data.get('method') or '-'}",
            f"  Parent:        {data.get('parent_dataset') or '-'}",
        ]
        if data.get('description'):
            lines.append(f"  Description:   {data['description']}")
        if data.get('direction'):
            lines.append(f"  Direction:     {data['direction']}")

        column = data.get('column_name')
        scored_in = data.get('scored_in') or []
        if column:
            lines.append(f"  Score column:  {column!r}")
        if scored_in:
            lines.append(f"  Pre-scored in: {', '.join(scored_in)}")
            lines.append(
                f"  → Use the pre-computed scores instead of recomputing with module_score: plot them by "
                f"column name, or read them with analytics_query. Where the score is kept depends on the "
                f"dataset; list_module_scores(db_id) gives the exact query. Usually the scores sidecar:")
            set_study, _, set_rest = (data.get('geneset_id') or geneset_id).partition('/')
            set_experiment, _, set_name = set_rest.partition('/')
            catalog_literal = "'" + f"{set_study}/{set_experiment}".replace("'", "''") + "'"
            module_literal = "'" + set_name.replace("'", "''") + "'"
            lines.append(
                f"      SELECT cell_name, score FROM score_sidecar WHERE source = 'geneset' "
                f"AND catalog = {catalog_literal} AND module = {module_literal}")
            lines.append(
                f"    or, in datasets that hold it as a column: SELECT cell_name, \"{column}\" FROM obsnum")
        else:
            lines.append(f"  Pre-scored in: (none — use module_score to compute on-the-fly)")

        if db_id:
            lines += await _geneset_rank_lines(geneset_id, db_id)

        genes = data.get('genes') or []
        if data['format'] == 'rnk' and data.get('ranks'):
            lines.append("\nRanked genes (gene\\trank):")
            for gene, rank in data['ranks']:
                lines.append(f"  {gene}\t{rank}")
        else:
            lines.append("\nGenes:")
            lines.append("  " + ", ".join(genes))
        return '\n'.join(lines)

    @mcp.tool()
    async def list_module_scores(db_id: str, with_ranks: bool = False) -> str:
        """List geneset module scores already computed and stored on a dataset.

        Use this BEFORE module_score to check whether a geneset is already
        pre-computed; if it is, prefer reading it via analytics_query rather
        than recomputing.

        Returns the column names, geneset references, per-score stats and,
        per score, the SQL that reads it. Scores live either in the scores
        sidecar (most datasets; read through the view score_sidecar) or as
        an obsnum column (older datasets):

            SELECT cell_name, score FROM score_sidecar
            WHERE source = 'geneset' AND catalog = 'Sierksma2025/WGCNA' AND module = 'Brown_Lysosome'

            SELECT cell_name, "Sierksma2025::WGCNA::Brown_Lysosome" FROM obsnum

        Every listed column name can also be plotted directly.

        with_ranks=true adds each set's RANK AMONG GENE SETS in this dataset
        (fraction of the other scored sets with a lower mean scanpy score, 0 to
        1, and the SD of the score over cells, not donors) and sorts by it. Use
        it for "which programmes are high in this dataset"; ranks are within
        one dataset only. The first request per dataset can take up to a
        minute. Call explain('rank-among-gene-sets') before explaining it.

        Args:
            db_id: Dataset id, e.g. 'P26/HMI'.
            with_ranks: Add the rank among gene sets (default false).
        """
        try:
            data = await _get(f'/databases/{db_id}/module_scores')
        except httpx.HTTPStatusError as exc:
            if exc.response.status_code == 404:
                return f"Dataset {db_id!r} not found."
            return f"Error {exc.response.status_code}: {exc.response.text}"
        ranks: Dict[str, dict] = {}
        rank_note = ''
        if with_ranks:
            try:
                rank_data = await _get(f'/databases/{db_id}/module-ranks')
                if rank_data.get('available'):
                    ranks = {row['column_name']: row for row in rank_data.get('modules') or []}
                else:
                    rank_note = f"Ranks not available: {rank_data.get('reason')}"
            except httpx.HTTPStatusError as exc:
                rank_note = f"Ranks: error {exc.response.status_code}: {exc.response.text[:200]}"

        items = data.get('scored_genesets', [])
        if not items:
            return (
                f"{db_id}: no pre-computed module scores. "
                + (rank_note + ' ' if rank_note else '')
                + (f"(scores sidecar unreadable: {data['sidecar_error']}) " if data.get('sidecar_error') else '')
                + "Use module_score to compute one on-the-fly."
            )

        by_storage = data.get('count_by_storage') or {}
        storage_text = ', '.join(
            f"{count} {'in the scores sidecar' if storage == 'scores_sidecar' else 'as obsnum columns'}"
            for storage, count in sorted(by_storage.items()))
        lines = [f"{db_id}: {len(items)} pre-computed module score(s)"
                 + (f" ({storage_text})" if storage_text else '') + ':']
        if rank_note:
            lines.append(rank_note)
        if ranks:
            lines.append('Sorted by rank among gene sets (scanpy score, this dataset only; highest first).')
            items = sorted(items, key=lambda item: -((ranks.get(item['column_name']) or {}).get('rank') or -1))
        for item in items:
            stats = item.get('stats') or {}
            line = (
                f"  {item['geneset_id']}\n"
                f"      column: {item['column_name']!r}"
            )
            ranked = ranks.get(item['column_name'])
            if ranked:
                line += (f"\n      rank among gene sets: {_rank_phrase(ranked.get('rank'), ranked.get('n_modules_compared'))} "
                         f"(SD over cells {_fmt_number(ranked.get('std'))})"
                         if ranked.get('available') and ranked.get('rank') is not None
                         else f"\n      rank among gene sets: not available ({ranked.get('reason')})")
            if item.get('method'):
                line += f"  method={item['method']}"
            if item.get('description'):
                line += f"\n      {item['description']}"
            if 'mean' in stats and stats.get('mean') is not None:
                line += (
                    f"\n      stats: mean={stats['mean']:.3f}, "
                    f"std={(stats.get('std') or 0):.3f}, "
                    f"range=[{(stats.get('min') or 0):.3f}, {(stats.get('max') or 0):.3f}]"
                )
            if item.get('query_sql'):
                line += f"\n      sql: {item['query_sql']}"
            if item.get('ucell_column_name'):
                line += f"\n      UCell score also stored: {item['ucell_column_name']!r}"
            if not item.get('geneset_known'):
                line += "\n      (geneset is scored here but not registered in genesetstore)"
            lines.append(line)

        lines.append("")
        lines.append("Read a score with analytics_query using its sql line (join other tables on cell_name), "
                     "or plot it by column name, e.g. plot(geom='violin', x=<cell type column>, y=<column>).")
        if by_storage.get('scores_sidecar'):
            lines.append("Sidecar scores are not obsnum columns: SELECT ... FROM obsnum does not see them; "
                         "use the view score_sidecar and filter on source, catalog and module.")
        return '\n'.join(lines)

    def _fmt_number(value, digits: int = 3) -> str:
        if value is None:
            return 'NA'
        try:
            number = float(value)
        except (TypeError, ValueError):
            return str(value)
        if number != 0 and (abs(number) < 1e-3 or abs(number) >= 1e4):
            return f'{number:.{digits - 1}e}'
        return f'{number:.{digits}g}'

    @mcp.tool()
    async def get_facet_tests(
        db_id: str,
        facet: Optional[str] = None,
        cell_type: Optional[str] = None,
        level: str = 'summary',
        q: float = 0.05,
        limit: int = 50,
    ) -> str:
        """Replicate-level facet test results for one dataset (sex, disease, APOE e4 carrier, Braak, age, App NL-G-F).

        EXPLORATORY results, precomputed per dataset. The unit of replication is
        the donor, not the cell: raw counts are summed per (donor, cell type)
        into a pseudobulk and genes are tested with limma-voom (TMM, voom,
        eBayes; model ~ facet + sex + age + PMI + batch where available, BH q
        within one dataset x cell type x facet). Module scores are averaged per
        donor (method cell_mean, sources geneset and ucell) or computed on the
        pseudobulk (method pseudobulk, source gene_list) and tested with OLS plus
        facet-label permutations, 10,000 by default; the unit's model gives the
        number (q_param from the t test, q_perm from the permutations; p_perm
        cannot go below 1/(n + 1), so with many modules q_perm has a floor; read
        q_param and p_perm together).

        Contrasts: sex = m vs f; disease = AD vs control; apoe4_carrier = e4
        carrier vs non-carrier; braak = linear trend per Braak stage; age = linear
        trend per decade (model ~ age + sex + pmi [+ batch]; the age effect
        includes disease prevalence); app_nlgf = App NL-G-F knock-in vs control
        (xenograft hosts; replicate = the animal). Each dataset
        has one facet_scope (human_postmortem,
        xenograft_human_in_mouse); a facet is only tested in the scopes the
        registry allows.
        Disease results are PROVISIONAL: what counts as control differs between
        studies. Datasets with a Braak and a CERAD score use the common
        definition (AD = Braak >= III and CERAD probable/definite; control =
        Braak <= II and CERAD none/sparse; disease_basis braak_cerad); the
        others keep the author's labels (author_dx). Gene rows also carry
        p_treat and q_treat (limma treat, H0 |log2FC| <= tau; tau_log2).
        Every unit states its analysis_level: "replicate level" (pseudobulk by
        the dataset's replicate_unit: donor, animal or sample, at least 3 per
        level; numeric facets at least 4 replicates with 3 distinct values) or
        "cell-level, descriptive only" with the reason (then nothing is tested).

        How to read the flags:
          small_sample      a level has fewer than 5 replicates (numeric facets:
                            fewer than 10): tested and counted, but power is low.
          descriptive_only  the unit was not tested (no p, q or CI); only
                            results from before 2026-10-06 use this for small cohorts.
          composition flag  the fraction of each donor's cells that falls in this
                            cell type differs with the facet (p < 0.05,
                            uncorrected); an effect may reflect a shift in cell
                            composition or state rather than expression.
          batch_confounded  facet and batch cannot be separated; batch left out.
        The same donors occur in several datasets (ROSMAP, SEA-AD, MADRC, ...),
        so agreement across datasets is not independent replication. No hit
        means "not detected with this many donors", not "no effect".

        When you report any of these results, state the model with it, as
        given in the summary for that unit: the unit of analysis (donor
        pseudobulk, at least 10 cells per donor and stratum), the stratum and
        how it was defined, the formula (e.g. expression ~ braak + sex + age_z
        + pmi_z), the method, which covariates were left out and why, donors
        per level, the multiple-testing scope, and tool, seed and run date.
        Say that the result is exploratory. Fields the run did not record
        read "not recorded"; do not fill them in.

        Definitions: call explain('facet-effects') for facets, explain('fdr')
        for q values (BH within one dataset x cell type x facet; not the
        r-value of replication across cohorts, explain('r-value')), and
        explain('facet-replicate-unit') for donor versus cell before you
        explain these results to a user.

        Args:
            db_id: Dataset id, e.g. 'G24/MMG'.
            facet: Restrict to one facet: sex, graft_sex, host_sex, disease, apoe4_carrier, braak, age or app_nlgf.
            cell_type: Restrict to one cell type stratum (as listed in the summary).
            level: 'summary' (one line per facet x cell type: donors per level,
                covariates, flags, genes at q < 0.05 split up and down, modules
                at q_param|q_perm < 0.05 and by the replication rule (q_param
                with at least 30 residual df, else q_perm) split up and down), 'genes'
                (gene rows: logFC with 95% CI, q, mean log2 CPM) or 'modules'
                (module rows: estimate with CI, std_effect, q_param, q_perm).
            q: q threshold for 'genes' and 'modules' (default 0.05; 1 returns
                every row, including descriptive-only ones). Modules pass when
                q_param or q_perm is below q.
            limit: Maximum rows for 'genes' and 'modules' (default 50, max 2000).
        """
        if level not in ('summary', 'genes', 'modules'):
            return "level must be 'summary', 'genes' or 'modules'."
        limit = max(1, min(int(limit), 2000))
        try:
            if level == 'summary':
                data = await _get(f'/databases/{db_id}/facet-tests')
            else:
                data = await _get(f'/databases/{db_id}/facet-tests/{level}', facet=facet,
                                  cell_type=cell_type, q=q, limit=limit)
        except httpx.HTTPStatusError as exc:
            if exc.response.status_code == 404:
                try:
                    detail = exc.response.json().get('detail')
                except Exception:
                    detail = exc.response.text
                return f"{db_id}: {detail or 'not found'}."
            return f"Error {exc.response.status_code}: {exc.response.text}"

        header = ('Exploratory donor-level results (unit = donor; genes: limma-voom on '
                  'pseudobulk; modules: OLS + permutations). Disease is provisional.')
        if level == 'summary':
            if data.get('status') != 'tested':
                return f"{db_id}: not tested ({data.get('reason') or 'no results'})."
            runs = data.get('runs') or {}
            lines = [header, f"{db_id}: {data.get('n_units_tested')} of {data.get('n_units')} "
                             f"facet x cell type units tested."]
            for kind in ('genes', 'modules'):
                run = runs.get(kind)
                if run:
                    lines.append(f"  {kind} run: {run.get('tool')} at {run.get('timestamp_utc')}, "
                                 f"seed {run.get('seed')}, versions {run.get('versions')}")
            if data.get('dataset_changed'):
                lines.append('  WARNING: the dataset changed since these results were computed.')
            for unit in data.get('units') or []:
                if facet and unit.get('facet') != facet:
                    continue
                if cell_type and unit.get('cell_type') != cell_type:
                    continue
                name = f"{unit.get('facet')} | {unit.get('cell_type')} ({unit.get('celltype_source')})"
                if not unit.get('tested'):
                    lines.append(f"- {name}: not tested; {unit.get('analysis_level_label') or 'cell-level, descriptive only'}"
                                 f" ({unit.get('analysis_level_reason') or unit.get('reason')})")
                    continue
                counts = unit.get('level_counts') or {}
                donors = ', '.join(f'{k}={v}' for k, v in counts.items()) or str(unit.get('n_donors'))
                flags = unit.get('flags') or {}
                flag_words = [word for word, on in (
                    ('descriptive_only', flags.get('descriptive_only')),
                    ('provisional', flags.get('provisional')),
                    (f"composition (p={_fmt_number(flags.get('composition_p'), 2)})", flags.get('composition_flag')),
                    ('batch_used', flags.get('batch_used')),
                    ('batch_confounded', flags.get('batch_confounded'))) if on]
                genes = unit.get('genes') or {}
                gene_split = (f" ({genes['n_up']} up, {genes['n_down']} down)"
                              if genes.get('n_up') is not None and genes.get('n_down') is not None else '')
                modules = '; '.join(
                    f"{m['method']}/{m['source']} {m.get('n_q05_param')}|{m.get('n_q05_perm')} of {m.get('n_modules')}"
                    + (f", {m['n_q05']} by the replication rule ({m.get('n_up')} up, {m.get('n_down')} down)"
                       if m.get('n_q05') is not None else '')
                    for m in unit.get('modules') or [])
                model = unit.get('model') or {}
                model_lines = [f"    stratum: {(model.get('stratum') or {}).get('description', 'not recorded')}"]
                for kind in ('genes', 'modules'):
                    part = model.get(kind)
                    if not part:
                        continue
                    left_out = '; '.join(f"{c['name']} {c['status']} ({c['reason']})"
                                         for c in part.get('covariates') or [] if c.get('status') != 'included')
                    model_lines.append(
                        f"    {kind} model: {part.get('formula')} | {part.get('method')} | "
                        f"multiple testing: {part.get('multiple_testing')} | {part.get('tool')}, seed "
                        f"{part.get('seed')}, run {part.get('run_date')}"
                        f"{' | not in model: ' + left_out if left_out else ''}")
                level_text = (f", analysis level {unit.get('analysis_level_label') or unit.get('analysis_level')} "
                              f"({unit.get('replicate_unit') or 'replicate unit not recorded'})")
                lines.append(
                    f"- {name}: {unit.get('contrast')}, donors {donors} (analysed {unit.get('n_donors')}){level_text}, "
                    f"covariates {', '.join(unit.get('covariates') or []) or 'none'}"
                    f"{', flags ' + ', '.join(flag_words) if flag_words else ''}; "
                    f"genes q<0.05: {genes.get('n_q05', 'NA')} of {genes.get('n_tested', 'NA')}{gene_split}"
                    f"{'; modules q_param|q_perm<0.05: ' + modules if modules else ''}")
                lines.extend(model_lines)
                control = unit.get('sex_control')
                if control:
                    lines.append(f"    sex positive control: {control.get('status')} (XIST log2FC "
                                 f"{_fmt_number(control.get('xist_logFC'))}, q {_fmt_number(control.get('xist_q'))}; "
                                 f"{control.get('n_y_up_q01')} of {control.get('n_y_tested')} Y genes up at q < 0.01)")
            lines.append("Use level='genes' or level='modules' with facet and cell_type for the rows.")
            return '\n'.join(lines)

        rows = data.get('rows') or []
        lines = [header, f"{db_id} {level}: {data.get('n_returned')} of {data.get('n_matching')} rows "
                         f"(q < {q}{', facet ' + facet if facet else ''}"
                         f"{', cell type ' + cell_type if cell_type else ''})."]
        if not rows:
            lines.append('No rows. Try q=1 to see all estimates (descriptive-only units have no q).')
            return '\n'.join(lines)
        if level == 'genes':
            lines.append('facet | cell_type | contrast | gene | logFC [95% CI] | q | ave_expr (log2 CPM) | donors')
            for row in rows:
                lines.append(
                    f"{row.get('facet')} | {row.get('cell_type')} | {row.get('contrast')} | {row.get('gene')} | "
                    f"{_fmt_number(row.get('logFC'))} [{_fmt_number(row.get('ci_low'))}, {_fmt_number(row.get('ci_high'))}] | "
                    f"{_fmt_number(row.get('q_value'))} | {_fmt_number(row.get('ave_expr'))} | {row.get('n_donors')}")
        else:
            lines.append('facet | cell_type | method/source | catalog/module | estimate [95% CI] | std_effect | q_param | q_perm')
            for row in rows:
                lines.append(
                    f"{row.get('facet')} | {row.get('cell_type')} | {row.get('method')}/{row.get('source')} | "
                    f"{row.get('catalog')}/{row.get('module')} | {_fmt_number(row.get('estimate'))} "
                    f"[{_fmt_number(row.get('ci_low'))}, {_fmt_number(row.get('ci_high'))}] | "
                    f"{_fmt_number(row.get('std_effect'))} | {_fmt_number(row.get('q_param'))} | "
                    f"{_fmt_number(row.get('q_perm'))}")
        return '\n'.join(lines)

    _FACET_TOOL_RULES = (
        'Exploratory, replicate-level results (unit = donor, animal or sample; genes: limma-voom on pseudobulk). '
        'Datasets are tested separately, and facets are tested and counted per facet SCOPE (human_postmortem, '
        'xenograft_human_in_mouse): scopes and their genes are never merged. Replication = '
        'partial-conjunction r-value < 0.05 (Benjamini and Heller 2008) on the ordinary one-sided limma p values: the '
        'effect is present in at least 2 cohorts in the same direction. Each cohort contributes ONE anchor unit per '
        'cell type group (a donor-pooled unit for multi-region cohorts such as MADRC and SEA-AD; other units are '
        'supplementary and never counted). A gene is REPLICATED when r_value < 0.05 (direction-consistent effect in at '
        'least 2 cohorts; r_cohorts names the two that carry it). The effect gate is a separate, descriptive '
        'condition: effect_gate_passed = at least 2 counted cohorts each with a log2 fold change of at least tau in '
        'the replicated direction (tau: 10 percent, log2(1.1); Braak 10 percent over three stages; age 10 percent per '
        'decade; effect_gate_cohorts). replicated_effect (r_treat < 0.05) is the second tier: replicated with at '
        'least a 10 percent change at FDR 5 percent. Units carry notes and flags (inflated lambda, sex-discordant '
        'replicates, covariates dropped, age top-coding, gene_flags: mitochondrial, ribosomal, lncRNA or clone, sex '
        'chromosome, long gene, APOE locus). Age is run twice: unadjusted (reads as pathology too) and adjusted for '
        'pathology (persists_after_pathology_adjustment). app_nlgf is stratified by timepoint and graft line, '
        'states its control (control_basis), is refused when confounded and detects large effects only; xenograft '
        'microglia are live-sorted cells, so dissociation-response genes are suspect. '
        'r_value is BH-adjusted over the genes of one scope x facet x cell type group. k = cohorts whose anchor has '
        'q_value < 0.05 in that direction (descriptive), m = cohorts tested. Cohorts with overlap_unknown never had '
        'their donor overlap checked. The disease facet only combines pathology-based definitions (disease_basis '
        'nia_reagan, braak_cerad, adnc). Cell types are counted by group (microglial cell, Microglia, MG and Mic '
        'P2RY12 are one group "microglia"); each unit keeps its raw label. Reanalyses (secondary datasets) are shown '
        'but never counted. A unit with analysis_level "cell-level, descriptive only" was not tested (too few '
        'replicates or no replicate unit). Small cohorts are tested and counted (3 replicates per level; 4 with 3 '
        'distinct values for Braak and age) and carry a small_sample flag.'
    )

    @mcp.tool()
    async def facet_effects(gene: str, facet: Optional[str] = None, cell_type: Optional[str] = None,
                            exclude_secondary: bool = True, scope: Optional[str] = None) -> str:
        """Replicate-level effect of one gene for the tested facets (sex, disease, APOE e4 carrier, Braak, age, App NL-G-F), per dataset and cell type, grouped by cohort, with a replication badge.

        EXPLORATORY. Each row is one dataset and cell type tested on its own:
        raw counts summed per donor (at least 10 cells) into a pseudobulk,
        limma-voom with covariates sex, age, PMI, batch when available; BH
        within dataset x cell type x facet. Regional files of one cohort are
        pooled per donor into one unit; there is no effect-size meta-analysis.

        Replication: partial-conjunction r-value (Benjamini and Heller 2008)
        for "present in at least 2 cohorts, same direction"; replicated =
        r_value < 0.05; the effect gate (at least 2 counted cohorts each with a
        log2 fold change of at least tau in the replicated direction: log2(1.1);
        Braak log2(1.1)/3 per stage; age log2(1.1) per decade) is a separate
        field (effect_gate_passed) and r_treat is a second tier (replicated with
        at least a 10 percent change). Each cohort
        contributes exactly one anchor unit per cell type group (donor-pooled over
        regional files where a cohort has several regions; per-region units are
        supplementary and not counted). The anchor p value is the ordinary
        one-sided limma p value of the tested direction (limma treat p_treat and
        q_treat stay as extra columns); the r_value is BH-adjusted over the genes
        of the scope x facet x cell type group. k (cohorts with q_value < 0.05,
        same direction) and m (cohorts tested) are descriptive. The legacy count
        (q_value < 0.05) is kept as
        legacy_badge. The disease facet only combines pathology-based
        definitions (disease_basis nia_reagan, braak_cerad, adnc). Cohorts with
        overlap_unknown never had their donor overlap checked. Cell types are
        counted by group (lib/celltype_groups.yaml). Secondary datasets
        (reanalyses) are listed but not counted.

        Contrasts: sex m vs f; disease AD vs control (PROVISIONAL: vocabulary
        not settled, results will change); apoe4_carrier any e4 allele vs none;
        braak linear trend per stage (not AD vs control); age linear trend per
        decade (includes disease prevalence); app_nlgf App NL-G-F knock-in vs
        control mouse or host (replicate = animal). Flags: small_sample (a level
        has fewer than 5 replicates: tested and counted, low power);
        descriptive_only (not tested: no p, q, CI); composition (cell fraction in
        the stratum differs with the facet; the effect may reflect composition).
        Scopes: human_postmortem, xenograft_human_in_mouse are
        never merged; a gene symbol is matched inside one scope only. For APOE, APOC1,
        APOC1P1, TOMM40, NECTIN2, PVRL2 the APOE-locus note applies.

        When you report a result, repeat its model line (formula, n donors,
        covariates left out), the replication badge and that it is exploratory.
        Before explaining to a user, call explain('facet-replication'),
        explain('r-value') (replication across cohorts) versus explain('fdr')
        (q value within one dataset) and explain('facet-replicate-unit').

        Args:
            gene: Gene symbol, e.g. 'PTPRG'.
            facet: sex (post-mortem), graft_sex or host_sex (xenograft: sex of the grafted cells' donor line, sex of the host mouse), disease, apoe4_carrier, braak, age or app_nlgf; omit for all.
            cell_type: Restrict to one cell type group (e.g. 'microglia') or raw label (e.g. 'Mic P2RY12').
            exclude_secondary: Do not count reanalyses (default true).
            scope: human_postmortem or xenograft_human_in_mouse. Default: human_postmortem
                (for app_nlgf: xenograft_human_in_mouse); the reply names the other scopes that have results.
        """
        facets = [facet] if facet else ['sex', 'graft_sex', 'host_sex', 'disease', 'apoe4_carrier', 'braak', 'age', 'app_nlgf']
        lines = [_FACET_TOOL_RULES]
        for name in facets:
            try:
                card = await _get(f'/facets/{name}/effects', gene=gene, cell_type=cell_type, scope=scope,
                                  exclude_secondary=str(bool(exclude_secondary)).lower())
            except httpx.HTTPStatusError as exc:
                lines.append(f"{name}: error {exc.response.status_code}: {exc.response.text[:200]}")
                continue
            info = card.get('facet') or {}
            others = [s for s in card.get('scopes') or [] if s != card.get('scope')]
            lines.append(f"\n## {gene} / {name} [{card.get('scope')}]: {info.get('contrast')}; effect = {info.get('effect_unit')}"
                         + (f" (other scopes with results: {', '.join(others)}; ask with scope=)" if others else ''))
            if not card.get('units'):
                lines.append('  not tested in any dataset of this scope (gene absent or filtered out by filterByExpr)')
                continue
            for rep in card.get('replication') or []:
                labels = ', '.join(rep.get('labels') or [])
                anchors = '; '.join(f"{a.get('cohort_label') or a.get('cohort')} -> {a['db_id']}"
                                    f"{' (pooled)' if a.get('pooled') else ''}" for a in rep.get('anchors') or [])
                donor_text = ''
                if rep.get('n_donors_sum') is not None:
                    donor_text = (f"; donors in counted units: {rep['n_donors_sum']} summed, "
                                  + (f"{rep['n_donors_distinct']} distinct" if rep.get('n_donors_distinct') is not None
                                     else 'distinct not recorded'))
                lines.append(f"  [{rep['cell_type']}] {rep['badge']}{donor_text}"
                             + (f" (labels: {labels})" if labels else ''))
                if rep.get('cohorts_label'):
                    lines.append(f"    call: {rep.get('call')}; {rep['cohorts_label']}"
                                 + ('; at least 10 percent change in 2 cohorts' if rep.get('gate') else '')
                                 + ('; passes the strict minimum-effect test' if rep.get('strict') else '')
                                 + (f"; carried by {', '.join(rep['r_cohorts'])}" if rep.get('r_cohorts') else ''))
                if rep.get('low_detection'):
                    lines.append(f"    low detection: expressed in a median {_fmt_number((rep.get('detection') or {}).get('pct_median'))} "
                                 f"percent of {rep['cell_type']} cells ({(rep.get('detection') or {}).get('n_datasets')} datasets); "
                                 'treat the effect as fragile')
                for row in rep.get('forest') or []:
                    point = row.get('anchor') or {}
                    lines.append(f"    cohort {row.get('cohort_display')}{'' if row.get('counted') else ' (not counted)'}: "
                                 f"log2FC {_fmt_number(point.get('logFC'))} [{_fmt_number(point.get('ci_low'))}, "
                                 f"{_fmt_number(point.get('ci_high'))}], {point.get('n_donors')} donors"
                                 f"{', small cohort' if point.get('small_sample') else ''}"
                                 f"{', lambda ' + _fmt_number(point.get('lambda_gc')) + ' (inflated)' if point.get('inflated') else ''}"
                                 f"{', ' + str(point.get('modality')) if point.get('modality') else ''}"
                                 f"{'; ' + str(row['n_more_units']) + ' more units' if row.get('n_more_units') else ''}")
                if anchors:
                    lines.append(f"    anchors: {anchors}")
            if card.get('gene_flags'):
                lines.append('  gene flags: ' + ', '.join(card['gene_flags']))
            for note in card.get('notes') or []:
                if note not in ('exploratory',):
                    lines.append(f'  note: {note}')
            unit_notes = sorted({n for u in card['units'] if u.get('counted') for n in u.get('notes') or []})
            for note in unit_notes:
                lines.append(f'  unit note: {note}')
            lines.append('  cohort | role | dataset | cell type | log2FC [95% CI] | q | q_treat | donors | level | flags | model')
            for unit in card['units']:
                flags = [k for k, v in (unit.get('flags') or {}).items()
                         if v is True and k not in ('n_lt5',)]
                donors = (f"{unit.get('level_test')} {unit.get('n_donors_test')}, {unit.get('level_ref')} {unit.get('n_donors_ref')}"
                          if unit.get('n_donors_test') is not None else f"{unit.get('n_donors')} donors")
                lines.append(
                    f"  {unit.get('cohort_label') or 'not in cohort table'}"
                    f"{'' if unit.get('counted') else ' (not counted: ' + str(unit.get('not_counted_reason') or '-') + ')'} | "
                    f"{unit.get('role') or '-'} | {unit['db_id']} | {unit['cell_type']} | "
                    f"{_fmt_number(unit.get('logFC'))} [{_fmt_number(unit.get('ci_low'))}, {_fmt_number(unit.get('ci_high'))}] | "
                    f"{_fmt_number(unit.get('q_value'))} | {_fmt_number(unit.get('q_treat'))} | {donors} | "
                    f"{unit.get('analysis_level') or '-'} | {', '.join(flags) or '-'} | "
                    f"{unit.get('model')}{'; left out: ' + ', '.join(unit['covariates_left_out']) if unit.get('covariates_left_out') else ''}")
        return '\n'.join(lines)

    @mcp.tool()
    async def facet_donor_values(facet: str, cell_type: str, gene: Optional[str] = None, geneset: Optional[str] = None,
                                 scope: Optional[str] = None, adjusted: bool = False,
                                 include_uncounted: bool = False, method: Optional[str] = None,
                                 source: Optional[str] = None, db_id: Optional[str] = None) -> str:
        """The values behind one facet result: one number per donor (or host animal), per counted cohort.

        Use it to check what a replicated gene or gene set really looks like (outliers, a few donors carrying the
        effect, overlap between groups) instead of trusting the estimate alone. Each line is one donor with a
        sequential label (D01, D02 ...; not a donor id), the facet value (group, Braak stage or age in years), the
        value and the number of cells. For a gene the value is log2 counts per million of the donor's summed counts
        with TMM normalised library size, the scale the limma-voom test works on. For a gene set it is the donor's
        score. Values are unadjusted unless adjusted=true (covariate part removed by ordinary least squares); the
        test also weights donors, so a trend can differ a little from the reported estimate. A plot link is given
        (an absolute URL on this site, png; svg and pdf by changing the extension; it opens for a user signed in
        to the site); share it with the user for the small-multiples figure. Give db_id to see only the units of
        one dataset (counted or not) in the exact cell type stratum. Exploratory. Call explain('donor-plots') and
        explain('per-cell-per-donor') before explaining the values to a user.

        Args:
            facet: sex, graft_sex, host_sex, disease, apoe4_carrier, braak, age or app_nlgf (also apoe4_dose, braak_threshold, age_adjusted).
            cell_type: A cell type group such as 'microglia' (as in facet_effects).
            gene: Gene symbol, e.g. 'MEIS1'. Give exactly one of gene or geneset.
            geneset: Gene set id 'Study/Experiment/name' (as in module_facet_effects).
            scope: human_postmortem or xenograft_human_in_mouse (default as facet_effects).
            adjusted: true for covariate-adjusted values.
            include_uncounted: also list units that do not carry a cohort's vote (with the reason).
            method: Gene sets only: cell_mean or pseudobulk (default: the variant the card shows).
            source: Gene sets only: geneset, ucell or gene_list (with method).
            db_id: Only the units of this dataset, e.g. 'G24/MMG' (404 when it has no unit for the cell).
        """
        params: dict = {'cell_type': cell_type, 'scope': scope, 'adjusted': str(bool(adjusted)).lower(),
                        'include_uncounted': str(bool(include_uncounted)).lower(), 'method': method, 'source': source,
                        'db_id': db_id}
        if gene:
            params['gene'] = gene
        if geneset:
            params['module'] = geneset
        try:
            data = await _get(f'/facets/{facet}/donor-values', **params)
        except httpx.HTTPStatusError as exc:
            return f'error {exc.response.status_code}: {exc.response.text[:300]}'
        subject = data['subject']
        name = subject.get('gene') or f"{subject.get('module')} ({subject.get('method')}, {subject.get('source')})"
        lines = [f"{name} / {data['facet']} [{data['scope']}] in {data['cell_type']}: one value per replicate, "
                 f"scale: {data.get('scale') or 'n/a'}; {'adjusted' if data['adjusted'] else 'unadjusted'}.",
                 data['note'] + '.', 'EXPLORATORY, descriptive. ' + data['anonymisation'] + '.']
        query = urlencode({key: value for key, value in params.items() if value is not None and key not in
                           ('include_uncounted',)})
        lines.append(f"plot: {public_api_url}/facets/{quote(data['facet'], safe='')}/donor-plot.png?{query} "
                     '(svg and pdf also)')
        for unit in data['units']:
            model = unit['model']
            header = (f"\n## {unit['cohort_display']}{'' if unit['counted'] else ' (not counted: ' + str(unit.get('not_counted_reason')) + ')'}"
                      f" | {unit['db_id']} | {unit['cell_type']} | {unit.get('n_donors') or unit.get('n_donors_test')} "
                      f"{unit['replicate_unit']}s")
            lines.append(header)
            if model.get('estimate') is not None:
                lines.append(f"  model: effect {_fmt_number(model['estimate'])} {model['unit']} "
                             f"[{_fmt_number(model.get('ci_low'))}, {_fmt_number(model.get('ci_high'))}], "
                             f"q {_fmt_number(model.get('q_value'))}; adjusts for: {', '.join(unit.get('covariates') or []) or 'nothing'}")
            if not unit['available']:
                lines.append(f"  not available: {unit['reason']}")
                continue
            lines.append('  label | ' + ('group' if unit['facet_kind'] == 'two_group' else data['x_label'] or 'facet value')
                         + ' | value | cells')
            for donor in unit['donors']:
                shown = donor.get('group') if unit['facet_kind'] == 'two_group' else _fmt_number(donor['facet_value'])
                lines.append(f"  {donor['label']} | {shown} | {_fmt_number(donor['value'])} | {donor['n_cells']}")
        return '\n'.join(lines)

    async def _dataset_donor_variability(db_id: str, *, gene: Optional[str], geneset: Optional[str], cell_type: str,
                                         rung: str, feature_type: str, n: int) -> str:
        """donor_variability for one dataset: ``/databases/{db_id}/donor-variability`` summary plus rows."""
        try:
            summary = await _get(f'/databases/{db_id}/donor-variability')
        except httpx.HTTPStatusError as exc:
            return f'error {exc.response.status_code}: {exc.response.text[:300]}'
        lines = [f"EXPLORATORY. Donor variability in {db_id} [{summary.get('facet_scope')}]: {summary.get('status')}"
                 + (f" ({summary['reason']})" if summary.get('reason') else '')
                 + f"; replicate = {summary.get('replicate_unit') or 'not recorded'}"
                 + (f" ({summary['replicate_column']})" if summary.get('replicate_column') else '') + '.']
        run = summary.get('run') or {}
        if run:
            lines.append(f"run: {run.get('tool')} at {run.get('timestamp_utc')}, seed {run.get('seed')}, "
                         f"counts layer {run.get('counts_layer')}, {run.get('n_replicates_all')} replicates in the dataset")
        for unit in summary.get('units') or []:
            reached = ', '.join(r['name'] for r in unit.get('rungs') or [] if r.get('computed'))
            omitted = '; '.join(f"{term}: {why}" for term, why in (unit.get('terms_omitted') or {}).items())
            lines.append(f"unit {unit.get('cell_type')} [{unit.get('celltype_group')}]: {unit.get('status')}, "
                         f"{unit.get('n_replicates')} replicates, median {_fmt_number(unit.get('median_cells_per_replicate'))} "
                         f"cells each, rungs {reached or 'none'} (deepest {unit.get('rung_deepest')}), "
                         f"{unit.get('n_genes')} genes, {unit.get('n_modules')} gene sets, median reliability "
                         f"{_fmt_number(unit.get('median_reliability'), 2)}"
                         + ('' if unit.get('counted_in_cross_cohort') else ', not counted across cohorts')
                         + (f"; left out of the design: {omitted}" if omitted else ''))
        if summary.get('status') != 'analysed':
            return '\n'.join(lines)
        kind = 'module' if (geneset or (not gene and feature_type == 'module')) else 'gene'
        try:
            data = await _get(f'/databases/{db_id}/donor-variability', feature_type=kind, cell_type=cell_type, rung=rung,
                              feature=gene or geneset, sort='excess' if kind == 'gene' else 'sd',
                              limit=max(1, min(int(n), 2000)))
        except httpx.HTTPStatusError as exc:
            lines.append(f'rows: error {exc.response.status_code}: {exc.response.text[:300]}')
            return '\n'.join(lines)
        unit = data.get('unit') or {}
        lines.append(f"\n{kind}s in {unit.get('cell_type')} ({unit.get('n_replicates')} replicates), rung {data.get('rung')}: "
                     f"{data.get('n_returned')} of {data.get('n_matching')}"
                     + (', most variable first (excess over the mean-variance trend; a rank within this unit, not a test)'
                        if kind == 'gene' and not gene else ''))
        if not data.get('rows') and (gene or geneset):
            lines.append(f"{gene or geneset} is not among the analysed {kind}s of this unit (absent from the dataset, "
                         'below the expression gate, or not scored here).')
        for row in data.get('rows') or []:
            at_rung = (row.get('rungs') or {}).get(data.get('rung')) or {}
            name = row.get('gene') or f"{row.get('module')} ({row.get('method')}/{row.get('source')})"
            line = (f"{name} | reliability {_fmt_number(row.get('reliability'), 2)} | donor SD {_fmt_number(row.get('sd_donor'))} "
                    f"log2 (x{_fmt_number(row.get('fold_range_donor'), 2)} at 2 SD) | at {data.get('rung')}: SD "
                    f"{_fmt_number(at_rung.get('sd'))}, design explains {_fmt_number(at_rung.get('share_design'), 2)}")
            if kind == 'gene':
                line += f", excess z {_fmt_number(at_rung.get('excess_z'), 2)}"
            lines.append(line)
        return '\n'.join(lines)

    @mcp.tool()
    async def donor_variability(gene: Optional[str] = None, geneset: Optional[str] = None,
                                cell_type: str = 'microglia', scope: Optional[str] = None, rung: str = 'D1',
                                feature_type: str = 'gene', n: int = 30, min_cohorts: int = 2,
                                exclude_secondary: bool = True, db_id: Optional[str] = None) -> str:
        """How much donors (animals in xenograft studies) differ from each other in one cell type, per gene or gene set.

        EXPLORATORY. Call explain('donor-variability') before interpreting. Replicate differences are measured on
        halves of each replicate's cells, so cell sampling noise is removed; but technical differences between
        replicates (depth, ambient RNA, RNA quality) are part of them until a rung from D0 on removes them. Rungs:
        raw (nothing removed), D0 technical block, D1 + sex, age, PMI, batch, D2 + disease, D3 + APOE e4, D4 + Braak,
        F + latent factors. A gene that stays variable at D1 or deeper in several cohorts is a candidate for
        genetic or donor-specific state (a deletion, an HLA or 17q21.31 haplotype, an eQTL), not proof of one.
        Rankings compare genes inside a cohort; they are not hypothesis tests.

        Give gene or geneset for one feature in every analysed unit; give neither for the cross-cohort top list.
        Give db_id for ONE dataset: its analysed units (replicates, rungs reached, run record) and its most
        variable genes (by the excess over the mean-variance trend) or gene sets (by donor SD) in one cell type,
        or, with gene or geneset, that feature's full row in this dataset.

        Args:
            gene: Gene symbol, e.g. 'GSTM1'.
            geneset: Gene set id 'Study/Experiment/name' (as in module_facet_effects).
            db_id: One dataset, e.g. 'G24/MMG' (see above).
            cell_type: Cell type group such as 'microglia' (restricts one feature; selects the group of the top list).
            scope: human_postmortem (default) or xenograft_human_in_mouse (variability between host animals).
            rung: raw, D0, D1 (default), D2, D3, D4 or F.
            feature_type: gene or module, for the top list.
            n: Rows of the top list.
            min_cohorts: Top list: results needed in at least this many cohorts (default 2).
            exclude_secondary: Do not count reanalyses (default true).
        """
        if db_id:
            return await _dataset_donor_variability(db_id, gene=gene, geneset=geneset, cell_type=cell_type,
                                                    rung=rung, feature_type=feature_type, n=n)
        params = {'scope': scope, 'rung': rung, 'exclude_secondary': str(bool(exclude_secondary)).lower()}
        try:
            if gene:
                data = await _get(f'/genes/{gene}/donor-variability', cell_type=cell_type, **params)
            elif geneset:
                data = await _get(f'/genesets/{geneset}/donor-variability', cell_type=cell_type, **params)
            else:
                data = await _get('/donor-variability/top', cell_type=cell_type, feature_type=feature_type,
                                  limit=max(1, int(n)), min_cohorts=max(1, int(min_cohorts)), **params)
        except httpx.HTTPStatusError as exc:
            return f'error {exc.response.status_code}: {exc.response.text[:300]}'
        if 'rows' in data:
            lines = [f"EXPLORATORY. {data['feature_type']}s varying between replicates, {data['celltype_group']} [{data['scope']}], "
                     f"rung {data['rung']}: {data['rung_label']}. {data['m_cohorts']} counted cohorts "
                     f"(at least {data['min_replicates_per_cohort']} replicates).", data['note']]
            if data['not_enough_cohorts']:
                lines.append('Fewer cohorts than min_cohorts reach this rung: no list.')
            concordance = data.get('concordance') or {}
            if concordance.get('mean_spearman') is not None:
                lines.append(f"Reproducibility: mean Spearman correlation of the excess between cohorts {_fmt_number(concordance['mean_spearman'], 2)} "
                             f"({concordance['n_pairs']} cohort pairs); 0 means no reproducibility.")
            for cohort in data['cohorts']:
                lines.append(f"  cohort {cohort['cohort']} | {cohort['db_id']} | {cohort['cell_type']} | "
                             f"{cohort['n_replicates']} {cohort['replicate_unit']}s | deepest rung {cohort['rung_deepest']}")
            for row in data['rows']:
                if data['feature_type'] == 'gene':
                    lines.append(f"{row['gene']} | in top 5% in {row['k']}/{row['m']} cohorts | r {_fmt_number(row.get('r_value'))} | "
                                 f"median excess z {_fmt_number(row.get('median_excess_z'), 2)} | SD {_fmt_number(row.get('median_sd'))} log2 "
                                 f"(x{_fmt_number(row.get('fold_range'), 2)} at 2 SD) | reliability {_fmt_number(row.get('median_reliability'), 2)}")
                else:
                    lines.append(f"{row['module']} | {row['method']}/{row['source']} | reliable in {row['k']}/{row['m']} cohorts | "
                                 f"SD {_fmt_number(row.get('median_sd'))} | reliability {_fmt_number(row.get('median_reliability'), 2)} | "
                                 f"share explained by design {_fmt_number(row.get('median_share_design'), 2)}")
            return '\n'.join(lines)
        lines = [f"EXPLORATORY. {data['feature']} [{data['scope']}], rung {data['rung']}: {data['rung_label']}."]
        for entry in data['by_group']:
            line = f"group {entry['celltype_group']}: {entry['m']} counted cohorts at this rung"
            if entry.get('r_value') is not None:
                line += f"; in top 5% in {entry['k']}/{entry['m_with_gene']}; r {_fmt_number(entry['r_value'])} (relative, exploratory)"
            lines.append(line)
        for unit in data['units']:
            values = unit['values']
            rung_values = (values['rungs'].get(data['rung']) or {})
            lines.append(
                f"{unit['cohort_label'] or 'unassigned'} | {unit['db_id']} | {unit['cell_type']} | {unit['n_replicates']} {unit['replicate_unit']}s"
                f"{'' if unit['counted'] else ' | not counted: ' + str(unit['not_counted_reason'])}"
                f" | reliability {_fmt_number(values.get('reliability'), 2)} | donor SD {_fmt_number(values.get('sd_donor'))} log2 "
                f"(x{_fmt_number(values.get('fold_range_donor'), 2)} at 2 SD) | at {data['rung']}: SD {_fmt_number(rung_values.get('sd'))}, "
                f"design explains {_fmt_number(rung_values.get('share_design'), 2)}, excess z {_fmt_number(rung_values.get('excess_z'), 2)}")
        return '\n'.join(lines)

    def _donor_phrase(donors: Optional[dict]) -> str:
        """', N donors (M distinct)' from n_donors_sum / n_donors_distinct, or ''."""
        if not donors or donors.get('n_donors_sum') is None:
            return ''
        distinct = donors.get('n_donors_distinct')
        return (f", {donors['n_donors_sum']} donors summed over counted units ("
                + (f"{distinct} distinct persons" if distinct is not None else 'distinct count not recorded') + ')')

    @mcp.tool()
    async def facet_top_genes(facet: str, cell_type: Optional[str] = None, n: int = 30,
                              exclude_secondary: bool = True, scope: Optional[str] = None,
                              offset: int = 0, effect_gate: bool = False, strict: bool = False) -> str:
        """Genes that change with a facet in the most independent cohorts, within one cell type group.

        Lists the genes with a partial-conjunction r-value below 0.05 (the
        effect is present in at least 2 cohorts in the same direction; the effect
        gate and the r_treat tier are shown, not filtered on), ranked by r_value, then k (cohorts with
        q_value < 0.05 in that direction), then agreement (fraction of the tested
        cohorts whose effect has that sign) and the median absolute log2 fold
        change. Same replication definition as facet_effects (one anchor unit per
        cohort and cell type group, ordinary one-sided limma p values, BH over the
        genes of the scope and group; cell types counted by group; reanalyses not
        counted). The reply states how many genes replicate (n_replicated) of how
        many were testable in at least two cohorts. EXPLORATORY, disease only
        combines pathology-based definitions, Braak is a linear trend per stage,
        age per decade, app_nlgf is App NL-G-F vs control (mouse, xenograft hosts).
        Use facet_effects on a gene from this list to see every dataset row
        and its model; facet_overview gives every cell type group in one call.
        Call explain('facet-replication'), explain('r-value') and
        explain('k-of-m') before explaining the list to a user.

        Args:
            facet: sex, disease, apoe4_carrier, braak, age or app_nlgf.
            cell_type: Cell type group (e.g. 'microglia') or raw label; omit for the group with most cohorts (the reply lists the options).
            n: Rows (default 30; no cap, page with offset).
            exclude_secondary: Do not count reanalyses (default true).
            scope: human_postmortem or xenograft_human_in_mouse. Default: human_postmortem
                (app_nlgf: xenograft_human_in_mouse). Scopes are never merged.
            offset: Ranked rows to skip (paging).
            effect_gate: Only genes with a change of at least 10 percent in 2 cohorts (Braak: over three stages, age: per decade).
            strict: Only genes that also pass the strict minimum-effect test.
        """
        try:
            data = await _get(f'/facets/{facet}/effects/top', cell_type=cell_type, n=max(1, int(n)), offset=max(0, int(offset)),
                              effect_gate=str(bool(effect_gate)).lower(), strict=str(bool(strict)).lower(),
                              scope=scope, exclude_secondary=str(bool(exclude_secondary)).lower())
        except httpx.HTTPStatusError as exc:
            return f"Error {exc.response.status_code}: {exc.response.text[:300]}"
        lines = [_FACET_TOOL_RULES,
                 f"{facet} [{data.get('scope')}] in {data.get('cell_type')}: {data.get('cohorts_in_cell_type')} counted cohorts tested"
                 + _donor_phrase(data.get('donors_in_cell_type')) + '.',
                 'Other cell types: ' + ', '.join(f"{o['cell_type']} ({o['n_cohorts']} cohorts)"
                                                  for o in (data.get('cell_types') or [])[:12])]
        rows = data.get('rows') or []
        if not rows:
            lines.append('No gene replicated (r < 0.05 and the effect gate) in this scope and cell type.'
                         + (f" Other scopes with results: {', '.join(s for s in data.get('scopes') or [] if s != data.get('scope'))}."
                            if len(data.get('scopes') or []) > 1 else ''))
            return '\n'.join(lines)
        if data.get('labels'):
            lines.append('Raw labels in this group: ' + ', '.join(data['labels']))
        lines.append(f"{data.get('n_replicated')} genes replicate (r < 0.05; {data.get('n_effect_gate')} also have an effect of "
                     f"at least 10 percent in 2 cohorts, {data.get('n_replicated_effect')} replicate with at least 10 percent "
                     f"by r_treat) of {data.get('n_genes_in_family')} testable in at least two cohorts.")
        headline = data.get('headline') or {}
        if headline.get('strict_genes'):
            lines.append(f"{headline.get('n_strict')} pass the strict minimum-effect test: {', '.join(headline['strict_genes'])}"
                         + (' and more' if (headline.get('n_strict') or 0) > len(headline['strict_genes']) else '') + '.')
        lines.append(f"Showing {data.get('n_returned')} of {data.get('n_matching')} matching genes from offset {data.get('offset')}"
                     + ('; more follow (raise offset).' if data.get('has_more') else '.'))
        lines.append('gene | r_value | k of m cohorts | agreement | direction | carried by | effect gate | flags')
        for row in rows:
            lines.append(f"{row['gene']} | {_fmt_number(row.get('r_value'))} | {row['k']} of {row['m']} | "
                         f"{_fmt_number(row.get('agreement'))} | "
                         f"{row['direction']}{' (sign discordant)' if row.get('sign_discordant') else ''} | "
                         f"{', '.join(row.get('r_cohorts') or [])} | "
                         f"{'passed' if row.get('effect_gate_passed') else 'below 10% in fewer than 2 cohorts'}"
                         f"{' + r_treat ' + _fmt_number(row.get('r_treat')) if row.get('replicated_effect') else ''} | "
                         f"{', '.join(row.get('cohorts') or [])}"
                         f"{' | overlap unknown: ' + ', '.join(row['cohorts_overlap_unknown']) if row.get('overlap_unknown') else ''}"
                         f"{' | small cohorts: ' + ', '.join(row['small_cohorts']) if row.get('small_cohorts') else ''}"
                         f"{' | low detection (' + _fmt_number((row.get('detection') or {}).get('pct_median')) + ' percent of cells)' if row.get('low_detection') else ''}"
                         f"{' | flags: ' + ', '.join(row['gene_flags']) if row.get('gene_flags') else ''}")
        return '\n'.join(lines)

    @mcp.tool()
    async def facet_overview(facet: str, n: int = 10, scope: Optional[str] = None,
                             exclude_secondary: bool = True) -> str:
        """One-call overview of a facet: per cell type group, how many genes replicate across cohorts and the strongest of them.

        EXPLORATORY. Start here for "what changes with Braak (or sex, age, disease, APOE e4, App NL-G-F)?". The
        reply gives the headline cell type group (counted cohorts, genes testable in at least two cohorts,
        replicated genes, how many also pass the 10 percent effect gate and the strict minimum-effect test), then
        each cell type group with its top genes (r-value, direction, median log2 fold change, k of m cohorts,
        low detection), and the quiet groups where nothing replicates (with a low power flag when too few cohorts
        or donors could show an effect). A gene replicated in several groups is listed once, in the group where it
        is strongest (also_in names the others). Same replication rules as facet_top_genes; use facet_top_genes
        for the full ranked list of one group and facet_effects for one gene's cohorts and models.

        Before explaining the numbers to a user, call explain('facet-overview'), explain('facet-replication')
        and explain('r-value') (r-value: partial-conjunction replication across cohorts, BH-adjusted; not the
        q value of one dataset), and explain('k-of-m').

        Args:
            facet: sex, graft_sex, host_sex, disease, apoe4_carrier, braak, age or app_nlgf.
            n: Top genes per cell type group (default 10).
            scope: human_postmortem or xenograft_human_in_mouse. Default: human_postmortem
                (app_nlgf: xenograft_human_in_mouse). Scopes are never merged.
            exclude_secondary: Do not count reanalyses (default true).
        """
        try:
            data = await _get(f'/facets/{facet}/effects/overview', n=max(1, int(n)), scope=scope,
                              exclude_secondary=str(bool(exclude_secondary)).lower())
        except httpx.HTTPStatusError as exc:
            return f"Error {exc.response.status_code}: {exc.response.text[:300]}"
        headline = data.get('headline') or {}
        others = [s for s in data.get('scopes') or [] if s != data.get('scope')]
        lines = [_FACET_TOOL_RULES,
                 f"\n# {data.get('facet')} [{data.get('scope')}]"
                 + (f" (other scopes with results: {', '.join(others)}; ask with scope=)" if others else ''),
                 f"Headline {headline.get('celltype_group')}: {headline.get('cohorts')} counted cohorts; "
                 f"{headline.get('n_replicated')} of {headline.get('n_genes_in_family')} testable genes replicate (r < 0.05), "
                 f"{headline.get('n_effect_gate')} with a change of at least {headline.get('effect_gate_unit') or '10%'} "
                 f"in 2 cohorts, {headline.get('n_strict')} strict"
                 + (f": {', '.join(headline['strict_genes'])}" if headline.get('strict_genes') else '') + '.']
        for group in data.get('cell_types') or []:
            lines.append(f"\n## {group['celltype_group']}: {group.get('n_cohorts')} cohorts, {group.get('n_replicated')} of "
                         f"{group.get('n_genes_in_family')} genes replicate ({group.get('n_effect_gate')} effect gate, "
                         f"{group.get('n_strict')} strict; {group.get('n_assigned')} of them are strongest in this group)")
            lines.append('gene | r_value | direction | median log2FC | k of m | effect gate | notes')
            for gene in group.get('genes') or []:
                notes = []
                if gene.get('strict'):
                    notes.append('strict')
                if gene.get('also_in'):
                    notes.append('also in ' + ', '.join(gene['also_in']))
                if gene.get('low_detection'):
                    notes.append(f"low detection ({_fmt_number((gene.get('detection') or {}).get('pct_median'))} percent of cells)")
                if gene.get('gene_flags'):
                    notes.append('flags: ' + ', '.join(gene['gene_flags']))
                lines.append(f"{gene['gene']} | {_fmt_number(gene.get('r_value'))} | {gene.get('direction')} | "
                             f"{_fmt_number(gene.get('median_logFC'))} | {gene.get('k')} of {gene.get('m')} | "
                             f"{'passed' if gene.get('effect_gate_passed') else 'no'} | {'; '.join(notes) or '-'}")
        quiet = data.get('quiet_groups') or []
        if quiet:
            lines.append('\nNo replicated gene in: ' + '; '.join(
                f"{group['celltype_group']} ({group.get('n_cohorts')} cohorts, {group.get('n_genes_in_family')} genes"
                + (', LOW POWER: absence of evidence, not evidence of absence' if group.get('low_power') else '') + ')'
                for group in quiet))
        return '\n'.join(lines)

    _MODULE_TOOL_RULES = (
        'EXPLORATORY. A module is a gene set; its score per donor is tested the same way as a gene, per dataset and cell '
        'type, then combined across cohorts: one anchor unit per cohort and cell type group, permutation p values of the '
        'donor-level module score, partial-conjunction r-value (Simes, at least 2 cohorts, same direction), '
        'Benjamini-Hochberg over the modules of one scope, facet, cell type group and method. replicated = r_value < 0.05. '
        'The effect filter is separate: a standardised effect of at least 0.2 in 2 cohorts. Modules have no strict tier. '
        'Two variants exist: pseudobulk of raw counts (B, shown where the dataset has counts) and the mean of per-cell '
        'scores (A); the reply says which one it shows and flags when A and B point in opposite directions. Mean scores '
        'of GWAS-like sets are not meaningful: read the member-gene counts. Sets dominated by mitochondrial or ribosomal '
        'genes track cell quality (quality sensitive). Scopes are never merged.'
    )

    @mcp.tool()
    async def module_facet_effects(geneset: str, facet: Optional[str] = None, cell_type: Optional[str] = None,
                                   scope: Optional[str] = None, exclude_secondary: bool = True) -> str:
        """Effect of one gene set (module) for the tested facets, across cohorts, next to how many of its member genes replicate.

        EXPLORATORY. Use it to ask "does the DAM program rise with Braak stage in microglia, and which of its genes do it?".
        For each facet and scope the reply gives, per cell type group, the module call (replicated or not, cohorts
        k of m, the cohorts that carry it, the effect filter), the variant shown (pseudobulk or cell mean) and
        whether the two variants disagree, then the member genes that replicate for the same facet (plain counts and names,
        never truncated, with the up and down split and the subset passing the 10 percent effect filter). It also says
        in which datasets the module was tested, whether the set is quality sensitive or directionless.
        Call explain('module-replication') and explain('r-value') before explaining the result to a user.

        Args:
            geneset: Gene set id 'study/experiment/name', e.g. 'Mancuso2024/Cell_states/DAM'.
            facet: sex (post-mortem), graft_sex or host_sex (xenograft: sex of the grafted cells' donor line, sex of the host mouse), disease, apoe4_carrier, braak, age or app_nlgf; omit for all.
            cell_type: Restrict to one cell type group (e.g. 'microglia').
            scope: human_postmortem or xenograft_human_in_mouse. Default: each facet's default scope.
            exclude_secondary: Do not count reanalyses (default true).
        """
        parts = geneset.strip('/').split('/')
        if len(parts) != 3:
            return "Give the gene set as 'study/experiment/name', for example 'Mancuso2024/Cell_states/DAM'."
        try:
            data = await _get(f'/genesets/{geneset.strip("/")}/facet-effects', facet=facet, cell_type=cell_type,
                              scope=scope, exclude_secondary=str(bool(exclude_secondary)).lower())
        except httpx.HTTPStatusError as exc:
            return f"Error {exc.response.status_code}: {exc.response.text[:300]}"
        lines = [_MODULE_TOOL_RULES, f"\n# {data['geneset_id']}: {data.get('n_genes')} genes, cell type scope "
                 f"{', '.join(data.get('celltypes') or []) or 'not recorded'}"]
        if data.get('directionless'):
            lines.append(f"NOTE: {data.get('directionless_note')}")
        if (data.get('quality') or {}).get('quality_sensitive'):
            lines.append('NOTE: quality sensitive: mitochondrial or ribosomal genes make up most of this set, so a change can '
                         'reflect cell quality rather than biology.')
        scored = data.get('scored_in') or []
        lines.append(f"Tested in {len(scored)} datasets: " + ', '.join(
            f"{d['db_id']} ({d.get('modality')}{', counts' if d.get('has_counts') else ', no counts'})" for d in scored[:30])
            + (' and more' if len(scored) > 30 else '') if scored else 'No facet test result for this set yet.')
        for name, card in (data.get('facets') or {}).items():
            module = card.get('module') or {}
            members = (card.get('members') or {}).get('groups') or {}
            entries = module.get('replication') or []
            if not entries and not members:
                continue
            lines.append(f"\n## {name} [{card.get('scope')}]")
            for entry in entries:
                primary = next((v for v in entry['variants'] if v['method'] == entry['primary']['method']
                                and v['source'] == entry['primary']['source']), entry['variants'][0])
                lines.append(f"  [{entry['celltype_group']}] module ({primary['label']}): {primary['call']}; "
                             f"{primary['cohorts_label']}; r {_fmt_number(primary.get('r_value'))}; direction "
                             f"{primary.get('r_direction') or '-'}; median effect {_fmt_number(primary.get('median_std_effect'))} SD"
                             + ('; effect filter passed (0.2 SD in 2 cohorts)' if primary.get('gate') else '')
                             + (f"; carried by {', '.join(primary['r_cohorts'])}" if primary.get('r_cohorts') else ''))
                if (entry.get('ab') or {}).get('disagree'):
                    lines.append(f"    A and B disagree: {entry['ab']['reason']}")
                for variant in entry['variants']:
                    if variant is not primary:
                        lines.append(f"    other variant {variant['label']}: {variant['call']}; {variant['cohorts_label']}; "
                                     f"r {_fmt_number(variant.get('r_value'))}")
            for group, found in members.items():
                if not found['n_replicated']:
                    lines.append(f"  [{group}] members: none of {found['n_tested']} tested members replicate")
                    continue
                lines.append(f"  [{group}] members: {found['n_replicated']} of {found['n_tested']} tested members replicate "
                             f"(r < 0.05; {found['n_up']} up, {found['n_down']} down; {found['n_effect_gate']} also with a "
                             f"10 percent change, {found['n_strict']} strict): up {', '.join(found['genes_up']) or '-'}; "
                             f"down {', '.join(found['genes_down']) or '-'}")
        return '\n'.join(lines)

    @mcp.tool()
    async def facet_top_modules(facet: str, cell_type: Optional[str] = None, n: int = 30, scope: Optional[str] = None,
                                offset: int = 0, effect_gate: bool = False, include_not_replicated: bool = False,
                                exclude_secondary: bool = True) -> str:
        """Gene sets (modules) whose score changes with a facet in at least 2 cohorts, within one cell type group.

        EXPLORATORY. The module counterpart of facet_top_genes: ranked by r_value, then k, agreement and the size of
        the standardised effect. Each row shows the pseudobulk-of-counts result where it exists, else the mean of
        per-cell scores, and flags A/B disagreement, quality-sensitive sets (mitochondrial or ribosomal) and
        directionless (GWAS-like) sets. Use module_facet_effects on a row for its cohorts and member genes.
        Call explain('module-replication') before explaining the list to a user.

        Args:
            facet: sex, disease, apoe4_carrier, braak, age or app_nlgf.
            cell_type: Cell type group (e.g. 'microglia'); omit for the group with most cohorts.
            n: Rows (default 30; no cap, page with offset).
            scope: human_postmortem or xenograft_human_in_mouse. Default: human_postmortem.
            offset: Ranked rows to skip.
            effect_gate: Only modules with a standardised effect of 0.2 in 2 cohorts.
            include_not_replicated: Also list modules with r_value of 0.05 or more.
            exclude_secondary: Do not count reanalyses (default true).
        """
        try:
            data = await _get(f'/facets/{facet}/modules/top', cell_type=cell_type, n=max(1, int(n)), offset=max(0, int(offset)),
                              effect_gate=str(bool(effect_gate)).lower(), scope=scope,
                              include_not_replicated=str(bool(include_not_replicated)).lower(),
                              exclude_secondary=str(bool(exclude_secondary)).lower())
        except httpx.HTTPStatusError as exc:
            return f"Error {exc.response.status_code}: {exc.response.text[:300]}"
        lines = [_MODULE_TOOL_RULES,
                 f"{facet} [{data.get('scope')}] in {data.get('cell_type')}: {data.get('cohorts_in_cell_type')} counted cohorts; "
                 f"{data.get('n_replicated')} of {data.get('n_modules_in_family')} modules replicate (r < 0.05), "
                 f"{data.get('n_effect_gate')} of them also pass the effect filter.",
                 'Other cell types: ' + ', '.join(f"{o['cell_type']} ({o['n_cohorts']} cohorts)"
                                                  for o in (data.get('cell_types') or [])[:12]),
                 f"Showing {data.get('n_returned')} of {data.get('n_matching')} matching modules from offset {data.get('offset')}"
                 + ('; more follow (raise offset).' if data.get('has_more') else '.')]
        for row in data.get('rows') or []:
            notes = [text for flag, text in (('quality_sensitive', 'quality sensitive'), ('directionless', 'directionless set'))
                     if row.get(flag)]
            if (row.get('ab') or {}).get('disagree'):
                notes.append('A and B disagree')
            lines.append(f"{row['geneset_id']} | {row['variant_label']} | r {_fmt_number(row.get('r_value'))} | "
                         f"{row['cohorts_label']} | {row.get('r_direction') or '-'} | median effect "
                         f"{_fmt_number(row.get('median_std_effect'))} SD | {'effect filter passed' if row.get('gate') else 'below 0.2 SD in fewer than 2 cohorts'}"
                         f"{' | ' + ', '.join(notes) if notes else ''}")
        return '\n'.join(lines)

    @mcp.tool()
    async def facet_units(db_id: Optional[str] = None, facet: Optional[str] = None,
                          exclude_secondary: bool = True, scope: Optional[str] = None) -> str:
        """Which dataset x cell type units were tested for the facets, with donors per level, model, flags and hits; and why the others were not tested.

        Give db_id for one dataset (all facets, with eligibility reasons and
        the sex positive control), or facet for that facet across all datasets
        (one row per tested dataset x cell type, sorted by donors, with cohort
        and role from the DRAFT cohort table). EXPLORATORY; donor-level
        pseudobulk (limma-voom for genes, OLS + permutations for modules,
        10,000 by default); disease is provisional. State the model when you report a
        unit. For gene and module rows of one unit use get_facet_tests.
        Call explain('facet-tested') and explain('facet-replicate-unit') for
        why units were or were not tested.

        Args:
            db_id: Dataset id, e.g. 'G24/MMG'.
            facet: sex, disease, apoe4_carrier, braak, age or app_nlgf (used when db_id is not given).
            exclude_secondary: Reanalyses are listed but marked not counted (default true).
            scope: human_postmortem, xenograft_human_in_mouse or all (used with facet).
        """
        if db_id:
            return await get_facet_tests(db_id, facet=facet, level='summary')
        if not facet:
            return 'Give db_id or facet.'
        try:
            data = await _get(f'/facets/{facet}/tests', top_genes=5, scope=scope,
                              exclude_secondary=str(bool(exclude_secondary)).lower())
        except httpx.HTTPStatusError as exc:
            return f"Error {exc.response.status_code}: {exc.response.text[:300]}"
        lines = [_FACET_TOOL_RULES,
                 f"{facet} [{data.get('scope')}]: {data.get('n_rows')} units in {data.get('n_datasets_tested')} datasets (no pooling)."]
        for row in data.get('rows') or []:
            counts = row.get('level_counts') or {}
            donors = ', '.join(f'{k}={v}' for k, v in counts.items())
            genes = row.get('genes') or {}
            flags = [k for k, v in (row.get('flags') or {}).items() if v is True and k != 'n_lt5']
            model = ((row.get('model') or {}).get('genes') or {}).get('formula', 'not recorded')
            top = ', '.join(g['gene'] for g in row.get('top_genes') or [])
            lines.append(f"- {row['db_id']}{' (reanalysis, not counted)' if row.get('is_secondary') else ''} | "
                         f"{row.get('cell_type')} [{row.get('celltype_group')}] | cohort {row.get('cohort_label') or 'not in table'}"
                         f" ({row.get('role') or '-'}) | donors {donors} | model {model} | genes q<0.05 "
                         f"{genes.get('n_q05', 'NA')}/{genes.get('n_tested', 'NA')} | flags {', '.join(flags) or '-'}"
                         f"{' | top ' + top if top else ''}")
        for item in data.get('not_tested') or []:
            lines.append(f"- not tested: {item['db_id']}: {item.get('reason')}")
        return '\n'.join(lines)

    @mcp.tool()
    async def donor_groups(donor_group: Optional[str] = None) -> str:
        """Donor groups: sets of datasets that hold cells of the same donor pool, with each dataset's lineage.

        Datasets in one donor group share persons (complementary splits of one
        study by cell class, region or library, or several studies of one
        cohort). Count their donors once and never treat them as independent
        replications. Each group shows its distinct donors, keyed on
        ant_donor_uid when published and on group id + ant_donor otherwise. Each dataset is a primary, a reanalysis (its cells are
        also served by the datasets it reanalyses) or unresolved.

        Args:
            donor_group: One group slug (e.g. 'gabitto2024'); omit for all.
        """
        try:
            data = await _get('/donor-groups', donor_group=donor_group)
        except httpx.HTTPStatusError as exc:
            return f"Error {exc.response.status_code}: {exc.response.text[:300]}"
        lines = [f"{data.get('n_groups')} donor group(s); {data.get('n_ungrouped')} datasets belong to none."]
        basis = None
        for group in data.get('groups') or []:
            lines.append(f"\n## {group['donor_group']}: {group['n_datasets']} datasets "
                         f"({group['n_primary']} primary, {group['n_reanalysis']} reanalysis, "
                         f"{group['n_unresolved']} unresolved); {group['n_cells']:,} cells in primaries")
            donors = group.get('donors')
            if donors:
                basis = donors.get('basis') or basis
                lines.append(f"Distinct donors: {donors['n_donors']} over {donors['n_datasets_counted']} "
                             f"dataset(s) ({donors['n_donors_uid']} by ant_donor_uid, "
                             f"{donors['n_donors_fallback']} by group id + ant_donor); "
                             f"{donors['n_donors_primary']} in non-reanalysis datasets"
                             + (f"; {donors['n_datasets_without_donor']} dataset(s) publish no donor column"
                                if donors.get('n_datasets_without_donor') else ''))
            for dataset in group.get('datasets') or []:
                lineage = dataset.get('designation') or '-'
                if dataset.get('reanalysis_of'):
                    lineage += ' of ' + ', '.join(dataset['reanalysis_of'])
                donor_text = ''
                if 'n_donors' in dataset:
                    donor_text = (' | donors: not published' if dataset['n_donors'] is None else
                                  f" | {dataset['n_donors']} donors ({dataset.get('n_donors_uid') or 0} with uid)")
                lines.append(f"  {dataset['db_id']} | {dataset.get('title')} | {lineage} | "
                             f"{dataset.get('n_cells'):,} cells{donor_text}")
        if basis:
            lines.append(f"\nCounting: {basis}.")
        return '\n'.join(lines)

    @mcp.tool()
    async def rescan_databases():
        """Force the API server to rescan its data folder and reload all datasets.

        Call this after new h5ad/duckdb files have been added or converted.
