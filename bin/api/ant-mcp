def _lineage_line(dataset: dict) -> str:
    """One line on a dataset's lineage for the tool replies."""
    designation = dataset.get('designation') or ('reanalysis' if dataset.get('is_secondary') else 'primary')
    parts = [designation]
    if dataset.get('reanalysis_of'):
        parts.append('reanalysis of ' + ', '.join(dataset['reanalysis_of']))
    if dataset.get('donor_group'):
        parts.append(f"donor group {dataset['donor_group']} (shares donors with the other datasets of the group)")
    if dataset.get('has_donor_uid'):
        parts.append('cross-dataset donor id ant_donor_uid')
    unit = dataset.get('replicate_unit')
    if unit:
        parts.append(f"replicate unit {unit}" + (f" ({dataset['replicate_column']})" if dataset.get('replicate_column')
                                                 else ' (cell-level, descriptive only: no replicates to test)')
                     + (' [inferred]' if dataset.get('replicate_basis') == 'inferred' else ''))
    if dataset.get('disease_basis'):
        parts.append(f"ant_disease basis {dataset['disease_basis']}")
    return '; '.join(parts)


def _parse_args() -> argparse.Namespace:
    cfg = _anthive_cfg  # shorthand for yaml mcp: section
    from config import get_api_url  # noqa: PLC0415
    default_api_url = get_api_url(_get_anthive_config())

    parser = argparse.ArgumentParser(
        description='Anthive MCP Server — exposes single-cell data to LLM sessions',
    )
    parser.add_argument(
        '--api-url', default=default_api_url,
        help=f'ant-serve API base URL (default: {default_api_url})',
    )
    parser.add_argument(
        '--host', default=cfg.get('host', '127.0.0.1'),
        help='Bind host for HTTP/SSE transport',
    )
    parser.add_argument(
        '--port', type=int, default=cfg.get('port', 8090),
        help='Port for HTTP/SSE transport',
    )
    parser.add_argument(
        '--transport',
        default=cfg.get('transport', 'streamable-http'),
        choices=['streamable-http', 'sse', 'stdio'],
        help='MCP transport',
    )
    parser.add_argument(
        '--plots-dir', default=cfg.get('plots_dir'),
        help='Directory to save plot PNGs for URL-based serving',
    )
    parser.add_argument(
        '--public-url', default=cfg.get('public_url', 'http://localhost:8501'),
        help='Public base URL used to construct plot image URLs',
    )
    parser.add_argument(
        '--mcp-url', default=cfg.get('mcp_url'),
        help='Public-facing MCP URL shown at startup and passed to LLM clients '
             '(e.g. https://anthive.example.org/mcp/<token>)',
    )
    return parser.parse_args()


# ── main ───────────────────────────────────────────────────────────────────────

def main() -> None:
    args = _parse_args()
    api_base_url = args.api_url.rstrip('/')
    plots_dir = Path(args.plots_dir) if args.plots_dir else None
    public_url = args.public_url.rstrip('/')
    # ant-serve as the users' browsers reach it: Caddy serves it under /api
    # (config/Caddyfile, handle_path /api/*). Links printed by tools use this.
    public_api_url = f'{public_url}/api'
    mcp_public_url = (args.mcp_url or f'http://{args.host}:{args.port}/mcp').rstrip('/')

    require_token = bool(_anthive_cfg.get('require_token', True))
