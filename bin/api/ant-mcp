# ── Image-capability detection ─────────────────────────────────────────────────
# Tools check this ContextVar to decide whether to embed images inline.
# The value is set per-request by _ImageCapabilityMiddleware.

_client_displays_images: contextvars.ContextVar[bool] = contextvars.ContextVar(
    'client_displays_images', default=False,
)


class _ImageCapabilityMiddleware:
    """ASGI middleware: reads X-Image-Output header and stores it in a ContextVar.

    Add the header  X-Image-Output: inline  in your MCP client config to receive
    images embedded directly in the response alongside the URL.
    """

    def __init__(self, app) -> None:
        self._app = app

    async def __call__(self, scope, receive, send) -> None:
        if scope['type'] == 'http':
            headers = {k.lower(): v for k, v in scope.get('headers', [])}
            raw_value = headers.get(b'x-image-output', b'').decode().lower()
            token = _client_displays_images.set(raw_value in ('true', '1', 'yes', 'inline'))
            try:
                await self._app(scope, receive, send)
            finally:
                _client_displays_images.reset(token)
        else:
            await self._app(scope, receive, send)

# ── Personal MCP links: token check + per-request identity ────────────────────
#
# /mcp/u/<token>[/...] is rewritten to /mcp[/...]; /mcp also accepts
# "Authorization: Bearer amcp_...". The token is resolved to its owner by
# ant-serve (/internal/mcp/verify, internal secret) and cached briefly. The
# identity rides in the ASGI scope, is read back per MCP message in
# AnthiveMCP, and is forwarded to ant-serve as Remote-User / Remote-Groups
# with the internal secret, so every tool call runs as that user.

ADMIN_ONLY_TOOLS = frozenset({'analytics_viz', 'rescan_databases'})

_current_identity: contextvars.ContextVar[Optional[dict]] = contextvars.ContextVar(
    'anthive_identity', default=None,
)


def _is_admin(identity: Optional[dict]) -> bool:
    return bool(identity) and 'admins' in {g.lower() for g in identity.get('groups', [])}


# Tools about adding papers: only visible to users in library_upload_groups
# (ant-serve enforces it again with a 403), and only while uploads are
# switched on (ant-serve's requirements report uploads_enabled).
UPLOAD_TOOLS = frozenset({'paper_upload_requirements', 'check_paper', 'upload_paper'})
UPLOADS_DISABLED_MESSAGE = 'Paper uploads are switched off on this site (services.paper_upload).'


def _upload_groups() -> set:
    from config import get_library_upload_settings  # noqa: PLC0415
    try:
        return set(get_library_upload_settings(_get_anthive_config())['upload_groups'])
    except Exception:  # noqa: BLE001 - unreadable config: admins only
        return {'admins'}


def _may_upload(identity: Optional[dict]) -> bool:
    if not identity:
        return False
    return bool({g.lower() for g in identity.get('groups', [])} & _upload_groups())


class _McpLinkAuthMiddleware:
    """ASGI middleware enforcing personal MCP links in front of FastMCP."""

    def __init__(self, app, *, api_base_url: str, internal_secret: str,
                 require_token: bool = True, rate_limit_per_minute: int = 120,
                 cache_seconds: float = 30.0, negative_cache_seconds: float = 5.0,
                 mcp_path: str = '/mcp', http_client: Optional[httpx.AsyncClient] = None) -> None:
        self._app = app
        self._verify_url = f"{api_base_url.rstrip('/')}/internal/mcp/verify"
        self._secret = internal_secret
        self._require_token = require_token
        self._rate_limit = max(1, int(rate_limit_per_minute))
        self._cache_seconds = float(cache_seconds)
        self._negative_cache_seconds = float(negative_cache_seconds)
        self._mcp_path = mcp_path.rstrip('/')
        self._cache: dict = {}
        self._hits: dict = collections.defaultdict(collections.deque)
        self._client = http_client or httpx.AsyncClient(timeout=httpx.Timeout(10.0))

    @staticmethod
    async def _reject(send, status: int, message: str) -> None:
        body = json.dumps({'error': 'unauthorized' if status == 401 else 'error',
                           'detail': message}).encode()
        headers = [(b'content-type', b'application/json'),
                   (b'content-length', str(len(body)).encode())]
        if status == 401:
            headers.append((b'www-authenticate', b'Bearer realm="anthive-mcp"'))
        await send({'type': 'http.response.start', 'status': status, 'headers': headers})
        await send({'type': 'http.response.body', 'body': body})

    async def _verify(self, token: str, client_ip: Optional[str]) -> Optional[dict]:
        now = time.monotonic()
        cached = self._cache.get(token)
        if cached and cached[0] > now:
            return cached[1]
        try:
            response = await self._client.post(
                self._verify_url, json={'token': token, 'client_ip': client_ip},
                headers={'X-Anthive-Internal': self._secret})
        except httpx.HTTPError:
            return None          # API unreachable: fail closed, do not cache
        identity = response.json() if response.status_code == 200 else None
        ttl = self._cache_seconds if identity else self._negative_cache_seconds
        if len(self._cache) > 10_000:
            self._cache.clear()
        self._cache[token] = (now + ttl, identity)
        return identity

    def _over_rate_limit(self, token: str) -> bool:
        now = time.monotonic()
        window = self._hits[token]
        while window and window[0] < now - 60:
            window.popleft()
        if len(window) >= self._rate_limit:
            return True
        window.append(now)
        return False

    async def __call__(self, scope, receive, send) -> None:
        if scope['type'] != 'http':
            await self._app(scope, receive, send)
            return
        path = scope.get('path', '')
        headers = {k.lower(): v for k, v in scope.get('headers', [])}
        token = None
        prefix = f"{self._mcp_path}/u/"
        if path.startswith(prefix):
            token, _, rest = path[len(prefix):].partition('/')
            new_path = self._mcp_path + (f"/{rest}" if rest else '')
            scope = dict(scope, path=new_path, raw_path=new_path.encode())
        elif path == self._mcp_path or path.startswith(self._mcp_path + '/'):
            auth = headers.get(b'authorization', b'').decode('latin-1')
            if auth.lower().startswith('bearer '):
                token = auth[7:].strip()
            elif self._require_token:
                await self._reject(send, 401,
                    'This MCP server needs your personal link. Get it in the Anthive '
                    'web UI (account menu, "MCP link") and use it as the server URL, '
                    'or send it as "Authorization: Bearer <token>".')
                return
        if token is not None:
            forwarded = headers.get(b'x-forwarded-for', b'').decode('latin-1')
            client_ip = (forwarded.split(',')[0].strip() if forwarded
                         else (scope.get('client') or ('', 0))[0])
            identity = await self._verify(token, client_ip)
            if identity is None:
                await self._reject(send, 401,
                    'Unknown, rotated, revoked or expired MCP link. Open the Anthive web '
                    'UI (account menu, "MCP link") to see your current link.')
                return
            if self._over_rate_limit(token):
                await self._reject(send, 429, 'Too many requests for this MCP link; slow down.')
                return
            state = dict(scope.get('state') or {})
            state['anthive_identity'] = identity
            scope = dict(scope, state=state)
            ctx_token = _current_identity.set(identity)
            try:
                await self._app(scope, receive, send)
            finally:
                _current_identity.reset(ctx_token)
            return
        await self._app(scope, receive, send)


class AnthiveMCP(FastMCP):
    """FastMCP that runs each tool call as the verified link owner and hides
    admin-only tools from everyone else."""

    require_identity = True
    # async (identity) -> bool, set in main(): are paper uploads switched on?
    # None means "assume yes" (tests, or a server without the probe).
    uploads_probe = None

    async def _uploads_enabled(self, identity: Optional[dict] = None) -> bool:
        if self.uploads_probe is None:
            return True
        return bool(await self.uploads_probe(identity))

    def _identity_from_request(self) -> Optional[dict]:
        try:
            request = self.get_context().request_context.request
        except (LookupError, ValueError, AttributeError):
            request = None
        if request is not None:
            identity = (getattr(request, 'scope', {}).get('state') or {}).get('anthive_identity')
            if identity:
                return identity
        return _current_identity.get()

    async def list_tools(self):
        tools = await super().list_tools()
        identity = self._identity_from_request()
        if self.require_identity and not _is_admin(identity):
            tools = [tool for tool in tools if tool.name not in ADMIN_ONLY_TOOLS]
        if (self.require_identity and not _may_upload(identity)) or not await self._uploads_enabled(identity):
            tools = [tool for tool in tools if tool.name not in UPLOAD_TOOLS]
        return tools

    async def call_tool(self, name, arguments):
        identity = self._identity_from_request()
        if self.require_identity and name in ADMIN_ONLY_TOOLS and not _is_admin(identity):
            raise PermissionError(f"The '{name}' tool is restricted to Anthive admins.")
        if self.require_identity and name in UPLOAD_TOOLS and not _may_upload(identity):
            raise PermissionError(f"The '{name}' tool needs permission to upload papers.")
        if name in UPLOAD_TOOLS and not await self._uploads_enabled(identity):
            raise PermissionError(UPLOADS_DISABLED_MESSAGE)
        ctx_token = _current_identity.set(identity)
        try:
            return await super().call_tool(name, arguments)
        finally:
            _current_identity.reset(ctx_token)


# ── plain-language help (served by ant-serve, /api/help) ────────────────────────

def format_help_index(index: Dict[str, Any]) -> str:
    """Markdown list of help topics and glossary terms from ``GET /help``."""
    lines = ['# Anthive help topics', '']
    lines += [f"- `{topic['id']}`: {topic['title']}. {topic['summary']}" for topic in index.get('topics', [])]
    terms = ', '.join(f"`{term['slug']}`" for term in index.get('glossary', []))
    lines += ['', '## Glossary terms', '', terms or '(none)']
    return '\n'.join(lines)


def format_help_topic(data: Dict[str, Any]) -> str:
    """Markdown for one topic from ``GET /help/{topic}``: title, summary, body, links."""
    parts = [f"# {data['title']}", '', data['summary'], '', data['body']]
    if data.get('related'):
        parts += ['', 'Related topics: ' + ', '.join(f'`{ident}`' for ident in data['related'])]
    if data.get('terms'):
        parts += ['Glossary terms: ' + ', '.join(f'`{slug}`' for slug in data['terms'])]
    return '\n'.join(parts)


async def explain_via_api(get: Any, query: str) -> str:
    """Answer ``explain(query)``: best matching topic or glossary term as markdown.

    Args:
        get: Coroutine ``get(path, **params) -> dict`` that calls ant-serve.
        query: Topic id, title or glossary term (fuzzy); empty lists the topics.

    Returns:
        The help text, followed by other close matches; the topic list when
        nothing matches.
    """
    query = (query or '').strip()
    if query:
        matches = (await get('/help/search', q=query)).get('matches', [])
        if matches:
            best = matches[0]
            if best['kind'] == 'term':
                data = await get(f"/help/glossary/{best['id']}")
                text = f"# {data['term']} (glossary)\n\n{data['definition']}"
            else:
                text = format_help_topic(await get(f"/help/{best['id']}"))
            others = [f"{hit['kind']} `{hit['id']}`" for hit in matches[1:]]
            if others:
                text += '\n\nOther close matches: ' + ', '.join(others)
            return text
    prefix = f"No help topic or glossary term matches '{query}'.\n\n" if query else ''
    return prefix + format_help_index(await get('/help'))


ANTHIVE_GUIDE = """# Using Anthive well

Anthive serves ~190 curated single-cell datasets (mostly human microglia) and
a library of the papers they come from. Datasets have ids like `L26/FMG`;
papers have citekeys like `lee2026plasticity`.

## Order of work

1. Find data: `search_datasets` (organism, tissue, cell type, disease, text).
2. Before analysing a dataset: `get_dataset_context(db_id)`. It gives the
   caveats, the exact obs column names (standardised `ant_*` facets such as
   `ant_disease`, `ant_braak`, `ant_donor`, `ant_sex`), the precomputed module
   scores and the source paper's methods.
3. Look and test: `plot` for figures, `analytics_schema` then
   `analytics_query` for numbers, `module_score` for gene programmes.
4. Literature: `search_literature` for passages, `get_paper` for a paper and
   the datasets it is the source of, `related_papers` for context.
5. Donor-level questions across cohorts ("what changes with Braak, sex, age,
   disease, APOE e4?"): `facet_overview(facet)` first, then
   `facet_top_genes` / `facet_top_modules` for one cell type group,
   `facet_effects` / `module_facet_effects` for one gene or gene set,
   `facet_donor_values` for the values per donor behind one result, and
   `get_facet_tests` / `facet_units` for one dataset.
6. Donor-to-donor variability: `donor_variability` (one gene or gene set
   across cohorts, the cross-cohort top list, or `db_id=` for one dataset).
7. Differential expression stored with a dataset by its authors or the lab:
   `list_de_studies`, `de_study`, `gene_de`.

## Which numbers mean what (call explain() before explaining them)

- q value (`q_value`, `q_param`, `q_perm`): Benjamini-Hochberg within one
  dataset x cell type x facet of anthive's own donor-level tests
  (`explain("fdr")`).
- r-value: replication across cohorts (partial conjunction, at least 2
  cohorts in the same direction), BH-adjusted over the genes or gene sets of
  one scope x facet x cell type group (`explain("r-value")`,
  `explain("facet-replication")`, `explain("k-of-m")`).
- padj of a stored DE study: that study's own adjusted p under the authors'
  model. Not comparable with q or r, never counted as replication
  (`explain("differential-expression")`).
- Per cell vs per donor: per-cell statistics (plots, `analytics_query`,
  cell-level DE studies such as glmm, wilcoxon or MAST) treat cells of one
  donor as independent and are descriptive; the facet tools work on one value
  per donor or animal (`explain("per-cell-per-donor")`,
  `explain("facet-replicate-unit")`).
- Rank among gene sets: where a gene set's mean score falls among all sets
  scored in the same dataset; within one dataset only
  (`explain("rank-among-gene-sets")`).
- Facets, scopes, donor variability, donor plots: `explain("facet-effects")`,
  `explain("facet-scopes")`, `explain("donor-variability")`,
  `explain("donor-plots")`.

## Rules

- Cite literature as [Author Year, p.N] with the citekey. Never present a
  literature claim as a result from our data, or the reverse.
- Per-cell statistics are pseudoreplicated. For donor-level conclusions
  aggregate per donor (`ant_donor`) first and report donors per group.
- Use exact column and gene names; confirm genes with `search_genes`
  (mouse and human symbols are different genes, never case-convert).
- Read the caveats; some datasets have known contamination, missing raw
  counts or partial metadata.
- Summaries and topics on papers marked as drafts are machine-written and
  not yet reviewed; say so if they matter.
- Share plot links with the user; every plot call returns one.

## Who sees what, and where text goes

Everyone who can sign in to this Anthive site sees the whole library; there
are no per-paper access rules. Everything these tools return, including
passages and notes from library papers, dataset descriptions and numbers, is
sent to your AI client and from there to its LLM provider. Tell the user if
that matters for what they are asking.

## Paper roles and document types

A paper's role says why it is in the library: `source` (the data in Anthive
come from it), `reanalysis`, `method`, `related`, or `background` (of
interest to the lab, not linked to any dataset; the default). The library
also holds other documents: `entrytype` plus `type` say which (for example
`report` with `type: project proposal`, `thesis` with `type: phd thesis`).
"""


