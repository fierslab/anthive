    @mcp.resource('anthive://guide', name='anthive-guide', title='How to use Anthive well',
                  mime_type='text/markdown')
    def anthive_guide() -> str:
        return ANTHIVE_GUIDE

    @mcp.resource('anthive://help', name='help-index', title='Anthive help topics',
                  mime_type='text/markdown')
    async def help_index_resource() -> str:
        return format_help_index(await _get('/help'))

    @mcp.resource('anthive://help/{topic}', name='help-topic', title='Anthive help topic',
                  mime_type='text/markdown')
    async def help_topic_resource(topic: str) -> str:
        return await explain_via_api(_get, topic)

    @mcp.resource('anthive://dataset/{group_id}/{file_id}/context', name='dataset-context',
                  title='Dataset background pack', mime_type='text/markdown')
    async def dataset_context_resource(group_id: str, file_id: str) -> str:
        data = await _get(f'/databases/{group_id}/{file_id}/context', level='full', budget_tokens=8000)
        return data.get('text') or ''

    # ── run ────────────────────────────────────────────────────────────────────

    if args.transport == 'stdio':
        mcp.run(transport='stdio')
    elif args.transport == 'streamable-http':
        starlette_app = mcp.streamable_http_app()
        asgi_app = _ImageCapabilityMiddleware(starlette_app)
        if require_token:
            asgi_app = _McpLinkAuthMiddleware(
                asgi_app,
                api_base_url=api_base_url,
                internal_secret=internal_secret,
                require_token=True,
                rate_limit_per_minute=int(_anthive_cfg.get('rate_limit_per_minute', 120)),
                cache_seconds=float(_anthive_cfg.get('verify_cache_seconds', 30)),
                negative_cache_seconds=float(_anthive_cfg.get('verify_negative_cache_seconds', 5)),
                mcp_path=mcp.settings.streamable_http_path,
            )
        else:
            print('  WARNING: mcp.require_token is false; /mcp is unauthenticated')
        uvicorn.run(
            asgi_app,
            host=args.host,
            port=args.port,
        )
    else:
        mcp.run(transport=args.transport)


if __name__ == '__main__':
    main()
