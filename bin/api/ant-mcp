    @mcp.tool()
    async def module_score(
        db_id: str,
        genes: list[str],
        layer: str = 'X',
        n_control: int = 100,
        seed: int = 42,
        subset: Optional[list[str]] = None,
    ) -> str:
        """Compute per-cell module scores (Scanpy score_genes / Seurat AddModuleScore).

        For each cell: score = mean(module genes) − mean(expression-matched control genes).
        Returns summary statistics and a session_id. Use the session_id with analytics_viz
        to plot the score distribution or overlay scores on a UMAP.

        Example module gene lists:
          DAM:          TREM2, APOE, SPP1, CD9, LPL, CST7
          Homeostatic:  P2RY12, CX3CR1, TMEM119, CSF1R
          Interferon:   IFIT1, IFIT3, ISG15, MX1, OAS1

        Requires __gene_bins (databases with a log-normalized default layer).

        Args:
            db_id:     Dataset ID (e.g. 'P26/HMI').
            genes:     List of gene names in the module.
            layer:     Expression layer (default 'X'). Should be log-normalized.
            n_control: Control genes per expression bin (default 100).
            seed:      Random seed for reproducible control selection.
            subset:    Cell subset filters (same syntax as plot tool).
        """
        try:
            data = await _get_post(f'/databases/{db_id}/module_score', {
                'genes': genes,
                'layer': layer,
                'n_control': n_control,
                'seed': seed,
                'subset': subset or [],
            })
        except httpx.HTTPStatusError as exc:
            return f"Error {exc.response.status_code}: {exc.response.text}"

        lines = [
            f"Module score for {len(data['genes_found'])} genes in {data['db_id']}",
            f"  Genes found:   {', '.join(data['genes_found'])}",
        ]
        if data['genes_missing']:
            lines.append(f"  Genes missing: {', '.join(data['genes_missing'])}")
        lines.append(f"  Control genes: {data['n_control_genes']}")
        lines.append(f"  Cells scored:  {data['n_cells']}")
        s = data['summary']
        lines.append(f"  Score summary: mean={s['mean']:.4f}, std={s['std']:.4f}, "
                      f"median={s['median']:.4f}, range=[{s['min']:.4f}, {s['max']:.4f}]")
        lines.append(f"  Session ID:    {data['session_id']}")
        lines.append("")
        lines.append("Use this session_id with analytics_viz to plot the score distribution,")
        lines.append("e.g. a histogram or overlay on UMAP embeddings.")
        return '\n'.join(lines)

    # ── differential expression stored with datasets (author or custom DE) ──────

    _de_scan_state: Dict[str, Any] = {}
    _DE_SCAN_TTL = 3600.0

    def _dataset_path(db_id: str) -> str:
        return '/databases/' + '/'.join(quote(part, safe='') for part in db_id.strip('/').split('/'))

    async def _de_studies_by_dataset() -> Dict[str, List[dict]]:
        """db_id -> stored DE studies for every dataset the caller may see; cached an hour per identity."""
        identity = _current_identity.get() or {}
        key = (identity.get('user', ''), tuple(sorted(identity.get('groups', []))))
        cached = _de_scan_state.get(key)
        if cached and time.monotonic() - cached[0] < _DE_SCAN_TTL:
            return cached[1]
        databases = (await _get('/databases')).get('databases', [])
        limiter = asyncio.Semaphore(8)

        async def studies_of(db_id: str) -> Tuple[str, List[dict]]:
            async with limiter:
                try:
                    return db_id, (await _get(_dataset_path(db_id) + '/de')).get('studies') or []
                except (httpx.HTTPError, ValueError):
                    return db_id, []
        found = {db_id: studies for db_id, studies in
                 await asyncio.gather(*(studies_of(db['id']) for db in databases if db.get('id'))) if studies}
        if len(_de_scan_state) > 64:
            _de_scan_state.clear()
        _de_scan_state[key] = (time.monotonic(), found)
        return found

    def _de_study_line(db_id: str, study: dict) -> str:
        covariates = study.get('covariates')
        return (f"{db_id} | {study.get('study_id')} | {study.get('target') or 'gene'} | method {study.get('method') or 'not recorded'} "
                f"[{de_level_note(study.get('method')).split(':')[0]}] | reference {study.get('reference_type') or '-'} | "
                f"{study.get('n_terms')} terms, {study.get('n_contrasts')} contrasts"
                + (f" | covariates {', '.join(covariates) if isinstance(covariates, list) else covariates}" if covariates else '')
                + (f" | {study['description']}" if study.get('description') else ''))

    @mcp.tool()
    async def list_de_studies(db_id: Optional[str] = None) -> str:
        """List the differential expression (DE) studies stored with a dataset, or with every dataset.

        AUTHOR OR CUSTOM DE, not anthive's own tests: each study is the authors' published analysis or one the
        lab added, with its own model, covariates and group definitions. Every study is labelled with its analysis
        level from the method: cell-level models (glmm, lmem, wilcoxon, MAST, scanpy, Seurat, ...) treat cells as
        independent replicates, so their p values are pseudoreplicated and the results are DESCRIPTIVE only;
        pseudobulk methods (DESeq2, edgeR, limma, dream on donor or sample sums) test at the replicate level. These
        results never count towards anthive's replication across cohorts; for donor-level evidence use the facet
        tools (facet_effects, facet_top_genes). Call explain('differential-expression') and
        explain('per-cell-per-donor') before interpreting, and explain('fdr') for adjusted p values.

        Next: de_study for the contrasts and their gene counts or top genes, gene_de for one gene.

        Args:
            db_id: Dataset id, e.g. 'SF9/CMR'; omit to list the studies of every dataset (one scan, cached an hour).
        """
        try:
            if db_id:
                studies_by_db = {db_id: (await _get(_dataset_path(db_id) + '/de')).get('studies') or []}
            else:
                studies_by_db = await _de_studies_by_dataset()
        except httpx.HTTPStatusError as exc:
            return f"Error {exc.response.status_code}: {exc.response.text[:300]}"
        studies_by_db = {key: value for key, value in studies_by_db.items() if value}
        if not studies_by_db:
            return (f"{db_id}: no stored DE studies." if db_id else 'No dataset has stored DE studies.')
        lines = [DE_RULES, f"{sum(len(v) for v in studies_by_db.values())} DE studies in {len(studies_by_db)} dataset(s):",
                 'dataset | study_id | target | method [analysis level] | reference | size | covariates | description']
        for key, studies in sorted(studies_by_db.items()):
            lines += [_de_study_line(key, study) for study in studies]
        return '\n'.join(lines)

    @mcp.tool()
    async def de_study(db_id: str, study_id: str, term: Optional[str] = None, contrast: Optional[str] = None,
                       padj_max: float = 0.05, n: int = 30, sort: str = 'padj', direction: str = 'both') -> str:
        """One stored DE study (author or custom DE): its contrasts with significant gene counts, or the top genes of one contrast.

        Without term and contrast: the study's method, analysis level, covariates, subset and, per term and
        contrast, the genes (or modules) tested and those with padj below padj_max split up and down by the sign of
        the effect. With term and contrast: the top rows of that contrast (log2 fold change, effect, padj, CI).

        AUTHOR OR CUSTOM DE, not anthive's donor-level facet tests, and never counted towards replication. For a
        cell-level study (glmm, lmem, wilcoxon, MAST, scanpy, Seurat, ...) the p values are pseudoreplicated: with
        thousands of cells nearly everything is significant, so the counts are not evidence; read the effect
        sizes (sort='effsize') and call the result DESCRIPTIVE. padj is the study's own adjusted p, not a q value
        or r-value of the facet tests. Call explain('differential-expression') and explain('per-cell-per-donor')
        before interpreting. The MCP has no DE plot; the dataset page (Facet tab, Other DE) has the volcano and
        MA plots of a contrast.

        Args:
            db_id: Dataset id, e.g. 'SF9/CMR'.
            study_id: From list_de_studies.
            term: Model term of one contrast (from the summary), with contrast.
            contrast: Contrast within the term, e.g. 'M_vs_F'.
            padj_max: Significance cut on padj for the counts (default 0.05). With sort effsize or estimate it
                also filters the rows of one contrast, so unstable estimates (huge intervals, padj near 1) do not
                fill the top.
            n: Rows for one contrast (default 30, max 2000).
            sort: padj (default), effsize or estimate (effect sorts rank by size; use direction to pick a side).
            direction: both (default), up or down.
        """
        study_path = _dataset_path(db_id) + '/de/' + quote(study_id, safe='')
        try:
            summary = await _get(study_path + '/summary', padj_max=padj_max)
        except httpx.HTTPStatusError as exc:
            return f"Error {exc.response.status_code}: {exc.response.text[:300]}"
        covariates = summary.get('covariates')
        lines = [DE_RULES,
                 f"\n# {db_id} / {summary.get('study_id')}: {summary.get('name') or ''}",
                 f"method {summary.get('method') or 'not recorded'}; {de_level_note(summary.get('method'))}.",
                 f"target {summary.get('target') or 'gene'}; reference {summary.get('reference_type') or '-'}; covariates "
                 f"{', '.join(covariates) if isinstance(covariates, list) else (covariates or 'not recorded')}; subset "
                 f"{json.dumps(summary.get('subset_filter')) if summary.get('subset_filter') else 'all cells'}"
                 + (f"; clusters from obs column {summary['cluster_obs_column']}" if summary.get('cluster_obs_column') else '')
                 + (f"; {summary['n_cells_total']} cells" if summary.get('n_cells_total') else '')
                 + (f"; source {summary['source']}" if summary.get('source') else '')]
        if summary.get('description'):
            lines.append(f"description: {summary['description']}")
        if summary.get('notes'):
            lines.append(f"notes: {summary['notes']}")
        if not (term and contrast):
            lines.append(f"term | contrast | tested | padj < {padj_max} (up, down) | effect type")
            for row in summary.get('contrasts') or []:
                lines.append(f"{row['term']} | {row['contrast']} | {row.get('n_genes')} | {row.get('n_sig')} "
                             f"({row.get('n_up')} up, {row.get('n_down')} down) | {row.get('efftype') or '-'}")
            lines.append('Give term and contrast for the top rows of one contrast.')
            return '\n'.join(lines)
        try:
            data = await _get(study_path + '/terms/' + quote(term, safe='') + '/contrasts/' + quote(contrast, safe=''),
                              sort=sort, direction=direction, limit=max(1, min(int(n), 2000)),
                              padj_max=padj_max if sort != 'padj' else None)
        except httpx.HTTPStatusError as exc:
            lines.append(f"Error {exc.response.status_code}: {exc.response.text[:300]}")
            return '\n'.join(lines)
        lines.append(f"\n{term} / {contrast}: top {data.get('n_rows')} rows by {sort} ({direction})"
                     + (f", padj <= {padj_max}" if sort != 'padj' else ''))
        lines.append('gene | log2FC | effect (type) | estimate [CI] | padj | p')
        for row in data.get('rows') or []:
            lines.append(f"{row.get('gene_name')} | {_fmt_number(row.get('log2fc'))} | {_fmt_number(row.get('effsize'))} "
                         f"({row.get('efftype') or '-'}) | {_fmt_number(row.get('estimate'))} [{_fmt_number(row.get('ci_low'))}, "
                         f"{_fmt_number(row.get('ci_high'))}] | {_fmt_number(row.get('padj'))} | {_fmt_number(row.get('pvalue'))}")
        return '\n'.join(lines)

    @mcp.tool()
    async def gene_de(gene: str, db_id: Optional[str] = None, padj_max: Optional[float] = None,
                      include_technical_terms: bool = False) -> str:
        """One gene in every stored DE study (author or custom DE) of one dataset, or of every dataset that has DE.

        One row per study, term and contrast: log2 fold change, effect, padj and the analysis level of the study.
        AUTHOR OR CUSTOM DE, not anthive's donor-level facet tests: each study has its own model and groups, rows
        of different studies are not on the same footing, and none of them count towards replication across
        cohorts. Rows from cell-level studies are marked DESCRIPTIVE (pseudoreplicated p values). Gene symbols
        are matched exactly (mouse and human symbols are different genes). Intercept rows are left out, and so
        are batch, interaction and per sample or line terms unless include_technical_terms is true. Call
        explain('differential-expression') and explain('per-cell-per-donor') before interpreting; for the
        donor-level evidence use facet_effects.

        Args:
            gene: Gene symbol, exactly as in the dataset (e.g. 'APOE' human, 'Apoe' mouse).
            db_id: One dataset; omit for every dataset with stored DE.
            padj_max: Only rows with padj at or below this (default: all rows).
            include_technical_terms: Also list batch, interaction and per sample or line terms.
        """
        try:
            if db_id:
                studies_by_db = {db_id: (await _get(_dataset_path(db_id) + '/de')).get('studies') or []}
            else:
                studies_by_db = await _de_studies_by_dataset()
        except httpx.HTTPStatusError as exc:
            return f"Error {exc.response.status_code}: {exc.response.text[:300]}"
        targets = [key for key, value in studies_by_db.items() if value]
        if not targets:
            return f"{db_id}: no stored DE studies." if db_id else 'No dataset has stored DE studies.'
        limiter = asyncio.Semaphore(6)

        async def rows_of(key: str) -> Tuple[str, List[dict]]:
            async with limiter:
                try:
                    return key, (await _get(_dataset_path(key) + '/de/by-gene/' + quote(gene, safe=''))).get('rows') or []
                except (httpx.HTTPError, ValueError):
                    return key, []
        results = await asyncio.gather(*(rows_of(key) for key in targets))
        lines = [DE_RULES, f"\n# {gene} in stored DE ({len(targets)} dataset(s) with DE)",
                 'dataset | study | level | term | contrast | log2FC | effect (type) | padj']
        n_rows = n_hidden = 0
        for key, rows in sorted(results):
            for row in rows:
                term_text = str(row.get('term') or '')
                if term_text == 'intercept':
                    continue
                if not include_technical_terms and DE_TECHNICAL_TERM.search(term_text):
                    n_hidden += 1
                    continue
                if padj_max is not None and (row.get('padj') is None or row['padj'] > padj_max):
                    continue
                level = de_method_level(row.get('method'))
                n_rows += 1
                lines.append(f"{key} | {row.get('study_id')} ({row.get('method') or '-'}) | "
                             f"{'cell, DESCRIPTIVE' if level == 'cell' else (level or 'not recorded')} | {term_text} | "
                             f"{row.get('contrast')} | {_fmt_number(row.get('log2fc'))} | {_fmt_number(row.get('effsize'))} "
                             f"({row.get('efftype') or '-'}) | {_fmt_number(row.get('padj'))}")
        if not n_rows:
            lines.append(f"No row for {gene}" + (f' at padj <= {padj_max}' if padj_max is not None else '')
                         + '. Check the symbol with search_genes (case and species matter).')
        if n_hidden:
            lines.append(f"{n_hidden} rows of technical terms (batch, interaction, per sample or line) left out; "
                         'include_technical_terms=true lists them.')
        return '\n'.join(lines)

    # ── literature: library search, papers, dataset background (REST 2.39) ──────

    def _passage_lines(results: list) -> list:
        lines = []
        for i, hit in enumerate(results, 1):
            pages = hit.get('page_start')
            if hit.get('page_end') and hit.get('page_end') != pages:
                pages = f"{pages}-{hit.get('page_end')}"
            lines.append(f"[{i}] {hit.get('citation')} ({hit.get('citekey')}), {hit.get('section')}, p.{pages}"
                         f"  {hit.get('title') or ''}")
            lines.append((hit.get('text') or '').strip())
            lines.append('')
        return lines

    @mcp.tool()
    async def search_literature(
        query: str,
        k: int = 6,
        section: Optional[str] = None,
        citekeys: Optional[List[str]] = None,
        year: Optional[str] = None,
        mode: str = 'hybrid',
    ) -> str:
        """Search the full text of the papers in the Anthive library.

        Returns passages with a citation (first author, year, citekey), the
        section and the page, so every claim can be cited as
        [Author Year, p.N]. Use it to answer what is known in the
        literature, then check the same question in our data with the
        dataset tools (get_paper lists the datasets a paper is the source of).
        Call it whenever you interpret a result or explain biology, not only
        when the user asks for literature.

        Queries: plain sentences work (hybrid mode also matches paraphrases);
        combine a gene symbol with a description; try two or three phrasings
        when results are thin; restrict to one paper with citekeys to read
        around a hit. The library is curated and small: no hit means "not in
        this library", not "unknown".

        The passages are sent to your AI client and its LLM provider, like
        everything else these tools return.

        Args:
            query:    a natural-language question or keywords (gene names work).
            k:        number of passages (default 6, max 20).
            section:  restrict to one or more sections, comma-separated:
                      abstract, introduction, methods, results, discussion, figure_legend.
            citekeys: only search these papers (e.g. ['lee2026plasticity']).
            year:     'YYYY' or 'YYYY..YYYY'.
            mode:     hybrid (default), keyword or semantic.
        """
        try:
            data = await _get('/search/literature', q=query, k=min(max(int(k), 1), 20), mode=mode,
                              section=section, citekey=','.join(citekeys) if citekeys else None,
                              year=year)
        except httpx.HTTPStatusError as exc:
            return f"Error {exc.response.status_code}: {exc.response.text}"
        lines = [f"Literature search: {query!r} ({data.get('mode')} mode, {len(data.get('results') or [])} passages)"]
        for warning in data.get('warnings') or []:
            lines.append(f"note: {warning}")
        lines.append('')
        lines += _passage_lines(data.get('results') or [])
        if not data.get('results'):
            lines.append('No passages found. Try other words, or drop the section/year filters.')
        lines.append('Cite passages as [Author Year, p.N]. Keep what the literature says separate '
                     'from what our datasets show.')
        return '\n'.join(lines)

    @mcp.tool()
    async def get_paper(citekey: str) -> str:
        """One paper from the library: bibliographic record, summary, curated
        topics (cell types, tissues, methods, cohorts), the datasets it is the
        source of (or otherwise linked to, with the role), linked gene sets and
        the most related papers.

        Args:
            citekey: the paper's citekey, e.g. 'lee2026plasticity' (from
                     search_literature or related_papers).
        """
        try:
            data = await _get(f'/papers/{citekey}')
        except httpx.HTTPStatusError as exc:
            return f"Error {exc.response.status_code}: {exc.response.text}"
        lines = [f"{data.get('citation')}: {data.get('title')}",
                 f"  {data.get('journal') or ''} {data.get('year') or ''}  doi:{data.get('doi') or '-'}"
                 f"  pmid:{data.get('pmid') or '-'}  citekey:{data.get('citekey')}"]
        if data.get('authors'):
            authors = data['authors']
            lines.append('  Authors: ' + '; '.join(authors[:6]) + (f' ... ({len(authors)} total)' if len(authors) > 6 else ''))
        if data.get('summary'):
            lines.append(f"  Summary: {data['summary']}")
        for label, key in (('Cell types', 'celltypes'), ('Tissues', 'tissues'), ('Diseases', 'diseases'),
                           ('Organisms', 'organisms'), ('Methods', 'methods'), ('Cohorts', 'cohorts')):
            if data.get(key):
                lines.append(f"  {label}: {', '.join(data[key])}")
        if data.get('draft_fields'):
            lines.append(f"  (machine-drafted, not yet reviewed: {', '.join(data['draft_fields'])})")
        if data.get('datasets'):
            lines.append('  Datasets:')
            lines += [f"    {d['db_id']} ({d['role']})" for d in data['datasets']]
        else:
            lines.append('  Datasets: none linked')
        if data.get('genesets'):
            lines.append('  Gene sets: ' + ', '.join(f"{g['id']} ({g['role']})" for g in data['genesets']))
        if data.get('related'):
            lines.append('  Related papers:')
            for item in data['related'][:8]:
                kinds = ', '.join(sorted({r['kind'] for r in item.get('relations', [])}))
                lines.append(f"    {item['citation']} ({item['citekey']}; {kinds}): {item.get('title')}")
        if data.get('notes'):
            lines.append('')
            lines.append(data['notes'].strip()[:2000])
        return '\n'.join(lines)

    @mcp.tool()
    async def related_papers(citekey: str, kinds: Optional[List[str]] = None, limit: int = 10) -> str:
        """Papers related to a library paper, with why: explicit links
        (same cohort, version, extends), shared cohort, cell type, tissue,
        disease, method, shared authors, and citations in either direction.

        Args:
            citekey: the paper's citekey.
            kinds:   optional subset of: explicit, cohort, celltype, tissue,
                     disease, method, author, cites, cited_by.
            limit:   at most this many papers (default 10).
        """
        try:
            data = await _get(f'/papers/{citekey}/related',
                              kind=','.join(kinds) if kinds else None, limit=min(max(int(limit), 1), 50))
        except httpx.HTTPStatusError as exc:
            return f"Error {exc.response.status_code}: {exc.response.text}"
        items = data.get('related') or []
        if not items:
            return f"No related papers found for {citekey}."
        lines = [f"Papers related to {citekey}:"]
        for item in items:
            why = '; '.join(
                f"{r['kind']}: {', '.join(r['evidence']) if isinstance(r['evidence'], list) else r['evidence']}"
                for r in item.get('relations', []))
            lines.append(f"- {item['citation']} ({item['citekey']}, score {item['score']}): {item.get('title')}")
            lines.append(f"    {why}")
        return '\n'.join(lines)

    @mcp.tool()
    async def get_dataset_context(db_id: str, level: str = 'brief', budget_tokens: int = 4000) -> str:
        """Background pack for analysing one dataset: metadata, known caveats,
        the exact obs column names (standardised ant_* facets first),
        precomputed module scores, the source paper(s) with summary and
        methods passages (how cells were isolated, QC, annotation), other
        linked papers and related literature. Load this BEFORE planning
        analyses or plots on a dataset.

        Args:
            db_id:         dataset id, e.g. 'L26/FMG'.
            level:         'brief' (default) or 'full' (more passages and related papers).
            budget_tokens: approximate size limit (default 4000).
        """
        try:
            data = await _get(f'/databases/{db_id}/context', level=level,
                              budget_tokens=min(max(int(budget_tokens), 500), 20000))
        except httpx.HTTPStatusError as exc:
            return f"Error {exc.response.status_code}: {exc.response.text}"
        text = data.get('text') or ''
        if data.get('truncated'):
            text += (f"\n\n(trimmed to ~{data.get('budget_tokens')} tokens; dropped: "
                     f"{', '.join(data.get('dropped_sections') or [])}. Ask with level='full' or a larger budget.)")
        if not data.get('index_available'):
            text += '\n\n(note: the literature index is not loaded on this server, so no paper passages.)'
        return text

    @mcp.tool()
    async def explain(topic_or_term: str = '') -> str:
        """Plain-language explanation of an anthive concept, written by the
        maintainers. Call this BEFORE explaining facets, facet effects,
        replication, replicate units, scopes, caveats, dataset versions,
        module scores, differential expression, donor groups, the paper
        library or any glossary term (pseudobulk, FDR, r-value, k of m, ...)
        to a user, and quote or closely paraphrase the result instead of
        improvising.

        Args:
            topic_or_term: topic id, title or glossary term, matched fuzzily
                           (e.g. 'facet-counting', 'replicate unit', 'r-value').
                           Empty or unknown returns the list of topics.
        """
        try:
            return await explain_via_api(_get, topic_or_term)
        except httpx.HTTPStatusError as exc:
            return f"Error {exc.response.status_code}: {exc.response.text}"

    # ── adding papers to the library (REST 2.40) ─────────────────────────────────

    async def _post_upload(metadata: Any, pdf: Optional[bytes], *, folder: Optional[str],
                           dry_run: bool, update: bool) -> Tuple[int, dict]:
        text = metadata if isinstance(metadata, str) else json.dumps(metadata)
        data = {'metadata': text, 'dry_run': str(dry_run).lower(), 'update': str(update).lower()}
        if folder:
            data['folder'] = folder
        files = {'file': ('paper.pdf', pdf, 'application/pdf')} if pdf is not None else None
        response = await _http_client.post(f"{api_base_url}/papers/upload", data=data, files=files,
                                           headers=_identity_headers(),
                                           timeout=httpx.Timeout(connect=10, read=300, write=120, pool=10))
        try:
            return response.status_code, response.json()
        except ValueError:
            return response.status_code, {'status': 'error', 'detail': response.text[:500]}

    def _upload_report(code: int, body: dict) -> str:
        status = body.get('status')
        if status == 'invalid':
            lines = ['The record is not valid yet:']
            lines += [f"- {e.get('field')}: {e.get('message')}" for e in body.get('errors', [])]
            if body.get('missing_required'):
                lines.append(f"Missing required: {', '.join(body['missing_required'])}")
            return '\n'.join(lines)
        if status == 'duplicate':
            return (f"Already in the library as {body.get('existing_citekey')} (matched on "
                    f"{body.get('matched_on')}). Use update=True to change that record.")
        if status == 'disabled':
            return body.get('message') or UPLOADS_DISABLED_MESSAGE
        if status in ('created', 'updated', 'dry_run'):
            verb = {'created': 'Added', 'updated': 'Updated', 'dry_run': 'Dry run, nothing written:'}[status]
            lines = [f"{verb} {body.get('citekey')} in papers/{body.get('folder')}/"]
            if body.get('filled_fields'):
                lines.append(f"Filled from CrossRef/OpenAlex (marked as draft): {', '.join(body['filled_fields'])}")
            if body.get('missing_recommended'):
                lines.append(f"Still recommended: {', '.join(body['missing_recommended'])}")
            lines += [f"Note: {w}" for w in body.get('warnings', [])]
            lines.append('Record:\n' + yaml.safe_dump(body.get('record') or {}, sort_keys=False,
                                                      allow_unicode=True).strip())
            return '\n'.join(lines)
        return f"Error {code}: {body.get('detail') or body}"

    @mcp.tool()
    async def paper_upload_requirements() -> str:
        """What a paper record must and should contain before it can be added
        to the Anthive paper library: required and recommended fields, their
        meaning and allowed values (document types, roles with background as
        the default, folders), whether uploads are switched on, and the PDF
        size limit. Read this before preparing a paper for upload. Anything
        you add to the library is visible to everyone who can sign in to the
        site, and its text may be sent to AI clients and their LLM providers."""
        try:
            data = await _get('/papers/upload/requirements')
        except httpx.HTTPStatusError as exc:
            return f"Error {exc.response.status_code}: {exc.response.text}"
        return json.dumps(data, indent=1)

    @mcp.tool()
    async def check_paper(metadata: Any) -> str:
        """Validate a paper record without writing anything (a dry run of
        upload_paper): reports errors, missing required and recommended
        fields, what CrossRef/OpenAlex would fill in from the DOI or PMID, a
        duplicate if the paper is already in the library, the citekey and the
        folder it would get.

        Args:
            metadata: the record as an object with BibLaTeX field names
                      (entrytype, title, author ['Last, First', ...], date,
                      doi, ...) plus anthive_* fields and optional papers_for,
                      or the full .md text with YAML front matter. Without
                      anthive_role the record gets role background (of
                      interest to the lab, not linked to a dataset); papers_for
                      only proposes dataset links and does not change it.
        """
        code, body = await _post_upload(metadata, None, folder=None, dry_run=True, update=False)
        return _upload_report(code, body)

    @mcp.tool()
    async def upload_paper(metadata: Any, pdf_base64: Optional[str] = None,
                           folder: Optional[str] = None, update: bool = False) -> str:
        """Add a paper to the Anthive paper library (record and optional PDF).
        The record is validated, missing fields are filled from CrossRef/
        OpenAlex (marked as draft), duplicates are refused unless update=True,
        and it is committed with you as the author. Run check_paper first.
        Everyone who can sign in to the site will see it, and its text may be
        sent to AI clients and their LLM providers.

        Args:
            metadata:   record object or .md text (see check_paper).
            pdf_base64: the PDF, base64-encoded (optional; size-limited).
            folder:     lab | datasets | methods | reading | proposals (default: by rule).
            update:     True to update the existing record of the same paper.
        """
        pdf = None
        if pdf_base64:
            limit_mb = int((_get_anthive_config().get('mcp') or {}).get('max_upload_mb') or 25)
            if len(pdf_base64) * 3 // 4 > limit_mb * 1024 * 1024:
                return f"The PDF is larger than the MCP upload limit of {limit_mb} MB; upload it through the API."
            try:
                pdf = base64.b64decode(pdf_base64, validate=True)
            except (ValueError, binascii.Error):
                return 'pdf_base64 is not valid base64.'
        code, body = await _post_upload(metadata, pdf, folder=folder, dry_run=False, update=update)
        return _upload_report(code, body)

    # ── prompts: ready-made starting points in MCP clients ───────────────────────

    @mcp.prompt(name='investigate_dataset', title='Investigate a dataset',
                description='Load a dataset\'s background and its source paper, then plan analyses.')
    def investigate_dataset(db_id: str) -> str:
        return (
            f"I want to investigate the Anthive dataset {db_id}.\n\n"
            f"1. Call get_dataset_context(db_id='{db_id}', level='full') and read it fully: the "
            "caveats, the obs columns and the source paper's methods matter for every later step.\n"
            "2. Summarise in a few lines what the dataset is (design, cohort, cell types, how cells "
            "were obtained) and what its source paper already reported, citing passages as "
            "[Author Year, p.N].\n"
            "3. Propose 3 to 5 concrete analyses or plots that would add to what the paper did, "
            "using the Anthive tools (plot, analytics_query, module scores). Use the exact obs "
            "column names from the context.\n"
            "4. Before running anything heavy, say what you will run and why. Then run it.\n"
            "Rules: keep 'the literature says' separate from 'our data shows'. Per-cell statistics "
            "are pseudoreplicated: for donor-level claims aggregate per donor (ant_donor) first, "
            "and say so. Flag any caveat from the context that affects a result."
        )

    @mcp.prompt(name='literature_in_our_data', title='What does the literature say, and do our data agree?',
                description='Search the library for a topic, then test the claims in Anthive datasets.')
    def literature_in_our_data(topic: str) -> str:
        return (
            f"Topic: {topic}\n\n"
            "1. Call search_literature on this topic (try two or three phrasings, and section='results' "
            "for findings). Collect the main claims, each cited as [Author Year, p.N] with its citekey.\n"
            "2. For the key papers, call get_paper to see which Anthive datasets they are the source of, "
            "and search_datasets for other datasets that can test the same claims.\n"
            "3. For each testable claim, propose the check (gene, obs column, plot or query), run it "
            "with the Anthive tools and report the result with the plot link or table.\n"
            "4. Finish with a short table: claim, source, our result, agree / disagree / not testable.\n"
            "Rules: never present a literature claim as our result or the reverse. Per-cell "
            "statistics are pseudoreplicated; aggregate per donor for donor-level conclusions and "
            "say how many donors per group. Mention datasets whose design limits the comparison."
        )

