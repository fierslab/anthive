def de_method_level(method: Any) -> str:
    """Analysis level of a stored DE study from its method name (same rule as the web UI's ``_de_method_level``).

    Returns 'donor or sample (pseudobulk)', 'cell' for a cell-level model, or '' when the name does not tell.
    """
    text = str(method or '').lower()
    if 'pseudobulk' in text or text.startswith(('deseq2', 'edger', 'limma', 'dream')):
        return 'donor or sample (pseudobulk)'
    if text in ('glmm', 'lmem', 'wilcoxon', 'mast', 't-test', 'ttest', 'logreg', 'seurat', 'scanpy'):
        return 'cell'
    return ''


def de_level_note(method: Any) -> str:
    """Plain words on how far the p values of a stored DE study can be trusted."""
    level = de_method_level(method)
    if level == 'cell':
        return ('cell level, DESCRIPTIVE: the model is fitted on cells, so the cells of one donor or animal enter as '
                'replicates and the p values are pseudoreplicated (far too small) unless the model fully accounts for '
                'the replicate; read the effects, not the significance counts')
    if level:
        return 'pseudobulk per donor or sample: p values are at the replicate level of the study design'
    return 'analysis level not recorded: check the method before quoting a p value'


# Model terms a biologist cannot use directly (batches, interactions, per line or per sample terms); the same
