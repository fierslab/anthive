#!/usr/bin/env -S uv run --quiet --script
# /// script
# dependencies = [
#   "anndata>=0.10.0",
#   "scanpy>=1.10.0",
#   "numpy>=1.24.0",
#   "pandas>=2.0.0",
#   "pyyaml>=6.0",
#   "scipy>=1.10.0",
# ]
# ///
"""
ant-score - Compute scanpy module scores from genesetstore onto h5ad files.

Pairing is explicit: you give the target h5ad (db_id) and one or more
genesets/experiments. scanpy.tl.score_genes runs per geneset and the per-cell
scores are written back as obs columns named:

    <study>::<experiment>::<geneset_name>

Writes are atomic and all-or-nothing: if any geneset fails, the original h5ad
is left untouched.

Usage:
  ant score <db_id> <experiment_or_geneset_id> [<id>...]

Examples:
  # Score all 13 WGCNA modules onto S25/PhM
  ant score S25/PhM Sierksma2025/WGCNA

  # Score one module
  ant score S25/PhM Sierksma2025/WGCNA/Brown_Lysosome

  # Multiple experiments in one atomic write
  ant score S25/PhM Sierksma2025/WGCNA Mancuso2024/cNMF

  # Cross-apply Sierksma WGCNA modules to a different study's h5ad
  ant score P26/HMI Sierksma2025/WGCNA

  # Full pipeline: h5ad -> duckdb -> S3 -> API rescan
  ant score S25/PhM Sierksma2025/WGCNA --rebuild --push --rescan

  # Dry-run: compute and report, do not write
  ant score S25/PhM Sierksma2025/WGCNA --dry-run

Options:
  --ctrl-size N      scanpy ctrl_size (default 50)
  --n-bins N         scanpy n_bins (default 25)
  --seed N           random_state (default 0)
  --layer NAME       use this h5ad layer (default: X)
  --use-raw          use adata.raw
  -v, --verbose      more logging
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path
from typing import Dict, List, Optional, Tuple

import anndata
import numpy as np
import pandas as pd
import scanpy as sc

script_dir = Path(__file__).parent.resolve()
lib_dir = script_dir.parent / 'lib'
sys.path.insert(0, str(lib_dir))

from config import get_config            # type: ignore
from geneset import (                    # type: ignore
    Experiment, Geneset, GenesetRegistry,
)
from h5adstore import H5adEntry, find_h5ad   # type: ignore
from metadata import parse_md_file, write_md_file   # type: ignore


SEPARATOR = '::'
TOOL_VERSION = 'ant-score/0.1'


class GenesetSkipped(Exception):
    """Raised when a single geneset can't be meaningfully scored on this
    dataset (0 genes overlap, <3 genes overlap). The dataset's other
    genesets are scored anyway; the skip is recorded in provenance."""


# ── resolution helpers ────────────────────────────────────────────────────────

def _load_geneset_registry() -> GenesetRegistry:
    config = get_config()
    store_value = config.get('geneset_store')
    if not store_value:
        sys.exit("ERROR: geneset_store is not configured (anthive.yaml)")
    store_path = (script_dir.parent / store_value).resolve()
    if not store_path.exists():
        sys.exit(f"ERROR: geneset store does not exist: {store_path}")
    registry = GenesetRegistry(store_path)
    registry.scan()
    if registry.errors:
        for error in registry.errors:
            print(f"  store error: {error}", file=sys.stderr)
        sys.exit("ERROR: geneset store has unresolved errors — fix with `ant geneset validate`")
    return registry


def _h5adstore_root() -> Path:
    config = get_config()
    h5ad_root_value = config.get('h5ad_store') or 'data/h5adstore'
    root = (script_dir.parent / h5ad_root_value).resolve()
    if not root.exists():
        sys.exit(f"ERROR: h5ad store does not exist: {root}")
    return root


def _resolve_target(registry: GenesetRegistry, target: str
                    ) -> List[Tuple[Experiment, List[Geneset]]]:
    """
    Resolve a target string to a list of (experiment, [genesets]).

    Accepts:
      - experiment id  ('Sierksma2025/WGCNA')         -> all genesets
      - geneset id     ('Sierksma2025/WGCNA/Brown')   -> that one geneset
    """
    target = target.strip().strip('/')
    parts = target.split('/')

    if len(parts) == 2:
        experiment_id = target
        experiment = registry.get_experiment(experiment_id)
        if experiment is None:
            sys.exit(f"ERROR: experiment {experiment_id!r} not found in geneset store")
        members = [
            g for g in registry.list_genesets()
            if g.experiment.experiment_id == experiment_id
        ]
        if not members:
            sys.exit(f"ERROR: experiment {experiment_id!r} contains no genesets")
        return [(experiment, members)]

    if len(parts) == 3:
        geneset = registry.get(target)
        if geneset is None:
            sys.exit(f"ERROR: geneset {target!r} not found in geneset store")
        return [(geneset.experiment, [geneset])]

    sys.exit(
        f"ERROR: target {target!r} must be either '<study>/<experiment>' "
        f"or '<study>/<experiment>/<geneset>'"
    )


# ── core scoring ──────────────────────────────────────────────────────────────

def _column_name(experiment: Experiment, geneset: Geneset) -> str:
    return f"{experiment.study}{SEPARATOR}{experiment.name}{SEPARATOR}{geneset.name}"


def _score_one(adata, geneset: Geneset, column: str,
               ctrl_size: int, n_bins: int, seed: int,
               layer: Optional[str], use_raw: bool, verbose: bool
               ) -> Dict[str, object]:
    """
    Run scanpy.tl.score_genes for one geneset. Mutates adata.obs.
    Returns a per-geneset provenance dict.
    """
    if geneset.format != 'grp':
        raise RuntimeError(
            f"{geneset.geneset_id}: only .grp genesets are supported (got .{geneset.format}). "
            "Rank-aware scoring is not implemented yet."
        )

    requested = list(geneset.genes)
    var_names = set(adata.var_names)
    found = [g for g in requested if g in var_names]
    missing = [g for g in requested if g not in var_names]

    # Skip (don't abort) modules that can't be meaningfully scored. Aborting
    # would block the remaining 12+ modules over one Y-linked or other
    # filtered-out edge case. Caller treats GenesetSkipped as a per-module
    # skip and continues with the rest of the experiment.
    if not found:
        raise GenesetSkipped(
            f"{geneset.geneset_id}: 0 of {len(requested)} genes in adata.var_names"
        )
    if len(found) < 3:
        raise GenesetSkipped(
            f"{geneset.geneset_id}: only {len(found)} of {len(requested)} genes found "
            f"(need >= 3 for a meaningful score)"
        )

    sc.tl.score_genes(
        adata,
        gene_list=found,
        ctrl_size=ctrl_size,
        n_bins=n_bins,
        score_name=column,
        random_state=seed,
        layer=layer,
        use_raw=use_raw,
        copy=False,
    )

    scores = np.asarray(adata.obs[column].values, dtype=float)
    summary = {
        'mean':   float(np.mean(scores)),
        'std':    float(np.std(scores)),
        'min':    float(np.min(scores)),
        'max':    float(np.max(scores)),
        'median': float(np.median(scores)),
    }

    if verbose:
        print(
            f"    {column}  found={len(found)}/{len(requested)}  "
            f"range=[{summary['min']:.3f}, {summary['max']:.3f}]  "
            f"mean={summary['mean']:.3f}"
        )
    else:
        print(
            f"    {column}  ({len(found)}/{len(requested)} genes, "
            f"mean={summary['mean']:.3f})"
        )

    return {
        'column':        column,
        'geneset_id':    geneset.geneset_id,
        'requested':     len(requested),
        'found':         len(found),
        'missing':       missing,
        'summary':       summary,
    }


def _score_experiment(adata, experiment: Experiment, genesets: List[Geneset],
                      genesetstore_root: Path, args: argparse.Namespace
                      ) -> Dict[str, object]:
    """
    Score one experiment's worth of genesets onto adata. Mutates adata.

    Raises on any failure — caller is responsible for not writing back if so.
    """
    # organism cross-check (geneset metadata only — adata's organism is in .uns
    # sometimes, and not always reliable; we use the genesetstore as truth)
    geneset_organism = experiment.organism
    if geneset_organism and geneset_organism != 'human' and geneset_organism != 'mouse':
        # non-canonical organism — warn but don't refuse
        print(f"  WARNING: experiment organism is {geneset_organism!r}", file=sys.stderr)

    plan = []
    for geneset in genesets:
        column = _column_name(experiment, geneset)
        plan.append((geneset, column))
        if column in adata.obs.columns:
            print(f"    (overwriting existing column {column!r})")

    print(f"  Scoring {len(plan)} geneset(s)…")

    per_geneset = []
    skipped = []
    for geneset, column in plan:
        try:
            per_geneset.append(_score_one(
                adata, geneset, column,
                ctrl_size=args.ctrl_size,
                n_bins=args.n_bins,
                seed=args.seed,
                layer=args.layer,
                use_raw=args.use_raw,
                verbose=args.verbose,
            ))
        except GenesetSkipped as exc:
            print(f"    SKIP {geneset.geneset_id}: {exc}", file=sys.stderr)
            skipped.append({
                'geneset_id': geneset.geneset_id,
                'reason':     str(exc),
            })

    # provenance under adata.uns['module_scores'][experiment_id]
    # Stored as a JSON string — anndata.uns is fragile with nested dicts
    # containing empty lists or mixed types.
    if 'module_scores' not in adata.uns:
        adata.uns['module_scores'] = {}
    if not isinstance(adata.uns['module_scores'], dict):
        adata.uns['module_scores'] = {}

    record = {
        'experiment_id':     experiment.experiment_id,
        'organism':          experiment.organism,
        'method':            experiment.method,
        'parent_dataset':    experiment.parent_dataset,
        'gene_id_type':      experiment.gene_id_type,
        'genesetstore_sha':  _git_sha(genesetstore_root),
        'parameters': {
            'ctrl_size':  args.ctrl_size,
            'n_bins':     args.n_bins,
            'seed':       args.seed,
            'layer':      args.layer if args.layer is not None else 'X',
            'use_raw':    args.use_raw,
            'separator':  SEPARATOR,
        },
        'per_geneset':       per_geneset,
        'columns':           [g['column'] for g in per_geneset],
        'skipped':           skipped,
        'timestamp':         datetime.now(timezone.utc).isoformat(),
        'tool_version':      TOOL_VERSION,
    }
    # Replace '/' with the column separator so the key doesn't auto-split into
    # nested HDF5 groups (anndata raises FutureWarning otherwise, will become
    # an error). Readers should split the key on SEPARATOR to recover the
    # experiment_id.
    safe_key = experiment.experiment_id.replace('/', SEPARATOR)
    adata.uns['module_scores'][safe_key] = json.dumps(record)
    return record


def _git_sha(repo: Path) -> Optional[str]:
    try:
        result = subprocess.run(
            ['git', '-C', str(repo), 'rev-parse', 'HEAD'],
            capture_output=True, text=True, check=False,
        )
        if result.returncode == 0:
            return result.stdout.strip()
    except Exception:
        pass
    return None


# ── h5ad I/O with atomic write ────────────────────────────────────────────────

def _process_one_h5ad(entry: H5adEntry,
                      experiments: List[Tuple[Experiment, List[Geneset]]],
                      genesetstore_root: Path,
                      args: argparse.Namespace) -> Dict[str, object]:
    """
    Apply all (experiment, genesets) pairs to one h5ad. Atomic: writes to
    .h5ad.tmp first, only renames on full success. On any error, the .tmp is
    removed and the original is untouched.
    """
    print(f"\n=== {entry.db_id} ({entry.readable_id}) ===")
    print(f"  h5ad: {entry.h5ad_path}")

    if not entry.h5ad_path.exists():
        sys.exit(
            f"ERROR: {entry.h5ad_path} not found locally — refusing to score "
            f"a remote / S3-only dataset. Pull it first."
        )

    # Resolve default_layer from .md — REQUIRED. ant-score will refuse to
    # score on a dataset without an explicit default_layer declaration, since
    # silently using adata.X can score on raw counts (which is meaningless for
    # scanpy.tl.score_genes).
    md_metadata, _ = parse_md_file(entry.md_path)
    default_layer = md_metadata.get('default_layer')
    has_lognorm = md_metadata.get('has_lognorm', True)
    if args.layer is not None:
        layer_to_use = args.layer
        layer_source = 'CLI override'
    elif has_lognorm is False:
        sys.exit(
            f"ERROR: {entry.md_path.name} declares 'has_lognorm: false' — "
            f"this dataset has no log-normalized layer, so module scoring "
            f"on raw counts would be meaningless. Pass --layer explicitly "
            f"if you really want to override."
        )
    elif default_layer:
        layer_to_use = default_layer
        layer_source = f'.md default_layer'
    else:
        sys.exit(
            f"ERROR: {entry.md_path.name} has no 'default_layer' field — "
            f"refusing to score. Set 'default_layer: X' (or another layer "
            f"name) in the .md, declare 'has_lognorm: false' if no "
            f"log-norm exists, or pass --layer explicitly."
        )

    print(f"  Loading…")
    adata = anndata.read_h5ad(entry.h5ad_path)
    print(f"  {adata.n_obs:,} cells × {adata.n_vars:,} genes")
    print(f"  Layer: {layer_to_use!r}  (from {layer_source})")

    # Some datasets (CellxGene Discover convention) put Ensembl IDs in
    # var_names and the human-readable gene symbols in a column like
    # 'feature_name' / 'gene_symbol'. If we detect that, swap var_names to
    # the symbol column so geneset gene names match.
    adata = _maybe_remap_var_names(adata, args.gene_column)

    # Translate "X" → None (scanpy convention for adata.X)
    layer_arg = None if layer_to_use == 'X' else layer_to_use
    if layer_arg is not None and layer_arg not in adata.layers:
        sys.exit(
            f"ERROR: layer {layer_arg!r} not found in h5ad. "
            f"Available layers: {list(adata.layers.keys())}"
        )

    # Override args.layer so _score_experiment / _score_one see the resolved value.
    args.layer = layer_arg

    # Resolve dataset organism from .md annotation; falls back to a heuristic
    # only if the .md says nothing.
    md_annotation = md_metadata.get('annotation') or {}
    md_organism = md_annotation.get('organism')
    if isinstance(md_organism, list):
        md_organism = [str(o).lower() for o in md_organism]
    elif md_organism is not None:
        md_organism = str(md_organism).lower()

    summaries = []
    for experiment, genesets in experiments:
        print(f"\n  Experiment: {experiment.experiment_id}  "
              f"(organism={experiment.organism}, method={experiment.method})")
        if experiment.organism:
            wanted = experiment.organism.lower()
            ok = False
            if md_organism is not None:
                if isinstance(md_organism, list):
                    ok = wanted in md_organism
                else:
                    ok = wanted == md_organism
            else:
                ok = _organism_compatible(adata, experiment.organism)
            if not ok:
                sys.exit(
                    f"ERROR: experiment organism {experiment.organism!r} is not "
                    f"compatible with dataset organism {md_organism!r}. "
                    f"Aborting (no scores written)."
                )
        record = _score_experiment(
            adata, experiment, genesets, genesetstore_root, args,
        )
        summaries.append(record)

    if args.dry_run:
        print("\n  (dry run — not writing h5ad)")
        return {'entry': entry.db_id, 'experiments': summaries, 'wrote': False}

    tmp_path = entry.h5ad_path.with_suffix('.h5ad.tmp')
    if tmp_path.exists():
        tmp_path.unlink()
    print(f"\n  Writing to {tmp_path.name} (atomic)…")
    try:
        adata.write_h5ad(tmp_path, compression='gzip')
        os.replace(tmp_path, entry.h5ad_path)
    except BaseException:
        if tmp_path.exists():
            tmp_path.unlink()
        raise
    print(f"  ✓ wrote {entry.h5ad_path}")

    # Update the .md to expose the new columns through ant-convert (which uses
    # obsnum_include as an allowlist).
    new_columns = []
    for record in summaries:
        new_columns.extend(record['columns'])
    if new_columns:
        _ensure_obsnum_include(entry.md_path, new_columns)

    return {'entry': entry.db_id, 'experiments': summaries, 'wrote': True}


def _ensure_obsnum_include(md_path: Path, columns: List[str]) -> None:
    """Append new columns to obsnum_include in the dataset's .md (idempotent)."""
    metadata, body = parse_md_file(md_path)
    existing = metadata.get('obsnum_include') or []
    if not isinstance(existing, list):
        existing = [existing]
    added = [c for c in columns if c not in existing]
    if not added:
        return
    metadata['obsnum_include'] = list(existing) + added
    write_md_file(md_path, metadata, body)
    print(f"  ✓ updated {md_path.name}: +{len(added)} obsnum_include entries")


_GENE_SYMBOL_COLUMN_CANDIDATES = ('feature_name', 'gene_symbol', 'Symbol',
                                  'gene_symbols', 'gene_name', 'symbol')


def _swap_var_names(adata, column: str, source_label: str):
    """Swap adata.var_names to `column`, deduplicating by keeping first.

    Returns a new adata view (subsetted to unique gene symbols).
    """
    old_idx_name = adata.var.index.name or '_var_index'
    # Preserve the original IDs as a column
    adata.var[old_idx_name + '_orig'] = adata.var.index.values
    new_names = pd.Index(adata.var[column].astype(str).values, name=old_idx_name)

    # Deduplicate: keep first row for each symbol
    keep_mask = ~new_names.duplicated(keep='first')
    n_dups = int((~keep_mask).sum())

    # Apply temporary index for slicing
    adata.var.index = new_names
    if n_dups:
        adata = adata[:, keep_mask].copy()
        print(
            f"  Var names swapped to {column!r} ({source_label}); "
            f"dropped {n_dups:,} duplicate symbols (kept first)."
        )
    else:
        print(f"  Var names swapped to {column!r} ({source_label}).")
    return adata


def _maybe_remap_var_names(adata, explicit_column: Optional[str]):
    """If var_names aren't symbols, return adata with var index swapped.

    Auto-detects CellxGene-style Ensembl IDs and looks up a known symbol
    column. Returns the (possibly new) adata.
    """
    if explicit_column:
        if explicit_column not in adata.var.columns:
            sys.exit(
                f"ERROR: --gene-column {explicit_column!r} not found in "
                f"adata.var. Available columns: {list(adata.var.columns)}"
            )
        return _swap_var_names(adata, explicit_column, 'CLI override')

    sample = list(adata.var_names[:200])
    if not sample:
        return adata
    looks_ensembl = sum(
        1 for s in sample
        if isinstance(s, str) and (s.startswith('ENSG') or s.startswith('ENSMUS'))
    ) / len(sample)
    if looks_ensembl < 0.5:
        return adata

    for cand in _GENE_SYMBOL_COLUMN_CANDIDATES:
        if cand in adata.var.columns:
            return _swap_var_names(adata, cand, 'autodetected; var_names looked like Ensembl IDs')

    print(
        "  WARNING: var_names look like Ensembl IDs but no symbol column "
        "(feature_name/gene_symbol/Symbol/...) found in adata.var. "
        "Scoring will likely fail."
    )
    return adata


def _organism_compatible(adata, organism: str) -> bool:
    """
    Crude organism check.

    Look at adata.uns for an 'organism' key, otherwise inspect var_names
    (uppercase = human, mixed case = mouse, by convention).
    """
    declared = None
    if 'organism' in adata.uns:
        declared = str(adata.uns['organism']).lower()
    if declared:
        return declared == organism.lower()

    # Fallback: heuristic on gene-name casing.
    sample = list(adata.var_names[:200])
    if not sample:
        return True  # nothing to check; trust the user
    upper = sum(1 for g in sample if g.isupper() or '-' in g)
    fraction_upper = upper / len(sample)
    if organism.lower() == 'human':
        return fraction_upper >= 0.4
    if organism.lower() == 'mouse':
        return fraction_upper <= 0.7
    return True  # other organisms, no heuristic


# ── pipeline chaining ─────────────────────────────────────────────────────────

def _run_rebuild(entry: H5adEntry) -> int:
    cmd = [str(script_dir / 'ant-convert'), str(entry.h5ad_path)]
    print(f"\n  $ {' '.join(cmd)}")
    return subprocess.call(cmd)


def _run_push(entry: H5adEntry) -> int:
    files = [str(entry.h5ad_path), str(entry.duckdb_path)]
    files = [f for f in files if Path(f).exists()]
    cmd = [str(script_dir / 'ant-sync'), 'push', *files]
    print(f"\n  $ {' '.join(cmd)}")
    return subprocess.call(cmd)


def _run_rescan(api_url: str) -> int:
    import urllib.request
    request = urllib.request.Request(
        f"{api_url.rstrip('/')}/admin/rescan", method='POST',
    )
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            print(f"\n  rescan -> {response.status} {response.read()[:200]}")
            return 0
    except Exception as exc:
        print(f"\n  rescan FAILED: {exc}", file=sys.stderr)
        return 1


# ── main ──────────────────────────────────────────────────────────────────────

def main() -> int:
    parser = argparse.ArgumentParser(
        description='Compute scanpy module scores from the genesetstore.',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__,
    )
    parser.add_argument('db_id',
                        help='h5adstore dataset to score onto, e.g. S25/PhM '
                             'or Sierksma2025/Pharmacogenomics')
    parser.add_argument('genesets', nargs='+',
                        help='one or more experiment_id or geneset_id values, e.g. '
                             'Sierksma2025/WGCNA  or  Sierksma2025/WGCNA/Brown_Lysosome')
    parser.add_argument('--ctrl-size', type=int, default=50)
    parser.add_argument('--n-bins',    type=int, default=25)
    parser.add_argument('--seed',      type=int, default=0)
    parser.add_argument('--layer',     default=None,
                        help='h5ad layer to use (default: X)')
    parser.add_argument('--use-raw',   action='store_true',
                        help='Use adata.raw')
    parser.add_argument('--gene-column', default=None,
                        help='If var_names are not gene symbols (e.g. Ensembl IDs), '
                             'use this column from adata.var as the gene index. '
                             'Auto-detected for CellxGene-style files.')
    parser.add_argument('--rebuild',   action='store_true',
                        help='After writing, run `ant convert` to rebuild the .duckdb')
    parser.add_argument('--push',      action='store_true',
                        help='After rebuild, run `ant sync push` to S3')
    parser.add_argument('--rescan',    action='store_true',
                        help='POST /admin/rescan to the API after writing')
    parser.add_argument('--api-url',   default=None,
                        help='API base URL for --rescan (default: from anthive.yaml)')
    parser.add_argument('--dry-run',   action='store_true',
                        help='Compute scores but do not write the h5ad back')
    parser.add_argument('-v', '--verbose', action='store_true')
    args = parser.parse_args()

    registry = _load_geneset_registry()
    h5ad_root = _h5adstore_root()
    genesetstore_root = registry.root

    # Resolve target h5ad first — fail fast on a bad db_id.
    entry = find_h5ad(h5ad_root, args.db_id)
    if entry is None:
        sys.exit(f"ERROR: dataset {args.db_id!r} not found in h5adstore ({h5ad_root})")

    # Collect (experiment, [genesets]) for every requested geneset/experiment id.
    # Multiple ids referencing the same experiment merge — each geneset appears once.
    pairs: List[Tuple[Experiment, List[Geneset]]] = []
    seen_columns: Dict[str, str] = {}  # column -> source id (for collision detection)
    by_experiment: Dict[str, List[Geneset]] = {}
    experiments_by_id: Dict[str, Experiment] = {}
    for raw_id in args.genesets:
        for experiment, genesets in _resolve_target(registry, raw_id):
            experiments_by_id[experiment.experiment_id] = experiment
            for geneset in genesets:
                column = _column_name(experiment, geneset)
                if column in seen_columns and seen_columns[column] != raw_id:
                    print(
                        f"  (skipping duplicate {column} from {raw_id!r}; "
                        f"already requested via {seen_columns[column]!r})"
                    )
                    continue
                seen_columns[column] = raw_id
                by_experiment.setdefault(experiment.experiment_id, []).append(geneset)

    for experiment_id, members in by_experiment.items():
        pairs.append((experiments_by_id[experiment_id], members))

    if not pairs:
        sys.exit("ERROR: no genesets resolved")

    n_total = sum(len(genesets) for _, genesets in pairs)
    print(f"Plan: {entry.db_id} ({entry.readable_id}) ← "
          f"{len(pairs)} experiment(s), {n_total} geneset(s)")

    result = _process_one_h5ad(entry, pairs, genesetstore_root, args)
    results = [(entry, result)]

    if args.dry_run:
        print("\n(dry run; no h5ad files modified)")
        return 0

    # Optional pipeline chain
    rebuild_failed = False
    for entry, result in results:
        if not result.get('wrote'):
            continue
        if args.rebuild:
            rc = _run_rebuild(entry)
            if rc != 0:
                rebuild_failed = True
                print(f"  ⚠ rebuild for {entry.db_id} returned {rc}", file=sys.stderr)
                continue
            if args.push:
                rc = _run_push(entry)
                if rc != 0:
                    print(f"  ⚠ push for {entry.db_id} returned {rc}", file=sys.stderr)

    if args.rescan:
        api_url = args.api_url
        if not api_url:
            config = get_config()
            host = config.get('rest_api_host', 'localhost')
            port = config.get('rest_api_port', 8080)
            api_url = f"http://{host}:{port}/api"
        _run_rescan(api_url)

    print()
    print(f"Done. {sum(1 for _, r in results if r.get('wrote'))} h5ad(s) written, "
          f"{sum(len(r['experiments']) for _, r in results)} experiment(s) scored.")
    return 1 if rebuild_failed else 0


if __name__ == '__main__':
    sys.exit(main())
