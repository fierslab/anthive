def cmd_init(args: argparse.Namespace) -> int:
    path = site_path(args)
    if not path.exists():
        shutil.copyfile(EXAMPLE, path)
        os.chmod(path, 0o640)
        _say(f"wrote {path} from site.example.yaml: edit it, then run `ant-stack init` again")
        return 0
    site = load_site(path)
    state = site['_state']
    state.mkdir(parents=True, exist_ok=True)
    os.chmod(state, 0o700)
    for sub in ('secrets', 'authelia', 'stack'):
        (state / sub).mkdir(exist_ok=True)
    created = ensure_secrets(site)
    for item in created:
        _say(f"created {item}")
    render(site)
    _say("init done; next: `ant-stack check`")
    return 0


def cmd_check(args: argparse.Namespace) -> int:
    site = load_site(site_path(args))
    render(site, quiet=True)
    print_plan(site)
    problems = check(site, running=args.running)
    for problem in problems:
        print(f"  PROBLEM  {problem}")
    if problems:
        return 1
    print("  OK: ready for `ant-stack up`")
    return 0


def cmd_render(args: argparse.Namespace) -> int:
    site = load_site(site_path(args))
    render(site)
    return 0


def cmd_up(args: argparse.Namespace) -> int:
    site = load_site(site_path(args))
    ensure_secrets(site)
    render(site)
    blocking = [p for p in check(site, running=True) if 'ingest' not in p]
    if blocking:
        for problem in blocking:
            print(f"  PROBLEM  {problem}")
        return 1
    extra = ['--wait', '--wait-timeout', str(args.wait_timeout)] if not args.no_wait else []
    # 1. Re-sync the image's static bundles + Caddy config into the shared
    #    volumes (a new image or edited config must not be masked by the
    #    copy made at the previous `up`).
    run_compose(site, 'up', '-d', '--no-deps', '--force-recreate', 'static')
    if run_compose(site, 'wait', 'static', check=False) != 0:
        raise SiteError("the static sync container failed; see `ant-stack logs static`")
    # 2. Everything else. Authelia first without waiting: if a previous
    #    config made it crash-loop, compose would otherwise wait on the
    #    stale container instead of recreating it with the new config.
    if site['auth']['mode'] == 'authelia':
        run_compose(site, 'up', '-d', '--no-deps', '--force-recreate', 'authelia')
    run_compose(site, 'up', '-d', '--remove-orphans', *extra)
    # 3. Services whose profile is now off (auth mode or mcp switched) are
    #    not orphans to compose; stop and remove them explicitly.
    active = {'authelia': site['auth']['mode'] == 'authelia',
              'mcp': bool(site['services'].get('mcp'))}
    for service, is_active in active.items():
        if not is_active:
            run_compose(site, '--profile', service, 'rm', '--stop', '--force', service, check=False)
    # 4. Caddy reads its config only at start (admin API is off): recreate
    #    it so the synced config and re-rendered snippets take effect.
    # Authelia too: its config is re-rendered on every up, and a container
    # stuck in crash-loop backoff would otherwise keep the old failure.
    recreate = ['caddy'] + (['authelia'] if active['authelia'] else [])
    run_compose(site, 'up', '-d', '--no-deps', '--force-recreate', *extra, *recreate)
    _say(f"up: {site['site']['public_url']}")
    return 0


def cmd_simple(args: argparse.Namespace) -> int:
    site = load_site(site_path(args))
    if not (stack_dir(site) / '.env').exists():
        render(site, quiet=True)
    compose_args = {
        'down': ['down'] + (['--volumes'] if getattr(args, 'volumes', False) else []),
        'ps': ['ps', '--all'],
        'pull': ['pull', '--ignore-buildable'],
        'logs': ['logs', '--tail', str(getattr(args, 'tail', 200))]
                + (['-f'] if getattr(args, 'follow', False) else [])
                + ([args.service] if getattr(args, 'service', None) else []),
        'restart': ['restart'] + ([args.service] if getattr(args, 'service', None) else []),
    }[args.command]
    return run_compose(site, *compose_args, check=False)


def cmd_build(args: argparse.Namespace) -> int:
    site = load_site(site_path(args))
    app, ingest = image_ref(site, 'app'), image_ref(site, 'ingest')
    # Build context = `git archive HEAD`: only committed, tracked files, so
    # local state (Authelia db, logs, nested checkouts) can never ship.
    if subprocess.run(['git', 'rev-parse', '--git-dir'], cwd=REPO,
                      capture_output=True).returncode != 0:
        raise SiteError("ant-stack build needs a git checkout (it builds from `git archive HEAD`)")
    if subprocess.run(['git', 'diff', '--quiet', 'HEAD', '--'], cwd=REPO).returncode != 0:
        _say("note: uncommitted changes are NOT in the image; commit them first to include them")
    builds = [
        ['docker', 'build', '-f', 'docker/Dockerfile', '-t', app, '-'],
        ['docker', 'build', '-f', 'docker/Dockerfile.ingest', '--build-arg', f'APP_IMAGE={app}',
         '-t', ingest, '-'],
    ]
    for command, image in list(zip(builds, (app, ingest)))[: 1 if args.app_only else 2]:
        if args.pull:
            command.insert(2, '--pull')
        _say('git archive HEAD | ' + ' '.join(command))
        archive = subprocess.Popen(['git', 'archive', '--format=tar', 'HEAD'], cwd=REPO,
                                   stdout=subprocess.PIPE)
        result = subprocess.run(command, cwd=REPO, stdin=archive.stdout)
        archive.stdout.close()
        if archive.wait() != 0 or result.returncode != 0:
            return result.returncode or 1
        check = subprocess.run([str(REPO / 'docker' / 'check-image'), image, 'HEAD'], cwd=REPO)
        if check.returncode != 0:
            raise SiteError(f"{image} failed docker/check-image; not safe to use or push")
    return 0


def cmd_passwd(args: argparse.Namespace) -> int:
    site = load_site(site_path(args))
    names = {str(u['name']) for u in site['auth'].get('users') or []}
    if args.user not in names:
        raise SiteError(f"{args.user!r} is not in auth.users of site.yaml")
    password = args.password or os.environ.get('ANTHIVE_NEW_PASSWORD')
    if not password:
        import getpass  # noqa: PLC0415
        password = getpass.getpass(f"new password for {args.user}: ")
        if password != getpass.getpass("again: "):
            raise SiteError("passwords differ")
    if len(password) < 10:
        raise SiteError("use at least 10 characters")
    hashes = _load_user_hashes(site)
    hashes[args.user] = _hash_password(password)
    _save_user_hashes(site, hashes)
    users_db = site['_state'] / 'authelia' / 'users_database.yml'
    if users_db.exists():
        doc = yaml.safe_load(users_db.read_text()) or {}
        if args.user in (doc.get('users') or {}):
            doc['users'][args.user]['password'] = hashes[args.user]
            _write_secret(users_db, yaml.safe_dump(doc, sort_keys=True), overwrite=True)
    render(site, quiet=True)
    _say(f"password for {args.user} updated (basic list + authelia db); "
         f"basic mode needs `ant-stack restart caddy`")
    return 0


def cmd_ingest(args: argparse.Namespace) -> int:
    site = load_site(site_path(args))
    render(site, quiet=True)
    command = list(args.cmd)
    if command and command[0] == '--':
        command = command[1:]
    if not command:
        raise SiteError("usage: ant-stack ingest -- <command...>")
    return run_compose(site, '--profile', 'ingest', 'run', '--rm', '--no-deps', 'ingest',
                       *command, check=False)


def cmd_config_path(args: argparse.Namespace) -> int:
    site = load_site(site_path(args))
    print(stack_dir(site) / 'anthive.yaml')
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(prog='ant-stack', description=__doc__.splitlines()[0],
                                     formatter_class=argparse.RawDescriptionHelpFormatter,
                                     epilog=__doc__)
    parser.add_argument('--site', help='site.yaml path (default: $ANTHIVE_SITE or ./site.yaml)')
    sub = parser.add_subparsers(dest='command', required=True)
    sub.add_parser('init')
    p_check = sub.add_parser('check')
    p_check.add_argument('--running', action='store_true',
                         help='skip the free-port check (stack already up)')
    sub.add_parser('render')
    p_up = sub.add_parser('up')
    p_up.add_argument('--no-wait', action='store_true')
    p_up.add_argument('--wait-timeout', type=int, default=900)
    p_down = sub.add_parser('down')
    p_down.add_argument('--volumes', action='store_true',
                        help='also delete the docker volumes (webapp bundle, caddy certs, scratch)')
    sub.add_parser('ps')
    sub.add_parser('pull')
    p_logs = sub.add_parser('logs')
    p_logs.add_argument('service', nargs='?')
    p_logs.add_argument('-f', '--follow', action='store_true')
    p_logs.add_argument('--tail', type=int, default=200)
    p_restart = sub.add_parser('restart')
    p_restart.add_argument('service', nargs='?')
    p_build = sub.add_parser('build')
    p_build.add_argument('--pull', action='store_true', help='pull newer base images')
    p_build.add_argument('--app-only', action='store_true')
    p_passwd = sub.add_parser('passwd')
    p_passwd.add_argument('user')
    p_passwd.add_argument('--password', help='non-interactive (or $ANTHIVE_NEW_PASSWORD)')
    p_ingest = sub.add_parser('ingest')
