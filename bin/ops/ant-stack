AUTH_MODES = ('authelia', 'basic', 'trusted-proxy', 'none')
# names the system writes as artefact owners (lib/artefacts.py SYSTEM_OWNERS): never a login
RESERVED_LOGINS = frozenset({'migration'})
TLS_MODES = ('internal', 'acme', 'off')
# What the api container may do on S3 (s3.api_access). The serving stack
# needs no S3 keys when the data is local; ingest and host-side sync always
# get the full keys from secrets/s3_access_key_id + s3_secret_access_key.
S3_API_ACCESS = ('none', 'read', 'write')
S3_KEY_FILES = {'write': ('s3_access_key_id', 's3_secret_access_key'),
                'read': ('s3_read_access_key_id', 's3_read_secret_access_key')}
# Optional key pair the api presigns dataset deposits with (services.dataset_deposit);
# without it the api gets the read-write pair for that purpose (`check` warns).
S3_INCOMING_KEY_FILES = ('s3_incoming_access_key_id', 's3_incoming_secret_access_key')
# A site whose deposits a central watcher on another host ingests (datasets.central_watcher, design section 24):
# the key pair of the INGESTION bucket (its own staging folder and records; the watcher copies into __incoming/)
# the api presigns and writes records with;
# the main s3 keys can then stay on the host. The site secret signs the records; the watcher holds a copy.
S3_INGEST_KEY_FILES = ('s3_ingest_access_key_id', 's3_ingest_secret_access_key')
DEPOSIT_SITE_SECRET_FILE = 'deposit_site_secret'
# Optional read-only key pair the api HEADs and signs artefact GETs with (artefacts_s3); without it the
# api uses its s3 block (s3.api_access read/write) or serves artefacts from local copies only.
S3_ARTEFACTS_READ_KEY_FILES = ('s3_artefacts_read_access_key_id', 's3_artefacts_read_secret_access_key')
# site.yaml artefacts: block -> anthive.yaml key (doc/DESIGN_artefacts.md section 14)
ARTEFACT_SITE_KEYS = {'upload_groups': 'artefacts_upload_groups',
                      'collections_create_groups': 'collections_create_groups',
                      'max_file_gb': 'artefacts_max_file_gb', 'max_deposit_gb': 'artefacts_max_deposit_gb',
                      'max_files': 'artefacts_max_files', 'max_versions': 'artefacts_max_versions',
                      'max_stored_gb_per_user': 'artefacts_max_stored_gb_per_user',
                      'inline_max_mb': 'artefacts_inline_max_mb', 'hold_public': 'artefacts_hold_public',
                      'serve_local': 'artefacts_serve_local', 'url_ttl_seconds': 'artefacts_url_ttl_seconds'}

# Container-side fixed locations (see docker/Dockerfile + compose.yaml).
C_STATE = '/var/lib/anthive'
C_SCRATCH = '/scratch'
C_WEBAPP = '/srv/webapp'
C_CONFIG = '/etc/anthive/anthive.yaml'
C_CADDY_SNIPPETS = '/etc/anthive-caddy'
C_CADDY_CONFIG = '/srv/caddy-config/config'
PORT_TLS_INTERNAL = 8443
PORT_PLAIN = 8500


class SiteError(Exception):
    """A site.yaml problem the operator must fix."""


def _say(message: str) -> None:
    print(f"[ant-stack] {message}", flush=True)


def _warn(message: str) -> None:
    print(f"[ant-stack] WARNING: {message}", file=sys.stderr, flush=True)


# ── site.yaml ────────────────────────────────────────────────────────────

def _deep_merge(base: dict, override: dict) -> dict:
    merged = copy.deepcopy(base)
    for key, value in (override or {}).items():
        if isinstance(value, dict) and isinstance(merged.get(key), dict):
            merged[key] = _deep_merge(merged[key], value)
        else:
            merged[key] = value
    return merged


def site_path(args: argparse.Namespace) -> Path:
    raw = args.site or os.environ.get('ANTHIVE_SITE') or 'site.yaml'
    return Path(raw).expanduser().resolve()


def load_site(path: Path) -> dict:
    if not path.exists():
        raise SiteError(f"{path} not found; run `ant-stack init` first")
    defaults = yaml.safe_load(EXAMPLE.read_text()) or {}
    user = yaml.safe_load(path.read_text()) or {}
    if not isinstance(user, dict):
        raise SiteError(f"{path} must be a YAML mapping (site:, data:, auth:, ...)")
    site = _deep_merge(defaults, user)
    # `users` lists replace rather than merge.
    if 'auth' in user and 'users' in (user.get('auth') or {}):
        site['auth']['users'] = user['auth']['users'] or []
    site = validate_site(site, path)
    site['_key_problems'], site['_key_warnings'] = site_key_findings(user, defaults)
    return site


#: Sections whose unknown keys block `check` / `up` (a typo there silently changes security or
#: what is served); unknown keys elsewhere are warnings.
STRICT_SECTIONS = ('auth', 'tls', 'ports', 's3', 'services', 'datasets', 'data', 'ui')
#: Valid keys that site.example.yaml only shows in a comment.
EXTRA_SITE_KEYS = {'site': {'docs_base_url'}}
#: Mappings whose own keys are free-form (copied through or described elsewhere).
FREE_FORM = {('anthive',), ('auth', 'smtp'), ('auth', 'users')}


def site_key_findings(user: dict, schema: dict) -> tuple[list[str], list[str]]:
    """(problems, warnings) for keys of site.yaml that site.example.yaml does not know.

    A misspelt key (``auth: {mdoe: basic}``) is otherwise merged over the defaults and ignored.
    Unknown keys in STRICT_SECTIONS are problems; at the top level and in other sections they
    are warnings. Each finding names the closest known key."""
    import difflib  # noqa: PLC0415

    problems: list[str] = []
    warnings: list[str] = []

    def hint(key: str, known) -> str:
        close = difflib.get_close_matches(str(key), sorted(map(str, known)), n=1, cutoff=0.6)
        return f" (did you mean {close[0]!r}?)" if close else ''

    def walk(given: dict, known: dict, trail: tuple) -> None:
        if trail in FREE_FORM:
            return
        allowed = set(known) | EXTRA_SITE_KEYS.get('.'.join(trail), set())
        for key, value in given.items():
            where = '.'.join((*trail, str(key)))
            if key not in allowed:
                message = f"site.yaml: unknown key {where}{hint(key, allowed)}"
                (problems if trail and trail[0] in STRICT_SECTIONS else warnings).append(message)
                continue
            if isinstance(value, dict) and isinstance(known.get(key), dict):
                walk(value, known[key], (*trail, str(key)))

    walk(user, schema, ())
    return problems, warnings


def _abs(value: Any, field: str, required: bool = True) -> Path | None:
    if value in (None, ''):
        if required:
            raise SiteError(f"{field} is required")
        return None
    path = Path(os.path.expandvars(os.path.expanduser(str(value))))
    if not path.is_absolute():
        raise SiteError(f"{field} must be an absolute host path (got {value!r})")
    return path


def _extra_mounts(value: Any) -> list[Path]:
    """data.extra_mounts as absolute host paths (deduplicated, order kept)."""
    if value in (None, ''):
        return []
    if not isinstance(value, list):
        raise SiteError("data.extra_mounts must be a list of absolute host paths")
    mounts: list[Path] = []
    for index, item in enumerate(value):
        path = _abs(item, f"data.extra_mounts[{index}]")
        if path not in mounts:
            mounts.append(path)
    return mounts


def validate_site(site: dict, path: Path) -> dict:
    name = str(site['site'].get('name') or '')
    if not re.fullmatch(r'[a-z0-9][a-z0-9-]{0,40}', name):
        raise SiteError("site.name must be lowercase letters, digits and dashes")
    public = urlsplit(str(site['site'].get('public_url') or ''))
    if public.scheme not in ('http', 'https') or not public.hostname:
        raise SiteError("site.public_url must look like https://host[:port]")
    auth_mode = site['auth'].get('mode')
    if auth_mode not in AUTH_MODES:
        raise SiteError(f"auth.mode must be one of {', '.join(AUTH_MODES)}")
    tls_mode = site['tls'].get('mode')
    if tls_mode is False:          # YAML 1.1 reads a bare `off` as false
        tls_mode = site['tls']['mode'] = 'off'
    if tls_mode not in TLS_MODES:
        raise SiteError(f"tls.mode must be one of {', '.join(TLS_MODES)}")
    if tls_mode == 'acme' and not site['tls'].get('acme_email'):
        raise SiteError("tls.mode acme needs tls.acme_email")
    if auth_mode == 'authelia' and public.scheme != 'https':
        raise SiteError("auth.mode authelia requires an https public_url (Authelia refuses http cookies)")
    if auth_mode == 'basic' and not site['auth'].get('users'):
        raise SiteError("auth.mode basic needs at least one entry in auth.users")
    reserved = [str(user.get('name')) for user in site['auth'].get('users') or []
                if isinstance(user, dict) and str(user.get('name') or '').lower() in RESERVED_LOGINS]
    if reserved:
        raise SiteError(f"auth.users: {', '.join(reserved)} is a reserved system name (artefact owner of the "
                        f"migration); choose another login")
    if not isinstance(site['auth'].get('internal_requires_auth', True), bool):
        raise SiteError("auth.internal_requires_auth must be true or false")
    facets_visible = site['site'].get('facets_visible')
    if facets_visible is not None and (
            not isinstance(facets_visible, list)
            or not all(isinstance(f, str) and re.fullmatch(r'ant_[A-Za-z0-9_]+', f) for f in facets_visible)):
        raise SiteError("site.facets_visible must be a list of ant_* facet names (or [] for all)")
    ui = site.get('ui')
    if ui is None:
        ui = site['ui'] = {}
    if not isinstance(ui, dict):
        raise SiteError(f"ui must be a mapping ({', '.join(UI_SWITCHES)}: true or false)")
    for key in UI_SWITCHES:
        value = ui.get(key, True)
        if value is None:
            value = ui[key] = True
        if not isinstance(value, bool):
            raise SiteError(f"ui.{key} must be true or false, not {value!r}")
    site['_path'] = path
    site['_h5adstore'] = _abs(site['data'].get('h5adstore'), 'data.h5adstore')
    site['_genesetstore'] = _abs(site['data'].get('genesetstore'), 'data.genesetstore', False)
    site['_starcatstore'] = _abs(site['data'].get('starcatstore'), 'data.starcatstore', False)
    site['_library'] = _abs(site['data'].get('library'), 'data.library', False)
    site['_library_index'] = _abs(site['data'].get('library_index'), 'data.library_index', False)
    site['_extra_mounts'] = _extra_mounts(site['data'].get('extra_mounts'))
    site['_state'] = _abs(site.get('state_dir'), 'state_dir')
    site['_scratch'] = _abs(site.get('scratch_dir'), 'scratch_dir', False)
    run_as = site.get('run_as') or {}
    site['_uid'] = int(run_as.get('uid') if run_as.get('uid') is not None else os.getuid())
    site['_gid'] = int(run_as.get('gid') if run_as.get('gid') is not None else os.getgid())
    site['_public'] = public
    for key in ('https', 'http', 'tools'):
        value = site['ports'].get(key)
        try:
            port = int(value)
        except (TypeError, ValueError):
            raise SiteError(f"ports.{key} must be a port number, not {value!r}") from None
        if not 0 < port < 65536:
            raise SiteError(f"ports.{key} must be between 1 and 65535, not {port}")
        site['ports'][key] = port
    if not isinstance(site.get('s3'), dict):
        site['s3'] = {}
    s3 = site['s3']
    api_access = str(s3.get('api_access') or 'none')
    if api_access not in S3_API_ACCESS:
        raise SiteError(f"s3.api_access must be one of {', '.join(S3_API_ACCESS)}")
    s3['api_access'] = api_access
    datasets = site.get('datasets')
    if datasets is not None and not isinstance(datasets, dict):
        raise SiteError("datasets must be a mapping (upload_groups, max_gb, ...)")
    groups = (datasets or {}).get('upload_groups')
    if groups is not None and (not isinstance(groups, list) or not all(isinstance(g, str) and g for g in groups)):
        raise SiteError("datasets.upload_groups must be a list of group names, e.g. [admins, curators]")
    central = (datasets or {}).get('central_watcher')
    if central is not None and not isinstance(central, dict):
        raise SiteError("datasets.central_watcher must be a mapping (ingestion_bucket, watcher_public_keys, ...)")
    keys = (central or {}).get('watcher_public_keys')
    if keys is not None and (not isinstance(keys, list)
                             or not all(isinstance(k, str) and k.startswith('ed25519:') for k in keys)):
        raise SiteError("datasets.central_watcher.watcher_public_keys must be a list of 'ed25519:<base64>' lines "
                        "(from `ant ingest-watch result-key` on the watcher host)")
    key_id = (central or {}).get('key_id')
    if key_id is not None and not re.fullmatch(r'[A-Za-z0-9._-]{1,32}', str(key_id)):
        raise SiteError("datasets.central_watcher.key_id must be a short id such as k1")
    artefact_block = site.get('artefacts')
    if artefact_block is not None and not isinstance(artefact_block, dict):
        raise SiteError("artefacts must be a mapping (enabled, upload_groups, max_file_gb, ...)")
    artefact_block = artefact_block or {}
    unknown = sorted(set(artefact_block) - set(ARTEFACT_SITE_KEYS) - {'enabled'})
    if unknown:
        raise SiteError(f"artefacts: unknown key(s) {', '.join(unknown)} (known: enabled, "
                        f"{', '.join(sorted(ARTEFACT_SITE_KEYS))})")
    if not isinstance(artefact_block.get('enabled', False), bool):
        raise SiteError("artefacts.enabled must be true or false")
    for key in ('upload_groups', 'collections_create_groups'):
        value = artefact_block.get(key)
        if value is not None and (not isinstance(value, list) or not all(isinstance(g, str) and g for g in value)):
            raise SiteError(f"artefacts.{key} must be a list of group names, e.g. [admins, analysts]")
    for key in ('max_file_gb', 'max_deposit_gb', 'max_stored_gb_per_user', 'inline_max_mb'):
        value = artefact_block.get(key)
        if value is not None and (isinstance(value, bool) or not isinstance(value, (int, float)) or value <= 0):
            raise SiteError(f"artefacts.{key} must be a positive number")
    for key in ('max_files', 'max_versions', 'url_ttl_seconds'):
        value = artefact_block.get(key)
        if value is not None and (isinstance(value, bool) or not isinstance(value, int) or value <= 0):
            raise SiteError(f"artefacts.{key} must be a positive whole number")
    if artefact_block.get('hold_public') is not None and not isinstance(artefact_block['hold_public'], bool):
        raise SiteError("artefacts.hold_public must be true or false")
    if artefact_block.get('serve_local') is not None and artefact_block['serve_local'] not in ('fallback', 'prefer'):
        raise SiteError("artefacts.serve_local must be fallback or prefer")
    site['_trusted_proxies'] = _trusted_proxies(site)
    library = site.get('library') or {}
    site['_deploy_key'] = _abs(library.get('deploy_key'), 'library.deploy_key', False)
    return site


def _trusted_proxies(site: dict) -> list[str]:
    """Ranges Caddy trusts for X-Forwarded-* (tls.trusted_proxies). Unset:
    private_ranges with tls off (an upstream proxy terminates TLS), none
    otherwise. `[]` turns it off explicitly."""
    import ipaddress  # noqa: PLC0415
    raw = site['tls'].get('trusted_proxies')
    if raw is None:
        return ['private_ranges'] if site['tls']['mode'] == 'off' else []
    if isinstance(raw, str):
        raw = raw.split()
    ranges: list[str] = []
    for entry in raw:
        entry = str(entry).strip()
        if entry != 'private_ranges':
            try:
                ipaddress.ip_network(entry, strict=False)
            except ValueError:
                raise SiteError(f"tls.trusted_proxies: {entry!r} is not an IP range "
                                f"(use CIDRs like 10.0.0.0/8 or private_ranges)") from None
        if entry not in ranges:
            ranges.append(entry)
    return ranges


def image_ref(site: dict, which: str) -> str:
    images = site['images']
    if which in ('caddy', 'authelia'):
        return str(images[which])
    registry = str(images.get('registry') or '').rstrip('/')
    name = str(images[which])
    ref = f"{registry}/{name}" if registry else name
    return f"{ref}:{images.get('tag') or 'latest'}"


def stack_dir(site: dict) -> Path:
    return site['_state'] / 'stack'


# ── secrets ──────────────────────────────────────────────────────────────

def _write_secret(path: Path, value: str, overwrite: bool = False) -> bool:
    if path.exists() and not overwrite:
        return False
    path.parent.mkdir(parents=True, exist_ok=True)
    os.chmod(path.parent, 0o700)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, 'w') as handle:
        handle.write(value if value.endswith('\n') else value + '\n')
    return True


def _read_secret(path: Path) -> str | None:
    if not path.exists():
        return None
    return path.read_text().strip() or None


def _users_file(site: dict) -> Path:
    return site['_state'] / 'secrets' / 'users.yaml'


def _load_user_hashes(site: dict) -> dict[str, str]:
    path = _users_file(site)
    if not path.exists():
        return {}
    return yaml.safe_load(path.read_text()) or {}


def _save_user_hashes(site: dict, hashes: dict[str, str]) -> None:
    _write_secret(_users_file(site), yaml.safe_dump(hashes, sort_keys=True), overwrite=True)


def _hash_password(password: str) -> str:
    return bcrypt.hashpw(password.encode(), bcrypt.gensalt(rounds=12)).decode()


def ensure_secrets(site: dict) -> list[str]:
    """Create every missing secret; return the list of files created."""
    state = site['_state']
    created: list[str] = []
    generated = {
        state / 'secrets' / 'internal_secret': secrets.token_hex(32),
        state / 'secrets' / 'mcp_token_secret': secrets.token_hex(32),
        state / 'authelia' / 'secrets' / 'jwt': secrets.token_hex(64),
        state / 'authelia' / 'secrets' / 'session': secrets.token_hex(64),
        state / 'authelia' / 'secrets' / 'storage': secrets.token_hex(32),
    }
    if _central_block(site) is not None:
        # the site secret that signs deposit records (design section 24): made here on the host, bound
        # read-only into the api, so it survives restarts and is the file the watcher host gets a copy of
        generated[state / 'secrets' / DEPOSIT_SITE_SECRET_FILE] = secrets.token_hex(32)
    for path, value in generated.items():
        if _write_secret(path, value):
            created.append(str(path.relative_to(state)))
    hashes = _load_user_hashes(site)
    new_passwords: list[str] = []
    for user in site['auth'].get('users') or []:
        name = str(user['name'])
        if name not in hashes:
            password = secrets.token_urlsafe(18)
            hashes[name] = _hash_password(password)
            new_passwords.append(f"{name}\t{password}")
    if new_passwords:
        _save_user_hashes(site, hashes)
        passwords_file = state / 'secrets' / 'initial-passwords.txt'
        existing = passwords_file.read_text() if passwords_file.exists() else ''
        _write_secret(passwords_file, existing + '\n'.join(new_passwords) + '\n', overwrite=True)
        if not existing:
            created.append('secrets/initial-passwords.txt')
        else:
            _say(f"added {len(new_passwords)} initial password(s) to secrets/initial-passwords.txt")
        for line in new_passwords:
            user, password = line.split('\t')
            _say(f"initial password for {user}: {password}  (also in secrets/initial-passwords.txt)")
    return created


# ── rendering ────────────────────────────────────────────────────────────

def _hostnames(site: dict) -> list[str]:
    names = [site['_public'].hostname] + [str(h) for h in site['site'].get('hostnames') or []]
    seen: list[str] = []
    for name in names:
        if name and name not in seen:
            seen.append(name)
    return seen


def _listen_and_ports(site: dict) -> tuple[str, list[str], str]:
    """(ANTHIVE_LISTEN, published ports, ANTHIVE_AUTO_HTTPS line)."""
    bind = site['ports']['bind']
    mode = site['tls']['mode']
    if mode == 'internal':
        listen = ', '.join(f"https://{name}:{PORT_TLS_INTERNAL}" for name in _hostnames(site))
        return listen, [f"{bind}:{site['ports']['https']}:{PORT_TLS_INTERNAL}"], \
            'auto_https disable_redirects'
    if mode == 'acme':
        return site['_public'].hostname, [f"{bind}:80:80", f"{bind}:443:443"], \
            '# acme: automatic HTTPS with redirects'
    return f"http://:{PORT_PLAIN}", [f"{bind}:{site['ports']['http']}:{PORT_PLAIN}"], \
        'auto_https off'


# The three rendered configs. Each container mounts only its own, so a
# secret is only in the containers that use it:
#   serve   web + mcp: no S3 keys, no chat key
#   api     ant-serve: S3 keys only as s3.api_access allows, the chat key
#   ingest  `ant-stack ingest` and host-side sync: the full S3 keys
CONFIG_ROLES = {'serve': 'anthive.yaml', 'api': 'anthive-api.yaml', 'ingest': 'anthive-ingest.yaml',
                'watcher': 'anthive-watcher.yaml'}
CONFIG_USERS = {'serve': 'web and mcp containers', 'api': 'api container',
                'ingest': 'ingest container and host-side sync',
                'watcher': 'host-side ingest watcher: host paths, full S3 keys, api via the tools listener'}
# Caddy's listener for host-side tools (container port; published on
# 127.0.0.1:<ports.tools> only while services.dataset_deposit is on). It
# drops every identity header, refuses requests without X-Anthive-Internal
# and forwards to the api, which checks the secret: the watcher on the host
# reaches /admin/rescan etc. without a login and nobody else gets in.
PORT_TOOLS = 8079


def config_file(site: dict, role: str) -> Path:
    return stack_dir(site) / CONFIG_ROLES[role]


def _s3_block(site: dict, role: str) -> dict | None:
    """The s3 block for one role, or None when that role gets no S3 access."""
    s3 = site.get('s3') or {}
    if not s3.get('enabled'):
        return None
    access = 'write' if role in ('ingest', 'watcher') else (s3['api_access'] if role == 'api' else 'none')
    if access == 'none':
        return None
    key_id, secret_key = S3_KEY_FILES[access]
    secrets_dir = site['_state'] / 'secrets'
    return {
        'endpoint': s3.get('endpoint'), 'region': s3.get('region') or 'us-east-1',
        'bucket': s3.get('bucket'), 'prefix': s3.get('prefix') or '',
        'use_path_style': bool(s3.get('use_path_style')),
        'access_key_id': _read_secret(secrets_dir / key_id),
        'secret_access_key': _read_secret(secrets_dir / secret_key),
    }


#: The ui: switches of site.yaml (lib/config.UI_SWITCHES): parts of the web UI a site shows.
UI_SWITCHES = ('facets', 'caveats', 'api', 'mcp')


def ui_settings(site: dict) -> dict[str, bool]:
    """site.yaml ui: block with defaults (every part on)."""
    block = site.get('ui') or {}
    return {key: bool(block.get(key, True)) for key in UI_SWITCHES}


def mcp_enabled(site: dict) -> bool:
    """Whether the mcp service runs and Caddy routes /mcp: services.mcp and ui.mcp."""
    return bool((site.get('services') or {}).get('mcp')) and ui_settings(site)['mcp']


def _deposit_enabled(site: dict) -> bool:
    return bool((site.get('services') or {}).get('dataset_deposit')) and bool((site.get('s3') or {}).get('enabled'))


def _artefacts_enabled(site: dict) -> bool:
    """Artefact and collection deposits (site.yaml artefacts.enabled; presigned S3 uploads, so s3.enabled)."""
    return bool((site.get('artefacts') or {}).get('enabled')) and bool((site.get('s3') or {}).get('enabled'))


def _central_block(site: dict) -> dict | None:
    """datasets.central_watcher when it names an ingestion bucket (deposits go to a watcher on another host)."""
    block = (site.get('datasets') or {}).get('central_watcher') or {}
    return block if block.get('ingestion_bucket') else None


def _central_s3_block(site: dict) -> dict | None:
    """datasets_deposit_s3 of a central-watcher site: the ingestion bucket and its own key pair."""
    block = _central_block(site)
    if block is None:
        return None
    s3 = site.get('s3') or {}
    secrets_dir = site['_state'] / 'secrets'
    return {'endpoint': block.get('endpoint') or s3.get('endpoint'),
            'region': block.get('region') or s3.get('region') or 'us-east-1',
            'bucket': block['ingestion_bucket'],
            'use_path_style': bool(block.get('use_path_style') if block.get('use_path_style') is not None
                                   else s3.get('use_path_style')),
            'access_key_id': _read_secret(secrets_dir / S3_INGEST_KEY_FILES[0]),
            'secret_access_key': _read_secret(secrets_dir / S3_INGEST_KEY_FILES[1])}


def _watcher_enabled(site: dict) -> bool:
    """The host-side watcher, its config, the tools listener and the api's presigning key pair: needed by
    dataset deposits and by artefact deposits alike (one watcher publishes both)."""
    return _deposit_enabled(site) or _artefacts_enabled(site)


def _artefacts_read_block(site: dict) -> dict | None:
    """artefacts_s3 of the api config: the read-only pair in secrets/s3_artefacts_read_*, or None."""
    s3 = site.get('s3') or {}
    if not s3.get('enabled'):
        return None
    secrets_dir = site['_state'] / 'secrets'
    key_id, secret = (_read_secret(secrets_dir / name) for name in S3_ARTEFACTS_READ_KEY_FILES)
    if not (key_id and secret):
        return None
    return {'endpoint': s3.get('endpoint'), 'region': s3.get('region') or 'us-east-1', 'bucket': s3.get('bucket'),
            'use_path_style': bool(s3.get('use_path_style')), 'access_key_id': key_id, 'secret_access_key': secret}


def _deposit_key_source(site: dict) -> str | None:
    """'incoming' when the separate presigning pair exists, 'write' when only the read-write pair does, else None."""
    secrets_dir = site['_state'] / 'secrets'
    if all(_read_secret(secrets_dir / name) for name in S3_INCOMING_KEY_FILES):
        return 'incoming'
    if all(_read_secret(secrets_dir / name) for name in S3_KEY_FILES['write']):
        return 'write'
    return None


def watch_prefixes(site: dict) -> tuple[str, str]:
    """(incoming prefix, catalog prefix) the api and the watcher must share. The catalog prefix follows
    ``s3.prefix`` (where ant-sync keeps the catalogue) unless ``datasets.catalog_prefix`` says otherwise."""
    datasets = site.get('datasets') or {}
    incoming = str(datasets.get('incoming_prefix') or '__incoming/').strip().strip('/') + '/'
    raw = datasets.get('catalog_prefix')
    if raw is None:
        raw = (site.get('s3') or {}).get('prefix') or ''
    catalog = str(raw).strip().strip('/')
    return incoming, (catalog + '/') if catalog else ''


def _deposit_s3_block(site: dict) -> dict | None:
    """datasets_deposit_s3 of the api config: the key pair the api presigns deposits with."""
    source = _deposit_key_source(site)
    if source is None:
        return None
    s3 = site.get('s3') or {}
    names = S3_INCOMING_KEY_FILES if source == 'incoming' else S3_KEY_FILES['write']
    secrets_dir = site['_state'] / 'secrets'
    return {'endpoint': s3.get('endpoint'), 'region': s3.get('region') or 'us-east-1', 'bucket': s3.get('bucket'),
            'use_path_style': bool(s3.get('use_path_style')),
            'access_key_id': _read_secret(secrets_dir / names[0]),
            'secret_access_key': _read_secret(secrets_dir / names[1])}


def render_anthive_yaml(site: dict, role: str = 'api') -> dict:
    res = site['resources']
    state = site['_state']
    cfg: dict[str, Any] = {
        'rest_api_host': '0.0.0.0', 'rest_api_port': 8080,
        'browse_host': '0.0.0.0', 'browse_port': 8081,
        'api_url': 'http://api:8080',
        'h5adstore': str(site['_h5adstore']),
        'geneset_store': str(site['_genesetstore']) if site['_genesetstore'] else None,
        # Paper library + literature index (absolute host paths, mounted at the
        # same path). Unset: the API runs without literature features.
        'library': str(site['_library']) if site['_library'] else f"{C_STATE}/no-library",
        'library_index': (str(site['_library_index']) if site['_library_index']
                          else f"{C_STATE}/no-library-index"),
        'state_dir': C_STATE,
        'tmp_dir': f"{C_SCRATCH}/tmp",
        'log_dir': f"{C_SCRATCH}/logs",
        # ant-serve copies INFO lines (warm-up progress) to stderr, so
        # `ant-stack logs api` shows them; the file in log_dir keeps everything.
        'log_stderr_level': 'info',
        'webapp_dir': C_WEBAPP,
        'duckdb_temp_directory': f"{C_SCRATCH}/duckdb_spill",
        'convert_staging_dir': f"{C_SCRATCH}/convert",
        'duckdb_server_threads': int(res['server_threads']),
        'duckdb_server_memory_limit': str(res['server_memory_limit']),
        'duckdb_max_open_databases': int(res['max_open_databases']),
        'duckdb_threads': int(res['convert_threads']),
        'duckdb_memory_limit': str(res['convert_memory_limit']),
        'plot_cache_max_entries': int(res['plot_cache_max_entries']),
        'catalog_scan': str(res['catalog_scan']),
        'coordinate': 'auto',
        'auth': {
            'mode': site['auth']['mode'],
            'admins': [str(a) for a in site['auth'].get('admins') or []],
        },
        'internal_requires_auth': bool(site['auth'].get('internal_requires_auth', True)),
        'mcp': {
            'enabled': mcp_enabled(site),   # personal links on/off (services.mcp and ui.mcp)
            'host': '0.0.0.0', 'port': 8090,
            'public_base_url': site['site']['public_url'].rstrip('/'),
            'plots_dir': f"{C_WEBAPP}/plots",
            'public_url': site['site']['public_url'].rstrip('/'),
            # what the MCP instructions name as its address (not the container's 0.0.0.0:8090)
            'mcp_url': site['site']['public_url'].rstrip('/') + '/mcp',
            'token_ttl_days': int((site.get('mcp') or {}).get('token_ttl_days') or 0),
            'max_links_per_user': int((site.get('mcp') or {}).get('max_links_per_user') or 5),
        },
        'issue_tracker_url': str(site['site'].get('issue_tracker_url') or ''),
    }
    if site['site'].get('docs_base_url'):
        cfg['docs_base_url'] = str(site['site']['docs_base_url'])
    cfg['facets_visible'] = [str(f) for f in (site['site'].get('facets_visible') or [])]
    # parts of the web UI (web, api and mcp read it; harmless for the other roles)
    cfg['ui'] = ui_settings(site)
    lib = site.get('library') or {}
    cfg.update({
        'library_upload_groups': [str(g) for g in (lib.get('upload_groups') or ['admins'])],
        'library_upload_max_pdf_mb': int(lib.get('max_pdf_mb') or 25),
        'library_git_push': bool(lib.get('git_push', False)),
        'library_git_committer': str(lib.get('git_committer') or 'anthive <noreply@anthive.local>'),
        'library_s3_autopush': bool(lib.get('s3_autopush', False)),
        'library_index_publisher': bool(lib.get('index_publisher', False)),
        'library_index_pull': _index_pull_enabled(site),
    })
    cfg['mcp']['max_upload_mb'] = int(lib.get('max_pdf_mb') or 25)
    # Dataset deposits (services.dataset_deposit, datasets: block). Who may deposit
    # goes to every role (the MCP shows its deposit tools by it); the presigning
    # key pair only to the api.
    datasets = site.get('datasets') or {}
    cfg['datasets_upload_groups'] = [str(g) for g in (datasets.get('upload_groups') or ['admins', 'curators'])]
    cfg['datasets_deposit_enabled'] = _deposit_enabled(site)
    cfg['datasets_deposit_site_id'] = str(datasets.get('site_id') or site['site']['name'])
    incoming, catalog = watch_prefixes(site)
    # the api presigns into / reuses from the prefixes the watcher uses: one source for both
    cfg['ingest_watch'] = {'prefix': incoming, 'catalog_prefix': catalog}
    for key in ('max_gb', 'url_ttl_hours', 'max_open_days', 'max_open_per_user', 'max_pending_gb_per_user',
                'update_policy'):
        if datasets.get(key) is not None:
            cfg[f'datasets_deposit_{key}'] = datasets[key]
    central = _central_block(site)
    if central is not None:
        # deposits go to a central watcher on another host (design section 24): records travel signed with
        # the site secret (<state_dir>/secrets/deposit_site_secret, made by ensure_secrets and bound read-only
        # into the api only), results come back signed with the watcher's key; the api presigns into the
        # ingestion bucket with its own key pair. Only the api role gets any of it: web, mcp and ingest
        # never read or create the site secret.
        if role == 'api':
            cfg['datasets_deposit_central_watcher'] = True
            cfg['datasets_deposit_site_key_id'] = str(central.get('key_id') or 'k1')
            cfg['datasets_deposit_watcher_public_keys'] = [str(k) for k in (central.get('watcher_public_keys') or [])]
            cfg['datasets_deposit_catalog_bucket'] = str((site.get('s3') or {}).get('bucket') or '')
            cfg['datasets_deposit_s3'] = _central_s3_block(site)
    elif role == 'api' and _watcher_enabled(site):
        block = _deposit_s3_block(site)
        if block is not None:
            cfg['datasets_deposit_s3'] = block
    # Artefact store (artefacts: block). The switch and the groups go to every role (the MCP shows its
    # deposit tools by them); the read-only key pair only to the api.
    artefact_block = site.get('artefacts') or {}
    cfg['artefacts_enabled'] = _artefacts_enabled(site)
    for key, target in ARTEFACT_SITE_KEYS.items():
        if artefact_block.get(key) is not None:
            cfg[target] = artefact_block[key]
    if role == 'api':
        read_block = _artefacts_read_block(site)
        if read_block is not None:
            cfg['artefacts_s3'] = read_block
    if site['_starcatstore']:
        cfg['starcat_store'] = str(site['_starcatstore'])
    chat_key = _read_secret(state / 'secrets' / 'chat_api_key')
    cfg['chat'] = {
        'enabled': bool(site['services'].get('chat')) and bool(chat_key),
        'api_key': chat_key if role == 'api' else None,
        'history_path': f"{C_STATE}/chat_history.db",
    }
    if site['services'].get('chat') and not chat_key and role == 'api':
        _warn("services.chat is on but secrets/chat_api_key is missing; chat stays off")
    s3_block = _s3_block(site, role)
    if s3_block is not None:
        cfg['s3'] = s3_block
    cfg = _deep_merge(cfg, site.get('anthive') or {})
    if role == 'watcher':
        # The watcher runs on the host: host paths everywhere (the ingest role's
        # /scratch and /var/lib/anthive exist only in containers), the real
        # state_dir (internal secret, deposits.sqlite), and the api through
        # Caddy's tools listener on 127.0.0.1 (http://api:8080 resolves only
        # inside the compose network).
        dirs = watcher_dirs(site)
        cfg.update({
            'state_dir': str(state), 'ingest_state_dir': str(state / 'ingest'),
            'tmp_dir': str(dirs['tmp']), 'log_dir': str(dirs['logs']),
            'convert_staging_dir': str(dirs['convert']), 'ingest_work_dir': str(dirs['work']),
            'duckdb_temp_directory': str(dirs['spill']), 'webapp_dir': str(dirs['webapp']),
            'api_url': watcher_api_url(site),
        })
        if not site['_library']:
            cfg['library'] = str(state / 'no-library')
        if not site['_library_index']:
            cfg['library_index'] = str(state / 'no-library-index')
        cfg['ingest_watch'] = {**cfg['ingest_watch'], 'enabled': True, 'api_url': watcher_api_url(site)}
        cfg['mcp']['plots_dir'] = str(dirs['webapp'] / 'plots')
        cfg['chat']['history_path'] = str(state / 'chat_history.db')
    return cfg


def watcher_env(site: dict) -> dict[str, str]:
    """Environment of the host-side watcher. Every value is also in the watcher
    config; the environment repeats them because env wins over anthive.yaml, so a
    stray ANTHIVE_TMP_DIR from the shell cannot point the watcher at a container path."""
    dirs = watcher_dirs(site)
    incoming, catalog = watch_prefixes(site)
    return {
        'ANTHIVE_CONFIG': str(config_file(site, 'watcher')),
        'ANTHIVE_STATE_DIR': str(site['_state']),
        'ANTHIVE_INGEST_STATE_DIR': str(site['_state'] / 'ingest'),
        'ANTHIVE_INGEST_WORK_DIR': str(dirs['work']),
        'ANTHIVE_TMP_DIR': str(dirs['tmp']),
        'ANTHIVE_LOG_DIR': str(dirs['logs']),
        'ANTHIVE_CONVERT_STAGING_DIR': str(dirs['convert']),
        'ANTHIVE_DUCKDB_TEMP_DIR': str(dirs['spill']),
        'ANTHIVE_API_URL': watcher_api_url(site),
        'ANTHIVE_INGEST_WATCH_PREFIX': incoming,
        'ANTHIVE_INGEST_WATCH_CATALOG_PREFIX': catalog,
    }


def watcher_command(site: dict) -> str:
    """The complete shell command that runs the deposit watcher on the host."""
    import shlex  # noqa: PLC0415
    env = ' '.join(f"{key}={shlex.quote(value) if value else chr(39) * 2}" for key, value in watcher_env(site).items())
    return f"{env} {REPO / 'bin' / 'ingest' / 'ant-ingest-watch'}"


def watcher_dirs(site: dict) -> dict[str, Path]:
    """Host folders of the host-side watcher (under scratch_dir when set, else state_dir/watcher)."""
    base = (site['_scratch'] or site['_state']) / 'watcher'
    return {name: base / name for name in ('tmp', 'logs', 'convert', 'work', 'spill', 'webapp')}


def watcher_api_url(site: dict) -> str:
    return f"http://127.0.0.1:{site['ports']['tools']}"


def render_caddy_tools(site: dict) -> str:
    """Top-level Caddy site block for host-side tools (only with services.dataset_deposit)."""
    head = ("# Rendered by bin/ops/ant-stack. Do not edit; edit site.yaml.\n"
            "# Imported by config/Caddyfile at top level (ANTHIVE_HTTP_REDIRECT_SNIPPET).\n")
    if not _watcher_enabled(site):
        return head + "# no tools listener: services.dataset_deposit and artefacts.enabled are off\n"
    return head + f"""# Listener for host-side tools (the ingest watcher), published on 127.0.0.1:{site['ports']['tools']}.
# Identity headers are dropped; a request without X-Anthive-Internal is refused
# here, a wrong one by the api (401).
http://:{{$ANTHIVE_TOOLS_PORT:{PORT_TOOLS}}} {{
\tbind 0.0.0.0
\t@nosecret not header X-Anthive-Internal *
\trespond @nosecret "X-Anthive-Internal required" 403
\trequest_header -Remote-User
\trequest_header -Remote-Groups
\trequest_header -Remote-Name
\trequest_header -Remote-Email
\trequest_header -X-Remote-User
\trequest_header -X-Remote-Groups
\trequest_header -X-Anthive-Anonymous
\trequest_header -X-Forwarded-User
\treverse_proxy {{$ANTHIVE_API_HOST:api}}:{{$ANTHIVE_API_PORT:8080}}
}}
"""


def render_caddy_mcp(site: dict) -> str:
    """What Caddy's /mcp route does (imported inside `handle /mcp*` through ANTHIVE_MCP_SNIPPET).

    The text of config/caddy-mcp.on (proxy to the mcp service) or caddy-mcp.off (JSON 404,
    no mcp service: services.mcp or ui.mcp false), rendered from this checkout into stack/caddy
    so it does not depend on the Caddy config copied out of the image."""
    which = 'on' if mcp_enabled(site) else 'off'
    head = f"# Rendered by bin/ops/ant-stack from services.mcp and ui.mcp (config/caddy-mcp.{which}).\n"
    return head + (REPO / 'config' / f'caddy-mcp.{which}').read_text()


def render_caddy_auth(site: dict) -> str:
    mode = site['auth']['mode']
    head = f"# Rendered by bin/ops/ant-stack for auth.mode={mode}. Do not edit; edit site.yaml.\n"
    if mode == 'authelia':
        return head + f"import {C_CADDY_CONFIG}/caddy-auth.dev\n"
    if mode == 'trusted-proxy':
        return head + f"import {C_CADDY_CONFIG}/caddy-auth.prod\n"
    if mode == 'none':
        return head + f"import {C_CADDY_CONFIG}/caddy-auth.none\n"
    hashes = _load_user_hashes(site)
    admins = {str(a) for a in site['auth'].get('admins') or []}
    for user in site['auth'].get('users') or []:
        if 'admins' in (user.get('groups') or []):
            admins.add(str(user['name']))
    lines = [head,
             "# Identity comes ONLY from basic_auth: client-sent headers are dropped",
             "# and re-derived from the authenticated user.",
             "# MCP personal links authenticate in ant-mcp (token in the path or",
             "# an `Authorization: Bearer amcp_...` header), not with basic auth.",
             "@anthive_protected {",
             "\tnot path /api/health /health /.well-known/* /register /mcp/u/*",
             "\tnot {",
             "\t\tpath /mcp /mcp/*",
             "\t\theader_regexp Authorization ^Bearer\\s+amcp_",
             "\t}",
             "}",
             "basic_auth @anthive_protected {"]
    for user in site['auth'].get('users') or []:
        name = str(user['name'])
        if name not in hashes:
            raise SiteError(f"no password hash for basic user {name!r}; run `ant-stack init` or `passwd`")
        if not re.fullmatch(r'[A-Za-z0-9._@-]+', name):
            raise SiteError(f"basic user name {name!r} has characters Caddy cannot take")
        lines.append(f"\t{name} {hashes[name]}")
    lines.append("}")
    lines.append("map {http.auth.user.id} {anthive_groups} {")
    for name in sorted(admins):
        lines.append(f"\t{name} admins")
    lines.append('\tdefault ""')
    lines.append("}")
    lines += [
        "request_header Remote-User {http.auth.user.id}",
        "request_header Remote-Groups {anthive_groups}",
        "request_header -Remote-Email",
        "request_header -Remote-Name",
        "request_header -X-Remote-User",
        "request_header -X-Remote-Groups",
    ]
    return '\n'.join(lines) + '\n'


def render_caddy_tls(site: dict) -> str:
    mode = site['tls']['mode']
    if mode == 'internal':
        return "tls internal\n"
    if mode == 'acme':
        return f"tls {site['tls']['acme_email']}\n"
    return "# tls off: plain HTTP behind an upstream TLS proxy\n"


def render_caddy_servers(site: dict) -> str:
    """Global `servers` options: which upstream proxies Caddy believes about
    X-Forwarded-For/-Proto/-Host. Without this, Caddy behind a TLS proxy
    (tls off) overwrites X-Forwarded-Proto with http and Authelia refuses
    the request as insecure."""
    ranges = site['_trusted_proxies']
    head = "# Rendered by bin/ops/ant-stack from tls.trusted_proxies. Do not edit; edit site.yaml.\n"
    if not ranges:
        return head + "# no trusted proxies: X-Forwarded-* from clients is replaced, not believed\n"
    return head + "servers {\n\ttrusted_proxies static " + ' '.join(ranges) + "\n}\n"


