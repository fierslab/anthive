    listen, ports, _ = _listen_and_ports(site)
    print(f"""
  site           {site['site']['name']}  ({site['_path']})
  public_url     {site['site']['public_url']}
  auth           {site['auth']['mode']}   admins: {', '.join(site['auth'].get('admins') or []) or '-'}
  tls            {site['tls']['mode']}    caddy listens: {listen}
  published      {', '.join(ports)}
  h5adstore      {site['_h5adstore']}{' (read-only)' if site['data'].get('readonly') else ''}
  genesetstore   {site['_genesetstore'] or '-'}
  library        {site['_library'] or '-'}
  library_index  {site['_library_index'] or '-'}
  state_dir      {site['_state']}
  scratch        {site['_scratch'] or 'docker volume <site>_scratch'}
  run as         uid {site['_uid']} gid {site['_gid']}
  images         {image_ref(site, 'app')}
                 {image_ref(site, 'ingest')}
  services       api web caddy{' mcp' if site['services'].get('mcp') else ''}{' authelia' if site['auth']['mode'] == 'authelia' else ''}
""")


