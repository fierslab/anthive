                         'default_redirection_url': f"{base}/"}],
        },
        'regulation': {'max_retries': 5, 'find_time': '2 minutes', 'ban_time': '10 minutes'},
        'storage': {'local': {'path': '/config/db.sqlite3'}},
        'notifier': notifier,
    }
    return ("# Rendered by bin/ops/ant-stack from site.yaml. Do not edit; edit site.yaml.\n"
            + yaml.safe_dump(config, sort_keys=False))


def seed_authelia_users(site: dict) -> None:
    """Write users_database.yml once. Authelia owns it afterwards."""
    path = site['_state'] / 'authelia' / 'users_database.yml'
    hashes = _load_user_hashes(site)
    users = {}
    for user in site['auth'].get('users') or []:
        name = str(user['name'])
        if name not in hashes:
            continue
        users[name] = {
            'disabled': False,
            'displayname': user.get('displayname') or name,
            'email': user.get('email') or f"{name}@localhost",
            'groups': list(user.get('groups') or []),
            'password': hashes[name],
        }
    if path.exists():
        current = yaml.safe_load(path.read_text()) or {}
        existing = current.get('users') or {}
        added = {k: v for k, v in users.items() if k not in existing}
        if not added:
            return
        existing.update(added)
        current['users'] = existing
        users_doc = current
    else:
        users_doc = {'users': users}
    _write_secret(path, yaml.safe_dump(users_doc, sort_keys=True), overwrite=True)


def _bind(source: Path | str, target: str, read_only: bool = False) -> dict:
    entry = {'type': 'bind', 'source': str(source), 'target': target}
    if read_only:
        entry['read_only'] = True
    return entry


def _state_mounts(site: dict, secret_names: tuple[str, ...], whole_state: bool) -> tuple[list, list]:
    """(volumes, tmpfs) giving a service the state it needs and nothing more.

    whole_state mounts state_dir read-write (caches, MCP link db) but hides
    secrets/, authelia/ and stack/ behind empty tmpfs mounts owned by the
    site uid; then each named secret file is bound read-only into the empty
    secrets/ folder. Without whole_state only the secrets are there.
    """
    state = site['_state']
    owner = f"uid={site.get('_uid', os.getuid())},gid={site.get('_gid', os.getgid())},mode=0700,size=1m"
    hidden = ('secrets', 'authelia', 'stack') if whole_state else ('secrets',)
    tmpfs = [f"{C_STATE}/{name}:{owner}" for name in hidden]
    volumes = [_bind(state, C_STATE)] if whole_state else []
    volumes += [_bind(state / 'secrets' / name, f"{C_STATE}/secrets/{name}", read_only=True)
                for name in secret_names]
    return volumes, tmpfs


# Services whose container must be recreated when what they read at start
# changes. Their inputs are bind-mounted files (the rendered anthive*.yaml and
# secret files), so compose sees no difference in the service definition when
# only the file content changes; `config_digest` puts that content into the
# environment (ANTHIVE_CONFIG_SHA) so `up` recreates exactly the changed
# services. static, caddy and authelia are force-recreated by `up` instead.
CONFIG_HASHED_SERVICES = ('api', 'web', 'mcp')


def config_digest(volumes: list[dict], read_from=None) -> str:
    """sha256 over the path and content of every bind-mounted regular file
    (rendered config, secret files) in a service's volume list. Folders
    (stores, state_dir) are not hashed: their content is data, not config.
    ``read_from(path)`` names the file to read the content from (the staged
    copy of a live config, so the digest matches the files `up` will put
    in place); the live path is what enters the hash."""
    import hashlib  # noqa: PLC0415
    digest = hashlib.sha256()
    for mount in sorted((m for m in volumes if m.get('type') == 'bind'), key=lambda m: m['target']):
        source = Path(mount['source'])
        content_path = read_from(source) if read_from else source
        if content_path.is_dir():
            continue
        digest.update(f"{mount['target']}\0{source}\0".encode())
        try:
            digest.update(content_path.read_bytes())
        except OSError:
            digest.update(b'<missing>')
        digest.update(b'\0')
    return digest.hexdigest()


def render_compose_site(site: dict, read_from=None) -> dict:
    state = site['_state']
    stack = stack_dir(site)
    h5ad = site['_h5adstore']
    data_rw = [_bind(h5ad, str(h5ad), read_only=bool(site['data'].get('readonly')))]
    data_ro = [_bind(h5ad, str(h5ad), read_only=True)]
    for extra in ('_genesetstore', '_starcatstore'):
        if site[extra]:
            data_rw.append(_bind(site[extra], str(site[extra]), read_only=True))
            data_ro.append(_bind(site[extra], str(site[extra]), read_only=True))
    # data.extra_mounts: targets of symlinks in the stores (a mirror whose
    # datasets and papers link into another site's stores). Read-only, at the
    # same absolute path, in every container that reads data.
    extra_ro = [_bind(path, str(path), read_only=True) for path in site.get('_extra_mounts') or []]
    data_rw += extra_ro
    data_ro += extra_ro
    # Library PDFs + literature index: the API only reads them, unless paper
    # uploads are on (it then writes records, PDFs and the index); the ingest
    # container writes them (`ant sync library`, `ant lib-add`, `ant lib-index`).
    library_ro, library_rw = [], []
    for extra in ('_library', '_library_index'):
        if site[extra]:
            library_ro.append(_bind(site[extra], str(site[extra]), read_only=True))
            library_rw.append(_bind(site[extra], str(site[extra])))
    def config_mount(role: str) -> dict:
        return _bind(config_file(site, role), C_CONFIG, read_only=True)
    state_mount = _bind(state, C_STATE)
    api_secrets = ('internal_secret', 'mcp_token_secret') + ((DEPOSIT_SITE_SECRET_FILE,)
                                                             if _central_block(site) is not None else ())
    api_state, api_tmpfs = _state_mounts(site, api_secrets, whole_state=True)
    mcp_state, mcp_tmpfs = _state_mounts(site, ('internal_secret',), whole_state=False)
    scratch = (_bind(site['_scratch'], C_SCRATCH) if site['_scratch']
               else {'type': 'volume', 'source': 'scratch', 'target': C_SCRATCH})
    webapp_rw = {'type': 'volume', 'source': 'webapp', 'target': C_WEBAPP}
    services: dict[str, Any] = {
        'static': {'volumes': [
            webapp_rw,
            {'type': 'volume', 'source': 'caddy-config', 'target': '/srv/caddy-config'},
        ]},
        'api': {'volumes': data_rw + (library_rw if site.get('services', {}).get('paper_upload') else library_ro)
                + [config_mount('api')] + api_state + [scratch, webapp_rw],
                'tmpfs': api_tmpfs},
        'web': {'volumes': data_ro + [config_mount('serve')]},
        'mcp': {'volumes': extra_ro + [config_mount('serve')] + mcp_state + [webapp_rw], 'tmpfs': mcp_tmpfs},
        # ingest is the operator's own tool: the whole state_dir and the full S3 keys
        'ingest': {'volumes': data_rw + library_rw + [config_mount('ingest'), state_mount, scratch, webapp_rw]},
        'caddy': {
            'ports': _listen_and_ports(site)[1]
                     + ([f"127.0.0.1:{site['ports']['tools']}:{PORT_TOOLS}"] if _watcher_enabled(site) else []),
            'volumes': [_bind(stack / 'caddy', C_CADDY_SNIPPETS, read_only=True)],
            'environment': {'ANTHIVE_HTTP_REDIRECT_SNIPPET': f"{C_CADDY_SNIPPETS}/tools.caddy",
                            # /mcp: proxy to the mcp service, or a JSON 404 when it is off (render_caddy_mcp)
                            'ANTHIVE_MCP_SNIPPET': f"{C_CADDY_SNIPPETS}/mcp.caddy"},
        },
        'authelia': {'volumes': [_bind(state / 'authelia', '/config')]},
    }
    for name in CONFIG_HASHED_SERVICES:
        services[name]['environment'] = {'ANTHIVE_CONFIG_SHA': config_digest(services[name]['volumes'], read_from)}
    doc: dict[str, Any] = {'services': services}
    if not site['_scratch']:
        doc['volumes'] = {'scratch': {}}
    return doc


def staging_dir(site: dict) -> Path:
    """Where `render` writes first (inside stack/, which the containers never see)."""
    return stack_dir(site) / 'staging'


def _config_roles(site: dict) -> dict[str, str]:
    """The config roles this site renders (the watcher config only with deposits on)."""
    return {role: name for role, name in CONFIG_ROLES.items() if role != 'watcher' or _watcher_enabled(site)}


# Files `render` produces, relative to stack/ (configs are 0600 secrets).
def _rendered_files(site: dict) -> list[str]:
    files = list(_config_roles(site).values()) + ['caddy/auth.caddy', 'caddy/tls.caddy', 'caddy/servers.caddy',
                                                  'caddy/tools.caddy', 'caddy/mcp.caddy', 'compose.site.yaml', '.env']
    if site['auth']['mode'] == 'authelia':
        files.append('authelia/configuration.yml')
    return files


def _live_path(site: dict, rel: str) -> Path:
    if rel.startswith('authelia/'):
        return site['_state'] / rel
    return stack_dir(site) / rel


def _atomic_write(path: Path, data: bytes, mode: int = 0o644) -> None:
    """Write ``data`` to a temporary file next to ``path`` and rename it into place."""
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.parent / f".{path.name}.{os.getpid()}.tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
    try:
        with os.fdopen(fd, 'wb') as handle:
            handle.write(data)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    finally:
        if tmp.exists():
            tmp.unlink()


# Files Caddy reads from stack/caddy/ (bind-mounted read-only): readable by every uid, because the
# container's root may be a remapped uid. The 0700 stack/ folder keeps them private on the host.
CADDY_FILE_MODE = 0o644

_STACK_LOCK_DEPTH = {'depth': 0, 'handle': None}


class _stack_lock:
    """flock on <state_dir>/stack/.lock around render and promote (re-entrant within this process),
    so two ant-stack commands never interleave their writes."""

    def __init__(self, site: dict):
        self.path = stack_dir(site) / '.lock'

    def __enter__(self):
        import fcntl  # noqa: PLC0415
        if _STACK_LOCK_DEPTH['depth'] == 0:
            self.path.parent.mkdir(parents=True, exist_ok=True)
            handle = open(self.path, 'a+')
            fcntl.flock(handle, fcntl.LOCK_EX)
            _STACK_LOCK_DEPTH['handle'] = handle
        _STACK_LOCK_DEPTH['depth'] += 1
        return self

    def __exit__(self, *exc):
        _STACK_LOCK_DEPTH['depth'] -= 1
        if _STACK_LOCK_DEPTH['depth'] == 0:
            _STACK_LOCK_DEPTH['handle'].close()
            _STACK_LOCK_DEPTH['handle'] = None
        return False


def staged_changes(site: dict) -> list[str]:
    """Rendered files whose staged content differs from what the running stack uses."""
    staging = staging_dir(site)
    changed = []
    for rel in _rendered_files(site):
        staged, live = staging / rel, _live_path(site, rel)
        if not staged.exists():
            continue
        try:
            if not live.exists() or live.read_bytes() != staged.read_bytes():
                changed.append(rel)
        except OSError:
            changed.append(rel)
    return changed


def promote(site: dict, only: list[str] | None = None) -> list[str]:
    """Put the staged render in place (`init`, `render` and `up`; `passwd` only the auth files).

    Each file is written to a temporary name and renamed into place, under the
    stack lock. Running containers keep the file they mounted; `up` recreates
    the services whose config digest changed."""
    with _stack_lock(site):
        staging = staging_dir(site)
        changed = [rel for rel in staged_changes(site) if only is None or rel in only]
        for rel in _rendered_files(site):
            if only is not None and rel not in only:
                continue
            staged, live = staging / rel, _live_path(site, rel)
            if not staged.exists():
                continue
            _atomic_write(live, staged.read_bytes(), 0o600 if rel in CONFIG_ROLES.values() else CADDY_FILE_MODE)
        if only is None:
            for role, name in CONFIG_ROLES.items():
                if role not in _config_roles(site) and (stack_dir(site) / name).exists():
                    # a watcher config with the full S3 keys must not outlive deposits
                    (stack_dir(site) / name).unlink()
                    changed.append(name)
        if site['auth']['mode'] == 'authelia' and only is None:
            seed_authelia_users(site)
        return changed


def apply_role_config(site: dict, role: str) -> None:
    """Render, then put only ``role``'s config in place (ingest, watcher).

    Those configs are read by on-demand runs (`ingest`, `publish-library`,
    `watch`), never by a running service, so applying them changes nothing
    that runs. Before this, S3 keys written after `init` stayed staged and the
    first `ant-stack ingest -- ant sync pull` of a new site failed with
    "s3.access_key_id is not set"."""
    render(site, quiet=True, apply=False)
    name = CONFIG_ROLES[role]
    if name in _config_roles(site).values():
        promote(site, only=[name])


def render(site: dict, quiet: bool = False, apply: bool = True) -> Path:
    """Render site.yaml into stack/staging/, validate it, and (``apply``) put it in place.

    ``apply=False`` (pull, check, logs, restart; `up` and `passwd` promote
    themselves after their checks, ingest, publish-library and watch apply only
    their own config through ``apply_role_config``) only stages: the
    running stack keeps the config that matches its images until `ant-stack
    up` applies the new one. Before staging existed, `pull` wrote the new
    release's keys into the live config, and an old api that restarted before
    `up` crash-looped on them (2.46.1). With no live render yet (first run)
    the staged one is applied anyway."""
    with _stack_lock(site):
        return _render_locked(site, quiet, apply)


def _render_locked(site: dict, quiet: bool, apply: bool) -> Path:
    state = site['_state']
    stack = stack_dir(site)
    staging = staging_dir(site)
    (staging / 'caddy').mkdir(parents=True, exist_ok=True)
    (stack / 'caddy').mkdir(parents=True, exist_ok=True)
    (state / 'authelia').mkdir(parents=True, exist_ok=True)
    listen, _ports, auto_https = _listen_and_ports(site)

    os.chmod(stack, 0o700)
    os.chmod(staging, 0o700)
    for role, name in CONFIG_ROLES.items():
        if role not in _config_roles(site):
            if (staging / name).exists():
                (staging / name).unlink()   # the live copy goes when the render is applied (promote)
            continue
        header = ("# Rendered by bin/ops/ant-stack from site.yaml. Do not edit: edit\n"
                  "# site.yaml (or its `anthive:` block) and run `ant-stack render`.\n"
                  f"# Role: {role} ({CONFIG_USERS[role]}).\n")
        _atomic_write(staging / name, (header + yaml.safe_dump(render_anthive_yaml(site, role),
                                                                 sort_keys=False)).encode(), 0o600)
    # 0644, not 0600: Caddy runs as root in its container, which is a subordinate uid under docker
    # userns-remap and could not read a 0600 file of the site user. On the host, stack/ is 0700, so
    # nobody else reaches the file (it holds bcrypt hashes in basic mode, nothing in the others).
    _atomic_write(staging / 'caddy' / 'auth.caddy', render_caddy_auth(site).encode(), CADDY_FILE_MODE)
    _atomic_write(staging / 'caddy' / 'tls.caddy', render_caddy_tls(site).encode())
    _atomic_write(staging / 'caddy' / 'servers.caddy', render_caddy_servers(site).encode())
    _atomic_write(staging / 'caddy' / 'tools.caddy', render_caddy_tools(site).encode())
    _atomic_write(staging / 'caddy' / 'mcp.caddy', render_caddy_mcp(site).encode())
    if _watcher_enabled(site):
        for folder in [*watcher_dirs(site).values(), state / 'ingest']:
            try:
                folder.mkdir(parents=True, exist_ok=True)
            except OSError as exc:
                _warn(f"cannot create the watcher folder {folder}: {exc}")
    if site['auth']['mode'] == 'authelia':
        (staging / 'authelia').mkdir(exist_ok=True)
        _atomic_write(staging / 'authelia' / 'configuration.yml', render_authelia(site).encode())

    def read_from(source: Path) -> Path:
        try:
            rel = source.relative_to(stack)
        except ValueError:
            return source
        return staging / rel if not rel.parts or rel.parts[0] != 'staging' else source

    _atomic_write(staging / 'compose.site.yaml', (
        "# Rendered by bin/ops/ant-stack from site.yaml. Do not edit.\n"
        + yaml.safe_dump(render_compose_site(site, read_from), sort_keys=False)).encode())

    profiles = []
    if mcp_enabled(site):
        profiles.append('mcp')
    if site['auth']['mode'] == 'authelia':
        profiles.append('authelia')
    env = {
        'COMPOSE_PROJECT_NAME': site['site']['name'],
        'COMPOSE_PROFILES': ','.join(profiles),
        'ANTHIVE_IMAGE_APP': image_ref(site, 'app'),
        'ANTHIVE_IMAGE_INGEST': image_ref(site, 'ingest'),
        'ANTHIVE_IMAGE_CADDY': image_ref(site, 'caddy'),
        'ANTHIVE_IMAGE_AUTHELIA': image_ref(site, 'authelia'),
        'ANTHIVE_UID': str(site['_uid']),
        'ANTHIVE_GID': str(site['_gid']),
        'ANTHIVE_H5ADSTORE': str(site['_h5adstore']),
        'ANTHIVE_GENESETSTORE': str(site['_genesetstore'] or ''),
        'ANTHIVE_STARCATSTORE': str(site['_starcatstore'] or ''),
        'ANTHIVE_LISTEN': listen,
        'ANTHIVE_AUTO_HTTPS': auto_https,
        'ANTHIVE_DEFAULT_SNI': (f"default_sni {site['_public'].hostname}"
                                if site['tls']['mode'] in ('internal', 'acme') else ''),
    }
    lines = ["# Rendered by bin/ops/ant-stack from site.yaml. Do not edit."]
    for key, value in env.items():
        escaped = value.replace('\\', '\\\\').replace('"', '\\"')
        lines.append(f'{key}="{escaped}"')
    _atomic_write(staging / '.env', ('\n'.join(lines) + '\n').encode())
    for name in _config_roles(site).values():
        _validate_rendered_config(staging / name)
    if apply or not (stack / '.env').exists():
        promote(site)
        if not quiet:
            _say(f"rendered {stack}")
    else:
        pending = staged_changes(site)
        if pending and not quiet:
            _say(f"staged in {staging} (not applied; `ant-stack up` applies it): {', '.join(pending)}")
    return stack


def _validate_rendered_config(path: Path) -> None:
    """Load the rendered config through lib/config so unknown keys fail now."""
    # A ConfigError is printed as its message only (no traceback); anything else as its last line.
    code = ("import sys; sys.path.insert(0, sys.argv[1]); import config\n"
            "try:\n"
            "    cfg = config.load_config(); config.get_auth_settings(cfg)\n"
            "    config.get_coordinate_mode(cfg); config.get_catalog_scan_mode(cfg)\n"
            "    config.get_facets_visible(cfg); config.get_log_stderr_level(cfg); config.get_ui_settings(cfg)\n"
            "except Exception as error:\n"
            "    print(error if isinstance(error, config.ConfigError) else f'{type(error).__name__}: {error}',"
            " file=sys.stderr); sys.exit(3)\n")
    env = {**os.environ, 'ANTHIVE_CONFIG': str(path), 'ANTHIVE_CONFIG_STRICT': '1'}
    result = subprocess.run([sys.executable, '-c', code, str(REPO / 'lib')],
                            env=env, capture_output=True, text=True)
    if result.returncode != 0:
        lines = [line for line in result.stderr.strip().splitlines() if line.strip()]
        message = ' '.join(lines) if result.returncode == 3 else (lines[-1] if lines else 'unknown error')
        raise SiteError(f"rendered {path.name} is invalid: {message}")


# ── docker compose plumbing ─────────────────────────────────────────────

def compose_cmd(site: dict, *args: str) -> list[str]:
    stack = stack_dir(site)
    return ['docker', 'compose', '--project-directory', str(REPO),
            '-p', site['site']['name'], '--env-file', str(stack / '.env'),
            '-f', str(COMPOSE_FILE), '-f', str(stack / 'compose.site.yaml'), *args]


def run_compose(site: dict, *args: str, check: bool = True) -> int:
    cmd = compose_cmd(site, *args)
    result = subprocess.run(cmd)
    if check and result.returncode != 0:
        raise SiteError(f"docker compose {' '.join(args)} failed (exit {result.returncode})")
    return result.returncode


# ── checks ───────────────────────────────────────────────────────────────

def _site_is_up(site: dict) -> bool:
    """True when containers of this site's compose project are running."""
    try:
        result = subprocess.run(
            ['docker', 'ps', '-q', '--filter', f"label=com.docker.compose.project={site['site']['name']}"],
            capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired):
        return False
    return result.returncode == 0 and bool(result.stdout.strip())


def _port_free(bind: str, port: int) -> bool:
    family = socket.AF_INET6 if ':' in bind else socket.AF_INET
    with socket.socket(family, socket.SOCK_STREAM) as sock:
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            sock.bind((bind, port))
            return True
        except OSError:
            return False


def _readable_by(path: Path, uid: int, gid: int) -> bool:
    try:
        info = path.stat()
    except OSError:
        return False
    if uid == 0:
        return True
    mode = info.st_mode
    if info.st_uid == uid:
        return bool(mode & stat.S_IRUSR)
    groups = {gid}
    try:
        user = pwd.getpwuid(uid).pw_name
        groups |= {g.gr_gid for g in grp.getgrall() if user in g.gr_mem}
    except KeyError:
        pass
    if info.st_gid in groups:
        return bool(mode & stat.S_IRGRP)
    return bool(mode & stat.S_IROTH)


# The query-embedding model baked into the app image (docker/Dockerfile);
# the literature index must be built with the same model.
IMAGE_EMBEDDING_MODEL = 'BAAI/bge-small-en-v1.5'


def _check_library(site: dict) -> list[str]:
    """Library + literature index sanity: warnings for what degrades features,
    problems only for what breaks the stack."""
    problems: list[str] = []
    library, index_dir = site['_library'], site['_library_index']
    if library is None:
        if index_dir is not None:
            _warn("data.library_index is set but data.library is not: passages cannot be attributed "
                  "to papers, so literature search returns nothing")
        return problems
    papers = library / 'papers'
    if library.is_dir() and not papers.is_dir():
        _warn(f"{library} has no papers/ folder: is data.library the library repo checkout?")
    elif papers.is_dir() and not any(papers.rglob('*.md')):
        _warn(f"{papers} has no paper records yet (clone the library repo there)")
    if index_dir is None:
        _warn("data.library is set but data.library_index is not: no literature search or "
              "paper passages (set data.library_index and run `ant-stack ingest -- ant sync pull`)")
        return problems
    parquet = index_dir / 'library_chunks.parquet'
    if index_dir.is_dir() and not parquet.is_file():
        if _index_pull_enabled(site):
            _warn(f"{parquet} is missing: run `ant-stack ingest -- ant sync pull --library-only` "
                  f"(or build it with `ant lib-index`)")
        else:
            _warn(f"{parquet} is missing: this site does not pull the shared index; build its own with "
                  f"`ant lib-index --library {library} --out {parquet}` (doc/LIBRARY_INDEX.md)")
    meta_file = index_dir / 'library_chunks.json'
    if parquet.is_file() and meta_file.is_file():
        try:
            import json  # noqa: PLC0415
            model = json.loads(meta_file.read_text()).get('embedding_model')
        except (OSError, ValueError):
            model = None
        if model and model != IMAGE_EMBEDDING_MODEL:
            _warn(f"the literature index was built with {model!r} but the image ships "
                  f"{IMAGE_EMBEDDING_MODEL!r}: semantic search falls back to keyword search "
                  f"(rebuild with `ant lib-index --full`)")
    if papers.is_dir() and not any(papers.rglob('*.pdf')):
        _warn(f"no PDFs under {papers}: run `ant-stack ingest -- ant sync pull --library-only` "
              f"for the paper files")
    if site.get('services', {}).get('paper_upload'):
        uid, gid = site['_uid'], site['_gid']
        if not (library / '.git').exists():
            _warn(f"services.paper_upload is on but {library} is not a git checkout: uploads are "
                  f"written but not committed (clone the library repo there)")
        for target in (library, papers, index_dir):
            if target.is_dir() and not _writable_by(target, uid, gid):
                _warn(f"services.paper_upload is on but {target} is not writable by uid {uid}: "
                      f"uploads will fail (chown it or set run_as)")
    return problems


def _writable_by(path: Path, uid: int, gid: int) -> bool:
    try:
        info = path.stat()
    except OSError:
        return False
    if uid == 0:
        return True
    if info.st_uid == uid:
        return bool(info.st_mode & stat.S_IWUSR)
    groups = {gid}
    try:
        user = pwd.getpwuid(uid).pw_name
        groups |= {g.gr_gid for g in grp.getgrall() if user in g.gr_mem}
    except KeyError:
        pass
    if info.st_gid in groups:
        return bool(info.st_mode & stat.S_IWGRP)
    return bool(info.st_mode & stat.S_IWOTH)


def _check_s3(site: dict) -> list[str]:
    """S3 key files for ingest (always the read-write pair) and for the api
    (none, the read-only pair, or the read-write pair; s3.api_access)."""
    problems: list[str] = []
    s3, state = site['s3'], site['_state']
    library = site.get('library') or {}
    if not s3.get('enabled'):
        if s3['api_access'] != 'none':
            _warn("s3.api_access is set but s3.enabled is false: the api gets no S3 access")
        return problems
    needed = {'write'} | ({s3['api_access']} - {'none'})
    for access in sorted(needed):
        for name in S3_KEY_FILES[access]:
            path = state / 'secrets' / name
            if not path.is_file() or not path.read_text().strip():
                why = ("s3.enabled is true" if access == 'write'
                       else "s3.api_access is read")
                problems.append(f"{why} but {path} is missing or empty (put the key in that file, chmod 600)")
    if library.get('s3_autopush') and s3['api_access'] != 'write':
        _warn("library.s3_autopush is on but s3.api_access is not write: uploaded PDFs reach S3 only "
              "with the next `ant-stack publish-library` (recommended: s3_autopush: false)")
    if s3['api_access'] == 'write':
        _warn("s3.api_access: write gives the api container the read-write S3 keys; prefer read "
              "(a read-only key pair) and `ant-stack publish-library` for uploads")
    extra = site.get('anthive') or {}
    if isinstance(extra.get('s3'), dict) and (extra['s3'].get('access_key_id') or extra['s3'].get('secret_access_key')):
        _warn("the `anthive:` block of site.yaml sets S3 keys: they are copied into EVERY rendered "
              "config (api, web, mcp); put keys in <state_dir>/secrets instead")
    return problems


def _check_datasets(site: dict) -> list[str]:
    """Dataset deposits through the api: one summary line, problems for what cannot work."""
    problems: list[str] = []
    datasets = site.get('datasets') or {}
    groups = ', '.join(datasets.get('upload_groups') or ['admins', 'curators'])
    if not (site.get('services') or {}).get('dataset_deposit'):
        _say("dataset deposits: off (services.dataset_deposit)")
        return problems
    if not (site.get('s3') or {}).get('enabled'):
        problems.append("services.dataset_deposit is on but s3.enabled is false: deposits are presigned S3 uploads")
        return problems
    if site['auth']['mode'] == 'none':
        _warn("services.dataset_deposit is on but auth.mode is none: nobody can deposit (a login is required)")
    central = _central_block(site)
    if central is not None:
        return problems + _check_central(site, central, groups)
    source = _deposit_key_source(site)
    if source is None:
        problems.append(f"services.dataset_deposit is on but neither secrets/{S3_INCOMING_KEY_FILES[0]} (+ "
                        f"{S3_INCOMING_KEY_FILES[1]}) nor the read-write pair exists")
        return problems
    if source == 'write':
        _warn(f"dataset deposits presign with the read-write S3 keys, so the api container holds them; put a key "
              f"pair limited to the incoming prefix in secrets/{S3_INCOMING_KEY_FILES[0]} and "
              f"{S3_INCOMING_KEY_FILES[1]} if the object store can scope keys")
    s3 = site.get('s3') or {}
    site_id = datasets.get('site_id') or site['site']['name']
    _warn(f"dataset deposits stage uploads in s3://{s3.get('bucket')}/__deposits/{site_id}/ and the watcher reads "
          f"__incoming/ of that bucket: another site on the same bucket must have a different site name "
          f"(datasets.site_id) and must not run a watcher on the same incoming prefix")
    _say("dataset deposits: give the bucket a lifecycle rule AbortIncompleteMultipartUpload (e.g. after 8 days) "
         "for __deposits/ and __incoming/, so multipart uploads nobody completes do not keep storage "
         "(doc/DEPLOY_CONTAINERS.md)")
    incoming, catalog = watch_prefixes(site)
    secret = site['_state'] / 'secrets' / 'internal_secret'
    _say(f"dataset deposits: on for {groups}; presigning with the {'read-write' if source == 'write' else source} "
         f"key pair")
    _say(f"dataset deposits: run the watcher on this host as uid {site['_uid']}: `bin/ops/ant-stack watch` (systemd: "
         f"config/examples/anthive-ingest-watch-stack.service.example), which is the same as:\n"
         f"    {watcher_command(site)}\n"
         f"  it reaches the api at {watcher_api_url(site)} (Caddy's tools listener, ports.tools) with the internal "
         f"secret {secret}, shares {site['_state'] / 'ingest'} with the api and watches {incoming!r}")
    if secret.is_file() and not _readable_by(secret, site['_uid'], site['_gid']):
        problems.append(f"{secret} is not readable by uid {site['_uid']}: the watcher cannot call the api")
    watcher_config = datasets.get('watcher_config')
    if watcher_config:
        path = Path(str(watcher_config)).expanduser()
        try:
            block = (yaml.safe_load(path.read_text()) or {}).get('ingest_watch') or {}
        except (OSError, yaml.YAMLError) as exc:
            problems.append(f"datasets.watcher_config {path} cannot be read: {exc}")
            return problems
        theirs = (str(block.get('prefix') or '__incoming/').strip('/') + '/',
                  (str(block.get('catalog_prefix') or '').strip('/') + '/') if str(block.get('catalog_prefix') or '').strip('/') else '')
        if theirs != (incoming, catalog):
            problems.append(f"the watcher config {path} uses prefix {theirs[0]!r} and catalog_prefix {theirs[1]!r}, "
                            f"the api {incoming!r} and {catalog!r}: deposits would never be seen or reused; make "
                            f"them equal (datasets.incoming_prefix / datasets.catalog_prefix)")
    return problems


def _check_central(site: dict, central: dict, groups: str) -> list[str]:
    """A site whose deposits a central watcher on another host ingests (design section 24)."""
    problems: list[str] = []
    secrets_dir = site['_state'] / 'secrets'
    missing = [name for name in S3_INGEST_KEY_FILES if not _read_secret(secrets_dir / name)]
    if missing:
        problems.append(f"datasets.central_watcher is set but secrets/{' and secrets/'.join(missing)} are missing: "
                        f"the key pair of the ingestion bucket {central['ingestion_bucket']!r}")
    if not central.get('watcher_public_keys'):
        problems.append("datasets.central_watcher.watcher_public_keys is empty: the site cannot check the "
                        "watcher's results (run `ant ingest-watch result-key` on the watcher host)")
    site_id = (site.get('datasets') or {}).get('site_id') or site['site']['name']
    secret = secrets_dir / DEPOSIT_SITE_SECRET_FILE
    _say(f"dataset deposits: on for {groups}, ingested by the central watcher: uploads and signed records in "
         f"s3://{central['ingestion_bucket']}/__deposits/{site_id}/ (the watcher copies them into __incoming/; "
         f"scope this site's key pair to that folder where the store can); do not run `ant-stack watch` on this "
         f"host")
    if secret.is_file():
        _say(f"dataset deposits: give the watcher host the site secret: a file <sites_dir>/{site_id}.keys "
             f"(mode 600, owned by the watcher's user) with the line \"{central.get('key_id') or 'k1'} "
             f"<contents of {secret}>\"")
    else:
        problems.append(f"datasets.central_watcher is set but the site secret {secret} is missing: run "
                        f"`ant-stack up` (or init), which creates it on the host; then copy it to the watcher host "
                        f"as <sites_dir>/{site_id}.keys (mode 600), line \"{central.get('key_id') or 'k1'} <secret>\"")
    _say("dataset deposits: approve, reject and purges happen on the central watcher host; this api shows the "
         "results and e-mails its depositors")
    return problems


def _check_artefacts(site: dict) -> list[str]:
    """The artefact store (doc/DESIGN_artefacts.md): deposits, the read key pair, the redirect log filter and
    the h5adstore's .gitignore. One summary line; problems only for what cannot work."""
    problems: list[str] = []
    block = site.get('artefacts') or {}
    s3 = site.get('s3') or {}
    secrets_dir = site['_state'] / 'secrets'
    present = [bool(_read_secret(secrets_dir / name)) for name in S3_ARTEFACTS_READ_KEY_FILES]
    if any(present) and not all(present):
        problems.append(f"only one of secrets/{S3_ARTEFACTS_READ_KEY_FILES[0]} and {S3_ARTEFACTS_READ_KEY_FILES[1]} "
                        f"exists: give both (the artefact read key pair) or neither")
    caddyfile = REPO / 'config' / 'Caddyfile'
    try:
        if 'resp_headers>Location' not in caddyfile.read_text():
            problems.append(f"{caddyfile} has no log filter for the Location header: signed artefact and download "
                            f"URLs would be written to the access log")
    except OSError:
        pass
    if not block.get('enabled'):
        _say("artefact deposits: off (artefacts.enabled); the artefact read routes serve what the store holds")
    elif not s3.get('enabled'):
        problems.append("artefacts.enabled is on but s3.enabled is false: artefact deposits are presigned S3 uploads")
    else:
        if site['auth']['mode'] == 'none':
            _warn("artefacts.enabled is on but auth.mode is none: nobody can deposit artefacts (a login is required)")
        source = _deposit_key_source(site)
        if source is None:
            problems.append(f"artefacts.enabled is on but neither secrets/{S3_INCOMING_KEY_FILES[0]} (+ "
                            f"{S3_INCOMING_KEY_FILES[1]}) nor the read-write pair exists for presigning")
        elif not _deposit_enabled(site):        # the dataset check says these two otherwise
            if source == 'write':
                _warn(f"artefact deposits presign with the read-write S3 keys, so the api container holds them; "
                      f"put a key pair limited to the incoming prefixes in secrets/{S3_INCOMING_KEY_FILES[0]} "
                      f"and {S3_INCOMING_KEY_FILES[1]} if the object store can scope keys")
            _say("artefact deposits: give the bucket a lifecycle rule AbortIncompleteMultipartUpload for __deposits/ "
                 "and __incoming/ (doc/DEPLOY_CONTAINERS.md)")
        groups = block.get('upload_groups') or ['admins', 'analysts']
        _say(f"artefact deposits: on for {', '.join(groups)} (collections: "
             f"{', '.join(block.get('collections_create_groups') or ['admins', 'analysts'])}); the same watcher "
             f"publishes them: `bin/ops/ant-stack watch`")
        if site['auth']['mode'] == 'basic':
            _warn("auth.mode basic has no groups: only auth.admins can deposit artefacts and create collections")
        elif site['auth']['mode'] == 'authelia' and any(group not in ('admins',) for group in groups):
            _say(f"artefact deposits: put depositors in the Authelia group(s) {', '.join(g for g in groups if g != 'admins')} "
                 f"(authelia/users_database.yml, or auth.users[].groups before the first init)")
    if s3.get('enabled'):
        if all(present):
            _say("artefact files: served by signed links made with the read-only pair secrets/s3_artefacts_read_*")
        elif s3.get('api_access') in ('read', 'write'):
            _say(f"artefact files: served by signed links made with the api's {s3['api_access']} key pair "
                 f"(a separate read-only pair in secrets/{S3_ARTEFACTS_READ_KEY_FILES[0]} is preferred)")
        else:
            _warn(f"artefact files: the api has no S3 read key (s3.api_access: none, no secrets/"
                  f"{S3_ARTEFACTS_READ_KEY_FILES[0]}): only files with a local copy (figures, small files) can be "
                  f"downloaded")
    store = site['_h5adstore']
    gitignore = store / '.gitignore' if store else None
    if gitignore is not None and (store / '.git').exists():
        try:
            text = gitignore.read_text() if gitignore.is_file() else ''
        except OSError:
            text = ''
        missing = [pattern for pattern in ('static/artefacts/**/files/', 'static/artefacts/**/preview/')
                   if pattern not in text]
        if missing:
            _warn(f"{gitignore} lacks {', '.join(missing)}: a hand `git add -A` in the h5adstore would commit "
                  f"artefact files (the watcher commits only head records and manifests)")
    return problems


def _loose_permissions(path: Path) -> bool:
    try:
        return bool(path.stat().st_mode & 0o077)
    except OSError:
        return False


def secret_files(site: dict) -> list[Path]:
    """Every file ant-stack knows holds a secret: key files, the user
    database, Authelia's secrets, the rendered configs and the deploy key."""
    state = site['_state']
    files: list[Path] = []
    for folder in (state / 'secrets', state / 'authelia' / 'secrets'):
        if folder.is_dir():
            files += sorted(p for p in folder.iterdir() if p.is_file())
    files.append(state / 'authelia' / 'users_database.yml')
    files += [config_file(site, role) for role in CONFIG_ROLES]      # missing ones are dropped below
    if site.get('_deploy_key'):
        files.append(site['_deploy_key'])
    return [p for p in files if p.exists()]


def _check_secret_permissions(site: dict) -> list[str]:
    """Warn about secret files and folders that group or others can read.
    Returns the offending paths (for tests)."""
    loose: list[str] = []
    state = site['_state']
    for folder in (state / 'secrets', state / 'authelia' / 'secrets', state / 'stack'):
        if folder.is_dir() and _loose_permissions(folder):
            loose.append(str(folder))
            _warn(f"{folder} is open to group or others (chmod 700 {folder})")
    for path in secret_files(site):
        if _loose_permissions(path):
            loose.append(str(path))
            _warn(f"{path} holds a secret and is readable by group or others (chmod 600 {path})")
    return loose


def _check_proxy_trust(site: dict) -> None:
    ranges = site['_trusted_proxies']
    bind = site['ports']['bind']
    if ranges and bind not in ('127.0.0.1', '::1'):
        _warn(f"tls.trusted_proxies ({' '.join(ranges)}) with ports.bind {bind}: any host in those "
              f"ranges that reaches the port can set X-Forwarded-For/-Proto; bind 127.0.0.1 when the "
              f"proxy runs on this host, or narrow tls.trusted_proxies to the proxy's address")
    if site['tls']['mode'] == 'off' and not ranges and site['auth']['mode'] == 'authelia':
        _warn("tls off with authelia and no tls.trusted_proxies: Caddy replaces the proxy's "
              "X-Forwarded-Proto with http and Authelia refuses logins as insecure")


def _index_pull_enabled(site: dict) -> bool:
    """True when `ant sync` may download the shared literature index: S3 is on
    and library.index_pull is not false. A site with its own index never pulls."""
    return bool((site.get('s3') or {}).get('enabled')) and bool((site.get('library') or {}).get('index_pull', True))


def _is_within(path: Path, parent: Path) -> bool:
    """True when ``path`` equals ``parent`` or sits below it (lexical, after resolving)."""
    try:
        path.resolve().relative_to(parent.resolve())
        return True
    except ValueError:
        return False


def _check_extra_mounts(site: dict) -> list[str]:
    """data.extra_mounts: each must exist, stay out of state_dir (and not
    contain it: the secrets would be exposed), and should not overlap the
    other mounts (overlap is only a warning, docker allows nested mounts)."""
    problems: list[str] = []
    mounts = site.get('_extra_mounts') or []
    state = site['_state']
    others = [(field, site[key]) for field, key in (
        ('data.h5adstore', '_h5adstore'), ('data.genesetstore', '_genesetstore'),
        ('data.starcatstore', '_starcatstore'), ('data.library', '_library'),
        ('data.library_index', '_library_index')) if site.get(key)]
    for index, mount in enumerate(mounts):
        field = f"data.extra_mounts[{index}]"
        if not mount.exists():
            problems.append(f"{field}: {mount} does not exist")
            continue
        if _is_within(mount, state):
            problems.append(f"{field}: {mount} is inside state_dir {state} (secrets live there)")
        elif _is_within(state, mount):
            problems.append(f"{field}: {mount} contains state_dir {state}; mounting it would expose the secrets")
        for other_field, other in others:
            if _is_within(mount, other) or _is_within(other, mount):
                _warn(f"{field}: {mount} overlaps {other_field} {other}; the mounts are nested, "
                      f"check that is intended (extra mounts are read-only)")
        for other_index, other in enumerate(mounts[:index]):
            if _is_within(mount, other) or _is_within(other, mount):
                _warn(f"{field}: {mount} overlaps data.extra_mounts[{other_index}] {other}")
    return problems


def _symlink_targets_outside_mounts(site: dict, limit: int = 2000) -> list[tuple[Path, Path]]:
    """(link, target) for symlinks in the stores and the library whose
    target is not below any mounted path: in the containers they dangle."""
    roots = [site[key] for key in ('_h5adstore', '_genesetstore', '_starcatstore', '_library', '_library_index')
             if site.get(key)] + list(site.get('_extra_mounts') or [])
    resolved_roots = [root.resolve() for root in roots if root.exists()]
    found: list[tuple[Path, Path]] = []
    seen = 0
    for root in [site[key] for key in ('_h5adstore', '_genesetstore', '_starcatstore', '_library')
                 if site.get(key) and site[key].is_dir()]:
        for current, dirs, files in os.walk(root):
            dirs[:] = [name for name in dirs if name not in ('.git', 'static')]
            for name in dirs + files:
                link = Path(current) / name
                if not link.is_symlink():
                    continue
                seen += 1
                if seen > limit:
                    return found
                target = Path(os.path.realpath(link))
                if not any(_is_within(target, root_) for root_ in resolved_roots):
                    found.append((link, target))
    return found


def _check_symlinks(site: dict) -> None:
    """Warn about store/library symlinks that dangle inside the containers."""
    outside = _symlink_targets_outside_mounts(site)
    if not outside:
        return
    parents = sorted({str(target.parent) for _link, target in outside})[:5]
    link, target = outside[0]
    _warn(f"{len(outside)} symlink(s) in the stores/library point outside every mounted path and "
          f"will dangle in the containers (first: {link} -> {target}); add their target folder(s) "
          f"to data.extra_mounts, e.g. {', '.join(parents)}")


def _check_uv() -> None:
    """Host-side tools (ant-stack, ant-sync) start with a `uv` shebang. Say
    where uv is, and warn when it is only reachable through a PATH that cron
    or systemd will not have."""
    uv = shutil.which('uv')
    if uv is None:
        _warn("uv was not found on PATH: ant-stack and ant-sync (`#!/usr/bin/env -S uv run`) cannot "
              "start without it. Install it (https://docs.astral.sh/uv/) or, in a cron job or systemd "
              "unit, set PATH=$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin "
              "(see config/examples/anthive-sync.cron.example)")
        return
    minimal = shutil.which('uv', path='/usr/local/bin:/usr/bin:/bin')
    if minimal is None:
        _say(f"uv is {uv}: cron/systemd jobs need PATH to include {Path(uv).parent} "
             f"(templates in config/examples/ set it)")


def _check_caddy_readable(site: dict) -> None:
    """Warn when Caddy may not read a file of its mounted snippet folder: in its container it runs as
    root, which under docker userns-remap is a subordinate uid that only gets the 'other' permissions."""
    folder = stack_dir(site) / 'caddy'
    if not folder.is_dir():
        return
    problems = []
    if (folder.stat().st_mode & 0o005) != 0o005:
        problems.append(f"{folder} (folder needs o+rx)")
    for path in sorted(p for p in folder.iterdir() if p.is_file()):
        if not path.stat().st_mode & 0o004:
            problems.append(str(path))
    if problems:
        _warn("Caddy may not be able to read " + ', '.join(problems) + " (under docker userns-remap its root is "
              "another uid); run `ant-stack render` to reset the modes")


def _check_publish_library(site: dict) -> None:
    key = site.get('_deploy_key')
    library = site.get('library') or {}
    if key is None:
        if site.get('services', {}).get('paper_upload') and not library.get('git_push'):
            _warn("services.paper_upload is on but library.deploy_key is not set: uploads stay in "
                  "this checkout until someone pushes; set the key and run `ant-stack publish-library` "
                  "from a timer (doc/DEPLOY_CONTAINERS.md, \"Let people add papers\")")
        return
    if not key.is_file():
        _warn(f"library.deploy_key {key} does not exist: `ant-stack publish-library` cannot push")
    if site['_library'] is None:
        _warn("library.deploy_key is set but data.library is not: nothing to publish")


def check(site: dict, running: bool = False) -> list[str]:
    problems: list[str] = list(site.get('_key_problems') or [])
    for warning in site.get('_key_warnings') or []:
        _warn(warning)
    if not shutil.which('docker'):
        problems.append("docker is not installed or not on PATH")
    else:
        result = subprocess.run(['docker', 'compose', 'version', '--short'],
                                capture_output=True, text=True)
        if result.returncode != 0:
            problems.append("docker compose v2 plugin not available")
    uid, gid = site['_uid'], site['_gid']
    for field, path in (('data.h5adstore', site['_h5adstore']),
                        ('data.genesetstore', site['_genesetstore']),
                        ('data.starcatstore', site['_starcatstore']),
                        ('data.library', site['_library']),
                        ('data.library_index', site['_library_index'])):
        if path is None:
            continue
        if not path.is_dir():
            problems.append(f"{field}: {path} is not a directory")
        elif not _readable_by(path, uid, gid):
            problems.append(f"{field}: {path} is not readable by uid {uid}")
    if site['_h5adstore'] and site['_h5adstore'].is_dir() and not site['data'].get('readonly'):
        if not os.access(site['_h5adstore'], os.W_OK):
            problems.append(f"data.h5adstore {site['_h5adstore']} is not writable (set data.readonly: true "
                            f"for a read-only mirror)")
    state = site['_state']
    if not state.is_dir():
        problems.append(f"state_dir {state} does not exist (run `ant-stack init`)")
    else:
        if state.stat().st_uid != uid:
            problems.append(f"state_dir {state} is owned by uid {state.stat().st_uid}, containers run as {uid}")
        if state.stat().st_mode & 0o077:
            problems.append(f"state_dir {state} is readable by others (chmod 700)")
        for secret in ('secrets/internal_secret', 'secrets/mcp_token_secret'):
            if not (state / secret).exists():
                problems.append(f"missing {secret} (run `ant-stack init`)")
        if site['auth']['mode'] == 'authelia':
            for secret in ('jwt', 'session', 'storage'):
                if not (state / 'authelia' / 'secrets' / secret).exists():
                    problems.append(f"missing authelia/secrets/{secret} (run `ant-stack init`)")
    problems += _check_s3(site)
    problems += _check_datasets(site)
    problems += _check_artefacts(site)
    _check_secret_permissions(site)
    _check_proxy_trust(site)
    store = site['_h5adstore']
    if store and store.is_dir():
        mds = [resolved for _item, resolved, _rel in _catalog_dataset_mds(store)]
        if not mds:
            # One line for an empty store (the internal-access count stays silent then).
            _warn(f"no datasets yet: {store} has no dataset .md files, so the catalog is empty "
                  f"(clone the h5adstore repo there, see doc/DEPLOY_CONTAINERS.md)")
        else:
            missing = [p for p in mds if not p.with_suffix('.duckdb').exists()]
            if missing:
                remote = (site['s3'].get('enabled') and site['s3']['api_access'] != 'none')
                _warn(f"{len(missing)} of {len(mds)} datasets have no local .duckdb: they are "
                      + ("served from S3 (slow)" if remote else
                         "not served (the api has no S3 access, s3.api_access: none)")
                      + "; pull them with `ant-stack ingest -- ant sync pull --include-duckdb` (on a site with "
                        "sync_policy.mode: priority: `ant-stack ingest -- ant sync pull`)")
    _check_caddy_readable(site)
    problems += _check_extra_mounts(site)
    _check_symlinks(site)
    problems += _check_library(site)
    _check_publish_library(site)
    _check_uv()
    if site['_scratch'] and not site['_scratch'].is_dir():
        problems.append(f"scratch_dir {site['_scratch']} does not exist")
    if not running and _site_is_up(site):
        _say("the site's own containers are running: skipping the free-port check")
        running = True
    if not running:
        _listen, ports, _ = _listen_and_ports(site)
        if _watcher_enabled(site):
            ports = ports + [f"127.0.0.1:{site['ports']['tools']}:{PORT_TOOLS}"]
        for spec in ports:
            bind, host_port, _container = spec.rsplit(':', 2)
            if not _port_free(bind, int(host_port)):
                problems.append(f"host port {bind}:{host_port} is already in use "
                                "(by another program; if it is this site, use `check --running`)")
    for which in ('app', 'ingest'):
        ref = image_ref(site, which)
        result = subprocess.run(['docker', 'image', 'inspect', ref], capture_output=True)
        if result.returncode != 0:
            problems.append(f"image {ref} not present locally (`ant-stack pull` or `ant-stack build`)"
                            + (" [ingest image only needed for `ant-stack ingest`]" if which == 'ingest' else ''))
    if site['auth']['mode'] == 'authelia':
        import ipaddress  # noqa: PLC0415
        from urllib.parse import urlparse  # noqa: PLC0415
        host = urlparse(str(site['site'].get('public_url') or '')).hostname or ''
        try:
            ipaddress.ip_address(host)
            is_ip = True
        except ValueError:
            is_ip = False
        if not is_ip and '.' not in host:
            problems.append(f"auth.mode authelia needs a public_url host with a dot or an IP address "
                            f"(cookie rule); {host!r} is refused by Authelia. Use e.g. "
                            f"https://anthive.example.org or https://127.0.0.1:<port>")
        if not str(site['site'].get('public_url') or '').startswith('https://'):
            problems.append("auth.mode authelia needs an https:// public_url (Authelia refuses plain-HTTP cookies)")
    if site['auth']['mode'] == 'none':
        _warn("auth.mode none: NO LOGIN. Admin features are off and only access: public datasets are "
              "served (unless auth.internal_requires_auth is false).")
    _check_internal_access(site)
    _check_ui(site)
    if site['auth']['mode'] == 'trusted-proxy' and site['ports']['bind'] not in ('127.0.0.1', '::1'):
        problems.append("auth.mode trusted-proxy trusts identity headers: ports.bind must be 127.0.0.1")
    return problems


def _check_ui(site: dict) -> None:
    """Say which parts of the web UI are off and what that means."""
    ui = ui_settings(site)
    off = [key for key, on in ui.items() if not on]
    if not off:
        return
    _say(f"ui: switched off: {', '.join(off)}")
    if not ui['mcp'] and (site.get('services') or {}).get('mcp'):
        _warn("ui.mcp is false: the mcp service is not started and /mcp answers 404, although "
              "services.mcp is true (set services.mcp: false to say so)")
    if not ui['caveats']:
        _warn("ui.caveats is false: caveats carry data-quality warnings (curation decisions, known "
              "defects such as a broken embedding); visitors of this site will not see them. The REST "
              "API still serves them.")
    if not ui['api']:
        _say("ui.api is false: no API page, API links or notebook buttons; /api/docs and /api/redoc "
             "answer 404 to visitors who are not signed in. The REST API itself stays (the web UI, "
             "vark and pyvark use it).")


def _catalog_dataset_mds(store: Path):
    """The dataset .md files of a store as ant-serve's catalog scan sees them (lib/h5adstore.py)."""
    if str(REPO / 'lib') not in sys.path:
        sys.path.insert(0, str(REPO / 'lib'))
    from h5adstore import catalog_dataset_mds  # noqa: PLC0415  (pure python, yaml only)
    return catalog_dataset_mds(store)


def _internal_dataset_count(store: Path) -> tuple[int, int]:
    """(datasets whose resolved annotation is not access: public, all datasets) of an h5adstore."""
    if str(REPO / 'lib') not in sys.path:
        sys.path.insert(0, str(REPO / 'lib'))
    import mus  # noqa: PLC0415  (lib/mus.py: pure python, yaml only)
    total = internal = 0
    for _item, md, rel in _catalog_dataset_mds(store):
        if any(part.startswith('.') for part in rel.parts):
            continue
        total += 1
        try:
            access = mus.resolve_annotation(md.with_suffix('.h5ad'), root=store).get('access')
        except Exception:  # noqa: BLE001 - an unreadable sidecar counts as not public, like ant-serve
            access = None
        if str(access or '').strip().lower() != 'public':
            internal += 1
    return internal, total


def internal_access_summary(site: dict, internal: int, total: int) -> tuple[str, str | None]:
    """(the line `check` always prints, a warning for the risky combinations or None).

    Risky: internal datasets reaching callers without a login
    (auth.internal_requires_auth false), or trusted-proxy mode where the
    upstream proxy decides who is signed in."""
    mode = site['auth']['mode']
    requires_auth = bool(site['auth'].get('internal_requires_auth', True))
    head = f"{internal} of {total} datasets are internal"
    if not total:
        return "", None          # check already warned "no datasets yet"
    if not internal:
        return f"{head}: every dataset is access: public", None
    if not requires_auth:
        if mode == 'none':
            return (f"{head}: served to ANYONE (auth.mode none, auth.internal_requires_auth false)",
                    f"auth.internal_requires_auth is false on a site WITHOUT login: {internal} of {total} "
                    f"datasets are not access: public and are served to anyone. Set it to true, or keep only "
                    f"public datasets in data.h5adstore.")
        return (f"{head}: also served to callers without an identity (auth.internal_requires_auth false)",
                f"auth.internal_requires_auth is false: {internal} internal datasets are also served to callers "
                f"without an identity (an MCP without personal links, a direct call to the api container).")
    if mode == 'none':
        return f"{head}: hidden on this site (auth.mode none, no login)", None
    if mode == 'trusted-proxy':
        return (f"{head}: visible only to callers the upstream proxy signs in (Remote-User)",
                f"auth.mode trusted-proxy: {internal} internal datasets are served whenever the upstream proxy "
                f"sends Remote-User. A public vhost must drop Remote-User/Remote-Groups "
                f"(config/examples/nginx-vhost.public.conf.example).")
    return f"{head}: visible only to signed-in users", None


def _check_internal_access(site: dict) -> None:
    """Print how many datasets are internal and who sees them (lib/dataset_access.py);
    warn when they could reach people without a login."""
    store = site['_h5adstore']
    if not store or not store.is_dir():
        return
    internal, total = _internal_dataset_count(store)
    line, warning = internal_access_summary(site, internal, total)
    if line:
        _say(line)
    if warning:
        _warn(warning)


def published_summary(site: dict) -> str:
    """The host address(es) docker publishes Caddy on, with the container port,
    e.g. `127.0.0.1:8443 (host) -> :8443 (caddy)`."""
    parts = []
    for spec in _listen_and_ports(site)[1]:
        bind, host_port, container_port = spec.rsplit(':', 2)
        host = f"[{bind}]" if ':' in bind else bind
        parts.append(f"{host}:{host_port} (host) -> :{container_port} (caddy)")
    return ', '.join(parts)


def _admins_summary(site: dict) -> str:
    """The admins part of the plan line; none on auth.mode none (nobody signs in, so nobody is an admin)."""
    if site['auth']['mode'] == 'none':
        return 'no admins (nobody signs in on auth.mode none)'
    return f"admins: {', '.join(site['auth'].get('admins') or []) or '-'}"


def print_plan(site: dict) -> None:
    listen, _ports, _ = _listen_and_ports(site)
    print(f"""
  site           {site['site']['name']}  ({site['_path']})
  public_url     {site['site']['public_url']}
  auth           {site['auth']['mode']}   {_admins_summary(site)}
  tls            {site['tls']['mode']}
  caddy          (in container): {listen}
  trusted proxy  {' '.join(site['_trusted_proxies']) or '-'}
  s3             {('on, api access: ' + site['s3']['api_access']) if site['s3'].get('enabled') else 'off'}
  deposits       {('on for ' + ', '.join((site.get('datasets') or {}).get('upload_groups') or ['admins', 'curators'])) if _deposit_enabled(site) else 'off'}
  artefacts      {('deposits on for ' + ', '.join((site.get('artefacts') or {}).get('upload_groups') or ['admins', 'analysts'])) if _artefacts_enabled(site) else 'deposits off'}
  published      {published_summary(site)}
  h5adstore      {site['_h5adstore']}{' (read-only)' if site['data'].get('readonly') else ''}
