def cmd_init(args: argparse.Namespace) -> int:
    path = site_path(args)
    if not path.exists():
        shutil.copyfile(EXAMPLE, path)
        os.chmod(path, 0o640)
        _say(f"wrote {path} from site.example.yaml: edit it, then run `ant-stack init` again")
        return 0
    site = load_site(path)
    state = site['_state']
    state.mkdir(parents=True, exist_ok=True)
    os.chmod(state, 0o700)
    for sub in ('secrets', 'authelia', 'stack'):
        (state / sub).mkdir(exist_ok=True)
    created = ensure_secrets(site)
    for item in created:
        _say(f"created {item}")
    render(site)
    _say("init done; next: `ant-stack check`")
    return 0


def cmd_check(args: argparse.Namespace) -> int:
    site = load_site(site_path(args))
    render(site, quiet=True)
    print_plan(site)
    problems = check(site, running=args.running)
    for problem in problems:
        print(f"  PROBLEM  {problem}")
    if problems:
        return 1
    print("  OK: ready for `ant-stack up`")
    return 0


def cmd_render(args: argparse.Namespace) -> int:
    site = load_site(site_path(args))
    render(site)
    return 0


def cmd_up(args: argparse.Namespace) -> int:
    site = load_site(site_path(args))
    ensure_secrets(site)
    render(site)
    blocking = [p for p in check(site, running=True) if 'ingest' not in p]
    if blocking:
        for problem in blocking:
            print(f"  PROBLEM  {problem}")
        return 1
    extra = ['--wait', '--wait-timeout', str(args.wait_timeout)] if not args.no_wait else []
    # 1. Re-sync the image's static bundles + Caddy config into the shared
    #    volumes (a new image or edited config must not be masked by the
    #    copy made at the previous `up`).
    run_compose(site, 'up', '-d', '--no-deps', '--force-recreate', 'static')
    if run_compose(site, 'wait', 'static', check=False) != 0:
        raise SiteError("the static sync container failed; see `ant-stack logs static`")
    # 2. Everything else. Authelia first without waiting: if a previous
    #    config made it crash-loop, compose would otherwise wait on the
    #    stale container instead of recreating it with the new config.
    if site['auth']['mode'] == 'authelia':
        run_compose(site, 'up', '-d', '--no-deps', '--force-recreate', 'authelia')
    # api, web and mcp carry ANTHIVE_CONFIG_SHA (render_compose_site): a
    # changed rendered config or secret recreates exactly those services here.
    run_compose(site, 'up', '-d', '--remove-orphans', *extra)
    # 3. Services whose profile is now off (auth mode or mcp switched) are
    #    not orphans to compose; stop and remove them explicitly.
    active = {'authelia': site['auth']['mode'] == 'authelia',
              'mcp': bool(site['services'].get('mcp'))}
    for service, is_active in active.items():
        if not is_active:
            run_compose(site, '--profile', service, 'rm', '--stop', '--force', service, check=False)
    # 4. Caddy reads its config only at start (admin API is off): recreate
    #    it so the synced config and re-rendered snippets take effect.
    # Authelia too: its config is re-rendered on every up, and a container
    # stuck in crash-loop backoff would otherwise keep the old failure.
    recreate = ['caddy'] + (['authelia'] if active['authelia'] else [])
    run_compose(site, 'up', '-d', '--no-deps', '--force-recreate', *extra, *recreate)
    _say(f"up: {site['site']['public_url']}")
    return 0


def cmd_simple(args: argparse.Namespace) -> int:
    site = load_site(site_path(args))
    # Always re-render: a .env left from an older site.yaml names the old
    # images (this is how `pull` once fetched 2.37.2 again after the tag
    # had been set to 2.40.0).
    try:
        render(site, quiet=True)
    except SiteError as error:
        if not (stack_dir(site) / '.env').exists():
            raise
        _warn(f"render failed, using the previous one: {error}")
    compose_args = {
        'down': ['down'] + (['--volumes'] if getattr(args, 'volumes', False) else []),
        'ps': ['ps', '--all'],
        'logs': ['logs', '--tail', str(getattr(args, 'tail', 200))]
                + (['-f'] if getattr(args, 'follow', False) else [])
                + ([args.service] if getattr(args, 'service', None) else []),
        'restart': ['restart'] + list(getattr(args, 'services', None) or []),
    }[args.command]
    return run_compose(site, *compose_args, check=False)


def _rendered_images(site: dict) -> dict[str, str]:
    """Image refs the current <state_dir>/stack/.env names (before a render)."""
    env_file = stack_dir(site) / '.env'
    found: dict[str, str] = {}
    if not env_file.exists():
        return found
    for line in env_file.read_text().splitlines():
        match = re.fullmatch(r'(ANTHIVE_IMAGE_[A-Z]+)="(.*)"', line.strip())
        if match:
            found[match.group(1)] = match.group(2)
    return found


def images_to_pull(site: dict, include_ingest: bool = True) -> list[tuple[str, str]]:
    """(role, image ref) for every image this site runs, from site.yaml."""
    images = [('app', image_ref(site, 'app'))]
    if include_ingest:
        images.append(('ingest', image_ref(site, 'ingest')))
    images.append(('caddy', image_ref(site, 'caddy')))
    if site['auth']['mode'] == 'authelia':
        images.append(('authelia', image_ref(site, 'authelia')))
    return images


def _image_id(ref: str) -> str | None:
    result = subprocess.run(['docker', 'image', 'inspect', '--format', '{{.Id}}', ref],
                            capture_output=True, text=True)
    return result.stdout.strip() if result.returncode == 0 else None


def cmd_pull(args: argparse.Namespace) -> int:
    """Pull every image the site runs, by the refs site.yaml names NOW.

    Renders first (a stale .env is what made 2.37.2 -> 2.40.0 upgrades pull
    the old app image), pulls with `docker pull` one by one (compose skips
    the ingest image, whose profile is off) and reports what changed."""
    site = load_site(site_path(args))
    before = _rendered_images(site)
    render(site, quiet=True)
    after = _rendered_images(site)
    for key, ref in after.items():
        if before.get(key) and before[key] != ref:
            _say(f"{key}: the previous render named {before[key]}, site.yaml now names {ref}")
    failed = 0
    report: list[str] = []
    for role, ref in images_to_pull(site, include_ingest=not args.no_ingest):
        old_id = _image_id(ref)
        _say(f"pulling {role}: {ref}")
        result = subprocess.run(['docker', 'pull', ref])
        new_id = _image_id(ref)
        if result.returncode != 0 or new_id is None:
            failed += 1
            report.append(f"  FAILED     {role:9s}{ref}")
            continue
        state = 'unchanged' if old_id == new_id else ('updated' if old_id else 'new')
        report.append(f"  {state:10s} {role:9s}{ref}  {new_id[:19]}")
    print('\n'.join(['', 'ant-stack pull:'] + report))
    if args.no_ingest:
        print(f"  skipped    ingest   {image_ref(site, 'ingest')} (--no-ingest)")
    if failed:
        _warn(f"{failed} image(s) failed to pull; `ant-stack up` will refuse a missing app image")
        return 1
    return 0


def library_lock_path(library: Path) -> Path:
    """The lock the api upload path holds (lib/library_upload.library_lock)."""
    meta = library / '.git'
    return meta / 'anthive-upload.lock' if meta.is_dir() else library / '.anthive-upload.lock'


def git_ssh_command(key: Path | None) -> str | None:
    if key is None:
        return None
    import shlex  # noqa: PLC0415
    return f"ssh -i {shlex.quote(str(key))} -o IdentitiesOnly=yes -o BatchMode=yes"


def _git(library: Path, env: dict, *args: str) -> subprocess.CompletedProcess:
    return subprocess.run(['git', '-C', str(library), *args], env=env, capture_output=True,
                          text=True, timeout=600)


def _acquire_lock(path: Path, timeout: float):
    import fcntl  # noqa: PLC0415
    import time  # noqa: PLC0415
    handle = open(path, 'a+')
    deadline = time.monotonic() + timeout
    while True:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return handle
        except BlockingIOError:
            if time.monotonic() > deadline:
                handle.close()
                raise SiteError(f"{path} stayed locked for {timeout:.0f}s (an upload or another "
                                f"publish is running); try again later") from None
            time.sleep(1)


def _git_output(result: subprocess.CompletedProcess) -> str:
    """All of git's output, indented: the cause (Permission denied
    (publickey), Host key verification failed) is rarely the last line."""
    text = ((result.stderr or '') + (result.stdout or '')).strip() or '(no output)'
    return '\n'.join('    ' + line for line in text.splitlines())


def cmd_publish_library(args: argparse.Namespace) -> int:
    """Host-side publishing of the paper library: git pull --rebase and push
    the records with the site's deploy key, then sync the PDFs (and the
    literature index) with S3 through the ingest container. Holds the
    upload lock throughout so no upload commits halfway."""
    site = load_site(site_path(args))
    library = site['_library']
    if library is None:
        raise SiteError("data.library is not set: nothing to publish")
    if not (library / '.git').is_dir():
        raise SiteError(f"{library} is not a git checkout of the library repo")
    key = site['_deploy_key']
    if key is not None and not key.is_file():
        raise SiteError(f"library.deploy_key {key} does not exist")
    env = dict(os.environ)
    ssh = git_ssh_command(key)
    if ssh:
        env['GIT_SSH_COMMAND'] = ssh
    else:
        _say("library.deploy_key is not set: git uses this user's own ssh setup")
    errors = 0
    handle = _acquire_lock(library_lock_path(library), args.lock_timeout)
    try:
        _say(f"locked {library_lock_path(library)}")
        if args.dry_run:
            s3_step = (not args.no_s3) and site['s3'].get('enabled')
            _say(f"dry run: would git pull --rebase{'' if args.no_push else ' and git push'} in {library}"
                 + (', then `ant sync library --no-git --dry-run`' if s3_step else ''))
            # Contact the remote with the deploy key, so the dry run proves
            # the key, the host key and the remote URL actually work.
            probe = _git(library, env, 'ls-remote', '--heads', 'origin')
            if probe.returncode != 0:
                errors += 1
                _warn("cannot reach the library remote with this key:\n" + _git_output(probe))
            else:
                _say("remote: reachable with this key")
        pulled = _git(library, env, 'pull', '--rebase', '--autostash') if not args.dry_run else None
        if pulled is not None and pulled.returncode != 0:
            _git(library, env, 'rebase', '--abort')
            errors += 1
            _warn("git pull --rebase failed, nothing pushed:\n" + _git_output(pulled))
        elif pulled is not None:
            _say("records: pulled")
            if not args.no_push:
                pushed = _git(library, env, 'push')
                if pushed.returncode != 0:
                    errors += 1
                    _warn("git push failed:\n" + _git_output(pushed))
                else:
                    _say("records: pushed")
        if args.no_s3:
            _say("PDFs: skipped (--no-s3)")
        elif not site['s3'].get('enabled'):
            _say("PDFs: skipped (s3.enabled is false)")
        else:
            render(site, quiet=True)
            sync = ['ant', 'sync', 'library', '--no-git'] + (['--dry-run'] if args.dry_run else [])
            _say("PDFs: " + ' '.join(sync) + " (ingest container)")
            if run_compose(site, '--profile', 'ingest', 'run', '--rm', '--no-deps', '-T', 'ingest',
                           *sync, check=False) != 0:
                errors += 1
                _warn("the library S3 sync failed; see the output above")
    finally:
        handle.close()
    return 1 if errors else 0


def image_pathspec() -> list[str]:
    """`git archive` pathspec for an image build context: the whole tree
    minus docker/image-excludes (reports, tests, audits), as the Makefile does."""
    spec = ['.']
    for line in (REPO / 'docker' / 'image-excludes').read_text().splitlines():
        line = line.strip()
        if line and not line.startswith('#'):
            spec.append(f':(exclude,glob){line}')
    return spec


def cmd_build(args: argparse.Namespace) -> int:
    site = load_site(site_path(args))
    app, ingest = image_ref(site, 'app'), image_ref(site, 'ingest')
    # Build context = `git archive HEAD`: only committed, tracked files, so
    # local state (Authelia db, logs, nested checkouts) can never ship.
    if subprocess.run(['git', 'rev-parse', '--git-dir'], cwd=REPO,
                      capture_output=True).returncode != 0:
        raise SiteError("ant-stack build needs a git checkout (it builds from `git archive HEAD`)")
    if subprocess.run(['git', 'diff', '--quiet', 'HEAD', '--'], cwd=REPO).returncode != 0:
        _say("note: uncommitted changes are NOT in the image; commit them first to include them")
    builds = [
        ['docker', 'build', '-f', 'docker/Dockerfile', '-t', app, '-'],
        ['docker', 'build', '-f', 'docker/Dockerfile.ingest', '--build-arg', f'APP_IMAGE={app}',
         '-t', ingest, '-'],
    ]
    for command, image in list(zip(builds, (app, ingest)))[: 1 if args.app_only else 2]:
        if args.pull:
            command.insert(2, '--pull')
        _say('git archive HEAD | ' + ' '.join(command))
        archive = subprocess.Popen(['git', 'archive', '--format=tar', 'HEAD', '--', *image_pathspec()],
                                   cwd=REPO, stdout=subprocess.PIPE)
        result = subprocess.run(command, cwd=REPO, stdin=archive.stdout)
        archive.stdout.close()
        if archive.wait() != 0 or result.returncode != 0:
            return result.returncode or 1
        check = subprocess.run([str(REPO / 'docker' / 'check-image'), image, 'HEAD'], cwd=REPO)
        if check.returncode != 0:
            raise SiteError(f"{image} failed docker/check-image; not safe to use or push")
    return 0


def cmd_passwd(args: argparse.Namespace) -> int:
    site = load_site(site_path(args))
    names = {str(u['name']) for u in site['auth'].get('users') or []}
    if args.user not in names:
        raise SiteError(f"{args.user!r} is not in auth.users of site.yaml")
    password = args.password or os.environ.get('ANTHIVE_NEW_PASSWORD')
    if not password:
        import getpass  # noqa: PLC0415
        try:
            password = getpass.getpass(f"new password for {args.user}: ")
            again = getpass.getpass("again: ")
        except EOFError:
            raise SiteError("no terminal to read the password from: pass --password PASSWORD "
                            "or set ANTHIVE_NEW_PASSWORD") from None
        if password != again:
            raise SiteError("passwords differ")
    if len(password) < 10:
        raise SiteError("use at least 10 characters")
    hashes = _load_user_hashes(site)
    hashes[args.user] = _hash_password(password)
    _save_user_hashes(site, hashes)
    users_db = site['_state'] / 'authelia' / 'users_database.yml'
    if users_db.exists():
        doc = yaml.safe_load(users_db.read_text()) or {}
        if args.user in (doc.get('users') or {}):
            doc['users'][args.user]['password'] = hashes[args.user]
            _write_secret(users_db, yaml.safe_dump(doc, sort_keys=True), overwrite=True)
    render(site, quiet=True)
    if site['auth']['mode'] == 'basic':
        _say(f"password for {args.user} updated; run `ant-stack restart caddy` to apply it (basic mode)")
    else:
        _say(f"password for {args.user} updated (basic list + authelia db; authelia picks it up "
             f"within seconds)")
    return 0


def cmd_ingest(args: argparse.Namespace) -> int:
    site = load_site(site_path(args))
    render(site, quiet=True)
    command = list(args.cmd)
    if command and command[0] == '--':
        command = command[1:]
    if not command:
        raise SiteError("usage: ant-stack ingest -- <command...>")
    return run_compose(site, '--profile', 'ingest', 'run', '--rm', '--no-deps', 'ingest',
                       *command, check=False)


def cmd_config_path(args: argparse.Namespace) -> int:
    site = load_site(site_path(args))
    print(config_file(site, args.role))
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(prog='ant-stack', description=__doc__.splitlines()[0],
                                     formatter_class=argparse.RawDescriptionHelpFormatter,
                                     epilog=__doc__)
    parser.add_argument('--site', help='site.yaml path (default: $ANTHIVE_SITE or ./site.yaml)')
    sub = parser.add_subparsers(dest='command', required=True)
    sub.add_parser('init')
    p_check = sub.add_parser('check')
    p_check.add_argument('--running', action='store_true',
                         help='skip the free-port check (stack already up)')
    sub.add_parser('render')
    p_up = sub.add_parser('up')
    p_up.add_argument('--no-wait', action='store_true')
    p_up.add_argument('--wait-timeout', type=int, default=900)
    p_down = sub.add_parser('down')
    p_down.add_argument('--volumes', action='store_true',
                        help='also delete the docker volumes (webapp bundle, caddy certs, scratch)')
    sub.add_parser('ps')
    p_pull = sub.add_parser('pull', help='pull every image site.yaml names and report what changed')
    p_pull.add_argument('--no-ingest', action='store_true',
                        help='skip the ingest image (~4.5 GB; needed for `ingest` and `publish-library`)')
    p_publish = sub.add_parser('publish-library',
                               help='host-side: git pull --rebase + push the library with the deploy key, '
                                    'then sync the PDFs with S3 (cron/systemd timer)')
    p_publish.add_argument('--no-push', action='store_true', help='pull the records, do not push')
    p_publish.add_argument('--no-s3', action='store_true', help='records only, no PDF/index sync')
    p_publish.add_argument('--dry-run', action='store_true', help='print the plan, change nothing')
    p_publish.add_argument('--lock-timeout', type=float, default=600,
                           help='seconds to wait for a running upload (default 600)')
    p_logs = sub.add_parser('logs')
    p_logs.add_argument('service', nargs='?')
    p_logs.add_argument('-f', '--follow', action='store_true')
    p_logs.add_argument('--tail', type=int, default=200)
    p_restart = sub.add_parser('restart')
    p_restart.add_argument('services', nargs='*', help='services to restart (default: all), e.g. api web mcp')
    p_build = sub.add_parser('build')
    p_build.add_argument('--pull', action='store_true', help='pull newer base images')
    p_build.add_argument('--app-only', action='store_true')
    p_passwd = sub.add_parser('passwd')
    p_passwd.add_argument('user')
    p_passwd.add_argument('--password', help='non-interactive (or $ANTHIVE_NEW_PASSWORD)')
    p_ingest = sub.add_parser('ingest')
    p_ingest.add_argument('cmd', nargs=argparse.REMAINDER)
    p_config = sub.add_parser('config-path')
    p_config.add_argument('--role', choices=sorted(CONFIG_ROLES), default='serve',
                          help='serve (web, mcp), api, or ingest (full S3 keys; host-side sync)')
    args = parser.parse_args()
    handlers = {
        'init': cmd_init, 'check': cmd_check, 'render': cmd_render, 'up': cmd_up,
        'down': cmd_simple, 'ps': cmd_simple, 'pull': cmd_pull, 'logs': cmd_simple,
        'publish-library': cmd_publish_library,
        'restart': cmd_simple, 'build': cmd_build, 'passwd': cmd_passwd,
        'ingest': cmd_ingest, 'config-path': cmd_config_path,
    }
    try:
        return handlers[args.command](args)
    except SiteError as error:
        print(f"[ant-stack] ERROR: {error}", file=sys.stderr)
        return 2


if __name__ == '__main__':
    sys.exit(main())
