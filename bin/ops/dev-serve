#!/bin/bash
# dev-serve - Start Streamlit development server
#
# Simple wrapper that starts Streamlit with the correct configuration

set -e

# Get script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

cd "$PROJECT_ROOT"

echo -e "${BLUE}=== Starting Streamlit Development Server ===${NC}"
echo

# Check if REST API is already running
echo -e "${BLUE}Checking for REST API on :8080...${NC}"
if curl -s -o /dev/null -w "%{http_code}" "http://localhost:8080/health" 2>/dev/null | grep -qE "^[0-9]{3}$"; then
    DB_COUNT=$(curl -s http://localhost:8080/databases 2>/dev/null | grep -oP '"total":\s*\K\d+' || echo "?")
    echo -e "${GREEN}✓ REST API running ($DB_COUNT databases)${NC}"
else
    echo -e "${RED}✗ REST API not running${NC}"
    echo -e "${YELLOW}Please start the API first: bin/ant serve${NC}"
    exit 1
fi

echo
echo -e "${BLUE}Starting Streamlit...${NC}"
echo

# Set environment variable for API URL
export ANTHIVE_API_URL="http://localhost:8080"

# Run streamlit directly (not in background)
exec "$SCRIPT_DIR/streamlit-serve"
