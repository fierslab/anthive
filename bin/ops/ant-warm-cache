async def warm_one(
    client: httpx.AsyncClient,
    base_url: str,
    gene: str,
    organism: Optional[str],
    cell_type: Optional[str],
    auth: Optional[tuple],
) -> tuple[str, int, float, dict]:
    """Fire one gene_stats_all call and return (gene, http_status, seconds, payload-summary)."""
    params = {'genes': gene}
    if organism:
        params['organism'] = organism
    if cell_type:
        params['cell_type'] = cell_type
    t0 = time.perf_counter()
    resp = await client.get(
        f'{base_url}/gene_stats_all',
        params=params, auth=auth, timeout=300.0,
    )
    elapsed = time.perf_counter() - t0
    try:
        body = resp.json()
    except ValueError:
        body = {}
    summary = {
        'n_databases': body.get('n_databases'),
        'cache': body.get('cache'),
    }
    return gene, resp.status_code, elapsed, summary


async def main_async(args: argparse.Namespace) -> int:
    if args.genes.startswith('@'):
        gene_file = Path(args.genes[1:])
        genes_raw = gene_file.read_text().strip().splitlines()
    elif args.genes == 'DEFAULT':
        genes_raw = DEFAULT_PANEL
    else:
        genes_raw = args.genes.split(',')

    genes = [g.strip() for g in genes_raw if g.strip()]
    if args.max and len(genes) > args.max:
        genes = genes[: args.max]

    print(f'  warming cache with {len(genes)} gene(s) against {args.base_url}')
    print(f'  filters: organism={args.organism!r}  cell_type={args.cell_type!r}')

    auth = tuple(args.auth.split(':', 1)) if args.auth else None

    n_ok = n_err = 0
    t_total0 = time.perf_counter()
    async with httpx.AsyncClient(verify=False) as client:
        for i, gene in enumerate(genes, 1):
            try:
                g, status, elapsed, summary = await warm_one(
                    client, args.base_url, gene,
                    args.organism, args.cell_type, auth,
                )
            except httpx.HTTPError as exc:
                print(f'  [{i:>3}/{len(genes)}] ERR  {gene}  {exc}')
                n_err += 1
                continue
            if status == 200:
                cache = summary.get('cache') or {}
                hits = cache.get('hits', 0)
                misses = cache.get('misses', 0)
                writes = cache.get('writes', 0)
                print(f'  [{i:>3}/{len(genes)}] {elapsed:5.1f}s  {gene:<10}  '
                      f'n_dbs={summary.get("n_databases")}  hits={hits} misses={misses} writes={writes}')
                n_ok += 1
            else:
                print(f'  [{i:>3}/{len(genes)}] HTTP {status}  {gene}')
                n_err += 1

    elapsed = time.perf_counter() - t_total0
    print()
    print(f'  done in {elapsed:.0f}s — {n_ok} ok, {n_err} err')
    return 0 if n_err == 0 else 1


def main() -> int:
    cfg = get_config()
    default_host = cfg.get('rest_api_host', 'localhost')
    default_port = cfg.get('rest_api_port', 8080)
    default_base = f'http://{default_host}:{default_port}/api'
    # If rest_api_host is the bind-all wildcard, prefer localhost loopback.
    if default_host in ('0.0.0.0', '::'):
        default_base = f'http://localhost:{default_port}/api'

    parser = argparse.ArgumentParser(
        description='Pre-populate the gene_stats cache for the curated panel + filters.',
    )
    parser.add_argument(
        '--base-url', default=default_base,
        help=f'ant-serve base URL (default {default_base}).',
    )
    parser.add_argument(
        '--auth', default=None,
        help='HTTP basic auth, "user:password". Omit when hitting localhost loopback.',
    )
    parser.add_argument(
        '--genes', default='DEFAULT',
        help=("Gene list. Default: the curated AD + microglia panel "
              "(~150 genes). Pass CSV directly or '@/path/to/file.txt' "
              "(one gene per line)."),
    )
    parser.add_argument(
        '--organism', default=None,
        help='Filter to one organism (mouse / human / …).',
    )
    parser.add_argument(
        '--cell-type', default=None,
        help='Filter to one mus-vocab cell_type (e.g. "microglial cell").',
    )
    parser.add_argument(
        '--max', type=int, default=500,
        help='Cap number of genes to warm (default 500, 0 = no cap).',
    )
    args = parser.parse_args()

    return asyncio.run(main_async(args))


if __name__ == '__main__':
    sys.exit(main())
