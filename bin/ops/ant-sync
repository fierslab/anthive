#!/usr/bin/env -S uv run --quiet --script
# /// script
# dependencies = ["boto3", "pyyaml"]
# ///

"""
ant-sync — push/pull .h5ad, .duckdb, .scores.parquet, layer-parquet
sidecars, AND per-group `<Group>/static/**` (paper PDFs, supp tables)
to/from S3. `.md` / `.h5ad.mus` frontmatter is git-tracked and never touched.

Usage:
  ant-sync push   [FILTER]   Upload local files to S3
  ant-sync pull   [FILTER]   Download S3 files to local
  ant-sync status [FILTER]   Show sync status (no transfers)
  ant-sync stamp-sha256 [FILTER] [--dry-run]
                             Set x-amz-meta-sha256 on catalogue .h5ad objects that lack it (in-place copy,
                             only when the local file is provably the same object; no deletes)

FILTER is an optional glob pattern relative to --data-folder.

Examples:
  ant-sync push                            # push all files
  ant-sync push 'Sierksma2025/**'          # push one group
  ant-sync push '**/Single.Grafts.h5ad'    # push a specific file
  ant-sync status                          # show what needs syncing

The paper library is synced in both directions by push, pull and
`ant-sync library` (see lib/library_sync.py and doc/LIBRARY.md): records via
version control (pull --rebase, push when library_git_push is on), PDFs
(<library>/papers/**.pdf, folders mirrored under _library/papers/) against S3
with a local manifest, so changes on either side travel and conflicts are
kept, and the literature index (_library_index/) by the publisher rule.
--no-library skips the library, --library-only does only the library.
A PDF that moved to another folder is uploaded under its new key; the old key
is reported as S3-only and never deleted automatically.
"""

import argparse
import fnmatch
import re
import shutil as _shutil
import sys
import time
from pathlib import Path
from typing import Dict, Optional, Set, Tuple

import boto3
from boto3.s3.transfer import TransferConfig

sys.path.insert(0, str(Path(__file__).parent.parent.parent / 'lib'))
from config import get_config, is_slave, require_primary  # noqa: E402
from h5adstore import iter_h5adstore  # noqa: E402
from metadata import get_priority, parse_md_file, PRIORITY_DEFAULT  # noqa: E402
from s3_etag import etag_matches_file, sha256_file  # noqa: E402

# Only these extensions are ever pushed/pulled.
# .md files are intentionally excluded — they live in git (h5adstore repo), not S3.
# .inactive sidecars are also intentionally excluded — they live in git.
# .de.parquet is the differential-expression sidecar (see
# doc/DESIGN_var_and_de.md). It does NOT round-trip into the h5ad, so it
# lives alongside the h5ad and is shipped to S3 as part of the source-of-
# truth set (alongside .h5ad). It's also pulled back by default.
# .layer.*.by_gene.parquet / .layer.*.by_cell.parquet are the new Parquet-
# backed expression layer sidecars (derived from .h5ad, treated like .duckdb:
# evictable/rebuildable, not pulled by default).
SYNC_EXTENSIONS      = {'.h5ad', '.duckdb', '.de.parquet', '.scores.parquet',
                        # Parquet-backed expression layers (two files per layer,
                        # matched via endswith since they contain multi-dot names
                        # like '.layer.X.by_gene.parquet').
                        '.by_gene.parquet', '.by_cell.parquet',
                        # Fleet-wide summary tables at repo root — one
                        # file per resource; specific-name allow.
                        'module_variability.parquet',
                        'scores_index.parquet',
                        'gene_stats_index.parquet',
                        'gene_variance_index.parquet'}
# Prefixed-path allowlist — relative-path prefixes whose contents are
# always syncable (bypasses the `_` staging-folder skip). Used for the
# module-variability + gene-stats + gene-variance caches so slave nodes
# reap the primary's cache hits.
SYNC_PATH_PREFIXES   = ('_module_variability_cache/', '_gene_stats_cache/',
                        '_gene_variance_cache/',
                        # Facet test results (per-dataset parquets, run
                        # manifests, pooled units, summaries, cohort table):
                        # served by ant-serve, so every site needs them.
                        '_facet_tests/')
# Inside a prefixed path these are never synced (run logs, helper scripts).
PREFIX_SKIP_SUFFIXES = ('.log', '.py', '.snapshot')
# Pull defaults to .h5ad + .de.parquet. .duckdb and .layer.*.parquet sidecars
# are derived (rebuilt locally via `ant-build-all`). Use `pull --include-duckdb`
# to override for disaster recovery.
PULL_DEFAULT_EXTS    = {'.h5ad', '.de.parquet', '.scores.parquet',
                        'module_variability.parquet',
                        'scores_index.parquet',
                        'gene_stats_index.parquet',
                        'gene_variance_index.parquet'}
SKIP_SUFFIXES        = {'.wal', '.deleted', '.partial'}
# Per-dataset sidecars that travel with their .duckdb in priority mode (a duckdb
# without its layer parquets cannot serve expression; .de/.scores feed the DE and
# module routes). Matched as '<duckdb stem>.<...><suffix>' in the same folder.
BUNDLE_SUFFIXES      = ('.by_gene.parquet', '.by_cell.parquet', '.de.parquet', '.scores.parquet')
# Same-size non-duckdb files whose S3 copy is newer are re-downloaded up to this
# size (cheap, and a cache JSON/parquet can change without changing size);
# bigger ones are only re-stamped, like duckdbs.
CHEAP_REPULL_BYTES   = 16 * 1024 ** 2
# S3 object metadata key holding the source file's mtime (integer seconds).
# Set on every push so we can detect content-without-size-change drift
# (e.g., ant-score adds module-score columns in-place).
MTIME_METADATA_KEY   = 'original-mtime'
# sha256 of a pushed .h5ad (the watch route and the deposit API read it: a metadata-only update reuses a
# published h5ad only when its object carries the hash the catalogue records).
SHA_METADATA_KEY     = 'sha256'
SINGLE_COPY_MAX      = 5 * 1024 ** 3          # CopyObject limit; larger objects use the managed multipart copy

MULTIPART_THRESHOLD = 256 * 1024 ** 2   # 256 MB
MULTIPART_CHUNKSIZE = 256 * 1024 ** 2


def _s3_client(s3_cfg: dict):
    endpoint = s3_cfg.get('endpoint')
    return boto3.client(
        's3',
        endpoint_url=f'https://{endpoint}' if endpoint else None,
        region_name=s3_cfg.get('region', 'us-east-1'),
        aws_access_key_id=s3_cfg.get('access_key_id'),
        aws_secret_access_key=s3_cfg.get('secret_access_key'),
    )


def _transfer_config(max_concurrency: int = 4,
                     max_bandwidth: int | None = None) -> TransferConfig:
    kwargs = dict(
        multipart_threshold=MULTIPART_THRESHOLD,
        multipart_chunksize=MULTIPART_CHUNKSIZE,
        max_concurrency=max_concurrency,
    )
    if max_bandwidth:
        kwargs['max_bandwidth'] = max_bandwidth
    return TransferConfig(**kwargs)


def _parse_bandwidth(spec: str) -> int:
    """Parse '4M', '500K', '1G' (or plain int) into bytes/sec."""
    s = spec.strip().upper()
    mult = 1
    if s.endswith('K'): mult, s = 1024, s[:-1]
    elif s.endswith('M'): mult, s = 1024 ** 2, s[:-1]
    elif s.endswith('G'): mult, s = 1024 ** 3, s[:-1]
    return int(float(s) * mult)


def _s3_key(relative_path: str, prefix: str) -> str:
    if prefix:
        return f'{prefix.rstrip("/")}/{relative_path}'
    return relative_path


def _rel_from_s3_key(s3_key: str, prefix: str) -> str:
    prefix_str = prefix.rstrip('/') + '/' if prefix else ''
    return s3_key[len(prefix_str):] if prefix_str else s3_key


def _is_static_path(rel: str) -> bool:
    """True if the relative path lives under a per-group `static/` folder.

    Layout: `data/h5adstore/<Group>/static/<anything>`. These carry paper
    PDFs, supplementary tables, etc. — catalog metadata that mirrors to S3
    regardless of file extension. Always synced, always pulled, never
    priority-gated.
    """
    parts = Path(rel).parts
    # <Group>/static/... — 'static' as the 2nd path segment or deeper.
    return 'static' in parts[:-1]


def _is_syncable(
    rel: str,
    allowed_exts: set[str] | None = None,
    include_static: bool = True,
) -> bool:
    path = Path(rel)
    if path.name.startswith('.'):
        return False
    # Prefixed-path allowlist (checked BEFORE the `_` skip because these
    # prefixes deliberately start with `_`, e.g. the module-variability
    # cache under `_module_variability_cache/`).
    for prefix in SYNC_PATH_PREFIXES:
        if rel.startswith(prefix):
            if any(rel.endswith(suffix) for suffix in SKIP_SUFFIXES):
                return False
            if rel.endswith(PREFIX_SKIP_SUFFIXES):
                return False
            return True
    # Skip _-prefixed folders (e.g. _synapse_raw) — staging / archive areas.
    if any(part.startswith('_') for part in path.parts[:-1]):
        return False
    # `<Group>/static/**` files bypass the extension gate — they're
    # catalog metadata (PDFs, supp tables) and can be any file type.
    # Callers that want only a specific ext (--only .duckdb) pass
    # include_static=False to opt out.
    if include_static and _is_static_path(rel):
        return True
    allowed = allowed_exts if allowed_exts is not None else SYNC_EXTENSIONS
    # endswith() (not path.suffix) because some extensions have multiple
    # dots: '.de.parquet' must match without also matching every '.parquet'.
    if not any(rel.endswith(ext) for ext in allowed):
        return False
    if any(rel.endswith(suffix) for suffix in SKIP_SUFFIXES):
        return False
    return True


def _local_files(
    data_folder: Path,
    filter_pattern: str | None,
    allowed_exts: set[str] | None = None,
    include_static: bool = True,
) -> list[tuple[Path, str]]:
    results = []
    for path in sorted(data_folder.rglob('*')):
        if not path.is_file():
            continue
        rel = str(path.relative_to(data_folder))
        if not _is_syncable(rel, allowed_exts, include_static=include_static):
            continue
        # Never push a .duckdb or layer parquet whose dataset is marked inactive
        if path.suffix == '.duckdb' and path.with_suffix('.inactive').exists():
            continue
        # Layer parquets inherit the inactivity of their parent dataset.
        # e.g. foo.layer.X.by_gene.parquet → foo.inactive
        if rel.endswith('.by_gene.parquet') or rel.endswith('.by_cell.parquet'):
            # Derive the base stem by stripping from the first '.layer.' segment
            import re as _re
            base_match = _re.match(r'^(.*?)\.layer\..+\.parquet$', path.name)
            if base_match:
                inactive_sidecar = path.parent / (base_match.group(1) + '.inactive')
                if inactive_sidecar.exists():
                    continue
        if filter_pattern and not fnmatch.fnmatch(rel, filter_pattern):
            continue
        results.append((path, rel))
    return results


def _s3_objects(
    client,
    bucket: str,
    prefix: str,
    allowed_exts: set[str] | None = None,
    include_static: bool = True,
) -> dict[str, int]:
    """Return {relative_path: size} for all syncable S3 objects."""
    paginator = client.get_paginator('list_objects_v2')
    prefix_str = prefix.rstrip('/') + '/' if prefix else ''
    index: dict[str, int] = {}
    for page in paginator.paginate(Bucket=bucket, Prefix=prefix_str):
        for obj in page.get('Contents', []):
            rel = _rel_from_s3_key(obj['Key'], prefix)
            if rel and _is_syncable(rel, allowed_exts, include_static=include_static):
                index[rel] = obj['Size']
    return index


def _s3_mtime(client, bucket: str, key: str) -> int | None:
    """Fetch the original-mtime metadata header from an S3 object, if set.
    Returns int seconds since epoch, or None if missing / inaccessible."""
    try:
        head = client.head_object(Bucket=bucket, Key=key)
        raw = (head.get('Metadata') or {}).get(MTIME_METADATA_KEY)
        return int(raw) if raw else None
    except Exception:
        return None


def _local_mtime(path: Path) -> int:
    return int(path.stat().st_mtime)


def _fmt_size(num_bytes: int) -> str:
    for unit in ('B', 'KB', 'MB', 'GB', 'TB'):
        if num_bytes < 1024 or unit == 'TB':
            return f'{num_bytes:.1f} {unit}'
        num_bytes /= 1024
    return str(num_bytes)


def _recorded_sha256(local_path: Path) -> Set[str]:
    """sha256 values the catalogue records for an .h5ad: its .md front matter and its .h5ad.mus sidecar."""
    found: Set[str] = set()
    md = local_path.with_suffix('.md')
    if md.exists():
        try:
            raw = (parse_md_file(md)[0] or {}).get('sha256')
            value = '' if raw is None else str(raw).strip().lower()
            if value:
                found.add(value)
        except Exception:  # noqa: BLE001 - an unreadable .md records nothing
            pass
    mus = local_path.with_name(local_path.name + '.mus')
    if mus.exists():
        for line in mus.read_text(encoding='utf-8', errors='replace').splitlines():
            key, _, value = line.partition('=')
            if key.strip() == 'sha256' and value.strip():
                found.add(value.strip().lower())
    return found


def _push_metadata(local_path: Path, rel: str, local_mtime: int) -> dict:
    """Object metadata of a push: the mtime, and for an .h5ad its sha256 (computed from the file; a .md or
    .mus that records another value is reported, never trusted)."""
    metadata = {MTIME_METADATA_KEY: str(local_mtime)}
    if rel.endswith('.h5ad'):
        sha = sha256_file(local_path)
        recorded = _recorded_sha256(local_path)
        if recorded and sha not in recorded:
            print(f'  note: {rel}: the .md/.mus record another sha256 than the file ({", ".join(sorted(recorded))[:80]})')
        metadata[SHA_METADATA_KEY] = sha
    return metadata


def stamp_plan(client, bucket: str, prefix: str, data_folder: Path, pattern: Optional[str]) -> list:
    """What ``stamp-sha256`` would do: one entry per catalogue .h5ad, ``action`` stamp / already / skip."""
    plan = []
    prefix_str = prefix.rstrip('/') + '/' if prefix else ''
    for page in client.get_paginator('list_objects_v2').paginate(Bucket=bucket, Prefix=prefix_str):
        for obj in page.get('Contents', []) or []:
            key = obj['Key']
            rel = _rel_from_s3_key(key, prefix)
            if not rel.endswith('.h5ad') or not _is_syncable(rel, {'.h5ad'}, include_static=False):
                continue
            if pattern and not fnmatch.fnmatch(rel, pattern):
                continue
            entry = {'rel': rel, 'key': key, 'size': int(obj.get('Size', 0)),
                     'etag': str(obj.get('ETag', '')).strip('"')}
            head = client.head_object(Bucket=bucket, Key=key)
            metadata = {str(k).lower(): str(v) for k, v in (head.get('Metadata') or {}).items()}
            entry['metadata'], entry['content_type'] = metadata, head.get('ContentType')
            if metadata.get(SHA_METADATA_KEY):
                plan.append({**entry, 'action': 'already'})
                continue
            local = data_folder / rel
            if not local.is_file():
                plan.append({**entry, 'action': 'skip', 'reason': 'no local copy to verify against'})
                continue
            if local.stat().st_size != entry['size']:
                plan.append({**entry, 'action': 'skip', 'reason': 'the local file has another size'})
                continue
            if not etag_matches_file(entry['etag'], local):
                plan.append({**entry, 'action': 'skip', 'reason': 'the local file is not the S3 object (ETag)'})
                continue
            sha = sha256_file(local)
            recorded = _recorded_sha256(local)
            if recorded and sha not in recorded:
                plan.append({**entry, 'action': 'skip', 'sha256': sha,
                             'reason': 'the .md/.mus record another sha256 than the file'})
                continue
            plan.append({**entry, 'action': 'stamp', 'sha256': sha})
    return plan


def stamp_apply(client, bucket: str, entry: dict, transfer=None) -> dict:
    """Set the sha256 metadata of one object by an in-place copy (existing metadata and content type kept,
    conditional on the listed ETag). Returns ``{'ok': bool, 'etag': new ETag, 'reason'?}``. No deletes."""
    metadata = {**entry['metadata'], SHA_METADATA_KEY: entry['sha256']}
    source = {'Bucket': bucket, 'Key': entry['key']}
    extra = {'Metadata': metadata, 'MetadataDirective': 'REPLACE',
             'ContentType': entry.get('content_type') or 'application/octet-stream',
             'CopySourceIfMatch': f'"{entry["etag"]}"'}
    if entry['size'] <= SINGLE_COPY_MAX:
        client.copy_object(Bucket=bucket, Key=entry['key'], CopySource=source, **extra)
    else:
        kwargs = {'ExtraArgs': extra}
        if transfer is not None:
            kwargs['Config'] = transfer
        client.copy(source, bucket, entry['key'], **kwargs)
    head = client.head_object(Bucket=bucket, Key=entry['key'])
    new_metadata = {str(k).lower(): str(v) for k, v in (head.get('Metadata') or {}).items()}
    if int(head.get('ContentLength') or 0) != entry['size'] or new_metadata.get(SHA_METADATA_KEY) != entry['sha256']:
        return {'ok': False, 'etag': str(head.get('ETag', '')).strip('"'), 'reason': 'not verified after the copy'}
    return {'ok': True, 'etag': str(head.get('ETag', '')).strip('"')}


def cmd_stamp(args, s3_cfg: dict, data_folder: Path) -> None:
    """``ant-sync stamp-sha256``: backfill x-amz-meta-sha256 on catalogue .h5ad objects."""
    require_primary(tool='ant-sync stamp-sha256')
    client = _s3_client(s3_cfg)
    bucket, prefix = s3_cfg['bucket'], s3_cfg.get('prefix', '') or ''
    print('Planning (hashes every local .h5ad whose object lacks the metadata; this reads them all)…')
    plan = stamp_plan(client, bucket, prefix, data_folder, args.filter)
    counts: Dict[str, int] = {}
    for entry in plan:
        counts[entry['action']] = counts.get(entry['action'], 0) + 1
        if entry['action'] == 'skip':
            print(f'[SKIP]  {entry["rel"]}: {entry["reason"]}')
        elif entry['action'] == 'stamp':
            print(f'[STAMP] {entry["rel"]}  sha256 {entry["sha256"][:16]}…  ({_fmt_size(entry["size"])})')
    print(f'\nPlan: {counts.get("stamp", 0)} to stamp, {counts.get("already", 0)} already stamped, '
          f'{counts.get("skip", 0)} skipped')
    if args.dry_run:
        print('Dry run: nothing changed.')
        return
    transfer = _transfer_config()
    failed = 0
    for entry in plan:
        if entry['action'] != 'stamp':
            continue
        try:
            result = stamp_apply(client, bucket, entry, transfer)
        except Exception as exc:  # noqa: BLE001 - e.g. PreconditionFailed: the object changed meanwhile
            result = {'ok': False, 'etag': entry['etag'], 'reason': str(exc)[:200]}
        changed = '' if result['etag'] == entry['etag'] else f' (ETag {entry["etag"]} -> {result["etag"]})'
        print(f'[{"DONE" if result["ok"] else "FAIL"}] {entry["rel"]}{changed}'
              + ('' if result['ok'] else f': {result.get("reason")}'))
        failed += 0 if result['ok'] else 1
    if failed:
        sys.exit(1)


class _ProgressCallback:
    def __init__(self, label: str, total_size: int):
        self._label      = label
        self._total      = total_size
        self._seen       = 0
        self._start      = time.monotonic()
        self._last_print = 0.0

    def __call__(self, bytes_amount: int) -> None:
        self._seen += bytes_amount
        now = time.monotonic()
        if now - self._last_print < 1.0 and self._seen < self._total:
            return
        self._last_print = now
        elapsed = now - self._start
        pct     = 100 * self._seen / self._total if self._total else 0
        speed   = self._seen / elapsed / (1024 ** 3) if elapsed > 0 else 0
        done_gb = self._seen / (1024 ** 3)
        total_gb = self._total / (1024 ** 3)
        print(
            f'\r  {done_gb:.1f}/{total_gb:.1f} GB  {pct:.0f}%  {speed:.2f} GB/s   ',
            end='',
            flush=True,
        )
        if self._seen >= self._total:
            print()


def _rebuild_module_variability_if_stale(
    data_folder: Path, skip: bool = False,
) -> None:
    """Rebuild ``<h5adstore>/module_variability.parquet`` if any local
    ``*.scores.parquet`` sidecar is newer than the aggregate.

    The aggregate is a single fleet-wide summary that pulls from every
    ``*.scores.parquet``. It ships to S3 alongside the sidecars, but nothing
    else in the sync layer notices when scoring runs make the aggregate
    stale. This helper does that check on every push so the file we ship
    matches the sidecars we ship.

    Args:
        data_folder: Root of the h5adstore.
        skip: If True, do nothing (opt-out via ``--no-rebuild-variability``).

    Side effects:
        On rebuild, runs ``bin/annot/ant-module-variability`` in a subprocess
        (output streamed to stdout). If ant-serve is reachable, POSTs
        ``/module-variability/rescan`` afterwards so the running server
        picks up the new file. Rebuild failure aborts the push (stale
        aggregate on S3 is worse than no push).
    """
    if skip:
        print('Skipping module_variability aggregate check '
              '(--no-rebuild-variability).')
        return

    aggregate = data_folder / 'module_variability.parquet'

    # Walk only the known catalog entries (fast) rather than rglob'ing the
    # whole tree (slow on a large h5adstore). `iter_h5adstore` skips staging
    # folders and half-ingested datasets — same gate as the rest of the tool.
    def _mtime(path: Path) -> float:
        try:
            return path.stat().st_mtime
        except FileNotFoundError:
            return 0.0

    newest_sidecar = 0.0
    sidecar_count = 0
    for entry in iter_h5adstore(data_folder):
        sidecar = entry.duckdb_path.with_name(
            entry.duckdb_path.name[: -len('.duckdb')] + '.scores.parquet'
        )
        if sidecar.exists():
            sidecar_count += 1
            m = _mtime(sidecar)
            if m > newest_sidecar:
                newest_sidecar = m

    if sidecar_count == 0:
        return  # nothing to aggregate → nothing to keep in sync
    aggregate_mtime = _mtime(aggregate) if aggregate.exists() else 0.0

    if aggregate.exists() and aggregate_mtime >= newest_sidecar:
        return  # already fresh

    import subprocess

    reason = 'missing' if not aggregate.exists() else 'stale'
    print(f'Aggregate module_variability.parquet is {reason} — '
          f'rebuilding via ant-module-variability before push.')

    script = Path(__file__).resolve().parent.parent / 'annot' / 'ant-module-variability'
    if not script.exists():
        print(f'  WARNING: {script} not found — pushing whatever aggregate exists.')
        return

    completed = subprocess.run(
        [str(script), '--h5adstore-root', str(data_folder)],
        check=False,
    )
    if completed.returncode != 0:
        print(f'\nERROR: ant-module-variability exited {completed.returncode}. '
              f'Refusing to push a stale aggregate — fix the rebuild first.',
              file=sys.stderr)
        raise SystemExit(1)

    # Best-effort: nudge ant-serve to reload the aggregate on the running
    # instance. Connection refused / 404 is fine — the file itself will
    # ship regardless, and a restarted server will pick it up.
    # Path is `/module-variability/rescan` (not `/api/…`): ant-serve mounts
    # itself under `root_path="/api"` at the Caddy layer, but when we talk
    # to it directly on rest_api_host:rest_api_port we go straight to the
    # route without the reverse-proxy prefix.
    api_url = _ant_serve_url(get_config())
    status = _admin_post(api_url, '/module-variability/rescan', timeout=30)
    if status in (200, 204):
        print('ant-serve module_variability rescan: ok')
    elif status is None:
        print('ant-serve module_variability rescan: skipped '
              '(server unreachable — file will still upload)')
    else:
        print(f'ant-serve module_variability rescan: status={status} '
              f'(non-fatal — file will still upload)')


def cmd_push(args, s3_cfg: dict, data_folder: Path) -> None:
    # Slaves are read-only mirrors — pushing would propagate local
    # divergence back to the primary, defeating the point of the mode.
    require_primary(tool='ant-sync push')

    dry_run = bool(getattr(args, 'dry_run', False))
    if dry_run:
        print('Dry run: module_variability aggregate not rebuilt, nothing uploaded.')
    else:
        _rebuild_module_variability_if_stale(
            data_folder, skip=args.no_rebuild_variability,
        )

    client   = _s3_client(s3_cfg)
    bucket   = s3_cfg['bucket']
    prefix   = s3_cfg.get('prefix', '') or ''
    transfer = _transfer_config(
        max_concurrency=args.max_concurrency,
        max_bandwidth=_parse_bandwidth(args.max_bandwidth) if args.max_bandwidth else None,
    )

    print('Scanning S3…')
    s3_index = _s3_objects(client, bucket, prefix)

    local_files = _local_files(data_folder, args.filter)
    print(f'Found {len(local_files)} local file(s) to check.\n')

    uploaded = skipped = 0
    for local_path, rel in local_files:
        local_size  = local_path.stat().st_size
        local_mtime = _local_mtime(local_path)
        s3_size     = s3_index.get(rel)

        if s3_size == local_size:
            # Same size — could still be different content (in-place edits like
            # ant-score appending columns). Check the mtime metadata header.
            s3_mt = _s3_mtime(client, bucket, _s3_key(rel, prefix))
            if s3_mt is not None and local_mtime <= s3_mt:
                skipped += 1
                continue
            if s3_mt is None and args.skip_no_mtime:
                # Treat absent metadata as 'in sync' when --skip-no-mtime is set.
                # (Legacy uploads before this version have no metadata; opt-out
                # for users who don't want to re-push everything just to add it.)
                skipped += 1
                continue

        action = 'UPDATE' if s3_size is not None else 'UPLOAD'
        if dry_run:
            print(f'[would {action}] {rel}  ({_fmt_size(local_size)})')
            uploaded += 1
            continue
        print(f'[{action}] {rel}  ({_fmt_size(local_size)})')

        s3_key   = _s3_key(rel, prefix)
        callback = _ProgressCallback(rel, local_size)
        client.upload_file(
            str(local_path),
            bucket,
            s3_key,
            Config=transfer,
            Callback=callback,
            ExtraArgs={'Metadata': _push_metadata(local_path, rel, local_mtime)},
        )
        uploaded += 1

    if dry_run:
        print(f'\nDry run (nothing uploaded).  Would upload: {uploaded},  skipped (up-to-date): {skipped}')
    else:
        print(f'\nDone.  Uploaded: {uploaded},  skipped (up-to-date): {skipped}')


# ── sync_policy helpers (priority-aware pull + evict) ───────────────────────


def _gb_to_bytes(gb: Optional[float]) -> Optional[int]:
    """Convert GB (float) to bytes (int), preserving ``None``."""
    if gb is None:
        return None
    return int(float(gb) * (1024 ** 3))


def _free_space(path: Path) -> int:
    """Bytes free on the filesystem hosting ``path``."""
    return _shutil.disk_usage(str(path)).free


def _load_sync_policy(cfg: Optional[dict] = None) -> dict:
    """Read the sync_policy block from anthive.yaml; resolve defaults.

    Returns a dict with keys: mode, max_local_bytes, min_free_bytes,
    priority_default. Caps come back in BYTES (None when not set).
    """
    cfg = cfg if cfg is not None else get_config()
    raw = cfg.get('sync_policy') or {}
    return {
        'mode': raw.get('mode', 'all'),
        'max_local_bytes': _gb_to_bytes(raw.get('max_local_gb')),
        'min_free_bytes':  _gb_to_bytes(raw.get('min_free_space')),
        'priority_default': int(raw.get('priority_default', PRIORITY_DEFAULT)),
    }


def _read_priorities(data_folder: Path, default: int) -> Dict[str, int]:
    """Map each dataset's .duckdb relative path → its priority [0..100].

    Walks every .md file via iter_h5adstore (skips half-ingested entries
    that lack id/group_id, same gate as the rest of the toolchain).
    """
    result: Dict[str, int] = {}
    for entry in iter_h5adstore(data_folder):
        try:
            md_data, _ = parse_md_file(entry.md_path)
        except Exception:
            continue
        priority = get_priority(md_data, default=default)
        try:
            rel = str(entry.duckdb_path.relative_to(data_folder))
        except ValueError:
            continue
        result[rel] = priority
    return result


def _plan_target_local(
    s3_index: Dict[str, int],
    priorities: Dict[str, int],
    policy: dict,
    free_now: int,
) -> Tuple[Set[str], list]:
    """Decide which relative paths SHOULD be local under the policy.

    Returns (target_set, warnings_list). Inputs:
      - s3_index: {rel → size_bytes} of every S3 object in the syncable set
      - priorities: {rel → priority} from local .md files
      - policy: parsed sync_policy dict
      - free_now: bytes free on the local filesystem RIGHT NOW

    Modes:
      all       → every S3 object (legacy behaviour)
      duckdb    → every S3 .duckdb (no priority gating)
      priority  → .duckdbs sorted by priority desc, accumulated until
                  cap hit. h5ads excluded entirely under this mode.
    """
    warnings: list = []
    mode = policy['mode']

    if mode == 'all':
        return set(s3_index.keys()), warnings
    if mode == 'duckdb':
        return {rel for rel in s3_index if rel.endswith('.duckdb')}, warnings
    if mode != 'priority':
        warnings.append(f"unknown sync_policy.mode {mode!r} — treating as 'all'")
        return set(s3_index.keys()), warnings

    # mode = 'priority' — duckdbs only, priority-ordered
    enriched = []
    for rel, size in s3_index.items():
        if not rel.endswith('.duckdb'):
            continue
        priority = priorities.get(rel, policy['priority_default'])
        if priority <= 0:
            continue  # 0 = inactive, never pulled
        enriched.append((priority, size, rel))
    enriched.sort(key=lambda t: (-t[0], t[2]))  # priority desc, then alpha

    max_local = policy['max_local_bytes']
    min_free  = policy['min_free_bytes']

    target: Set[str] = set()
    cumulative = 0
    # `free_now` is the disk free RIGHT NOW. After pulling N bytes locally,
    # free space drops by approximately N (ignoring existing-file replacement;
    # planner is conservative — overestimates pressure, never underestimates).
    for priority, size, rel in enriched:
        if max_local is not None and (cumulative + size) > max_local:
            warnings.append(
                f"max_local_gb cap reached at priority={priority}: "
                f"skipping {rel} ({_fmt_size(size)})"
            )
            continue
        if min_free is not None and (free_now - cumulative - size) < min_free:
            warnings.append(
                f"min_free_space floor reached at priority={priority}: "
                f"skipping {rel} ({_fmt_size(size)})"
            )
            continue
        target.add(rel)
        cumulative += size
    return target, warnings


def _print_policy_summary(policy: dict, target_n: int, target_bytes: int) -> None:
    mode = policy['mode']
    print(f"sync_policy.mode = {mode!r}")
    if mode == 'priority':
        cap = policy['max_local_bytes']
        floor = policy['min_free_bytes']
        print(f"  max_local_gb   = {(cap / 1024**3) if cap else 'unlimited'}"
              f"   min_free_space = {(floor / 1024**3) if floor else 'unlimited'}")
        print(f"  priority_default = {policy['priority_default']}")
    print(f"  target_local: {target_n} file(s), {_fmt_size(target_bytes)}")


def _git_pull_h5adstore(data_folder: Path) -> None:
    """Refresh the h5adstore git checkout so per-dataset priorities (in the
    .md files) are current before planning. Best-effort; no-op if not a repo."""
    import subprocess
    if not (data_folder / '.git').exists():
        return
    try:
        result = subprocess.run(
            ['git', '-C', str(data_folder), 'pull', '--ff-only'],
            capture_output=True, text=True, timeout=180,
        )
        lines = (result.stdout + result.stderr).strip().splitlines()
        print(f"h5adstore priorities: {lines[-1] if lines else 'up to date'}")
    except Exception as exc:  # noqa: BLE001 — best-effort refresh
        print(f"h5adstore git pull skipped ({exc})")


def _s3_index_with_mtime(
    client, bucket: str, prefix: str, allowed_exts: set[str] | None = None,
) -> Dict[str, Tuple[int, int]]:
    """{rel: (size_bytes, lastmodified_epoch)} for syncable S3 objects.

    LastModified is returned by the list call itself — no per-object HEAD.
    It is the upload time; a slave compares it to the local file's mtime to
    decide 'same version' (the pull sets local mtime to this value).
    """
    paginator = client.get_paginator('list_objects_v2')
    prefix_str = prefix.rstrip('/') + '/' if prefix else ''
    index: Dict[str, Tuple[int, int]] = {}
    for page in paginator.paginate(Bucket=bucket, Prefix=prefix_str):
        for obj in page.get('Contents', []):
            rel = _rel_from_s3_key(obj['Key'], prefix)
            if rel and _is_syncable(rel, allowed_exts):
                index[rel] = (obj['Size'], int(obj['LastModified'].timestamp()))
    return index


_LAYER_SIDECAR = re.compile(r'^(?P<stem>.+?)\.layer\..+\.(?:by_gene|by_cell)\.parquet$')


def _sidecar_stem(name: str) -> Optional[str]:
    """The dataset stem a sidecar file name carries, or None for other files."""
    match = _LAYER_SIDECAR.match(name)
    if match:
        return match.group('stem')
    for suffix in ('.de.parquet', '.scores.parquet'):
        if name.endswith(suffix):
            return name[:-len(suffix)]
    return None


def _bundle_owner(rel: str, stems_by_dir: Dict[str, Set[str]]) -> Optional[str]:
    """The ``.duckdb`` rel a per-dataset sidecar belongs to, or None.

    Only an exact stem match counts: ``foo.layer.X.by_gene.parquet``,
    ``foo.de.parquet`` and ``foo.scores.parquet`` belong to ``foo.duckdb`` in the
    same folder. ``foo.sub.de.parquet`` without a ``foo.sub.duckdb`` belongs to
    nobody (it is left alone), never to ``foo.duckdb``.
    """
    folder, _, name = rel.rpartition('/')
    stem = _sidecar_stem(name)
    if stem is None or stem not in stems_by_dir.get(folder, ()):
        return None
    return f"{folder}/{stem}.duckdb" if folder else f"{stem}.duckdb"


def _is_priority_global(rel: str) -> bool:
    """Files a priority site always mirrors, whatever its dataset budget: the root
    fleet indexes, the shared caches and facet results (SYNC_PATH_PREFIXES) and
    per-group static/ files. Never an .h5ad or a .duckdb."""
    if rel.endswith('.h5ad') or rel.endswith('.duckdb'):
        return False
    if rel.startswith(SYNC_PATH_PREFIXES):
        return True
    if '/' not in rel:
        return True
    return _is_static_path(rel)


def _split_priority_index(s3_meta: Dict[str, Tuple[int, int]]
                          ) -> Tuple[Dict[str, Tuple[int, int]], Dict[str, Dict[str, Tuple[int, int]]],
                                     Dict[str, Tuple[int, int]]]:
    """(duckdbs, sidecars per duckdb, global files) of a full S3 index. Everything
    else (.h5ad, sidecars of datasets without a duckdb on S3) is left out."""
    duckdbs = {rel: meta for rel, meta in s3_meta.items() if rel.endswith('.duckdb')}
    stems_by_dir: Dict[str, Set[str]] = {}
    for rel in duckdbs:
        folder, _, name = rel.rpartition('/')
        stems_by_dir.setdefault(folder, set()).add(name[:-len('.duckdb')])
    bundles: Dict[str, Dict[str, Tuple[int, int]]] = {rel: {} for rel in duckdbs}
    global_files: Dict[str, Tuple[int, int]] = {}
    for rel, meta in s3_meta.items():
        if rel in duckdbs or rel.endswith('.h5ad'):
            continue
        if _is_priority_global(rel):
            global_files[rel] = meta
            continue
        owner = _bundle_owner(rel, stems_by_dir)
        if owner is not None:
            bundles[owner][rel] = meta
    return duckdbs, bundles, global_files


def _file_status(path: Path, size: int, mtime: int, *, cheap_repull: bool) -> str:
    """HERE / TOUCH / PULL / PULL* of one file against its S3 (size, LastModified)."""
    if not path.exists():
        return 'PULL'
    stat = path.stat()
    if stat.st_size != size:
        return 'PULL*'
    if int(stat.st_mtime) == mtime:
        return 'HERE'
    if cheap_repull and size <= CHEAP_REPULL_BYTES and mtime > int(stat.st_mtime):
        return 'PULL*'
    return 'TOUCH'


def _build_priority_plan(
    s3_meta: Dict[str, Tuple[int, int]],
    priorities: Dict[str, int],
    data_folder: Path,
    policy: dict,
    free_now: int,
    bundles: Optional[Dict[str, Dict[str, Tuple[int, int]]]] = None,
    primary: bool = False,
) -> Tuple[list, int]:
    """Ordered fill plan for mode='priority'.

    Datasets are sorted priority desc, then S3 mtime desc (newest first), and
    greedily kept while projected final free space stays >= min_free. A
    dataset's size is its .duckdb plus its sidecars (``bundles``: layer
    parquets, .de/.scores parquets). The budget is (free_now + bytes of the
    files the plan may delete or replace that are ALREADY local): keeping a
    file that is already on disk consumes no new space, and evicting one frees it.

    ``primary`` (sync_policy.role is not slave): local sidecars may be work not
    pushed yet, so they are never replaced, re-stamped or evicted (status
    KEEP). They are therefore not in the budget (they never free space) and a
    kept dataset needs new space only for the sidecars it lacks. A dataset
    whose local sidecars differ from S3 keeps its local duckdb too (status
    KEEP): a new duckdb next to layer parquets of another version would be
    inconsistent.

    Returns (rows, baseline_free). Per-row status (of the .duckdb):
      HERE  - target, local, size+mtime match → nothing to do
      TOUCH - target, local, same size, mtime differs → realign mtime only
      PULL  - target, absent locally → download
      PULL* - target, local but size differs → overwrite (S3 canonical)
      KEEP  - primary: target, but its local sidecars differ from S3 → left as it is
      EVICT - below cutoff, local → delete (slave: S3 is the source of truth)
      SKIP  - below cutoff, absent → stays on S3
    Each row also lists ``sidecars`` as (rel, size, mtime, status, local_size).
    """
    bundles = bundles or {}
    min_free  = policy['min_free_bytes']
    max_local = policy['max_local_bytes']
    default   = policy['priority_default']

    local_meta: Dict[str, Tuple[int, int]] = {}
    local_bytes = 0
    for rel in s3_meta:
        if not rel.endswith('.duckdb'):
            continue
        for member in [rel, *bundles.get(rel, {})]:
            path = data_folder / member
            if path.exists():
                stat = path.stat()
                local_meta[member] = (stat.st_size, int(stat.st_mtime))
                if member == rel or not primary:
                    local_bytes += stat.st_size     # a primary never frees its sidecars
    baseline_free = free_now + local_bytes

    candidates = []
    for rel, (size, mtime) in s3_meta.items():
        if not rel.endswith('.duckdb'):
            continue
        priority = priorities.get(rel, default)
        if priority <= 0:
            continue  # 0 = inactive, never local
        candidates.append((priority, mtime, size, rel))
    candidates.sort(key=lambda row: (-row[0], -row[1], row[3]))

    rows = []
    cumulative = 0
    for priority, mtime, size, rel in candidates:
        is_local = rel in local_meta
        local_size, local_mtime = local_meta.get(rel, (None, None))
        sidecar_meta = bundles.get(rel, {})
        if primary:
            # local sidecars stay whatever happens: only the missing ones need room
            sidecar_need = sum(meta[0] for side, meta in sidecar_meta.items() if side not in local_meta)
        else:
            sidecar_need = sum(meta[0] for meta in sidecar_meta.values())
        bundle_size = size + sidecar_need
        tentative = cumulative + bundle_size
        fits = True
        if min_free is not None and (baseline_free - tentative) < min_free:
            fits = False
        if max_local is not None and tentative > max_local:
            fits = False
        sidecars = []
        if fits:
            cumulative = tentative
            in_target = True
            if is_local and local_size == size:
                # Same byte size ⇒ same content (different duckdb builds differ
                # in size). If only the mtime drifted, realign it locally —
                # never re-download just to fix a timestamp.
                status = 'HERE' if local_mtime == mtime else 'TOUCH'
            elif is_local:
                status = 'PULL*'   # size differs ⇒ content changed ⇒ re-pull
            else:
                status = 'PULL'
            for side_rel, (side_size, side_mtime) in sorted(sidecar_meta.items()):
                side_status = _file_status(data_folder / side_rel, side_size, side_mtime, cheap_repull=True)
                if primary and side_status in ('PULL*', 'TOUCH'):
                    side_status = 'KEEP'
                sidecars.append((side_rel, side_size, side_mtime, side_status,
                                 local_meta.get(side_rel, (None, None))[0]))
            if primary and status in ('PULL', 'PULL*', 'TOUCH') and any(entry[3] == 'KEEP' for entry in sidecars):
                # Keep the local version of the whole dataset: no new duckdb and no new
                # sidecar next to layer parquets of another version. It occupies what is
                # local now (its local duckdb is in the budget, local sidecars are not).
                cumulative -= bundle_size - (local_size or 0)
                bundle_size = local_size or 0
                status = 'KEEP'
                sidecars = [(entry[0], entry[1], entry[2],
                             'SKIP' if entry[4] is None else ('HERE' if entry[3] == 'HERE' else 'KEEP'), entry[4])
                            for entry in sidecars]
        else:
            in_target = False
            status = 'EVICT' if is_local else 'SKIP'
            for side_rel, (side_size, side_mtime) in sorted(sidecar_meta.items()):
                local_side = local_meta.get(side_rel)
                side_status = ('KEEP' if primary else 'EVICT') if local_side else 'SKIP'
                sidecars.append((side_rel, side_size, side_mtime, side_status,
                                 local_side[0] if local_side else None))
        rows.append(dict(
            rel=rel, priority=priority, mtime=mtime, size=size, bundle_size=bundle_size,
            is_local=is_local, local_size=local_size, local_mtime=local_mtime,
            in_target=in_target, status=status, sidecars=sidecars,
            cumulative=cumulative, projected_free=baseline_free - cumulative,
        ))
    return rows, baseline_free


def _print_priority_plan(rows: list, policy: dict, free_now: int,
                         baseline_free: int) -> None:
    """Render the full ordered fill plan (the dry-run view)."""
    import datetime
    min_free = policy['min_free_bytes']
    print(f"free now: {_fmt_size(free_now)}    "
          f"budget (free + local datasets): {_fmt_size(baseline_free)}    "
          f"min_free: {_fmt_size(min_free) if min_free is not None else 'none'}")
    print()
    header = (f"{'PRIO':>4}  {'UPDATED':>10}  {'SIZE':>9}  {'CUMUL':>9}  "
              f"{'FREE→':>9}  {'STATUS':6}  DATASET (+sidecars)")
    print(header)
    print('-' * len(header))
    cutoff_printed = False
    for row in rows:
        if not row['in_target'] and not cutoff_printed:
            label = (f"min_free floor {_fmt_size(min_free)}"
                     if min_free is not None else "cap reached")
            print(f"   ── cutoff: {label} — everything below stays on S3 "
                  f"(local copies evicted) ──")
            cutoff_printed = True
        date = datetime.datetime.fromtimestamp(row['mtime'], datetime.timezone.utc).strftime('%Y-%m-%d')
        side_note = ''
        sidecars = row.get('sidecars') or []
        if sidecars:
            busy = sum(1 for entry in sidecars if entry[3] in ('PULL', 'PULL*'))
            side_note = f"  (+{len(sidecars)} sidecars" + (f", {busy} to pull" if busy else '') + ')'
        print(f"{row['priority']:>4}  {date:>10}  {_fmt_size(row.get('bundle_size', row['size'])):>9}  "
              f"{_fmt_size(row['cumulative']):>9}  "
              f"{_fmt_size(row['projected_free']):>9}  "
              f"{row['status']:6}  {row['rel']}{side_note}")

    def _count(statuses: set) -> int:
        return sum(1 for row in rows if row['status'] in statuses)

    def _sum_bytes(statuses: set, key: str) -> int:
        return sum(row[key] for row in rows if row['status'] in statuses)

    print()
    print(f"  PULL  {_count({'PULL'})} absent ({_fmt_size(_sum_bytes({'PULL'}, 'size'))})"
          f"  +  {_count({'PULL*'})} size-changed "
          f"({_fmt_size(_sum_bytes({'PULL*'}, 'size'))})")
    print(f"  HERE  {_count({'HERE'})} already current  "
          f"+  TOUCH {_count({'TOUCH'})} realign mtime only (no download)")
    if _count({'KEEP'}):
        print(f"  KEEP  {_count({'KEEP'})} kept in their local version (primary: local sidecars differ from S3)")
    print(f"  EVICT {_count({'EVICT'})} ({_fmt_size(_sum_bytes({'EVICT'}, 'local_size'))})")
    print(f"  SKIP  {_count({'SKIP'})} stay on S3")
    if rows:
        print(f"  projected free afterwards: {_fmt_size(rows[-1]['projected_free'])}")


_API_URL_WARNED = {'done': False}


def _ant_serve_url(cfg: dict) -> str:
    """Base URL of this instance's ant-serve (``config.get_api_url``: ANTHIVE_API_URL > api_url > localhost).

    Warns once when the URL names a compose service (``http://api:8080`` of the ingest role's config) and
    this process is not in a container: release, restore and rescan then reach nothing."""
    import config as config_module  # noqa: PLC0415
    from urllib.parse import urlsplit  # noqa: PLC0415
    url = config_module.get_api_url(cfg)
    host = urlsplit(url).hostname or ''
    in_container = Path('/.dockerenv').exists() or Path('/run/.containerenv').exists()
    if host and '.' not in host and host != 'localhost' and not in_container and not _API_URL_WARNED['done']:
        _API_URL_WARNED['done'] = True
        print(f"WARNING: api_url {url} resolves only inside the container network: ant-serve will not be told "
              f"to release, restore or rescan. On a container site's host use the watcher config "
              f"(`ant-stack config-path --role watcher`) or set ANTHIVE_API_URL=http://127.0.0.1:<ports.tools>.",
              file=sys.stderr)
    return url


def _admin_post(base_url: str, path: str, timeout: float = 120.0):
    """Best-effort POST to an ant-serve /admin endpoint.

    Returns the HTTP status (int) or None if ant-serve is unreachable. Never
    raises — the sync must proceed even when the server is down (in which case
    no handles are held, so there is nothing to coordinate anyway).
    """
    import urllib.request
    import urllib.error
    try:
        req = urllib.request.Request(base_url + path, method='POST', headers=__import__('config').internal_auth_headers())
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return resp.status
    except urllib.error.HTTPError as exc:
        return exc.code            # e.g. 404 (db not in the catalog) — fine
    except Exception:
        return None                # server down / unreachable — fine


def _db_id_from_rel(rel: str) -> str:
    return rel[:-len('.duckdb')] if rel.endswith('.duckdb') else rel


def _release_db(base_url: str, rel: str) -> None:
    """Tell ant-serve to drop its handle on a duckdb BEFORE we unlink/overwrite
    it, so the freed blocks are actually reclaimed (an open fd on a deleted file
    pins ~its full size until the process closes it — the leak we saw)."""
    import urllib.parse
    db_id = urllib.parse.quote(_db_id_from_rel(rel), safe='/')
    _admin_post(base_url, f"/admin/release/{db_id}"
                          "?duration_seconds=3600&drain_timeout_seconds=15")


def _global_plan(global_files: Dict[str, Tuple[int, int]], data_folder: Path, primary: bool = False) -> list:
    """(rel, size, mtime, status) of every always-mirrored file of a priority site. On a primary a local
    copy that differs from S3 is KEEP (never overwritten or re-stamped: it may be unpushed work)."""
    plan = []
    for rel, (size, mtime) in sorted(global_files.items()):
        status = _file_status(data_folder / rel, size, mtime, cheap_repull=True)
        if primary and status in ('PULL*', 'TOUCH'):
            status = 'KEEP'
        plan.append((rel, size, mtime, status))
    return plan


def _run_priority(args, policy: dict, s3_cfg: dict, data_folder: Path, *,
                  do_evict: bool, do_pull: bool, dry_run: bool,
                  git_refresh: Optional[bool] = None) -> None:
    """Unified mode='priority' driver — fill the disk with the highest-priority
    datasets (newest first within a priority) until ~min_free_space remains.

    A dataset is its .duckdb plus its sidecars (layer parquets, .de/.scores
    parquets), pulled and evicted together. The root fleet indexes, the shared
    caches, `_facet_tests/` and per-group static/ files are always mirrored.
    Never an .h5ad (use `pull --only .h5ad` for that).

    Shared by `pull`(+--evict), `evict`, and `plan`. Slave semantics: S3 is the
    source of truth, so eviction never needs a size/mtime guard and the tool
    never pushes. ``dry_run`` transfers, deletes and re-stamps nothing and
    does not git pull the h5adstore (``git_refresh`` overrides that, for `plan`).
    """
    if git_refresh is None:
        git_refresh = not dry_run
    if git_refresh:
        _git_pull_h5adstore(data_folder)
    else:
        print("h5adstore git pull: skipped (dry run; priorities from the current checkout)")
    if getattr(args, 'filter', None):
        print(f"WARNING: filter {args.filter!r} is ignored under sync_policy.mode='priority' "
              f"(use --only EXTS to bypass the policy for one run)")
    client = _s3_client(s3_cfg)
    bucket = s3_cfg['bucket']
    prefix = s3_cfg.get('prefix', '') or ''
    print('Scanning S3…')
    s3_full = _s3_index_with_mtime(client, bucket, prefix)
    s3_meta, bundles, global_files = _split_priority_index(s3_full)
    priorities = _read_priorities(data_folder, policy['priority_default'])
    free_now = _free_space(data_folder)
    # A primary is where scores, DE tables, the fleet indexes and the caches are made: a local copy
    # that differs from S3 may be work not pushed yet. The plan never overwrites, re-stamps or evicts
    # those there (KEEP) and budgets accordingly; it only fetches what is missing.
    primary = not is_slave(get_config())
    rows, baseline_free = _build_priority_plan(
        s3_meta, priorities, data_folder, policy, free_now, bundles=bundles, primary=primary)
    globals_plan = _global_plan(global_files, data_folder, primary=primary) if do_pull else []
    _print_priority_plan(rows, policy, free_now, baseline_free)
    kept = sum(1 for row in rows for entry in row['sidecars'] if entry[3] == 'KEEP') \
        + sum(1 for entry in globals_plan if entry[3] == 'KEEP')
    kept_datasets = [row['rel'] for row in rows if row['status'] == 'KEEP']
    if kept:
        print(f"\n  primary site: {kept} local sidecar/shared file(s) are kept as they are (not overwritten, "
              f"re-stamped or evicted; push them, or set sync_policy.role: slave)")
    for rel in kept_datasets:
        print(f"  KEEP {rel}: its local sidecars differ from S3, so the local version of the whole dataset stays "
              f"(no new duckdb next to layer parquets of another version)")
    if do_pull:
        busy = [entry for entry in globals_plan if entry[3] in ('PULL', 'PULL*')]
        print(f"\n  ALWAYS {len(globals_plan)} shared file(s) (fleet indexes, caches, facet results, static): "
              f"{len(busy)} to pull ({_fmt_size(sum(entry[1] for entry in busy))})")

    if dry_run:
        if do_pull:
            for entry in globals_plan:
                if entry[3] in ('PULL', 'PULL*'):
                    print(f"  would {'OVERWRITE' if entry[3] == 'PULL*' else 'DOWNLOAD'} {entry[0]}  ({_fmt_size(entry[1])})")
        print("\n(dry-run — nothing transferred or deleted)")
        return

    import os
    evicted = freed = pulled = skipped_no_room = touched = 0
    api_url = _ant_serve_url(get_config())
    overwritten_ids: list = []   # PULL* db_ids → restore (reopen fresh) afterwards

    # Realign timestamps for size-matching local files (no transfer) so they
    # read as current next run — kills spurious re-pulls and any rotation.
    for row in rows:
        if row['status'] == 'TOUCH':
            os.utime(data_folder / row['rel'], (row['mtime'], row['mtime']))
            touched += 1
        if row['in_target']:
            for side_rel, _size, side_mtime, side_status, _local in row['sidecars']:
                if side_status == 'TOUCH':
                    os.utime(data_folder / side_rel, (side_mtime, side_mtime))
                    touched += 1
    for rel, _size, mtime, status in globals_plan:
        if status == 'TOUCH':
            os.utime(data_folder / rel, (mtime, mtime))
            touched += 1
    if touched:
        print(f"Realigned mtime on {touched} unchanged local file(s) (no download).")

    if do_evict:
        print("\nEvicting below-cutoff local datasets (slave: S3 is canonical)…")
        for row in rows:
            if row['in_target']:
                continue
            path = data_folder / row['rel']
            if row['status'] == 'EVICT' and path.exists():
                _release_db(api_url, row['rel'])   # close ant-serve's fd first
                path.unlink()
                evicted += 1
                freed += row['local_size']
                print(f"  EVICTED {row['rel']}  ({_fmt_size(row['local_size'])})")
            for side_rel, _size, _mtime, side_status, local_size in row['sidecars']:
                side_path = data_folder / side_rel
                if side_status == 'EVICT' and side_path.exists():
                    side_path.unlink()
                    freed += local_size or 0
                    print(f"  EVICTED {side_rel}")
        if not evicted:
            print("  (nothing below the cutoff)")

    transfer = None
    if do_pull:
        transfer = _transfer_config(
            max_concurrency=args.max_concurrency,
            max_bandwidth=_parse_bandwidth(args.max_bandwidth) if args.max_bandwidth else None,
        )

    def _download(rel: str, size: int, mtime: int, verb: str) -> None:
        path = data_folder / rel
        path.parent.mkdir(parents=True, exist_ok=True)
        print(f"  {verb} {rel}  ({_fmt_size(size)})")
        client.download_file(
            bucket, _s3_key(rel, prefix), str(path),
            Config=transfer, Callback=_ProgressCallback(rel, size),
        )
        # Stamp local mtime to the S3 upload time so size+mtime is stable
        # next run (idempotent — no re-pull of an unchanged file).
        os.utime(path, (mtime, mtime))

    progress = {'pulled': 0}
    try:
        _priority_pulls(rows, globals_plan, do_pull, do_evict, policy, data_folder, _download,
                        api_url, overwritten_ids, progress)
    finally:
        pulled = progress['pulled']
        # Reopen overwritten dbs + refresh the catalog so ant-serve serves the fresh
        # files and forgets the evicted ones, also after a failed download (a released
        # db must never stay released). Best-effort; skipped if ant-serve is down.
        if evicted or pulled or overwritten_ids:
            import urllib.parse
            for db_id in overwritten_ids:
                _admin_post(api_url, f"/admin/restore/{urllib.parse.quote(db_id, safe='/')}")
            status = _admin_post(api_url, "/admin/rescan", timeout=600)
            print("ant-serve catalog refresh: "
                  + ("ok" if status == 200
                     else f"skipped (ant-serve not reachable / status={status})"))

    print(f"\nDone.  pulled={pulled} file(s)  realigned={touched}  "
          f"evicted={evicted} dataset(s) ({_fmt_size(freed)})")


def _priority_pulls(rows, globals_plan, do_pull, do_evict, policy, data_folder, _download, api_url,
                    overwritten_ids, progress):
    """The download phase of ``_run_priority``; counts pulled files in ``progress['pulled']`` as it goes
    (so the caller's cleanup knows them even when a download fails)."""
    skipped_no_room = 0
    if do_pull:
        print("\nPulling shared files (fleet indexes, caches, facet results, static)…")
        for rel, size, mtime, status in globals_plan:
            if status in ('PULL', 'PULL*'):
                if policy['min_free_bytes'] is not None and (_free_space(data_folder) - size) < policy['min_free_bytes']:
                    print(f"  SKIP {rel}: would breach min_free_space")
                    skipped_no_room += 1
                    continue
                _download(rel, size, mtime, 'OVERWRITE' if status == 'PULL*' else 'DOWNLOAD')
                progress['pulled'] += 1
        print("\nPulling target datasets (highest priority first)…")
        for row in rows:
            if not row['in_target']:
                continue
            todo_sidecars = [entry for entry in row['sidecars'] if entry[3] in ('PULL', 'PULL*')]
            if row['status'] not in ('PULL', 'PULL*') and not todo_sidecars:
                continue
            need = (row['size'] if row['status'] in ('PULL', 'PULL*') else 0) + sum(entry[1] for entry in todo_sidecars)
            # The floor is checked against the real free space before every dataset, with or without
            # --evict (evictions already ran; a plan that counted on space that was not freed must not
            # fill the disk past min_free_space).
            if policy['min_free_bytes'] is not None:
                if (_free_space(data_folder) - need) < policy['min_free_bytes']:
                    print(f"  SKIP {row['rel']}: would breach min_free_space "
                          f"(free {_fmt_size(_free_space(data_folder))}, needs {_fmt_size(need)})")
                    skipped_no_room += 1
                    continue
            if row['status'] in ('PULL', 'PULL*'):
                if row['status'] == 'PULL*':
                    _release_db(api_url, row['rel'])   # close handle before overwrite
                    overwritten_ids.append(_db_id_from_rel(row['rel']))
                _download(row['rel'], row['size'], row['mtime'],
                          'OVERWRITE' if row['status'] == 'PULL*' else 'DOWNLOAD')
                progress['pulled'] += 1
            for side_rel, side_size, side_mtime, side_status, _local in todo_sidecars:
                _download(side_rel, side_size, side_mtime, 'OVERWRITE' if side_status == 'PULL*' else 'DOWNLOAD')
                progress['pulled'] += 1
    if skipped_no_room:
        print(f"  skipped (no room): {skipped_no_room} dataset(s)")


def cmd_pull(args, s3_cfg: dict, data_folder: Path) -> None:
    client   = _s3_client(s3_cfg)
    bucket   = s3_cfg['bucket']
    prefix   = s3_cfg.get('prefix', '') or ''
    transfer = _transfer_config(
        max_concurrency=args.max_concurrency,
        max_bandwidth=_parse_bandwidth(args.max_bandwidth) if args.max_bandwidth else None,
    )

    cfg = get_config()
    policy = _load_sync_policy(cfg)
    mode = policy['mode']

    dry_run = bool(getattr(args, 'dry_run', False))
    # mode='priority': dedicated fill driver — keep the highest-priority
    # datasets (duckdb + sidecars, newest first within a priority) until
    # ~min_free_space remains, plus the shared files. --only is the explicit
    # ad-hoc override that bypasses it. --include-duckdb does NOT: on a priority
    # site it used to switch to the plain path, which pulled every raw .h5ad and
    # overwrote duckdbs under a live api.
    if mode == 'priority' and not args.only:
        if args.include_duckdb:
            print("(--include-duckdb has no effect under sync_policy.mode='priority': "
                  "the priority fill already pulls duckdbs with their sidecars)")
        _run_priority(args, policy, s3_cfg, data_folder,
                      do_evict=args.evict, do_pull=True, dry_run=dry_run)
        return

    # Policy mode determines the candidate extension set BEFORE
    # explicit flags. --only / --include-duckdb still override (for ad-hoc
    # ops where the user wants to bypass the policy this one run).
    if args.only:
        allowed = set()
        for raw in args.only.split(','):
            ext = raw.strip()
            if not ext:
                continue
            if not ext.startswith('.'):
                ext = '.' + ext
            if ext not in SYNC_EXTENSIONS:
                print(f"ant-sync pull: --only includes {ext!r} but it's not "
                      f"in the syncable set ({sorted(SYNC_EXTENSIONS)}). "
                      f"Aborting.")
                raise SystemExit(2)
            allowed.add(ext)
        if not allowed:
            print('ant-sync pull: --only is empty — nothing to pull.')
            return
        print(f'(pulling only {sorted(allowed)} per --only)')
    elif args.include_duckdb:
        allowed = SYNC_EXTENSIONS
    elif mode == 'duckdb':
        allowed = {'.duckdb'}
    else:
        # mode='all' or unknown — legacy default (h5ad + de.parquet)
        allowed = PULL_DEFAULT_EXTS
        print('(skipping .duckdb — pass --include-duckdb or --only .duckdb to override)')

    # `--only` / priority / duckdb modes want ONLY the requested ext.
    # Default + include_duckdb pulls also include per-group `static/**`
    # (paper PDFs, supp tables — small, always-present catalog metadata).
    include_static = args.only is None and mode not in ('priority', 'duckdb')
    print('Scanning S3…')
    s3_index = _s3_objects(client, bucket, prefix, allowed_exts=allowed,
                           include_static=include_static)

    if args.filter:
        s3_index = {rel: size for rel, size in s3_index.items()
                    if fnmatch.fnmatch(rel, args.filter)}

    print(f'Found {len(s3_index)} S3 file(s) to check.\n')

    # Outside mode='priority' nothing is evicted: --evict only acts in the
    # priority fill (and in `ant-sync evict`).
    target_set: Set[str] = set(s3_index.keys())
    if args.evict:
        print("(--evict only acts under sync_policy.mode='priority'; nothing is evicted here)")
    downloaded = skipped = skipped_no_fit = 0
    pull_list = sorted(target_set)

    slave_mode = is_slave(cfg)
    api_url = _ant_serve_url(cfg)
    overwritten_ids: list = []
    pulled_duckdb = {'any': False}

    try:
        for rel in pull_list:
            s3_size = s3_index[rel]
            local_path = data_folder / rel

            if local_path.exists() and local_path.stat().st_size == s3_size:
                # Slave mode: same size isn't enough — also check S3 mtime
                # metadata. If S3 says the file is different (mtime drift),
                # force re-download. Adds one HEAD per same-size file but
                # only on slaves where correctness > speed.
                if slave_mode:
                    s3_mt = _s3_mtime(client, bucket, _s3_key(rel, prefix))
                    local_mt = _local_mtime(local_path)
                    if s3_mt is not None and s3_mt != local_mt:
                        print(f'[FORCE]    {rel}  (slave: mtime drift, '
                              f'Δ={abs(s3_mt - local_mt)}s — overwriting)')
                        # Fall through to download below by NOT continuing
                    else:
                        skipped += 1
                        continue
                else:
                    skipped += 1
                    continue

            # min_free_space safety: don't pull a file that would push the
            # filesystem below the configured floor.
            if policy['min_free_bytes'] is not None:
                free_now = _free_space(data_folder)
                if (free_now - s3_size) < policy['min_free_bytes']:
                    print(f"  SKIP {rel}: would push below min_free_space "
                          f"({_fmt_size(free_now)} free, needs {_fmt_size(s3_size)})."
                          f" Run sync-pull-evict to make room.")
                    skipped_no_fit += 1
                    continue

            action = 'UPDATE' if local_path.exists() else 'DOWNLOAD'
            if dry_run:
                print(f'[would {action}] {rel}  ({_fmt_size(s3_size)})')
                downloaded += 1
                continue
            print(f'[{action}] {rel}  ({_fmt_size(s3_size)})')

            local_path.parent.mkdir(parents=True, exist_ok=True)
            if rel.endswith('.duckdb') and local_path.exists():
                _release_db(api_url, rel)            # never overwrite a duckdb under an open handle
                overwritten_ids.append(_db_id_from_rel(rel))
            callback = _ProgressCallback(rel, s3_size)
            client.download_file(
                bucket,
                _s3_key(rel, prefix),
                str(local_path),
                Config=transfer,
                Callback=callback,
            )
            downloaded += 1
            pulled_duckdb['any'] = pulled_duckdb['any'] or rel.endswith('.duckdb')
    finally:
        # Restore every released duckdb and rescan, also when a download failed half-way
        # (a released db must never stay released; a new duckdb must be listed).
        if overwritten_ids or pulled_duckdb['any']:
            import urllib.parse
            for db_id in overwritten_ids:
                _admin_post(api_url, f"/admin/restore/{urllib.parse.quote(db_id, safe='/')}")
            status = _admin_post(api_url, "/admin/rescan", timeout=600)
            print("ant-serve catalog refresh: "
                  + ("ok" if status == 200 else f"skipped (ant-serve not reachable / status={status})"))

    print()
    if dry_run:
        print("(dry-run — nothing transferred or deleted)")
    print(f"{'Dry run' if dry_run else 'Done'}.  {'would download' if dry_run else 'downloaded'}={downloaded}  skipped (up-to-date)={skipped}", end='')
    if skipped_no_fit:
        print(f"  skipped (no room)={skipped_no_fit}", end='')
    print()


def cmd_evict(args, s3_cfg: dict, data_folder: Path) -> None:
    """Evict local .duckdbs below the priority cutoff (no pulling).

    Slave semantics: S3 is the source of truth, so a below-cutoff local file
    is always re-pullable — eviction needs no size/mtime guard. Files absent
    from S3 are never candidates (they aren't in the plan), so local-only work
    is never deleted.
    """
    cfg = get_config()
    policy = _load_sync_policy(cfg)
    if policy['mode'] != 'priority':
        print(f"ant-sync evict: sync_policy.mode is {policy['mode']!r} — eviction "
              f"only runs under mode='priority'. Set it in anthive.yaml.")
        return
    _run_priority(args, policy, s3_cfg, data_folder,
                  do_evict=True, do_pull=False, dry_run=args.dry_run)


def cmd_plan(args, s3_cfg: dict, data_folder: Path) -> None:
    """Dry-run: print the full ordered fill plan (what sync-pull-evict would do).

    Lists every active dataset in fill order (priority desc, newest first),
    with size, cumulative, projected free space, and per-dataset action
    (HERE / PULL / PULL* / EVICT / SKIP), plus the min_free cutoff line.
    """
    cfg = get_config()
    policy = _load_sync_policy(cfg)
    if policy['mode'] != 'priority':
        print(f"sync_policy.mode={policy['mode']!r} — the priority fill plan "
              f"applies only to mode='priority'.")
        return
    _run_priority(args, policy, s3_cfg, data_folder,
                  do_evict=False, do_pull=False, dry_run=True)


def cmd_status(args, s3_cfg: dict, data_folder: Path) -> None:
    client = _s3_client(s3_cfg)
    bucket = s3_cfg['bucket']
    prefix = s3_cfg.get('prefix', '') or ''

    print('Scanning local and S3…')
    local_files = _local_files(data_folder, args.filter)
    local_index = {rel: (path, path.stat().st_size, _local_mtime(path))
                   for path, rel in local_files}
    s3_index    = _s3_objects(client, bucket, prefix)
    if args.filter:
        s3_index = {rel: size for rel, size in s3_index.items()
                    if fnmatch.fnmatch(rel, args.filter)}

    all_keys   = sorted(set(local_index) | set(s3_index))
    only_local = only_s3 = modified = mtime_drift = in_sync = 0

    for rel in all_keys:
        local_entry = local_index.get(rel)
        s3_size     = s3_index.get(rel)
        local_size  = local_entry[1] if local_entry else None
        local_mt    = local_entry[2] if local_entry else None

        if local_size is not None and s3_size is None:
            print(f'  LOCAL ONLY   {rel}  ({_fmt_size(local_size)})')
            only_local += 1
        elif s3_size is not None and local_size is None:
            print(f'  S3 ONLY      {rel}  ({_fmt_size(s3_size)})')
            only_s3 += 1
        elif local_size != s3_size:
            print(f'  MODIFIED     {rel}  '
                  f'(local {_fmt_size(local_size)}, s3 {_fmt_size(s3_size)})')
            modified += 1
        else:
            # Same size — fetch S3 mtime metadata and compare. If S3 mtime
            # is missing, treat as in-sync (legacy upload pre-mtime header).
            s3_mt = _s3_mtime(client, bucket, _s3_key(rel, prefix))
            if s3_mt is not None and local_mt is not None and local_mt != s3_mt:
                direction = 'local newer' if local_mt > s3_mt else 's3 newer'
                print(f'  MTIME DRIFT  {rel}  ({direction}, '
                      f'Δ={abs(local_mt - s3_mt)}s, size matches)')
                mtime_drift += 1
            else:
                in_sync += 1

    print(f'\nLocal only: {only_local},  S3 only: {only_s3},  '
          f'modified: {modified},  mtime drift: {mtime_drift},  '
          f'in sync: {in_sync}')


def _sync_library(args, s3_cfg: dict, push: Optional[bool] = None) -> int:
    """Two-way sync of the paper library (records via git, PDFs via S3) and
    the literature index (publisher rule). Same behaviour for push, pull and
    `ant sync library`: the library has no single direction. Returns the
    number of errors."""
    import subprocess  # noqa: PLC0415
    from config import get_library_dir, get_library_index_dir  # noqa: PLC0415
    import library_sync as ls  # noqa: PLC0415
    cfg = get_config()
    library_dir = get_library_dir(cfg)
    index_dir = get_library_index_dir(cfg)
    client = _s3_client(s3_cfg)
    bucket = s3_cfg['bucket']
    prefix = s3_cfg.get('prefix', '') or ''
    dry_run = bool(getattr(args, 'dry_run', False))
    read_only = is_slave(cfg)
    errors = 0
    print('\nLibrary (two-way):' + ('  [read-only site: downloads only]' if read_only else ''))

    # 1. records: git pull --rebase, push when allowed
    if not getattr(args, 'no_git', False):
        allow_push = bool(cfg.get('library_git_push', False)) and not read_only
        git = ls.git_sync(library_dir, push=allow_push, dry_run=dry_run)
        print(f"  records (git): {git['status']}: {git['detail']}")
        errors += git['status'] in ('conflict', 'push_failed')

    # 2. PDFs: two-way against S3
    papers_report = None
    if (library_dir / 'papers').is_dir():
        papers_report = ls.sync_library_pdfs(
            client, bucket, prefix, library_dir, dry_run=dry_run,
            propagate_deletes=bool(getattr(args, 'propagate_deletes', False)),
            prefer=getattr(args, 'prefer', None), allow_remote_writes=not read_only,
            say=lambda msg: print('  ' + msg))
        counts = {k: papers_report.count(k) for k in
                  ('upload', 'download', 'conflict', 'move_remote', 'move_local', 'delete_remote',
                   'delete_local', 'report', 'resolve_local', 'resolve_remote')}
        busy = ', '.join(f"{k.replace('_', ' ')} {v}" for k, v in counts.items() if v) or 'in sync'
        print(f"  papers (S3): {busy}" + (' [dry run]' if dry_run else ''))
        for error in papers_report.errors:
            print(f"  ERROR {error}")
        errors += len(papers_report.errors)
    else:
        print(f"  papers (S3): skipped, {library_dir}/papers does not exist (clone the library repo there)")

    # 3. literature index: derived data. Publisher sites push it; others pull
    #    it only when missing or older, then add their local papers.
    publisher = bool(cfg.get('library_index_publisher', False)) and not read_only
    pulled = False
    if not publisher and not cfg.get('library_index_pull', True):
        print('  index: not pulled (library_index_pull is false: this site builds its own index)')
    elif not publisher:
        try:
            if not dry_run:
                index_dir.mkdir(parents=True, exist_ok=True)
            pulled = ls.pull_index_if_newer(client, bucket, prefix, index_dir, dry_run=dry_run,
                                            say=lambda msg: print('  ' + msg))
        except OSError as exc:
            print(f"  index: cannot write {index_dir}: {exc}")
    changed = bool(papers_report and papers_report.changed_local) or pulled or bool(getattr(args, 'reindex', False))
    if changed and not getattr(args, 'no_index', False) and (library_dir / 'papers').is_dir() and not dry_run:
        tool = Path(__file__).resolve().parent.parent / 'meta' / 'ant-lib-index'
        cmd = [str(tool), '--add', '--library', str(library_dir),
               '--out', str(index_dir / ls.INDEX_FILENAME)]
        print('  index: adding new or changed papers (ant lib-index --add)')
        result = subprocess.run(cmd, capture_output=True, text=True)
        tail = (result.stdout.strip().splitlines() or [''])[-1]
        if result.returncode not in (0, 2):
            print(f"  index: update failed ({result.returncode}): {(result.stderr or tail).strip()[-300:]}")
            errors += 1
        else:
            print(f"  index: {tail}")
    if publisher:
        report = ls.push_area(client, bucket, prefix, ls.index_area(index_dir), dry_run=dry_run,
                              say=lambda msg: print('  ' + msg))
        print('  ' + ls.summarize([report], 'uploaded')[0] + ' (this site publishes the index)')
    return errors


def main() -> None:
    parser = argparse.ArgumentParser(
        prog='ant-sync',
        description='Push/pull .h5ad and .duckdb files to/from S3.',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__,
    )
    parser.add_argument(
        '--data-folder', default=str(__import__('config').get_data_folder()),
        help='Root of the h5adstore (default: h5adstore key / ANTHIVE_H5ADSTORE)',
    )

    subparsers = parser.add_subparsers(dest='command', required=True)

    push_sub = subparsers.add_parser('push', help='Upload local files to S3')
    push_sub.add_argument(
        'filter', nargs='?', default=None,
        help='Optional glob filter relative to data-folder',
    )
    push_sub.add_argument(
        '--skip-no-mtime', action='store_true',
        help=('When a same-size file has no S3 mtime metadata (legacy upload), '
              'treat as in-sync rather than re-uploading. Useful for a no-op '
              'first run after deploying the mtime feature.'),
    )
    push_sub.add_argument(
        '--max-bandwidth', default=None,
        help='Cap upload bandwidth, e.g. "4M" (= 4 MB/s) or "500K". '
             'Default: unlimited.',
    )
    push_sub.add_argument(
        '--max-concurrency', type=int, default=4,
        help='Parallel multipart upload chunks (default 4). Lower it to '
             'reduce CPU + socket pressure.',
    )
    push_sub.add_argument(
        '--no-rebuild-variability', action='store_true',
        help=('Skip the pre-push check that rebuilds '
              'module_variability.parquet when any *.scores.parquet '
              'sidecar is newer. Use for surgical pushes where the '
              'aggregate is known to be current (or when the scoring '
              'fleet is still running).'),
    )

    def _library_flags(sub, with_dry_run: bool = False) -> None:
        sub.add_argument('--propagate-deletes', action='store_true',
                         help='library: delete a PDF on the other side when it was deleted on one side '
                              '(default: report only)')
        sub.add_argument('--prefer', choices=['local', 'remote'], default=None,
                         help='library: resolve PDF conflicts by keeping the local or the S3 copy')
        sub.add_argument('--no-git', action='store_true',
                         help='library: do not git pull/push the paper records')
        sub.add_argument('--no-index', action='store_true',
                         help='library: do not update the literature index after PDF changes')
        sub.add_argument('--reindex', action='store_true',
                         help='library: run the incremental index update even if no PDF changed')
        if with_dry_run:
            sub.add_argument('--dry-run', action='store_true', help='print the plan, change nothing')

    push_sub.add_argument('--dry-run', action='store_true',
                          help='print what would be uploaded (and the library plan), change nothing')

    for sub in (push_sub,):
        sub.add_argument('--no-library', action='store_true',
                         help='skip the library PDFs and the literature index')
        sub.add_argument('--library-only', action='store_true',
                         help='only the library PDFs and the literature index (not the h5adstore)')
        _library_flags(sub)

    pull_sub = subparsers.add_parser('pull', help='Download S3 files locally')
    pull_sub.add_argument(
        'filter', nargs='?', default=None,
        help='Optional glob filter relative to data-folder',
    )
    pull_sub.add_argument(
        '--include-duckdb', action='store_true',
        help=('Also pull .duckdb files. By default only .h5ad and '
              '.de.parquet are pulled — .duckdb should be rebuilt '
              'locally via `make build-stale`. No effect under '
              "sync_policy.mode='priority', which pulls duckdbs with their "
              'sidecars and never .h5ad.'),
    )
    pull_sub.add_argument(
        '--only', default=None, metavar='EXTS',
        help=('Pull ONLY these extensions (comma-separated, e.g. '
              "'.duckdb' or '.h5ad,.de.parquet').  Overrides the default "
              'set and --include-duckdb.  Useful for surgical pulls like '
              '"just refresh the duckdbs without re-downloading h5ads".'),
    )
    pull_sub.add_argument(
        '--max-bandwidth', default=None,
        help='Cap download bandwidth, e.g. "4M". Default: unlimited.',
    )
    pull_sub.add_argument(
        '--max-concurrency', type=int, default=4,
        help='Parallel multipart download chunks (default 4).',
    )
    pull_sub.add_argument(
        '--evict', action='store_true',
        help=("Only under sync_policy.mode='priority' (ignored otherwise): in "
              "the same pass, also REMOVE local datasets (.duckdb and, on a "
              "slave, its sidecars) that fell below the current cutoff. S3 "
              "is the source of truth, so they are re-pullable. A primary "
              "never evicts sidecars or shared files. Without --evict, files "
              "below the cutoff stay and the pull only fetches what fits."),
    )
    pull_sub.add_argument(
        '--dry-run', action='store_true',
        help=("Print what would be pulled or evicted and change nothing, on "
              "every path (mode='priority': the full ordered fill plan; "
              "library: the PDF plan). No download, delete, mtime change "
              "or h5adstore git pull."),
    )

    pull_sub.add_argument('--no-library', action='store_true',
                          help='skip the library PDFs and the literature index')
    pull_sub.add_argument('--library-only', action='store_true',
                          help='only the library PDFs and the literature index (not the h5adstore)')
    _library_flags(pull_sub)

    library_sub = subparsers.add_parser(
        'library',
        help=('Two-way sync of the paper library only: records via git, PDFs via S3 '
              '(both directions, conflicts kept), then the literature index'))
    _library_flags(library_sub, with_dry_run=True)

    evict_sub = subparsers.add_parser(
        'evict',
        help=("Remove local datasets below the current sync_policy cutoff "
              "(requires sync_policy.mode='priority'). Only datasets whose "
              ".duckdb is on S3 are candidates; the local copy is deleted "
              "without a size check (S3 is canonical). On a slave its "
              "sidecars go too; a primary keeps sidecars and shared files."),
    )
    evict_sub.add_argument(
        '--dry-run', action='store_true',
        help='Print what would be evicted without deleting anything.',
    )

    plan_sub = subparsers.add_parser(
        'plan',
        help=("Show priority distribution + what the current sync_policy "
              "would pull/evict. Reads S3 for canonical sizes by default; "
              "pass --local to skip the S3 query."),
    )
    plan_sub.add_argument(
        '--local', action='store_true',
        help='Use local .duckdb sizes only (no S3 listing). Faster but '
             'only shows what is currently on disk — useful when offline.',
    )

    stamp_sub = subparsers.add_parser(
        'stamp-sha256', help='Set x-amz-meta-sha256 on catalogue .h5ad objects that lack it (in-place copy)')
    stamp_sub.add_argument('filter', nargs='?', default=None, help='Optional glob filter relative to data-folder')
    stamp_sub.add_argument('--dry-run', action='store_true', help='Show the plan, change nothing')
    status_sub = subparsers.add_parser('status', help='Show local/S3 sync state')
    status_sub.add_argument(
        'filter', nargs='?', default=None,
        help='Optional glob filter relative to data-folder',
    )

    args        = parser.parse_args()
    config      = get_config()
    s3_cfg      = config.get('s3') or {}
    bucket      = s3_cfg.get('bucket')

    if not bucket:
        print('Error: s3.bucket is not set in anthive.yaml (on a container site: S3 is off, see s3.enabled in site.yaml)', file=sys.stderr)
        sys.exit(1)
    if not s3_cfg.get('access_key_id'):
        print('Error: s3.access_key_id is not set in anthive.yaml', file=sys.stderr)
        sys.exit(1)

    data_folder = Path(args.data_folder).resolve()
    if not data_folder.exists():
        print(f'Error: data folder not found: {data_folder}', file=sys.stderr)
        sys.exit(1)

    if args.command in ('push', 'pull'):
        if args.no_library and args.library_only:
            print('Error: --no-library and --library-only exclude each other', file=sys.stderr)
            sys.exit(2)
        if args.command == 'push' and args.library_only:
            require_primary(tool='ant-sync push')
        if not args.library_only:
            (cmd_push if args.command == 'push' else cmd_pull)(args, s3_cfg, data_folder)
        if not args.no_library:
            _sync_library(args, s3_cfg, push=(args.command == 'push'))
    elif args.command == 'library':
        sys.exit(1 if _sync_library(args, s3_cfg) else 0)
    elif args.command == 'evict':
        cmd_evict(args, s3_cfg, data_folder)
    elif args.command == 'plan':
        cmd_plan(args, s3_cfg, data_folder)
    elif args.command == 'status':
        cmd_status(args, s3_cfg, data_folder)
    elif args.command == 'stamp-sha256':
        cmd_stamp(args, s3_cfg, data_folder)


def _run() -> int:
    """main() with an unreachable S3 endpoint reported in one line instead of a traceback."""
    from botocore.exceptions import ConnectionError as BotoConnectionError, ReadTimeoutError  # noqa: PLC0415
    try:
        main()
    except (BotoConnectionError, ReadTimeoutError) as error:
        endpoint = (get_config().get('s3') or {}).get('endpoint') or 'the default AWS endpoint'
        print(f'Error: cannot reach the S3 endpoint {endpoint}: {error}', file=sys.stderr)
        return 3
    return 0


if __name__ == '__main__':
    sys.exit(_run())
