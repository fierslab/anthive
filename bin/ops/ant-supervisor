#!/usr/bin/env -S uv run --quiet --script
# /// script
# dependencies = [
#   "pyyaml>=6.0",
# ]
# ///
"""
Anthive process supervisor

Starts all backend services, multiplexes their output with colored labels,
and auto-restarts any crashed child process.

Subcommands (control plane):
  ant-supervisor                         # run all services (default)
  ant-supervisor --caddy                 # run with Caddy on :8501
  ant-supervisor restart <name>…         # SIGTERM a running child by name
  ant-supervisor restart all             # SIGTERM every running child
  ant-supervisor status                  # show supervisor + child PIDs
"""

import argparse
import asyncio
import json
import os
import shutil
import signal
import sys
import textwrap
import time
from datetime import datetime
from pathlib import Path

# ANSI color codes
CYAN    = '\033[36m'
GREEN   = '\033[32m'
MAGENTA = '\033[35m'
YELLOW  = '\033[33m'
BLUE    = '\033[34m'
RED     = '\033[31m'
RESET   = '\033[0m'
BOLD    = '\033[1m'
DIM     = '\033[2m'

_script_dir = Path(__file__).parent.parent.parent.resolve()

# Read host/port from anthive.yaml so the supervisor doesn't override the
# user's config.  Default is `localhost` (secure) — see anthive.default.yaml.
sys.path.insert(0, str(_script_dir / 'lib'))
try:
    from config import load_config as _load_anthive_config
    _CFG = _load_anthive_config()
except Exception:
    _CFG = {}

_API_HOST    = _CFG.get('rest_api_host', 'localhost')
_API_PORT    = str(_CFG.get('rest_api_port', 8080))
_BROWSE_HOST = _CFG.get('browse_host',    'localhost')
_BROWSE_PORT = str(_CFG.get('browse_port', 8081))
# ant-browse connects TO ant-serve; use loopback when serve is bound there.
_API_INTERNAL_URL = f"http://{'localhost' if _API_HOST in ('127.0.0.1', 'localhost') else _API_HOST}:{_API_PORT}"

SERVICES: dict = {
    'api': {
        'cmd': ['./bin/api/ant-serve', '--data-folder', './data/h5adstore',
                '--host', _API_HOST, '--port', _API_PORT],
        'color': CYAN,
    },
    'browse': {
        # ant-browse lives at the top of the tree (./web/), not under bin/,
        # so the web UI is a peer of api/lib/data — not an ant-* subcommand.
        'cmd': ['./web/ant-browse', '--api-url', _API_INTERNAL_URL,
                '--host', _BROWSE_HOST, '--port', _BROWSE_PORT],
        'color': GREEN,
    },
    'mcp': {
        'cmd': ['./bin/api/ant-mcp'],
        'color': MAGENTA,
    },
    'streamlit': {
        'cmd': [
            'uvx',
            '--with', 'streamlit',
            '--with', 'matplotlib',
            '--with', 'seaborn',
            '--with', 'scipy',
            '--with', 'numpy',
            '--with', 'pandas',
            '--with', 'requests',
            'streamlit', 'run', 'streamlit_app.py',
            '--server.baseUrlPath', 'streamlit',
            '--server.headless', 'true',
            '--server.port', '8082',
        ],
        'cwd': 'frontend/streamlit',
        'color': YELLOW,
    },
    'caddy': {
        'cmd': ['caddy', 'run', '--config', 'config/Caddyfile'],
        'color': BLUE,
    },
    'authelia': {
        # `env VAR=value …` is a portable way to inject env vars without
        # threading them through ant-supervisor's subprocess plumbing.
        # Secrets are read from files (gitignored).
        'cmd': [
            'env',
            'AUTHELIA_SESSION_SECRET_FILE=./config/authelia/secrets/session',
            'AUTHELIA_STORAGE_ENCRYPTION_KEY_FILE=./config/authelia/secrets/encryption',
            'AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET_FILE=./config/authelia/secrets/jwt',
            'AUTHELIA_NOTIFIER_SMTP_PASSWORD_FILE=./config/authelia/secrets/smtp',
            './envs/authelia/authelia',
            '--config', './config/authelia/configuration.yml',
        ],
        'color': YELLOW,
    },
}

# Services intentionally NOT in the default set:
#   * mcp        — vark (CLI/skill) is the LLM-facing path now.
#   * streamlit  — superseded by ant-browse (per-dataset plot UI ships the
#                  same gene / cat / num plots via /browse/...).  The
#                  source under frontend/streamlit/ is kept for reference
#                  and one-off runs (`make serve-streamlit`) but isn't
#                  part of the production stack any more.
#
# To re-enable either: add the name back to DEFAULT_SERVICES, OR launch
# it standalone (`make serve-mcp` / `make serve-streamlit`).
DEFAULT_SERVICES = ['api', 'browse', 'authelia']

# Back-off settings
BACKOFF_INITIAL     = 2   # seconds
BACKOFF_MAX         = 30  # seconds
BACKOFF_MULTIPLIER  = 2
CLEAN_RUN_THRESHOLD = 10  # seconds; if process lived this long, reset back-off

# Control-plane state file. Written by the running supervisor; read by the
# `restart` / `status` subcommands to know which PIDs to signal.
STATE_FILE = _script_dir / 'tmp' / 'supervisor-state.json'

# Set by the run loop; read by _write_state. Module-global because the
# write happens inside per-service tasks and it's cheaper than threading
# the value through.
_started_at: str = ''


def _write_state(active_processes: dict, started_at: str) -> None:
    """Snapshot supervisor + child PIDs to STATE_FILE."""
    try:
        STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
        state = {
            'supervisor_pid': os.getpid(),
            'started_at':     started_at,
            'updated_at':     datetime.now().isoformat(timespec='seconds'),
            'services': {
                name: {'pid': proc.pid}
                for name, proc in active_processes.items()
            },
        }
        STATE_FILE.write_text(json.dumps(state, indent=2) + '\n')
    except OSError:
        pass  # state file is advisory; don't crash the supervisor over it


def _read_state() -> dict | None:
    if not STATE_FILE.exists():
        return None
    try:
        return json.loads(STATE_FILE.read_text())
    except (OSError, json.JSONDecodeError):
        return None


def _pid_alive(pid: int) -> bool:
    """Cheap check — signal 0 raises if the process doesn't exist."""
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
        return True
    except (OSError, ProcessLookupError):
        return False


def cmd_status() -> int:
    """Print the current supervisor state and exit."""
    state = _read_state()
    if state is None:
        print('No supervisor state file found (is the supervisor running?)')
        return 1
    sup_pid = state.get('supervisor_pid')
    print(f"supervisor pid: {sup_pid}  ({'alive' if _pid_alive(sup_pid) else 'DEAD'})")
    print(f"started_at:     {state.get('started_at')}")
    print(f"updated_at:     {state.get('updated_at')}")
    print('services:')
    for name, info in (state.get('services') or {}).items():
        pid = info.get('pid')
        status = 'alive' if _pid_alive(pid) else 'dead'
        print(f"  {name:10s} pid={pid:<7d} {status}")
    return 0


def cmd_restart(service_names: list[str]) -> int:
    """SIGTERM the named child PIDs. The supervisor's restart loop respawns
    them. Use 'all' to signal every running child."""
    state = _read_state()
    if state is None:
        print('No supervisor state file found (is the supervisor running?)',
              file=sys.stderr)
        return 1
    sup_pid = state.get('supervisor_pid')
    if not _pid_alive(sup_pid):
        print(f'Supervisor (pid={sup_pid}) is not running — cannot restart',
              file=sys.stderr)
        return 1

    services = state.get('services') or {}
    if service_names == ['all']:
        targets = list(services.keys())
    else:
        unknown = [n for n in service_names if n not in services]
        if unknown:
            print(f'Unknown service(s): {", ".join(unknown)}', file=sys.stderr)
            print(f'Known: {", ".join(services.keys())}', file=sys.stderr)
            return 1
        targets = service_names

    if not targets:
        print('No services to restart.')
        return 0

    for name in targets:
        pid = services[name].get('pid')
        if not _pid_alive(pid):
            print(f'  {name}: pid={pid} is already dead — skipping')
            continue
        try:
            os.kill(pid, signal.SIGTERM)
            print(f'  {name}: sent SIGTERM to pid={pid} '
                  f'(supervisor will restart it)')
        except ProcessLookupError:
            print(f'  {name}: pid={pid} vanished before signal')
            continue
        except PermissionError:
            print(f'  {name}: not permitted to signal pid={pid} '
                  f'(different user?)', file=sys.stderr)
            continue

        # Caddy honours SIGTERM by entering an "eternal grace period"
        # graceful-shutdown that never exits while keep-alive connections
        # are around.  Give it 3 seconds, then SIGKILL — the supervisor
        # respawn loop expects the process to actually die.
        for _ in range(30):  # 30 × 0.1s = 3s
            if not _pid_alive(pid):
                break
            time.sleep(0.1)
        else:
            try:
                os.kill(pid, signal.SIGKILL)
                print(f'  {name}: pid={pid} ignored SIGTERM for 3s, '
                      f'sent SIGKILL')
            except ProcessLookupError:
                pass
    return 0


def _make_prefix(name: str, color: str, label_width: int) -> tuple[str, int]:
    """Return (colored_prefix, visible_character_width)."""
    padded_name = name.ljust(label_width)
    prefix = f"{color}{BOLD}[{padded_name}]{RESET} "
    visible_width = 1 + label_width + 2  # '[' + name + '] '
    return prefix, visible_width


async def _pipe_stream(
    stream: asyncio.StreamReader,
    prefix: str,
    prefix_visible_width: int,
) -> None:
    """Read lines from a stream and print each with the given prefix.

    Long lines are wrapped at the terminal width and continuation lines are
    indented by the same number of spaces as the visible prefix width, so the
    content column stays aligned:

        [caddy     ] first part of a very long line that wraps here…
                     continuation indented flush with the message above
    """
    continuation_indent = ' ' * prefix_visible_width

    while True:
        line_bytes = await stream.readline()
        if not line_bytes:
            break

        line = line_bytes.decode(errors='replace').rstrip()
        terminal_width = shutil.get_terminal_size(fallback=(120, 24)).columns
        available_width = max(40, terminal_width - prefix_visible_width)

        if len(line) <= available_width:
            print(prefix + line, flush=True)
        else:
            wrapped_parts = textwrap.wrap(line, width=available_width) or ['']
            first_line, *remaining_lines = wrapped_parts
            print(prefix + first_line, flush=True)
            for continuation_line in remaining_lines:
                print(continuation_indent + continuation_line, flush=True)


async def _run_service(
    name: str,
    config: dict,
    label_width: int,
    shutdown_event: asyncio.Event,
    active_processes: dict,
) -> None:
    """Spawn a service process, pipe its output, and restart on crash."""
    color = config['color']
    prefix, prefix_visible_width = _make_prefix(name, color, label_width)
    sup_prefix, sup_prefix_visible_width = _make_prefix('supervisor', DIM, label_width)
    cwd = str(_script_dir / config.get('cwd', '.'))
    cmd = config['cmd']

    backoff_delay = BACKOFF_INITIAL

    while not shutdown_event.is_set():
        start_time = time.monotonic()
        try:
            process = await asyncio.create_subprocess_exec(
                *cmd,
                stdout=asyncio.subprocess.PIPE,
                stderr=asyncio.subprocess.PIPE,
                cwd=cwd,
            )
        except FileNotFoundError:
            print(
                f"{sup_prefix}{RED}cannot start '{name}': "
                f"command not found: {cmd[0]}{RESET}",
                flush=True,
            )
            await asyncio.sleep(backoff_delay)
            backoff_delay = min(backoff_delay * BACKOFF_MULTIPLIER, BACKOFF_MAX)
            continue

        active_processes[name] = process
        _write_state(active_processes, _started_at)

        # Stream stdout and stderr concurrently
        await asyncio.gather(
            _pipe_stream(process.stdout, prefix, prefix_visible_width),
            _pipe_stream(process.stderr, prefix, prefix_visible_width),
        )
        return_code = await process.wait()
        active_processes.pop(name, None)
        _write_state(active_processes, _started_at)

        elapsed = time.monotonic() - start_time

        if shutdown_event.is_set():
            break

        # Always respawn: the supervisor's job is to keep long-running
        # daemons alive.  Caddy in particular exits 0 on a SIGTERM-induced
        # graceful shutdown — which we want to treat as "got restarted"
        # not "task complete".  If the user genuinely wants something to
        # stop, they SIGTERM the supervisor itself (make serve-stop).
        if elapsed >= CLEAN_RUN_THRESHOLD:
            backoff_delay = BACKOFF_INITIAL

        label = ('exited cleanly' if return_code == 0
                 else f'crashed (exit {return_code})')
        print(
            f"{sup_prefix}{RED}[{name}] {label} — restarting in {backoff_delay}s{RESET}",
            flush=True,
        )
        await asyncio.sleep(backoff_delay)
        backoff_delay = min(backoff_delay * BACKOFF_MULTIPLIER, BACKOFF_MAX)


async def _main() -> None:
    global _started_at

    parser = argparse.ArgumentParser(description='Anthive process supervisor')
    parser.add_argument(
        '--caddy',
        action='store_true',
        help='Also start Caddy as local reverse proxy on port 8501',
    )
    args = parser.parse_args()

    active_services = DEFAULT_SERVICES + (['caddy'] if args.caddy else [])
    label_width = max(len(name) for name in active_services + ['supervisor'])
    sup_prefix, _ = _make_prefix('supervisor', DIM, label_width)

    _started_at = datetime.now().isoformat(timespec='seconds')
    mode = 'debug (caddy on :8501)' if args.caddy else 'deployment (nginx handles :8501)'
    print(f"{sup_prefix}{BOLD}starting anthive — {mode}{RESET}", flush=True)
    print(f"{sup_prefix}{DIM}state file: {STATE_FILE}{RESET}", flush=True)
    for service_name in active_services:
        svc = SERVICES[service_name]
        print(
            f"{sup_prefix}  {svc['color']}{service_name}{RESET}: "
            f"{' '.join(svc['cmd'][:3])}…",
            flush=True,
        )
    print(flush=True)

    shutdown_event = asyncio.Event()
    active_processes: dict = {}  # name -> asyncio.subprocess.Process
    loop = asyncio.get_running_loop()

    def _handle_shutdown() -> None:
        if not shutdown_event.is_set():
            print(f"\n{sup_prefix}{BOLD}shutting down…{RESET}", flush=True)
            shutdown_event.set()

    for sig in (signal.SIGINT, signal.SIGTERM):
        loop.add_signal_handler(sig, _handle_shutdown)

    service_tasks = [
        asyncio.create_task(
            _run_service(
                service_name,
                SERVICES[service_name],
                label_width,
                shutdown_event,
                active_processes,
            )
        )
        for service_name in active_services
    ]

    # Wait until shutdown is requested
    await shutdown_event.wait()

    # Cancel all service tasks (stops restart loops)
    for task in service_tasks:
        task.cancel()

    # SIGTERM all still-running children
    for service_name, process in list(active_processes.items()):
        try:
            process.terminate()
        except ProcessLookupError:
            pass

    # Wait up to 5 s, then SIGKILL stragglers
    deadline = loop.time() + 5.0
    for service_name, process in list(active_processes.items()):
        remaining = max(0.0, deadline - loop.time())
        try:
            await asyncio.wait_for(process.wait(), timeout=remaining)
        except (asyncio.TimeoutError, ProcessLookupError):
            try:
                process.kill()
            except ProcessLookupError:
                pass

    print(f"{sup_prefix}all services stopped", flush=True)

    try:
        STATE_FILE.unlink()
    except (OSError, FileNotFoundError):
        pass


if __name__ == '__main__':
    # Subcommand dispatch: control-plane commands don't need asyncio.
    # Detect them before argparse so the existing `--caddy` invocation
    # in the Makefile keeps working unchanged.
    if len(sys.argv) >= 2 and sys.argv[1] in ('status', 'restart'):
        if sys.argv[1] == 'status':
            sys.exit(cmd_status())
        else:
            names = sys.argv[2:] or ['all']
            sys.exit(cmd_restart(names))
    asyncio.run(_main())
