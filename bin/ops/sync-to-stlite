#!/bin/bash
# sync-to-stlite - Sync frontend/streamlit changes to stlite
#
# After developing in frontend/streamlit/, use this to sync changes
# back to the stlite (browser-based) version

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

cd "$PROJECT_ROOT"

# Colors
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${BLUE}=== Syncing frontend/streamlit to stlite ===${NC}"
echo

# Files to sync
FILES=(
    "components.py"
    "util.py"
    "streamlit_app.py"
    "pages/1_gene.py"
    "pages/2_umap.py"
    "pages/3_rolling.py"
)

# Check for differences
DIFFS=0
for file in "${FILES[@]}"; do
    if ! diff -q "frontend/streamlit/$file" "frontend/jupyter/stlite/$file" > /dev/null 2>&1; then
        DIFFS=$((DIFFS + 1))
    fi
done

if [ $DIFFS -eq 0 ]; then
    echo -e "${GREEN}✓ Already in sync - no changes to copy${NC}"
    exit 0
fi

echo -e "${YELLOW}Found $DIFFS file(s) with changes${NC}"
echo

# Show differences
echo "Files that will be updated:"
for file in "${FILES[@]}"; do
    if ! diff -q "frontend/streamlit/$file" "frontend/jupyter/stlite/$file" > /dev/null 2>&1; then
        echo "  - $file"
    fi
done
echo

# Confirm
read -p "Copy these changes to stlite? [y/N] " -n 1 -r
echo
if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    echo "Cancelled"
    exit 1
fi

# Backup
BACKUP_DIR="/tmp/stlite-backup-$(date +%Y%m%d-%H%M%S)"
mkdir -p "$BACKUP_DIR"
echo -e "${BLUE}Creating backup in $BACKUP_DIR${NC}"
for file in "${FILES[@]}"; do
    mkdir -p "$BACKUP_DIR/$(dirname "$file")"
    cp "frontend/jupyter/stlite/$file" "$BACKUP_DIR/$file" 2>/dev/null || true
done

# Copy files
echo -e "${BLUE}Copying files...${NC}"
for file in "${FILES[@]}"; do
    cp "frontend/streamlit/$file" "frontend/jupyter/stlite/$file"
    echo -e "  ${GREEN}✓${NC} $file"
done

echo
echo -e "${GREEN}=== Sync complete ===${NC}"
echo
echo "Next steps:"
echo "  1. Test the stlite version"
echo "  2. Commit changes if working"
echo
echo "Backup saved to: $BACKUP_DIR"
