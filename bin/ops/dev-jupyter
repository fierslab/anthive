#!/bin/bash
# dev-jupyter - Start JupyterLab for developing frontend/jupyter/jupyter
#
# Runs JupyterLab with all required packages against frontend/jupyter/jupyter.
# On exit (normal or Ctrl+C): removes antclient.py and anthelper.py if
# unchanged (they are imported via micropip in JupyterLite), warns if
# either was edited. Also cleans up __pycache__ and .ipynb_checkpoints.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
cd "$PROJECT_ROOT"

# ── colours ────────────────────────────────────────────────────────────────
RED='\033[0;31m'
YELLOW='\033[1;33m'
BOLD='\033[1m'
NC='\033[0m'

# ── post-session cleanup (runs on EXIT, including Ctrl+C) ──────────────────
cleanup() {
    CHANGED=()

    # Compare each file against its canonical library source.
    # If unchanged → remove (normally imported via micropip in JupyterLite).
    # If changed   → warn and keep so the user can sync back.
    for src_file in antclient/antclient.py antclient/anthelper.py; do
        base_name=$(basename "$src_file")
        dest_file="frontend/jupyter/jupyter/$base_name"
        if [ ! -f "$dest_file" ]; then
            continue
        fi
        if diff -q "$src_file" "$dest_file" > /dev/null 2>&1; then
            rm -f "$dest_file"
        else
            CHANGED+=("$base_name  →  differs from $src_file")
        fi
    done

    # Remove __pycache__ and .ipynb_checkpoints left by the session
    find frontend/jupyter/jupyter -type d \( -name "__pycache__" -o -name ".ipynb_checkpoints" \) -exec rm -rf {} + 2>/dev/null || true

    if [ ${#CHANGED[@]} -eq 0 ]; then
        return
    fi

    echo ""
    echo -e "${YELLOW}${BOLD}"
    echo "  ╔══════════════════════════════════════════════════════════════════════╗"
    echo "  ║                                                                      ║"
    echo "  ║   !!  WARNING: sync these files back to the library  !!             ║"
    echo "  ║                                                                      ║"
    for msg in "${CHANGED[@]}"; do
        printf "  ║   →  %-66s║\n" "$msg"
    done
    echo "  ║                                                                      ║"
    echo "  ╚══════════════════════════════════════════════════════════════════════╝"
    echo -e "${NC}"
}

trap cleanup EXIT

# ── prepare source folder ──────────────────────────────────────────────────
chmod -R u+rw frontend/jupyter/jupyter
cp antclient/antclient.py frontend/jupyter/jupyter/antclient.py
cp antclient/anthelper.py frontend/jupyter/jupyter/anthelper.py

echo "Starting JupyterLab on http://localhost:9090"
echo ""

uvx --from jupyterlab \
    --with ipywidgets \
    --with jupyterlab-widgets \
    --with pandas \
    --with matplotlib \
    --with seaborn \
    --with scikit-learn \
    --with statsmodels \
    jupyter-lab \
    --notebook-dir frontend/jupyter/jupyter \
    --port 9090 \
    --no-browser
