#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["ruamel.yaml"]
# ///
"""ant-adduser — add an Authelia user, keyed on email, with a random password.

What it does:
  - REQUIRES an email address (validated).
  - Auto-derives the login name from the email local part's initials:
      jane.doe@example.org    -> jd
      bert.bobjes@example.org -> bb
      jan.van.berg@example.org-> jvb
      carlo@example.org       -> carlo   (single token: used as-is)
    If that login is already taken by a DIFFERENT email, it falls back to
    <first-initial><lastname> (jdoe), then <initials>2, 3, …  If it's
    taken by the SAME email, that's the same person -> error, unless
    --force is given (then the password is regenerated for that account,
    preserving its login / display name / groups).
  - Auto-derives a display name ("Mark Fiers") unless -n is given.
  - Generates a random 12-char alphanumeric password, hashes it (argon2 via
    the Authelia binary), and adds the user to users_database.yml.
  - Prints the username + plaintext password ONCE (it is not stored), plus a
    ready-to-send email body (recipient, site URL, credentials). The site URL
    is auto-detected from this instance's Authelia configuration.yml
    (session.cookies[].default_redirection_url); override with --url.

Robust to file format: the database is parsed and re-dumped with a YAML
round-trip parser, so it works whether entries are in the minimal 4-field
form or Authelia's fully-expanded schema — and never emits invalid YAML.
Existing users are preserved untouched. Authelia watches the file
(watch: true), so a new user can log in within ~a second; no restart.

Usage:
  ant-adduser <email> [-u login] [-n "Display Name"] [-g group ...] [--admin]
              [-f users_file] [--url https://host/] [--force]

Examples:
  ant-adduser jane.doe@example.org              # -> login jd, group users
  ant-adduser bert.bobjes@example.org -g admins # -> login bb, group admins
  ant-adduser carlo@example.org --admin         # -> shorthand for -g admins
  ant-adduser jo@example.org --admin -g curators# -> in both 'admins' and 'curators'
  ant-adduser jo@example.org -g a,b             # -> comma-list also accepted
  ant-adduser carlo@example.org -u carlo2       # force the login name
  ant-adduser jo@example.org --url https://anthive.example.org/  # override auto-detected URL
  ant-adduser jane.doe@example.org --force      # reset jd's password, new one printed
"""

import argparse
import re
import subprocess
import sys
from pathlib import Path
from urllib.parse import urlparse

from ruamel.yaml import YAML

SCRIPT_DIR = Path(__file__).resolve().parent
REPO_ROOT = SCRIPT_DIR.parent.parent
AUTHELIA_BIN = REPO_ROOT / "envs" / "authelia" / "authelia"
DEFAULT_USERS_FILE = REPO_ROOT / "config" / "authelia" / "users_database.yml"
DEFAULT_CONFIG_FILE = REPO_ROOT / "config" / "authelia" / "configuration.yml"

EMAIL_RE = re.compile(r"^[^@\s]+@[^@\s]+\.[^@\s]+$")
LOGIN_RE = re.compile(r"^[a-z][a-z0-9_-]*$")


def die(message: str) -> None:
    """Print an error to stderr and exit non-zero."""
    print(f"error: {message}", file=sys.stderr)
    raise SystemExit(1)


def candidate_logins(email: str) -> tuple[list[str], list[str]]:
    """Ordered login candidates derived from the email, plus the name tokens.

    multi-token -> initials (jane.doe -> jd); single token -> as-is (carlo).
    Fallbacks: <first-initial><lastname> (mfiers), then <initials>2, 3, …
    """
    local = email.split("@")[0]
    tokens = [token for token in re.split(r"[._\-]+", local) if token]
    if not tokens:
        die(f"cannot derive a login from email {email}")
    base = (tokens[0] if len(tokens) == 1
            else "".join(token[0] for token in tokens)).lower()
    candidates = [base]
    if len(tokens) >= 2:
        candidates.append((tokens[0][0] + tokens[-1]).lower())  # mfiers
    candidates += [f"{base}{n}" for n in range(2, 100)]
    return candidates, tokens


def confirm_login(suggestion: str, existing: dict[str, str | None],
                  email: str) -> str:
    """Prompt for a free login after a collision; exit if no input is given.

    Accepts a typed login or the offered suggestion (empty line). Re-prompts
    on an invalid or still-taken choice. With no input available (EOF / not a
    terminal), exits with the warning rather than auto-resolving.
    """
    while True:
        try:
            response = input(f"  enter a login to use [{suggestion}]: ").strip()
        except EOFError:
            die("collision not resolved (no input); re-run with "
                f"-u <login> — suggestion: {suggestion}")
        choice = response or suggestion
        if not LOGIN_RE.match(choice):
            print("  invalid: lowercase, start with a letter, a-z 0-9 _ -",
                  file=sys.stderr)
            continue
        if choice not in existing:
            return choice
        if (existing[choice] or "").lower() == email.lower():
            die(f"'{choice}' already exists with email {email} (same person)")
        print(f"  '{choice}' is taken by {existing[choice]}; choose another",
              file=sys.stderr)


def detect_instance_url(config_path: Path) -> str | None:
    """Best-effort public base URL of this instance, for the welcome email.

    Reads the first session cookie's `default_redirection_url` from the
    Authelia config (e.g. https://anthive.example.org/); falls back to
    `authelia_url` with the trailing `authelia/` stripped. Returns None if
    the config is missing/unparseable so the caller can prompt for --url.
    """
    if not config_path.is_file():
        return None
    try:
        cfg = YAML(typ="safe").load(config_path) or {}
    except Exception:
        return None
    cookies = ((cfg.get("session") or {}).get("cookies")) or []
    for cookie in cookies:
        if cookie.get("default_redirection_url"):
            return cookie["default_redirection_url"].strip()
        if cookie.get("authelia_url"):
            return re.sub(r"authelia/?$", "", cookie["authelia_url"].strip())
    return None


def generate_password_and_hash(fixed_password: str = "") -> tuple[str, str]:
    """Return (plaintext, argon2_digest) from the Authelia crypto helper.

    If ``fixed_password`` is provided, hash it and return (fixed_password, digest).
    Else generate a random 12-char alphanumeric password.
    """
    if fixed_password:
        result = subprocess.run(
            [str(AUTHELIA_BIN), "crypto", "hash", "generate", "argon2",
             "--password", fixed_password, "--no-confirm"],
            capture_output=True, text=True, check=True,
        )
        digest = None
        for line in result.stdout.splitlines():
            if line.startswith("Digest: "):
                digest = line[len("Digest: "):].strip()
        if not digest:
            die(f"could not parse hash from authelia output:\n{result.stdout}")
        return fixed_password, digest
    result = subprocess.run(
        [str(AUTHELIA_BIN), "crypto", "hash", "generate", "argon2",
         "--random", "--random.length", "12", "--random.charset", "alphanumeric",
         "--no-confirm"],
        capture_output=True, text=True, check=True,
    )
    password = digest = None
    for line in result.stdout.splitlines():
        if line.startswith("Random Password: "):
            password = line[len("Random Password: "):].strip()
        elif line.startswith("Digest: "):
            digest = line[len("Digest: "):].strip()
    if not password or not digest:
        die(f"could not parse password/hash from authelia output:\n{result.stdout}")
    return password, digest


def main() -> None:
    parser = argparse.ArgumentParser(
        prog="ant-adduser", description="Add an Authelia user keyed on email.")
    parser.add_argument("email", help="email address (required; drives the login)")
    parser.add_argument("-u", "--login", default="",
                        help="explicit login name (overrides the auto-derived one)")
    parser.add_argument("-n", "--name", default="",
                        help="display name (default: derived from email)")
    parser.add_argument("-g", "--group", action="append", default=None,
                        metavar="GROUP",
                        help="Authelia group membership. Repeatable: pass -g "
                             "multiple times for multiple groups. Default for "
                             "new accounts: 'users' (single group). Preserved "
                             "on --force unless any -g is given (then "
                             "replaced wholesale).")
    parser.add_argument("--admin", action="store_true",
                        help="Shortcut for `-g admins`. Stackable with other "
                             "-g flags — `--admin -g curators` lands the user "
                             "in both groups.")
    parser.add_argument("-f", "--file", default=str(DEFAULT_USERS_FILE),
                        help="users database path (default: this instance's)")
    parser.add_argument("--url", default="",
                        help="public site URL for the welcome email "
                             "(default: auto-detected from configuration.yml)")
    parser.add_argument("--force", action="store_true",
                        help="if the email already has an account, regenerate "
                             "its password instead of erroring (preserves the "
                             "existing login, display name and groups)")
    parser.add_argument("--password", default="",
                        help="use this password instead of generating a random "
                             "one. Combine with --force to reset an existing "
                             "account to a chosen password.")
    args = parser.parse_args()

    # Normalize the group list. argparse hands us a list (or None when no -g
    # was passed). --admin is a shorthand that gets folded in. De-dupe but
    # preserve insertion order so the YAML reads in the order the operator
    # typed.
    requested_groups: list[str] = []
    if args.admin:
        requested_groups.append("admins")
    if args.group:
        for entry in args.group:
            for raw in entry.split(","):
                group_name = raw.strip()
                if group_name and group_name not in requested_groups:
                    requested_groups.append(group_name)

    if not AUTHELIA_BIN.is_file():
        die(f"authelia binary not found at {AUTHELIA_BIN}")
    users_path = Path(args.file)
    if not users_path.is_file():
        die(f"users database not found at {users_path}")
    if not EMAIL_RE.match(args.email):
        die(f"invalid email address: {args.email}")

    yaml = YAML()  # round-trip: preserves existing entries' formatting
    yaml.preserve_quotes = True
    data = yaml.load(users_path) or {}
    users = data.get("users")
    if users is None:
        die(f"{users_path} has no top-level 'users:' mapping")

    existing = {login: (entry or {}).get("email") for login, entry in users.items()}

    # The login that already owns this email, if any (for --force resets).
    existing_login_for_email = next(
        (login for login, mail in existing.items()
         if (mail or "").lower() == args.email.lower()), None)

    candidates, tokens = candidate_logins(args.email)

    if args.login:
        if not LOGIN_RE.match(args.login):
            die(f"login {args.login!r} must be lowercase, start with a letter, "
                f"and contain only a-z 0-9 _ -")
        desired = args.login
        suggestions = [args.login] + [f"{args.login}{n}" for n in range(2, 100)]
    else:
        desired = candidates[0]
        suggestions = candidates

    is_reset = False
    if args.force and existing_login_for_email:
        # --force: regenerate the password for whoever already owns this email
        # (matched by email, not by the derived login), preserving their entry.
        login = existing_login_for_email
        login_source = "existing — password reset (--force)"
        is_reset = True
    elif desired not in existing:
        login = desired
        login_source = "explicit (-u)" if args.login else "auto-derived from email"
    elif (existing[desired] or "").lower() == args.email.lower():
        die(f"user '{desired}' already exists with email {args.email} "
            f"(same person) — use --force to reset the password")
    else:
        # collision with a DIFFERENT email: warn + require manual confirmation
        # rather than silently picking an alternative.
        suggestion = next((c for c in suggestions if c not in existing),
                          f"{desired}2")
        print(f"warning: login '{desired}' is already taken by a different "
              f"email ({existing[desired]}).", file=sys.stderr)
        login = confirm_login(suggestion, existing, args.email)
        login_source = "manually confirmed (collision)"

    password, digest = generate_password_and_hash(args.password)

    if is_reset:
        # Mutate the existing entry: swap only the password (and display
        # name / groups if explicitly given), preserving any other fields
        # and the file's formatting.
        entry = users[login]
        entry["password"] = digest
        if args.name:
            entry["displayname"] = args.name
        if requested_groups:
            entry["groups"] = list(requested_groups)
        display_name = entry.get("displayname") or login
        group_display = ", ".join(entry.get("groups") or []) or "—"
    else:
        display_name = args.name or (
            " ".join(token.capitalize() for token in tokens) if tokens else login)
        groups = list(requested_groups) if requested_groups else ["users"]
        users[login] = {
            "displayname": display_name,
            "password": digest,
            "email": args.email,
            "groups": groups,
        }
        group_display = ", ".join(groups)

    yaml.dump(data, users_path)
    users_path.chmod(0o600)

    action_label = "password reset" if is_reset else "created"
    print(f"""\
================================================================
  Authelia user {action_label} (live within ~1s, no restart needed)
----------------------------------------------------------------
  username:     {login}      ({login_source})
  password:     {password}
  email:        {args.email}
  display name: {display_name}
  groups:       {group_display}
  file:         {users_path}
----------------------------------------------------------------
  Share the password over a secure channel. It is NOT stored;
  if lost, regenerate the hash and replace the password line.
================================================================""")

    site_url = args.url.strip() or detect_instance_url(DEFAULT_CONFIG_FILE)
    if not site_url:
        site_url = "https://<your-instance>/"
        print("\nnote: could not auto-detect the site URL; pass --url to fill "
              "it into the email below.", file=sys.stderr)
    host = urlparse(site_url).netloc or site_url.strip("/")
    portal_url = site_url.rstrip("/") + "/authelia/"

    print(f"""
─── ready-to-send email ─────────────────────────────────────────
To: {args.email}
Subject: Your login for the Anthive data browser ({host})

Dear {display_name},

You have an account on the Anthive single-cell data browser at {host}.

  Website:   {site_url}
  Username:  {login}
  Password:  {password}

Please sign in and set your own password under Settings → Reset
Password ({portal_url}). Keep these credentials private; do not
forward this email.

Kind regards,
The Anthive team
─────────────────────────────────────────────────────────────────""")


if __name__ == "__main__":
    main()
