#!/usr/bin/env -S uv run --quiet --script
# /// script
# dependencies = [
#   "duckdb>=0.10.0",
#   "h5py>=3.0",
#   "numpy>=1.24",
#   "pandas>=2.0.0",
#   "pyyaml>=6.0",
# ]
# ///
"""
ant-merge-h5ad — merge pending duckdb obs columns back into the h5ad.

The "cold path" complement to AnnotationWriter. After annotators have added
columns to the duckdb (fast path), this tool reflects those columns back
into the h5ad source-of-truth without rewriting X.

Dual sanity check before writing:
  1. __pending_cols table in duckdb (audit trail)
  2. Independent column diff between duckdb obs and h5ad obs

If the diff doesn't match the recorded pending list → refuse (divergent state).

Usage:
  ant-merge-h5ad DATASET.md            # merge one dataset
  ant-merge-h5ad --all                 # walk h5adstore, merge every dirty
  ant-merge-h5ad --dry-run DATASET.md  # report what would change

The companion .h5ad and .duckdb are inferred from the .md path.
"""
from __future__ import annotations

import argparse
import fcntl
import sys
from pathlib import Path
from typing import List, Optional

import duckdb
import h5py
import numpy as np
import pandas as pd

script_dir = Path(__file__).parent.resolve()
lib_dir = script_dir.parent / 'lib'
sys.path.insert(0, str(lib_dir))

from anthive_db import (  # noqa: E402
    _post_ant_serve,
    pending_state_diagnosis,
    read_pending_cols,
    safe_ident,
)

try:
    from config import get_config  # type: ignore
except Exception:
    get_config = None  # type: ignore

try:
    from metadata import parse_md_file  # type: ignore
except Exception:
    parse_md_file = None  # type: ignore


def _h5_index_dataset_name(h5_obs) -> str:
    """Return the cell-name index dataset name within obs/."""
    return str(h5_obs.attrs.get('_index', '_index'))


def _h5_cell_names(h5_obs) -> list:
    name = _h5_index_dataset_name(h5_obs)
    raw = h5_obs[name][:]
    return [v.decode() if isinstance(v, (bytes, bytearray)) else str(v)
            for v in raw]


def _h5_column_order(h5_obs) -> List[str]:
    raw = h5_obs.attrs.get('column-order', None)
    if raw is None:
        return []
    out = []
    for v in list(raw):
        if isinstance(v, (bytes, bytearray)):
            out.append(v.decode())
        else:
            out.append(str(v))
    return out


def _pick_int_dtype(n_cats: int) -> np.dtype:
    """Pick the smallest signed int dtype that can hold n_cats categories
    plus the -1 sentinel for NaN."""
    if n_cats <= 127:
        return np.dtype('int8')
    if n_cats <= 32767:
        return np.dtype('int16')
    return np.dtype('int32')


def _write_numerical(h5_obs, col_name: str, arr: np.ndarray) -> None:
    ds = h5_obs.create_dataset(col_name, data=arr)
    ds.attrs['encoding-type'] = 'array'
    ds.attrs['encoding-version'] = '0.2.0'


def _write_categorical(
    h5_obs, col_name: str, categories: List[str], codes: np.ndarray,
) -> None:
    grp = h5_obs.create_group(col_name)
    str_dtype = h5py.string_dtype(encoding='utf-8')
    grp.create_dataset('categories', data=np.array(categories, dtype=object),
                       dtype=str_dtype)
    grp.create_dataset('codes', data=codes)
    grp.attrs['encoding-type'] = 'categorical'
    grp.attrs['encoding-version'] = '0.2.0'
    grp.attrs['ordered'] = False


def _resolve_db_id_from_md(md_path: Path) -> Optional[str]:
    """Build the canonical db_id from sibling .md / index.md."""
    if parse_md_file is None:
        return None
    index_path = md_path.parent / 'index.md'
    if not index_path.exists():
        return None
    try:
        data_meta, _ = parse_md_file(md_path)
        index_meta, _ = parse_md_file(index_path)
    except Exception:
        return None
    file_id = str(data_meta.get('id') or '').strip()
    group_id = str(index_meta.get('group_id') or '').strip()
    if not file_id or not group_id:
        return None
    return f"{group_id}/{file_id}"


def _resolve_ant_serve_url(api_url_override: Optional[str],
                           no_coordinate: bool) -> Optional[str]:
    if no_coordinate:
        return None
    if api_url_override:
        return api_url_override.rstrip('/')
    if get_config is None:
        return None
    try:
        cfg = get_config()
    except Exception:
        return None
    host = cfg.get('rest_api_host', 'localhost')
    port = cfg.get('rest_api_port', 8080)
    return f"http://{host}:{port}/api"


def _open_duckdb_rw_with_release(duckdb_path: Path,
                                 db_id: Optional[str],
                                 ant_serve_url: Optional[str]):
    """Open the duckdb r/w, coordinating with ant-serve on lock conflict."""
    try:
        return duckdb.connect(str(duckdb_path), read_only=False), False
    except duckdb.IOException as exc:
        if 'Conflicting lock' not in str(exc):
            raise
        if not (ant_serve_url and db_id):
            raise
        print(f"  ⚠ DuckDB lock held — asking ant-serve to release {db_id}…")
        result = _post_ant_serve(
            ant_serve_url, f'/admin/release/{db_id}', on_failure='raise',
        )
        if not (result and result.get('ok')):
            raise RuntimeError(
                f"ant-serve release of {db_id!r} did not succeed: {result}"
            )
        return duckdb.connect(str(duckdb_path), read_only=False), True


def merge_dataset(
    md_path: Path,
    dry_run: bool = False,
    force_divergent: bool = False,
    db_id: Optional[str] = None,
    ant_serve_url: Optional[str] = None,
) -> int:
    """Merge pending obs columns from duckdb into h5ad. Returns exit code."""
    h5ad_path = md_path.with_suffix('.h5ad')
    duckdb_path = md_path.with_suffix('.duckdb')

    if not duckdb_path.exists():
        print(f"  · {md_path.name}: no duckdb (skipping)")
        return 0
    if not h5ad_path.exists():
        print(f"  ⚠ {md_path.name}: duckdb present but h5ad missing — "
              f"need to pull first")
        return 1

    # --- Pre-flight sanity check (reads from h5ad without modifying) ---
    with h5py.File(h5ad_path, 'r') as f:
        h5_obs_keys = set(f['obs'].keys())
        h5_cell_names = _h5_cell_names(f['obs'])

    diag = pending_state_diagnosis(duckdb_path, h5_obs_keys)
    if diag['clean']:
        print(f"  · {md_path.name}: clean, nothing to merge")
        return 0

    pending_df = diag['pending_table']
    unrecorded = diag['unrecorded']
    missing_from_duckdb = diag['missing_from_duckdb']
    already_merged = diag['already_merged']
    only_in_duckdb = set(diag['only_in_duckdb'])

    if unrecorded or missing_from_duckdb:
        print(f"  ✗ {md_path.name}: DIVERGENT state")
        if unrecorded:
            print(f"    duckdb has obs cols not in __pending_cols: "
                  f"{unrecorded}")
        if missing_from_duckdb:
            print(f"    __pending_cols has rows for cols not in duckdb obs: "
                  f"{missing_from_duckdb}")
        if not force_divergent:
            print(f"    Refusing to merge. Investigate, then use --force "
                  f"to override.")
            return 2
        print(f"    --force given — merging only the recorded intersection.")

    # The actual set we merge: rows in __pending_cols that are still
    # only in the duckdb (not yet in h5ad)
    mergeable = pending_df[pending_df['col_name'].isin(only_in_duckdb)].copy()

    # Recovery path: rows whose column is ALREADY in the h5ad. This happens
    # when a previous merge wrote the h5ad but died before clearing
    # __pending_cols. We just delete those rows — the work is already done.
    if already_merged and not dry_run:
        print(f"  ↺ {md_path.name}: {len(already_merged)} columns already in h5ad — "
              f"clearing stale __pending_cols entries")
        for c in already_merged:
            print(f"    ~ {c} (cleanup)")

    if mergeable.empty and not already_merged:
        print(f"  · {md_path.name}: nothing mergeable")
        return 0

    # --- Cell-name alignment ---
    con = duckdb.connect(str(duckdb_path), read_only=True)
    try:
        cell_rows = con.execute(
            "SELECT cell_id, cell_name FROM __cells"
        ).fetchall()
    finally:
        con.close()

    duck_names_ordered_by_id = [row[1] for row in
                                sorted(cell_rows, key=lambda r: r[0])]
    duck_names_set = {row[1] for row in cell_rows}
    h5_names_set = set(h5_cell_names)

    if duck_names_set != h5_names_set:
        only_h5 = h5_names_set - duck_names_set
        only_duck = duck_names_set - h5_names_set
        print(f"  ✗ {md_path.name}: cell-name mismatch")
        if only_h5:
            print(f"    {len(only_h5):,} cells in h5ad not in duckdb "
                  f"(sample: {sorted(only_h5)[:3]})")
        if only_duck:
            print(f"    {len(only_duck):,} cells in duckdb not in h5ad "
                  f"(sample: {sorted(only_duck)[:3]})")
        print(f"    Cannot merge. Probably need ant-convert rebuild.")
        return 3

    h5_idx_of = {name: i for i, name in enumerate(h5_cell_names)}

    # --- Show the plan ---
    print(f"  {md_path.name}: {len(mergeable)} columns to merge")
    for _, row in mergeable.iterrows():
        print(f"    + {row['col_name']:<45s} [{row['kind']}] "
              f"by {row['annotator']} (run {row['run_id']})")

    if dry_run:
        print(f"  (dry-run; no changes written)")
        return 0

    # --- Fetch values from duckdb ---
    con = duckdb.connect(str(duckdb_path), read_only=True)
    new_arrays = {}        # numerical: col -> np.ndarray (float64)
    new_categoricals = {}  # categorical: col -> (categories, codes)
    try:
        for _, row in mergeable.iterrows():
            col = row['col_name']
            target = row['target_table']    # obsnum | obscat
            kind = row['kind']

            df = con.execute(
                f"SELECT c.cell_name, t.{safe_ident(col)} AS val "
                f"FROM __cells c LEFT JOIN __{target} t "
                f"ON c.cell_id = t.cell_id"
            ).fetchdf()

            if kind == 'num':
                arr = np.full(len(h5_cell_names), np.nan, dtype='f8')
                for cn, val in zip(df['cell_name'], df['val']):
                    if pd.notna(val):
                        arr[h5_idx_of[cn]] = float(val)
                new_arrays[col] = arr
            else:
                non_null = df[df['val'].notna()]
                cats = sorted(non_null['val'].astype(str).unique())
                cat_map = {v: i for i, v in enumerate(cats)}
                codes = np.full(len(h5_cell_names), -1,
                                dtype=_pick_int_dtype(len(cats)))
                for cn, val in zip(df['cell_name'], df['val']):
                    if pd.notna(val):
                        codes[h5_idx_of[cn]] = cat_map[str(val)]
                new_categoricals[col] = (cats, codes)
    finally:
        con.close()

    # --- Acquire lock for the brief duckdb update after h5ad write ---
    lock_path = duckdb_path.with_suffix(duckdb_path.suffix + '.lock')
    lock_fd = open(lock_path, 'w')
    try:
        try:
            fcntl.flock(lock_fd.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print(f"  ✗ {md_path.name}: cannot acquire write lock — "
                  f"another writer is active")
            return 4

        # --- Write into h5ad (h5py opens 'r+', appends datasets) ---
        with h5py.File(h5ad_path, 'r+') as f:
            obs = f['obs']
            existing_order = _h5_column_order(obs)

            for col, arr in new_arrays.items():
                _write_numerical(obs, col, arr)
            for col, (cats, codes) in new_categoricals.items():
                _write_categorical(obs, col, cats, codes)

            new_cols = list(new_arrays.keys()) + list(new_categoricals.keys())
            # Preserve insertion order: existing first, then new
            new_order = existing_order + [c for c in new_cols
                                          if c not in existing_order]
            obs.attrs['column-order'] = np.array(new_order, dtype=object)

        # --- Clear __pending_cols rows we just merged + any stale already-merged ones ---
        merged_names = list(mergeable['col_name']) + list(already_merged)
        if merged_names:
            con_rw, released_db = _open_duckdb_rw_with_release(
                duckdb_path, db_id, ant_serve_url,
            )
            try:
                placeholders = ','.join(['?'] * len(merged_names))
                con_rw.execute(
                    f"DELETE FROM __pending_cols WHERE col_name IN ({placeholders})",
                    merged_names,
                )
            finally:
                con_rw.close()
                if released_db and db_id and ant_serve_url:
                    _post_ant_serve(
                        ant_serve_url, f'/admin/restore/{db_id}',
                        on_failure='warn',
                    )
    finally:
        try:
            fcntl.flock(lock_fd.fileno(), fcntl.LOCK_UN)
        except Exception:
            pass
        lock_fd.close()
        try:
            lock_path.unlink()
        except FileNotFoundError:
            pass

    print(f"  ✓ {md_path.name}: merged {len(merged_names)} columns")
    return 0


def find_dirty_datasets(h5adstore_root: Path) -> List[Path]:
    """Walk the h5adstore and return .md paths whose duckdb has pending cols."""
    out = []
    for md in h5adstore_root.rglob('*.md'):
        # Skip _-prefixed staging dirs (project convention)
        if any(part.startswith('_') for part in md.relative_to(h5adstore_root).parts):
            continue
        if md.name == 'index.md':
            continue
        duckdb_path = md.with_suffix('.duckdb')
        if not duckdb_path.exists():
            continue
        try:
            pending = read_pending_cols(duckdb_path)
        except Exception:
            continue
        if not pending.empty:
            out.append(md)
    return out


def find_h5adstore_root() -> Optional[Path]:
    here = Path(__file__).parent.resolve()
    repo_root = here.parent
    candidate = repo_root / 'data' / 'h5adstore'
    return candidate if candidate.exists() else None


def main() -> int:
    parser = argparse.ArgumentParser(
        prog='ant-merge-h5ad',
        description='Merge pending duckdb obs columns into the h5ad source-of-truth.',
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument('paths', nargs='*',
                        help='.md file(s) to merge. Use --all to walk h5adstore.')
    parser.add_argument('--all', action='store_true',
                        help='Walk the h5adstore and merge every dirty dataset.')
    parser.add_argument('--dry-run', action='store_true',
                        help='Report what would change without writing.')
    parser.add_argument('--force', action='store_true',
                        help='Merge even in divergent state (only the recorded '
                             'pending intersection).')
    parser.add_argument('--api-url', default=None,
                        help='Override ant-serve URL (default: from anthive.yaml)')
    parser.add_argument('--no-coordinate', action='store_true',
                        help='Do not negotiate the DuckDB lock with ant-serve.')
    args = parser.parse_args()

    ant_serve_url = _resolve_ant_serve_url(args.api_url, args.no_coordinate)

    if args.all and args.paths:
        print("ERROR: cannot combine --all with explicit paths", file=sys.stderr)
        return 2
    if not args.all and not args.paths:
        parser.print_help()
        return 2

    if args.all:
        root = find_h5adstore_root()
        if root is None:
            print("ERROR: could not locate data/h5adstore/", file=sys.stderr)
            return 3
        targets = find_dirty_datasets(root)
        print(f"Found {len(targets)} dirty datasets under {root}")
    else:
        targets = [Path(p).resolve() for p in args.paths]
        for p in targets:
            if not p.exists():
                print(f"ERROR: not found: {p}", file=sys.stderr)
                return 3
            if p.suffix != '.md':
                print(f"ERROR: expected .md path: {p}", file=sys.stderr)
                return 2

    overall = 0
    for md in targets:
        db_id = _resolve_db_id_from_md(md) if ant_serve_url else None
        rc = merge_dataset(
            md, dry_run=args.dry_run, force_divergent=args.force,
            db_id=db_id, ant_serve_url=ant_serve_url if db_id else None,
        )
        if rc != 0:
            overall = rc
    return overall


if __name__ == '__main__':
    sys.exit(main())
