#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""gen-lock: build the container lock files from the scripts' PEP-723 headers.

Every ``bin/<domain>/ant-*`` tool and ``web/ant-browse`` declares its own
dependencies inline (the repo has no shared venv). Containers instead run
every script through ONE pinned virtualenv, so this tool:

1. collects the ``# dependencies = [...]`` block of each script,
2. merges them per image profile (``app`` = everything that runs in the
   service/ingest containers; ``ingest-extra`` = packages only the R/rds
   conversion image adds on top),
3. applies the explicit overrides in ``docker/lock-overrides.txt`` (where
   script headers conflict or a package must be excluded),
4. resolves with ``uv pip compile`` into ``docker/requirements-<profile>.lock``.

Inputs:  bin/*/ant-*, web/ant-browse, docker/lock-overrides.txt
Outputs: docker/requirements-app.in, docker/requirements-app.lock
         (and a report of which script asked for what, on stdout)

Usage:
    docker/gen-lock            # regenerate the lock
    docker/gen-lock --check    # exit 1 if the lock is stale vs the headers
"""

from __future__ import annotations

import argparse
import re
import subprocess
import sys
import tempfile
from collections import defaultdict
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
DOCKER = REPO / 'docker'
PYTHON_VERSION = '3.11'

# Scripts whose headers must NOT enter the shared venv: heavyweight or
# GPU/R-bound tools that are run from their own environment (or not at all
# in containers). Keep this list short and justified.
EXCLUDED_SCRIPTS = {
    # starCAT scoring pulls torch-scale dependencies and is purged from the
    # catalog (see git log 2026-09); run it from a dev checkout if needed.
    'ant-starcat', 'ant-starcat-ext',
}

HEADER = re.compile(r'^# /// script\s*$(.*?)^# ///\s*$', re.M | re.S)
DEPS = re.compile(r'dependencies\s*=\s*\[(.*?)\]', re.S)
ITEM = re.compile(r'"([^"]+)"|\'([^\']+)\'')


def script_paths() -> list[Path]:
    paths = sorted(REPO.glob('bin/*/ant-*')) + [REPO / 'web' / 'ant-browse']
    return [p for p in paths if p.is_file() and not p.name.endswith(('.md', '.py'))]


def header_deps(path: Path) -> list[str] | None:
    try:
        text = path.read_text(errors='replace')
    except OSError:
        return None
    block = HEADER.search(text)
    if not block:
        return None
    lines = [line[1:].strip() if line.startswith('#') else line
             for line in block.group(1).splitlines()]
    match = DEPS.search('\n'.join(lines))
    if not match:
        return []
    return [a or b for a, b in ITEM.findall(match.group(1))]


def package_name(requirement: str) -> str:
    return re.split(r'[\s<>=!~\[;]', requirement, maxsplit=1)[0].lower().replace('_', '-')


def load_overrides() -> tuple[dict[str, str], set[str]]:
    """``pkg-spec`` lines replace every header spec for pkg; ``-pkg`` drops it."""
    pinned: dict[str, str] = {}
    dropped: set[str] = set()
    path = DOCKER / 'lock-overrides.txt'
    if path.exists():
        for raw in path.read_text().splitlines():
            line = raw.split('#', 1)[0].strip()
            if not line:
                continue
            if line.startswith('-'):
                dropped.add(package_name(line[1:]))
            else:
                pinned[package_name(line)] = line
    return pinned, dropped


def build_input() -> tuple[str, dict[str, set[str]]]:
    pinned, dropped = load_overrides()
    specs: dict[str, set[str]] = defaultdict(set)
    askers: dict[str, set[str]] = defaultdict(set)
    for path in script_paths():
        if path.name in EXCLUDED_SCRIPTS:
            continue
        deps = header_deps(path)
        if deps is None:
            continue
        for requirement in deps:
            name = package_name(requirement)
            specs[name].add(requirement.strip())
            askers[name].add(path.name)
    lines = [
        '# GENERATED by docker/gen-lock from the PEP-723 headers. Do not edit;',
        '# edit the script headers or docker/lock-overrides.txt instead.',
    ]
    for name in sorted(specs):
        if name in dropped:
            lines.append(f'# dropped by override: {name}')
            continue
        if name in pinned:
            lines.append(f'{pinned[name]}  # override (headers: {"; ".join(sorted(specs[name]))})')
            continue
        # Several scripts may constrain the same package; uv intersects them.
        for spec in sorted(specs[name]):
            lines.append(spec)
    for name, spec in sorted(pinned.items()):
        if name not in specs:
            lines.append(f'{spec}  # override-only')
    return '\n'.join(lines) + '\n', askers


def compile_lock(input_text: str, out_path: Path) -> None:
    with tempfile.NamedTemporaryFile('w', suffix='.in', delete=False) as handle:
        handle.write(input_text)
        in_path = handle.name
    cmd = ['uv', 'pip', 'compile', in_path, '--python-version', PYTHON_VERSION,
           '--python-platform', 'x86_64-manylinux_2_28', '--no-header',
           '--quiet', '-o', str(out_path)]
    subprocess.run(cmd, check=True)
    body = out_path.read_text().replace(in_path, 'docker/requirements-app.in')
    out_path.write_text(
        '# GENERATED by docker/gen-lock (uv pip compile, Python '
        f'{PYTHON_VERSION}, x86_64 manylinux). Commit it.\n' + body
    )


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument('--check', action='store_true',
                        help='exit 1 when requirements-app.in is out of date')
    parser.add_argument('--report', action='store_true',
                        help='print which scripts ask for each package')
    args = parser.parse_args()

    input_text, askers = build_input()
    in_path = DOCKER / 'requirements-app.in'
    if args.report:
        for name in sorted(askers):
            print(f'{name:28s} {", ".join(sorted(askers[name]))}')
    if args.check:
        current = in_path.read_text() if in_path.exists() else ''
        if current != input_text:
            print('docker/requirements-app.in is stale: run docker/gen-lock', file=sys.stderr)
            return 1
        print('lock input up to date')
        return 0
    in_path.write_text(input_text)
    compile_lock(input_text, DOCKER / 'requirements-app.lock')
    n_pins = sum(1 for line in (DOCKER / 'requirements-app.lock').read_text().splitlines()
                 if line and not line.startswith(('#', ' ')))
    print(f'wrote docker/requirements-app.in ({len(askers)} packages requested) '
          f'and docker/requirements-app.lock ({n_pins} pinned)')
    return 0


if __name__ == '__main__':
    sys.exit(main())
