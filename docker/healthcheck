#!/bin/sh
# healthcheck URL [--any-status]
#
# Container HEALTHCHECK helper. Default: healthy on HTTP 2xx/3xx. With
# --any-status, healthy on ANY HTTP response (used for ant-mcp, whose /mcp
# endpoint answers a bare GET with 4xx but is alive).
url="$1"
code="$(curl -s -o /dev/null --max-time 4 -w '%{http_code}' "$url" || true)"
case "$code" in
    000|"") exit 1 ;;
esac
if [ "${2:-}" = "--any-status" ]; then
    exit 0
fi
case "$code" in
    2*|3*) exit 0 ;;
    *) exit 1 ;;
esac
