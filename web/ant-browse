"""
ant-browse - Anthive Web Browser Server

Serves HTML interface for browsing single-cell datasets.
All data is fetched from the ant-serve REST API.

Usage:
    ant browse [--api-url URL] [--host HOST] [--port PORT]

Example:
    ant browse --api-url http://localhost:8080 --host 0.0.0.0 --port 8081
"""

import argparse
import sys
from pathlib import Path

import requests
import uvicorn
from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware

# Layout: web/ant-browse lives next to web/browser.py and web/templates/,
# with the shared core in ../lib/.  No more cross-folder gymnastics.
script_dir = Path(__file__).parent.resolve()      # → repo/web/
lib_dir = script_dir.parent / 'lib'
sys.path.insert(0, str(lib_dir))
import config as _anthive_config_module  # noqa: E402
# A server warns about unknown config keys instead of stopping, so a container of an older
# release never crash-loops on a config rendered for a newer one (lib/config.py).
_anthive_config_module.set_unknown_keys_lenient()

from config import get_config

# Load the router module — sibling of this script.
sys.path.insert(0, str(script_dir.parent))   # allow `import web.browser`-ish paths if ever needed
import importlib.util
spec = importlib.util.spec_from_file_location("anthive_web_browser", script_dir / "browser.py")
browser_module = importlib.util.module_from_spec(spec)
spec.loader.exec_module(browser_module)
browser_router = browser_module.router


def create_app(api_url: str) -> FastAPI:
    """Create FastAPI app for browser"""

    app = FastAPI(
        title="Anthive Browser",
        description="Web interface for browsing single-cell datasets",
        version="1.0.0",
        docs_url=None,  # No Swagger docs for browser
        redoc_url=None,
    )

    # Enable CORS
    app.add_middleware(
        CORSMiddleware,
        allow_origins=["*"],
        allow_credentials=True,
        allow_methods=["*"],
        allow_headers=["*"],
    )

    # No-cache for HTML responses — these are dynamic and embed JS that
    # ships with each new commit (e.g. the plot.html form's syncURL).
    # Browsers were caching the old plot.html and silently running stale
    # JS even after a server-side update; this prevents that.  Static
    # assets (CSS/JS/images) are unaffected — they have their own URLs.
    from starlette.middleware.base import BaseHTTPMiddleware

    class _NoCacheHTMLMiddleware(BaseHTTPMiddleware):
        async def dispatch(self, request, call_next):
            response = await call_next(request)
            ct = response.headers.get('content-type', '')
            if ct.startswith('text/html'):
                response.headers['Cache-Control'] = 'no-cache, no-store, must-revalidate'
                response.headers['Pragma'] = 'no-cache'
                response.headers['Expires'] = '0'
            return response

    app.add_middleware(_NoCacheHTMLMiddleware)

    # Refresh genesets availability on every request with a short TTL so a
    # startup race (ant-serve not yet ready when browse boots) self-heals
    # within 5 s without requiring a browse restart.
    class _GenесetsProbeMiddleware(BaseHTTPMiddleware):
        async def dispatch(self, request, call_next):
            browser_module.refresh_genesets_available(request.app.state)
            return await call_next(request)

    app.add_middleware(_GenесetsProbeMiddleware)

    # Store API URL and config in app state for routes to access
    app.state.api_url = api_url
    config = get_config()
    app.state.reports = config.get('reports', [])

    # Initialise geneset state so the first request TTL check sees t=0 and probes.
    app.state.genesets_available = False
    app.state._genesets_probe_ts = 0.0

    # Include browser router
    app.include_router(browser_router)
    # One HTML error page for page routes (JSON for API clients)
    browser_module.install_error_pages(app)

    return app


def main():
    """Main entry point"""
    parser = argparse.ArgumentParser(
        description="Anthive Web Browser Server",
        formatter_class=argparse.RawDescriptionHelpFormatter
    )

    # Get config for defaults
    config = get_config()

    parser.add_argument(
        '--api-url',
        default=__import__('config').get_api_url(config),
        help='URL of the ant-serve REST API (default: api_url / ANTHIVE_API_URL, '
             'else http://localhost:<rest_api_port>)'
    )
    parser.add_argument(
        '--host',
        default=config.get('browse_host') or '127.0.0.1',
        help='Host to bind to (default: browse_host or 127.0.0.1)'
    )
    parser.add_argument(
        '--port',
        type=int,
        default=int(config.get('browse_port') or 8081),
        help='Port to bind to (default: browse_port or 8081)'
    )
    parser.add_argument(
        '--reload',
        action='store_true',
        help='Enable auto-reload for development'
    )

    args = parser.parse_args()

    # Create app
    app = create_app(args.api_url)

    # Print startup info
    print(f"\n{'='*60}")
    print(f"Starting Anthive Web Browser Server")
    print(f"{'='*60}")
    print(f"API URL: {args.api_url}")
    print(f"Listening on: http://{args.host}:{args.port}")
    print(f"{'='*60}\n")

    # Start server
    uvicorn.run(
        app,
        host=args.host,
        port=args.port,
        reload=args.reload,
        log_level="info"
    )


if __name__ == '__main__':
    main()
